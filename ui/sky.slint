    // Composants (ROM, connecteurs, GPU, mémoire, contrôleur, quartz, pile, réseau…) : s'allument quand
    // le courant les atteint.
    Path {
        property <float> lit: clamp((root.surge - 0.435) / 0.15, 0, 1);
        x: root.cx - 700 * root.u;
        y: root.cy - 700 * root.u;
        width: 1400 * root.u;
        height: 1400 * root.u;
        viewbox-width: 1400;
        viewbox-height: 1400;
        fill: #03110a;
