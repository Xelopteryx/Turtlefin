18.0 1019.0 L 414.0 1019.0 Z M 478.0 536.0 L 484.0 536.0 L 484.0 540.0 L 478.0 540.0 Z M 478.0 544.0 L 484.0 544.0 L 484.0 548.0 L 478.0 548.0 Z M 478.0 552.0 L 484.0 552.0 L 484.0 556.0 L 478.0 556.0 Z M 478.0 560.0 L 484.0 560.0 L 484.0 564.0 L 478.0 564.0 Z M 416.0 536.0 L 422.0 536.0 L 422.0 540.0 L 416.0 540.0 Z M 416.0 544.0 L 422.0 544.0 L 422.0 548.0 L 416.0 548.0 Z M 416.0 552.0 L 422.0 552.0 L 422.0 556.0 L 416.0 556.0 Z M 416.0 560.0 L 422.0 560.0 L 422.0 564.0 L 416.0 564.0 Z M 448.0 525.0 L 452.0 525.0 L 452.0 531.0 L 448.0 531.0 Z M 323.0 512.0 L 329.0 512.0 L 329.0 516.0 L 323.0 516.0 Z M 323.0 520.0 L 329.0 520.0 L 329.0 524.0 L 323.0 524.0 Z M 323.0 528.0 L 329.0 528.0 L 329.0 532.0 L 323.0 532.0 Z M 323.0 536.0 L 329.0 536.0 L 329.0 540.0 L 323.0 540.0 Z M 548.0 369.0 L 552.0 369.0 L 552.0 375.0 L 548.0 375.0 Z";
    }
    // Lueur du centre : de plus en plus claire à chaque puce branchée.
    Rectangle {
        property <float> r: 60 + 150 * root.power + 120 * root.surge;
        x: root.cx - self.r * root.u;
        y: root.cy - self.r * root.u;
        width: 2 * self.r * root.u;
        height: self.width;
        border-radius: self.width / 2;
        background: @radial-gradient(circle, root.a2.with-alpha((0.10 + 0.35 * root.power) * root.bright * 1.6) 0%, root.a1.with-alpha(0.12 * root.power * root.bright * 1.6) 45%, root.a1.with-alpha(0) 72%);
    }
    // Pistes parcourues par le courant : chacune à son tour, tracée jusqu'à la pointe.
    if root.surge > 0 && root.surge < 1: Rectangle {
        for tr[j] in Board.traces: Path {
            property <float> p: clamp((root.surge - tr.d) / 0.42, 0, 1);
            property <float> f: self.p * 10;
            visible: self.p > 0;
            x: root.cx - 700 * root.u;
            y: root.cy - 700 * root.u;
            width: 1400 * root.u;
            height: 1400 * root.u;
            viewbox-width: 1400;
            viewbox-height: 1400;
            fill: transparent;
            stroke: root.a2.with-alpha(0.85);
            stroke-width: 2.4 * root.u;
            stroke-line-join: round;
            stroke-line-cap: round;
            commands: "M " + tr.xs[0] + " " + tr.ys[0]
                + (self.f > 0 ? " L " + (self.f >= 1 ? tr.xs[1] : tr.xs[0] + (tr.xs[1] - tr.xs[0]) * (self.f - 0)) + " " + (self.f >= 1 ? tr.ys[1] : tr.ys[0] + (tr.ys[1] - tr.ys[0]) * (self.f - 0)) : "")
                + (self.f > 1 ? " L " + (self.f >= 2 ? tr.xs[2] : tr.xs[1] + (tr.xs[2] - tr.xs[1]) * (self.f - 1)) + " " + (self.f >= 2 ? tr.ys[2] : tr.ys[1] + (tr.ys[2] - tr.ys[1]) * (self.f - 1)) : "")
                + (self.f > 2 ? " L " + (self.f >= 3 ? tr.xs[3] : tr.xs[2] + (tr.xs[3] - tr.xs[2]) * (self.f - 2)) + " " + (self.f >= 3 ? tr.ys[3] : tr.ys[2] + (tr.ys[3] - tr.ys[2]) * (self.f - 2)) : "")
                + (self.f > 3 ? " L " + (self.f >= 4 ? tr.xs[4] : tr.xs[3] + (tr.xs[4] - tr.xs[3]) * (self.f - 3)) + " " + (self.f >= 4 ? tr.ys[4] : tr.ys[3] + (tr.ys[4] - tr.ys[3]) * (self.f - 3)) : "")
                + (self.f > 4 ? " L " + (self.f >= 5 ? tr.xs[5] : tr.xs[4] + (tr.xs[5] - tr.xs[4]) * (self.f - 4)) + " " + (self.f >= 5 ? tr.ys[5] : tr.ys[4] + (tr.ys[5] - tr.ys[4]) * (self.f - 4)) : "")
                + (self.f > 5 ? " L " + (self.f >= 6 ? tr.xs[6] : tr.xs[5] + (tr.xs[6] - tr.xs[5]) * (self.f - 5)) + " " + (self.f >= 6 ? tr.ys[6] : tr.ys[5] + (tr.ys[6] - tr.ys[5]) * (self.f - 5)) : "")
                + (self.f > 6 ? " L " + (self.f >= 7 ? tr.xs[7] : tr.xs[6] + (tr.xs[7] - tr.xs[6]) * (self.f - 6)) + " " + (self.f >= 7 ? tr.ys[7] : tr.ys[6] + (tr.ys[7] - tr.ys[6]) * (self.f - 6)) : "")
                + (self.f > 7 ? " L " + (self.f >= 8 ? tr.xs[8] : tr.xs[7] + (tr.xs[8] - tr.xs[7]) * (self.f - 7)) + " " + (self.f >= 8 ? tr.ys[8] : tr.ys[7] + (tr.ys[8] - tr.ys[7]) * (self.f - 7)) : "")
                + (self.f > 8 ? " L " + (self.f >= 9 ? tr.xs[9] : tr.xs[8] + (tr.xs[9] - tr.xs[8]) * (self.f - 8)) + " " + (self.f >= 9 ? tr.ys[9] : tr.ys[8] + (tr.ys[9] - tr.ys[8]) * (self.f - 8)) : "")
                + (self.f > 9 ? " L " + (self.f >= 10 ? tr.xs[10] : tr.xs[9] + (tr.xs[10] - tr.xs[9]) * (self.f - 9)) + " " + (self.f >= 10 ? tr.ys[10] : tr.ys[9] + (tr.ys[10] - tr.ys[9]) * (self.f - 9)) : "");
        }
        // Pointe du courant : une lueur qui file devant.
        for tr[j] in Board.traces: Rectangle {
            property <float> p: clamp((root.surge - tr.d) / 0.42, 0, 1);
            property <int> s: min(floor(self.p * 10), 9);
            property <float> l: self.p * 10 - self.s;
            property <float> tx: tr.xs[self.s] + (tr.xs[self.s + 1] - tr.xs[self.s]) * self.l - 700;
            property <float> ty: tr.ys[self.s] + (tr.ys[self.s + 1] - tr.ys[self.s]) * self.l - 700;
            visible: self.p > 0 && self.p < 1;
            x: root.cx + self.tx * root.u - 9 * root.u;
            y: root.cy + self.ty * root.u - 9 * root.u;
            width: 18 * root.u;
            height: self.width;
            border-radius: self.width / 2;
            background: @radial-gradient(circle, #ffffff 0%, root.a2.with-alpha(0.9) 35%, root.a2.with-alpha(0) 70%);
        }
    }
    // Toutes parcourues : un seul tracé (fond de l'appli, image figée).
    if root.surge >= 1: Path {
        x: root.cx - 700 * root.u;
        y: root.cy - 700 * root.u;
        width: 1400 * root.u;
        height: 1400 * root.u;
        viewbox-width: 1400;
        viewbox-height: 1400;
        fill: transparent;
        stroke: root.a2.with-alpha(0.85 * root.bright);
        stroke-width: 2.4 * root.u;
        stroke-line-join: round;
