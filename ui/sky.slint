// Décor du fond pour les thèmes à `Theme.bubbles` (Frutiger Aero) : halo de soleil, voiles de
// lumière (aurore), colline d'herbe, bulles de savon. Tout est fixe (aucune animation continue :
// rien à redessiner tant que rien ne bouge), dessiné par-dessus l'image de fond et sous les pages.
import { Theme } from "theme.slint";

// Une bulle : corps presque transparent au bord plus clair, reflet en haut à gauche, petit éclat
// en bas à droite.
component Bubble inherits Rectangle {
    in property <float> a: 1.0; // opacité générale
    border-radius: self.width / 2;
    height: self.width;
    opacity: root.a;
    background: @radial-gradient(circle, rgba(255, 255, 255, 0.02) 0%, rgba(255, 255, 255, 0.06) 55%,
        rgba(200, 240, 255, 0.28) 85%, rgba(255, 255, 255, 0.55) 100%);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.55);
    // Reflet principal (fenêtre de lumière)
    Rectangle {
        x: parent.width * 0.16;
        y: parent.height * 0.1;
        width: parent.width * 0.42;
        height: parent.height * 0.26;
        border-radius: self.height / 2;
        background: @linear-gradient(180deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.05) 100%);
    }
    // Éclat opposé
    Rectangle {
        x: parent.width * 0.62;
        y: parent.height * 0.7;
        width: parent.width * 0.14;
        height: self.width;
        border-radius: self.width / 2;
        background: @radial-gradient(circle, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0) 100%);
    }
}

// Ciel lumineux, colline d'herbe et bulles (décor 1).
component SkyScene inherits Rectangle {
    property <length> u: min(self.width, self.height * 1.6) / 100;

    // Halo du soleil (en haut à droite)
    Rectangle {
        x: parent.width * 0.62;
        y: -parent.height * 0.35;
        width: parent.width * 0.6;
        height: self.width;
        border-radius: self.width / 2;
        background: @radial-gradient(circle, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 240, 0.22) 30%, rgba(255, 255, 255, 0) 70%);
    }

    // Voiles de lumière : longues courbes claires qui traversent le ciel.
    Path {
        width: 1000px;
        height: 600px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        transform-scale-x: parent.width / self.width;
        transform-scale-y: parent.height / self.height;
        viewbox-width: 1000;
        viewbox-height: 600;
        fill: @linear-gradient(100deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.32) 45%, rgba(190, 255, 220, 0.18) 75%, rgba(255, 255, 255, 0) 100%);
        commands: "M -50 330 C 200 220 420 300 620 230 C 800 170 900 120 1050 60 L 1050 110 C 900 170 790 230 620 290 C 420 360 210 280 -50 400 Z";
    }
    Path {
        width: 1000px;
        height: 600px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        transform-scale-x: parent.width / self.width;
        transform-scale-y: parent.height / self.height;
        viewbox-width: 1000;
        viewbox-height: 600;
        fill: @linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(160, 230, 255, 0.28) 50%, rgba(255, 255, 255, 0) 100%);
        commands: "M -50 430 C 240 350 470 420 700 360 C 850 320 950 290 1050 250 L 1050 275 C 950 315 850 350 700 395 C 470 455 240 395 -50 470 Z";
    }

    // Colline d'herbe, douce, en bas.
    Rectangle {
        y: parent.height * 0.72;
        height: parent.height * 0.28;
    Path {
        width: 1000px;
        height: 200px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        transform-scale-x: parent.width / self.width;
        transform-scale-y: parent.height / self.height;
        viewbox-width: 1000;
        viewbox-height: 200;
        fill: @linear-gradient(180deg, rgba(160, 235, 110, 0.55) 0%, rgba(70, 175, 60, 0.75) 100%);
        commands: "M 0 120 C 180 40 380 30 560 80 C 720 125 860 70 1000 40 L 1000 200 L 0 200 Z";
    }
    Path {
        width: 1000px;
        height: 200px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        transform-scale-x: parent.width / self.width;
        transform-scale-y: parent.height / self.height;
        viewbox-width: 1000;
        viewbox-height: 200;
        fill: @linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 100%);
        commands: "M 0 120 C 180 40 380 30 560 80 C 720 125 860 70 1000 40 L 1000 52 C 860 82 720 137 560 92 C 380 42 180 52 0 132 Z";
    }

    }

    // Bulles (tailles et places fixes, plutôt sur les bords pour ne pas gêner les affiches).
    Bubble { x: parent.width * 0.04; y: parent.height * 0.62; width: 9 * root.u; }
    Bubble { x: parent.width * 0.11; y: parent.height * 0.5; width: 4 * root.u; a: 0.8; }
    Bubble { x: parent.width * 0.02; y: parent.height * 0.36; width: 3 * root.u; a: 0.7; }
    Bubble { x: parent.width * 0.16; y: parent.height * 0.7; width: 2.2 * root.u; a: 0.7; }
    Bubble { x: parent.width * 0.87; y: parent.height * 0.55; width: 11 * root.u; }
    Bubble { x: parent.width * 0.82; y: parent.height * 0.42; width: 3.6 * root.u; a: 0.85; }
    Bubble { x: parent.width * 0.94; y: parent.height * 0.3; width: 5 * root.u; a: 0.8; }
    Bubble { x: parent.width * 0.78; y: parent.height * 0.76; width: 2.6 * root.u; a: 0.7; }
    Bubble { x: parent.width * 0.47; y: parent.height * 0.82; width: 3.2 * root.u; a: 0.6; }
    Bubble { x: parent.width * 0.58; y: parent.height * 0.12; width: 2.4 * root.u; a: 0.6; }
    Bubble { x: parent.width * 0.33; y: parent.height * 0.18; width: 1.8 * root.u; a: 0.55; }
    Bubble { x: parent.width * 0.69; y: parent.height * 0.9; width: 5.5 * root.u; a: 0.75; }
}

// Éclat de lumière doux (rond, flou) : cœur coloré qui s'efface vers le bord.
component Glow inherits Rectangle {
    in property <color> c: #ffffff;
    in property <float> a: 0.5;
    height: self.width;
    border-radius: self.width / 2;
    background: @radial-gradient(circle, root.c.with-alpha(root.a) 0%, root.c.with-alpha(root.a * 0.35) 35%, root.c.with-alpha(0) 70%);
}

// « Harmony » (décor 2), dans l'esprit du fond d'écran de Windows 7 : bleu profond, gerbe de lumière
// cyan et blanche, rubans de lumière en éventail, petites lueurs de couleur au cœur.
component HarmonyScene inherits Rectangle {
    property <length> u: min(self.width, self.height * 1.6) / 100;
    // Halo général, un peu à gauche du centre.
    Glow { x: parent.width * 0.5 - self.width / 2; y: parent.height * 0.42 - self.height / 2; width: parent.width * 1.1; c: #4fb4ff; a: 0.42; }
    // Rubans de lumière : courbes claires qui partent du cœur vers les bords.
    Path {
        width: 1000px;
        height: 600px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        transform-scale-x: parent.width / self.width;
        transform-scale-y: parent.height / self.height;
        viewbox-width: 1000;
        viewbox-height: 600;
        fill: @linear-gradient(160deg, rgba(255, 255, 255, 0) 0%, rgba(190, 235, 255, 0.30) 45%, rgba(255, 255, 255, 0) 100%);
        commands: "M 500 250 C 380 150 220 60 -40 20 L -40 80 C 200 110 360 190 500 262 Z M 500 250 C 650 170 820 110 1040 90 L 1040 130 C 830 150 660 200 500 262 Z";
    }
    Path {
        width: 1000px;
        height: 600px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        transform-scale-x: parent.width / self.width;
        transform-scale-y: parent.height / self.height;
        viewbox-width: 1000;
        viewbox-height: 600;
        fill: @linear-gradient(20deg, rgba(255, 255, 255, 0) 0%, rgba(120, 210, 255, 0.24) 50%, rgba(255, 255, 255, 0) 100%);
        commands: "M 500 260 C 360 330 180 430 -40 470 L -40 540 C 200 480 380 370 500 272 Z M 500 260 C 640 340 820 420 1040 440 L 1040 500 C 810 470 630 380 500 272 Z";
    }
    Path {
        width: 1000px;
        height: 600px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        transform-scale-x: parent.width / self.width;
        transform-scale-y: parent.height / self.height;
        viewbox-width: 1000;
        viewbox-height: 600;
        fill: @linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(220, 245, 255, 0.20) 50%, rgba(255, 255, 255, 0) 100%);
        commands: "M -40 300 C 200 270 380 250 500 256 C 640 262 820 250 1040 230 L 1040 250 C 820 272 640 280 500 270 C 380 262 200 290 -40 330 Z";
    }
    // Cœur : lueurs de couleur (rouge, vert, bleu, jaune) puis blanc éclatant.
    Glow { x: parent.width * 0.47 - self.width / 2; y: parent.height * 0.40 - self.height / 2; width: 16 * root.u; c: #ff5a3c; a: 0.3; }
    Glow { x: parent.width * 0.53 - self.width / 2; y: parent.height * 0.40 - self.height / 2; width: 16 * root.u; c: #7ed957; a: 0.3; }
    Glow { x: parent.width * 0.47 - self.width / 2; y: parent.height * 0.47 - self.height / 2; width: 16 * root.u; c: #2f9bff; a: 0.34; }
    Glow { x: parent.width * 0.53 - self.width / 2; y: parent.height * 0.47 - self.height / 2; width: 16 * root.u; c: #ffd23c; a: 0.3; }
    Glow { x: parent.width * 0.5 - self.width / 2; y: parent.height * 0.435 - self.height / 2; width: 20 * root.u; c: #ffffff; a: 0.38; }
    // Reflets ronds, flous, comme une lumière dans la vitre.
    Glow { x: parent.width * 0.16; y: parent.height * 0.18; width: 7 * root.u; c: #bfe6ff; a: 0.18; }
    Glow { x: parent.width * 0.78; y: parent.height * 0.66; width: 10 * root.u; c: #bfe6ff; a: 0.14; }
    Glow { x: parent.width * 0.86; y: parent.height * 0.14; width: 5 * root.u; c: #ffffff; a: 0.16; }
    Glow { x: parent.width * 0.08; y: parent.height * 0.72; width: 9 * root.u; c: #8fd0ff; a: 0.12; }
    // Assombrissement des bords, pour que les pages restent lisibles.
    Rectangle {
        background: @linear-gradient(180deg, rgba(2, 16, 40, 0.35) 0%, rgba(2, 16, 40, 0) 30%, rgba(2, 16, 40, 0) 65%, rgba(2, 16, 40, 0.5) 100%);
    }
}

// Carte mère (décor 3, thème Nerd) : fond noir, pistes de cuivre qui partent des sept puces vers les
// bords en serpentant. Les puces (une par vérification du démarrage, chacune dessinée selon son rôle)
// sont branchées autour du processeur, au centre ; le centre s'éclaire à chaque puce branchée, puis le
// courant parcourt les pistes (surge, 0 à 1 : chaque piste s'allume à son tour, une lueur à sa pointe).
// Mêmes positions que le logo du démarrage (centre de l'écran, 30 px plus haut) : la carte montée au
// démarrage reste en fond des pages. En fond de l'appli : tout branché, tout allumé, image figée.
export struct TraceData {
    xs: [float],
    ys: [float],
    d: float,
}

export component CircuitScene inherits Rectangle {
    in property <float> k: 1.0;
    // États des sept puces (0 absente · 1 en cours · 2 branchée · 3 échec · 4 à configurer).
    in property <[int]> state: [2, 2, 2, 2, 2, 2, 2];
    // Courant dans les pistes (0 rien · 1 tout parcouru).
    in property <float> surge: 1;
    // Intensité d'ensemble (plus bas en fond des pages).
    in property <float> bright: 0.55;
    background: transparent;
    property <length> u: min(self.width, self.height) * 0.46 / 256;
    property <length> cx: self.width / 2;
    property <length> cy: self.height / 2 - 30px * root.k;
    property <int> ok-n: (root.state[0] == 2 ? 1 : 0) + (root.state[1] == 2 ? 1 : 0) + (root.state[2] == 2 ? 1 : 0)
        + (root.state[3] == 2 ? 1 : 0) + (root.state[4] == 2 ? 1 : 0) + (root.state[5] == 2 ? 1 : 0) + (root.state[6] == 2 ? 1 : 0);
    property <float> power: root.ok-n / 7;
    animate power { duration: 600ms; easing: ease-out; }
    property <[{x: float, y: float}]> chips: [{x: 0, y: -68}, {x: 59, y: -34}, {x: 59, y: 34}, {x: 0, y: 68}, {x: -59, y: 34}, {x: -59, y: -34}, {x: 0, y: 0}];
    property <[TraceData]> traces: [
        { xs: [700.0, 675.8, 652.0, 616.5, 593.8, 549.4, 515.2, 476.9, 448.4, 452.2, 434.1, 453.2], ys: [610.2, 561.3, 513.2, 471.4, 435.6, 383.3, 314.1, 236.7, 150.8, 92.1, -6.9, -99.5], d: 0.277 },
        { xs: [700.0, 706.8, 701.0, 701.0, 718.7, 735.5, 741.8, 684.4, 591.5, 473.2, 376.4, 294.8], ys: [610.2, 582.9, 541.4, 471.2, 400.3, 358.6, 267.9, 188.9, 130.9, 110.0, 92.9, 98.6], d: 0.239 },
        { xs: [700.0, 717.3, 727.4, 740.9, 768.6, 809.3, 906.7, 996.3, 1108.7, 1178.0, 1275.8, 1342.0], ys: [610.2, 583.3, 553.2, 513.2, 458.1, 410.7, 394.7, 340.1, 321.6, 279.4, 263.3, 222.9], d: 0.248 },
        { xs: [652.0, 682.5, 734.7, 772.2, 820.7, 900.6, 951.7, 993.7, 1036.4, 1105.8, 1157.6, 1221.9], ys: [513.2, 514.3, 495.2, 461.5, 417.9, 388.8, 354.3, 307.7, 227.4, 131.8, 60.6, 13.9], d: 0.397 },
        { xs: [777.9, 792.3, 801.6, 820.5, 857.1, 851.3, 836.4, 820.6, 775.9, 662.0, 555.1, 449.6], ys: [655.1, 598.1, 561.3, 526.0, 457.7, 370.2, 324.0, 274.8, 202.8, 194.5, 201.6, 193.9], d: 0.326 },
        { xs: [777.9, 825.8, 842.9, 849.6, 881.3, 912.2, 955.7, 968.4, 1051.5, 1130.4, 1184.7, 1302.8], ys: [655.1, 617.8, 588.2, 540.5, 475.6, 438.9, 369.4, 297.9, 271.0, 257.1, 223.3, 271.1], d: 0.316 },
        { xs: [777.9, 819.4, 852.4, 889.3, 935.8, 953.0, 987.2, 1018.4, 1069.8, 1150.6, 1257.7, 1350.2], ys: [655.1, 668.2, 678.6, 709.0, 723.6, 775.1, 815.1, 864.1, 924.3, 981.9, 1024.0, 1111.7], d: 0.299 },
        { xs: [801.6, 841.9, 863.9, 905.6, 936.8, 984.6, 1027.6, 1059.3, 1124.0, 1158.8, 1207.8, 1234.1], ys: [561.3, 581.0, 605.5, 625.8, 665.9, 703.3, 747.9, 826.5, 850.1, 936.3, 1021.3, 1113.2], d: 0.446 },
        { xs: [777.9, 827.8, 875.9, 934.1, 1002.4, 1056.6, 1102.5, 1158.3, 1261.2, 1352.8, 1446.4, 1486.7], ys: [744.9, 766.7, 771.4, 792.1, 806.2, 803.9, 861.8, 893.5, 934.3, 986.3, 1039.5, 1098.3], d: 0.213 },
        { xs: [777.9, 824.8, 889.5, 962.7, 1038.2, 1085.4, 1183.0, 1274.6, 1364.0, 1407.4, 1470.7, 1509.8], ys: [744.9, 751.4, 769.9, 790.9, 782.9, 789.5, 779.1, 756.2, 720.0, 678.0, 616.8, 566.6], d: 0.23 },
        { xs: [777.9, 751.6, 731.4, 699.0, 667.8, 662.4, 643.6, 608.3, 554.8, 474.9, 379.5, 296.7], ys: [744.9, 789.0, 855.4, 909.8, 962.0, 1025.3, 1107.7, 1177.5, 1254.2, 1306.4, 1389.8, 1443.8], d: 0.211 },
        { xs: [875.9, 904.6, 949.8, 989.3, 1029.2, 1116.4, 1173.6, 1239.0, 1325.0, 1372.0, 1367.4, 1339.3], ys: [771.4, 775.4, 764.1, 769.6, 759.6, 750.4, 766.7, 785.4, 852.5, 901.1, 968.4, 1026.1], d: 0.333 },
        { xs: [700.0, 730.8, 774.5, 809.1, 865.4, 904.6, 960.0, 990.2, 1008.4, 1056.4, 1073.9, 1060.8], ys: [789.8, 813.6, 838.7, 858.5, 902.2, 952.1, 1022.6, 1074.5, 1137.1, 1219.8, 1341.5, 1470.0], d: 0.341 },
        { xs: [700.0, 715.0, 738.8, 726.8, 686.2, 636.2, 589.9, 491.4, 412.5, 320.6, 209.5, 105.4], ys: [789.8, 849.9, 882.6, 919.5, 967.9, 1004.2, 1022.9, 1047.5, 1021.8, 964.4, 980.0, 980.0], d: 0.332 },
        { xs: [700.0, 690.5, 685.3, 700.0, 730.8, 765.2, 799.7, 856.6, 928.9, 990.1, 1099.7, 1229.1], ys: [789.8, 821.7, 856.3, 918.0, 961.4, 1009.7, 1039.3, 1054.1, 1072.9, 1073.5, 1039.1, 1031.4], d: 0.372 },
        { xs: [774.5, 809.5, 851.9, 870.1, 893.5, 918.2, 914.3, 881.4, 797.1, 679.9, 610.8, 515.4], ys: [838.7, 857.3, 907.9, 945.2, 993.1, 1069.2, 1125.1, 1182.1, 1258.1, 1245.8, 1220.6, 1185.9], d: 0.461 },
        { xs: [622.1, 598.9, 559.0, 529.5, 509.9, 470.6, 451.6, 437.3, 401.0, 348.3, 275.5, 233.4], ys: [744.9, 791.2, 826.5, 885.4, 943.6, 989.4, 1046.1, 1122.6, 1230.4, 1312.9, 1397.9, 1522.8], d: 0.164 },
        { xs: [622.1, 573.8, 530.3, 483.1, 441.1, 408.3, 372.8, 324.6, 244.6, 182.9, 156.4, 208.7], ys: [744.9, 751.6, 776.7, 813.5, 857.0, 902.0, 931.7, 947.3, 997.3, 1082.0, 1188.1, 1265.8], d: 0.169 },
        { xs: [622.1, 577.9, 545.4, 481.3, 429.2, 385.3, 347.1, 285.6, 217.1, 108.6, 5.3, -76.7], ys: [744.9, 785.2, 802.7, 809.8, 837.9, 877.9, 935.2, 991.3, 1028.2, 1040.2, 1078.5, 1134.5], d: 0.16 },
        { xs: [559.0, 515.5, 486.0, 449.8, 384.9, 341.5, 278.6, 199.9, 107.8, 40.4, -8.6, -63.8], ys: [826.5, 799.3, 774.5, 751.8, 730.6, 727.6, 702.1, 715.9, 773.4, 843.0, 910.4, 1013.9], d: 0.284 },
        { xs: [622.1, 585.4, 525.6, 465.0, 414.6, 344.2, 262.9, 203.6, 161.1, 52.5, -60.0, -174.8], ys: [655.1, 677.9, 688.2, 714.9, 737.1, 749.3, 775.4, 812.1, 870.0, 881.0, 892.4, 952.9], d: 0.13 },
        { xs: [622.1, 577.4, 540.6, 500.0, 443.2, 360.9, 275.1, 214.3, 151.3, 96.0, 19.0, -68.2], ys: [655.1, 629.4, 614.5, 585.1, 571.0, 537.8, 516.5, 510.1, 487.2, 475.5, 438.1, 419.6], d: 0.12 },
        { xs: [622.1, 609.4, 609.6, 591.9, 585.2, 594.5, 620.2, 573.1, 515.4, 449.4, 328.2, 237.1], ys: [655.1, 623.6, 559.7, 504.8, 466.2, 422.6, 352.7, 263.6, 263.5, 236.7, 219.4, 219.2], d: 0.117 },
        { xs: [525.6, 543.7, 585.6, 613.9, 637.4, 690.4, 743.1, 767.9, 790.7, 799.0, 787.0, 786.9], ys: [688.2, 647.4, 606.9, 543.3, 513.2, 445.2, 394.3, 325.8, 262.9, 183.5, 98.5, -35.6], d: 0.25 }
    ];
    pure function ink(s: int) -> color {
        return s == 2 ? #4dff9a : s == 3 ? #ff5c5c : s == 4 ? #ffc23d : Theme.accent2;
    }

    // Pistes éteintes : à peine visibles sur le noir.
    Path {
        x: root.cx - 700 * root.u;
        y: root.cy - 700 * root.u;
        width: 1400 * root.u;
        height: 1400 * root.u;
        viewbox-width: 1400;
        viewbox-height: 1400;
        fill: transparent;
        stroke: Theme.accent1.with-alpha(0.10);
