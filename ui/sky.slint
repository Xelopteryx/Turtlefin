export component CircuitScene inherits Rectangle {
    in property <float> k: 1.0;
    // États des sept puces (0 absente · 1 en cours · 2 branchée · 3 échec · 4 à configurer).
    in property <[int]> state: [2, 2, 2, 2, 2, 2, 2];
    // Courant dans les pistes (0 rien · 1 tout parcouru).
    in property <float> surge: 1;
    // Intensité d'ensemble (plus bas en fond des pages).
    in property <float> bright: 0.55;
    // Animé (démarrage) ; en fond des pages, image figée : pas de pulsation.
    in property <bool> live: true;
    // Hors ligne (Srv.core = 2) : les pistes et les puces passent à l'ambre.
    in property <bool> offline;
    // Démarrage : les puces deviennent le logo (0 puces · 1 plots aux sommets, puce du serveur au
    // centre, exactement ceux du logo, voir ThemeLogo) ; gone : le logo dessiné par-dessus a pris le
    // relais et part se poser sur le titre, les puces devenues plots s'effacent (0 à 1).
    in property <float> morph;
    in property <float> gone;
    // Capot du processeur (0 absent · 1 posé) : fin du démarrage et fond des pages. Les sept puces
    // sont dessous, comme les puces d'un vrai processeur sous son capot, et le logo y est gravé.
    // Seulement quand le serveur est là (processeur branché).
    in property <float> lid;
    property <bool> lid-on: root.lid > 0.001 && root.state[6] == 2;
    property <bool> lid-down: root.lid-on && root.lid >= 0.999;
    property <color> a1: root.offline ? #a8620e : Theme.accent1;
    property <color> a2: root.offline ? #f59e0b : Theme.accent2;
    animate a1, a2 { duration: 900ms; easing: ease-in-out; }
    background: transparent;
    property <length> u: min(self.width, self.height) * 0.46 / 256;
    property <length> cx: self.width / 2;
    property <length> cy: self.height / 2;
    property <int> ok-n: (root.state[0] == 2 ? 1 : 0) + (root.state[1] == 2 ? 1 : 0) + (root.state[2] == 2 ? 1 : 0)
        + (root.state[3] == 2 ? 1 : 0) + (root.state[4] == 2 ? 1 : 0) + (root.state[5] == 2 ? 1 : 0) + (root.state[6] == 2 ? 1 : 0);
    property <float> power: root.ok-n / 7;
    animate power { duration: 600ms; easing: ease-out; }
    property <[{x: float, y: float}]> chips: [{x: 0, y: -68}, {x: 59, y: -34}, {x: 59, y: 34}, {x: 0, y: 68}, {x: -59, y: 34}, {x: -59, y: -34}, {x: 0, y: 0}];
    pure function ink(s: int) -> color {
        return s == 2 ? #4dff9a : s == 3 || s == 5 ? #ff5c5c : s == 4 ? #ffc23d : root.a2;
    }

    // Pistes éteintes : à peine visibles sur le noir.
    Path {
        x: root.cx - 700 * root.u;
        y: root.cy - 700 * root.u;
        width: 1400 * root.u;
        height: 1400 * root.u;
        viewbox-width: 1400;
        viewbox-height: 1400;
        fill: transparent;
        stroke: root.a1.with-alpha(0.10);
        stroke-width: 2.2 * root.u;
        stroke-line-join: round;
