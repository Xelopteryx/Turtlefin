4.0 562.0 L 356.0 554.0 L 348.0 546.0 L 340.0 538.0 L 326.0 538.0 M 450 530 L 450.0 512.0 L 450.0 484.0 L 464.3 469.7 L 478.6 455.4 L 492.9 441.1 L 507.1 426.9 L 521.4 412.6 L 535.7 398.3 L 550.0 384.0 L 550.0 370.0";
    }
    if root.surge >= 1: Path {
        x: root.cx - 700 * root.u;
        y: root.cy - 700 * root.u;
        width: 1400 * root.u;
        height: 1400 * root.u;
        viewbox-width: 1400;
        viewbox-height: 1400;
        fill: root.a2.with-alpha(0.7 * root.bright);
        commands: "M 803.0 508.0 A 5 5 0 1 0 813.0 508.0 A 5 5 0 1 0 803.0 508.0 Z M 811.0 508.0 A 5 5 0 1 0 821.0 508.0 A 5 5 0 1 0 811.0 508.0 Z M 819.0 508.0 A 5 5 0 1 0 829.0 508.0 A 5 5 0 1 0 819.0 508.0 Z M 827.0 508.0 A 5 5 0 1 0 837.0 508.0 A 5 5 0 1 0 827.0 508.0 Z M 885.0 370.0 A 5 5 0 1 0 895.0 370.0 A 5 5 0 1 0 885.0 370.0 Z M 893.0 370.0 A 5 5 0 1 0 903.0 370.0 A 5 5 0 1 0 893.0 370.0 Z M 901.0 370.0 A 5 5 0 1 0 911.0 370.0 A 5 5 0 1 0 901.0 370.0 Z M 999.0 568.0 A 5 5 0 1 0 1009.0 568.0 A 5 5 0 1 0 999.0 568.0 Z M 999.0 576.0 A 5 5 0 1 0 1009.0 576.0 A 5 5 0 1 0 999.0 576.0 Z M 999.0 584.0 A 5 5 0 1 0 1009.0 584.0 A 5 5 0 1 0 999.0 584.0 Z M 999.0 592.0 A 5 5 0 1 0 1009.0 592.0 A 5 5 0 1 0 999.0 592.0 Z M 924.0 804.0 A 5 5 0 1 0 934.0 804.0 A 5 5 0 1 0 924.0 804.0 Z M 924.0 812.0 A 5 5 0 1 0 934.0 812.0 A 5 5 0 1 0 924.0 812.0 Z M 924.0 820.0 A 5 5 0 1 0 934.0 820.0 A 5 5 0 1 0 924.0 820.0 Z M 924.0 828.0 A 5 5 0 1 0 934.0 828.0 A 5 5 0 1 0 924.0 828.0 Z M 924.0 836.0 A 5 5 0 1 0 934.0 836.0 A 5 5 0 1 0 924.0 836.0 Z M 995.0 1018.0 A 5 5 0 1 0 1005.0 1018.0 A 5 5 0 1 0 995.0 1018.0 Z M 1005.0 1018.0 A 5 5 0 1 0 1015.0 1018.0 A 5 5 0 1 0 1005.0 1018.0 Z M 1015.0 1018.0 A 5 5 0 1 0 1025.0 1018.0 A 5 5 0 1 0 1015.0 1018.0 Z M 1025.0 1018.0 A 5 5 0 1 0 1035.0 1018.0 A 5 5 0 1 0 1025.0 1018.0 Z M 1035.0 1018.0 A 5 5 0 1 0 1045.0 1018.0 A 5 5 0 1 0 1035.0 1018.0 Z M 1045.0 1018.0 A 5 5 0 1 0 1055.0 1018.0 A 5 5 0 1 0 1045.0 1018.0 Z M 1085.0 748.0 A 5 5 0 1 0 1095.0 748.0 A 5 5 0 1 0 1085.0 748.0 Z M 1107.0 748.0 A 5 5 0 1 0 1117.0 748.0 A 5 5 0 1 0 1107.0 748.0 Z M 1129.0 748.0 A 5 5 0 1 0 1139.0 748.0 A 5 5 0 1 0 1129.0 748.0 Z M 1151.0 748.0 A 5 5 0 1 0 1161.0 748.0 A 5 5 0 1 0 1151.0 748.0 Z M 599.0 914.0 A 5 5 0 1 0 609.0 914.0 A 5 5 0 1 0 599.0 914.0 Z M 607.0 914.0 A 5 5 0 1 0 617.0 914.0 A 5 5 0 1 0 607.0 914.0 Z M 615.0 914.0 A 5 5 0 1 0 625.0 914.0 A 5 5 0 1 0 615.0 914.0 Z M 623.0 914.0 A 5 5 0 1 0 633.0 914.0 A 5 5 0 1 0 623.0 914.0 Z M 631.0 914.0 A 5 5 0 1 0 641.0 914.0 A 5 5 0 1 0 631.0 914.0 Z M 599.0 955.0 A 5 5 0 1 0 609.0 955.0 A 5 5 0 1 0 599.0 955.0 Z M 607.0 955.0 A 5 5 0 1 0 617.0 955.0 A 5 5 0 1 0 607.0 955.0 Z M 615.0 955.0 A 5 5 0 1 0 625.0 955.0 A 5 5 0 1 0 615.0 955.0 Z M 623.0 955.0 A 5 5 0 1 0 633.0 955.0 A 5 5 0 1 0 623.0 955.0 Z M 631.0 955.0 A 5 5 0 1 0 641.0 955.0 A 5 5 0 1 0 631.0 955.0 Z M 471.0 812.0 A 5 5 0 1 0 481.0 812.0 A 5 5 0 1 0 471.0 812.0 Z M 471.0 820.0 A 5 5 0 1 0 481.0 820.0 A 5 5 0 1 0 471.0 820.0 Z M 471.0 828.0 A 5 5 0 1 0 481.0 828.0 A 5 5 0 1 0 471.0 828.0 Z M 323.0 870.0 A 5 5 0 1 0 333.0 870.0 A 5 5 0 1 0 323.0 870.0 Z M 323.0 878.0 A 5 5 0 1 0 333.0 878.0 A 5 5 0 1 0 323.0 878.0 Z M 361.0 752.0 A 5 5 0 1 0 371.0 752.0 A 5 5 0 1 0 361.0 752.0 Z M 395.0 1016.0 A 5 5 0 1 0 405.0 1016.0 A 5 5 0 1 0 395.0 1016.0 Z M 403.0 1016.0 A 5 5 0 1 0 413.0 1016.0 A 5 5 0 1 0 403.0 1016.0 Z M 411.0 1016.0 A 5 5 0 1 0 421.0 1016.0 A 5 5 0 1 0 411.0 1016.0 Z M 476.0 538.0 A 5 5 0 1 0 486.0 538.0 A 5 5 0 1 0 476.0 538.0 Z M 476.0 546.0 A 5 5 0 1 0 486.0 546.0 A 5 5 0 1 0 476.0 546.0 Z M 476.0 554.0 A 5 5 0 1 0 486.0 554.0 A 5 5 0 1 0 476.0 554.0 Z M 476.0 562.0 A 5 5 0 1 0 486.0 562.0 A 5 5 0 1 0 476.0 562.0 Z M 321.0 514.0 A 5 5 0 1 0 331.0 514.0 A 5 5 0 1 0 321.0 514.0 Z M 321.0 522.0 A 5 5 0 1 0 331.0 522.0 A 5 5 0 1 0 321.0 522.0 Z M 321.0 530.0 A 5 5 0 1 0 331.0 530.0 A 5 5 0 1 0 321.0 530.0 Z M 321.0 538.0 A 5 5 0 1 0 331.0 538.0 A 5 5 0 1 0 321.0 538.0 Z M 545.0 370.0 A 5 5 0 1 0 555.0 370.0 A 5 5 0 1 0 545.0 370.0 Z";
    }
    // Pistes des puces vers le processeur : le courant y entre quand la puce est branchée.
    for c[i] in 6: inflow := Rectangle {
        // Démarrage : les rayons du logo les remplacent (même direction). Capot posé : dessous.
        visible: !root.lid-down;
        opacity: 1 - root.morph;
        property <float> flow: root.state[i] == 2 ? 1 : 0;
        animate flow { duration: 550ms; easing: ease-in; }
        property <float> x0: root.chips[i].x * 0.62;
        property <float> y0: root.chips[i].y * 0.62;
        property <float> x1: root.chips[i].x * 0.36;
        property <float> y1: root.chips[i].y * 0.36;
        Path {
            x: root.cx - 700 * root.u;
            y: root.cy - 700 * root.u;
            width: 1400 * root.u;
            height: 1400 * root.u;
            viewbox-width: 1400;
            viewbox-height: 1400;
            fill: transparent;
            stroke: root.a1.with-alpha(0.25);
            stroke-width: 3 * root.u;
            commands: "M " + (parent.x0 + 700) + " " + (parent.y0 + 700) + " L " + (parent.x1 + 700) + " " + (parent.y1 + 700);
        }
        if inflow.flow > 0: Path {
            x: root.cx - 700 * root.u;
            y: root.cy - 700 * root.u;
            width: 1400 * root.u;
            height: 1400 * root.u;
            viewbox-width: 1400;
            viewbox-height: 1400;
            fill: transparent;
            stroke: root.a2.with-alpha(min(1, 0.1 + 0.9 * root.bright));
            stroke-width: 3 * root.u;
            stroke-line-cap: round;
            commands: "M " + (parent.x0 + 700) + " " + (parent.y0 + 700) + " L " + (parent.x0 + (parent.x1 - parent.x0) * parent.flow + 700) + " " + (parent.y0 + (parent.y1 - parent.y0) * parent.flow + 700);
        }
    }
    // Support du processeur vide (aucun serveur choisi) : cadre orange qui attend, coins marqués.
    if root.state[6] == 4: Rectangle {
        property <float> pulse: root.live ? 0.5 + 0.5 * sin(mod(animation-tick() / 1ms, 1100) / 1100 * 360deg) : 0.6;
        x: root.cx - 30 * root.u;
        y: root.cy - 30 * root.u;
        width: 60 * root.u;
        height: self.width;
        border-radius: 3 * root.u;
        border-width: 1.5 * root.u;
        border-color: #f59e0b.with-alpha(0.35 + 0.5 * self.pulse);
        background: #f59e0b.with-alpha(0.05 * self.pulse);
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 60;
            viewbox-height: 60;
            fill: transparent;
            stroke: #f59e0b.with-alpha(0.5 + 0.5 * parent.pulse);
            stroke-width: 3 * root.u;
            commands: "M 2 12 L 2 2 L 12 2 M 48 2 L 58 2 L 58 12 M 58 48 L 58 58 L 48 58 M 12 58 L 2 58 L 2 48";
        }
    }
    // Les sept puces : arrivent de l'extérieur et se posent ; diode d'état ; dessin selon le rôle.
    for c[i] in root.chips: chip := Rectangle {
        property <int> s: root.state[i];
        property <bool> cpu: i == 6;
        // À configurer (aucun serveur choisi) : le processeur ne vient pas, son support reste vide.
        property <float> arrive: self.s == 4 ? 0 : self.s >= 1 ? 1 : 0;
        animate arrive { duration: 480ms; easing: cubic-bezier(0.34, 1.4, 0.64, 1); }
        // Processeur : il descend se poser ; repart-il (aucun serveur), il s'efface sur place au lieu de
        // remonter à travers la puce de la langue.
        property <bool> leaving: self.cpu && self.s == 4;
        property <float> dx: self.cpu ? 0 : c.x / 68;
        property <float> dy: self.leaving ? 0 : self.cpu ? -1 : c.y / 68;
        // En fond des pages (bright bas), les puces restent discrètes derrière le contenu.
        opacity: (self.leaving ? self.arrive : 1) * min(1, 0.1 + 0.9 * root.bright) * (1 - root.gone);
        // Logo : plot rond de 28 (anneau du logo : rayon 11, trait 6) ; processeur : puce de 65 (60, trait 5).
        property <length> w: ((self.cpu ? 52 : 44) + ((self.cpu ? 65 : 28) - (self.cpu ? 52 : 44)) * root.morph) * root.u;
        property <length> h: ((self.cpu ? 52 : 32) + ((self.cpu ? 65 : 28) - (self.cpu ? 52 : 32)) * root.morph) * root.u;
        visible: self.arrive > 0.01 && root.gone < 0.999 && !root.lid-down;
        x: root.cx + (c.x + self.dx * 130 * (1 - self.arrive)) * root.u - self.w / 2;
        y: root.cy + (c.y + self.dy * 130 * (1 - self.arrive)) * root.u - self.h / 2;
        width: self.w;
        height: self.h;
        border-radius: (3 + ((self.cpu ? 0 : 14) - 3) * root.morph) * root.u;
        background: @linear-gradient(135deg, #0f2a1c 0%, #06150d 100%);
        border-width: 1 * root.u;
        border-color: self.s == 2 ? root.a2.with-alpha(0.8) : root.a2.with-alpha(0.35);
        drop-shadow-blur: self.s == 2 ? (self.cpu ? 28 : 12) * root.u * (0.5 + 0.5 * root.bright) : 0px;
        drop-shadow-color: root.a2.with-alpha(0.55);
        // Pattes (rentrées quand la puce devient un plot du logo).
        Path {
            opacity: 1 - root.morph;
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: transparent;
            stroke: root.a1.with-alpha(0.7);
            stroke-width: 1 * root.u;
            commands: "M 8 0 L 8 -4 M 15 0 L 15 -4 M 22 0 L 22 -4 M 29 0 L 29 -4 M 36 0 L 36 -4 M 8 32 L 8 36 M 15 32 L 15 36 M 22 32 L 22 36 M 29 32 L 29 36 M 36 32 L 36 36";
        }
        property <color> ic: self.s == 2 ? root.a2 : root.a2.with-alpha(0.45);
        // 0 Langue : « Aa ».
        if i == 0: Text {
            text: "Aa";
            color: parent.ic;
            font-size: 15 * root.u;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // 1 Affichage : un écran sur son pied.
        if i == 1: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: transparent;
            stroke: parent.ic;
            stroke-width: 1.6 * root.u;
            commands: "M 11 7 L 33 7 L 33 21 L 11 21 Z M 22 21 L 22 25 M 16 25 L 28 25";
        }
        // 2 Lecteur vidéo : bouton lecture.
        if i == 2: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: parent.ic;
            commands: "M 17 8 L 30 16 L 17 24 Z";
        }
        // 3 Stockage : barrette de mémoire (puces en rang).
        if i == 3: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: parent.ic;
            commands: "M 7 11 L 14 11 L 14 21 L 7 21 Z M 16 11 L 23 11 L 23 21 L 16 21 Z M 25 11 L 32 11 L 32 21 L 25 21 Z M 34 13 L 38 13 L 38 19 L 34 19 Z";
        }
        // 4 Configuration : engrenage.
        if i == 4: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: transparent;
            stroke: parent.ic;
            stroke-width: 1.6 * root.u;
            commands: "M 22 9 L 22 6 M 22 23 L 22 26 M 15 16 L 12 16 M 29 16 L 32 16 M 17 11 L 15 9 M 27 21 L 29 23 M 27 11 L 29 9 M 17 21 L 15 23 M 27 16 A 5 5 0 1 0 17 16 A 5 5 0 1 0 27 16 Z";
        }
        // 5 Réseau : antenne et ondes.
        if i == 5: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: transparent;
            stroke: parent.ic;
            stroke-width: 1.6 * root.u;
            stroke-line-cap: round;
            commands: "M 22 15 L 22 26 M 17 10 A 7 7 0 0 1 27 10 M 14 7 A 11 11 0 0 1 30 7 M 22 15 L 22 14";
        }
        // 6 Processeur (le serveur) : la puce, son cœur et ses pistes internes.
        if i == 6: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 52;
            viewbox-height: 52;
            fill: transparent;
            stroke: parent.ic;
            stroke-width: 1.4 * root.u;
            commands: "M 14 14 L 38 14 L 38 38 L 14 38 Z M 20 20 L 32 20 L 32 32 L 20 32 Z M 8 20 L 14 20 M 8 26 L 14 26 M 8 32 L 14 32 M 38 20 L 44 20 M 38 26 L 44 26 M 38 32 L 44 32 M 20 8 L 20 14 M 26 8 L 26 14 M 32 8 L 32 14 M 20 38 L 20 44 M 26 38 L 26 44 M 32 38 L 32 44";
        }
        if i == 6 && chip.s == 2: Rectangle {
            x: parent.width * 0.38;
            y: parent.height * 0.38;
            width: parent.width * 0.24;
            height: self.width;
            background: root.a2.with-alpha(0.7);
        }
        // Diode d'état.
        Rectangle {
            x: parent.width - 8 * root.u;
            y: 3 * root.u;
            width: 5 * root.u;
            height: self.width;
            border-radius: self.width / 2;
            background: parent.s == 2 ? #4dff9a : parent.s == 3 || parent.s == 5 ? #ff5c5c : parent.s == 4 ? #ffc23d : root.a2.with-alpha(0.6);
            drop-shadow-blur: 5 * root.u;
            drop-shadow-color: self.background;
        }
        // Devenir le logo : le plot (fond de la page, anneau d'accent) ou la puce du serveur (cœur
        // d'accent) recouvre peu à peu la puce.
        if root.morph > 0.001: Rectangle {
            opacity: root.morph;
            border-radius: parent.border-radius;
            background: chip.cpu ? Theme.accent1.mix(Theme.bg, 0.25) : Theme.bg;
            border-width: (chip.cpu ? 5 : 6) * root.u;
            border-color: Theme.accent2;
            if chip.cpu: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24 * root.u;
                height: self.width;
                background: Theme.accent1;
            }
        }
    }
    // Capot : substrat vert et ses condensateurs, plaque de métal, logo gravé (reflet et creux), repère
    // de la broche 1. Il descend se poser (un peu plus grand au départ) pendant qu'il apparaît.
    if root.lid-on: Rectangle {
        property <float> e: 1 - (1 - root.lid) * (1 - root.lid);
        x: root.cx - 100 * root.u;
        y: root.cy - 100 * root.u;
        width: 200 * root.u;
        height: 200 * root.u;
        // Opaque (les pistes ne se voient pas à travers) ; en fond des pages, assombri par-dessus.
        opacity: self.e;
        transform-scale: 1.25 - 0.25 * self.e;
        Rectangle {
            border-radius: 7 * root.u;
            background: #0b2215;
            border-width: 1 * root.u;
            border-color: root.a1.with-alpha(0.55);
            drop-shadow-blur: 16 * root.u;
            drop-shadow-color: #000000a0;
        }
        Path {
            viewbox-width: 200;
            viewbox-height: 200;
            fill: #c9a24a.with-alpha(0.85);
            commands: "M 6 30 L 11 30 L 11 38 L 6 38 Z M 6 44 L 11 44 L 11 52 L 6 52 Z M 189 148 L 194 148 L 194 156 L 189 156 Z M 189 162 L 194 162 L 194 170 L 189 170 Z M 148 6 L 156 6 L 156 11 L 148 11 Z M 44 189 L 52 189 L 52 194 L 44 194 Z";
        }
        Rectangle {
            x: 16 * root.u;
            y: 16 * root.u;
            width: 168 * root.u;
            height: 168 * root.u;
            border-radius: 12 * root.u;
            background: @linear-gradient(135deg, #d3d9dc 0%, #9aa3a8 42%, #6f787d 100%);
            border-width: 1 * root.u;
            border-color: #eef3f5.with-alpha(0.7);
            // Reflet brossé, en diagonale.
            Rectangle {
                border-radius: parent.border-radius;
                background: @linear-gradient(135deg, rgba(255, 255, 255, 0.0) 30%, rgba(255, 255, 255, 0.22) 48%, rgba(255, 255, 255, 0.0) 62%);
            }
            // Logo gravé : reflet clair décalé, puis le creux sombre.
            for g in 2: Rectangle {
                x: (168 - 140) / 2 * root.u + (g == 0 ? 0.8 : 0) * root.u;
                y: (168 - 140) / 2 * root.u + (g == 0 ? 0.8 : 0) * root.u;
                width: 140 * root.u;
                height: 140 * root.u;
                property <color> ink: g == 0 ? rgba(255, 255, 255, 0.45) : rgba(30, 36, 40, 0.55);
                Path {
                    viewbox-width: 256;
                    viewbox-height: 256;
                    fill: transparent;
                    stroke: parent.ink;
                    stroke-width: 9 * 140 / 256 * root.u;
                    stroke-line-join: round;
                    commands: "M 128 60 L 187 94 L 187 162 L 128 196 L 69 162 L 69 94 Z M 128 60 L 128 98 M 187 94 L 154 113 M 187 162 L 154 143 M 128 196 L 128 158 M 69 162 L 102 143 M 69 94 L 102 113";
                }
                Path {
                    viewbox-width: 256;
                    viewbox-height: 256;
                    fill: transparent;
                    stroke: parent.ink;
                    stroke-width: 6 * 140 / 256 * root.u;
                    commands: "M 117 60 A 11 11 0 1 0 139 60 A 11 11 0 1 0 117 60 Z M 176 94 A 11 11 0 1 0 198 94 A 11 11 0 1 0 176 94 Z M 176 162 A 11 11 0 1 0 198 162 A 11 11 0 1 0 176 162 Z M 117 196 A 11 11 0 1 0 139 196 A 11 11 0 1 0 117 196 Z M 58 162 A 11 11 0 1 0 80 162 A 11 11 0 1 0 58 162 Z M 58 94 A 11 11 0 1 0 80 94 A 11 11 0 1 0 58 94 Z M 98 98 L 158 98 L 158 158 L 98 158 Z";
                }
            }
            Text {
                y: parent.height - 24 * root.u;
                width: parent.width;
                text: "TURTLEFIN";
                color: rgba(30, 36, 40, 0.5);
                font-size: 10 * root.u;
                font-weight: 800;
                letter-spacing: 2 * root.u;
                horizontal-alignment: center;
            }
            // Broche 1.
            Path {
                viewbox-width: 168;
                viewbox-height: 168;
                fill: rgba(30, 36, 40, 0.45);
                commands: "M 10 158 L 10 144 L 24 158 Z";
            }
        }
        // Fond des pages (bright bas) : tout le capot plus sombre, discret derrière le contenu.
        Rectangle {
            border-radius: 7 * root.u;
            background: #000000.with-alpha(0.62 * (1 - min(1, root.bright)));
        }
    }
    // Bords assombris (pages lisibles).
    Rectangle {
        background: @radial-gradient(circle, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.7) 100%);
    }
}

// Décor 4 (thème Turtlefin) : l'hexagone du logo en anneaux concentriques, une trame régulière de
// points en nid d'abeilles (plus nette au centre) et le lavis violet -> bleu à 130° du style de base
// (JellySkin). Tout est symétrique par rapport au centre. Partie fixe : dessinée une fois (voir
// AeroSky) ; ce qui bouge est dans HexDrift, à part.
// Les tracés gardent le format 16:9 (centrés, rognés) : étirés, les hexagones se déformeraient.
component HexScene inherits Rectangle {
    clip: true;
    // Lavis diagonal (130°, comme les dégradés d'accent du style de base).
    Rectangle {
        background: @linear-gradient(130deg, Theme.accent1.with-alpha(0.13) 0%, Theme.accent1.with-alpha(0) 42%, Theme.accent2.with-alpha(0) 58%, Theme.accent2.with-alpha(0.13) 100%);
    }
    Rectangle {
        width: max(parent.width, parent.height * 16 / 9);
        height: self.width * 9 / 16;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1600;
            viewbox-height: 900;
            fill: transparent;
            stroke: Theme.accent2.with-alpha(0.16);
            stroke-width: 1.2px;
            commands: "M 800.0 300.0 L 929.9 375.0 L 929.9 525.0 L 800.0 600.0 L 670.1 525.0 L 670.1 375.0 Z";
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1600;
            viewbox-height: 900;
            fill: transparent;
            stroke: Theme.accent1.with-alpha(0.13);
            stroke-width: 1.2px;
            commands: "M 800.0 190.0 L 1025.2 320.0 L 1025.2 580.0 L 800.0 710.0 L 574.8 580.0 L 574.8 320.0 Z";
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1600;
            viewbox-height: 900;
            fill: transparent;
            stroke: Theme.accent2.with-alpha(0.1);
            stroke-width: 1.1px;
            commands: "M 800.0 60.0 L 1137.7 255.0 L 1137.7 645.0 L 800.0 840.0 L 462.3 645.0 L 462.3 255.0 Z";
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1600;
            viewbox-height: 900;
            fill: transparent;
            stroke: Theme.accent1.with-alpha(0.075);
            stroke-width: 1.0px;
            commands: "M 800.0 -90.0 L 1267.7 180.0 L 1267.7 720.0 L 800.0 990.0 L 332.3 720.0 L 332.3 180.0 Z";
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1600;
            viewbox-height: 900;
            fill: transparent;
            stroke: Theme.accent2.with-alpha(0.05);
            stroke-width: 1.0px;
            commands: "M 800.0 -270.0 L 1423.5 90.0 L 1423.5 810.0 L 800.0 1170.0 L 176.5 810.0 L 176.5 90.0 Z";
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1600;
            viewbox-height: 900;
            fill: rgba(200, 220, 255, 0.20);
