    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 1600;
        viewbox-height: 900;
        fill: Theme.bg.with-alpha(0.6);
        stroke: Theme.accent1.with-alpha(0.22);
        stroke-width: 2px;
