.0 A 5 5 0 1 0 641.0 914.0 A 5 5 0 1 0 631.0 914.0 Z M 599.0 955.0 A 5 5 0 1 0 609.0 955.0 A 5 5 0 1 0 599.0 955.0 Z M 607.0 955.0 A 5 5 0 1 0 617.0 955.0 A 5 5 0 1 0 607.0 955.0 Z M 615.0 955.0 A 5 5 0 1 0 625.0 955.0 A 5 5 0 1 0 615.0 955.0 Z M 623.0 955.0 A 5 5 0 1 0 633.0 955.0 A 5 5 0 1 0 623.0 955.0 Z M 631.0 955.0 A 5 5 0 1 0 641.0 955.0 A 5 5 0 1 0 631.0 955.0 Z M 471.0 812.0 A 5 5 0 1 0 481.0 812.0 A 5 5 0 1 0 471.0 812.0 Z M 471.0 820.0 A 5 5 0 1 0 481.0 820.0 A 5 5 0 1 0 471.0 820.0 Z M 471.0 828.0 A 5 5 0 1 0 481.0 828.0 A 5 5 0 1 0 471.0 828.0 Z M 323.0 870.0 A 5 5 0 1 0 333.0 870.0 A 5 5 0 1 0 323.0 870.0 Z M 323.0 878.0 A 5 5 0 1 0 333.0 878.0 A 5 5 0 1 0 323.0 878.0 Z M 361.0 752.0 A 5 5 0 1 0 371.0 752.0 A 5 5 0 1 0 361.0 752.0 Z M 395.0 1016.0 A 5 5 0 1 0 405.0 1016.0 A 5 5 0 1 0 395.0 1016.0 Z M 403.0 1016.0 A 5 5 0 1 0 413.0 1016.0 A 5 5 0 1 0 403.0 1016.0 Z M 411.0 1016.0 A 5 5 0 1 0 421.0 1016.0 A 5 5 0 1 0 411.0 1016.0 Z M 476.0 538.0 A 5 5 0 1 0 486.0 538.0 A 5 5 0 1 0 476.0 538.0 Z M 476.0 546.0 A 5 5 0 1 0 486.0 546.0 A 5 5 0 1 0 476.0 546.0 Z M 476.0 554.0 A 5 5 0 1 0 486.0 554.0 A 5 5 0 1 0 476.0 554.0 Z M 476.0 562.0 A 5 5 0 1 0 486.0 562.0 A 5 5 0 1 0 476.0 562.0 Z M 321.0 514.0 A 5 5 0 1 0 331.0 514.0 A 5 5 0 1 0 321.0 514.0 Z M 321.0 522.0 A 5 5 0 1 0 331.0 522.0 A 5 5 0 1 0 321.0 522.0 Z M 321.0 530.0 A 5 5 0 1 0 331.0 530.0 A 5 5 0 1 0 321.0 530.0 Z M 321.0 538.0 A 5 5 0 1 0 331.0 538.0 A 5 5 0 1 0 321.0 538.0 Z M 545.0 370.0 A 5 5 0 1 0 555.0 370.0 A 5 5 0 1 0 545.0 370.0 Z";
    }
    // Pistes des puces vers le processeur : le courant y entre quand la puce est branchée.
    for c[i] in 6: inflow := Rectangle {
        property <float> flow: root.state[i] == 2 ? 1 : 0;
        animate flow { duration: 550ms; easing: ease-in; }
        property <float> x0: root.chips[i].x * 0.62;
        property <float> y0: root.chips[i].y * 0.62;
        property <float> x1: root.chips[i].x * 0.36;
        property <float> y1: root.chips[i].y * 0.36;
        Path {
            x: root.cx - 700 * root.u;
            y: root.cy - 700 * root.u;
            width: 1400 * root.u;
            height: 1400 * root.u;
            viewbox-width: 1400;
            viewbox-height: 1400;
            fill: transparent;
            stroke: Theme.accent1.with-alpha(0.25);
            stroke-width: 3 * root.u;
            commands: "M " + (parent.x0 + 700) + " " + (parent.y0 + 700) + " L " + (parent.x1 + 700) + " " + (parent.y1 + 700);
        }
        if inflow.flow > 0: Path {
            x: root.cx - 700 * root.u;
            y: root.cy - 700 * root.u;
            width: 1400 * root.u;
            height: 1400 * root.u;
            viewbox-width: 1400;
            viewbox-height: 1400;
            fill: transparent;
            stroke: Theme.accent2;
            stroke-width: 3 * root.u;
            stroke-line-cap: round;
            commands: "M " + (parent.x0 + 700) + " " + (parent.y0 + 700) + " L " + (parent.x0 + (parent.x1 - parent.x0) * parent.flow + 700) + " " + (parent.y0 + (parent.y1 - parent.y0) * parent.flow + 700);
        }
    }
    // Support du processeur vide (aucun serveur choisi) : cadre orange qui attend, coins marqués.
    if root.state[6] == 4: Rectangle {
        property <float> pulse: root.live ? 0.5 + 0.5 * sin(mod(animation-tick() / 1ms, 1100) / 1100 * 360deg) : 0.6;
        x: root.cx - 30 * root.u;
        y: root.cy - 30 * root.u;
        width: 60 * root.u;
        height: self.width;
        border-radius: 3 * root.u;
        border-width: 1.5 * root.u;
        border-color: #f59e0b.with-alpha(0.35 + 0.5 * self.pulse);
        background: #f59e0b.with-alpha(0.05 * self.pulse);
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 60;
            viewbox-height: 60;
            fill: transparent;
            stroke: #f59e0b.with-alpha(0.5 + 0.5 * parent.pulse);
            stroke-width: 3 * root.u;
            commands: "M 2 12 L 2 2 L 12 2 M 48 2 L 58 2 L 58 12 M 58 48 L 58 58 L 48 58 M 12 58 L 2 58 L 2 48";
        }
    }
    // Les sept puces : arrivent de l'extérieur et se posent ; diode d'état ; dessin selon le rôle.
    for c[i] in root.chips: chip := Rectangle {
        property <int> s: root.state[i];
        property <bool> cpu: i == 6;
        // À configurer (aucun serveur choisi) : le processeur ne vient pas, son support reste vide.
        property <float> arrive: self.s == 4 ? 0 : self.s >= 1 ? 1 : 0;
        animate arrive { duration: 480ms; easing: cubic-bezier(0.34, 1.4, 0.64, 1); }
        // Processeur : il descend se poser ; repart-il (aucun serveur), il s'efface sur place au lieu de
        // remonter à travers la puce de la langue.
        property <bool> leaving: self.cpu && self.s == 4;
        property <float> dx: self.cpu ? 0 : c.x / 68;
        property <float> dy: self.leaving ? 0 : self.cpu ? -1 : c.y / 68;
        opacity: self.leaving ? self.arrive : 1;
        property <length> w: (self.cpu ? 52 : 44) * root.u;
        property <length> h: (self.cpu ? 52 : 32) * root.u;
        visible: self.arrive > 0.01;
        x: root.cx + (c.x + self.dx * 130 * (1 - self.arrive)) * root.u - self.w / 2;
        y: root.cy + (c.y + self.dy * 130 * (1 - self.arrive)) * root.u - self.h / 2;
        width: self.w;
        height: self.h;
        border-radius: 3 * root.u;
        background: @linear-gradient(135deg, #0f2a1c 0%, #06150d 100%);
        border-width: 1 * root.u;
        border-color: self.s == 2 ? Theme.accent2.with-alpha(0.8) : Theme.accent2.with-alpha(0.35);
        drop-shadow-blur: self.s == 2 ? (self.cpu ? 28 : 12) * root.u * (0.5 + 0.5 * root.bright) : 0px;
        drop-shadow-color: Theme.accent2.with-alpha(0.55);
        // Pattes.
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: transparent;
            stroke: Theme.accent1.with-alpha(0.7);
            stroke-width: 1 * root.u;
            commands: "M 8 0 L 8 -4 M 15 0 L 15 -4 M 22 0 L 22 -4 M 29 0 L 29 -4 M 36 0 L 36 -4 M 8 32 L 8 36 M 15 32 L 15 36 M 22 32 L 22 36 M 29 32 L 29 36 M 36 32 L 36 36";
        }
        property <color> ic: self.s == 2 ? Theme.accent2 : Theme.accent2.with-alpha(0.45);
        // 0 Langue : « Aa ».
        if i == 0: Text {
            text: "Aa";
            color: parent.ic;
            font-size: 15 * root.u;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // 1 Affichage : un écran sur son pied.
        if i == 1: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: transparent;
            stroke: parent.ic;
            stroke-width: 1.6 * root.u;
            commands: "M 11 7 L 33 7 L 33 21 L 11 21 Z M 22 21 L 22 25 M 16 25 L 28 25";
        }
        // 2 Lecteur vidéo : bouton lecture.
        if i == 2: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: parent.ic;
            commands: "M 17 8 L 30 16 L 17 24 Z";
        }
        // 3 Stockage : barrette de mémoire (puces en rang).
        if i == 3: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: parent.ic;
            commands: "M 7 11 L 14 11 L 14 21 L 7 21 Z M 16 11 L 23 11 L 23 21 L 16 21 Z M 25 11 L 32 11 L 32 21 L 25 21 Z M 34 13 L 38 13 L 38 19 L 34 19 Z";
        }
        // 4 Configuration : engrenage.
        if i == 4: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: transparent;
            stroke: parent.ic;
            stroke-width: 1.6 * root.u;
            commands: "M 22 9 L 22 6 M 22 23 L 22 26 M 15 16 L 12 16 M 29 16 L 32 16 M 17 11 L 15 9 M 27 21 L 29 23 M 27 11 L 29 9 M 17 21 L 15 23 M 27 16 A 5 5 0 1 0 17 16 A 5 5 0 1 0 27 16 Z";
        }
        // 5 Réseau : antenne et ondes.
        if i == 5: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: transparent;
            stroke: parent.ic;
            stroke-width: 1.6 * root.u;
            stroke-line-cap: round;
            commands: "M 22 15 L 22 26 M 17 10 A 7 7 0 0 1 27 10 M 14 7 A 11 11 0 0 1 30 7 M 22 15 L 22 14";
        }
        // 6 Processeur (le serveur) : la puce, son cœur et ses pistes internes.
        if i == 6: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 52;
            viewbox-height: 52;
            fill: transparent;
            stroke: parent.ic;
            stroke-width: 1.4 * root.u;
            commands: "M 14 14 L 38 14 L 38 38 L 14 38 Z M 20 20 L 32 20 L 32 32 L 20 32 Z M 8 20 L 14 20 M 8 26 L 14 26 M 8 32 L 14 32 M 38 20 L 44 20 M 38 26 L 44 26 M 38 32 L 44 32 M 20 8 L 20 14 M 26 8 L 26 14 M 32 8 L 32 14 M 20 38 L 20 44 M 26 38 L 26 44 M 32 38 L 32 44";
        }
        if i == 6 && chip.s == 2: Rectangle {
            x: parent.width * 0.38;
            y: parent.height * 0.38;
            width: parent.width * 0.24;
            height: self.width;
            background: Theme.accent2.with-alpha(0.7);
        }
        // Diode d'état.
        Rectangle {
            x: parent.width - 8 * root.u;
            y: 3 * root.u;
            width: 5 * root.u;
            height: self.width;
            border-radius: self.width / 2;
            background: parent.s == 2 ? #4dff9a : parent.s == 3 ? #ff5c5c : parent.s == 4 ? #ffc23d : Theme.accent2.with-alpha(0.6);
            drop-shadow-blur: 5 * root.u;
            drop-shadow-color: self.background;
        }
    }
    // Bords assombris (pages lisibles).
    Rectangle {
        background: @radial-gradient(circle, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.7) 100%);
    }
}

// Profondeurs marines (décor 4, thème Turtlefin) : rayons de lumière qui tombent de la surface, lueurs
// violette et bleue, plancton en suspension. Fixe (dessiné une fois, voir AeroSky).
component AbyssScene inherits Rectangle {
    // Rayons de lumière.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 1600;
        viewbox-height: 900;
        // Teinte unie : un dégradé sur un tracé est mal calé par le moteur de rendu (marche visible).
        fill: Theme.accent2.with-alpha(0.045);
        commands: "M 200 0 L 234 0 L 541 900 L 366 900 Z M 414 0 L 437 0 L 717 900 L 528 900 Z M 571 0 L 599 0 L 892 900 L 755 900 Z M 721 0 L 749 0 L 1027 900 L 871 900 Z M 930 0 L 963 0 L 1238 900 L 1054 900 Z M 1211 0 L 1230 0 L 1537 900 L 1376 900 Z M 1416 0 L 1436 0 L 1663 900 L 1518 900 Z";
    }
    // Lueurs diffuses (violet à gauche, bleu à droite).
    Rectangle {
        x: parent.width * -0.15;
        y: parent.height * 0.35;
        width: parent.width * 0.6;
        height: self.width;
        background: @radial-gradient(circle, Theme.accent1.with-alpha(0.13) 0%, Theme.accent1.with-alpha(0) 65%);
    }
    Rectangle {
        x: parent.width * 0.6;
        y: parent.height * 0.1;
        width: parent.width * 0.55;
        height: self.width;
        background: @radial-gradient(circle, Theme.accent2.with-alpha(0.10) 0%, Theme.accent2.with-alpha(0) 65%);
    }
    // Plancton.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 1600;
        viewbox-height: 900;
        fill: rgba(190, 225, 255, 0.28);
