// Décor du thème, sur l'image de fond du média et sous les pages.
export component AeroSky inherits Rectangle {
    in property <float> k: 1.0;
    // Décor fixe : dessiné une fois dans une image gardée par le moteur de rendu, puis recopié tel
    // quel à chaque image (bulles, dégradés et courbes coûtent sinon à chaque rafraîchissement).
    cache-rendering-hint: true;
    if Theme.scenery == 1: SkyScene { }
    if Theme.scenery == 2: HarmonyScene { }
    if Theme.scenery == 3: CircuitScene { }
    if Theme.scenery == 4: StarScene { }
}
