4.0 562.0 L 356.0 554.0 L 348.0 546.0 L 340.0 538.0 L 326.0 538.0 M 450 530 L 450.0 512.0 L 450.0 484.0 L 464.3 469.7 L 478.6 455.4 L 492.9 441.1 L 507.1 426.9 L 521.4 412.6 L 535.7 398.3 L 550.0 384.0 L 550.0 370.0";
    }
    if root.surge >= 1: Path {
        x: root.cx - 700 * root.u;
        y: root.cy - 700 * root.u;
        width: 1400 * root.u;
        height: 1400 * root.u;
        viewbox-width: 1400;
        viewbox-height: 1400;
        fill: root.a2.with-alpha(0.7 * root.bright);
        commands: "M 803.0 508.0 A 5 5 0 1 0 813.0 508.0 A 5 5 0 1 0 803.0 508.0 Z M 811.0 508.0 A 5 5 0 1 0 821.0 508.0 A 5 5 0 1 0 811.0 508.0 Z M 819.0 508.0 A 5 5 0 1 0 829.0 508.0 A 5 5 0 1 0 819.0 508.0 Z M 827.0 508.0 A 5 5 0 1 0 837.0 508.0 A 5 5 0 1 0 827.0 508.0 Z M 869.0 370.0 A 5 5 0 1 0 879.0 370.0 A 5 5 0 1 0 869.0 370.0 Z M 877.0 370.0 A 5 5 0 1 0 887.0 370.0 A 5 5 0 1 0 877.0 370.0 Z M 885.0 370.0 A 5 5 0 1 0 895.0 370.0 A 5 5 0 1 0 885.0 370.0 Z M 999.0 568.0 A 5 5 0 1 0 1009.0 568.0 A 5 5 0 1 0 999.0 568.0 Z M 999.0 576.0 A 5 5 0 1 0 1009.0 576.0 A 5 5 0 1 0 999.0 576.0 Z M 999.0 584.0 A 5 5 0 1 0 1009.0 584.0 A 5 5 0 1 0 999.0 584.0 Z M 999.0 592.0 A 5 5 0 1 0 1009.0 592.0 A 5 5 0 1 0 999.0 592.0 Z M 924.0 804.0 A 5 5 0 1 0 934.0 804.0 A 5 5 0 1 0 924.0 804.0 Z M 924.0 812.0 A 5 5 0 1 0 934.0 812.0 A 5 5 0 1 0 924.0 812.0 Z M 924.0 820.0 A 5 5 0 1 0 934.0 820.0 A 5 5 0 1 0 924.0 820.0 Z M 924.0 828.0 A 5 5 0 1 0 934.0 828.0 A 5 5 0 1 0 924.0 828.0 Z M 924.0 836.0 A 5 5 0 1 0 934.0 836.0 A 5 5 0 1 0 924.0 836.0 Z M 995.0 1018.0 A 5 5 0 1 0 1005.0 1018.0 A 5 5 0 1 0 995.0 1018.0 Z M 1005.0 1018.0 A 5 5 0 1 0 1015.0 1018.0 A 5 5 0 1 0 1005.0 1018.0 Z M 1015.0 1018.0 A 5 5 0 1 0 1025.0 1018.0 A 5 5 0 1 0 1015.0 1018.0 Z M 1025.0 1018.0 A 5 5 0 1 0 1035.0 1018.0 A 5 5 0 1 0 1025.0 1018.0 Z M 1035.0 1018.0 A 5 5 0 1 0 1045.0 1018.0 A 5 5 0 1 0 1035.0 1018.0 Z M 1045.0 1018.0 A 5 5 0 1 0 1055.0 1018.0 A 5 5 0 1 0 1045.0 1018.0 Z M 1085.0 748.0 A 5 5 0 1 0 1095.0 748.0 A 5 5 0 1 0 1085.0 748.0 Z M 1107.0 748.0 A 5 5 0 1 0 1117.0 748.0 A 5 5 0 1 0 1107.0 748.0 Z M 1129.0 748.0 A 5 5 0 1 0 1139.0 748.0 A 5 5 0 1 0 1129.0 748.0 Z M 1151.0 748.0 A 5 5 0 1 0 1161.0 748.0 A 5 5 0 1 0 1151.0 748.0 Z M 599.0 914.0 A 5 5 0 1 0 609.0 914.0 A 5 5 0 1 0 599.0 914.0 Z M 607.0 914.0 A 5 5 0 1 0 617.0 914.0 A 5 5 0 1 0 607.0 914.0 Z M 615.0 914.0 A 5 5 0 1 0 625.0 914.0 A 5 5 0 1 0 615.0 914.0 Z M 623.0 914.0 A 5 5 0 1 0 633.0 914.0 A 5 5 0 1 0 623.0 914.0 Z M 631.0 914.0 A 5 5 0 1 0 641.0 914.0 A 5 5 0 1 0 631.0 914.0 Z M 599.0 955.0 A 5 5 0 1 0 609.0 955.0 A 5 5 0 1 0 599.0 955.0 Z M 607.0 955.0 A 5 5 0 1 0 617.0 955.0 A 5 5 0 1 0 607.0 955.0 Z M 615.0 955.0 A 5 5 0 1 0 625.0 955.0 A 5 5 0 1 0 615.0 955.0 Z M 623.0 955.0 A 5 5 0 1 0 633.0 955.0 A 5 5 0 1 0 623.0 955.0 Z M 631.0 955.0 A 5 5 0 1 0 641.0 955.0 A 5 5 0 1 0 631.0 955.0 Z M 471.0 812.0 A 5 5 0 1 0 481.0 812.0 A 5 5 0 1 0 471.0 812.0 Z M 471.0 820.0 A 5 5 0 1 0 481.0 820.0 A 5 5 0 1 0 471.0 820.0 Z M 471.0 828.0 A 5 5 0 1 0 481.0 828.0 A 5 5 0 1 0 471.0 828.0 Z M 323.0 870.0 A 5 5 0 1 0 333.0 870.0 A 5 5 0 1 0 323.0 870.0 Z M 323.0 878.0 A 5 5 0 1 0 333.0 878.0 A 5 5 0 1 0 323.0 878.0 Z M 361.0 752.0 A 5 5 0 1 0 371.0 752.0 A 5 5 0 1 0 361.0 752.0 Z M 395.0 1016.0 A 5 5 0 1 0 405.0 1016.0 A 5 5 0 1 0 395.0 1016.0 Z M 403.0 1016.0 A 5 5 0 1 0 413.0 1016.0 A 5 5 0 1 0 403.0 1016.0 Z M 411.0 1016.0 A 5 5 0 1 0 421.0 1016.0 A 5 5 0 1 0 411.0 1016.0 Z M 476.0 538.0 A 5 5 0 1 0 486.0 538.0 A 5 5 0 1 0 476.0 538.0 Z M 476.0 546.0 A 5 5 0 1 0 486.0 546.0 A 5 5 0 1 0 476.0 546.0 Z M 476.0 554.0 A 5 5 0 1 0 486.0 554.0 A 5 5 0 1 0 476.0 554.0 Z M 476.0 562.0 A 5 5 0 1 0 486.0 562.0 A 5 5 0 1 0 476.0 562.0 Z M 321.0 514.0 A 5 5 0 1 0 331.0 514.0 A 5 5 0 1 0 321.0 514.0 Z M 321.0 522.0 A 5 5 0 1 0 331.0 522.0 A 5 5 0 1 0 321.0 522.0 Z M 321.0 530.0 A 5 5 0 1 0 331.0 530.0 A 5 5 0 1 0 321.0 530.0 Z M 321.0 538.0 A 5 5 0 1 0 331.0 538.0 A 5 5 0 1 0 321.0 538.0 Z M 545.0 370.0 A 5 5 0 1 0 555.0 370.0 A 5 5 0 1 0 545.0 370.0 Z";
    }
    // Pistes des puces vers le processeur : le courant y entre quand la puce est branchée.
    for c[i] in 6: inflow := Rectangle {
        // Démarrage : les rayons du logo les remplacent (même direction). Capot posé : dessous.
        visible: !root.lid-down;
        opacity: 1 - root.morph;
        property <float> flow: root.state[i] == 2 ? 1 : 0;
        animate flow { duration: 550ms; easing: ease-in; }
        property <float> x0: root.chips[i].x * 0.62;
        property <float> y0: root.chips[i].y * 0.62;
        property <float> x1: root.chips[i].x * 0.36;
        property <float> y1: root.chips[i].y * 0.36;
        Path {
            x: root.cx - 700 * root.u;
            y: root.cy - 700 * root.u;
            width: 1400 * root.u;
            height: 1400 * root.u;
            viewbox-width: 1400;
            viewbox-height: 1400;
            fill: transparent;
            stroke: root.a1.with-alpha(0.25);
            stroke-width: 3 * root.u;
            commands: "M " + (parent.x0 + 700) + " " + (parent.y0 + 700) + " L " + (parent.x1 + 700) + " " + (parent.y1 + 700);
        }
        if inflow.flow > 0: Path {
            x: root.cx - 700 * root.u;
            y: root.cy - 700 * root.u;
            width: 1400 * root.u;
            height: 1400 * root.u;
            viewbox-width: 1400;
            viewbox-height: 1400;
            fill: transparent;
            stroke: root.a2.with-alpha(min(1, 0.1 + 0.9 * root.bright));
            stroke-width: 3 * root.u;
            stroke-line-cap: round;
            commands: "M " + (parent.x0 + 700) + " " + (parent.y0 + 700) + " L " + (parent.x0 + (parent.x1 - parent.x0) * parent.flow + 700) + " " + (parent.y0 + (parent.y1 - parent.y0) * parent.flow + 700);
        }
    }
    // Support du processeur vide (aucun serveur choisi) : cadre orange qui attend, coins marqués.
    if root.state[6] == 4: Rectangle {
        property <float> pulse: root.live ? 0.5 + 0.5 * sin(mod(animation-tick() / 1ms, 1100) / 1100 * 360deg) : 0.6;
        x: root.cx - 30 * root.u;
        y: root.cy - 30 * root.u;
        width: 60 * root.u;
        height: self.width;
        border-radius: 3 * root.u;
        border-width: 1.5 * root.u;
        border-color: #f59e0b.with-alpha(0.35 + 0.5 * self.pulse);
        background: #f59e0b.with-alpha(0.05 * self.pulse);
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 60;
            viewbox-height: 60;
            fill: transparent;
            stroke: #f59e0b.with-alpha(0.5 + 0.5 * parent.pulse);
            stroke-width: 3 * root.u;
            commands: "M 2 12 L 2 2 L 12 2 M 48 2 L 58 2 L 58 12 M 58 48 L 58 58 L 48 58 M 12 58 L 2 58 L 2 48";
        }
    }
    // Les sept puces : arrivent de l'extérieur et se posent ; diode d'état ; dessin selon le rôle.
    for c[i] in root.chips: chip := Rectangle {
        property <int> s: root.state[i];
        property <bool> cpu: i == 6;
        // À configurer (aucun serveur choisi) : le processeur ne vient pas, son support reste vide.
        property <float> arrive: self.s == 4 ? 0 : self.s >= 1 ? 1 : 0;
        animate arrive { duration: 480ms; easing: cubic-bezier(0.34, 1.4, 0.64, 1); }
        // Processeur : il descend se poser ; repart-il (aucun serveur), il s'efface sur place au lieu de
        // remonter à travers la puce de la langue.
        property <bool> leaving: self.cpu && self.s == 4;
        property <float> dx: self.cpu ? 0 : c.x / 68;
        property <float> dy: self.leaving ? 0 : self.cpu ? -1 : c.y / 68;
        // En fond des pages (bright bas), les puces restent discrètes derrière le contenu.
        opacity: (self.leaving ? self.arrive : 1) * min(1, 0.1 + 0.9 * root.bright) * (1 - root.gone);
        // Logo : plot rond de 28 (anneau du logo : rayon 11, trait 6) ; processeur : puce de 65 (60, trait 5).
        property <length> w: ((self.cpu ? 52 : 44) + ((self.cpu ? 65 : 28) - (self.cpu ? 52 : 44)) * root.morph) * root.u;
        property <length> h: ((self.cpu ? 52 : 32) + ((self.cpu ? 65 : 28) - (self.cpu ? 52 : 32)) * root.morph) * root.u;
        visible: self.arrive > 0.01 && root.gone < 0.999 && !root.lid-down;
        x: root.cx + (c.x + self.dx * 130 * (1 - self.arrive)) * root.u - self.w / 2;
        y: root.cy + (c.y + self.dy * 130 * (1 - self.arrive)) * root.u - self.h / 2;
        width: self.w;
        height: self.h;
        border-radius: (3 + ((self.cpu ? 0 : 14) - 3) * root.morph) * root.u;
        background: @linear-gradient(135deg, #0f2a1c 0%, #06150d 100%);
        border-width: 1 * root.u;
        border-color: self.s == 2 ? root.a2.with-alpha(0.8) : root.a2.with-alpha(0.35);
        drop-shadow-blur: self.s == 2 ? (self.cpu ? 28 : 12) * root.u * (0.5 + 0.5 * root.bright) : 0px;
        drop-shadow-color: root.a2.with-alpha(0.55);
        // Pattes (rentrées quand la puce devient un plot du logo).
        Path {
            opacity: 1 - root.morph;
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: transparent;
            stroke: root.a1.with-alpha(0.7);
            stroke-width: 1 * root.u;
            commands: "M 8 0 L 8 -4 M 15 0 L 15 -4 M 22 0 L 22 -4 M 29 0 L 29 -4 M 36 0 L 36 -4 M 8 32 L 8 36 M 15 32 L 15 36 M 22 32 L 22 36 M 29 32 L 29 36 M 36 32 L 36 36";
        }
        property <color> ic: self.s == 2 ? root.a2 : root.a2.with-alpha(0.45);
        // 0 Langue : « Aa ».
        if i == 0: Text {
            text: "Aa";
            color: parent.ic;
            font-size: 15 * root.u;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // 1 Affichage : un écran sur son pied.
        if i == 1: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: transparent;
            stroke: parent.ic;
            stroke-width: 1.6 * root.u;
            commands: "M 11 7 L 33 7 L 33 21 L 11 21 Z M 22 21 L 22 25 M 16 25 L 28 25";
        }
        // 2 Lecteur vidéo : bouton lecture.
        if i == 2: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: parent.ic;
            commands: "M 17 8 L 30 16 L 17 24 Z";
        }
        // 3 Stockage : barrette de mémoire (puces en rang).
        if i == 3: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: parent.ic;
            commands: "M 7 11 L 14 11 L 14 21 L 7 21 Z M 16 11 L 23 11 L 23 21 L 16 21 Z M 25 11 L 32 11 L 32 21 L 25 21 Z M 34 13 L 38 13 L 38 19 L 34 19 Z";
        }
        // 4 Configuration : engrenage.
        if i == 4: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: transparent;
            stroke: parent.ic;
            stroke-width: 1.6 * root.u;
            commands: "M 22 9 L 22 6 M 22 23 L 22 26 M 15 16 L 12 16 M 29 16 L 32 16 M 17 11 L 15 9 M 27 21 L 29 23 M 27 11 L 29 9 M 17 21 L 15 23 M 27 16 A 5 5 0 1 0 17 16 A 5 5 0 1 0 27 16 Z";
        }
        // 5 Réseau : antenne et ondes.
        if i == 5: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 44;
            viewbox-height: 32;
            fill: transparent;
            stroke: parent.ic;
            stroke-width: 1.6 * root.u;
            stroke-line-cap: round;
            commands: "M 22 15 L 22 26 M 17 10 A 7 7 0 0 1 27 10 M 14 7 A 11 11 0 0 1 30 7 M 22 15 L 22 14";
        }
        // 6 Processeur (le serveur) : la puce, son cœur et ses pistes internes.
        if i == 6: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 52;
            viewbox-height: 52;
            fill: transparent;
            stroke: parent.ic;
            stroke-width: 1.4 * root.u;
            commands: "M 14 14 L 38 14 L 38 38 L 14 38 Z M 20 20 L 32 20 L 32 32 L 20 32 Z M 8 20 L 14 20 M 8 26 L 14 26 M 8 32 L 14 32 M 38 20 L 44 20 M 38 26 L 44 26 M 38 32 L 44 32 M 20 8 L 20 14 M 26 8 L 26 14 M 32 8 L 32 14 M 20 38 L 20 44 M 26 38 L 26 44 M 32 38 L 32 44";
        }
        if i == 6 && chip.s == 2: Rectangle {
            x: parent.width * 0.38;
            y: parent.height * 0.38;
            width: parent.width * 0.24;
            height: self.width;
            background: root.a2.with-alpha(0.7);
        }
        // Diode d'état.
        Rectangle {
            x: parent.width - 8 * root.u;
            y: 3 * root.u;
            width: 5 * root.u;
            height: self.width;
            border-radius: self.width / 2;
            background: parent.s == 2 ? #4dff9a : parent.s == 3 || parent.s == 5 ? #ff5c5c : parent.s == 4 ? #ffc23d : root.a2.with-alpha(0.6);
            drop-shadow-blur: 5 * root.u;
            drop-shadow-color: self.background;
        }
        // Devenir le logo : le plot (fond de la page, anneau d'accent) ou la puce du serveur (cœur
        // d'accent) recouvre peu à peu la puce.
        if root.morph > 0.001: Rectangle {
            opacity: root.morph;
            border-radius: parent.border-radius;
            background: chip.cpu ? Theme.accent1.mix(Theme.bg, 0.25) : Theme.bg;
            border-width: (chip.cpu ? 5 : 6) * root.u;
            border-color: Theme.accent2;
            if chip.cpu: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24 * root.u;
                height: self.width;
                background: Theme.accent1;
            }
        }
    }
    // Capot : substrat vert et ses condensateurs, plaque de métal, logo gravé (reflet et creux), repère
    // de la broche 1. Il descend se poser (un peu plus grand au départ) pendant qu'il apparaît.
    if root.lid-on: Rectangle {
        property <float> e: 1 - (1 - root.lid) * (1 - root.lid);
        x: root.cx - 100 * root.u;
        y: root.cy - 100 * root.u;
        width: 200 * root.u;
        height: 200 * root.u;
        // Opaque (les pistes ne se voient pas à travers) ; en fond des pages, assombri par-dessus.
        opacity: self.e;
        transform-scale: 1.25 - 0.25 * self.e;
        Rectangle {
            border-radius: 7 * root.u;
            background: #0b2215;
            border-width: 1 * root.u;
            border-color: root.a1.with-alpha(0.55);
            drop-shadow-blur: 16 * root.u;
            drop-shadow-color: #000000a0;
        }
        Path {
            viewbox-width: 200;
            viewbox-height: 200;
            fill: #c9a24a.with-alpha(0.85);
            commands: "M 6 30 L 11 30 L 11 38 L 6 38 Z M 6 44 L 11 44 L 11 52 L 6 52 Z M 189 148 L 194 148 L 194 156 L 189 156 Z M 189 162 L 194 162 L 194 170 L 189 170 Z M 148 6 L 156 6 L 156 11 L 148 11 Z M 44 189 L 52 189 L 52 194 L 44 194 Z";
        }
        Rectangle {
            x: 16 * root.u;
            y: 16 * root.u;
            width: 168 * root.u;
            height: 168 * root.u;
            border-radius: 12 * root.u;
            background: @linear-gradient(135deg, #d3d9dc 0%, #9aa3a8 42%, #6f787d 100%);
            border-width: 1 * root.u;
            border-color: #eef3f5.with-alpha(0.7);
            // Reflet brossé, en diagonale.
            Rectangle {
                border-radius: parent.border-radius;
                background: @linear-gradient(135deg, rgba(255, 255, 255, 0.0) 30%, rgba(255, 255, 255, 0.22) 48%, rgba(255, 255, 255, 0.0) 62%);
            }
            // Logo gravé : reflet clair décalé, puis le creux sombre.
            for g in 2: Rectangle {
                x: (168 - 140) / 2 * root.u + (g == 0 ? 0.8 : 0) * root.u;
                y: (168 - 140) / 2 * root.u + (g == 0 ? 0.8 : 0) * root.u;
                width: 140 * root.u;
                height: 140 * root.u;
                property <color> ink: g == 0 ? rgba(255, 255, 255, 0.45) : rgba(30, 36, 40, 0.55);
                Path {
                    viewbox-width: 256;
                    viewbox-height: 256;
                    fill: transparent;
                    stroke: parent.ink;
                    stroke-width: 9 * 140 / 256 * root.u;
                    stroke-line-join: round;
                    commands: "M 128 60 L 187 94 L 187 162 L 128 196 L 69 162 L 69 94 Z M 128 60 L 128 98 M 187 94 L 154 113 M 187 162 L 154 143 M 128 196 L 128 158 M 69 162 L 102 143 M 69 94 L 102 113";
                }
                Path {
                    viewbox-width: 256;
                    viewbox-height: 256;
                    fill: transparent;
                    stroke: parent.ink;
                    stroke-width: 6 * 140 / 256 * root.u;
                    commands: "M 117 60 A 11 11 0 1 0 139 60 A 11 11 0 1 0 117 60 Z M 176 94 A 11 11 0 1 0 198 94 A 11 11 0 1 0 176 94 Z M 176 162 A 11 11 0 1 0 198 162 A 11 11 0 1 0 176 162 Z M 117 196 A 11 11 0 1 0 139 196 A 11 11 0 1 0 117 196 Z M 58 162 A 11 11 0 1 0 80 162 A 11 11 0 1 0 58 162 Z M 58 94 A 11 11 0 1 0 80 94 A 11 11 0 1 0 58 94 Z M 98 98 L 158 98 L 158 158 L 98 158 Z";
                }
            }
            Text {
                y: parent.height - 24 * root.u;
                width: parent.width;
                text: "TURTLEFIN";
                color: rgba(30, 36, 40, 0.5);
                font-size: 10 * root.u;
                font-weight: 800;
                letter-spacing: 2 * root.u;
                horizontal-alignment: center;
            }
            // Broche 1.
            Path {
                viewbox-width: 168;
                viewbox-height: 168;
                fill: rgba(30, 36, 40, 0.45);
                commands: "M 10 158 L 10 144 L 24 158 Z";
            }
        }
        // Fond des pages (bright bas) : capot assombri, aussi discret que le reste de la carte (il est
        // au centre de l'écran, sous les messages centrés : « Aucun téléchargement », erreurs…).
        Rectangle {
            border-radius: 7 * root.u;
            background: #000000.with-alpha(min(0.8, 1.2 * (1 - min(1, root.bright))));
        }
    }
    // Bords assombris (pages lisibles).
    Rectangle {
        background: @radial-gradient(circle, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.7) 100%);
    }
}


// Ciel des décors, posé par Rust (daynight.rs) : nuit (0 le jour, 1 la nuit), course du soleil et de la
// lune (u : 0 entre à droite, 1 sort à gauche ; h : hauteur 0 à 1), aurore boréale, matin ou soir.
export global Sky {
    in-out property <float> night;
    in-out property <bool> sun-on;
    in-out property <float> sun-u;
    in-out property <float> sun-h;
    in-out property <bool> moon-on;
    in-out property <float> moon-u;
    in-out property <float> moon-h;
    in-out property <float> aurora;
    in-out property <bool> dawn;
    // Trame hexagonale du décor Turtlefin (tracé, repère 1600 x 900), préparée par Rust.
    in-out property <string> hex;
}

// Fonds animés (Paramètres -> Animations -> Fond animé), un par décor. Même idée partout : l'énergie
// vient du serveur, au centre de l'écran (là où le logo se forme au démarrage), et part alimenter
// tout le décor. Sans serveur (aucun choisi, ou perdu) : rien ne part du centre.
// Phase commune (secondes) aux deux fonds (sous les pages et voile des changements de page) : ils
// restent calés. Elle suit l'horloge (animation-tick) et non le nombre de tours de la minuterie :
// une minuterie en retard (interface occupée) ne ralentit plus le décor, il saute seulement une image.
// Redessiné 30 fois par seconde au plus, rien quand `live` est faux.

global Drift {
    in-out property <float> ph;
}


// Décors Aero (ciel, Harmony) : des bulles naissent au centre (le serveur), grossissent en
// s'éloignant vers les bords, et un anneau de lumière part du centre toutes les 10 s.
export component AeroDrift inherits Rectangle {
    in property <bool> live;
    in property <bool> ticking;
    in property <bool> no-server;
    in property <float> k: 1.0;
    property <float> ph: Drift.ph;
    Timer {
        interval: 33ms;
        running: root.live && root.ticking;
        triggered => {
            Drift.ph = mod(animation-tick() / 1ms, 3600000) / 1000;
        }
    }
    clip: true;
    property <length> cx: self.width / 2;
    property <length> cy: self.height / 2;
    property <length> reach: max(self.width, self.height) * 0.62;
    // Bulles : chacune son tempo (14 à 31 s), sa direction et sa taille.
    for i in (root.live && !root.no-server ? 8 : 0): Bubble {
        property <float> period: 14 + 2.5 * i;
        property <float> t: mod(root.ph + i * 3.7, self.period) / self.period;
        property <angle> dir: i * 45deg + 20deg + sin(self.t * 360deg) * 12deg;
        property <length> d: root.reach * self.t;
        width: (6 + self.t * (22 + mod(i * 17, 30))) * 1px * root.k;
        x: root.cx + cos(self.dir) * self.d - self.width / 2;
        y: root.cy + sin(self.dir) * self.d - self.width / 2;
        // Apparition au centre, disparition vers les bords.
        a: 0.55 * sin(self.t * 180deg);
    }
    // Anneau de lumière : 3 s pour gagner les bords, toutes les 10 s.
    property <float> rq: mod(root.ph, 10) / 3;
    if root.live && !root.no-server && root.rq < 1: Rectangle {
        width: root.reach * 2.4 * root.rq;
        height: self.width;
        x: root.cx - self.width / 2;
        y: root.cy - self.height / 2;
        border-radius: self.width / 2;
        opacity: 1 - root.rq;
        background: @radial-gradient(circle, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0) 55%, rgba(200, 240, 255, 0.16) 66%, rgba(255, 255, 255, 0) 72%);
    }
}




// Décor du thème, sur l'image de fond du média et sous les pages.
export component AeroSky inherits Rectangle {
    in property <float> k: 1.0;
    // Aucun serveur choisi : la carte mère (Nerd) n'a pas encore son processeur, rien n'y circule.
    in property <bool> no-server;
    // Décor fixe : dessiné une fois dans une image gardée par le moteur de rendu, puis recopié tel
    // quel à chaque image (bulles, dégradés et courbes coûtent sinon à chaque rafraîchissement).
    // Cache refait (coupé un instant puis remis) quand le contexte graphique change ou que la fenêtre
    // change de taille : sous Android, l'ancien cache devenait une image noire après une rotation.
    property <bool> fresh: true;
    property <int> epoch: Perf.gl-epoch;
    changed epoch => {
        root.fresh = false;
        refresh.running = true;
    }
    changed width => {
        root.fresh = false;
        refresh.running = true;
    }
    refresh := Timer {
        interval: 250ms;
        running: false;
        triggered => {
            root.fresh = true;
            self.running = false;
        }
    }
    cache-rendering-hint: root.fresh;
    if Theme.scenery == 1: SkyScene { }
    if Theme.scenery == 2: HarmonyScene { }
    // Décor Nerd (3) : Schematic, posé à part (voir app.slint).
    // Décor Turtlefin (4) : Nappes, posé à part (voir app.slint).
    // Décor Aero (5) : Lagon, posé à part (voir app.slint).
}

// « Nappes » (décor Turtlefin, style JellySkin) : sur le fond #010e18, de grandes nappes de couleur
// floues dérivent lentement, comme les fonds flous des pages ; bleues le jour (#00a4db, #063660,
// #003d52), elles glissent une à une vers le violet la nuit (#a95bc2, #3f2348). Une fine trame
// hexagonale (le motif du logo, tracé fixe gardé en image par le moteur) est parcourue d'un reflet à
// 130° (l'angle du dégradé des boutons), bleu le jour, violet la nuit. Une poussière lumineuse monte
// doucement ; la nuit, une partie scintille comme des étoiles. Ce qui bouge suit Drift (30 images/s au
// plus) et s'arrête quand le décor ne doit pas bouger (réglage). La nuit vient de Sky (daynight.rs).
export component Nappes inherits Rectangle {
    in property <bool> live;
    in property <bool> ticking;
    property <float> ph: Drift.ph;
    Timer {
        interval: 33ms;
        running: root.live && root.ticking;
        triggered => {
            Drift.ph = mod(animation-tick() / 1ms, 3600000) / 1000;
        }
    }
    clip: true;
    // Repère 1600 x 900, couvrant la fenêtre sans déformation.
    property <length> s: max(self.width / 1600, self.height / 900);
    property <length> ox: (self.width - 1600 * self.s) / 2;
    property <length> oy: (self.height - 900 * self.s) / 2;
    property <float> n: Sky.night;
    pure function abs1(v: float) -> float {
        return v < 0 ? -v : v;
    }
    // Chaque nappe passe au violet un peu après la précédente (0 jour, 1 nuit).
    pure function blob-k(i: int) -> float {
        return clamp((root.n * 1.3 - i * 0.06 - 0.5) * 2.2 + 0.5, 0, 1);
    }
    for b[i] in [
        { day: #00a4db, night: #a95bc2, r: 520, ax: 0.30, ay: 0.35, fx: 0.066, fy: 0.102, ph: 0.0, a: 0.42 },
        { day: #063660, night: #3f2348, r: 640, ax: 0.70, ay: 0.65, fx: 0.054, fy: 0.078, ph: 1.7, a: 0.55 },
        { day: #003d52, night: #a95bc2, r: 460, ax: 0.82, ay: 0.25, fx: 0.084, fy: 0.060, ph: 3.1, a: 0.40 },
        { day: #a95bc2, night: #003d52, r: 380, ax: 0.18, ay: 0.80, fx: 0.072, fy: 0.090, ph: 4.4, a: 0.22 },
        { day: #00a4db, night: #063660, r: 300, ax: 0.55, ay: 0.15, fx: 0.096, fy: 0.072, ph: 5.2, a: 0.25 }
    ]: Rectangle {
        property <color> c: b.night.mix(b.day, root.blob-k(i));
        property <float> al: b.a * (1 - root.n * 0.25);
        property <float> rr: b.r * (1 + 0.12 * sin((root.ph * 0.05 + b.ph) * 1rad));
        property <float> cx: 1600 * b.ax + sin((root.ph * b.fx + b.ph) * 1rad) * 220;
        property <float> cy: 900 * b.ay + cos((root.ph * b.fy + b.ph * 1.3) * 1rad) * 140;
        x: root.ox + (self.cx - self.rr * 1.4) * root.s;
        y: root.oy + (self.cy - self.rr * 1.4) * root.s;
        width: self.rr * 2.8 * root.s;
        height: self.width;
        background: @radial-gradient(circle, self.c.with-alpha(self.al) 0%, self.c.with-alpha(self.al * 0.6) 25%, self.c.with-alpha(self.al * 0.18) 50%, self.c.with-alpha(0) 72%);
    }
    // Trame hexagonale fixe (gardée en image).
    Rectangle {
        cache-rendering-hint: true;
        Path {
            x: root.ox;
            y: root.oy;
            width: 1600 * root.s;
            height: 900 * root.s;
            viewbox-width: 1600;
            viewbox-height: 900;
            fill: transparent;
            stroke: #ffffff09;
            stroke-width: 1px;
            commands: Sky.hex;
        }
    }
    // Reflet à 130° qui parcourt la trame (un passage toutes les 40 s).
    property <float> sw: mod(root.ph / 40, 1) * 1.3 - 0.15;
    property <color> swc: #a95bc2.mix(#00a4db, root.n);
    if root.live: Path {
        x: root.ox;
        y: root.oy;
        width: 1600 * root.s;
        height: 900 * root.s;
        viewbox-width: 1600;
        viewbox-height: 900;
        fill: transparent;
        stroke: @linear-gradient(130deg, transparent 0%, transparent clamp(root.sw - 0.15, 0, 1) * 100%, root.swc.with-alpha(0.35) clamp(root.sw, 0, 1) * 100%, transparent clamp(root.sw + 0.15, 0, 1) * 100%, transparent 100%);
        stroke-width: 1.2px;
        commands: Sky.hex;
    }
    // Poussière lumineuse qui monte ; la nuit, une partie scintille (étoiles).
    for i in 140: Rectangle {
        property <float> rx: root.abs1(mod(sin(i * 12.9898 * 1rad) * 43758.5453, 1));
        property <float> ry: root.abs1(mod(sin(i * 78.233 * 1rad) * 12543.123, 1));
        property <float> rs: root.abs1(mod(sin(i * 39.425 * 1rad) * 9631.77, 1));
        property <bool> star: mod(i, 9) < 4;
        property <float> sp: 4 + self.rs * 12;
        property <float> py: mod(self.ry * 900 - root.ph * self.sp + 9000, 900);
        property <float> px: self.rx * 1600 + sin((root.ph * 0.2 + i) * 1rad) * 10;
        property <float> tw: self.star ? 0.25 + (0.15 + 0.6 * max(0, sin((root.ph * 1.5 + i * 2.1) * 1rad))) * root.n : 0.25 * (1 - root.n * 0.5);
        property <float> d: (0.5 + self.rs * 1.6) * (self.star ? 1 + root.n * 1.4 : 1) * 2;
        x: root.ox + (self.px - self.d / 2) * root.s;
        y: root.oy + (self.py - self.d / 2) * root.s;
        width: self.d * root.s;
        height: self.width;
        border-radius: self.width / 2;
        background: (self.star ? #e6d2ff : #ffffff).with-alpha(self.tw);
    }
}

// Décor Nerd (board.rs) : schéma de carte (repère 1600 x 900) et ce qui bouge dessus.
export struct PcbLabel {
    x: float,
    y: float,
    text: string,
    size: float,
}
export struct PcbDot {
    x: float,
    y: float,
    a: float,
    r: float,
}
export struct TtyRow {
    k: string,
    v: string,
}
export struct PcbBox {
    x: float,
    y: float,
    w: float,
    h: float,
}
export global Pcb {
    // Tracés fixes : pistes fines et épaisses, vias, contours des composants, parties pleines, grille.
    in-out property <string> thin;
    in-out property <string> thick;
    in-out property <string> vias;
    in-out property <string> outline;
    in-out property <string> fill;
    in-out property <string> grid;
    in-out property <[PcbLabel]> labels;
    // Signaux (avec leur traînée), oscilloscope (tracé dans un repère 360 x 92), fenêtre tty0.
    in-out property <[PcbDot]> dots;
    in-out property <string> scope;
    in-out property <string> scope-label;
    in-out property <[TtyRow]> tty;
    in-out property <[string]> log;
    // Démarrage : le composant de chaque vérification (langue, affichage, lecteur vidéo, stockage,
    // configuration, réseau, serveur).
    in-out property <[PcbBox]> checks;
}

// « Schéma » (décor Nerd) : vert phosphore sur noir le jour, ambre la nuit (veille) ; à l'aube, une
// vague verte part du processeur et rallume le schéma pendant que le journal de démarrage s'écrit
// dans tty0 ; la nuit, un battement part du processeur toutes les 6 s. Le schéma fixe est gardé en
// image par le moteur (refait seulement quand sa couleur change).
export component Schematic inherits Rectangle {
    in property <bool> live;
    in property <bool> ticking;
    // Démarrage (boot.slint) : schéma éteint, chaque vérification allume son composant et s'écrit dans
    // tty0 ([ .. ] en cours, [ OK ], [FAIL], [WARN] à configurer ou hors ligne).
    in property <bool> boot;
    in property <[int]> check-state;
    in property <[string]> check-labels;
    pure function check-color(st: int) -> color {
        return st == 2 ? #2ef0a0 : st == 3 ? #ff5c5c : st == 4 || st == 5 ? #ffc23d : root.ink;
    }
    pure function check-tag(st: int) -> string {
        return st == 2 ? "[ OK ]" : st == 3 ? "[FAIL]" : st == 4 || st == 5 ? "[WARN]" : st == 1 ? "[ .. ]" : "[    ]";
    }
    property <float> ph: Drift.ph;
    Timer {
        interval: 33ms;
        running: root.live && root.ticking;
        triggered => {
            Drift.ph = mod(animation-tick() / 1ms, 3600000) / 1000;
        }
    }
    clip: true;
    property <length> s: max(self.width / 1600, self.height / 900);
    property <length> ox: (self.width - 1600 * self.s) / 2;
    property <length> oy: (self.height - 900 * self.s) / 2;
    // Veille : 0 en marche (vert), 1 en veille (ambre).
    property <float> sleep: clamp((Sky.night - 0.2) / 0.6, 0, 1);
    property <color> ink: #2ef0a0.mix(#ffaa3c, 1 - root.sleep);
    // Au démarrage, le schéma s'éclaire à mesure que les vérifications passent.
    property <int> ok-n: (root.check-state[0] == 2 ? 1 : 0) + (root.check-state[1] == 2 ? 1 : 0) + (root.check-state[2] == 2 ? 1 : 0) + (root.check-state[3] == 2 ? 1 : 0)
        + (root.check-state[4] == 2 ? 1 : 0) + (root.check-state[5] == 2 ? 1 : 0) + (root.check-state[6] == 2 ? 1 : 0);
    property <float> lum: root.boot ? 0.16 + 0.3 * root.ok-n / 7 : 0.55 + (0.28 - 0.55) * root.sleep;
    // Aube : avancement du redémarrage (0 à 1).
    property <float> wake: Sky.dawn ? clamp(1 - Sky.night, 0, 1) : 1;
    property <bool> booting: !root.boot && Sky.dawn && Sky.night > 0.02 && Sky.night < 0.98;

    // Schéma fixe.
    Rectangle {
        cache-rendering-hint: true;
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: transparent; stroke: root.ink.with-alpha(0.12); stroke-width: 1px;
            commands: Pcb.grid;
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: transparent; stroke: root.ink.with-alpha(root.lum); stroke-width: 1.4px * root.s / 1px;
            stroke-line-cap: round; stroke-line-join: round;
            commands: Pcb.thin;
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: transparent; stroke: root.ink.with-alpha(root.lum); stroke-width: 2.6px * root.s / 1px;
            stroke-line-cap: round; stroke-line-join: round;
            commands: Pcb.thick;
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: transparent; stroke: root.ink.with-alpha(root.lum); stroke-width: 1.2px * root.s / 1px;
            commands: Pcb.vias;
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: transparent; stroke: root.ink.with-alpha(root.lum * 1.1); stroke-width: 1.3px * root.s / 1px;
            commands: Pcb.outline;
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: root.ink.with-alpha(root.lum * 1.1); stroke: transparent;
            commands: Pcb.fill;
        }
        for l in Pcb.labels: Text {
            x: root.ox + l.x * root.s;
            y: root.oy + l.y * root.s;
            text: l.text;
            color: root.ink.with-alpha(root.lum * 1.1);
            font-family: "JetBrains Mono NL";
            font-size: l.size * root.s;
        }
    }
    // Aube : la vague verte qui rallume le schéma depuis le processeur (au centre).
    if root.booting: Path {
        x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
        viewbox-width: 1600; viewbox-height: 900;
        fill: transparent;
        stroke: @radial-gradient(circle, #2ef0a020 0%, #2ef0a020 max(0%, (root.wake - 0.12) * 100%), #9effd0 root.wake * 100%, transparent min(100%, (root.wake + 0.02) * 100%));
        stroke-width: 2px * root.s / 1px;
        commands: Pcb.thin;
    }
    // Nuit : battement qui part du processeur toutes les 6 s.
    property <float> beat: mod(root.ph / 6, 1);
    if root.live && root.sleep > 0.3 && !root.booting: Path {
        x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
        viewbox-width: 1600; viewbox-height: 900;
        fill: transparent;
        stroke: @radial-gradient(circle, transparent 0%, transparent max(0%, (root.beat - 0.06) * 100%), #ffaa3c.with-alpha(0.6 * (root.sleep - 0.3) / 0.7) root.beat * 100%, transparent min(100%, (root.beat + 0.03) * 100%));
        stroke-width: 2.4px * root.s / 1px;
        commands: Pcb.thin;
    }
    // Démarrage : le composant de chaque vérification s'allume (en cours : il palpite).
    if root.boot: Rectangle {
        for b[bi] in Pcb.checks: Rectangle {
            property <int> st: root.check-state[bi];
            property <float> pulse: 0.5 + 0.5 * sin(mod(animation-tick() / 1ms, 900) / 900 * 360deg);
            visible: self.st > 0;
            x: root.ox + (b.x - 6) * root.s;
            y: root.oy + (b.y - 6) * root.s;
            width: (b.w + 12) * root.s;
            height: (b.h + 12) * root.s;
            border-width: 2px;
            border-color: root.check-color(self.st).with-alpha(self.st == 1 ? 0.4 + 0.5 * self.pulse : 0.9);
            background: root.check-color(self.st).with-alpha(self.st == 1 ? 0.06 + 0.08 * self.pulse : 0.12);
        }
    }
    // Signaux (calculés par board.rs) : point lumineux et sa traînée.
    if root.live: Rectangle {
        for d in Pcb.dots: Rectangle {
            visible: d.a > 0.01;
            x: root.ox + (d.x - d.r) * root.s;
            y: root.oy + (d.y - d.r) * root.s;
            width: d.r * 2 * root.s;
            height: self.width;
            border-radius: self.width / 2;
            background: @radial-gradient(circle, #ffffff.with-alpha(d.a) 0%, #8cffdc.with-alpha(d.a * 0.6) 35%, #8cffdc.with-alpha(0) 70%);
        }
    }
    // Instruments : oscilloscope (en bas à gauche) et tty0 (en bas à droite), chacun dans sa fenêtre.
    for z[zi] in [{ x: 40, y: 720, w: 400, h: 150 }, { x: 1160, y: 696, w: 400, h: 184 }]: Rectangle {
        x: root.ox + z.x * root.s;
        y: root.oy + z.y * root.s;
        width: z.w * root.s;
        height: z.h * root.s;
        background: #000805f0;
        border-width: 1.2px;
        border-color: root.ink.with-alpha(0.45);
        Rectangle {
            y: 0;
            height: 26 * root.s;
            background: root.ink.with-alpha(0.12);
            Text {
                x: 10 * root.s;
                text: zi == 0 ? Pcb.scope-label : "tty0 — turtlefin";
                color: root.ink.with-alpha(0.85);
                font-family: "JetBrains Mono NL";
                font-size: 12 * root.s;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        // Oscilloscope : grille et signal.
        if zi == 0: Path {
            x: 20 * root.s; y: 38 * root.s; width: 360 * root.s; height: 92 * root.s;
            viewbox-width: 360; viewbox-height: 92;
            fill: transparent; stroke: root.ink.with-alpha(0.14); stroke-width: 1px;
            commands: "M 0 0 L 360 0 M 0 23 L 360 23 M 0 46 L 360 46 M 0 69 L 360 69 M 0 92 L 360 92 M 0 0 L 0 92 M 45 0 L 45 92 M 90 0 L 90 92 M 135 0 L 135 92 M 180 0 L 180 92 M 225 0 L 225 92 M 270 0 L 270 92 M 315 0 L 315 92 M 360 0 L 360 92";
        }
        if zi == 0: Path {
            x: 20 * root.s; y: 38 * root.s; width: 360 * root.s; height: 92 * root.s;
            viewbox-width: 360; viewbox-height: 92;
            fill: transparent; stroke: root.ink.with-alpha(0.95); stroke-width: 2px * root.s / 1px;
            stroke-line-join: round;
            commands: Pcb.scope != "" ? Pcb.scope : "M 0 46 L 360 46";
        }
        // tty0 : l'état du système, ou le journal de démarrage à l'aube.
        if zi == 1 && root.boot: VerticalLayout {
            x: 18 * root.s; y: 40 * root.s; width: parent.width - 36 * root.s;
            alignment: start;
            for st[ci] in root.check-state: HorizontalLayout {
                height: 19 * root.s;
                Text { width: 76 * root.s; text: root.check-tag(st); color: root.check-color(st).with-alpha(st == 0 ? 0.35 : 0.95); font-family: "JetBrains Mono NL"; font-size: 14 * root.s; font-weight: 700; }
                Text { text: root.check-labels[ci]; color: root.ink.with-alpha(st == 0 ? 0.35 : 0.85); font-family: "JetBrains Mono NL"; font-size: 14 * root.s; overflow: elide; }
            }
        }
        if zi == 1 && !root.boot && !root.booting: VerticalLayout {
            x: 18 * root.s; y: 40 * root.s; width: parent.width - 36 * root.s;
            alignment: start;
            for r in Pcb.tty: HorizontalLayout {
                height: 19 * root.s;
                Text { width: 150 * root.s; text: r.k; color: root.ink.with-alpha(0.5); font-family: "JetBrains Mono NL"; font-size: 14 * root.s; }
                Text { text: r.v; color: root.ink.with-alpha(0.9); font-family: "JetBrains Mono NL"; font-size: 14 * root.s; overflow: elide; }
            }
        }
        if zi == 1 && root.booting: VerticalLayout {
            x: 18 * root.s; y: 40 * root.s; width: parent.width - 36 * root.s;
            alignment: start;
            for line[li] in Pcb.log: Text {
                height: 15 * root.s;
                visible: li < floor(root.wake * (Pcb.log.length + 1));
                text: line;
                color: li == Pcb.log.length - 1 ? #8cffc8f0 : #2ef0a0c0;
                font-family: "JetBrains Mono NL";
                font-size: 13 * root.s;
            }
        }
    }
}

// Décor Aero (lagoon.rs) : images du lagon (ui/lagoon, chargées au premier affichage), lumière selon
// l'heure, et ce qui bouge (repère 1600 x 900).
export struct LagoonJelly {
    on: bool,
    bell: string,
    arms: string,
    tentacles: string,
    organs: string,
    under: string,
    shine: string,
    gx: float,
    gy: float,
    gr: float,
    c: float,
    s: float,
}
export struct LagoonAnemone {
    column: string,
    outer: string,
    inner: string,
    tips: string,
    s: float,
}
export struct LagoonFish {
    x: float,
    y: float,
    s: float,
    right: bool,
    clown: bool,
}
export struct LagoonDot {
    x: float,
    y: float,
    a: float,
    r: float,
}
export struct LagoonSpeck {
    x: float,
    y: float,
    r: float,
    a: float,
    sp: float,
    ph: float,
    lum: bool,
    th: float,
}
export struct LagoonBubble {
    x: float,
    off: float,
    r: float,
    sp: float,
    ph: float,
}
export global Lagoon {
    // Images (ui/lagoon), posées par lagoon.rs.
    in-out property <image> reef-back;
    in-out property <image> reef-day;
    in-out property <image> reef-night;
    in-out property <image> reef-glow;
    in-out property <image> sand;
    in-out property <image> rays;
    in-out property <image> c1;
    in-out property <image> c2;
    in-out property <image> win;
    in-out property <image> aur1;
    in-out property <image> aur2;
    in-out property <image> fan-day;
    in-out property <image> fan-night;
    in-out property <image> bubble;
    in-out property <image> dot;
    in-out property <image> jglow;
    in-out property <image> clown-r;
    in-out property <image> clown-l;
    in-out property <image> chromis-r;
    in-out property <image> chromis-l;
    in-out property <image> fish-img;
    in-out property <bool> ready;
    // Lumière (selon l'heure).
    in-out property <color> w0: #38b6e6;
    in-out property <color> w1: #1683c6;
    in-out property <color> w2: #0a4f98;
    in-out property <color> w3: #062c66;
    in-out property <color> w4: #02132e;
    in-out property <float> sun-x;
    in-out property <float> sun-scale: 1;
    in-out property <color> sun-color: white;
    in-out property <float> sun-a;
    in-out property <float> ray-x;
    in-out property <float> ray-angle;
    in-out property <float> ray-len: 900;
    in-out property <color> ray-color: white;
    in-out property <float> ray-a;
    in-out property <float> moon-x;
    in-out property <float> moon-a;
    in-out property <float> moon-ray-angle;
    in-out property <float> moon-ray-len;
    in-out property <float> caustic-a;
    in-out property <float> aurora;
    // Banc de poissons : avancement de sa traversée (0 à 1), -1 aucun.
    in-out property <float> school: -1;
    // Ce qui bouge.
    in-out property <[LagoonJelly]> jellies;
    in-out property <[LagoonAnemone]> anemones;
    in-out property <[LagoonFish]> fish;
    in-out property <[LagoonDot]> tips;
    in-out property <[LagoonSpeck]> plankton;
    in-out property <[LagoonBubble]> bubbles;
    in-out property <[LagoonDot]> school-fish;
    in-out property <[LagoonDot]> fans;
}

// « Lagon » (décor Aero). La nuit vient de Sky (daynight.rs), le reste de Lagoon (lagoon.rs).
export component Lagon inherits Rectangle {
    in property <bool> live;
    in property <bool> ticking;
    property <float> ph: Drift.ph;
    Timer {
        interval: 33ms;
        running: root.live && root.ticking;
        triggered => {
            Drift.ph = mod(animation-tick() / 1ms, 3600000) / 1000;
        }
    }
    clip: true;
    property <length> s: max(self.width / 1600, self.height / 900);
    property <length> ox: (self.width - 1600 * self.s) / 2;
    property <length> oy: (self.height - 900 * self.s) / 2;
    property <float> dark: Sky.night;
    property <float> t: root.live ? root.ph : 0;
    // Image du média affichée dessous (0 à 1, suit son fondu) : l'eau devient un voile teinté à travers
    // lequel on la voit ; lumières, poissons, méduses, récif et bulles restent au premier plan.
    in property <float> see;
    property <float> wa: 1 - root.see * 0.62;

    // Eau.
    Rectangle {
        background: @linear-gradient(180deg, Lagoon.w0.with-alpha(root.wa * 0.85) 0%, Lagoon.w1.with-alpha(root.wa * 0.9) 18%, Lagoon.w2.with-alpha(root.wa) 45%, Lagoon.w3.with-alpha(root.wa) 75%, Lagoon.w4.with-alpha(root.wa) 100%);
    }
    // Décor allégé (Perf.decor 1, decor.rs) : sans les petits éléments (256) ni les bords assombris (2048).
    // Diagnostic (TURTLEFIN_PERF_OFF) : 128 lumières, 256 petits éléments, 512 tracés (méduses, anémones),
    // 1024 récif et sable, 2048 bords assombris.
    if Lagoon.ready && !Perf.hide(128): Rectangle {
        // Reflets du soleil et de la lune à la surface.
        if Lagoon.sun-a > 0: Image {
            x: root.ox + (Lagoon.sun-x - 400 * Lagoon.sun-scale * 1.6) * root.s;
            y: root.oy - 40 * root.s;
            width: 800 * Lagoon.sun-scale * 1.6 * root.s;
            height: 300 * Lagoon.sun-scale * 1.3 * root.s;
            source: Lagoon.win;
            colorize: Lagoon.sun-color;
            image-fit: fill;
            opacity: Lagoon.sun-a;
        }
        if Lagoon.moon-a > 0: Image {
            x: root.ox + (Lagoon.moon-x - 400 * 0.8) * root.s;
            y: root.oy - 40 * root.s;
            width: 800 * 0.8 * root.s;
            height: 300 * 0.65 * root.s;
            source: Lagoon.win;
            colorize: #bed7ff;
            image-fit: fill;
            opacity: Lagoon.moon-a;
        }
        // Rayons : partent de l'astre (au-dessus de la surface), s'inclinent et raccourcissent quand il baisse.
        if Lagoon.ray-a > 0.01: Image {
            x: root.ox + (Lagoon.ray-x - 720) * root.s;
            y: root.oy - 120 * root.s;
            width: 1600 * root.s;
            height: (Lagoon.ray-len + 120) * root.s;
            source: Lagoon.rays;
            colorize: Lagoon.ray-color;
            image-fit: fill;
            opacity: Lagoon.ray-a;
            transform-rotation: Lagoon.ray-angle * 1deg;
            transform-origin: { x: 720 * root.s, y: 0px };
        }
        if Lagoon.moon-a > 0: Image {
            x: root.ox + (Lagoon.moon-x - 720 * 0.45) * root.s;
            y: root.oy - 120 * root.s;
            width: 1600 * 0.45 * root.s;
            height: (Lagoon.moon-ray-len + 120) * root.s;
            source: Lagoon.rays;
            colorize: #afcdff;
            image-fit: fill;
            opacity: 0.3;
            transform-rotation: Lagoon.moon-ray-angle * 1deg;
            transform-origin: { x: 720 * 0.45 * root.s, y: 0px };
        }
        // Aurore boréale dans la surface : les rubans poussent depuis leur base.
        if Lagoon.aurora > 0.01: Rectangle {
            property <float> grow: Lagoon.aurora;
            property <float> mx: root.live ? 0.5 + 0.5 * sin(root.t * 0.23 * 1rad) : 0.5;
            property <float> dx: root.live ? sin(root.t * 0.05 * 1rad) * 80 : 0;
            Image {
                x: root.ox + (-100 + parent.dx) * root.s;
                y: root.oy + 300 * (1 - (0.25 + 0.75 * parent.grow)) * root.s;
                width: 1800 * root.s;
                height: 300 * (0.25 + 0.75 * parent.grow) * root.s;
                source: Lagoon.aur1;
                image-fit: fill;
                opacity: 0.85 * parent.grow * parent.mx;
            }
            Image {
                x: root.ox + (-100 - parent.dx) * root.s;
                y: root.oy + 300 * (1 - (0.25 + 0.75 * parent.grow)) * root.s;
                width: 1800 * root.s;
                height: 300 * (0.25 + 0.75 * parent.grow) * root.s;
                source: Lagoon.aur2;
                image-fit: fill;
                opacity: 0.85 * parent.grow * (1 - parent.mx);
            }
            Rectangle {
                height: 420 * root.s;
                y: root.oy;
                background: @linear-gradient(180deg, #46ffb4.with-alpha(0.14 * parent.grow) 0%, #46ffb400 100%);
            }
        }
        // Reflets des vagues (deux textures qui se relaient en glissant).
        if Lagoon.caustic-a > 0.01: Rectangle {
            property <float> ca: root.live ? 0.5 + 0.5 * sin(root.t * 0.45 * 1rad) : 0.5;
            Image {
                x: root.ox - mod(root.t * 9, 240) * root.s;
                y: root.oy;
                width: 1840 * root.s;
                height: 440 * root.s;
                source: Lagoon.c1;
                image-fit: fill;
                opacity: Lagoon.caustic-a * parent.ca;
            }
            Image {
                x: root.ox + (-240 + mod(root.t * 6, 240)) * root.s;
                y: root.oy;
                width: 1840 * root.s;
                height: 440 * root.s;
                source: Lagoon.c2;
                image-fit: fill;
                opacity: Lagoon.caustic-a * (1 - parent.ca);
            }
        }
    }
    // Plancton : points pâles ; la nuit, un tiers s'allume grain par grain.
    for q in Lagoon.plankton: speck := Rectangle {
        property <float> py: q.y + (root.live ? sin((root.t * 0.5 + q.ph) * 1rad) * 6 : 0);
        property <float> px: mod(q.x + root.t * q.sp, 1600);
        property <float> on: q.lum ? clamp((root.dark - q.th) / 0.04, 0, 1) : 0;
        x: root.ox + self.px * root.s;
        y: root.oy + self.py * root.s;
        width: q.r * 1.6 * root.s;
        height: self.width;
        background: #c8f0ff.with-alpha(q.a * (1 - self.py / 900 * 0.5) * (1 - root.dark + root.dark * 0.3));
        if speck.on > 0 && Lagoon.ready && !Perf.hide(256) && Perf.decor < 1: Image {
            property <float> rr: 4 + q.r * 4;
            x: (q.r * 0.8 - self.rr) * root.s;
            y: (q.r * 0.8 - self.rr) * root.s;
            width: self.rr * 2 * root.s;
            height: self.width;
            source: Lagoon.dot;
            opacity: speck.on * (root.live ? 0.45 + 0.55 * max(0, sin((root.t * 1.3 + q.ph * 3) * 1rad)) : 0.7);
        }
    }
    // Banc de poissons au loin.
    if Lagoon.school >= 0 && Lagoon.ready && !Perf.hide(256) && Perf.decor < 1: school := Rectangle {
        property <float> x0: -400 + 1900 * Lagoon.school;
        for f in Lagoon.school-fish: Image {
            x: root.ox + (school.x0 + f.x - 20 * f.r / 6) * root.s;
            y: root.oy + (340 + f.y + f.x * 0.12 + (root.live ? sin((root.t * 1.2 + f.a) * 1rad) * 4 : 0) - 7 * f.r / 6) * root.s;
            width: 32 * f.r / 6 * root.s;
            height: 14 * f.r / 6 * root.s;
            source: Lagoon.fish-img;
            opacity: 0.55 * (1 - root.dark * 0.4);
        }
    }
    // Méduses.
    for j in Lagoon.jellies: Rectangle {
        visible: j.on && !Perf.hide(512);
        if Lagoon.ready: Image {
            x: root.ox + (j.gx - j.gr) * root.s;
            y: root.oy + (j.gy - j.gr) * root.s;
            width: j.gr * 2 * root.s;
            height: self.width;
            source: Lagoon.jglow;
            opacity: 0.5 + 0.2 * j.c;
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: transparent; stroke: #e6a0ff38; stroke-width: 7px * j.s * root.s / 1px;
            stroke-line-cap: round;
            commands: j.arms != "" ? j.arms : "M 0 0";
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: transparent; stroke: #e6a0ff8c; stroke-width: 1.6px * j.s * root.s / 1px;
            stroke-line-cap: round;
            commands: j.arms != "" ? j.arms : "M 0 0";
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: transparent; stroke: #bee1ff60; stroke-width: (1.2 * j.s + 0.3) * root.s / 1px * 1px;
            stroke-line-cap: round;
            commands: j.tentacles != "" ? j.tentacles : "M 0 0";
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: @radial-gradient(circle, #ebe1ff8c 0%, #aa8cff38 55%, #6ed2ff60 100%);
            stroke: #c8f0ff.with-alpha(0.55 + 0.3 * j.c); stroke-width: (1.6 * j.s + 0.4) * root.s / 1px * 1px;
            commands: j.bell != "" ? j.bell : "M 0 0";
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: #beaaff1f; stroke: transparent;
            commands: j.under != "" ? j.under : "M 0 0";
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: #ffaaeb.with-alpha(0.22 + 0.2 * j.c); stroke: transparent;
            commands: j.organs != "" ? j.organs : "M 0 0";
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: #ffffff29; stroke: transparent;
            commands: j.shine != "" ? j.shine : "M 0 0";
        }
    }
    if Lagoon.ready && !Perf.hide(1024): Rectangle {
        // Sable, récif lointain, gorgones.
        Image { x: root.ox; y: root.oy + 760 * root.s; width: 1600 * root.s; height: 140 * root.s; source: Lagoon.sand; image-fit: fill; }
        Rectangle { x: root.ox; y: root.oy + 760 * root.s; width: 1600 * root.s; height: 140 * root.s; background: #020816.with-alpha(root.dark * 0.6); }
        Image { x: root.ox; y: root.oy + 480 * root.s; width: 1600 * root.s; height: 420 * root.s; source: Lagoon.reef-back; image-fit: fill; }
        Rectangle { x: root.ox; y: root.oy + 680 * root.s; width: 1600 * root.s; height: 220 * root.s; background: #020816.with-alpha(root.dark * 0.65); }
        for f in Lagoon.fans: Rectangle {
            x: root.ox + (f.x - f.r / 2) * root.s;
            y: root.oy + (f.y - f.r) * root.s;
            width: f.r * root.s;
            height: self.width;
            Image {
                width: parent.width; height: parent.height; source: Lagoon.fan-day; image-fit: fill;
                transform-rotation: (root.live ? sin((root.t * 0.55 + f.a) * 1rad) * 2.6 : 0) * 1deg;
                transform-origin: { x: self.width / 2, y: self.height };
            }
            Image {
                width: parent.width; height: parent.height; source: Lagoon.fan-night; image-fit: fill; opacity: root.dark;
                transform-rotation: (root.live ? sin((root.t * 0.55 + f.a) * 1rad) * 2.6 : 0) * 1deg;
                transform-origin: { x: self.width / 2, y: self.height };
            }
        }
        // Demoiselles et poissons-clowns (avant le récif proche : ils s'y cachent la nuit).
        for f in Lagoon.fish: Image {
            property <float> w: (f.clown ? 52 : 36) / 1.1 * f.s;
            property <float> h: (f.clown ? 30 : 20) / 1.1 * f.s;
            x: root.ox + (f.x - self.w / 2) * root.s;
            y: root.oy + (f.y - self.h / 2) * root.s;
            width: self.w * root.s;
            height: self.h * root.s;
            source: f.clown ? (f.right ? Lagoon.clown-r : Lagoon.clown-l) : (f.right ? Lagoon.chromis-r : Lagoon.chromis-l);
        }
        // Récif proche : jour, nuit, et la fluorescence qui respire la nuit.
        Image { x: root.ox; y: root.oy + 480 * root.s; width: 1600 * root.s; height: 420 * root.s; source: Lagoon.reef-day; image-fit: fill; }
        if root.dark > 0: Image { x: root.ox; y: root.oy + 480 * root.s; width: 1600 * root.s; height: 420 * root.s; source: Lagoon.reef-night; image-fit: fill; opacity: root.dark; }
        if root.dark > 0: Image { x: root.ox; y: root.oy + 480 * root.s; width: 1600 * root.s; height: 420 * root.s; source: Lagoon.reef-glow; image-fit: fill; opacity: root.dark * (root.live ? 0.8 + 0.2 * sin(root.t * 0.7 * 1rad) : 0.9); }
    }
    // Anémones.
    for a in Lagoon.anemones: Rectangle {
        visible: !Perf.hide(512);
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: #c85a78.mix(#231a2d, 1 - root.dark * 0.75); stroke: transparent;
            commands: a.column != "" ? a.column : "M 0 0";
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: transparent; stroke: #eb7396.mix(#281e3c, 1 - root.dark * 0.75); stroke-width: 4.6px * a.s * root.s / 1px;
            stroke-line-cap: round;
            commands: a.outer != "" ? a.outer : "M 0 0";
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: transparent; stroke: #f08ca5.mix(#2d2341, 1 - root.dark * 0.75); stroke-width: 3.6px * a.s * root.s / 1px;
            stroke-line-cap: round;
            commands: a.inner != "" ? a.inner : "M 0 0";
        }
        Path {
            x: root.ox; y: root.oy; width: 1600 * root.s; height: 900 * root.s;
            viewbox-width: 1600; viewbox-height: 900;
            fill: transparent; stroke: #ffe1a5.mix(#3c3250, 1 - root.dark * 0.7); stroke-width: 4px * a.s * root.s / 1px;
            stroke-line-cap: round;
            commands: a.tips != "" ? a.tips : "M 0 0";
        }
    }
    if root.dark > 0.2 && Lagoon.ready && !Perf.hide(256) && Perf.decor < 1: Rectangle {
        for d in Lagoon.tips: Image {
            x: root.ox + (d.x - d.r) * root.s;
            y: root.oy + (d.y - d.r) * root.s;
            width: d.r * 2 * root.s;
            height: self.width;
            source: Lagoon.dot;
            opacity: (root.dark - 0.2) / 0.8;
        }
    }
    // Colonnes de bulles qui montent du récif.
    if Lagoon.ready && !Perf.hide(256) && Perf.decor < 1: Rectangle {
        for b in Lagoon.bubbles: Image {
            property <float> q: mod(b.off + root.t * b.sp, 1);
            property <float> by: 900 - self.q * 860;
            property <float> br: b.r * (0.6 + self.q * 0.5);
            x: root.ox + (b.x + sin((self.q * 14 + b.ph) * 1rad) * 10 - self.br) * root.s;
            y: root.oy + (self.by - self.br) * root.s;
            width: self.br * 2 * root.s;
            height: self.width;
            source: Lagoon.bubble;
            opacity: min(1, (1 - self.q) * 3) * (1 - root.dark * 0.45);
        }
    }
    // Bords assombris.
    if !Perf.hide(2048) && Perf.decor < 1: Rectangle {
        background: @radial-gradient(circle, #00000000 0%, #00000000 45%, #0000008c 100%);
    }
}
