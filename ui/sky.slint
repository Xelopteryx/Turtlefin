    }
    // Fond plus sombre vers le bas et sur les bords (pages lisibles).
    Rectangle {
        background: @radial-gradient(circle, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0) 45%, rgba(0, 3, 10, 0.55) 100%);
    }
}

// Fonds animés (Paramètres -> Animations -> Fond animé), un par décor. Même idée partout : l'énergie
// vient du serveur, au centre de l'écran (là où le logo se forme au démarrage), et part alimenter
// tout le décor. Sans serveur (aucun choisi, ou perdu) : rien ne part du centre.
// Phase commune (secondes) aux deux fonds (sous les pages et voile des changements de page) : ils
// restent calés. Elle suit l'horloge (animation-tick) et non le nombre de tours de la minuterie :
// une minuterie en retard (interface occupée) ne ralentit plus le décor, il saute seulement une image.
// Redessiné 30 fois par seconde au plus, rien quand `live` est faux.
global Drift {
    in-out property <float> ph;
}

// Hexagone du décor Turtlefin, rayon r (repère 1600 x 900, centre 800 450).
export struct HexRing {
    r: float,
    c: string,
}

// Décor Turtlefin : une onde hexagonale part du centre (le cœur du logo) toutes les 6 s ; chaque
// anneau du décor s'allume quand elle le traverse. Deux lueurs, violette et bleue, tournent lentement
// en restant symétriques par rapport au centre.
export component HexDrift inherits Rectangle {
    // Décor qui bouge (réglage) ; `ticking` : c'est cette copie qui fait avancer la phase.
    in property <bool> live;
    in property <bool> ticking;
    in property <bool> no-server;
    property <float> ph: Drift.ph;
    Timer {
        interval: 33ms;
        running: root.live && root.ticking;
        triggered => {
            Drift.ph = mod(animation-tick() / 1ms, 3600000) / 1000;
        }
    }
    // Un tour en 72 s pour les lueurs.
    property <angle> a: root.ph * 5deg;
    property <length> gw: max(self.width, self.height) * 0.62;
    property <length> ox: cos(root.a) * self.width * 0.10;
    property <length> oy: sin(root.a) * self.height * 0.08;
    // Onde : 4,8 s de trajet du centre jusqu'au dernier anneau, puis 1,2 s de repos.
    property <float> t: clamp(mod(root.ph, 6) / 4.8, 0, 1);
    property <float> wr: 20 + 760 * root.t;
    property <[HexRing]> rings: [
        { r: 150, c: "M 800.0 300.0 L 929.9 375.0 L 929.9 525.0 L 800.0 600.0 L 670.1 525.0 L 670.1 375.0 Z" },
        { r: 260, c: "M 800.0 190.0 L 1025.2 320.0 L 1025.2 580.0 L 800.0 710.0 L 574.8 580.0 L 574.8 320.0 Z" },
        { r: 390, c: "M 800.0 60.0 L 1137.7 255.0 L 1137.7 645.0 L 800.0 840.0 L 462.3 645.0 L 462.3 255.0 Z" },
        { r: 540, c: "M 800.0 -90.0 L 1267.7 180.0 L 1267.7 720.0 L 800.0 990.0 L 332.3 720.0 L 332.3 180.0 Z" },
        { r: 720, c: "M 800.0 -270.0 L 1423.5 90.0 L 1423.5 810.0 L 800.0 1170.0 L 176.5 810.0 L 176.5 90.0 Z" }
    ];
    clip: true;
    Rectangle {
        x: root.width * 0.22 - root.gw / 2 + root.ox;
        y: root.height * 0.22 - root.gw / 2 + root.oy;
        width: root.gw;
        height: root.gw;
        background: @radial-gradient(circle, Theme.accent1.with-alpha(0.16) 0%, Theme.accent1.with-alpha(0) 65%);
    }
    Rectangle {
        x: root.width * 0.78 - root.gw / 2 - root.ox;
        y: root.height * 0.78 - root.gw / 2 - root.oy;
        width: root.gw;
        height: root.gw;
        background: @radial-gradient(circle, Theme.accent2.with-alpha(0.16) 0%, Theme.accent2.with-alpha(0) 65%);
    }
    // Même cadre 16:9 que HexScene (centré, rogné) : les anneaux tombent sur ceux du décor.
    if root.live && !root.no-server: Rectangle {
        width: max(parent.width, parent.height * 16 / 9);
        height: self.width * 9 / 16;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        // Départ : le centre s'éclaire.
        Rectangle {
            property <float> f: clamp(1 - mod(root.ph, 6) / 0.7, 0, 1);
            visible: self.f > 0;
            width: parent.width * 300 / 1600;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: @radial-gradient(circle, Theme.accent2.with-alpha(0.30 * self.f) 0%, Theme.accent2.with-alpha(0) 70%);
        }
        Path {
            visible: root.t < 1;
            width: parent.width;
            height: parent.height;
            viewbox-width: 1600;
            viewbox-height: 900;
            fill: transparent;
            stroke: Theme.accent2.with-alpha(0.30 * (1 - root.t));
            stroke-width: 1.5px;
            transform-scale: root.wr / 150;
            commands: "M 800.0 300.0 L 929.9 375.0 L 929.9 525.0 L 800.0 600.0 L 670.1 525.0 L 670.1 375.0 Z";
        }
        // Anneaux du décor : chacun s'allume au passage de l'onde (tous, à chaque fois).
        for ring in root.rings: Path {
            property <float> lit: max(0, 1 - abs(root.wr - ring.r) / 80);
            visible: self.lit > 0.01;
            width: parent.width;
            height: parent.height;
            viewbox-width: 1600;
            viewbox-height: 900;
            fill: transparent;
            stroke: Theme.accent2.with-alpha(0.38 * self.lit);
            stroke-width: 2px;
            commands: ring.c;
        }
    }
}

// Décors Aero (ciel, Harmony) : des bulles naissent au centre (le serveur), grossissent en
// s'éloignant vers les bords, et un anneau de lumière part du centre toutes les 10 s.
export component AeroDrift inherits Rectangle {
    in property <bool> live;
    in property <bool> ticking;
    in property <bool> no-server;
    in property <float> k: 1.0;
    property <float> ph: Drift.ph;
    Timer {
        interval: 33ms;
        running: root.live && root.ticking;
        triggered => {
            Drift.ph = mod(animation-tick() / 1ms, 3600000) / 1000;
        }
    }
    clip: true;
    property <length> cx: self.width / 2;
    property <length> cy: self.height / 2;
    property <length> reach: max(self.width, self.height) * 0.62;
    // Bulles : chacune son tempo (14 à 31 s), sa direction et sa taille.
    for i in (root.live && !root.no-server ? 8 : 0): Bubble {
        property <float> period: 14 + 2.5 * i;
        property <float> t: mod(root.ph + i * 3.7, self.period) / self.period;
        property <angle> dir: i * 45deg + 20deg + sin(self.t * 360deg) * 12deg;
        property <length> d: root.reach * self.t;
        width: (6 + self.t * (22 + mod(i * 17, 30))) * 1px * root.k;
        x: root.cx + cos(self.dir) * self.d - self.width / 2;
        y: root.cy + sin(self.dir) * self.d - self.width / 2;
        // Apparition au centre, disparition vers les bords.
        a: 0.55 * sin(self.t * 180deg);
    }
    // Anneau de lumière : 3 s pour gagner les bords, toutes les 10 s.
    property <float> rq: mod(root.ph, 10) / 3;
    if root.live && !root.no-server && root.rq < 1: Rectangle {
        width: root.reach * 2.4 * root.rq;
        height: self.width;
        x: root.cx - self.width / 2;
        y: root.cy - self.height / 2;
        border-radius: self.width / 2;
        opacity: 1 - root.rq;
        background: @radial-gradient(circle, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0) 55%, rgba(200, 240, 255, 0.16) 66%, rgba(255, 255, 255, 0) 72%);
    }
}

// Une étincelle sur une piste (CircuitDrift) : point lumineux à l'avancement p (0 à 1) de la piste.
component Spark inherits Rectangle {
    in property <TraceData> tr;
    in property <float> p;
    in property <length> u;
    in property <length> cx;
    in property <length> cy;
    in property <float> size;
    in property <color> c;
    // Sous le capot du processeur (carré de 200 au centre) : rien à voir.
    in property <bool> under-lid;
    property <int> s: min(floor(root.p * 10), 9);
    property <float> l: root.p * 10 - self.s;
    property <float> tx: root.tr.xs[self.s] + (root.tr.xs[self.s + 1] - root.tr.xs[self.s]) * self.l - 700;
    property <float> ty: root.tr.ys[self.s] + (root.tr.ys[self.s + 1] - root.tr.ys[self.s]) * self.l - 700;
    property <bool> hidden: root.under-lid && abs(self.tx) < 100 && abs(self.ty) < 100;
    x: root.cx + (self.tx - root.size / 2) * root.u;
    y: root.cy + (self.ty - root.size / 2) * root.u;
    width: root.size * root.u;
    height: self.width;
    border-radius: self.width / 2;
    background: self.hidden ? transparent : @radial-gradient(circle, #ffffff 0%, root.c.with-alpha(0.9) 35%, root.c.with-alpha(0) 70%);
}

// Carte électronique (Nerd) : toutes les 6 s, le processeur (le serveur) s'éclaire sous son capot ;
// la lumière suit le logo gravé (cœur, rayons, puis les six plots), sort par les pistes des puces, et
// chaque composant atteint s'allume et éclaire autour de lui. Une piste qui part d'un composant
// attend qu'il soit atteint (Board : t0, td, PartData.t). Tout reste allumé, puis s'éteint ensemble
// avant l'éclair suivant. Ambre hors ligne. Sans serveur : rien. Même géométrie que CircuitScene.
export component CircuitDrift inherits Rectangle {
    in property <bool> live;
    in property <bool> ticking;
    in property <float> k: 1.0;
    in property <bool> no-server;
    in property <bool> offline;
    property <float> ph: Drift.ph;
    Timer {
        interval: 33ms;
        running: root.live && root.ticking;
        triggered => {
            Drift.ph = mod(animation-tick() / 1ms, 3600000) / 1000;
        }
    }
    clip: true;
    property <color> a2: root.offline ? #f59e0b : Theme.accent2;
    property <length> u: min(self.width, self.height) * 0.46 / 256;
    property <length> cx: self.width / 2;
    property <length> cy: self.height / 2;
    // Temps dans le cycle (s) ; extinction commune de 4,6 à 5,6 s.
    property <float> t: mod(root.ph, 6);
    property <float> off: 1 - clamp((root.t - 4.6) / 1.0, 0, 1);
    property <bool> on: root.live && !root.no-server;
    // Logo du capot : 140 de côté, centré (repère 256 du logo).
    property <length> lu: 140 / 256 * root.u;
    // Éclair du processeur, à travers le capot.
    if root.on && root.t < 1.2: Rectangle {
        property <float> f: root.t < 0.15 ? root.t / 0.15 : 1 - (root.t - 0.15) / 1.05;
        x: root.cx - 130 * root.u;
        y: root.cy - 130 * root.u;
        width: 260 * root.u;
        height: self.width;
        border-radius: self.width / 2;
        opacity: self.f;
        background: @radial-gradient(circle, root.a2.with-alpha(0.40) 0%, root.a2.with-alpha(0.12) 45%, root.a2.with-alpha(0) 70%);
    }
    // Le logo s'allume : cœur, rayons (du cœur vers les plots, de 0,1 à 0,5 s), plots ; il reste allumé.
    if root.on && root.off > 0: lg := Rectangle {
        x: root.cx - 70 * root.u;
        y: root.cy - 70 * root.u;
        width: 140 * root.u;
        height: 140 * root.u;
        opacity: root.off;
        property <float> sp: clamp((root.t - 0.1) / 0.4, 0, 1);
        // Le capot rayonne un peu tant que le logo est allumé.
        Rectangle {
            x: -40 * root.u;
            y: -40 * root.u;
            width: 220 * root.u;
            height: self.width;
            border-radius: self.width / 2;
            opacity: 0.5 * clamp((root.t - 0.1) / 0.5, 0, 1);
            background: @radial-gradient(circle, root.a2.with-alpha(0.0) 35%, root.a2.with-alpha(0.14) 50%, root.a2.with-alpha(0) 70%);
        }
        Path {
            viewbox-width: 256;
            viewbox-height: 256;
            fill: transparent;
            stroke: root.a2.with-alpha(0.9);
            stroke-width: 6 * root.lu;
            opacity: clamp(root.t / 0.1, 0, 1);
            commands: "M 98 98 L 158 98 L 158 158 L 98 158 Z";
        }
        if lg.sp > 0: Path {
            viewbox-width: 256;
            viewbox-height: 256;
            fill: transparent;
            stroke: root.a2.with-alpha(0.85);
            stroke-width: 7 * root.lu;
            stroke-line-cap: round;
            property <float> q: lg.sp;
            // Rayons : du bord du cœur vers chaque plot.
            commands: "M 128 98 L 128 " + (98 - 27 * self.q)
                + " M 154 113 L " + (154 + 23 * self.q) + " " + (113 - 13.5 * self.q)
                + " M 154 143 L " + (154 + 23 * self.q) + " " + (143 + 13.5 * self.q)
                + " M 128 158 L 128 " + (158 + 27 * self.q)
                + " M 102 143 L " + (102 - 23 * self.q) + " " + (143 + 13.5 * self.q)
                + " M 102 113 L " + (102 - 23 * self.q) + " " + (113 - 13.5 * self.q);
        }
        if root.t > 0.5: Path {
            viewbox-width: 256;
            viewbox-height: 256;
            fill: transparent;
            stroke: root.a2;
            stroke-width: 6 * root.lu;
            opacity: clamp((root.t - 0.5) / 0.12, 0, 1);
            commands: "M 117 60 A 11 11 0 1 0 139 60 A 11 11 0 1 0 117 60 Z M 176 94 A 11 11 0 1 0 198 94 A 11 11 0 1 0 176 94 Z M 176 162 A 11 11 0 1 0 198 162 A 11 11 0 1 0 176 162 Z M 117 196 A 11 11 0 1 0 139 196 A 11 11 0 1 0 117 196 Z M 58 162 A 11 11 0 1 0 80 162 A 11 11 0 1 0 58 162 Z M 58 94 A 11 11 0 1 0 80 94 A 11 11 0 1 0 58 94 Z";
        }
    }
    // Composants atteints : leur dessin s'allume et ils éclairent autour d'eux.
    for pt in Board.parts: Rectangle {
        property <float> l: root.on ? clamp((root.t - pt.t) / 0.18, 0, 1) * root.off : 0;
        visible: self.l > 0.01;
        // Halo : un cercle plus grand que le composant ; un éclat à l'arrivée du courant, puis stable.
        Rectangle {
            property <float> r: max(pt.w, pt.h) * 0.5 + 30;
            x: root.cx + (pt.x + pt.w / 2 - 700 - self.r) * root.u;
            y: root.cy + (pt.y + pt.h / 2 - 700 - self.r) * root.u;
            width: 2 * self.r * root.u;
            height: self.width;
            border-radius: self.width / 2;
            opacity: min(1, parent.l * (0.55 + 0.6 * max(0, 1 - (root.t - pt.t) / 0.6)));
            background: @radial-gradient(circle, root.a2.with-alpha(0.22) 0%, root.a2.with-alpha(0.07) 45%, root.a2.with-alpha(0) 70%);
        }
        Path {
            x: root.cx - 700 * root.u;
            y: root.cy - 700 * root.u;
            width: 1400 * root.u;
            height: 1400 * root.u;
            viewbox-width: 1400;
            viewbox-height: 1400;
            fill: root.a2.with-alpha(0.10);
            stroke: root.a2.with-alpha(0.95);
            stroke-width: 1.6 * root.u;
            opacity: parent.l;
            commands: pt.c;
        }
    }
    // Le courant le long de chaque piste : une tête et sa traîne, de t0 à t0 + td.
    if root.on: Rectangle {
    for tr in Board.traces: Rectangle {
        property <float> raw: (root.t - tr.t0) / tr.td;
        property <float> p: clamp(self.raw, 0, 1);
        visible: self.raw > 0 && self.raw < 1.25;
        Spark {
            tr: tr;
            p: max(0, parent.p - 0.1);
            u: root.u;
            cx: root.cx;
            cy: root.cy;
            size: 9;
            c: root.a2;
            under-lid: true;
            visible: parent.raw < 1.08;
            opacity: 0.45;
        }
        Spark {
            tr: tr;
            p: parent.p;
            u: root.u;
            cx: root.cx;
            cy: root.cy;
            size: parent.raw < 1 ? 16 : 16 + 22 * (parent.raw - 1) / 0.25;
            c: root.a2;
            under-lid: true;
            opacity: parent.raw < 1 ? 0.95 : 0.95 * (1.25 - parent.raw) / 0.25;
        }
    }
    }
}

// Décor du thème, sur l'image de fond du média et sous les pages.
export component AeroSky inherits Rectangle {
    in property <float> k: 1.0;
    // Aucun serveur choisi : la carte mère (Nerd) n'a pas encore son processeur, rien n'y circule.
    in property <bool> no-server;
    // Décor fixe : dessiné une fois dans une image gardée par le moteur de rendu, puis recopié tel
    // quel à chaque image (bulles, dégradés et courbes coûtent sinon à chaque rafraîchissement).
    cache-rendering-hint: true;
    if Theme.scenery == 1: SkyScene { }
    if Theme.scenery == 2: HarmonyScene { }
    if Theme.scenery == 3: CircuitScene {
        k: root.k;
        bright: 0.32;
        live: false;
        // Serveur perdu (Srv.core 3) : processeur absent, comme sans serveur.
        state: root.no-server || Srv.core == 3 ? [2, 2, 2, 2, 2, 2, 4] : [2, 2, 2, 2, 2, 2, 2];
        surge: root.no-server || Srv.core == 3 ? 0 : 1;
        offline: Srv.core == 2;
        lid: 1;
    }
    if Theme.scenery == 4: HexScene { }
}
