                + (self.f > 1 ? " L " + (self.f >= 2 ? tr.xs[2] : tr.xs[1] + (tr.xs[2] - tr.xs[1]) * (self.f - 1)) + " " + (self.f >= 2 ? tr.ys[2] : tr.ys[1] + (tr.ys[2] - tr.ys[1]) * (self.f - 1)) : "")
