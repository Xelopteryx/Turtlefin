// Démarrage : le logo de Turtlefin sert d'écran de vérification.
//
// Sept points : les six sommets de l'hexagone (langue, affichage, lecteur vidéo, stockage,
// configuration, réseau) et le centre (serveur). Chacun est une vraie vérification (boot.rs) : gris en
// attente, vert si tout va bien, rouge sinon (avec l'explication et « Continuer »). Quand tout est
// vert, les sommets se relient (contour), les rayons partent vers le centre, le point central devient
// l'hexagone plein : c'est exactement le logo (packaging/turtlefin.svg). Puis on zoome dans le centre
// vers la page suivante. Le déroulement est piloté par Rust (boot.rs) ; `--no-intro` le saute.

import { Theme } from "theme.slint";
import { TrackData } from "player.slint";

export component BootLogo inherits Rectangle {
    in property <float> k: 1.0;
    in property <[int]> state;            // 7 points · 0 attente · 1 en cours · 2 ok · 3 échec · 4 ok, à configurer
    in property <[string]> labels;
    in property <string> text;            // vérification en cours
    in property <string> fail;            // échec : explication
    in property <string> fail-hint;       // « Entrée pour continuer »
    in property <int> phase;              // 0 vérifications · 1 liaison · 2 zoom
    in property <bool> lang-open;
    in property <string> lang-title;
    in property <[TrackData]> langs;
    in-out property <int> lang-sel;
    callback continue-boot();
    callback lang-chosen(string);
    callback linked();                     // fin de la liaison : Rust ouvre la page suivante
    callback finished();                   // fin du zoom

    background: Theme.bg;

    // Géométrie commune avec l'icône (packaging/turtlefin.svg, packaging/icons/make-icons.py) :
    // repère 256, centre (128, 128) ; hexagone de rayon 68 (trait 14), hexagone central plein de
    // rayon 30, rayons (trait 8), bouts arrondis ; dégradé à 135° sur le carré [53, 203].
    property <[float]> px: [128, 187, 187, 128, 69, 69];
    property <[float]> py: [60, 94, 162, 196, 162, 94];
    property <[float]> ix: [128, 154, 154, 128, 102, 102];
    property <[float]> iy: [98, 113, 143, 158, 143, 113];
    property <length> side: min(self.width, self.height) * 0.46;
    property <length> u: self.side / 256;
    property <brush> grad: @linear-gradient(135deg, Theme.accent1 0%, Theme.accent2 100%);

    // Horloges des phases (au temps : rien n'est redessiné en dehors).
    property <duration> t-link;
    property <duration> t-zoom;
    property <int> ph: root.phase;
    changed ph => {
        if (root.phase == 1) {
            root.t-link = animation-tick();
            link-timer.running = true;
        } else if (root.phase == 2) {
            root.t-zoom = animation-tick();
            zoom-timer.running = true;
        }
    }
    property <float> lp: root.phase == 0 ? 0 : root.phase == 1 ? clamp((animation-tick() - root.t-link) / 900ms, 0, 1) : 1;
    property <float> zp: root.phase < 2 ? 0 : clamp((animation-tick() - root.t-zoom) / 750ms, 0, 1);
    // Liaison : contour (première moitié), puis rayons et hexagone central (seconde moitié).
    property <float> edge-p: root.ease(clamp(root.lp * 2, 0, 1));
    property <float> spoke-p: root.ease(clamp(root.lp * 2 - 1, 0, 1));
    link-timer := Timer {
        interval: 1100ms;
        running: false;
        triggered => {
            self.running = false;
            root.linked();
        }
    }
    zoom-timer := Timer {
        interval: 780ms;
        running: false;
        triggered => {
            self.running = false;
            root.finished();
        }
    }
    // Point « en cours » : pulsation.
    property <float> pulse: 0.5 + 0.5 * sin(mod(animation-tick() / 1ms, 900) / 900 * 360deg);

    pure function ease(t: float) -> float {
        return 1 - (1 - t) * (1 - t) * (1 - t);
    }
    // Couleur du dégradé du logo à un endroit du repère (pour que les points s'y fondent).
    pure function logo-color(x: float, y: float) -> color {
        return Theme.accent1.mix(Theme.accent2, 1 - clamp((x - 53 + y - 53) / 300, 0, 1));
    }
    pure function dot-color(s: int, x: float, y: float) -> brush {
        return root.phase >= 1 ? root.logo-color(x, y)
            : s == 2 || s == 4 ? #22c55e
            : s == 3 ? #ef4444
            : s == 1 ? Theme.accent2.transparentize(0.6 - 0.5 * root.pulse)
            : #ffffff2e;
    }
    pure function dot-size(s: int) -> float {
        return s == 1 || s == 3 ? 26 : s == 0 ? 18 : 22;
    }

    // Fond : s'efface pendant le zoom (la page suivante est déjà dessous).
    opacity: 1 - root.zp * root.zp;

    logo := Rectangle {
        x: (parent.width - root.side) / 2;
        y: (parent.height - root.side) / 2 - 30px * root.k;
        width: root.side;
        height: root.side;
        // Zoom dans le point central.
        transform-scale: 1 + root.zp * root.zp * 26;

        // Contour : chaque arête part de son sommet vers le suivant, toutes en même temps.
        for i in 6: Path {
            visible: root.edge-p > 0;
            // Slint réduit le dessin d'un chemin de l'épaisseur de son trait : on agrandit d'autant.
            x: (53 - 7) * root.u;
            y: (53 - 7) * root.u;
            width: (150 + 14) * root.u;
            height: (150 + 14) * root.u;
            viewbox-x: 53;
            viewbox-y: 53;
            viewbox-width: 150;
            viewbox-height: 150;
            fill: transparent;
            stroke: root.grad;
            stroke-width: 14 * root.u;
            stroke-line-cap: round;
            commands: "M " + root.px[i] + " " + root.py[i] + " L "
                + (root.px[i] + (root.px[mod(i + 1, 6)] - root.px[i]) * root.edge-p) + " "
                + (root.py[i] + (root.py[mod(i + 1, 6)] - root.py[i]) * root.edge-p);
        }
        // Rayons, des sommets vers l'hexagone central.
        for i in 6: Path {
            visible: root.spoke-p > 0;
            x: (53 - 4) * root.u;
            y: (53 - 4) * root.u;
            width: (150 + 8) * root.u;
            height: (150 + 8) * root.u;
            viewbox-x: 53;
            viewbox-y: 53;
            viewbox-width: 150;
            viewbox-height: 150;
            fill: transparent;
            stroke: root.grad;
            stroke-width: 8 * root.u;
            stroke-line-cap: round;
            commands: "M " + root.px[i] + " " + root.py[i] + " L "
                + (root.px[i] + (root.ix[i] - root.px[i]) * root.spoke-p) + " "
                + (root.py[i] + (root.iy[i] - root.py[i]) * root.spoke-p);
        }
        // Hexagone central : le point du serveur grandit jusqu'à lui.
        Path {
            property <float> g: 0.25 + 0.75 * root.spoke-p;
            visible: root.spoke-p > 0;
            x: 53 * root.u;
            y: 53 * root.u;
            width: 150 * root.u;
            height: 150 * root.u;
            viewbox-x: 53;
            viewbox-y: 53;
            viewbox-width: 150;
            viewbox-height: 150;
            fill: root.grad;
            commands: "M " + (128 + (root.ix[0] - 128) * self.g) + " " + (128 + (root.iy[0] - 128) * self.g)
                + " L " + (128 + (root.ix[1] - 128) * self.g) + " " + (128 + (root.iy[1] - 128) * self.g)
                + " L " + (128 + (root.ix[2] - 128) * self.g) + " " + (128 + (root.iy[2] - 128) * self.g)
                + " L " + (128 + (root.ix[3] - 128) * self.g) + " " + (128 + (root.iy[3] - 128) * self.g)
                + " L " + (128 + (root.ix[4] - 128) * self.g) + " " + (128 + (root.iy[4] - 128) * self.g)
                + " L " + (128 + (root.ix[5] - 128) * self.g) + " " + (128 + (root.iy[5] - 128) * self.g) + " Z";
        }

        // Les six sommets. Pendant la liaison, chaque point prend la couleur du logo et la taille du
        // trait : il devient l'angle arrondi du contour.
        for i in 6: Rectangle {
            property <int> s: root.state[i];
            property <float> base: root.dot-size(self.s);
            animate base { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            property <length> d: (self.base + (14 - self.base) * root.edge-p) * root.u;
            x: root.px[i] * root.u - self.d / 2;
            y: root.py[i] * root.u - self.d / 2;
            width: self.d;
            height: self.d;
            border-radius: self.d / 2;
            background: root.dot-color(self.s, root.px[i], root.py[i]);
            animate background { duration: 300ms; }
            // Libellé, à l'extérieur de l'hexagone.
            Text {
                property <float> ox: (root.px[i] - 128) * 0.55;
                property <float> oy: (root.py[i] - 128) * 0.42;
                x: self.ox * root.u + (parent.width - self.width) / 2;
                y: self.oy * root.u + (parent.height - self.height) / 2;
                width: 160px * root.k;
                text: root.labels[i];
                color: parent.s == 3 ? #fca5a5 : parent.s == 0 ? #ffffff59 : #ffffffcc;
                font-size: 13px * root.k;
                font-weight: 600;
                horizontal-alignment: center;
                opacity: 1 - root.edge-p;
            }
        }
        // Le centre (7e point) : le serveur, vérifié en dernier.
        Rectangle {
            property <int> s: root.state[6];
            property <float> base: root.dot-size(self.s);
            animate base { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            property <length> d: self.base * root.u;
            x: 128 * root.u - self.d / 2;
            y: 128 * root.u - self.d / 2;
            width: self.d;
            height: self.d;
            border-radius: self.d / 2;
            background: root.dot-color(self.s, 128, 128);
            animate background { duration: 300ms; }
            opacity: 1 - root.spoke-p;
            Text {
                x: (parent.width - self.width) / 2;
                y: parent.height + 6px * root.k;
                width: 160px * root.k;
                text: root.labels[6];
                color: parent.s == 3 ? #fca5a5 : parent.s == 0 ? #ffffff59 : #ffffffcc;
                font-size: 13px * root.k;
                font-weight: 600;
                horizontal-alignment: center;
                opacity: 1 - root.edge-p;
            }
        }
    }

    // Vérification en cours, ou échec avec son explication.
    VerticalLayout {
        y: logo.y + root.side + 24px * root.k;
        width: parent.width;
        spacing: 10px * root.k;
        opacity: 1 - root.edge-p;
        alignment: start;
        Text {
            text: root.fail != "" ? root.fail : root.text;
            color: root.fail != "" ? #fca5a5 : Theme.muted;
            font-size: 16px * root.k;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.fail != "": HorizontalLayout {
            alignment: center;
            Rectangle {
                width: hint.preferred-width + 40px * root.k;
                height: 40px * root.k;
                border-radius: 10px * root.k;
                background: @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%);
                hint := Text {
                    text: root.fail-hint;
                    color: white;
                    font-size: 15px * root.k;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => {
                        root.continue-boot();
                    }
                }
            }
        }
    }

    // Choix de la langue (premier lancement).
    if root.lang-open: Rectangle {
        background: #000000a6;
        TouchArea { }
        lang-box := Rectangle {
            // Liste qui défile au-delà de ce qui tient à l'écran (langues ajoutées).
            property <length> row-h: 56px * root.k;
            property <int> fit: max(3, floor((parent.height - 160px * root.k) / self.row-h));
            property <int> shown: min(root.langs.length, self.fit);
            property <int> first: max(0, min(root.langs.length - self.shown, root.lang-sel - self.shown + 2));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px * root.k;
            height: 80px * root.k + self.shown * self.row-h;
            border-radius: 18px * root.k;
            background: Theme.glass;
            border-width: 1px;
            border-color: Theme.glass-border;
            Text {
                y: 18px * root.k;
                width: parent.width;
                text: root.lang-title;
                color: white;
                font-size: 18px * root.k;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Rectangle {
                y: 64px * root.k;
                height: parent.shown * parent.row-h;
                clip: true;
                for l[i] in root.langs: Rectangle {
                    x: 16px * root.k;
                    y: (i - lang-box.first) * lang-box.row-h;
                    animate y { duration: 160ms; easing: ease-out; }
                    width: parent.width - 32px * root.k;
                    height: 48px * root.k;
                    border-radius: 12px * root.k;
                    background: i == root.lang-sel || la.has-hover ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : #ffffff12;
                    Text {
                        text: l.label;
                        color: white;
                        font-size: 17px * root.k;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    la := TouchArea {
                        clicked => {
                            root.lang-chosen(l.id);
                        }
                    }
                }
            }
        }
    }

    // Clavier : choix de la langue, ou Entrée pour continuer après un échec.
    FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if (root.lang-open) {
                if (event.text == Key.UpArrow) {
                    root.lang-sel = max(0, root.lang-sel - 1);
                } else if (event.text == Key.DownArrow) {
                    root.lang-sel = min(root.langs.length - 1, root.lang-sel + 1);
                } else if (event.text == Key.Return && !event.repeat) {
                    root.lang-chosen(root.langs[root.lang-sel].id);
                }
                return EventResult.accept;
            }
            if (root.fail != "" && (event.text == Key.Return || event.text == " ") && !event.repeat) {
                root.continue-boot();
            }
            return EventResult.accept;
        }
    }
}
