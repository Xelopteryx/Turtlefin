// Démarrage : le logo de Turtlefin sert d'écran de vérification.
//
// Sept points : les six sommets de l'hexagone (langue, affichage, lecteur vidéo, stockage,
// configuration, réseau) et le centre (serveur). Chacun est une vraie vérification (boot.rs) : gris en
// attente, vert si tout va bien, rouge sinon (avec l'explication et « Continuer »). Quand tout est
// vert, les sommets se relient (contour), les rayons partent vers le centre, le point central devient
// l'hexagone plein : c'est exactement le logo (packaging/turtlefin.svg). Puis le logo rétrécit et se
// range à côté du nom « Turtlefin », et l'ensemble s'efface sur la page suivante. Chaque thème a sa
// mise en scène des sept points (Theme.boot-style) : 0 points qui se relient, 1 billes de verre qui
// tourbillonnent (Aero), 2 modules branchés sur une carte mère qui s'allume (Nerd). Déroulement
// piloté par Rust (boot.rs) ; `--no-intro` le saute.

import { Theme, Tr, Gloss, Motion, Nav } from "theme.slint";
import { AeroSky, Schematic } from "sky.slint";
import { TrackData } from "player.slint";
import { DustLine, DustLines } from "dust.slint";
import { ThemeLogo, Srv, Win7Ink, NerdArt } from "logo.slint";

export component BootLogo inherits Rectangle {
    in property <float> k: 1.0;
    // Fin : le logo et le nom se posent sur le titre de la page qui suit (taille du logo, son centre,
    // hauteur du milieu de la ligne, début et taille du nom).
    in property <length> tgt-logo;
    in property <length> tgt-logo-cx;
    in property <length> tgt-cy;
    in property <length> tgt-text-x;
    in property <length> tgt-font;
    in property <[int]> state;            // 7 points · 0 attente · 1 en cours · 2 ok · 3 échec · 4 à configurer (orange)
    in property <[string]> labels;
    in property <string> text;            // vérification en cours
    in property <string> fail;            // échec : explication
    in property <string> fail-hint;       // « Entrée pour continuer »
    in property <int> phase;              // 0 vérifications · 1 liaison · 2 zoom
    in property <bool> lang-open;
    // Effet de langue (dust.rs) : image sous la liste ; snap : captures en cours, liste masquée.
    in property <bool> snap;
    in property <bool> dust-on;
    in property <[DustLine]> dust-lines;
    in property <int> dust-phase;
    in property <duration> dust-t0;
    // Fragmenter les textes derrière (choix de la langue) ; pas pour la question de la visite guidée.
    in property <string> lang-title;
    in property <[TrackData]> langs;
    in-out property <int> lang-sel;
    callback continue-boot();
    callback lang-chosen(string);
    callback linked();                     // fin de la liaison : Rust ouvre la page suivante
    callback finished();                   // fin du zoom
    callback skip();                       // touche ou appui : animation passée (boot.rs)

    Rectangle {
        opacity: 1 - root.o3;
        background: @linear-gradient(180deg, Theme.bg 0%, Theme.bg-mid 55%, Theme.bg-end 100%);
        if Theme.bubbles && !root.nerd: AeroSky { k: root.k; }
        // Nerd : la carte mère se monte puce par puce, puis le courant parcourt ses pistes.
        // Nerd : le schéma de la carte (le même que le fond des pages) ; chaque vérification allume son
        // composant et s'écrit dans tty0 ; le logo se grave sur la puce du processeur, au centre.
        // La machine reste éteinte pendant les vérifications (fond seul, comme les autres thèmes) ; le
        // logo terminé l'allume : le schéma apparaît, une onde part de la puce.
        if root.nerd && root.power-on > 0.001: Rectangle {
            opacity: root.power-on;
            Schematic { live: Motion.boot; ticking: true; boot: true; check-state: root.state; check-labels: root.labels; }
        }
        if root.nerd && root.power-on > 0.001 && root.power-on < 0.999: Rectangle {
            property <length> r: max(root.width, root.height) * root.power-on;
            x: logo.x + root.side / 2 - self.r;
            y: logo.y + root.side / 2 - self.r;
            width: self.r * 2;
            height: self.width;
            border-radius: self.r;
            border-width: 3px * root.k;
            border-color: Theme.accent2.with-alpha(0.8 * (1 - root.power-on));
        }
    }
    property <float> power-on: root.nerd && (root.handoff || root.phase >= 2) ? 1 : 0;
    animate power-on { duration: 900ms; easing: ease-out; }
    TouchArea {
        clicked => {
            root.skip-now();
        }
    }

    property <bool> nerd: Theme.boot-style == 2;
    property <bool> gate: false;
    // Turtlefin (Theme.boot-style 0) : les points sont des alvéoles hexagonales qui sautent en place une à
    // une, et le contour du logo se trace entre deux sommets dès que leurs vérifications sont passées.
    // Aero : des bulles de verre montent du bas jusqu'à leur place, puis flottent en tournant lentement.
    property <bool> plain: !root.aero && !root.nerd && !root.gate;
    // Début de l'écran (arrivée des points, l'un après l'autre).
    property <duration> t0;
    init => {
        self.t0 = animation-tick();
    }
    // Aero : lente rotation de l'anneau de bulles (un tour en 40 s) et léger flottement, pendant les vérifications.
    property <angle> orbit: root.aero ? mod(animation-tick() / 1ms, 40000) / 40000 * 360deg : 0deg;
    // Sommet passé (vert, ou orange : à configurer, hors ligne) : il se relie à ses voisins (Turtlefin).
    pure function done(s: int) -> bool {
        return s == 2 || s == 4 || s == 5;
    }
    // Arrivée d'un point (0 -> 1), décalée selon son rang.
    pure function arrive(i: int) -> float {
        return clamp((animation-tick() - root.t0 - i * 110ms) / 650ms, 0, 1);
    }
    // Aucun serveur choisi (premier lancement) : le logo se forme sans son cœur (le serveur) : au centre,
    // un anneau orange qui attend. Pas d'orbe (Aero), pas de courant (Nerd : pas de processeur) ; à la
    // fin, le logo seul (sans le nom) se pose sur le titre de « Choisir un serveur », au cœur vide aussi.
    property <bool> noserver: root.state[6] == 4;
    // Serveur muet, rien de téléchargé (Srv.core 3) : la recherche de serveur suit, comme sans serveur
    // le logo se pose seul (sans le nom) sur son titre.
    property <bool> lost: Srv.core == 3;
    property <float> spread: 0;
    // Vérifications réussies (0 à 7) : la machine du thème Nerd s'allume d'autant.
    property <int> ok-n: (root.state[0] == 2 ? 1 : 0) + (root.state[1] == 2 ? 1 : 0) + (root.state[2] == 2 ? 1 : 0)
        + (root.state[3] == 2 ? 1 : 0) + (root.state[4] == 2 ? 1 : 0) + (root.state[5] == 2 ? 1 : 0) + (root.state[6] == 2 ? 1 : 0);
    property <float> power-a: root.phase >= 1 && !root.noserver ? 1 : root.ok-n / 7;
    animate power-a { duration: 500ms; easing: ease-out; }

    // Style « Aero » (Theme.boot-style 1) : les points sont des billes de verre lumineuses ; à la
    // liaison, elles tourbillonnent jusqu'au centre, un éclair blanc jaillit et le logo apparaît.
    property <bool> aero: Theme.boot-style == 1;

    // Géométrie commune avec l'icône (packaging/turtlefin.svg, packaging/icons/make-icons.py) :
    // repère 256, centre (128, 128) ; hexagone de rayon 68 (trait 14), hexagone central plein de
    // rayon 30, rayons (trait 8), bouts arrondis ; dégradé à 135° sur le carré [53, 203].
    property <[float]> px: [128, 187, 187, 128, 69, 69];
    property <[float]> py: [60, 94, 162, 196, 162, 94];
    property <[float]> ix: [128, 154, 154, 128, 102, 102];
    property <[float]> iy: [98, 113, 143, 158, 143, 113];
    property <length> side: min(self.width, self.height) * 0.46;

    property <length> u: self.side / 256;
    // Orbe (Theme.logo-style 1) : carapace blanc nacré vers l'accent clair, posée sur une sphère de verre.
    property <bool> orb: root.aero && Theme.logo-style == 1;
    property <brush> grad: root.orb || root.gate
        ? @linear-gradient(135deg, rgba(255, 255, 255, root.reveal) 0%, Theme.accent2.with-alpha(root.reveal) 110%)
        : @linear-gradient(135deg, Theme.accent1.with-alpha(root.reveal) 0%, Theme.accent2.with-alpha(root.reveal) 100%);

    // Horloges des phases (au temps : rien n'est redessiné en dehors).
    property <duration> t-link;
    property <duration> t-zoom;
    property <int> ph: root.phase;
    changed ph => {
        if (root.phase == 1) {
            root.t-link = animation-tick();
            link-timer.running = true;
        } else if (root.phase == 2) {
            root.t-zoom = animation-tick();
            zoom-timer.running = true;
        }
    }
    property <duration> outro-len: 2100ms;
    property <duration> link-len: root.aero ? 2400ms : root.nerd ? 2800ms : root.plain && !root.noserver ? 1700ms : 900ms;
    property <float> lp: root.phase == 0 ? 0 : root.phase == 1 ? clamp((animation-tick() - root.t-link) / root.link-len, 0, 1) : 1;
    // Aero : tourbillon (0 -> 1), éclair (monte puis retombe), apparition du logo.
    // Aero, sur 2,4 s : tourbillon (0 -> 0,35), éclair (0,28 -> 0,53), l'orbe surgit en zoomant avec un
    // rebond (0,36 -> 0,6), puis le logo se redessine sur elle : contour (0,5 -> 0,74), rayons et centre
    // (0,72 -> 0,9).
    property <float> swirl: root.noserver ? 0 : root.ease-io(clamp(root.lp / 0.35, 0, 1));
    property <float> flash: 0.55 * sin(clamp((root.lp - 0.27) / 0.16, 0, 1) * 180deg);
    property <float> reveal: root.aero && !root.noserver ? clamp((root.lp - 0.45) / 0.08, 0, 1) : 1;
    // La bille du serveur (au centre) devient la grande orbe : elle grossit (avec un rebond) en passant
    // de sa couleur (vert) à celle du thème. orb-s : rayon en part du rayon final (100), depuis celui de la bille (0,11).
    property <float> orb-t: root.noserver ? 0 : clamp((root.lp - 0.35) / 0.27, 0, 1);
    property <float> orb-s: 0.11 + 0.89 * root.ease(root.orb-t) + 0.12 * sin(root.orb-t * 180deg);
    property <float> orb-c: root.ease(clamp((root.orb-t - 0.15) / 0.75, 0, 1));
    property <color> srv: root.orb-color(root.state[6]);
    property <float> zp: root.phase < 2 ? 0 : clamp((animation-tick() - root.t-zoom) / root.outro-len, 0, 1);
    // Liaison : contour, puis rayons et hexagone central (selon le style).
    property <float> edge-p: root.noserver ? root.ease(clamp(root.lp * 2, 0, 1))
        : root.aero ? root.ease(clamp((root.lp - 0.5) / 0.24, 0, 1))
        : root.gate ? root.ease(clamp((root.lp - 0.45) / 0.3, 0, 1))
        : root.nerd ? root.ease(clamp((root.lp - 0.62) / 0.22, 0, 1))
        : root.plain ? root.ease(clamp((root.lp - 0.3) / 0.35, 0, 1))
        : root.ease(clamp(root.lp * 2, 0, 1));
    property <float> spoke-p: root.noserver ? root.ease(clamp(root.lp * 2 - 1, 0, 1))
        : root.aero ? root.ease(clamp((root.lp - 0.72) / 0.18, 0, 1))
        : root.gate ? root.ease(clamp((root.lp - 0.7) / 0.25, 0, 1))
        : root.nerd ? root.ease(clamp((root.lp - 0.8) / 0.18, 0, 1))
        : root.plain ? root.ease(clamp((root.lp - 0.62) / 0.33, 0, 1))
        : root.ease(clamp(root.lp * 2 - 1, 0, 1));
    // Nerd : le courant parcourt la carte (début de la liaison), avant que le logo ne se grave.
    // Seulement si ce qui alimente la carte est en place : le processeur (serveur joint) ou la maison
    // (hors ligne, téléchargements). Serveur absent, muet ou perdu : pas de courant.
    property <bool> powered: root.state[6] == 2 || Srv.core == 2;
    property <float> surge: root.phase == 0 || root.noserver || !root.powered ? 0 : clamp(root.lp / 0.62, 0, 1);
    // Nerd : les puces deviennent les plots du logo (le processeur, sa puce centrale), puis les pistes
    // du logo se tracent de plot en plot (edge-p, spoke-p) ; à la fin, le logo prend leur place
    // (handoff), identique, avant de partir se poser sur le titre. Autres thèmes : de même quand le
    // serveur ne répond pas (le logo des titres joue alors son cœur qui se fend ou se débranche).
    // Sans serveur, les pistes partent dès le début de la liaison : les plots grandissent aussitôt.
    property <float> morph: !root.nerd || root.phase == 0 ? 0
        : root.noserver ? root.ease-io(clamp(root.lp / 0.3, 0, 1))
        : root.ease-io(clamp((root.lp - 0.46) / 0.18, 0, 1));
    property <bool> handoff: root.phase >= 1 && root.spoke-p >= 1 && (root.nerd || (Srv.core != 0 && !root.noserver));
    // Fin des rayons au bord de la puce centrale (la puce est sous les pistes) : sommets du haut et
    // du bas, puis les quatre autres.
    property <[float]> spoke-end: [0.934, 0.803, 0.803, 0.934, 0.803, 0.803];
    // Libellés et textes : ils s'effacent pendant la liaison (ou l'écartement, sans serveur).
    property <float> lab-fade: root.noserver ? root.edge-p : root.aero ? min(1, root.swirl * 3) : root.gate || root.nerd ? clamp(root.lp * 3, 0, 1)
        : root.plain ? clamp(root.lp * 2.5, 0, 1) : root.edge-p;
    // Turtlefin, liaison : les alvéoles passent de la couleur de leur état à celle du logo (tint-q, sur le
    // premier tiers), puis s'arrondissent (round-q) au moment où le contour part d'elles.
    property <float> tint-q: root.plain && root.phase >= 1 ? root.ease(clamp(root.lp / 0.35, 0, 1)) : 0;
    property <float> round-q: root.plain && root.phase >= 1 ? clamp((root.lp - 0.3) / 0.25, 0, 1) : 0;
    // Couleur d'un état (vérifications), comme dot-color, en couleur unie (pour le mélange de la liaison).
    pure function state-color(s: int) -> color {
        return s == 2 ? #22c55e : s == 4 || s == 5 ? #f59e0b : s == 3 ? #ef4444
            : s == 1 ? Theme.accent2.transparentize(0.6 - 0.5 * root.pulse) : Theme.fg.with-alpha(0.18);
    }
    // Couleur d'une alvéole pendant la liaison : de son état vers le logo.
    pure function link-color(s: int, x: float, y: float) -> color {
        return root.logo-color(x, y).mix(root.state-color(s), root.tint-q);
    }
    // Fin (zp) : le logo rétrécit et glisse à gauche (o1), le nom « Turtlefin » apparaît à sa droite (o2),
    // puis tout s'efface sur la page suivante (o3). Sans serveur : pas de nom, le logo reste au milieu.
    property <float> o1: root.ease-io(clamp(root.zp / 0.42, 0, 1));
    property <float> o2: root.noserver || root.lost ? 0 : root.ease(clamp((root.zp - 0.3) / 0.3, 0, 1));
    // o4 : l'ensemble monte se poser sur le titre de la page ; o3 : le fond s'efface dessous.
    property <float> o4: root.ease-io(clamp((root.zp - 0.48) / 0.4, 0, 1));
    property <float> o3: clamp((root.zp - 0.8) / 0.2, 0, 1);
    // Logo : centre et taille, du milieu de l'écran (côte à côte) jusqu'au titre.
    property <length> mid-cx: root.end-cx;
    property <length> mid-cy: root.height / 2;
    property <length> logo-cx: root.mid-cx + (root.tgt-logo-cx - root.mid-cx) * root.o4;
    property <length> logo-cy: root.mid-cy + (root.tgt-cy - root.mid-cy) * root.o4;
    property <float> logo-s: 1 - (1 - root.mini) * root.o1 + (root.tgt-logo / root.side - root.mini) * root.o4;
    property <float> mini: 0.36;
    property <length> word-gap: 20px * root.k;
    property <length> word-size: root.side * 0.17;
    property <length> group-w: root.side * root.mini + root.word-gap + word-m.preferred-width;
    property <length> end-cx: root.noserver || root.lost ? root.width / 2 : (root.width - root.group-w) / 2 + root.side * root.mini / 2;
    word-m := Text { visible: false; text: "Turtlefin"; font-size: root.word-size; font-weight: 800; }
    link-timer := Timer {
        interval: root.link-len + 150ms;
        running: false;
        triggered => {
            self.running = false;
            root.linked();
        }
    }
    zoom-timer := Timer {
        interval: root.outro-len + 40ms;
        running: false;
        triggered => {
            self.running = false;
            root.finished();
        }
    }
    property <bool> ring: root.noserver && root.phase >= 1 && !root.nerd;
    // Point « en cours » : pulsation.
    property <float> pulse: 0.5 + 0.5 * sin(mod(animation-tick() / 1ms, 900) / 900 * 360deg);

    pure function ease(t: float) -> float {
        return 1 - (1 - t) * (1 - t) * (1 - t);
    }
    pure function ease-io(t: float) -> float {
        return t < 0.5 ? 4 * t * t * t : 1 - (2 - 2 * t) * (2 - 2 * t) * (2 - 2 * t) / 2;
    }
    // Couleur d'une bille (Aero) : vert, orange (à configurer, ou hors ligne : 5), rouge, bleu
    // d'attente, gris.
    pure function orb-color(s: int) -> color {
        return s == 2 ? #3fd46a : s == 4 || s == 5 ? #ffb02e : s == 3 ? #ff4d4d : s == 1 ? Theme.accent2 : #9fb8d8;
    }
    // Couleur du dégradé du logo à un endroit du repère (pour que les points s'y fondent).
    pure function logo-color(x: float, y: float) -> color {
        return Theme.accent1.mix(Theme.accent2, 1 - clamp((x - 53 + y - 53) / 300, 0, 1));
    }
    pure function dot-color(s: int, x: float, y: float) -> brush {
        return root.phase >= 1 ? root.logo-color(x, y)
            : s == 2 ? #22c55e
            // À configurer (aucun serveur choisi au premier lancement), ou hors ligne (5 : réseau
            // absent, serveur muet) : orange, pas vert.
            : s == 4 || s == 5 ? #f59e0b
            : s == 3 ? #ef4444
            : s == 1 ? Theme.accent2.transparentize(0.6 - 0.5 * root.pulse)
            : Theme.fg.with-alpha(0.18);
    }
    // Diamètre d'un point (repère 256) : plus grand en cours et en échec.
    pure function dot-size(s: int) -> float {
        return s == 1 || s == 3 ? 36 : s == 0 ? 26 : 32;
    }
    // Onde d'un point (0 -> 1, en boucle) : les ondes partent du point en cours.
    property <float> wave: mod(animation-tick() / 1ms, 1300) / 1300;

    // Fond : s'efface à la fin (voir le premier rectangle) ; logo et nom restent posés sur le titre.

    logo := Rectangle {
        x: (root.o4 > 0 ? root.logo-cx : parent.width / 2 + (root.end-cx - parent.width / 2) * root.o1) - root.side / 2;
        y: (root.o4 > 0 ? root.logo-cy : root.mid-cy) - root.side / 2;
        width: root.side;
        height: root.side;
        // Fin : le logo rétrécit à côté du nom, puis monte se poser sur le titre de la page.
        transform-scale: root.logo-s;

        // Orbe de verre derrière le logo : sphère d'accent sombre au bord, lueur en bas.
        if root.orb && root.orb-t > 0 && !root.handoff: Rectangle {
            x: (128 - 100 * root.orb-s) * root.u;
            y: (128 - 100 * root.orb-s) * root.u;
            width: 200 * root.orb-s * root.u;
            height: self.width;
            border-radius: self.width / 2;
            // Fin : le verre sombre du logo (ThemeLogo), pour qu'il n'y ait pas de saut de couleur au relais.
            background: @radial-gradient(circle, root.srv.brighter(0.5).mix(#0a3270, 1 - root.orb-c) 0%,
                root.srv.mix(#061c44, 1 - root.orb-c) 62%, root.srv.darker(0.35).mix(#020c1e, 1 - root.orb-c) 100%);
            border-width: 2px;
            border-color: rgba(160, 210, 255, 0.55 * root.orb-c);
            drop-shadow-blur: 30 * root.u;
            drop-shadow-color: root.srv.mix(Theme.accent2, 1 - root.orb-c).with-alpha(0.6);
            Rectangle {
                x: parent.width * 0.15;
                y: parent.height * 0.42;
                width: parent.width * 0.7;
                height: parent.height * 0.6;
                border-radius: self.width / 2;
                background: @radial-gradient(circle, #2a8ce6.with-alpha(0.75) 0%, #2a8ce6.with-alpha(0) 72%);
            }
        }
        // Aero : halo du logo qui s'allume, et éclair blanc au moment où les billes se rejoignent.
        if root.aero && root.lp > 0.4 && !root.handoff: Rectangle {
            property <float> w: 120 + 150 * root.reveal;
            x: (128 - self.w / 2) * root.u;
            y: (128 - self.w / 2) * root.u;
            width: self.w * root.u;
            height: self.width;
            border-radius: self.width / 2;
            background: @radial-gradient(circle, Theme.accent2.with-alpha(0.55 * root.reveal) 0%, Theme.accent2.with-alpha(0.18 * root.reveal) 40%, Theme.accent2.with-alpha(0) 70%);
        }
        if root.aero && root.flash > 0.01: Rectangle {
            property <float> w: 30 + 330 * root.flash;
            x: (128 - self.w / 2) * root.u;
            y: (128 - self.w / 2) * root.u;
            width: self.w * root.u;
            height: self.width;
            border-radius: self.width / 2;
            background: @radial-gradient(circle, rgba(255, 255, 255, 0.95 * root.flash) 0%, rgba(200, 240, 255, 0.5 * root.flash) 25%, rgba(200, 240, 255, 0) 70%);
        }

        // Contour : chaque arête part de son sommet vers le suivant, toutes en même temps.
        for i in 6: Path {
            visible: root.edge-p > 0 && !root.nerd && !root.handoff;
            // Slint réduit le dessin d'un chemin de l'épaisseur de son trait : on agrandit d'autant.
            // Aero : cadre de Win7Shell (logo.slint), pour que les couleurs tombent au même endroit qu'à la fin.
            x: (53 - 7) * root.u;
            y: (53 - 7) * root.u;
            width: (150 + 14) * root.u;
            height: (150 + 14) * root.u;
            viewbox-x: root.orb ? 53 - 7 : 53;
            viewbox-y: root.orb ? 53 - 7 : 53;
            viewbox-width: root.orb ? 150 + 14 : 150;
            viewbox-height: root.orb ? 150 + 14 : 150;
            fill: transparent;
            stroke: root.orb ? Win7Ink.edge(i, root.reveal, 0) : root.grad;
            stroke-width: 14 * root.u;
            stroke-line-cap: round;
            commands: "M " + root.px[i] + " " + root.py[i] + " L "
                + (root.px[i] + (root.px[mod(i + 1, 6)] - root.px[i]) * root.edge-p) + " "
                + (root.py[i] + (root.py[mod(i + 1, 6)] - root.py[i]) * root.edge-p);
        }
        // Rayons, des sommets vers l'hexagone central.
        for i in 6: Path {
            visible: root.spoke-p > 0 && !root.nerd && !root.handoff;
            x: (53 - (root.orb ? 7 : 4)) * root.u;
            y: (53 - (root.orb ? 7 : 4)) * root.u;
            width: (150 + (root.orb ? 14 : 8)) * root.u;
            height: (150 + (root.orb ? 14 : 8)) * root.u;
            viewbox-x: root.orb ? 53 - 7 : 53;
            viewbox-y: root.orb ? 53 - 7 : 53;
            viewbox-width: root.orb ? 150 + 14 : 150;
            viewbox-height: root.orb ? 150 + 14 : 150;
            fill: transparent;
            stroke: root.orb ? Win7Ink.spoke(i, root.reveal, 0) : root.grad;
            stroke-width: 8 * root.u;
            stroke-line-cap: round;
            commands: "M " + root.px[i] + " " + root.py[i] + " L "
                + (root.px[i] + (root.ix[i] - root.px[i]) * root.spoke-p) + " "
                + (root.py[i] + (root.iy[i] - root.py[i]) * root.spoke-p);
        }
        // Nerd : les pistes du logo se tracent entre les plots (les puces devenues plots, dessous) :
        // chaque arête part du bord de son plot vers le suivant, puis les rayons vers la puce centrale.
        // Même dessin que ThemeLogo (repère 256, trait 9).
        for i in 6: Path {
            visible: root.nerd && root.edge-p > 0 && !root.handoff;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            viewbox-width: 256;
            viewbox-height: 256;
            fill: transparent;
            stroke: @linear-gradient(135deg, Theme.accent1 0%, Theme.accent2 100%);
            stroke-width: 9 * root.u;
            property <float> f0: 14 / 68;
            property <float> f1: self.f0 + (1 - 2 * self.f0) * root.edge-p;
            commands: "M " + (root.px[i] + (root.px[mod(i + 1, 6)] - root.px[i]) * self.f0) + " " + (root.py[i] + (root.py[mod(i + 1, 6)] - root.py[i]) * self.f0)
                + " L " + (root.px[i] + (root.px[mod(i + 1, 6)] - root.px[i]) * self.f1) + " " + (root.py[i] + (root.py[mod(i + 1, 6)] - root.py[i]) * self.f1);
        }
        for i in 6: Path {
            visible: root.nerd && root.spoke-p > 0 && !root.handoff && !root.noserver;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            viewbox-width: 256;
            viewbox-height: 256;
            fill: transparent;
            stroke: @linear-gradient(135deg, Theme.accent1 0%, Theme.accent2 100%);
            stroke-width: 9 * root.u;
            property <float> f0: 14 / 38;
            property <float> f1: self.f0 + (root.spoke-end[i] - self.f0) * root.spoke-p;
            commands: "M " + (root.px[i] + (root.ix[i] - root.px[i]) * self.f0) + " " + (root.py[i] + (root.iy[i] - root.py[i]) * self.f0)
                + " L " + (root.px[i] + (root.ix[i] - root.px[i]) * self.f1) + " " + (root.py[i] + (root.iy[i] - root.py[i]) * self.f1);
        }
        // Nerd : les pattes de la puce sortent pendant qu'elle grandit (mêmes que ThemeLogo).
        if root.nerd && !root.noserver && root.morph > 0 && !root.handoff: Path {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            viewbox-width: 256;
            viewbox-height: 256;
            fill: transparent;
            stroke: Theme.accent2.with-alpha(root.morph);
            stroke-width: 4 * root.u;
            commands: NerdArt.pins;
        }
        // Puis le logo lui-même (le même que sur les titres, voir ThemeLogo) prend le relais.
        if root.handoff: ThemeLogo {
            hollow: root.noserver;
            width: parent.width;
            height: parent.height;
        }
        // Hexagone central : le point du serveur grandit jusqu'à lui.
        Path {
            property <float> g: 0.25 + 0.75 * root.spoke-p;
            visible: root.spoke-p > 0 && !root.nerd && !root.noserver && !root.handoff;
            x: 53 * root.u;
            y: 53 * root.u;
            width: 150 * root.u;
            height: 150 * root.u;
            viewbox-x: 53;
            viewbox-y: 53;
            viewbox-width: 150;
            viewbox-height: 150;
            fill: root.grad;
            commands: "M " + (128 + (root.ix[0] - 128) * self.g) + " " + (128 + (root.iy[0] - 128) * self.g)
                + " L " + (128 + (root.ix[1] - 128) * self.g) + " " + (128 + (root.iy[1] - 128) * self.g)
                + " L " + (128 + (root.ix[2] - 128) * self.g) + " " + (128 + (root.iy[2] - 128) * self.g)
                + " L " + (128 + (root.ix[3] - 128) * self.g) + " " + (128 + (root.iy[3] - 128) * self.g)
                + " L " + (128 + (root.ix[4] - 128) * self.g) + " " + (128 + (root.iy[4] - 128) * self.g)
                + " L " + (128 + (root.ix[5] - 128) * self.g) + " " + (128 + (root.iy[5] - 128) * self.g) + " Z";
        }

        // Turtlefin : pendant les vérifications, l'arête entre deux sommets passés se trace (fine, en
        // couleur d'accent) ; la liaison la recouvre ensuite du vrai contour.
        for i in 6: Path {
            property <bool> on: root.plain && root.phase <= 1 && root.done(root.state[i]) && root.done(root.state[mod(i + 1, 6)]);
            property <float> p: self.on ? 1 : 0;
            animate p { duration: 450ms; easing: ease-out; }
            visible: root.plain && root.phase <= 1 && self.p > 0.01 && root.edge-p < 1;
            x: (53 - 4) * root.u;
            y: (53 - 4) * root.u;
            width: (150 + 8) * root.u;
            height: (150 + 8) * root.u;
            viewbox-x: 53;
            viewbox-y: 53;
            viewbox-width: 150;
            viewbox-height: 150;
            fill: transparent;
            stroke: Theme.accent2.with-alpha(0.55 * (1 - root.edge-p));
            stroke-width: 4 * root.u;
            stroke-line-cap: round;
            commands: "M " + root.px[i] + " " + root.py[i] + " L "
                + (root.px[i] + (root.px[mod(i + 1, 6)] - root.px[i]) * self.p) + " "
                + (root.py[i] + (root.py[mod(i + 1, 6)] - root.py[i]) * self.p);
        }

        // Les six sommets. Pendant la liaison, chaque point prend la couleur du logo et la taille du
        // trait : il devient l'angle arrondi du contour.
        for i in 6: Rectangle {
            property <int> s: root.state[i];
            property <float> base: root.dot-size(self.s) * (root.aero ? 1.1 : 1);
            animate base { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            // Aero : la bille tourne autour du centre en s'en rapprochant (rayon 68 -> 0).
            property <angle> ang: (-90 + 60 * i) * 1deg + root.swirl * 420deg + root.orbit;
            property <float> in-p: root.arrive(i);
            // Aero : flottement (s'éteint pendant le tourbillon) ; Turtlefin : saut d'arrivée.
            property <float> bob: root.aero ? 3 * sin(mod(animation-tick() / 1ms, 2600) / 2600 * 360deg + i * 60deg) * (1 - root.swirl) : 0;
            property <float> pop: self.in-p >= 1 ? 1 : root.ease(self.in-p) + 0.3 * sin(self.in-p * 180deg);
            // Aero : la bulle se gonfle sur place, en tremblant comme une bulle de savon.
            property <float> blow: self.in-p >= 1 ? 1 : root.ease(self.in-p) + 0.14 * sin(self.in-p * 540deg) * (1 - self.in-p);
            property <float> rad: (68 + self.bob) * (1 - root.swirl);
            // Sept chevrons : près de son chevron (voir chev-of).
            property <angle> ga: (-90 + 40 * [1, 2, 3, 6, 7, 8][i]) * 1deg;
            property <float> cx: root.gate ? 128 + 150 * cos(self.ga) : root.aero ? 128 + self.rad * (1 + 0.5 * root.spread) * cos(self.ang)
                : 128 + (root.px[i] - 128) * (1 + 0.5 * root.spread);
            property <float> cy: root.gate ? 128 + 150 * sin(self.ga) : root.aero ? 128 + self.rad * (1 + 0.5 * root.spread) * sin(self.ang)
                : 128 + (root.py[i] - 128) * (1 + 0.5 * root.spread);
            // Nerd : la pastille grandit jusqu'au plot du logo (anneau de 28, voir ThemeLogo) avant que
            // les pistes n'en partent (morph).
            property <length> d: (root.aero ? self.base * (1 - 0.35 * root.swirl) * self.blow
                : root.nerd ? self.base * 0.6 + (28 - self.base * 0.6) * root.morph
                : (self.base + (14 - self.base) * root.edge-p) * (root.plain ? self.pop : 1)) * root.u;
            // Turtlefin : alvéole hexagonale (dessinée par le Path dessous) ; pendant la liaison, elle se
            // fond dans un rond (round-q), qui devient l'angle arrondi du contour.
            property <bool> hex: root.plain && root.round-q < 1;
            x: self.cx * root.u - self.d / 2;
            y: self.cy * root.u - self.d / 2;
            width: self.d;
            height: self.d;
            border-radius: root.nerd ? 2px + (self.d / 2 - 2px) * root.morph : self.d / 2;
            visible: (!root.aero || root.orb-t == 0) && !root.handoff;
            // Nerd : pastille carrée, à la couleur de la vérification ; à la liaison, elle s'arrondit en
            // plot du logo (anneau d'accent, fond de la page, soudure au milieu).
            border-width: root.nerd ? 1.5px + (6 * root.u - 1.5px) * root.morph : 0px;
            border-color: Theme.accent2.with-alpha(0.7 + 0.3 * root.morph);
            background: root.gate ? transparent
                : root.plain ? (root.phase == 0 ? transparent : root.link-color(self.s, root.px[i], root.py[i]).with-alpha(root.round-q))
                : root.aero ? @radial-gradient(circle, root.orb-color(self.s).brighter(0.5) 0%, root.orb-color(self.s) 55%, root.orb-color(self.s).darker(0.35) 100%)
                : root.nerd && root.phase >= 1 ? Theme.bg.mix(root.state-color(self.s), root.morph)
                : root.dot-color(self.s, root.px[i], root.py[i]);
            animate background { duration: root.plain || (root.nerd && root.phase >= 1) ? 0ms : 300ms; }
            if root.nerd && root.morph > 0: Rectangle {
                width: 7 * root.u;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.accent1.with-alpha(root.morph);
            }
            drop-shadow-blur: root.aero && !root.nerd && !root.gate ? self.d * 0.9 : 0px;
            drop-shadow-color: root.aero ? root.orb-color(self.s).with-alpha(0.85) : transparent;
            if self.hex: Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 100;
                viewbox-height: 100;
                // En attente : contour seul ; ensuite plein, à la couleur de l'état (liaison : vers le logo).
                fill: parent.s == 0 ? transparent : root.phase == 0 ? root.dot-color(parent.s, root.px[i], root.py[i])
                    : root.link-color(parent.s, root.px[i], root.py[i]).with-alpha(1 - root.round-q);
                stroke: parent.s == 0 ? Theme.fg.with-alpha(0.35) : transparent;
                stroke-width: 2px;
                stroke-line-join: round;
                commands: "M 50 2 L 91.6 26 L 91.6 74 L 50 98 L 8.4 74 L 8.4 26 Z";
            }
            // Vérification réussie : le point rebondit (base) et lance un anneau qui s'élargit en s'effaçant.
            property <duration> t-ok;
            changed s => {
                if (self.s == 2 || self.s == 3) {
                    self.t-ok = animation-tick();
                }
            }
            // En cours : deux ondes qui partent du point, décalées d'une demi-période.
            for w in (root.phase == 0 && self.s == 1 && root.aero ? 2 : 0): Rectangle {
                property <float> t: mod(root.wave + w * 0.5, 1);
                width: parent.width * (1 + 1.6 * self.t);
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                border-width: 3 * root.u;
                border-color: root.orb-color(1).with-alpha(0.7 * (1 - self.t));
            }
            for w in (root.phase == 0 && self.s == 1 && root.plain ? 2 : 0): Path {
                property <float> t: mod(root.wave + w * 0.5, 1);
                width: parent.width * (1 + 1.6 * self.t);
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                viewbox-width: 100;
                viewbox-height: 100;
                fill: transparent;
                stroke: Theme.accent2.with-alpha(0.7 * (1 - self.t));
                stroke-width: 3 * root.u;
                stroke-line-join: round;
                commands: "M 50 2 L 91.6 26 L 91.6 74 L 50 98 L 8.4 74 L 8.4 26 Z";
            }
            if root.phase == 0 && (self.s == 2 || self.s == 3) && root.aero && animation-tick() - self.t-ok < 650ms: Rectangle {
                property <float> t: clamp((animation-tick() - parent.t-ok) / 650ms, 0, 1);
                width: parent.width * (1 + 1.8 * root.ease(self.t));
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                border-width: 4 * root.u * (1 - self.t) + 1px;
                border-color: (parent.s == 2 ? #22c55e : #ef4444).with-alpha(0.9 * (1 - self.t));
            }
            if root.phase == 0 && (self.s == 2 || self.s == 3) && root.plain && animation-tick() - self.t-ok < 650ms: Path {
                property <float> t: clamp((animation-tick() - parent.t-ok) / 650ms, 0, 1);
                width: parent.width * (1 + 1.8 * root.ease(self.t));
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                viewbox-width: 100;
                viewbox-height: 100;
                fill: transparent;
                stroke: (parent.s == 2 ? #22c55e : #ef4444).with-alpha(0.9 * (1 - self.t));
                stroke-width: 4 * root.u * (1 - self.t) + 1px;
                stroke-line-join: round;
                commands: "M 50 2 L 91.6 26 L 91.6 74 L 50 98 L 8.4 74 L 8.4 26 Z";
            }
            // Reflet de la bille.
            if root.aero && !root.nerd && !root.gate: Rectangle {
                x: parent.width * 0.2;
                y: parent.height * 0.1;
                width: parent.width * 0.6;
                height: parent.height * 0.42;
                border-radius: self.height / 2;
                background: @linear-gradient(180deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.05) 100%);
            }
            // Libellé, à l'extérieur de l'hexagone (Nerd : sous le module ; Sept chevrons : sur le point).
            Text {
                property <float> ox: root.aero ? 68 * cos(parent.ang) * 0.72 : (root.px[i] - 128) * 0.72;
                property <float> oy: root.aero ? 68 * sin(parent.ang) * 0.62 : (root.py[i] - 128) * 0.62;
                x: self.ox * root.u + (parent.width - self.width) / 2;
                y: self.oy * root.u + (parent.height - self.height) / 2;
                width: 160px * root.k;
                text: root.labels[i];
                // Fondu par la couleur : une transparence d'ensemble (opacity) dessine l'élément à part,
                // dans une texture créée au premier fondu ; huit d'un coup figeaient la liaison.
                color: (parent.s == 3 ? Theme.danger-text : parent.s == 0 ? Theme.fg.with-alpha(0.35) : Theme.fg.with-alpha(0.8)).transparentize(root.lab-fade);
                font-size: 13px * root.k;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
        // Le centre (7e point) : le serveur, vérifié en dernier.
        Rectangle {
            visible: !root.handoff;
            property <int> s: root.state[6];
            property <float> base: root.ring ? 30 : root.dot-size(self.s);
            animate base { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            property <float> in-p: root.arrive(6);
            property <float> pop: self.in-p >= 1 ? 1 : root.ease(self.in-p) + 0.3 * sin(self.in-p * 180deg);
            property <float> blow: self.in-p >= 1 ? 1 : root.ease(self.in-p) + 0.14 * sin(self.in-p * 540deg) * (1 - self.in-p);
            // Nerd : la pastille du serveur grandit jusqu'à la puce du logo (65 avec son contour), ou,
            // sans serveur, jusqu'au support vide (60).
            property <float> chip-d: root.noserver ? 60 : 65;
            property <length> d: (root.nerd ? self.base * 0.6 + (self.chip-d - self.base * 0.6) * root.morph
                : self.base * (root.plain && root.phase == 0 ? self.pop : root.aero && root.phase == 0 ? self.blow : 1)) * root.u;
            // Sans serveur : anneau orange qui attend (le même que le titre de « Choisir un serveur »).
            border-width: root.nerd ? 1.5px + ((root.noserver ? 4 : 5) * root.u - 1.5px) * root.morph : root.ring ? 5 * root.u : 0px;
            border-color: root.nerd ? (root.noserver ? #f59e0b.mix(Theme.accent2.with-alpha(0.7), root.morph) : Theme.accent2.with-alpha(0.7 + 0.3 * root.morph))
                : #f59e0b.with-alpha(0.55 + 0.45 * root.pulse);
            x: 128 * root.u - self.d / 2;
            y: 128 * root.u - self.d / 2;
            width: self.d;
            height: self.d;
            border-radius: root.nerd ? (2 + 0.5 * root.morph) * root.u : self.d / 2;
            // Nerd : cœur de la puce (carré d'accent de 24, comme ThemeLogo).
            if root.nerd && !root.noserver && root.morph > 0: Rectangle {
                width: 24 * root.u;
                height: self.width;
                background: Theme.accent1.with-alpha(root.morph);
            }
            // Turtlefin : alvéole hexagonale, comme les sommets ; pendant la liaison, elle prend la couleur
            // du logo et s'efface dans l'hexagone central qui grandit (même forme).
            property <bool> hex: root.plain && !root.ring && (root.phase == 0 || root.spoke-p < 1);
            if self.hex: Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 100;
                viewbox-height: 100;
                fill: parent.s == 0 ? transparent : root.phase == 0 ? root.dot-color(parent.s, 128, 128)
                    : root.link-color(parent.s, 128, 128).with-alpha(1 - root.spoke-p);
                stroke: parent.s == 0 ? Theme.fg.with-alpha(0.35) : transparent;
                stroke-width: 2px;
                stroke-line-join: round;
                commands: "M 50 2 L 91.6 26 L 91.6 74 L 50 98 L 8.4 74 L 8.4 26 Z";
            }
            // Fondu par la couleur (voir les libellés).
            background: root.gate || root.ring || self.hex ? transparent : root.aero
                ? (root.orb-t > 0 ? transparent : @radial-gradient(circle, root.orb-color(self.s).brighter(0.5) 0%, root.orb-color(self.s) 55%, root.orb-color(self.s).darker(0.35) 100%))
                // Nerd : vers le silicium de la puce (ou le fond orangé du support vide).
                : root.nerd && root.phase >= 1 ? (root.noserver ? #f59e0b.with-alpha(0.10).mix(root.state-color(self.s), root.morph)
                    : Theme.accent1.mix(Theme.bg, 0.25).mix(root.state-color(self.s), root.morph))
                : root.spoke-p > 0 ? root.logo-color(128, 128).transparentize(root.spoke-p) : root.dot-color(self.s, 128, 128);
            // Aero : l'orbe prend sa place d'un coup (même taille, même couleur), sans fondu.
            animate background { duration: root.aero || (root.nerd && root.phase >= 1) ? 0ms : 300ms; }
            drop-shadow-blur: root.aero && !root.nerd && !root.gate && root.orb-t == 0 ? self.d * 0.9 : 0px;
            drop-shadow-color: root.orb-color(self.s).with-alpha(0.85);
            // Ondes (en cours) et anneau de réussite, comme les sommets.
            property <duration> t-ok;
            changed s => {
                if (self.s == 2 || self.s == 3) {
                    self.t-ok = animation-tick();
                }
            }
            for w in (root.phase == 0 && self.s == 1 && root.aero ? 2 : 0): Rectangle {
                property <float> t: mod(root.wave + w * 0.5, 1);
                width: parent.width * (1 + 1.6 * self.t);
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                border-width: 3 * root.u;
                border-color: root.orb-color(1).with-alpha(0.7 * (1 - self.t));
            }
            for w in (self.hex && self.s == 1 ? 2 : 0): Path {
                property <float> t: mod(root.wave + w * 0.5, 1);
                width: parent.width * (1 + 1.6 * self.t);
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                viewbox-width: 100;
                viewbox-height: 100;
                fill: transparent;
                stroke: Theme.accent2.with-alpha(0.7 * (1 - self.t));
                stroke-width: 3 * root.u;
                stroke-line-join: round;
                commands: "M 50 2 L 91.6 26 L 91.6 74 L 50 98 L 8.4 74 L 8.4 26 Z";
            }
            if self.hex && (self.s == 2 || self.s == 3) && animation-tick() - self.t-ok < 650ms: Path {
                property <float> t: clamp((animation-tick() - parent.t-ok) / 650ms, 0, 1);
                width: parent.width * (1 + 1.8 * root.ease(self.t));
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                viewbox-width: 100;
                viewbox-height: 100;
                fill: transparent;
                stroke: (parent.s == 2 ? #22c55e : #ef4444).with-alpha(0.9 * (1 - self.t));
                stroke-width: 4 * root.u * (1 - self.t) + 1px;
                stroke-line-join: round;
                commands: "M 50 2 L 91.6 26 L 91.6 74 L 50 98 L 8.4 74 L 8.4 26 Z";
            }
            if root.phase == 0 && (self.s == 2 || self.s == 3) && root.aero && animation-tick() - self.t-ok < 650ms: Rectangle {
                property <float> t: clamp((animation-tick() - parent.t-ok) / 650ms, 0, 1);
                width: parent.width * (1 + 1.8 * root.ease(self.t));
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                border-width: 4 * root.u * (1 - self.t) + 1px;
                border-color: (parent.s == 2 ? #22c55e : #ef4444).with-alpha(0.9 * (1 - self.t));
            }
            if root.aero && !root.nerd && !root.gate && root.orb-t == 0: Rectangle {
                x: parent.width * 0.2;
                y: parent.height * 0.1;
                width: parent.width * 0.6;
                height: parent.height * 0.42;
                border-radius: self.height / 2;
                background: @linear-gradient(180deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.05) 100%);
            }
            Text {
                x: (parent.width - self.width) / 2;
                // Sept chevrons : au-dessus du chevron du haut.
                y: root.gate ? -150 * root.u : parent.height + 6px * root.k;
                width: 160px * root.k;
                text: root.labels[6];
                // Fondu par la couleur : une transparence d'ensemble (opacity) dessine l'élément à part,
                // dans une texture créée au premier fondu ; huit d'un coup figeaient la liaison.
                color: (parent.s == 3 ? Theme.danger-text : parent.s == 0 ? Theme.fg.with-alpha(0.35) : Theme.fg.with-alpha(0.8)).transparentize(root.lab-fade);
                font-size: 13px * root.k;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
        // Reflet blanc de l'orbe, par-dessus la carapace (le même que ThemeLogo).
        if root.orb && root.orb-t > 0 && !root.handoff: Image {
            x: (128 - 100 * root.orb-s) * root.u;
            y: (128 - 100 * root.orb-s) * root.u;
            width: 200 * root.orb-s * root.u;
            height: self.width;
            source: @image-url("logo/orb_gloss.png");
        }
    }

    // Fin : le nom, à droite du logo réduit (Nerd : curseur qui clignote, comme dans un terminal).
    if root.o2 > 0: Text {
        property <length> x0: root.end-cx + root.side * root.mini / 2 + root.word-gap - (1 - root.o2) * 30px * root.k;
        x: self.x0 + (root.tgt-text-x - self.x0) * root.o4;
        y: root.mid-cy + (root.tgt-cy - root.mid-cy) * root.o4 - self.height / 2;
        opacity: root.o2;
        // Nerd : curseur de terminal qui clignote, jusqu'à ce que le nom se pose.
        text: root.nerd && root.o4 < 1 ? (mod(animation-tick() / 1ms, 900) < 450 ? "Turtlefin_" : "Turtlefin ") : "Turtlefin";
        font-size: root.word-size + (root.tgt-font - root.word-size) * root.o4;
        font-weight: 800;
        // Même couleur que le titre où il se pose.
        color: Theme.gloss > 0 ? @linear-gradient(180deg, #ffffff 0%, Theme.accent2.brighter(0.5) 50%, Theme.accent2 51%, Theme.accent2.darker(0.15) 100%)
            : Theme.dark ? Theme.accent2 : Theme.accent1;
    }

    // Vérification en cours, ou échec avec son explication.
    VerticalLayout {
        y: logo.y + root.side + 24px * root.k;
        width: parent.width;
        spacing: 10px * root.k;
        // Pas de transparence d'ensemble (voir les libellés) : le texte s'efface par sa couleur, et
        // le bouton d'un échec n'est pas affiché pendant la liaison.
        alignment: start;
        Text {
            text: root.fail != "" ? root.fail : root.text;
            color: (root.fail != "" ? Theme.danger-text : Theme.muted).transparentize(root.lab-fade);
            font-size: 16px * root.k;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.fail != "": HorizontalLayout {
            alignment: center;
            Rectangle {
                width: hint.preferred-width + 40px * root.k;
                height: 40px * root.k;
                border-radius: 10px * root.k;
                background: @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%);
                Gloss { r: parent.border-radius; strength: 0.8; }
                hint := Text {
                    text: root.fail-hint;
                    color: Theme.on-accent;
                    font-size: 15px * root.k;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => {
                        root.continue-boot();
                    }
                }
            }
        }
    }

    // Choix de la langue (premier lancement).
    // Apparition : fondu du voile, la boîte monte et grandit ; fermeture : l'inverse. Langue
    // choisie : les textes changent « en poussière » (dust.rs).
    property <float> lang-p: root.lang-open ? 1 : 0;
    animate lang-p { duration: 320ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    if root.dust-on: DustLines {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        lines: root.dust-lines;
        phase: root.dust-phase;
        t0: root.dust-t0;
        k: root.k;
    }
    if root.lang-p > 0.01 && !root.snap: Rectangle {
        background: Theme.scrim.with-alpha(0.65).transparentize(1 - root.lang-p);
        TouchArea {
            // La molette ne fait pas défiler la page dessous.
            scroll-event(e) => {
                return EventResult.accept;
            }
        }
        lang-box := Rectangle {
            // Liste qui défile au-delà de ce qui tient à l'écran (langues ajoutées).
            property <length> row-h: 56px * root.k;
            property <int> fit: max(3, floor((parent.height - 160px * root.k) / self.row-h));
            property <int> shown: min(root.langs.length, self.fit);
            property <int> first: max(0, min(root.langs.length - self.shown, root.lang-sel - self.shown + 2));
            // Au doigt : la liste suit le glissement (défilement libre) ; une touche la recale.
            property <length> max-off: max(0px, (root.langs.length - self.shown) * self.row-h);
            property <bool> free;
            property <length> free-off;
            property <length> off: self.free ? self.free-off : self.first * self.row-h;
            property <int> sel-now: root.lang-sel;
            changed sel-now => {
                self.free = false;
            }
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (1 - root.lang-p) * 40px * root.k;
            opacity: root.lang-p;
            transform-scale: 0.92 + 0.08 * root.lang-p;
            width: min(420px * root.k, parent.width - 32px * root.k);
            height: 80px * root.k + self.shown * self.row-h;
            border-radius: 18px * root.k;
            // Base opaque sous le verre : rien de ce qui est derrière (accueil en chargement, grains de
            // l'effet de langue) ne transparaît à travers les cases.
            background: Theme.bg;
            Rectangle {
                border-radius: parent.border-radius;
                background: Theme.glass;
                border-width: 1px;
                border-color: Theme.glass-border;
            }
            Text {
                y: 18px * root.k;
                width: parent.width;
                text: root.lang-title;
                font-family: Theme.font-name; // lisible pendant l'effet de langue
                color: Theme.fg;
                font-size: 18px * root.k;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Rectangle {
                y: 64px * root.k;
                height: parent.shown * parent.row-h;
                clip: true;
                TouchArea {
                    scroll-event(e) => {
                        if (e.delta-y == 0 || lang-box.max-off <= 0) {
                            return EventResult.reject;
                        }
                        lang-box.free-off = max(0px, min(lang-box.max-off, lang-box.off - e.delta-y));
                        lang-box.free = true;
                        return EventResult.accept;
                    }
                }
                // Cases des langues : elles arrivent en cascade (glissent et apparaissent l'une après l'autre).
                for l[i] in root.langs: Rectangle {
                    // Horloge propre à la case (départ à sa création) : rien n'est montré avant son tour.
                    property <duration> t0;
                    property <bool> live: true;
                    init => {
                        self.t0 = animation-tick();
                    }
                    Timer {
                        interval: 1000ms;
                        running: parent.live;
                        triggered => {
                            parent.live = false;
                        }
                    }
                    property <float> x0: self.live && Motion.language ? clamp((animation-tick() - self.t0 - 120ms - min(i, 10) * 45ms) / 360ms, 0, 1) : 1;
                    property <float> e: 1 - (1 - self.x0) * (1 - self.x0) * (1 - self.x0);
                    x: 16px * root.k + (1 - self.e) * 36px * root.k;
                    y: i * lang-box.row-h - lang-box.off;
                    animate y { duration: Motion.language && !Nav.drag ? 160ms : 0ms; easing: ease-out; }
                    width: parent.width - 32px * root.k;
                    height: 48px * root.k;
                    border-radius: 12px * root.k;
                    background: Theme.fg.with-alpha(0.07 * self.e);
                }
                // Surbrillance : elle glisse jusqu'à la langue choisie (petit rebond), comme dans les menus.
                Rectangle {
                    x: 16px * root.k;
                    y: root.lang-sel * lang-box.row-h - lang-box.off;
                    animate y { duration: Motion.language ? 240ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    width: parent.width - 32px * root.k;
                    height: 48px * root.k;
                    border-radius: 12px * root.k;
                    background: @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%);
                    Gloss { r: parent.border-radius; strength: 0.8; }
                }
                for l[i] in root.langs: Rectangle {
                    // Horloge propre à la case (départ à sa création) : rien n'est montré avant son tour.
                    property <duration> t0;
                    property <bool> live: true;
                    init => {
                        self.t0 = animation-tick();
                    }
                    Timer {
                        interval: 1000ms;
                        running: parent.live;
                        triggered => {
                            parent.live = false;
                        }
                    }
                    property <float> x0: self.live && Motion.language ? clamp((animation-tick() - self.t0 - 120ms - min(i, 10) * 45ms) / 360ms, 0, 1) : 1;
                    property <float> e: 1 - (1 - self.x0) * (1 - self.x0) * (1 - self.x0);
                    property <bool> on: i == root.lang-sel;
                    x: 16px * root.k + (1 - self.e) * 36px * root.k;
                    y: i * lang-box.row-h - lang-box.off;
                    animate y { duration: Motion.language && !Nav.drag ? 160ms : 0ms; easing: ease-out; }
                    width: parent.width - 32px * root.k;
                    height: 48px * root.k;
                    Text {
                        text: l.label;
                        font-family: Theme.font-name; // lisible pendant l'effet de langue
                        color: (parent.on ? Theme.on-accent : Theme.fg).with-alpha(parent.e);
                        animate color { duration: Motion.language ? 160ms : 0ms; }
                        font-size: (parent.on ? 18px : 17px) * root.k;
                        font-weight: parent.on ? 700 : 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    la := TouchArea {
                        // La souris choisit la langue qu'elle survole.
                        changed has-hover => {
                            if (self.has-hover && !Nav.kb && !Nav.touch) {
                                root.lang-sel = i;
                            }
                        }
                        clicked => {
                            root.lang-chosen(l.id);
                        }
                    }
                }
            }
        }
    }

    // Clavier : choix de la langue, ou Entrée pour continuer après un échec.
    FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if (root.lang-open) {
                if (event.text == Key.UpArrow) {
                    root.lang-sel = max(0, root.lang-sel - 1);
                } else if (event.text == Key.DownArrow) {
                    root.lang-sel = min(root.langs.length - 1, root.lang-sel + 1);
                } else if (event.text == Key.Return && !event.repeat) {
                    root.lang-chosen(root.langs[root.lang-sel].id);
                }
                return EventResult.accept;
            }
            if (root.fail != "" && (event.text == Key.Return || event.text == " ") && !event.repeat) {
                root.continue-boot();
                return EventResult.accept;
            }
            // Toute autre touche (pas une touche de modification seule) : l'animation est passée.
            if (!event.repeat && event.text != Key.Shift && event.text != Key.ShiftR && event.text != Key.Control
                && event.text != Key.ControlR && event.text != Key.Alt && event.text != Key.AltGr && event.text != Key.Meta
                && event.text != Key.MetaR && event.text != Key.Tab) {
                root.skip-now();
            }
            return EventResult.accept;
        }
    }
    // Un appui n'importe où (téléphone, souris) passe aussi l'animation ; pas pendant une question.
    function skip-now() {
        if (root.lang-open) {
            return;
        }
        if (root.phase >= 2) {
            root.finished();
        } else {
            root.skip();
        }
    }
}
