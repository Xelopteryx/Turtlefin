// Démarrage : le logo de Turtlefin sert d'écran de vérification.
//
// Sept points : les six sommets de l'hexagone (langue, affichage, lecteur vidéo, stockage,
// configuration, réseau) et le centre (serveur). Chacun est une vraie vérification (boot.rs) : gris en
// attente, vert si tout va bien, rouge sinon (avec l'explication et « Continuer »). Quand tout est
// vert, les sommets se relient (contour), les rayons partent vers le centre, le point central devient
// l'hexagone plein : c'est exactement le logo (packaging/turtlefin.svg). Puis on zoome dans le centre
// vers la page suivante. Le déroulement est piloté par Rust (boot.rs) ; `--no-intro` le saute.

import { Theme, Tr, Gloss } from "theme.slint";
import { AeroSky } from "sky.slint";
import { TrackData } from "player.slint";
import { DustLine, DustLines } from "dust.slint";

export component BootLogo inherits Rectangle {
    in property <float> k: 1.0;
    in property <[int]> state;            // 7 points · 0 attente · 1 en cours · 2 ok · 3 échec · 4 à configurer (orange)
    in property <[string]> labels;
    in property <string> text;            // vérification en cours
    in property <string> fail;            // échec : explication
    in property <string> fail-hint;       // « Entrée pour continuer »
    in property <int> phase;              // 0 vérifications · 1 liaison · 2 zoom
    in property <bool> lang-open;
    // Effet de langue (dust.rs) : image sous la liste ; snap : captures en cours, liste masquée.
    in property <bool> snap;
    in property <bool> dust-on;
    in property <[DustLine]> dust-lines;
    in property <int> dust-phase;
    in property <duration> dust-t0;
    // Fragmenter les textes derrière (choix de la langue) ; pas pour la question de la visite guidée.
    in property <string> lang-title;
    in property <[TrackData]> langs;
    in-out property <int> lang-sel;
    callback continue-boot();
    callback lang-chosen(string);
    callback linked();                     // fin de la liaison : Rust ouvre la page suivante
    callback finished();                   // fin du zoom

    background: @linear-gradient(180deg, Theme.bg 0%, Theme.bg-mid 55%, Theme.bg-end 100%);
    if Theme.bubbles: AeroSky { k: root.k; }

    // Style « Aero » (Theme.boot-style 1) : les points sont des billes de verre lumineuses ; à la
    // liaison, elles tourbillonnent jusqu'au centre, un éclair blanc jaillit et le logo apparaît.
    property <bool> aero: Theme.boot-style == 1;

    // Géométrie commune avec l'icône (packaging/turtlefin.svg, packaging/icons/make-icons.py) :
    // repère 256, centre (128, 128) ; hexagone de rayon 68 (trait 14), hexagone central plein de
    // rayon 30, rayons (trait 8), bouts arrondis ; dégradé à 135° sur le carré [53, 203].
    property <[float]> px: [128, 187, 187, 128, 69, 69];
    property <[float]> py: [60, 94, 162, 196, 162, 94];
    property <[float]> ix: [128, 154, 154, 128, 102, 102];
    property <[float]> iy: [98, 113, 143, 158, 143, 113];
    property <length> side: min(self.width, self.height) * 0.46;
    property <length> u: self.side / 256;
    // Orbe (Theme.logo-style 1) : carapace blanc nacré vers l'accent clair, posée sur une sphère de verre.
    property <bool> orb: root.aero && Theme.logo-style == 1;
    property <brush> grad: root.orb
        ? @linear-gradient(135deg, rgba(255, 255, 255, root.reveal) 0%, Theme.accent2.with-alpha(root.reveal) 110%)
        : @linear-gradient(135deg, Theme.accent1.with-alpha(root.reveal) 0%, Theme.accent2.with-alpha(root.reveal) 100%);

    // Horloges des phases (au temps : rien n'est redessiné en dehors).
    property <duration> t-link;
    property <duration> t-zoom;
    property <int> ph: root.phase;
    changed ph => {
        if (root.phase == 1) {
            root.t-link = animation-tick();
            link-timer.running = true;
        } else if (root.phase == 2) {
            root.t-zoom = animation-tick();
            zoom-timer.running = true;
        }
    }
    property <float> lp: root.phase == 0 ? 0 : root.phase == 1 ? clamp((animation-tick() - root.t-link) / (root.aero ? 2400ms : 900ms), 0, 1) : 1;
    // Aero : tourbillon (0 -> 1), éclair (monte puis retombe), apparition du logo.
    // Aero, sur 2,4 s : tourbillon (0 -> 0,35), éclair (0,28 -> 0,53), l'orbe surgit en zoomant avec un
    // rebond (0,36 -> 0,6), puis le logo se redessine sur elle : contour (0,5 -> 0,74), rayons et centre
    // (0,72 -> 0,9).
    property <float> swirl: root.ease-io(clamp(root.lp / 0.35, 0, 1));
    property <float> flash: 0.55 * sin(clamp((root.lp - 0.27) / 0.16, 0, 1) * 180deg);
    property <float> reveal: root.aero ? clamp((root.lp - 0.45) / 0.08, 0, 1) : 1;
    // La bille du serveur (au centre) devient la grande orbe : elle grossit (avec un rebond) en passant
    // de sa couleur (vert) à celle du thème. orb-s : rayon en part du rayon final (100), depuis celui de la bille (0,11).
    property <float> orb-t: clamp((root.lp - 0.35) / 0.27, 0, 1);
    property <float> orb-s: 0.11 + 0.89 * root.ease(root.orb-t) + 0.12 * sin(root.orb-t * 180deg);
    property <float> orb-c: root.ease(clamp((root.orb-t - 0.15) / 0.75, 0, 1));
    property <color> srv: root.orb-color(root.state[6]);
    property <float> zp: root.phase < 2 ? 0 : clamp((animation-tick() - root.t-zoom) / 750ms, 0, 1);
    // Liaison : contour (première moitié), puis rayons et hexagone central (seconde moitié).
    property <float> edge-p: root.aero ? root.ease(clamp((root.lp - 0.5) / 0.24, 0, 1)) : root.ease(clamp(root.lp * 2, 0, 1));
    property <float> spoke-p: root.aero ? root.ease(clamp((root.lp - 0.72) / 0.18, 0, 1)) : root.ease(clamp(root.lp * 2 - 1, 0, 1));
    link-timer := Timer {
        interval: root.aero ? 2550ms : 1100ms;
        running: false;
        triggered => {
            self.running = false;
            root.linked();
        }
    }
    zoom-timer := Timer {
        interval: 780ms;
        running: false;
        triggered => {
            self.running = false;
            root.finished();
        }
    }
    // Point « en cours » : pulsation.
    property <float> pulse: 0.5 + 0.5 * sin(mod(animation-tick() / 1ms, 900) / 900 * 360deg);

    pure function ease(t: float) -> float {
        return 1 - (1 - t) * (1 - t) * (1 - t);
    }
    pure function ease-io(t: float) -> float {
        return t < 0.5 ? 4 * t * t * t : 1 - (2 - 2 * t) * (2 - 2 * t) * (2 - 2 * t) / 2;
    }
    // Couleur d'une bille (Aero) : vert, orange, rouge, bleu d'attente, gris.
    pure function orb-color(s: int) -> color {
        return s == 2 ? #3fd46a : s == 4 ? #ffb02e : s == 3 ? #ff4d4d : s == 1 ? Theme.accent2 : #9fb8d8;
    }
    // Couleur du dégradé du logo à un endroit du repère (pour que les points s'y fondent).
    pure function logo-color(x: float, y: float) -> color {
        return Theme.accent1.mix(Theme.accent2, 1 - clamp((x - 53 + y - 53) / 300, 0, 1));
    }
    pure function dot-color(s: int, x: float, y: float) -> brush {
        return root.phase >= 1 ? root.logo-color(x, y)
            : s == 2 ? #22c55e
            // À configurer (aucun serveur choisi au premier lancement) : orange, pas vert.
            : s == 4 ? #f59e0b
            : s == 3 ? #ef4444
            : s == 1 ? Theme.accent2.transparentize(0.6 - 0.5 * root.pulse)
            : Theme.fg.with-alpha(0.18);
    }
    pure function dot-size(s: int) -> float {
        return s == 1 || s == 3 ? 26 : s == 0 ? 18 : 22;
    }

    // Fond : s'efface pendant le zoom (la page suivante est déjà dessous).
    opacity: 1 - root.zp * root.zp;

    logo := Rectangle {
        x: (parent.width - root.side) / 2;
        y: (parent.height - root.side) / 2 - 30px * root.k;
        width: root.side;
        height: root.side;
        // Zoom dans le point central.
        transform-scale: 1 + root.zp * root.zp * 26;

        // Orbe de verre derrière le logo : sphère d'accent sombre au bord, lueur en bas.
        if root.orb && root.orb-t > 0: Rectangle {
            x: (128 - 100 * root.orb-s) * root.u;
            y: (128 - 100 * root.orb-s) * root.u;
            width: 200 * root.orb-s * root.u;
            height: self.width;
            border-radius: self.width / 2;
            background: @radial-gradient(circle, root.srv.brighter(0.5).mix(Theme.accent1, 1 - root.orb-c) 0%,
                root.srv.mix(Theme.accent1.mix(Theme.bg, 0.55), 1 - root.orb-c) 70%, root.srv.darker(0.35).mix(Theme.bg, 1 - root.orb-c) 100%);
            border-width: 2px;
            border-color: Theme.accent2.with-alpha(0.45 * root.orb-c);
            drop-shadow-blur: 30 * root.u;
            drop-shadow-color: root.srv.mix(Theme.accent2, 1 - root.orb-c).with-alpha(0.6);
            Rectangle {
                x: parent.width * 0.15;
                y: parent.height * 0.42;
                width: parent.width * 0.7;
                height: parent.height * 0.6;
                border-radius: self.width / 2;
                background: @radial-gradient(circle, Theme.accent2.with-alpha(0.65) 0%, Theme.accent2.with-alpha(0) 70%);
            }
        }
        // Aero : halo du logo qui s'allume, et éclair blanc au moment où les billes se rejoignent.
        if root.aero && root.lp > 0.4: Rectangle {
            property <float> w: 120 + 150 * root.reveal;
            x: (128 - self.w / 2) * root.u;
            y: (128 - self.w / 2) * root.u;
            width: self.w * root.u;
            height: self.width;
            border-radius: self.width / 2;
            background: @radial-gradient(circle, Theme.accent2.with-alpha(0.55 * root.reveal) 0%, Theme.accent2.with-alpha(0.18 * root.reveal) 40%, Theme.accent2.with-alpha(0) 70%);
        }
        if root.aero && root.flash > 0.01: Rectangle {
            property <float> w: 30 + 330 * root.flash;
            x: (128 - self.w / 2) * root.u;
            y: (128 - self.w / 2) * root.u;
            width: self.w * root.u;
            height: self.width;
            border-radius: self.width / 2;
            background: @radial-gradient(circle, rgba(255, 255, 255, 0.95 * root.flash) 0%, rgba(200, 240, 255, 0.5 * root.flash) 25%, rgba(200, 240, 255, 0) 70%);
        }

        // Contour : chaque arête part de son sommet vers le suivant, toutes en même temps.
        for i in 6: Path {
            visible: root.edge-p > 0;
            // Slint réduit le dessin d'un chemin de l'épaisseur de son trait : on agrandit d'autant.
            x: (53 - 7) * root.u;
            y: (53 - 7) * root.u;
            width: (150 + 14) * root.u;
            height: (150 + 14) * root.u;
            viewbox-x: 53;
            viewbox-y: 53;
            viewbox-width: 150;
            viewbox-height: 150;
            fill: transparent;
            stroke: root.grad;
            stroke-width: 14 * root.u;
            stroke-line-cap: round;
            commands: "M " + root.px[i] + " " + root.py[i] + " L "
                + (root.px[i] + (root.px[mod(i + 1, 6)] - root.px[i]) * root.edge-p) + " "
                + (root.py[i] + (root.py[mod(i + 1, 6)] - root.py[i]) * root.edge-p);
        }
        // Rayons, des sommets vers l'hexagone central.
        for i in 6: Path {
            visible: root.spoke-p > 0;
            x: (53 - 4) * root.u;
            y: (53 - 4) * root.u;
            width: (150 + 8) * root.u;
            height: (150 + 8) * root.u;
            viewbox-x: 53;
            viewbox-y: 53;
            viewbox-width: 150;
            viewbox-height: 150;
            fill: transparent;
            stroke: root.grad;
            stroke-width: 8 * root.u;
            stroke-line-cap: round;
            commands: "M " + root.px[i] + " " + root.py[i] + " L "
                + (root.px[i] + (root.ix[i] - root.px[i]) * root.spoke-p) + " "
                + (root.py[i] + (root.iy[i] - root.py[i]) * root.spoke-p);
        }
        // Hexagone central : le point du serveur grandit jusqu'à lui.
        Path {
            property <float> g: 0.25 + 0.75 * root.spoke-p;
            visible: root.spoke-p > 0;
            x: 53 * root.u;
            y: 53 * root.u;
            width: 150 * root.u;
            height: 150 * root.u;
            viewbox-x: 53;
            viewbox-y: 53;
            viewbox-width: 150;
            viewbox-height: 150;
            fill: root.grad;
            commands: "M " + (128 + (root.ix[0] - 128) * self.g) + " " + (128 + (root.iy[0] - 128) * self.g)
                + " L " + (128 + (root.ix[1] - 128) * self.g) + " " + (128 + (root.iy[1] - 128) * self.g)
                + " L " + (128 + (root.ix[2] - 128) * self.g) + " " + (128 + (root.iy[2] - 128) * self.g)
                + " L " + (128 + (root.ix[3] - 128) * self.g) + " " + (128 + (root.iy[3] - 128) * self.g)
                + " L " + (128 + (root.ix[4] - 128) * self.g) + " " + (128 + (root.iy[4] - 128) * self.g)
                + " L " + (128 + (root.ix[5] - 128) * self.g) + " " + (128 + (root.iy[5] - 128) * self.g) + " Z";
        }

        // Les six sommets. Pendant la liaison, chaque point prend la couleur du logo et la taille du
        // trait : il devient l'angle arrondi du contour.
        for i in 6: Rectangle {
            property <int> s: root.state[i];
            property <float> base: root.dot-size(self.s) * (root.aero ? 1.25 : 1);
            animate base { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            // Aero : la bille tourne autour du centre en s'en rapprochant (rayon 68 -> 0).
            property <angle> ang: (-90 + 60 * i) * 1deg + root.swirl * 420deg;
            property <float> rad: 68 * (1 - root.swirl);
            property <float> cx: root.aero ? 128 + self.rad * cos(self.ang) : root.px[i];
            property <float> cy: root.aero ? 128 + self.rad * sin(self.ang) : root.py[i];
            property <length> d: (root.aero ? self.base * (1 - 0.35 * root.swirl) : self.base + (14 - self.base) * root.edge-p) * root.u;
            x: self.cx * root.u - self.d / 2;
            y: self.cy * root.u - self.d / 2;
            width: self.d;
            height: self.d;
            border-radius: self.d / 2;
            visible: !root.aero || root.orb-t == 0;
            background: root.aero
                ? @radial-gradient(circle, root.orb-color(self.s).brighter(0.5) 0%, root.orb-color(self.s) 55%, root.orb-color(self.s).darker(0.35) 100%)
                : root.dot-color(self.s, root.px[i], root.py[i]);
            animate background { duration: 300ms; }
            drop-shadow-blur: root.aero ? self.d * 0.9 : 0px;
            drop-shadow-color: root.aero ? root.orb-color(self.s).with-alpha(0.85) : transparent;
            // Reflet de la bille.
            if root.aero: Rectangle {
                x: parent.width * 0.2;
                y: parent.height * 0.1;
                width: parent.width * 0.6;
                height: parent.height * 0.42;
                border-radius: self.height / 2;
                background: @linear-gradient(180deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.05) 100%);
            }
            // Libellé, à l'extérieur de l'hexagone.
            Text {
                property <float> ox: (root.px[i] - 128) * 0.55;
                property <float> oy: (root.py[i] - 128) * 0.42;
                x: self.ox * root.u + (parent.width - self.width) / 2;
                y: self.oy * root.u + (parent.height - self.height) / 2;
                width: 160px * root.k;
                text: root.labels[i];
                // Fondu par la couleur : une transparence d'ensemble (opacity) dessine l'élément à part,
                // dans une texture créée au premier fondu ; huit d'un coup figeaient la liaison.
                color: (parent.s == 3 ? Theme.danger-text : parent.s == 0 ? Theme.fg.with-alpha(0.35) : Theme.fg.with-alpha(0.8)).transparentize(root.aero ? min(1, root.swirl * 3) : root.edge-p);
                font-size: 13px * root.k;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
        // Le centre (7e point) : le serveur, vérifié en dernier.
        Rectangle {
            property <int> s: root.state[6];
            property <float> base: root.dot-size(self.s);
            animate base { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            property <length> d: self.base * root.u;
            x: 128 * root.u - self.d / 2;
            y: 128 * root.u - self.d / 2;
            width: self.d;
            height: self.d;
            border-radius: self.d / 2;
            // Fondu par la couleur (voir les libellés).
            background: root.aero
                ? (root.orb-t > 0 ? transparent : @radial-gradient(circle, root.orb-color(self.s).brighter(0.5) 0%, root.orb-color(self.s) 55%, root.orb-color(self.s).darker(0.35) 100%))
                : root.spoke-p > 0 ? root.logo-color(128, 128).transparentize(root.spoke-p) : root.dot-color(self.s, 128, 128);
            // Aero : l'orbe prend sa place d'un coup (même taille, même couleur), sans fondu.
            animate background { duration: root.aero ? 0ms : 300ms; }
            drop-shadow-blur: root.aero && root.orb-t == 0 ? self.d * 0.9 : 0px;
            drop-shadow-color: root.orb-color(self.s).with-alpha(0.85);
            if root.aero && root.orb-t == 0: Rectangle {
                x: parent.width * 0.2;
                y: parent.height * 0.1;
                width: parent.width * 0.6;
                height: parent.height * 0.42;
                border-radius: self.height / 2;
                background: @linear-gradient(180deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.05) 100%);
            }
            Text {
                x: (parent.width - self.width) / 2;
                y: parent.height + 6px * root.k;
                width: 160px * root.k;
                text: root.labels[6];
                // Fondu par la couleur : une transparence d'ensemble (opacity) dessine l'élément à part,
                // dans une texture créée au premier fondu ; huit d'un coup figeaient la liaison.
                color: (parent.s == 3 ? Theme.danger-text : parent.s == 0 ? Theme.fg.with-alpha(0.35) : Theme.fg.with-alpha(0.8)).transparentize(root.aero ? min(1, root.swirl * 3) : root.edge-p);
                font-size: 13px * root.k;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
        // Grand reflet blanc de l'orbe, par-dessus la carapace.
        if root.orb && root.orb-t > 0: Rectangle {
            x: (128 - 100 * root.orb-s + 200 * root.orb-s * 0.13) * root.u;
            y: (128 - 100 * root.orb-s + 200 * root.orb-s * 0.04) * root.u;
            width: 200 * 0.74 * root.orb-s * root.u;
            height: 200 * 0.44 * root.orb-s * root.u;
            border-radius: self.height / 2;
            background: @linear-gradient(180deg, rgba(255, 255, 255, 0.62) 0%, rgba(255, 255, 255, 0.06) 100%);
        }
    }

    // Vérification en cours, ou échec avec son explication.
    VerticalLayout {
        y: logo.y + root.side + 24px * root.k;
        width: parent.width;
        spacing: 10px * root.k;
        // Pas de transparence d'ensemble (voir les libellés) : le texte s'efface par sa couleur, et
        // le bouton d'un échec n'est pas affiché pendant la liaison.
        alignment: start;
        Text {
            text: root.fail != "" ? root.fail : root.text;
            color: (root.fail != "" ? Theme.danger-text : Theme.muted).transparentize(root.aero ? min(1, root.swirl * 3) : root.edge-p);
            font-size: 16px * root.k;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.fail != "": HorizontalLayout {
            alignment: center;
            Rectangle {
                width: hint.preferred-width + 40px * root.k;
                height: 40px * root.k;
                border-radius: 10px * root.k;
                background: @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%);
                Gloss { r: parent.border-radius; strength: 0.8; }
                hint := Text {
                    text: root.fail-hint;
                    color: Theme.on-accent;
                    font-size: 15px * root.k;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => {
                        root.continue-boot();
                    }
                }
            }
        }
    }

    // Choix de la langue (premier lancement).
    // Apparition : fondu du voile, la boîte monte et grandit ; fermeture : l'inverse. Langue
    // choisie : les textes changent « en poussière » (dust.rs).
    property <float> lang-p: root.lang-open ? 1 : 0;
    animate lang-p { duration: 320ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    if root.dust-on: DustLines {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        lines: root.dust-lines;
        phase: root.dust-phase;
        t0: root.dust-t0;
        k: root.k;
    }
    if root.lang-p > 0.01 && !root.snap: Rectangle {
        background: Theme.scrim.with-alpha(0.65).transparentize(1 - root.lang-p);
        TouchArea {
            // La molette ne fait pas défiler la page dessous.
            scroll-event(e) => {
                return EventResult.accept;
            }
        }
        lang-box := Rectangle {
            // Liste qui défile au-delà de ce qui tient à l'écran (langues ajoutées).
            property <length> row-h: 56px * root.k;
            property <int> fit: max(3, floor((parent.height - 160px * root.k) / self.row-h));
            property <int> shown: min(root.langs.length, self.fit);
            property <int> first: max(0, min(root.langs.length - self.shown, root.lang-sel - self.shown + 2));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (1 - root.lang-p) * 40px * root.k;
            opacity: root.lang-p;
            transform-scale: 0.92 + 0.08 * root.lang-p;
            width: 420px * root.k;
            height: 80px * root.k + self.shown * self.row-h;
            border-radius: 18px * root.k;
            background: Theme.glass;
            border-width: 1px;
            border-color: Theme.glass-border;
            Text {
                y: 18px * root.k;
                width: parent.width;
                text: root.lang-title;
                font-family: "Montserrat"; // lisible pendant l'effet de langue
                color: Theme.fg;
                font-size: 18px * root.k;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Rectangle {
                y: 64px * root.k;
                height: parent.shown * parent.row-h;
                clip: true;
                for l[i] in root.langs: Rectangle {
                    x: 16px * root.k;
                    y: (i - lang-box.first) * lang-box.row-h;
                    animate y { duration: 160ms; easing: ease-out; }
                    width: parent.width - 32px * root.k;
                    height: 48px * root.k;
                    border-radius: 12px * root.k;
                    background: i == root.lang-sel || la.has-hover ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : Theme.fg.with-alpha(0.07);
                    Gloss { r: parent.border-radius; strength: 0.8; }
                    Text {
                        text: l.label;
                        font-family: "Montserrat"; // lisible pendant l'effet de langue
                        color: i == root.lang-sel || la.has-hover ? Theme.on-accent : Theme.fg;
                        font-size: 17px * root.k;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    la := TouchArea {
                        clicked => {
                            root.lang-chosen(l.id);
                        }
                    }
                }
            }
        }
    }

    // Clavier : choix de la langue, ou Entrée pour continuer après un échec.
    FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if (root.lang-open) {
                if (event.text == Key.UpArrow) {
                    root.lang-sel = max(0, root.lang-sel - 1);
                } else if (event.text == Key.DownArrow) {
                    root.lang-sel = min(root.langs.length - 1, root.lang-sel + 1);
                } else if (event.text == Key.Return && !event.repeat) {
                    root.lang-chosen(root.langs[root.lang-sel].id);
                }
                return EventResult.accept;
            }
            if (root.fail != "" && (event.text == Key.Return || event.text == " ") && !event.repeat) {
                root.continue-boot();
            }
            return EventResult.accept;
        }
    }
}
