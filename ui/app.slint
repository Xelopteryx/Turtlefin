        stroke-line-join: round;
        commands: "M 8 2 L 16 2 Q 18 2 18 4 L 18 20 Q 18 22 16 22 L 8 22 Q 6 22 6 20 L 6 4 Q 6 2 8 2 Z M 12 6 L 12 12 M 9 9 L 15 9 M 12 17 L 12 17.2";
    }
    if root.name == "party": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 8 4 A 3.5 3.5 0 1 1 7.99 4 Z M 1 19 C 1 14.5 4 12.5 8 12.5 C 12 12.5 15 14.5 15 19 Z M 17 5.5 A 3 3 0 1 1 16.99 5.5 Z M 16.2 12.6 C 20 12.4 23 14.2 23 18 L 16.6 18 C 16.6 15.8 16.5 14 16.2 12.6 Z";
    }
    if root.name == "library": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.height / 11;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M 4 4 L 8 4 L 8 20 L 4 20 Z M 10 4 L 14 4 L 14 20 L 10 20 Z M 16 5.2 L 19.6 4.2 L 22 19.4 L 18.4 20.4 Z";
    }
    if root.name == "profile": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 12 3 A 4.5 4.5 0 1 1 11.99 3 Z M 3.5 21.5 C 3.5 16.5 7.5 14 12 14 C 16.5 14 20.5 16.5 20.5 21.5 Z";
    }
    if root.name == "server": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.height / 11;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M 4 4 L 20 4 L 20 10 L 4 10 Z M 4 14 L 20 14 L 20 20 L 4 20 Z M 7.5 7 L 9 7 M 7.5 17 L 9 17";
    }
    if root.name == "logout": Path {
        width: parent.width;
