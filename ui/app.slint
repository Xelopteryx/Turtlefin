import { LineEdit, Button } from "std-widgets.slint";
// Montserrat, la police de JellySkin (licence OFL : ui/fonts/OFL.txt), intégrée au programme.
import "fonts/Montserrat-Regular.ttf";
import "fonts/Montserrat-Medium.ttf";
import "fonts/Montserrat-SemiBold.ttf";
import "fonts/Montserrat-Bold.ttf";
import { PlayerView, TrackData } from "player.slint";
import { Theme } from "theme.slint";
import { CardData } from "card.slint";
import { Osk } from "osk.slint";
import { Marquee } from "marquee.slint";

export { CardData }

export { TrackData }


export struct Section {
    title: string,
    items: [CardData],
    landscape: bool, // rangée de vignettes 16:9 (« Mes médias », « Reprendre »...)
    y-px: float,     // position verticale de la rangée, en pixels logiques (calculée en Rust)
    h-px: float,     // hauteur de la rangée, en pixels logiques
}

export struct ServerData {
    id: string,
    name: string,
    version: string,
    local: string,  // adresse sur le réseau local, vide si inconnue
    remote: string, // adresse distante (Tailscale ou autre), vide si inconnue
}

export struct FactData {
    label: string,
    value: string,
}

export struct SeerrPage {
    loading: bool,
    title: string,
    year: string,
    overview: string,
    genres: string,
    length: string,
    rating: string,
    facts: [FactData],
    status: string,    // « Demande en attente »... vide si rien
    can-request: bool,
    on-server: bool,
    poster: image,
    has-poster: bool,
    backdrop: image,
    has-backdrop: bool,
}

export struct SettingRow {
    key: string,
    label: string,
    value: string,
    kind: string, // "toggle" | "choice" | "action" | "info"
    on: bool,
}

export struct MenuEntry {
    label: string,
    action: string, // "home" | "requests" | "lib:<id>" | "server" | "settings" | "logout" | "quit"
    header: bool,   // intitulé de groupe (non sélectionnable)
}

export struct ButtonData {
    label: string,  // vide pour un bouton à icône
    action: string, // "play" | "fav" | "played" | "download" | "open:<id>"
    icon: string,   // "play" | "heart" | "check" | "download" | ""
    active: bool,   // favori / vu
}

export struct DetailData {
    id: string,
    title: string,
    subtitle: string,
    misc: string,
    overview: string,
    expect-logo: bool,
    has-logo: bool,
    logo: image,
    has-poster: bool,
    poster: image,
    children-title: string,
    children-landscape: bool,
    has-next: bool,       // bloc « À suivre » (séries)
    next-id: string,
    next-title: string,
    next-subtitle: string,
    has-next-image: bool,
    next-image: image,
    buttons: [ButtonData],
    icon-count: int, // boutons à icône (ligne du haut), les autres sont des pastilles
}

// Carte au style JellySkin : encadré translucide, image en haut (coins supérieurs arrondis
// intégrés à l'image au décodage), titre et sous-titre centrés dessous. Sélection : encadré plus
// sombre et carte légèrement agrandie (simple mise à l'échelle, sans image intermédiaire).
component Card inherits Rectangle {
    in property <CardData> data;
    in property <bool> focused;
    in property <float> ratio: 1.5;
    in property <float> k: 1.0;
    callback clicked();

    property <length> img-h: root.width * root.ratio;

    z: root.focused ? 1 : 0;
    transform-scale: root.focused ? 1.06 : 1.0;
    animate transform-scale { duration: 120ms; easing: ease-out; }
    border-radius: Theme.radius;
    background: root.focused ? #00000080 : #00000033;

    Rectangle {
        y: 0px;
        height: root.img-h;
        border-top-left-radius: Theme.radius;
        border-top-right-radius: Theme.radius;
        background: root.data.has-image ? transparent : @linear-gradient(130deg, #2b2142 0%, #10283a 100%);

        if root.data.has-image: Image {
            width: parent.width;
            height: parent.height;
            source: root.data.image;
            image-fit: fill;
        }

        // Avancement de la lecture (comme .itemProgressBar de JellySkin)
        if root.data.progress > 0: Rectangle {
            x: 14px * root.k;
            y: parent.height - 16px * root.k;
            width: parent.width - 28px * root.k - (root.data.rating != "" ? 50px * root.k : 0px);
            height: 5px * root.k;
            border-radius: self.height / 2;
            background: #ffffff4d;

            Rectangle {
                x: 0px;
                width: parent.width * root.data.progress;
                height: parent.height;
                border-radius: parent.height / 2;
                background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
            }
        }

        // Absent du serveur, proposé par Seerr : badge en haut à gauche.
        if root.data.seerr: Rectangle {
            x: 7px * root.k;
            y: 7px * root.k;
            width: 52px * root.k;
            height: 20px * root.k;
            border-radius: 5px * root.k;
            background: @linear-gradient(130deg, #6366f1 0%, #a855f7 100%);
            Text {
                text: "SEERR";
                color: white;
                font-size: 10px * root.k;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Coin en haut à droite, collé à l'angle de l'affiche : épisodes restant à voir (« +99 »
        // au-delà), sinon une coche si tout est vu.
        if root.data.count > 0 || root.data.played: Rectangle {
            x: parent.width - self.width;
            y: 0px;
            width: max(30px * root.k, cnt.preferred-width + 16px * root.k);
            height: 28px * root.k;
            border-top-right-radius: Theme.radius;
            border-bottom-left-radius: 9px * root.k;
            background: @linear-gradient(110deg, Theme.accent1 0%, Theme.accent2 100%);
            cnt := Text {
                text: root.data.count > 99 ? "+99" : root.data.count > 0 ? root.data.count : "";
                color: white;
                font-size: 14px * root.k;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.data.count == 0: Path {
                width: 14px * root.k;
                height: 14px * root.k;
                viewbox-width: 14;
                viewbox-height: 14;
                fill: transparent;
                stroke: white;
                stroke-width: 2.5px * root.k;
                commands: "M 2 7.5 L 5.5 11 L 12 3";
            }
        }

        // État d'une demande Seerr
        if root.data.status > 0: Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 8px * root.k;
            width: st-row.preferred-width + 18px * root.k;
            height: 24px * root.k;
            border-radius: self.height / 2;
            background: root.data.status == 1 ? #d97706 : root.data.status == 2 ? #15803d
                : root.data.status == 3 ? #dc2626 : root.data.status == 4 ? #4ade80 : #7f1d1d;
            st-row := HorizontalLayout {
                alignment: center;
                spacing: 5px * root.k;
                padding-left: 9px * root.k;
                padding-right: 9px * root.k;
                Path {
                    width: 12px * root.k;
                    height: 12px * root.k;
                    y: (24px * root.k - self.height) / 2;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    fill: transparent;
                    stroke: root.data.status == 4 ? #052e16 : white;
                    stroke-width: 2px * root.k;
                    // en attente : sablier · acceptée / disponible : coche · refusée / échec : croix
                    commands: root.data.status == 1 ? "M 2 1 L 10 1 L 2 11 L 10 11 Z"
                        : root.data.status == 2 || root.data.status == 4 ? "M 1.5 6.5 L 4.5 9.5 L 10.5 2.5"
                        : "M 2 2 L 10 10 M 10 2 L 2 10";
                }
                Text {
                    text: root.data.status == 1 ? "En attente" : root.data.status == 2 ? "Acceptée"
                        : root.data.status == 3 ? "Refusée" : root.data.status == 4 ? "Disponible" : "Échec";
                    color: root.data.status == 4 ? #052e16 : white;
                    font-size: 11px * root.k;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }

        // Note de la communauté
        if root.data.rating != "": Rectangle {
            x: parent.width - self.width - 8px * root.k;
            y: parent.height - self.height - 7px * root.k;
            width: 44px * root.k;
            height: 18px * root.k;
            border-radius: 4px * root.k;
            background: #000000b3;

            HorizontalLayout {
                alignment: center;
                spacing: 3px * root.k;

                Text {
                    text: "★";
                    color: #f5c518;
                    font-size: 11px * root.k;
                    vertical-alignment: center;
                }
                Text {
                    text: root.data.rating;
                    color: white;
                    font-size: 11px * root.k;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Titre et sous-titre : défilent sur la carte sélectionnée s'ils sont trop longs.
    Marquee {
        x: 8px * root.k;
        // Sans sous-titre (bibliothèques), le titre est centré dans l'encadré.
        y: root.img-h + (root.data.subtitle == "" ? (parent.height - root.img-h - self.height) / 2 : 8px * root.k);
        width: parent.width - 16px * root.k;
        height: 22px * root.k;
        text: root.data.title;
        active: root.focused;
        text-color: Theme.text;
        font-size: 15px * root.k;
        font-weight: 500;
    }

    Marquee {
        x: 8px * root.k;
        y: root.img-h + 30px * root.k;
        width: parent.width - 16px * root.k;
        height: 18px * root.k;
        text: root.data.subtitle;
        active: root.focused;
        text-color: Theme.muted;
        font-size: 12px * root.k;
        font-weight: 400;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Rangée titrée de cartes, défilant horizontalement.
// Hauteur attendue : 132 px x k + hauteur d'image (titre 48, marges 10 + 18, texte 56).
component SectionRow inherits Rectangle {
    in property <string> title;
    in property <[CardData]> items;
    in property <length> card-w;
    in property <float> ratio: 1.5;
    in property <bool> active;
    in property <int> focus-index;
    in property <float> k: 1.0;
    callback activated(int);

    property <length> gap: 18px * root.k;
    property <length> pad: 32px * root.k;
    property <length> title-h: 48px * root.k;
    property <length> text-h: 56px * root.k;
    // Chaque rangée garde son propre défilement quand elle n'est pas active.
    property <int> remembered: 0;
    property <int> idx: root.active ? root.focus-index : root.remembered;
    property <length> strip-w: root.items.length * (root.card-w + root.gap) + root.pad * 2;
    property <length> target-x: min(0px, max(root.width - root.strip-w,
        root.width / 2 - (root.pad + root.idx * (root.card-w + root.gap) + root.card-w / 2)));

    changed focus-index => {
        if (root.active) {
            root.remembered = root.focus-index;
        }
    }

    // Titre précédé d'un trait (comme .sectionTitle:before de JellySkin)
    Rectangle {
        x: root.pad;
        y: root.title-h / 2 - 1px;
        width: 22px * root.k;
        height: 2px;
        background: white;
    }

    Text {
        x: root.pad + 32px * root.k;
        y: 0px;
        height: root.title-h;
        text: root.title;
        color: white;
        font-size: 22px * root.k;
        font-weight: 500;
        vertical-alignment: center;
    }

    Rectangle {
        y: root.title-h;
        height: root.height - root.title-h;
        clip: true;

        Rectangle {
            x: root.target-x;
            width: root.strip-w;
            animate x { duration: 160ms; easing: ease-out; }

            for card[i] in root.items: Card {
                x: root.pad + i * (root.card-w + root.gap);
                y: 10px * root.k;
                width: root.card-w;
                height: root.card-w * root.ratio + root.text-h;
                data: card;
                ratio: root.ratio;
                k: root.k;
                focused: root.active && i == root.focus-index;
                clicked => {
                    root.activated(i);
                }
            }
        }
    }
}

// Onglet de l'en-tête : blanc et gras quand il est actif, souligné en dégradé quand il est sélectionné.
component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> focused;
    in property <float> k: 1.0;
    callback clicked();

    preferred-width: label.preferred-width + 8px * root.k;

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: (root.active || root.focused || area.has-hover) ? white : #ffffffa6;
        font-size: 18px * root.k;
        font-weight: root.active ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.focused: Rectangle {
        y: parent.height / 2 + 16px * root.k;
        height: 3px * root.k;
        border-radius: self.height / 2;
        background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
    }

    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Icône ronde de l'en-tête (recherche, profil).
component HeaderIcon inherits Rectangle {
    in property <string> icon;
    in property <bool> focused;
    in property <bool> on; // état actif (watch party en cours) : anneau d'accent
    in property <float> k: 1.0;
    callback clicked();

    width: 44px * root.k;
    height: 44px * root.k;
    border-radius: self.height / 2;
    background: (root.focused || area.has-hover) ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : transparent;
    border-width: root.on && !root.focused ? 2px * root.k : 0px;
    border-color: Theme.accent2;

    if root.icon == "search": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: white;
        stroke-width: 2.4px * root.k;
        commands: "M 10.5 3.5 A 7 7 0 1 1 10.49 3.5 Z M 15.6 15.6 L 21 21";
    }

    if root.icon == "menu": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: white;
        stroke-width: 2.4px * root.k;
        commands: "M 4 6.5 L 20 6.5 M 4 12 L 20 12 M 4 17.5 L 20 17.5";
    }

    if root.icon == "back": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: white;
        commands: "M 13.5 4 L 15.5 6 L 9.5 12 L 15.5 18 L 13.5 20 L 5.5 12 Z";
    }

    if root.icon == "home": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: white;
        commands: "M 12 3 L 21.5 11.5 L 19 11.5 L 19 20.5 L 14.5 20.5 L 14.5 15 L 9.5 15 L 9.5 20.5 L 5 20.5 L 5 11.5 L 2.5 11.5 Z";
    }

    if root.icon == "party": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: white;
        commands: "M 8 4 A 3.5 3.5 0 1 1 7.99 4 Z M 1 19 C 1 14.5 4 12.5 8 12.5 C 12 12.5 15 14.5 15 19 Z M 17 5.5 A 3 3 0 1 1 16.99 5.5 Z M 16.2 12.6 C 20 12.4 23 14.2 23 18 L 16.6 18 C 16.6 15.8 16.5 14 16.2 12.6 Z";
    }

    if root.icon == "dice": Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px * root.k;
        height: 22px * root.k;
        border-radius: 5px * root.k;
        border-width: 2.2px * root.k;
        border-color: white;
        for p in [[0.28, 0.28], [0.72, 0.28], [0.5, 0.5], [0.28, 0.72], [0.72, 0.72]]: Rectangle {
            x: parent.width * p[0] - 2px * root.k;
            y: parent.height * p[1] - 2px * root.k;
            width: 4px * root.k;
            height: 4px * root.k;
            border-radius: 2px * root.k;
            background: white;
        }
    }

    if root.icon == "profile": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: white;
        commands: "M 12 3 A 4.5 4.5 0 1 1 11.99 3 Z M 3.5 21.5 C 3.5 16.5 7.5 14 12 14 C 16.5 14 20.5 16.5 20.5 21.5 Z";
    }

    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Bouton de la fiche : dégradé violet -> bleu au focus/survol (comme .mainDetailButtons).
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> focused;
    in property <length> font: 16px;
    callback clicked();

    preferred-width: label.preferred-width + 40px;
    border-radius: 10px;
    background: (root.focused || area.has-hover) ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%)
        : @linear-gradient(130deg, #ffffff1f 0%, #ffffff1f 100%);

    label := Text {
        text: root.text;
        color: white;
        font-size: root.font;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Bouton de la fiche : icône (lecture, favori, vu, téléchargement) ou texte, au style de ActionButton.
component DetailButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    in property <bool> focused;
    in property <float> k: 1.0;
    callback clicked();

    property <bool> lit: root.focused || area.has-hover;

    in property <bool> chip; // pastille compacte (saison, série, pistes)
    preferred-width: root.icon != "" ? self.height : label.preferred-width + (root.chip ? 24px : 40px) * root.k;
    min-width: self.preferred-width;
    horizontal-stretch: 0;
    border-radius: root.chip ? self.height / 2 : 10px;
    background: root.lit ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%)
        : @linear-gradient(130deg, #ffffff1f 0%, #ffffff1f 100%);

    if root.icon == "play": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px * root.k;
        height: 22px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: white;
        commands: "M 7 4 L 20 12 L 7 20 Z";
    }
    if root.icon == "heart": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px * root.k;
        height: 22px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.active ? #ff4d6d : transparent;
        stroke: root.active ? #ff4d6d : white;
        stroke-width: 2px * root.k;
        commands: "M 12 20.5 L 10.6 19.2 C 5.4 14.5 2.5 11.9 2.5 8.6 C 2.5 5.9 4.6 3.8 7.3 3.8 C 8.9 3.8 10.6 4.6 12 6 C 13.4 4.6 15.1 3.8 16.7 3.8 C 19.4 3.8 21.5 5.9 21.5 8.6 C 21.5 11.9 18.6 14.5 13.4 19.2 Z";
    }
    if root.icon == "check": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px * root.k;
        height: 22px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.active ? Theme.accent2 : white;
        stroke-width: (root.active ? 3.2px : 2.2px) * root.k;
        commands: "M 4 12.5 L 9.5 18 L 20 6.5";
    }
    if root.icon == "download": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px * root.k;
        height: 22px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.active ? Theme.accent2 : white;
        stroke-width: 2.2px * root.k;
        commands: "M 12 3.5 L 12 15 M 6.5 10 L 12 15.5 L 17.5 10 M 4.5 20 L 19.5 20";
    }

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: white;
        font-size: (root.chip ? 13px : 16px) * root.k;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Panneau « résumé complet » : fond assombri uni (pas de flou, trop coûteux sur Pi).
component OverviewPanel inherits Rectangle {
    in property <string> text;
    in property <length> font: 20px;
    callback close();

    property <length> scroll: 0px;

    public function scroll-by(d: length) {
        root.scroll = clamp(root.scroll + d, 0px, max(0px, txt.height - view.height));
    }
    public function reset() {
        root.scroll = 0px;
    }

    background: #000000b8;

    TouchArea {
        clicked => {
            root.close();
        }
    }

    Rectangle {
        width: min(parent.width - 64px, 900px);
        height: min(parent.height - 96px, parent.height * 0.8);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 16px;
        background: #181820f5;
        border-width: 1px;
        border-color: #ffffff24;

        // Absorbe les clics à l'intérieur du panneau (sinon ils fermeraient le panneau).
        TouchArea { }

        view := Rectangle {
            x: 28px;
            y: 24px;
            width: parent.width - 56px;
            height: parent.height - 24px - 56px;
            clip: true;

            VerticalLayout {
                y: 0px - root.scroll;
                alignment: start;

                txt := Text {
                    text: root.text;
                    wrap: word-wrap;
                    color: Theme.text;
                    font-size: root.font;
                }
            }
        }

        Text {
            y: parent.height - 38px;
            width: parent.width;
            text: "Échap pour fermer  ·  ↑ ↓ pour défiler";
            color: Theme.muted;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
}

// Élément qui descend en glissant à son apparition (`e` passe de 0 à 1 à la création).
component DropIn inherits Rectangle {
    out property <float> e: 0;
    init => {
        self.e = 1;
    }
    animate e { duration: 280ms; easing: ease-out; }
}

// Barre de navigation en haut à gauche de chaque écran : menu, retour (si l'on a navigué),
// accueil (hors accueil) et titre de la page. Les boutons qui apparaissent descendent en glissant,
// le menu et le titre se décalent en douceur, le titre d'une nouvelle page descend aussi.
component NavBar inherits Rectangle {
    in property <float> k: 1.0;
    in property <bool> can-back;
    in property <bool> show-home;
    in property <string> title;
    in property <brush> title-color: Theme.text;
    in property <int> sel: -1; // bouton sélectionné, de gauche à droite : [retour] [accueil] menu
    in property <float> enter: 1; // arrivée de la page (0 -> 1)
    callback activate(int);

    property <int> n: 1 + (root.can-back ? 1 : 0) + (root.show-home ? 1 : 0);
    property <length> x0: 24px * root.k;
    property <length> step: 54px * root.k;
    property <length> iy: (root.height - 44px * root.k) / 2;
    height: 72px * root.k;

    if root.can-back: DropIn {
        x: root.x0;
        y: root.iy + (self.e - 1) * 34px * root.k;
        width: 44px * root.k;
        height: 44px * root.k;
        HeaderIcon {
            icon: "back";
            k: root.k;
            focused: root.sel == 0;
            clicked => {
                root.activate(0);
            }
        }
    }
    if root.show-home: DropIn {
        x: root.x0 + (root.can-back ? root.step : 0px);
        y: root.iy + (self.e - 1) * 34px * root.k;
        width: 44px * root.k;
        height: 44px * root.k;
        animate x { duration: 240ms; easing: ease-out; }
        HeaderIcon {
            icon: "home";
            k: root.k;
            focused: root.sel == (root.can-back ? 1 : 0);
            clicked => {
                root.activate(root.can-back ? 1 : 0);
            }
        }
    }
    HeaderIcon {
        x: root.x0 + (root.n - 1) * root.step;
        y: root.iy;
        animate x { duration: 240ms; easing: ease-out; }
        icon: "menu";
        k: root.k;
        focused: root.sel == root.n - 1;
        clicked => {
            root.activate(root.n - 1);
        }
    }
    Text {
        x: root.x0 + root.n * root.step + 4px * root.k;
        y: (1 - root.enter) * -18px * root.k;
        width: root.width - self.x - 8px * root.k;
        height: root.height;
        animate x { duration: 240ms; easing: ease-out; }
        text: root.title;
        color: root.title-color;
        font-size: 26px * root.k;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Droite de la barre du haut, sur toutes les pages : watch party, au hasard, recherche, compte, heure.
component HeaderRight inherits Rectangle {
    in property <float> k: 1.0;
    in property <int> sel: -1; // 0 watch party · 1 au hasard · 2 recherche · 3 compte
    in property <bool> party-on;
    in property <bool> has-avatar;
    in property <image> avatar;
    in property <string> clock;
    in property <bool> offline;
    callback activate(int);

    HorizontalLayout {
        alignment: end;
        spacing: 12px * root.k;
        padding-right: 32px * root.k;
        padding-top: (root.height - 44px * root.k) / 2;
        padding-bottom: (root.height - 44px * root.k) / 2;

        // Mode hors ligne : pastille verte à la place des icônes qui demandent le serveur.
        if root.offline: Rectangle {
            width: offline-label.preferred-width + 48px * root.k;
            border-radius: self.height / 2;
            background: #14532d;
            border-width: 1px;
            border-color: #4ade80;
            HorizontalLayout {
                padding-left: 12px * root.k;
                spacing: 8px * root.k;
                alignment: start;
                Text {
                    text: "●";
                    color: #4ade80;
                    font-size: 11px * root.k;
                    vertical-alignment: center;
                }
                offline-label := Text {
                    text: "Hors ligne";
                    color: #bbf7d0;
                    font-size: 15px * root.k;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
        if !root.offline: HeaderIcon {
            icon: "party";
            k: root.k;
            on: root.party-on;
            focused: root.sel == 0;
            clicked => {
                root.activate(0);
            }
        }
        if !root.offline: HeaderIcon {
            icon: "dice";
            k: root.k;
            focused: root.sel == 1;
            clicked => {
                root.activate(1);
            }
        }
        if !root.offline: HeaderIcon {
            icon: "search";
            k: root.k;
            focused: root.sel == 2;
            clicked => {
                root.activate(2);
            }
        }
        HeaderIcon {
            icon: root.has-avatar ? "" : "profile";
            k: root.k;
            focused: root.sel == 3;
            clicked => {
                root.activate(3);
            }
            if root.has-avatar: Image {
                x: 4px * root.k;
                y: 4px * root.k;
                width: parent.width - 8px * root.k;
                height: parent.height - 8px * root.k;
                source: root.avatar;
                image-fit: fill;
            }
        }
        Text {
            text: root.clock;
            color: Theme.text;
            font-size: 18px * root.k;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

export struct DlInfo {
    title: string,
    details: string,
    overview: string,
}

export component AppWindow inherits Window {
    title: "Turtlefin";
    background: Theme.bg;
    default-font-family: "Montserrat";
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 400px;

    in-out property <string> screen: "login"; // "login" | "loading" | "home" | "detail" | "search" | "profile"
    in-out property <string> server;
    in-out property <string> user-name;
    in-out property <string> error-text;
    in-out property <string> toast;
    // Connexion
    in-out property <string> login-mode: "pick"; // "pick" (tuiles) | "form" (identifiant, mot de passe)
    in property <[CardData]> login-tiles;
    in-out property <int> login-sel;
    in-out property <string> login-user;
    in-out property <string> login-pass;
    in-out property <int> login-field;  // 0 utilisateur · 1 mot de passe · 2 Se connecter · 3 Retour
    in-out property <bool> login-osk;   // mode TV : le clavier à l'écran a la sélection
    in property <string> server-name;
    in-out property <bool> busy;
    in property <bool> tv-mode;

    // Accueil
    in-out property <[Section]> sections;
    in-out property <int> sel-section: 0;
    in-out property <int> sel-item: 0;
    // Arrivée d'une page : 300 ms d'animation (zoom léger, glissement), puis la minuterie coupe
    // animation-tick() : rien n'est redessiné en continu.
    property <bool> page-anim;
    property <duration> page-t0;
    property <float> page-lin: root.page-anim ? clamp((animation-tick() - root.page-t0) / 300ms, 0, 1) : 1;
    out property <float> page-e: 1 - (1 - root.page-lin) * (1 - root.page-lin) * (1 - root.page-lin);
    public function page-enter() {
        root.page-t0 = animation-tick();
        root.page-anim = true;
    }
    Timer {
        interval: 320ms;
        running: root.page-anim;
        triggered => {
            root.page-anim = false;
        }
    }
    // Chargement d'une page : barre animée en haut, l'écran précédent reste affiché.
    in-out property <bool> loading;
    Timer {
        interval: 20s;
        running: root.loading;
        triggered => {
            root.loading = false;
        }
    }

    changed screen => {
        root.loading = false;
        if (root.screen != "login") {
            root.page-enter();
        }
        if (root.screen == "login") {
            root.login-mode = "pick";
            root.login-osk = false;
            root.login-opened();
        }
    }
    changed sel-item => {
        root.row-seen(root.sel-section, root.sel-item);
    }
    changed d-x => {
        root.row-seen(1000 + root.d-zone, root.d-x);
    }
    changed d-child => {
        root.row-seen(1002, root.d-child);
    }
    changed s-item => {
        root.row-seen(2000 + root.s-section, root.s-item);
    }
    in-out property <string> tab: "home";    // onglet affiché : "home" | "favorites" | "requests"
    in property <bool> has-requests;         // Seerr disponible : onglet Demandes
    in-out property <bool> h-focus: false;   // la sélection est dans l'en-tête
    in-out property <int> h-sel: 0;          // onglets (Accueil, Favoris, [Demandes]), puis Recherche, Profil
    in property <string> clock;              // « 16:52 »
    in-out property <int> prof-sel: 1;      // écran Profil : 0 Réglages · 1 Déconnexion

    // Navigation commune : bouton Retour (si l'on a navigué), menu latéral
    in property <bool> can-back;
    in-out property <bool> menu-open;
    in-out property <int> menu-sel;
    in property <[MenuEntry]> menu-entries;
    in-out property <string> soon-title: "Recherche"; // écran « bientôt disponible »
    in-out property <int> refocus;          // incrémenté : l'écran affiché reprend le clavier

    // Choix du serveur
    in property <[ServerData]> servers;
    in property <bool> srv-searching;
    in-out property <int> srv-sel;
    in-out property <bool> manual-open;
    in property <string> manual-error;
    in property <bool> manual-busy;
    in property <string> choice-a;          // deux adresses répondent (http et https) : laquelle ?
    in property <string> choice-b;

    // Paramètres : catégories à gauche (0 Profil · 1 Lecture · 2 Réseau · 3 Affichage · 4 Compte), lignes à droite
    in-out property <int> set-cat;
    in-out property <int> set-sel;
    in-out property <bool> set-in;           // sélection dans le panneau de droite
    in property <[SettingRow]> set-rows;
    in property <[CardData]> avatar-items;
    in property <bool> has-getavatar;
    in property <image> avatar;
    in property <bool> has-avatar;
    in property <bool> offline;             // pas de serveur : téléchargements seulement

    // Page Seerr (premier plan)
    in-out property <bool> sr-open;
    in property <SeerrPage> sr;
    in property <[CardData]> sr-cast;
    in-out property <int> sr-sel;           // 0 bouton Demander · 1 Fermer
    in-out property <length> sr-scroll;

    // Téléchargements : liste générale (séries, films) > saisons d'une série > épisodes d'une saison
    in property <[CardData]> dl-items;
    in property <[bool]> dl-folders;        // la carte s'ouvre (série, saison) au lieu de se lire
    in property <[DlInfo]> dl-infos;        // infos de la carte sélectionnée (bas de l'écran)
    in property <int> dl-level;             // 0 liste générale · 1 série · 2 saison
    in property <bool> dl-landscape;        // épisodes : vignettes 16:9
    in property <string> dl-title: "Téléchargements";
    in property <string> dl-status;
    in-out property <int> dl-sel;
    in-out property <bool> dl-dialog;       // Lire / Supprimer / Annuler
    in-out property <int> dl-dsel;

    // Watch party
    in property <bool> sp-active;
    in property <string> sp-name;
    in property <string> sp-people;
    in property <string> sp-state;
    in property <[MenuEntry]> sp-groups;     // label, action = identifiant du groupe
    in-out property <int> sp-sel;

    // Recherche
    in-out property <string> search-text;
    in property <[Section]> search-sections;
    in property <bool> search-busy;
    in-out property <int> s-section;
    in-out property <int> s-item;
    in-out property <bool> s-osk;            // sélection sur le clavier (mode TV) / le champ

    // Bibliothèque (grille)
    in property <string> lib-title;
    in-out property <[CardData]> lib-items;
    in property <int> lib-total;
    in-out property <int> l-sel;

    // Fiche détail
    in-out property <DetailData> detail;
    in-out property <[CardData]> child-items;
    in-out property <int> d-zone: 0;   // 0 boutons · 1 résumé · 2 enfants
    in-out property <int> d-button: 0;
    in-out property <int> d-child: 0;
    in-out property <bool> overview-open: false;
    // Choix des pistes de la fiche (liste au premier plan) : "" | "audio" | "sub"
    in-out property <string> tp-kind;
    in property <[TrackData]> tp-items;
    in-out property <int> tp-sel;
    in-out property <[Section]> detail-rows; // casting, plus de ce genre, Seerr (zones 4 et +)
    in-out property <int> d-x: 0;            // carte sélectionnée dans une rangée du bas
    in-out property <bool> playing: false;

    // Lecture (rempli par player.rs / video.rs)
    in property <image> video-frame;
    in property <bool> p-ready;
    in property <string> p-title;
    in property <string> p-subtitle;
    in property <bool> p-paused;
    in property <float> p-progress;
    in property <string> p-pos-text;
    in property <string> p-dur-text;
    in property <string> p-end-text;
    in property <[float]> p-chapters;
    in property <int> p-chapter-count;
    in property <bool> p-has-prev;
    in property <bool> p-has-next;
    in property <[TrackData]> audio-tracks;
    in property <int> audio-current;
    in property <[TrackData]> sub-tracks;
    in property <int> sub-current;
    in property <[CardData]> p-episodes;    // épisodes de la saison (bandeau ↓)
    in property <int> p-ep-current;
    in-out property <string> p-up-mode;     // "" | "next" | "pick" | "end" (propositions de fin)
    in property <string> p-up-title;
    in property <string> p-up-sub;
    in property <image> p-up-image;
    in property <bool> p-has-up-image;
    in property <[CardData]> p-picks;       // 3 suggestions
    in property <string> p-up-button;       // « Passer à l'épisode suivant » / « … à la saison suivante »
    in-out property <bool> p-skip-intro;    // bouton « Passer l'intro »
    in property <image> p-bg;               // fond de l'écran de fin (image du média, floutée)
    in property <bool> p-has-bg;

    callback login(string, string, string); // serveur, utilisateur, mot de passe
    callback open-item(string);
    callback run-action(string);            // "play" | "back" | "open:<id>"
    callback logout();
    callback switch-account();
    callback login-opened();               // écran de connexion affiché : tuiles des comptes
    callback login-pick(string);           // "acc:<id>" | "pub:<nom>" | "other"
    pure callback mask(string) -> string;  // mot de passe affiché en points
    callback select-tab(string);            // "home" | "favorites" | "requests"
    callback go-home();
    callback menu-action(string);
    callback lib-more();                    // page suivante de la bibliothèque
    // Navigation entre rangées : carte de la rangée cible (n cartes de largeur w) la plus proche
    // du centre `x` à l'écran, une fois cette rangée défilée vers elle. Calcul fait en Rust.
    // `key` désigne la rangée cible (son défilement actuel est mémorisé côté Rust par row-seen).
    pure callback row-pick(float /* x */, float /* largeur de rangée */, int /* n */, float /* w */, float /* écart */, float /* marge */, int /* key */) -> int;
    callback row-seen(int /* key */, int /* index sélectionné */);
    callback servers-search();
    callback dl-play(string);
    callback dl-open(string);               // "series:<id>" | "season:<id>"
    callback seerr-action();
    callback track-pick(string, string, string); // type, langue ("" défaut, "off"), libellé
    callback search-open();
    callback party-action(string);
    callback search-changed(string);
    callback random-pick();
    // Effacement : le clavier à l'écran envoie "\u{8}" + texte ; le dernier caractère est retiré en Rust.
    pure callback text-backspace(string) -> string;
    callback dl-delete(string);
    callback server-pick(int);
    callback manual-submit(string, string); // adresse locale, adresse distante
    callback manual-choice(string);
    callback settings-activate(string);
    callback settings-category();
    callback avatar-pick(string);
    callback player-cmd(string);            // pendant la lecture : "pause", "seek:-10", "episode:1", ...

    property <float> k: root.tv-mode ? 1.4 : 1.0;
    property <length> card-w: root.tv-mode ? 230px : 170px;
    property <length> header-h: 72px * root.k;
    property <int> tab-count: root.has-requests ? 3 : 2;

    // Centre à l'écran de la carte i d'une rangée (même calcul de défilement que SectionRow).
    pure function card-center(i: int, n: int, w: length, gap: length, pad: length, rw: length) -> length {
        return pad + i * (w + gap) + w / 2
            + min(0px, max(rw - (n * (w + gap) + pad * 2), rw / 2 - (pad + i * (w + gap) + w / 2)));
    }
    // Rangées de l'accueil.
    pure function home-w(si: int) -> length {
        return root.sections[si].landscape ? root.card-w * 1.5 : root.card-w;
    }
    pure function home-pick(from: int, to: int) -> int {
        return root.row-pick(
            root.card-center(root.sel-item, root.sections[from].items.length, root.home-w(from), 18px * root.k, 32px * root.k, root.width) / 1px,
            root.width / 1px, root.sections[to].items.length, root.home-w(to) / 1px, 18 * root.k, 32 * root.k, to);
    }
    // Fiche : rangée d'enfants (zone 2) et rangées du bas (zones 4+), cartes de 140 px x k.
    pure function detail-pick-down(from-x: int, from-n: int, from-w: length, to-row: int) -> int {
        return root.row-pick(
            root.card-center(from-x, from-n, from-w, 18px * root.k, 32px * root.k, root.width) / 1px,
            root.width / 1px, root.detail-rows[to-row].items.length, 140 * root.k, 18 * root.k, 32 * root.k, 1004 + to-row);
    }
    // Boutons de la barre de navigation, de gauche à droite : [retour], [accueil], menu.
    property <bool> show-home: root.screen != "home";
    property <int> nav-n: 1 + (root.can-back ? 1 : 0) + (root.show-home ? 1 : 0);

    function nav-activate(i: int) {
        root.h-focus = false;
        if (i == 0 && root.can-back) {
            root.run-action("back");
        } else if (i == root.nav-n - 1) {
            root.open-menu();
        } else {
            root.menu-action("home");
        }
    }

    function open-menu() {
        root.menu-sel = root.menu-entries.length > 1 && root.menu-entries[0].header ? 1 : 0;
        root.menu-open = true;
    }

    function close-menu() {
        root.menu-open = false;
        root.refocus += 1;
    }

    // Déplacement dans le menu en sautant les intitulés de groupe.
    function menu-move(d: int) {
        if (root.menu-sel + d >= 0 && root.menu-sel + d < root.menu-entries.length) {
            if (root.menu-entries[root.menu-sel + d].header) {
                if (root.menu-sel + 2 * d >= 0 && root.menu-sel + 2 * d < root.menu-entries.length) {
                    root.menu-sel += 2 * d;
                }
            } else {
                root.menu-sel += d;
            }
        }
    }

    // Touches de la barre de navigation (écrans autres que l'accueil). Renvoie true si traitée.
    function nav-key(t: string) -> bool {
        if (!root.h-focus) {
            return false;
        }
        if (t == Key.LeftArrow) {
            root.h-sel = max(0, root.h-sel - 1);
        } else if (t == Key.RightArrow) {
            root.h-sel = min(root.right-base + 3, root.h-sel + 1);
        } else if (t == Key.DownArrow || t == Key.Escape) {
            root.h-focus = false;
        } else if (t == Key.Return) {
            if (root.h-sel < root.nav-n) {
                root.nav-activate(root.h-sel);
            } else {
                root.right-activate(root.h-sel - root.right-base);
            }
        }
        return true;
    }

    // Monte dans la barre de navigation, sur le premier bouton (Retour s'il existe).
    function nav-enter() {
        root.h-focus = true;
        root.h-sel = 0;
    }

    function tab-index() -> int {
        return root.tab == "favorites" ? 1 : root.tab == "requests" ? 2 : 0;
    }

    // Onglets, puis Recherche, puis Profil.
    function header-activate(i: int) {
        if (i == 0) {
            root.select-tab("home");
        } else if (i == 1) {
            root.select-tab("favorites");
        } else if (i == 2 && root.has-requests) {
            root.select-tab("requests");
        }
    }

    // Icônes de droite de la barre du haut (toutes les pages).
    property <int> right-base: root.screen == "home" ? root.nav-n + root.tab-count : root.nav-n;
    function right-activate(i: int) {
        root.h-focus = false;
        if (i == 0) {
            root.menu-action("party");
        } else if (i == 1) {
            root.random-pick();
        } else if (i == 2) {
            root.search-open();
        } else {
            root.menu-action("settings");
        }
    }

    property <length> poster-w: 200px * root.k;
    property <length> col-x: 64px + root.poster-w;
    property <float> child-ratio: root.detail.children-landscape ? 0.5625 : 1.5;
    property <length> child-card-w: (root.detail.children-landscape ? 240px : 120px) * root.k;
    property <length> next-w: 260px * root.k;
    // Haut de la rangée d'enfants, et des rangées du bas (sous les enfants s'il y en a).
    property <length> d-children-y: 24px + 316px * root.k + 16px;
    property <length> d-extra-y: root.d-children-y
        + (root.child-items.length > 0 ? root.child-card-w * root.child-ratio + 132px * root.k : 0px);
    // Défilement de la fiche : la rangée sélectionnée remonte vers le haut de l'écran.
    property <length> d-scroll: root.d-zone >= 4 && root.d-zone - 4 < root.detail-rows.length
        ? max(0px, root.d-extra-y + root.detail-rows[root.d-zone - 4].y-px * 1px - 40px * root.k)
        : root.d-zone == 2 ? max(0px, root.d-children-y - 140px * root.k) : 0px;
    // Largeur de la colonne d'infos : rétrécie quand le bloc « À suivre » est affiché.
    property <length> info-w: root.width - root.col-x - 32px - (root.detail.has-next ? root.next-w + 24px : 0px);

    // ------------------------------------------------------------ Connexion
    // Pendant la lecture, aucun écran n'est instancié sous la vidéo : rien à redessiner à chaque
    // image, et le clavier va au lecteur.
    if root.screen == "login" && !root.playing: lg := Rectangle {
        property <length> u: min(self.height / 720px, self.width / 1280px) * 1px;
        property <length> tile: 150 * self.u;
        property <int> n: root.login-tiles.length;
        // Tuiles puis bouton « Changer de serveur » (index n).
        // Formulaire : largeur, haut, hauteur d'un champ, des boutons, écart entre les lignes.
        property <length> fw: min(self.width - 80 * self.u, 560 * self.u);
        property <length> fy: 150 * self.u;
        property <length> field-h: 54 * self.u;
        property <length> btn-h: 46 * self.u;
        property <length> gap: 12 * self.u;

        function submit() {
            root.login(root.server, root.login-user, root.login-pass);
        }

        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                self.focus();
            }
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if (root.busy) {
                    return EventResult.accept;
                }
                if (root.login-mode == "pick") {
                    if (event.text == Key.LeftArrow) {
                        root.login-sel = max(0, root.login-sel - 1);
                    } else if (event.text == Key.RightArrow) {
                        root.login-sel = min(lg.n - 1, root.login-sel + 1);
                    } else if (event.text == Key.DownArrow) {
                        root.login-sel = lg.n;
                    } else if (event.text == Key.UpArrow) {
                        if (root.login-sel >= lg.n) {
                            root.login-sel = 0;
                        }
                    } else if (event.text == Key.Return) {
                        if (root.login-sel >= lg.n) {
                            root.menu-action("server");
                        } else {
                            root.login-pick(root.login-tiles[root.login-sel].id);
                        }
                    }
                    return EventResult.accept;
                }
                // Formulaire
                if (event.text == Key.Escape) {
                    root.login-mode = "pick";
                    root.login-osk = false;
                    return EventResult.accept;
                }
                if (!root.tv-mode) {
                    return EventResult.reject;
                }
                if (root.login-osk) {
                    if (form-osk.key(event.text)) {
                        return EventResult.accept;
                    }
                    if (event.text == Key.Escape || event.text == Key.Backspace) {
                        root.login-osk = false;
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.UpArrow) {
                    root.login-field = max(0, root.login-field - 1);
                } else if (event.text == Key.DownArrow) {
                    root.login-field = min(3, root.login-field + 1);
                } else if (event.text == Key.Return) {
                    if (root.login-field <= 1) {
                        root.login-osk = true;
                    } else if (root.login-field == 2) {
                        lg.submit();
                    } else {
                        root.login-mode = "pick";
                    }
                } else if (event.text == Key.Backspace) {
                    root.login-mode = "pick";
                }
                return EventResult.accept;
            }
        }

        // En-tête : nom de l'appli et serveur
        Text {
            y: 40 * lg.u;
            width: parent.width;
            text: "Turtlefin";
            color: Theme.accent2;
            font-size: 44 * lg.u;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Text {
            y: 100 * lg.u;
            width: parent.width;
            text: root.server-name != "" ? root.server-name + "  ·  " + root.server : root.server;
            color: Theme.muted;
            font-size: 16 * lg.u;
            horizontal-alignment: center;
        }

        // ---- Qui regarde ?
        if root.login-mode == "pick": Rectangle {
            Text {
                y: 170 * lg.u;
                width: parent.width;
                text: "Qui regarde ?";
                color: white;
                font-size: 30 * lg.u;
                font-weight: 700;
                horizontal-alignment: center;
            }
            for t[i] in root.login-tiles: Rectangle {
                x: (parent.width - (lg.n * (lg.tile + 30 * lg.u) - 30 * lg.u)) / 2 + i * (lg.tile + 30 * lg.u);
                y: 240 * lg.u;
                width: lg.tile;
                height: lg.tile + 70 * lg.u;
                property <bool> sel: (i == root.login-sel) || tile-area.has-hover;
                transform-scale: self.sel ? 1.08 : 1.0;
                animate transform-scale { duration: 120ms; }
                Rectangle {
                    y: 0px;
                    width: lg.tile;
                    height: lg.tile;
                    border-radius: self.width / 2;
                    background: t.id == "other" ? #ffffff14 : @linear-gradient(130deg, #3b2a55 0%, #12304a 100%);
                    border-width: parent.sel ? 5 * lg.u : 0px;
                    border-color: Theme.accent2;
                    if t.has-image: Image {
                        x: 6 * lg.u;
                        y: 6 * lg.u;
                        width: parent.width - 12 * lg.u;
                        height: parent.height - 12 * lg.u;
                        source: t.image;
                        image-fit: fill;
                    }
                    if !t.has-image: Text {
                        text: t.id == "other" ? "+" : t.rating;
                        color: white;
                        font-size: (t.id == "other" ? 64 : 40) * lg.u;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: clip;
                    }
                }
                Marquee {
                    y: lg.tile + 12 * lg.u;
                    width: parent.width;
                    text: t.title;
                    text-color: white;
                    font-size: 18 * lg.u;
                    font-weight: 600;
                    horizontal-alignment: center;
                    active: i == root.login-sel;
                    height: self.preferred-height;
                }
                Text {
                    y: lg.tile + 38 * lg.u;
                    width: parent.width;
                    text: t.subtitle;
                    color: Theme.accent2;
                    font-size: 13 * lg.u;
                    horizontal-alignment: center;
                }
                tile-area := TouchArea {
                    clicked => {
                        root.login-sel = i;
                        root.login-pick(t.id);
                    }
                }
            }
            HorizontalLayout {
                y: 240 * lg.u + lg.tile + 110 * lg.u;
                width: parent.width;
                height: 46 * lg.u;
                alignment: center;
                ActionButton {
                    text: "Changer de serveur";
                    font: 16 * lg.u;
                    focused: root.login-sel >= lg.n;
                    clicked => {
                        root.menu-action("server");
                    }
                }
            }
            Text {
                y: parent.height - 50 * lg.u;
                width: parent.width;
                text: root.busy ? "Connexion…" : root.error-text;
                color: root.busy ? Theme.muted : #ff6b6b;
                font-size: 15 * lg.u;
                horizontal-alignment: center;
            }
        }

        // Sous les boutons du formulaire.
        form-osk := Osk {
            x: (parent.width - self.width) / 2;
            y: lg.fy + 2 * lg.field-h + lg.btn-h + 2 * lg.gap + 28 * lg.u;
            width: min(parent.width - 80 * lg.u, 760 * lg.u);
            visible: root.tv-mode && root.login-mode == "form";
            k: lg.u / 1px * 1.0;
            active: root.login-osk;
            text: root.login-field == 0 ? root.login-user : root.login-pass;
            ok-label: root.login-field == 0 ? "Suivant" : "Connexion";
            erase(t) => {
                return root.text-backspace("\u{8}" + t);
            }
            edited(t) => {
                if (root.login-field == 0) {
                root.login-user = t;
                } else {
                root.login-pass = t;
                }
            }
            done => {
                if (root.login-field == 0) {
                root.login-field = 1;
                } else {
                root.login-osk = false;
                lg.submit();
                }
            }
            leave-up => {
                root.login-osk = false;
            }
            leave-down => {
                root.login-osk = false;
                root.login-field = 2;
            }
        }

        // ---- Formulaire (identifiant, mot de passe) : une colonne à hauteurs fixes, centrée.
        if root.login-mode == "form": VerticalLayout {
            x: (parent.width - lg.fw) / 2;
            y: lg.fy;
            width: lg.fw;
            height: 2 * lg.field-h + lg.btn-h + 3 * lg.gap + 30 * lg.u;
            spacing: lg.gap;
            alignment: start;

            // Mode TV : champs affichés, saisis au clavier à l'écran.
            if root.tv-mode: VerticalLayout {
                spacing: lg.gap;
                for f[i] in ["Utilisateur", "Mot de passe"]: Rectangle {
                    height: lg.field-h;
                    border-radius: 12 * lg.u;
                    background: #ffffff14;
                    border-width: root.login-field == i ? 2px : 1px;
                    border-color: root.login-field == i ? Theme.accent2 : #ffffff33;
                    Text {
                        x: 20 * lg.u;
                        width: 150 * lg.u;
                        height: parent.height;
                        text: f;
                        color: Theme.muted;
                        font-size: 15 * lg.u;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 170 * lg.u;
                        width: parent.width - 190 * lg.u;
                        height: parent.height;
                        text: (i == 0 ? root.login-user : root.mask(root.login-pass)) + (root.login-osk && root.login-field == i ? "│" : "");
                        color: white;
                        font-size: 18 * lg.u;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TouchArea {
                        clicked => {
                            root.login-field = i;
                            root.login-osk = true;
                        }
                    }
                }
            }
            // Bureau : champs classiques.
            if !root.tv-mode: VerticalLayout {
                spacing: lg.gap;
                user-in := LineEdit {
                    height: lg.field-h;
                    font-size: 17 * lg.u;
                    placeholder-text: "Utilisateur";
                    text <=> root.login-user;
                    init => {
                        if (root.login-field == 0) {
                            self.focus();
                        }
                    }
                    accepted => {
                        pass-in.focus();
                    }
                }
                pass-in := LineEdit {
                    height: lg.field-h;
                    font-size: 17 * lg.u;
                    placeholder-text: "Mot de passe";
                    input-type: InputType.password;
                    text <=> root.login-pass;
                    init => {
                        if (root.login-field == 1) {
                            self.focus();
                        }
                    }
                    accepted => {
                        lg.submit();
                    }
                }
            }

            HorizontalLayout {
                height: lg.btn-h;
                spacing: 14 * lg.u;
                alignment: start;
                ActionButton {
                    text: root.busy ? "Connexion…" : "Se connecter";
                    font: 17 * lg.u;
                    focused: root.tv-mode ? !root.login-osk && root.login-field == 2 : true;
                    clicked => {
                        lg.submit();
                    }
                }
                ActionButton {
                    text: "Retour";
                    font: 17 * lg.u;
                    focused: root.tv-mode && !root.login-osk && root.login-field == 3;
                    clicked => {
                        root.login-mode = "pick";
                        root.login-osk = false;
                    }
                }
            }

            Text {
                height: 30 * lg.u;
                text: root.error-text;
                color: #ff6b6b;
                font-size: 15 * lg.u;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    // ------------------------------------------------------------ Chargement
    // Démarrage (ou juste après la connexion) : nom de l'appli et barre animée.
    if root.screen == "loading" && !root.playing: Rectangle {
        Text {
            y: parent.height / 2 - 60px * root.k;
            width: parent.width;
            text: "Turtlefin";
            color: Theme.accent2;
            font-size: 48px * root.k;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height / 2 + 20px * root.k;
            width: 220px * root.k;
            height: 4px * root.k;
            border-radius: self.height / 2;
            background: #ffffff1a;
            Rectangle {
                x: (mod(animation-tick() / 1ms, 1400) / 1400) * (parent.width + self.width) - self.width;
                width: 80px * root.k;
                height: parent.height;
                border-radius: self.height / 2;
                background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
            }
        }
    }

    // ------------------------------------------------------------ Accueil / Favoris
    if root.screen == "home" && !root.playing: Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        // En-tête : nom, onglets au centre, recherche, profil et heure à droite.
        Rectangle {
            y: 0px;
            height: root.header-h;

            NavBar {
                x: 0px;
                width: parent.width / 3;
                k: root.k;
                can-back: false;
                show-home: false;
                title: "Turtlefin";
                title-color: root.offline ? #4ade80 : Theme.accent2;
                sel: root.h-focus && root.h-sel < root.nav-n ? root.h-sel : -1;
                activate(i) => {
                    root.nav-activate(i);
                }
            }

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                alignment: center;
                spacing: 36px * root.k;

                Tab {
                    text: "Accueil";
                    k: root.k;
                    active: root.tab == "home";
                    focused: root.h-focus && root.h-sel == root.nav-n + 0;
                    clicked => {
                        root.h-sel = root.nav-n + 0;
                        root.header-activate(0);
                    }
                }
                Tab {
                    text: "Favoris";
                    k: root.k;
                    active: root.tab == "favorites";
                    focused: root.h-focus && root.h-sel == root.nav-n + 1;
                    clicked => {
                        root.h-sel = root.nav-n + 1;
                        root.header-activate(1);
                    }
                }
                if root.has-requests: Tab {
                    text: "Demandes";
                    k: root.k;
                    active: root.tab == "requests";
                    focused: root.h-focus && root.h-sel == root.nav-n + 2;
                    clicked => {
                        root.h-sel = root.nav-n + 2;
                        root.header-activate(2);
                    }
                }
            }

            HeaderRight {
                width: parent.width;
                height: parent.height;
                k: root.k;
                sel: root.h-focus && root.h-sel >= root.right-base ? root.h-sel - root.right-base : -1;
                party-on: root.sp-active;
                has-avatar: root.has-avatar;
                avatar: root.avatar;
                clock: root.clock;
                offline: root.offline;
                activate(i) => {
                    root.right-activate(i);
                }
            }
        }

        FocusScope {
            y: root.header-h;
            height: parent.height - root.header-h;

            property <int> tick: root.refocus;
            changed tick => {
                self.focus();
            }

            init => {
                self.focus();
            }

            key-pressed(event) => {
                // Sélection dans l'en-tête : menu, onglets, recherche, profil
                if (root.h-focus) {
                    if (event.text == Key.LeftArrow) {
                        root.h-sel = max(0, root.h-sel - 1);
                    } else if (event.text == Key.RightArrow) {
                        root.h-sel = min(root.right-base + 3, root.h-sel + 1);
                    } else if (event.text == Key.DownArrow) {
                        if (root.sections.length > 0) {
                            root.h-focus = false;
                        }
                    } else if (event.text == Key.Return) {
                        if (root.h-sel < root.nav-n) {
                            root.nav-activate(root.h-sel);
                        } else if (root.h-sel < root.right-base) {
                            root.header-activate(root.h-sel - root.nav-n);
                        } else {
                            root.right-activate(root.h-sel - root.right-base);
                        }
                    }
                    return EventResult.accept;
                }
                if (root.sections.length == 0) {
                    root.h-focus = true;
                    root.h-sel = root.nav-n + root.tab-index();
                    return EventResult.accept;
                }
                if (event.text == Key.RightArrow) {
                    if (root.sel-item < root.sections[root.sel-section].items.length - 1) {
                        root.sel-item += 1;
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.LeftArrow) {
                    if (root.sel-item > 0) {
                        root.sel-item -= 1;
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.DownArrow) {
                    if (root.sel-section < root.sections.length - 1) {
                        root.sel-item = root.home-pick(root.sel-section, root.sel-section + 1);
                        root.sel-section += 1;
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.UpArrow) {
                    if (root.sel-section > 0) {
                        root.sel-item = root.home-pick(root.sel-section, root.sel-section - 1);
                        root.sel-section -= 1;
                    } else {
                        // Depuis la première rangée : on monte dans l'en-tête, sur l'onglet affiché.
                        root.h-focus = true;
                        root.h-sel = root.nav-n + root.tab-index();
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.Return) {
                    root.open-item(root.sections[root.sel-section].items[root.sel-item].id);
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            if root.sections.length == 0: Text {
                text: root.tab == "favorites" ? "Aucun favori pour l'instant."
                    : root.tab == "requests" ? "Aucune demande pour l'instant." : "Rien à afficher.";
                color: Theme.muted;
                font-size: 20px * root.k;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                clip: true;

                Rectangle {
                    y: root.sections.length == 0 ? 0px
                        : min(0px, 4px * root.k - root.sections[root.sel-section].y-px * 1px);
                    animate y { duration: 180ms; easing: ease-out; }

                    for section[si] in root.sections: SectionRow {
                        y: section.y-px * 1px;
                        width: parent.width;
                        height: section.h-px * 1px;
                        title: section.title;
                        items: section.items;
                        card-w: section.landscape ? root.card-w * 1.5 : root.card-w;
                        ratio: section.landscape ? 0.5625 : 1.5;
                        k: root.k;
                        active: !root.h-focus && si == root.sel-section;
                        focus-index: root.sel-item;
                        activated(i) => {
                            root.h-focus = false;
                            root.sel-section = si;
                            root.sel-item = i;
                            root.open-item(section.items[i].id);
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Watch party
    if root.screen == "party" && !root.playing: party := Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        y: root.header-h + (1 - root.page-e) * 28px * root.k;
        height: parent.height - root.header-h;

        // Boutons : dans un groupe, « Quitter » ; sinon les groupes existants puis « Créer ».
        property <int> n: root.sp-active ? 1 : root.sp-groups.length + 1;

        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                self.focus();
            }
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                if (event.text == Key.UpArrow) {
                    if (root.sp-sel == 0) {
                        root.nav-enter();
                    } else {
                        root.sp-sel -= 1;
                    }
                } else if (event.text == Key.DownArrow) {
                    root.sp-sel = min(party.n - 1, root.sp-sel + 1);
                } else if (event.text == Key.Return) {
                    if (root.sp-active) {
                        root.party-action("leave");
                    } else if (root.sp-sel < root.sp-groups.length) {
                        root.party-action(root.sp-groups[root.sp-sel].action);
                    } else {
                        root.party-action("create");
                    }
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.go-home();
                }
                return EventResult.accept;
            }
        }

        VerticalLayout {
            x: 64px * root.k;
            width: min(parent.width - 128px * root.k, 760px * root.k);
            alignment: start;
            spacing: 14px * root.k;

            Text {
                text: "Watch party";
                color: Theme.text;
                font-size: 30px * root.k;
                font-weight: 700;
            }
            Text {
                text: root.sp-active
                    ? "Tu es dans « " + root.sp-name + " ». Lance un film ou un épisode : il démarrera pour tout le groupe, en même temps. Pause et sauts sont partagés."
                    : "Regarde la même chose en même temps que d'autres comptes : crée une watch party ou rejoins-en une.";
                color: Theme.muted;
                font-size: 15px * root.k;
                wrap: word-wrap;
            }
            if root.sp-active: Text {
                text: "État : " + root.sp-state;
                color: Theme.text;
                font-size: 16px * root.k;
                font-weight: 600;
            }
            if root.sp-active: Text {
                text: "Participants : " + root.sp-people;
                color: Theme.accent2;
                font-size: 16px * root.k;
                font-weight: 600;
                wrap: word-wrap;
            }
            if !root.sp-active && root.sp-groups.length > 0: Text {
                text: "REJOINDRE";
                color: Theme.muted;
                font-size: 12px * root.k;
                font-weight: 700;
            }
            for g[i] in root.sp-active ? [] : root.sp-groups: Rectangle {
                height: 56px * root.k;
                border-radius: 12px * root.k;
                background: i == root.sp-sel || g-area.has-hover ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : #ffffff14;
                Text {
                    x: 20px * root.k;
                    height: parent.height;
                    text: g.label;
                    color: white;
                    font-size: 16px * root.k;
                    vertical-alignment: center;
                }
                g-area := TouchArea {
                    clicked => {
                        root.party-action(g.action);
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                height: 46px * root.k;
                ActionButton {
                    text: root.sp-active ? "Quitter la watch party" : "Créer une watch party";
                    font: 16px * root.k;
                    focused: root.sp-active ? root.sp-sel == 0 : root.sp-sel == root.sp-groups.length;
                    clicked => {
                        root.party-action(root.sp-active ? "leave" : "create");
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Recherche
    if root.screen == "search" && !root.playing: srch := Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        y: root.header-h + (1 - root.page-e) * 28px * root.k;
        height: parent.height - root.header-h;

        property <length> box-h: 52px * root.k;
        property <length> osk-h: root.tv-mode ? 7 * 48px * root.k + 16px * root.k : 0px;
        property <length> res-y: 16px * root.k + self.box-h + 16px * root.k + (root.s-osk ? self.osk-h : 0px);

        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                self.focus();
            }
            init => {
                if (root.tv-mode) {
                    self.focus();
                } else {
                    s-input.focus();
                }
            }
            key-pressed(event) => {
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                if (event.text == Key.Escape) {
                    root.go-home();
                    return EventResult.accept;
                }
                // Clavier à l'écran (mode TV)
                if (root.tv-mode && root.s-osk) {
                    if (osk.key(event.text)) {
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
                if (root.search-sections.length == 0) {
                    if (event.text == Key.UpArrow) {
                        if (root.tv-mode) {
                            root.s-osk = true;
                        } else {
                            s-input.focus();
                        }
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.RightArrow) {
                    root.s-item = min(root.search-sections[root.s-section].items.length - 1, root.s-item + 1);
                } else if (event.text == Key.LeftArrow) {
                    root.s-item = max(0, root.s-item - 1);
                } else if (event.text == Key.DownArrow) {
                    if (root.s-section < root.search-sections.length - 1) {
                        root.s-item = root.row-pick(
                            root.card-center(root.s-item, root.search-sections[root.s-section].items.length,
                                root.search-sections[root.s-section].landscape ? root.card-w * 1.5 : root.card-w, 18px * root.k, 32px * root.k, root.width) / 1px,
                            root.width / 1px, root.search-sections[root.s-section + 1].items.length,
                            (root.search-sections[root.s-section + 1].landscape ? root.card-w * 1.5 : root.card-w) / 1px, 18 * root.k, 32 * root.k, 2001 + root.s-section);
                        root.s-section += 1;
                    }
                } else if (event.text == Key.UpArrow) {
                    if (root.s-section > 0) {
                        root.s-item = root.row-pick(
                            root.card-center(root.s-item, root.search-sections[root.s-section].items.length,
                                root.search-sections[root.s-section].landscape ? root.card-w * 1.5 : root.card-w, 18px * root.k, 32px * root.k, root.width) / 1px,
                            root.width / 1px, root.search-sections[root.s-section - 1].items.length,
                            (root.search-sections[root.s-section - 1].landscape ? root.card-w * 1.5 : root.card-w) / 1px, 18 * root.k, 32 * root.k, 1999 + root.s-section);
                        root.s-section -= 1;
                    } else if (root.tv-mode) {
                        root.s-osk = true;
                    } else {
                        s-input.focus();
                    }
                } else if (event.text == Key.Return) {
                    root.open-item(root.search-sections[root.s-section].items[root.s-item].id);
                } else if (event.text == Key.Backspace) {
                    root.go-home();
                }
                return EventResult.accept;
            }
        }

        // Champ de recherche
        Rectangle {
            x: 32px * root.k;
            y: 16px * root.k;
            width: parent.width - 64px * root.k;
            height: parent.box-h;
            border-radius: self.height / 2;
            background: #ffffff14;
            border-width: (root.tv-mode && root.s-osk) || s-input.has-focus ? 2px : 1px;
            border-color: (root.tv-mode && root.s-osk) || s-input.has-focus ? Theme.accent2 : #ffffff33;

            Path {
                x: 18px * root.k;
                y: (parent.height - self.height) / 2;
                width: 22px * root.k;
                height: 22px * root.k;
                viewbox-width: 24;
                viewbox-height: 24;
                fill: transparent;
                stroke: #ffffffb3;
                stroke-width: 2.4px * root.k;
                commands: "M 10.5 3.5 A 7 7 0 1 1 10.49 3.5 Z M 15.6 15.6 L 21 21";
            }
            // Mode TV : texte tapé au clavier à l'écran ; sinon, champ classique.
            if root.tv-mode: Text {
                x: 54px * root.k;
                width: parent.width - 70px * root.k;
                height: parent.height;
                text: root.search-text == "" ? "Titre d'un film, d'une série, d'un épisode…" : root.search-text + "│";
                color: root.search-text == "" ? Theme.muted : white;
                font-size: 18px * root.k;
                vertical-alignment: center;
                overflow: elide;
            }
            s-input := TextInput {
                x: 54px * root.k;
                width: parent.width - 70px * root.k;
                height: parent.height;
                visible: !root.tv-mode;
                enabled: !root.tv-mode;
                text <=> root.search-text;
                color: white;
                font-size: 18px * root.k;
                vertical-alignment: center;
                single-line: true;
                edited => {
                    root.search-changed(self.text);
                }
                key-pressed(event) => {
                    if (event.text == Key.DownArrow || event.text == Key.Return) {
                        root.refocus += 1;
                        return EventResult.accept;
                    }
                    if (event.text == Key.UpArrow) {
                        root.nav-enter();
                        root.refocus += 1;
                        return EventResult.accept;
                    }
                    if (event.text == Key.Escape) {
                        root.go-home();
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            if !root.tv-mode && root.search-text == "": Text {
                x: 54px * root.k;
                height: parent.height;
                text: "Titre d'un film, d'une série, d'un épisode…";
                color: Theme.muted;
                font-size: 18px * root.k;
                vertical-alignment: center;
            }
        }

        // Clavier à l'écran (mode TV)
        osk := Osk {
            x: max(32px * root.k, (parent.width - 900px * root.k) / 2);
            y: 16px * root.k + parent.box-h + 16px * root.k;
            width: min(parent.width - 64px * root.k, 900px * root.k);
            visible: root.tv-mode && root.s-osk;
            k: root.k;
            active: root.s-osk;
            text: root.search-text;
            erase(t) => {
                return root.text-backspace("\u{8}" + t);
            }
            edited(t) => {
                root.search-text = t;
                root.search-changed(root.search-text);
            }
            done => {
                if (root.search-sections.length > 0) {
                    root.s-osk = false;
                }
            }
            leave-up => {
                root.nav-enter();
            }
            leave-down => {
                if (root.search-sections.length > 0) {
                    root.s-osk = false;
                }
            }
        }

        // Résultats
        Rectangle {
            y: parent.res-y;
            height: parent.height - parent.res-y;
            clip: true;

            if root.search-sections.length == 0: Text {
                text: root.search-busy ? "Recherche…" : root.search-text.character-count >= 2 ? "Aucun résultat." : "";
                color: Theme.muted;
                font-size: 18px * root.k;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                y: root.search-sections.length == 0 ? 0px
                    : min(0px, 4px * root.k - root.search-sections[root.s-section].y-px * 1px);
                animate y { duration: 180ms; easing: ease-out; }

                for section[si] in root.search-sections: SectionRow {
                    y: section.y-px * 1px;
                    width: parent.width;
                    height: section.h-px * 1px;
                    title: section.title;
                    items: section.items;
                    card-w: section.landscape ? root.card-w * 1.5 : root.card-w;
                    ratio: section.landscape ? 0.5625 : 1.5;
                    k: root.k;
                    active: !root.h-focus && !root.s-osk && si == root.s-section;
                    focus-index: root.s-item;
                    activated(i) => {
                        root.s-section = si;
                        root.s-item = i;
                        root.open-item(section.items[i].id);
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Bientôt disponible (Recherche, Paramètres)
    if root.screen == "soon" && !root.playing: Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                self.focus();
            }
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                if (event.text == Key.UpArrow) {
                    root.nav-enter();
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.go-home();
                }
                return EventResult.accept;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 14px * root.k;

            Text {
                text: root.soon-title;
                color: Theme.text;
                font-size: 34px * root.k;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "Bientôt disponible.";
                color: Theme.muted;
                font-size: 18px * root.k;
                horizontal-alignment: center;
            }
            Text {
                text: "Échap ou Retour arrière pour revenir";
                color: Theme.muted;
                font-size: 14px * root.k;
                horizontal-alignment: center;
            }
        }
    }

    // ------------------------------------------------------------ Profil
    if root.screen == "profile" && !root.playing: Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                self.focus();
            }
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                if (event.text == Key.UpArrow) {
                    root.nav-enter();
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.go-home();
                } else if (event.text == Key.LeftArrow) {
                    root.prof-sel = 0;
                } else if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                    root.prof-sel = 1;
                } else if (event.text == Key.Return && root.prof-sel == 1) {
                    root.logout();
                }
                return EventResult.accept;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 24px * root.k;

            Text {
                text: root.user-name;
                color: Theme.text;
                font-size: 34px * root.k;
                font-weight: 700;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 16px * root.k;
                height: 44px * root.k;

                ActionButton {
                    text: "Réglages · bientôt";
                    font: 16px * root.k;
                    focused: root.prof-sel == 0;
                    clicked => {
                        root.prof-sel = 0;
                    }
                }
                ActionButton {
                    text: "Déconnexion";
                    font: 16px * root.k;
                    focused: root.prof-sel == 1;
                    clicked => {
                        root.logout();
                    }
                }
            }

            Text {
                text: "Échap ou Retour arrière pour revenir";
                color: Theme.muted;
                font-size: 14px * root.k;
                horizontal-alignment: center;
            }
        }
    }

    // ------------------------------------------------------------ Fiche détail
    if root.screen == "detail" && !root.playing: Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        y: root.header-h + (1 - root.page-e) * 28px * root.k;
        height: parent.height - root.header-h;
        clip: true; // le contenu défile sous la barre de navigation sans la recouvrir

        // Réceptionne le clavier / la télécommande (sans taille : seul le focus compte).
        FocusScope {
            width: 0px;
            height: 0px;

            property <int> tick: root.refocus;
            changed tick => {
                self.focus();
            }

            init => {
                self.focus();
            }

            key-pressed(event) => {
                if (root.tp-kind != "") {
                    if (event.text == Key.UpArrow) {
                        root.tp-sel = max(0, root.tp-sel - 1);
                    } else if (event.text == Key.DownArrow) {
                        root.tp-sel = min(root.tp-items.length - 1, root.tp-sel + 1);
                    } else if (event.text == Key.Return) {
                        root.track-pick(root.tp-kind, root.tp-items[root.tp-sel].id, root.tp-items[root.tp-sel].label);
                    } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                        root.tp-kind = "";
                    }
                    return EventResult.accept;
                }
                if (!root.overview-open && root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                // Panneau « résumé complet » ouvert : il capte toutes les touches.
                if (root.overview-open) {
                    if (event.text == Key.DownArrow) {
                        ov-panel.scroll-by(80px);
                    } else if (event.text == Key.UpArrow) {
                        ov-panel.scroll-by(-80px);
                    } else if (event.text == Key.PageDown) {
                        ov-panel.scroll-by(300px);
                    } else if (event.text == Key.PageUp) {
                        ov-panel.scroll-by(-300px);
                    } else if (event.text == Key.Escape || event.text == Key.Backspace || event.text == Key.Return) {
                        root.overview-open = false;
                        ov-panel.reset();
                    }
                    return EventResult.accept;
                }

                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.run-action("back");
                    return EventResult.accept;
                }

                // Zone 0 : boutons (↑ : pastilles -> icônes -> barre de navigation)
                if (root.d-zone == 0) {
                    if (event.text == Key.UpArrow) {
                        if (root.d-button >= root.detail.icon-count) {
                            root.d-button = 0;
                        } else {
                            root.nav-enter();
                        }
                        return EventResult.accept;
                    }
                    let on-icons = root.d-button < root.detail.icon-count;
                    if (event.text == Key.RightArrow) {
                        if (root.d-button < (on-icons ? root.detail.icon-count : root.detail.buttons.length) - 1) {
                            root.d-button += 1;
                        } else if (root.detail.has-next) {
                            root.d-zone = 3;
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.LeftArrow) {
                        if (root.d-button > (on-icons ? 0 : root.detail.icon-count)) {
                            root.d-button -= 1;
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.DownArrow && on-icons && root.detail.buttons.length > root.detail.icon-count) {
                        root.d-button = root.detail.icon-count;
                        return EventResult.accept;
                    }
                    if (event.text == Key.DownArrow) {
                        if (root.detail.overview != "") {
                            root.d-zone = 1;
                        } else if (root.child-items.length > 0) {
                            root.d-zone = 2;
                        } else if (root.detail-rows.length > 0) {
                            root.d-zone = 4;
                            root.d-x = 0;
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.Return) {
                        root.run-action(root.detail.buttons[root.d-button].action);
                        return EventResult.accept;
                    }
                }

                // Zone 1 : résumé
                if (root.d-zone == 1) {
                    if (event.text == Key.UpArrow) {
                        root.d-zone = 0;
                        return EventResult.accept;
                    }
                    if (event.text == Key.RightArrow) {
                        if (root.detail.has-next) {
                            root.d-zone = 3;
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.DownArrow) {
                        if (root.child-items.length > 0) {
                            root.d-zone = 2;
                        } else if (root.detail-rows.length > 0) {
                            root.d-zone = 4;
                            root.d-x = 0;
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.Return) {
                        root.overview-open = true;
                        return EventResult.accept;
                    }
                }

                // Zone 2 : saisons / épisodes
                if (root.d-zone == 2) {
                    if (event.text == Key.RightArrow) {
                        if (root.d-child < root.child-items.length - 1) {
                            root.d-child += 1;
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.LeftArrow) {
                        if (root.d-child > 0) {
                            root.d-child -= 1;
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.UpArrow) {
                        root.d-zone = root.detail.overview != "" ? 1 : 0;
                        return EventResult.accept;
                    }
                    if (event.text == Key.DownArrow) {
                        if (root.detail-rows.length > 0) {
                            root.d-x = root.detail-pick-down(root.d-child, root.child-items.length, root.child-card-w, 0);
                            root.d-zone = 4;
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.Return) {
                        root.open-item(root.child-items[root.d-child].id);
                        return EventResult.accept;
                    }
                }

                // Zones 4 et + : rangées du bas
                if (root.d-zone >= 4 && root.d-zone - 4 < root.detail-rows.length) {
                    if (event.text == Key.RightArrow) {
                        if (root.d-x < root.detail-rows[root.d-zone - 4].items.length - 1) {
                            root.d-x += 1;
                        }
                    } else if (event.text == Key.LeftArrow) {
                        if (root.d-x > 0) {
                            root.d-x -= 1;
                        }
                    } else if (event.text == Key.DownArrow) {
                        if (root.d-zone - 4 < root.detail-rows.length - 1) {
                            root.d-x = root.detail-pick-down(root.d-x, root.detail-rows[root.d-zone - 4].items.length, 140px * root.k, root.d-zone - 3);
                            root.d-zone += 1;
                        }
                    } else if (event.text == Key.UpArrow) {
                        if (root.d-zone > 4) {
                            root.d-x = root.detail-pick-down(root.d-x, root.detail-rows[root.d-zone - 4].items.length, 140px * root.k, root.d-zone - 5);
                            root.d-zone -= 1;
                        } else {
                            if (root.child-items.length > 0) {
                                root.d-child = root.row-pick(
                                    root.card-center(root.d-x, root.detail-rows[0].items.length, 140px * root.k, 18px * root.k, 32px * root.k, root.width) / 1px,
                                    root.width / 1px, root.child-items.length, root.child-card-w / 1px, 18 * root.k, 32 * root.k, 1002);
                            }
                            root.d-zone = root.child-items.length > 0 ? 2 : root.detail.overview != "" ? 1 : 0;
                        }
                    } else if (event.text == Key.Return) {
                        root.open-item(root.detail-rows[root.d-zone - 4].items[root.d-x].id);
                    }
                    return EventResult.accept;
                }

                // Zone 3 : bloc « À suivre »
                if (root.d-zone == 3) {
                    if (event.text == Key.LeftArrow) {
                        root.d-zone = 0;
                        return EventResult.accept;
                    }
                    if (event.text == Key.DownArrow) {
                        if (root.child-items.length > 0) {
                            root.d-zone = 2;
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.Return) {
                        root.open-item(root.detail.next-id);
                        return EventResult.accept;
                    }
                }
                return EventResult.reject;
            }
        }

        // Contenu qui défile (la barre de navigation reste en place).
        Rectangle {
            y: 0px - root.d-scroll;
            height: parent.height + root.d-scroll;
            animate y { duration: 180ms; easing: ease-out; }

        // Poster (portrait)
        Rectangle {
            x: 32px;
            y: 24px;
            width: root.poster-w;
            height: root.poster-w * 1.5;
            border-radius: Theme.radius;
            background: root.detail.has-poster ? transparent : @linear-gradient(130deg, #2b2142 0%, #10283a 100%);

            // Image déjà recadrée et arrondie (voir Card).
            if root.detail.has-poster: Image {
                width: parent.width;
                height: parent.height;
                source: root.detail.poster;
                image-fit: fill;
            }
        }

        // Logo, ou titre en texte à défaut
        Rectangle {
            x: root.col-x;
            y: 24px;
            width: root.info-w;
            height: 84px * root.k;

            if root.detail.has-logo: Image {
                x: 0px;
                width: min(parent.width, 420px * root.k);
                height: parent.height;
                source: root.detail.logo;
                image-fit: contain;
            }

            if !root.detail.has-logo && !root.detail.expect-logo: Marquee {
                width: parent.width;
                height: parent.height;
                text: root.detail.title;
                text-color: Theme.text;
                font-size: 34px * root.k;
                font-weight: 800;
                vertical-alignment: center;
                active: true;
                horizontal-alignment: TextHorizontalAlignment.left;
            }
        }

        Marquee {
            x: root.col-x;
            y: 24px + 88px * root.k;
            width: root.info-w;
            height: 24px * root.k;
            text: root.detail.subtitle;
            text-color: Theme.accent2;
            font-size: 18px * root.k;
            font-weight: 600;
            vertical-alignment: center;
            active: true;
            horizontal-alignment: TextHorizontalAlignment.left;
        }

        // Boutons : icônes (lecture, favori, vu, téléchargement)…
        HorizontalLayout {
            x: root.col-x;
            y: 24px + 118px * root.k;
            width: root.info-w;
            height: 40px * root.k;
            spacing: 10px * root.k;
            alignment: start;

            for b[i] in root.detail.buttons: DetailButton {
                visible: i < root.detail.icon-count;
                width: i < root.detail.icon-count ? self.height : 0px;
                text: b.label;
                icon: b.icon;
                active: b.active;
                k: root.k;
                focused: !root.h-focus && root.d-zone == 0 && root.d-button == i;
                clicked => {
                    root.d-zone = 0;
                    root.d-button = i;
                    root.run-action(b.action);
                }
            }
        }
        // … puis pastilles compactes (saison, série, langue audio, sous-titres).
        HorizontalLayout {
            // Les boutons à icône masqués comptent encore dans les espacements : on les compense.
            x: root.col-x - root.detail.icon-count * 8px * root.k;
            y: 24px + 166px * root.k;
            width: root.info-w;
            height: 30px * root.k;
            spacing: 8px * root.k;
            alignment: start;

            for b[i] in root.detail.buttons: DetailButton {
                visible: i >= root.detail.icon-count;
                width: i >= root.detail.icon-count ? self.preferred-width : 0px;
                chip: true;
                text: b.label;
                icon: "";
                k: root.k;
                focused: !root.h-focus && root.d-zone == 0 && root.d-button == i;
                clicked => {
                    root.d-zone = 0;
                    root.d-button = i;
                    root.run-action(b.action);
                }
            }
        }

        // Année · classification · durée · note
        Text {
            x: root.col-x;
            y: 24px + 202px * root.k;
            width: root.info-w;
            height: 24px * root.k;
            text: root.detail.misc;
            color: Theme.muted;
            font-size: 15px * root.k;
            vertical-alignment: center;
            overflow: elide;
        }

        // Résumé (bloc « verre » cliquable)
        if root.detail.overview != "": Rectangle {
            x: root.col-x;
            y: 24px + 232px * root.k;
            width: root.info-w;
            height: 80px * root.k;
            border-radius: 14px;
            background: !root.h-focus && root.d-zone == 1 ? #ffffff3d : #ffffff21;
            border-width: !root.h-focus && root.d-zone == 1 ? 2px : 0px;
            border-color: Theme.accent2;

            Text {
                x: 14px;
                y: 10px;
                width: parent.width - 28px;
                height: parent.height - 20px;
                text: root.detail.overview;
                wrap: word-wrap;
                overflow: elide;
                color: Theme.text;
                font-size: 15px * root.k;
            }

            TouchArea {
                clicked => {
                    root.d-zone = 1;
                    root.overview-open = true;
                }
            }
        }

        // Bloc « À suivre » (séries) : colonne resserrée à droite, comme .nextUpSection
        if root.detail.has-next: Rectangle {
            x: parent.width - 32px - root.next-w;
            y: 24px;
            width: root.next-w;
            height: 214px * root.k;

            Text {
                height: 20px * root.k;
                text: "À SUIVRE";
                color: Theme.muted;
                font-size: 12px * root.k;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                y: 24px * root.k;
                height: root.next-w * 0.5625;
                border-radius: Theme.radius;
                background: root.detail.has-next-image ? transparent : @linear-gradient(130deg, #2b2142 0%, #10283a 100%);

                // Image déjà recadrée et arrondie (voir Card).
                if root.detail.has-next-image: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.detail.next-image;
                    image-fit: fill;
                }

                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-radius: Theme.radius;
                    border-width: !root.h-focus && root.d-zone == 3 ? 3px : 0px;
                    border-color: Theme.accent2;
                }
            }

            Marquee {
                y: 24px * root.k + root.next-w * 0.5625 + 6px;
                height: 22px * root.k;
                text: root.detail.next-title;
                text-color: Theme.text;
                font-size: 14px * root.k;
                font-weight: 600;
                active: !root.h-focus && root.d-zone == 3;
                horizontal-alignment: TextHorizontalAlignment.left;
            }

            Marquee {
                y: 24px * root.k + root.next-w * 0.5625 + 6px + 22px * root.k;
                height: 18px * root.k;
                text: root.detail.next-subtitle;
                text-color: Theme.muted;
                font-size: 12px * root.k;
                active: !root.h-focus && root.d-zone == 3;
                horizontal-alignment: TextHorizontalAlignment.left;
            }

            TouchArea {
                clicked => {
                    root.d-zone = 3;
                    root.open-item(root.detail.next-id);
                }
            }
        }

        // Saisons / épisodes / contenu
        if root.child-items.length > 0: SectionRow {
            y: root.d-children-y;
            width: parent.width;
            height: root.child-card-w * root.child-ratio + 132px * root.k;
            title: root.detail.children-title;
            items: root.child-items;
            card-w: root.child-card-w;
            ratio: root.child-ratio;
            k: root.k;
            active: !root.h-focus && root.d-zone == 2;
            focus-index: root.d-child;
            activated(i) => {
                root.d-zone = 2;
                root.d-child = i;
                root.open-item(root.child-items[i].id);
            }
        }

        // Rangées du bas : casting, plus de ce genre, Seerr (similaires, recommandés)
        for row[ri] in root.detail-rows: SectionRow {
            y: root.d-extra-y + row.y-px * 1px;
            width: parent.width;
            height: row.h-px * 1px;
            title: row.title;
            items: row.items;
            card-w: 140px * root.k;
            ratio: 1.5;
            k: root.k;
            active: !root.h-focus && root.d-zone == 4 + ri;
            focus-index: root.d-x;
            activated(i) => {
                root.d-zone = 4 + ri;
                root.d-x = i;
                root.open-item(row.items[i].id);
            }
        }
        }

        // Choix des pistes (au premier plan)
        if root.tp-kind != "": Rectangle {
            background: #000000a6;
            TouchArea {
                clicked => {
                    root.tp-kind = "";
                }
            }
            Rectangle {
                width: 480px * root.k;
                height: 70px * root.k + root.tp-items.length * 44px * root.k;
                border-radius: 16px;
                background: Theme.glass;
                border-width: 1px;
                border-color: Theme.glass-border;
                TouchArea { }
                Text {
                    x: 24px * root.k;
                    y: 16px * root.k;
                    text: root.tp-kind == "audio" ? "Langue audio" : "Sous-titres";
                    color: Theme.text;
                    font-size: 20px * root.k;
                    font-weight: 700;
                }
                Text {
                    x: 24px * root.k;
                    y: 42px * root.k;
                    text: "Retenu pour toute la série";
                    color: Theme.muted;
                    font-size: 12px * root.k;
                }
                for t[i] in root.tp-items: Rectangle {
                    x: 12px * root.k;
                    y: 62px * root.k + i * 44px * root.k;
                    width: parent.width - 24px * root.k;
                    height: 40px * root.k;
                    border-radius: 10px * root.k;
                    background: (i == root.tp-sel || tp-area.has-hover)
                        ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : transparent;
                    if t.current: Rectangle {
                        x: 14px * root.k;
                        y: (parent.height - self.height) / 2;
                        width: 9px * root.k;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: white;
                    }
                    Text {
                        x: 34px * root.k;
                        width: parent.width - 44px * root.k;
                        height: parent.height;
                        text: t.label;
                        color: white;
                        font-size: 15px * root.k;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    tp-area := TouchArea {
                        clicked => {
                            root.track-pick(root.tp-kind, t.id, t.label);
                        }
                    }
                }
            }
        }

        // Panneau du résumé complet (toujours instancié, affiché à la demande)
        ov-panel := OverviewPanel {
            width: parent.width;
            height: parent.height;
            visible: root.overview-open;
            text: root.detail.overview;
            font: 20px * root.k;
            close => {
                root.overview-open = false;
                ov-panel.reset();
            }
        }
    }

    // ------------------------------------------------------------ Bibliothèque (grille)
    if root.screen == "library" && !root.playing: lib := Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        y: root.header-h + (1 - root.page-e) * 28px * root.k;
        height: parent.height - root.header-h;

        property <length> gap: 18px * root.k;
        property <length> pad: 32px * root.k;
        property <length> cw: root.card-w;
        property <length> ch: root.card-w * 1.5 + 56px * root.k;
        property <int> cols: max(1, floor((self.width - 2 * self.pad + self.gap) / (self.cw + self.gap)));
        property <int> rows: ceil(root.lib-items.length / self.cols);
        property <int> sel-row: floor(root.l-sel / self.cols);
        // Grille centrée horizontalement.
        property <length> left: (self.width - (self.cols * (self.cw + self.gap) - self.gap)) / 2;

        // Proche de la fin de ce qui est chargé : page suivante.
        function maybe-more() {
            if (root.l-sel >= root.lib-items.length - 2 * self.cols && root.lib-items.length < root.lib-total) {
                root.lib-more();
            }
        }

        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                self.focus();
            }
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.run-action("back");
                    return EventResult.accept;
                }
                if (root.lib-items.length == 0) {
                    if (event.text == Key.UpArrow) {
                        root.nav-enter();
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.RightArrow) {
                    root.l-sel = min(root.lib-items.length - 1, root.l-sel + 1);
                } else if (event.text == Key.LeftArrow) {
                    root.l-sel = max(0, root.l-sel - 1);
                } else if (event.text == Key.DownArrow) {
                    if (lib.sel-row < lib.rows - 1) {
                        root.l-sel = min(root.lib-items.length - 1, root.l-sel + lib.cols);
                    }
                } else if (event.text == Key.UpArrow) {
                    if (lib.sel-row > 0) {
                        root.l-sel -= lib.cols;
                    } else {
                        root.nav-enter();
                    }
                } else if (event.text == Key.Return) {
                    root.open-item(root.lib-items[root.l-sel].id);
                }
                lib.maybe-more();
                return EventResult.accept;
            }
        }

        if root.lib-items.length == 0: Text {
            text: root.lib-total == 0 ? "Chargement…" : "";
            color: Theme.muted;
            font-size: 20px * root.k;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            clip: true;

            Rectangle {
                // La rangée sélectionnée reste vers le milieu de l'écran.
                y: min(0px, parent.height / 2 - (12px * root.k + lib.sel-row * (lib.ch + lib.gap) + lib.ch / 2));
                animate y { duration: 180ms; easing: ease-out; }

                for card[i] in root.lib-items: Card {
                    x: lib.left + mod(i, lib.cols) * (lib.cw + lib.gap);
                    y: 12px * root.k + floor(i / lib.cols) * (lib.ch + lib.gap);
                    width: lib.cw;
                    height: lib.ch;
                    data: card;
                    ratio: 1.5;
                    k: root.k;
                    focused: !root.h-focus && i == root.l-sel;
                    clicked => {
                        root.h-focus = false;
                        root.l-sel = i;
                        root.open-item(card.id);
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Choix du serveur
    if root.screen == "servers" && !root.playing: srv := Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        y: root.header-h + (1 - root.page-e) * 28px * root.k;
        height: parent.height - root.header-h;

        property <int> n: root.servers.length;

        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                self.focus();
            }
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if (root.manual-open || root.choice-a != "") {
                    return EventResult.reject;
                }
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                // Serveurs trouvés, puis « Rechercher à nouveau » et « Saisir une adresse ».
                if (event.text == Key.UpArrow) {
                    if (root.srv-sel == 0) {
                        root.nav-enter();
                    } else if (root.srv-sel > srv.n) {
                        root.srv-sel = max(0, srv.n - 1);
                    } else {
                        root.srv-sel -= 1;
                    }
                } else if (event.text == Key.DownArrow) {
                    root.srv-sel = min(srv.n, root.srv-sel + 1);
                } else if (event.text == Key.LeftArrow && root.srv-sel == srv.n + 1) {
                    root.srv-sel = srv.n;
                } else if (event.text == Key.RightArrow && root.srv-sel == srv.n) {
                    root.srv-sel = srv.n + 1;
                } else if (event.text == Key.Return) {
                    if (root.srv-sel < srv.n) {
                        root.server-pick(root.srv-sel);
                    } else if (root.srv-sel == srv.n) {
                        root.servers-search();
                    } else {
                        root.manual-open = true;
                    }
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.go-home();
                }
                return EventResult.accept;
            }
        }

        VerticalLayout {
            alignment: start;
            padding-top: 8px * root.k;
            spacing: 14px * root.k;

            Text {
                text: "Choisir un serveur";
                color: Theme.text;
                font-size: 30px * root.k;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: root.srv-searching ? "Recherche sur le réseau local et Tailscale…"
                    : root.servers.length == 0 ? "Aucun serveur trouvé. Saisis son adresse."
                    : "Serveurs trouvés sur le réseau local et Tailscale";
                color: Theme.muted;
                font-size: 15px * root.k;
                horizontal-alignment: center;
            }

            for s[i] in root.servers: HorizontalLayout {
                alignment: center;
                height: 86px * root.k;

                Rectangle {
                    width: 620px * root.k;
                    border-radius: 14px * root.k;
                    background: i == root.srv-sel ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%)
                        : (srv-area.has-hover ? #ffffff26 : #ffffff14);

                    Text {
                        x: 22px * root.k;
                        y: 12px * root.k;
                        text: s.name + (s.version != "" ? "  ·  " + s.version : "");
                        color: white;
                        font-size: 19px * root.k;
                        font-weight: 700;
                    }
                    Text {
                        x: 22px * root.k;
                        y: 40px * root.k;
                        text: "Local : " + (s.local != "" ? s.local : "—");
                        color: #ffffffcc;
                        font-size: 13px * root.k;
                    }
                    Text {
                        x: 22px * root.k;
                        y: 60px * root.k;
                        text: "Distante : " + (s.remote != "" ? s.remote : "—");
                        color: #ffffffcc;
                        font-size: 13px * root.k;
                    }
                    srv-area := TouchArea {
                        clicked => {
                            root.srv-sel = i;
                            root.server-pick(i);
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 16px * root.k;
                height: 44px * root.k;

                ActionButton {
                    text: root.srv-searching ? "Recherche…" : "Rechercher à nouveau";
                    font: 16px * root.k;
                    focused: root.srv-sel == root.servers.length;
                    clicked => {
                        root.servers-search();
                    }
                }
                ActionButton {
                    text: "Saisir une adresse";
                    font: 16px * root.k;
                    focused: root.srv-sel == root.servers.length + 1;
                    clicked => {
                        root.manual-open = true;
                    }
                }
            }
        }

        // Saisie manuelle : deux adresses possibles pour le même serveur.
        if root.manual-open: Rectangle {
            background: #000000b3;

            TouchArea { }

            Rectangle {
                width: 600px * root.k;
                height: 360px * root.k;
                border-radius: 16px;
                background: Theme.glass;
                border-width: 1px;
                border-color: Theme.glass-border;

                VerticalLayout {
                    padding: 26px * root.k;
                    spacing: 10px * root.k;

                    Text {
                        text: "Adresse du serveur";
                        color: Theme.text;
                        font-size: 22px * root.k;
                        font-weight: 700;
                    }
                    Text {
                        text: "Sans « http:// » ni « https:// », les deux sont essayés.";
                        color: Theme.muted;
                        font-size: 13px * root.k;
                    }
                    Text {
                        text: "Réseau local";
                        color: Theme.text;
                        font-size: 14px * root.k;
                    }
                    local-in := LineEdit {
                        placeholder-text: "192.168.1.32:8097";
                        init => {
                            self.focus();
                        }
                        accepted => {
                            remote-in.focus();
                        }
                    }
                    Text {
                        text: "Adresse distante (Tailscale ou autre), facultative";
                        color: Theme.text;
                        font-size: 14px * root.k;
                    }
                    remote-in := LineEdit {
                        placeholder-text: "100.111.157.87:8097";
                        accepted => {
                            root.manual-submit(local-in.text, remote-in.text);
                        }
                    }
                    Text {
                        text: root.manual-busy ? "Vérification…" : root.manual-error;
                        color: root.manual-busy ? Theme.muted : #ff6b6b;
                        font-size: 13px * root.k;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 12px * root.k;
                        height: 40px * root.k;

                        ActionButton {
                            text: "Annuler";
                            font: 15px * root.k;
                            focused: false;
                            clicked => {
                                root.manual-open = false;
                                root.refocus += 1;
                            }
                        }
                        ActionButton {
                            text: "Valider";
                            font: 15px * root.k;
                            focused: true;
                            clicked => {
                                root.manual-submit(local-in.text, remote-in.text);
                            }
                        }
                    }
                }

                FocusScope {
                    width: 0px;
                    height: 0px;
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.manual-open = false;
                            root.refocus += 1;
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }
                }
            }
        }

        // http et https répondent tous deux : l'utilisateur choisit.
        if root.choice-a != "": Rectangle {
            background: #000000c0;

            TouchArea { }

            choice := Rectangle {
                width: 600px * root.k;
                height: 190px * root.k;
                border-radius: 16px;
                background: Theme.glass;
                border-width: 1px;
                border-color: Theme.glass-border;

                property <int> pick: 0;

                FocusScope {
                    init => {
                        self.focus();
                    }
                    key-pressed(event) => {
                        if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                            choice.pick = 0;
                        } else if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                            choice.pick = 1;
                        } else if (event.text == Key.Return) {
                            root.manual-choice(choice.pick == 0 ? root.choice-a : root.choice-b);
                        } else if (event.text == Key.Escape) {
                            root.manual-choice("");
                        }
                        return EventResult.accept;
                    }
                }

                VerticalLayout {
                    padding: 24px * root.k;
                    spacing: 18px * root.k;

                    Text {
                        text: "Deux adresses répondent. Laquelle utiliser ?";
                        color: Theme.text;
                        font-size: 18px * root.k;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 14px * root.k;
                        height: 44px * root.k;

                        ActionButton {
                            text: root.choice-a;
                            font: 15px * root.k;
                            focused: choice.pick == 0;
                            clicked => {
                                root.manual-choice(root.choice-a);
                            }
                        }
                        ActionButton {
                            text: root.choice-b;
                            font: 15px * root.k;
                            focused: choice.pick == 1;
                            clicked => {
                                root.manual-choice(root.choice-b);
                            }
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Téléchargements
    if root.screen == "downloads" && !root.playing: dls := Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        y: root.header-h + (1 - root.page-e) * 28px * root.k;
        height: parent.height - root.header-h;

        property <length> gap: 18px * root.k;
        property <float> ratio: root.dl-landscape ? 0.5625 : 1.5;
        property <length> cw: root.dl-landscape ? root.card-w * 1.6 : root.card-w;
        property <length> ch: self.cw * self.ratio + 56px * root.k;
        property <length> top: root.dl-status != "" ? 44px * root.k : 8px * root.k;
        // Bandeau d'infos de la carte sélectionnée, en bas.
        property <length> info-h: root.dl-items.length > 0 ? 132px * root.k : 0px;
        property <int> cols: max(1, floor((self.width - 64px * root.k + self.gap) / (self.cw + self.gap)));
        property <int> rows: ceil(root.dl-items.length / self.cols);
        property <int> sel-row: floor(root.dl-sel / self.cols);
        property <length> left: (self.width - (self.cols * (self.cw + self.gap) - self.gap)) / 2;

        function activate() {
            if (root.dl-sel < root.dl-folders.length && root.dl-folders[root.dl-sel]) {
                root.dl-open(root.dl-items[root.dl-sel].id);
            } else {
                root.dl-dsel = 0;
                root.dl-dialog = true;
            }
        }

        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                self.focus();
            }
            init => {
                self.focus();
            }
            key-pressed(event) => {
                // Fenêtre Lire / Supprimer / Annuler
                if (root.dl-dialog) {
                    if (event.text == Key.LeftArrow) {
                        root.dl-dsel = max(0, root.dl-dsel - 1);
                    } else if (event.text == Key.RightArrow) {
                        root.dl-dsel = min(2, root.dl-dsel + 1);
                    } else if (event.text == Key.Return) {
                        root.dl-dialog = false;
                        if (root.dl-dsel == 0) {
                            root.dl-play(root.dl-items[root.dl-sel].id);
                        } else if (root.dl-dsel == 1) {
                            root.dl-delete(root.dl-items[root.dl-sel].id);
                        }
                    } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                        root.dl-dialog = false;
                    }
                    return EventResult.accept;
                }
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    // Saison -> série -> liste générale -> accueil
                    if (root.dl-level > 0) {
                        root.run-action("back");
                    } else {
                        root.go-home();
                    }
                    return EventResult.accept;
                }
                if (root.dl-items.length == 0) {
                    if (event.text == Key.UpArrow) {
                        root.nav-enter();
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.RightArrow) {
                    root.dl-sel = min(root.dl-items.length - 1, root.dl-sel + 1);
                } else if (event.text == Key.LeftArrow) {
                    root.dl-sel = max(0, root.dl-sel - 1);
                } else if (event.text == Key.DownArrow) {
                    if (dls.sel-row < dls.rows - 1) {
                        root.dl-sel = min(root.dl-items.length - 1, root.dl-sel + dls.cols);
                    }
                } else if (event.text == Key.UpArrow) {
                    if (dls.sel-row > 0) {
                        root.dl-sel -= dls.cols;
                    } else {
                        root.nav-enter();
                    }
                } else if (event.text == Key.Return) {
                    dls.activate();
                }
                return EventResult.accept;
            }
        }

        if root.dl-status != "": Text {
            x: 32px * root.k;
            y: 4px * root.k;
            height: 32px * root.k;
            text: root.dl-status;
            color: Theme.accent2;
            font-size: 15px * root.k;
            font-weight: 600;
            vertical-alignment: center;
        }

        if root.dl-items.length == 0: Text {
            text: root.offline ? "Aucun téléchargement : rien à regarder hors ligne."
                : "Aucun téléchargement.\nSur la fiche d'un film ou d'une série, le bouton Télécharger permet de regarder hors ligne.";
            color: Theme.muted;
            font-size: 18px * root.k;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            y: dls.top;
            height: parent.height - dls.top - dls.info-h;
            clip: true;

            Rectangle {
                y: min(0px, parent.height / 2 - (12px * root.k + dls.sel-row * (dls.ch + dls.gap) + dls.ch / 2));
                animate y { duration: 180ms; easing: ease-out; }

                for card[i] in root.dl-items: Card {
                    x: dls.left + mod(i, dls.cols) * (dls.cw + dls.gap);
                    y: 12px * root.k + floor(i / dls.cols) * (dls.ch + dls.gap);
                    width: dls.cw;
                    height: dls.ch;
                    data: card;
                    ratio: dls.ratio;
                    k: root.k;
                    focused: !root.h-focus && i == root.dl-sel;
                    clicked => {
                        root.dl-sel = i;
                        dls.activate();
                    }
                }
            }
        }

        // Infos de la carte sélectionnée : titre, détails (année, durée, état, taille), résumé.
        if root.dl-sel < root.dl-infos.length: Rectangle {
            x: 32px * root.k;
            y: parent.height - dls.info-h;
            width: parent.width - 64px * root.k;
            height: dls.info-h - 16px * root.k;
            border-radius: 14px * root.k;
            background: #ffffff0d;
            border-width: 1px;
            border-color: #ffffff1a;

            VerticalLayout {
                padding: 14px * root.k;
                padding-left: 20px * root.k;
                padding-right: 20px * root.k;
                spacing: 4px * root.k;
                alignment: start;
                Marquee {
                    text: root.dl-infos[root.dl-sel].title;
                    text-color: Theme.text;
                    font-size: 18px * root.k;
                    font-weight: 700;
                    active: true;
                    horizontal-alignment: TextHorizontalAlignment.left;
                    height: self.preferred-height;
                }
                Text {
                    text: root.dl-infos[root.dl-sel].details;
                    color: Theme.accent2;
                    font-size: 14px * root.k;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.dl-infos[root.dl-sel].overview;
                    color: Theme.muted;
                    font-size: 14px * root.k;
                    wrap: word-wrap;
                    overflow: elide;
                    height: 40px * root.k;
                }
            }
        }

        if root.dl-dialog && root.dl-sel < root.dl-items.length: Rectangle {
            background: #000000b3;
            TouchArea {
                clicked => {
                    root.dl-dialog = false;
                }
            }
            Rectangle {
                width: 520px * root.k;
                height: 160px * root.k;
                border-radius: 16px;
                background: Theme.glass;
                border-width: 1px;
                border-color: Theme.glass-border;

                TouchArea { }

                VerticalLayout {
                    padding: 24px * root.k;
                    spacing: 20px * root.k;

                    Text {
                        text: root.dl-items[root.dl-sel].title;
                        color: Theme.text;
                        font-size: 19px * root.k;
                        font-weight: 700;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 14px * root.k;
                        height: 44px * root.k;

                        ActionButton {
                            text: "Lire";
                            font: 16px * root.k;
                            focused: root.dl-dsel == 0;
                            clicked => {
                                root.dl-dialog = false;
                                root.dl-play(root.dl-items[root.dl-sel].id);
                            }
                        }
                        ActionButton {
                            text: "Supprimer";
                            font: 16px * root.k;
                            focused: root.dl-dsel == 1;
                            clicked => {
                                root.dl-dialog = false;
                                root.dl-delete(root.dl-items[root.dl-sel].id);
                            }
                        }
                        ActionButton {
                            text: "Annuler";
                            font: 16px * root.k;
                            focused: root.dl-dsel == 2;
                            clicked => {
                                root.dl-dialog = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Paramètres
    if root.screen == "settings" && !root.playing: sets := Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        y: root.header-h + (1 - root.page-e) * 28px * root.k;
        height: parent.height - root.header-h;

        property <[string]> cats: ["Profil", "Lecture", "Réseau", "Affichage", "Compte"];
        property <length> left-w: 260px * root.k;
        property <length> av: 96px * root.k;
        property <int> av-cols: max(1, floor((self.width - self.left-w - 120px * root.k) / (self.av + 18px * root.k)));
        // Profil : les lignes sont les avatars ; autres catégories : les lignes de réglage.
        property <int> n: root.set-cat == 0 ? root.avatar-items.length : root.set-rows.length;

        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                self.focus();
            }
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    if (root.set-in) {
                        root.set-in = false;
                    } else {
                        root.go-home();
                    }
                    return EventResult.accept;
                }
                if (!root.set-in) {
                    // Colonne des catégories
                    if (event.text == Key.UpArrow) {
                        if (root.set-cat == 0) {
                            root.nav-enter();
                        } else {
                            root.set-cat -= 1;
                            root.settings-category();
                        }
                    } else if (event.text == Key.DownArrow) {
                        root.set-cat = min(sets.cats.length - 1, root.set-cat + 1);
                        root.settings-category();
                    } else if (event.text == Key.RightArrow || event.text == Key.Return) {
                        if (sets.n > 0) {
                            root.set-in = true;
                            root.set-sel = 0;
                        }
                    }
                    return EventResult.accept;
                }
                if (root.set-cat == 0) {
                    // Grille d'avatars
                    if (event.text == Key.RightArrow) {
                        root.set-sel = min(sets.n - 1, root.set-sel + 1);
                    } else if (event.text == Key.LeftArrow) {
                        if (mod(root.set-sel, sets.av-cols) == 0) {
                            root.set-in = false;
                        } else {
                            root.set-sel -= 1;
                        }
                    } else if (event.text == Key.DownArrow) {
                        root.set-sel = min(sets.n - 1, root.set-sel + sets.av-cols);
                    } else if (event.text == Key.UpArrow) {
                        root.set-sel = max(0, root.set-sel - sets.av-cols);
                    } else if (event.text == Key.Return) {
                        root.avatar-pick(root.avatar-items[root.set-sel].id);
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.UpArrow) {
                    root.set-sel = max(0, root.set-sel - 1);
                } else if (event.text == Key.DownArrow) {
                    root.set-sel = min(sets.n - 1, root.set-sel + 1);
                } else if (event.text == Key.LeftArrow) {
                    root.set-in = false;
                } else if (event.text == Key.Return) {
                    root.settings-activate(root.set-rows[root.set-sel].key);
                }
                return EventResult.accept;
            }
        }

        // Catégories
        for c[i] in sets.cats: Rectangle {
            x: 32px * root.k;
            y: 64px * root.k + i * 52px * root.k;
            width: sets.left-w - 32px * root.k;
            height: 46px * root.k;
            border-radius: 10px * root.k;
            background: (!root.set-in && !root.h-focus && i == root.set-cat) || cat-area.has-hover
                ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%)
                : i == root.set-cat ? #ffffff1f : transparent;
            Text {
                x: 18px * root.k;
                height: parent.height;
                text: c;
                color: white;
                font-size: 17px * root.k;
                font-weight: i == root.set-cat ? 700 : 500;
                vertical-alignment: center;
            }
            cat-area := TouchArea {
                clicked => {
                    root.set-cat = i;
                    root.set-in = false;
                    root.settings-category();
                }
            }
        }

        Text {
            x: 32px * root.k;
            y: 8px * root.k;
            height: 44px * root.k;
            text: "Paramètres";
            color: Theme.text;
            font-size: 28px * root.k;
            font-weight: 700;
            vertical-alignment: center;
        }

        // Panneau de droite
        Rectangle {
            x: sets.left-w + 32px * root.k;
            y: 64px * root.k;
            width: parent.width - self.x - 32px * root.k;
            height: parent.height - self.y - 24px * root.k;
            clip: true;

            // Profil : nom, avatar actuel, avatars proposés
            if root.set-cat == 0: Rectangle {
                Rectangle {
                    width: 72px * root.k;
                    height: self.width;
                    x: 0px;
                    y: 0px;
                    border-radius: self.width / 2;
                    background: #ffffff1f;
                    if root.has-avatar: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.avatar;
                        image-fit: fill;
                    }
                }
                Text {
                    x: 90px * root.k;
                    y: 8px * root.k;
                    text: root.user-name;
                    color: white;
                    font-size: 24px * root.k;
                    font-weight: 700;
                }
                Text {
                    x: 90px * root.k;
                    y: 42px * root.k;
                    text: root.has-getavatar ? "Choisis un avatar parmi ceux proposés par le serveur."
                        : "Aucun avatar proposé (plugin GetAvatar absent ou vide).";
                    color: Theme.muted;
                    font-size: 14px * root.k;
                }
                for a[i] in root.avatar-items: Rectangle {
                    x: mod(i, sets.av-cols) * (sets.av + 18px * root.k);
                    y: 100px * root.k + floor(i / sets.av-cols) * (sets.av + 40px * root.k);
                    width: sets.av;
                    height: sets.av + 30px * root.k;
                    Rectangle {
                        width: sets.av;
                        height: sets.av;
                        y: 0px;
                        border-radius: self.width / 2;
                        background: #ffffff14;
                        border-width: (root.set-in && i == root.set-sel) || av-area.has-hover ? 4px * root.k : 0px;
                        border-color: Theme.accent2;
                        if a.has-image: Image {
                            x: 6px * root.k;
                            y: 6px * root.k;
                            width: parent.width - 12px * root.k;
                            height: parent.height - 12px * root.k;
                            source: a.image;
                            image-fit: fill;
                        }
                    }
                    Marquee {
                        y: sets.av + 6px * root.k;
                        width: parent.width;
                        text: a.title;
                        text-color: Theme.muted;
                        font-size: 12px * root.k;
                        horizontal-alignment: center;
                        active: root.set-in && i == root.set-sel;
                        height: self.preferred-height;
                    }
                    av-area := TouchArea {
                        clicked => {
                            root.set-in = true;
                            root.set-sel = i;
                            root.avatar-pick(a.id);
                        }
                    }
                }
            }

            // Autres catégories : lignes de réglage
            if root.set-cat != 0: VerticalLayout {
                alignment: start;
                spacing: 10px * root.k;

                for r[i] in root.set-rows: Rectangle {
                    height: r.kind == "info" ? 30px * root.k : 60px * root.k;
                    border-radius: 12px * root.k;
                    property <bool> sel: root.set-in && i == root.set-sel;
                    background: r.kind == "info" ? transparent
                        : r.kind == "action" && (self.sel || row-area.has-hover) ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%)
                        : self.sel ? #ffffff2e : #ffffff12;
                    border-width: self.sel && r.kind != "action" ? 2px : 0px;
                    border-color: Theme.accent2;

                    Text {
                        x: 20px * root.k;
                        width: parent.width - 260px * root.k;
                        height: parent.height;
                        text: r.label;
                        color: r.kind == "info" ? Theme.muted : white;
                        font-size: (r.kind == "info" ? 13px : 16px) * root.k;
                        font-weight: r.kind == "action" ? 600 : 400;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    if r.kind == "choice": Text {
                        x: parent.width - 240px * root.k;
                        width: 220px * root.k;
                        height: parent.height;
                        text: "‹  " + r.value + "  ›";
                        color: Theme.accent2;
                        font-size: 16px * root.k;
                        font-weight: 600;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    if r.kind == "toggle": Rectangle {
                        x: parent.width - self.width - 20px * root.k;
                        y: (parent.height - self.height) / 2;
                        width: 56px * root.k;
                        height: 30px * root.k;
                        border-radius: self.height / 2;
                        background: r.on ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : #ffffff33;
                        Rectangle {
                            x: r.on ? parent.width - self.width - 4px * root.k : 4px * root.k;
                            width: 22px * root.k;
                            height: 22px * root.k;
                            border-radius: self.height / 2;
                            background: white;
                            animate x { duration: 120ms; }
                        }
                    }
                    row-area := TouchArea {
                        enabled: r.kind != "info";
                        clicked => {
                            root.set-in = true;
                            root.set-sel = i;
                            root.settings-activate(r.key);
                        }
                    }
                }
            }
        }
    }

    // Barre de navigation des écrans autres que l'accueil (l'accueil l'intègre à son en-tête).
    property <bool> bar-screen: root.screen == "detail" || root.screen == "library" || root.screen == "soon" || root.screen == "profile"
        || root.screen == "search" || root.screen == "party" || root.screen == "servers" || root.screen == "settings" || root.screen == "downloads";
    if root.bar-screen && !root.playing: NavBar {
        y: 0px;
        width: parent.width;
        k: root.k;
        can-back: root.can-back;
        show-home: true;
        enter: root.page-e;
        title-color: root.offline ? #4ade80 : Theme.text;
        title: root.screen == "library" ? root.lib-title : root.screen == "downloads" ? root.dl-title : root.screen == "search" ? "Recherche"
            : root.screen == "party" ? "Watch party" : "";
        sel: root.h-focus && root.h-sel < root.nav-n ? root.h-sel : -1;
        activate(i) => {
            root.nav-activate(i);
        }
    }
    if root.bar-screen && !root.playing: HeaderRight {
        x: parent.width / 2;
        y: 0px;
        width: parent.width / 2;
        height: root.header-h;
        k: root.k;
        sel: root.h-focus && root.h-sel >= root.right-base ? root.h-sel - root.right-base : -1;
        party-on: root.sp-active;
        has-avatar: root.has-avatar;
        avatar: root.avatar;
        clock: root.clock;
        offline: root.offline;
        activate(i) => {
            root.right-activate(i);
        }
    }

    // ------------------------------------------------------------ Menu latéral
    // Ouverture : le menu glisse vers la droite ; fermeture (ou choix) : il repart vers la gauche.
    property <float> menu-p: root.menu-open ? 1 : 0;
    animate menu-p { duration: 240ms; easing: ease-out; }
    if root.menu-p > 0.001 && !root.playing: Rectangle {
        background: #000000a6.transparentize(1 - root.menu-p);

        TouchArea {
            clicked => {
                if (root.menu-open) {
                    root.close-menu();
                }
            }
        }

        drawer := Rectangle {
            x: -(1 - root.menu-p) * (self.width + 8px);
            width: 340px * root.k;
            height: parent.height;
            background: #0b1520f5;
            border-width: 1px;
            border-color: Theme.glass-border;

            property <length> row-h: 40px * root.k;
            property <length> top: 84px * root.k;
            // Défilement si le menu dépasse l'écran (mode TV).
            property <length> scroll: max(0px, (root.menu-sel + 1) * self.row-h - (self.height - self.top - 16px * root.k));

            TouchArea { }

            FocusScope {
                init => {
                    self.focus();
                }
                // Rouvert pendant qu'il se refermait : le clavier revient au menu.
                property <bool> open: root.menu-open;
                changed open => {
                    if (self.open) {
                        self.focus();
                    }
                }
                key-pressed(event) => {
                    if (!root.menu-open) {
                        return EventResult.reject;
                    }
                    if (event.text == Key.UpArrow) {
                        root.menu-move(-1);
                    } else if (event.text == Key.DownArrow) {
                        root.menu-move(1);
                    } else if (event.text == Key.Return) {
                        root.close-menu();
                        root.menu-action(root.menu-entries[root.menu-sel].action);
                    } else if (event.text == Key.Escape || event.text == Key.Backspace || event.text == Key.LeftArrow) {
                        root.close-menu();
                    }
                    return EventResult.accept;
                }
            }

            Text {
                x: 28px * root.k;
                y: 0px;
                height: parent.top;
                text: "Turtlefin";
                color: Theme.accent2;
                font-size: 26px * root.k;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                y: parent.top;
                height: parent.height - parent.top;
                clip: true;

                for e[i] in root.menu-entries: Rectangle {
                    x: 14px * root.k;
                    y: i * drawer.row-h - drawer.scroll;
                    width: parent.width - 28px * root.k;
                    height: drawer.row-h - 4px * root.k;
                    border-radius: 10px * root.k;
                    background: !e.header && (i == root.menu-sel || row.has-hover)
                        ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : transparent;

                    if e.header && i > 0: Rectangle {
                        x: 4px * root.k;
                        y: 6px * root.k;
                        width: parent.width - 8px * root.k;
                        height: 1px;
                        background: #ffffff38;
                    }

                    Marquee {
                        x: (e.header ? 14px : 18px) * root.k;
                        width: parent.width - 28px * root.k;
                        text: e.header ? e.label.to-uppercase() : e.label;
                        text-color: e.header ? Theme.muted : white;
                        font-size: (e.header ? 12px : 17px) * root.k;
                        font-weight: e.header ? 700 : (i == root.menu-sel ? 600 : 500);
                        vertical-alignment: e.header ? TextVerticalAlignment.bottom : TextVerticalAlignment.center;
                        active: !e.header && i == root.menu-sel;
                        horizontal-alignment: TextHorizontalAlignment.left;
                        height: self.preferred-height;
                    }

                    row := TouchArea {
                        enabled: !e.header;
                        clicked => {
                            root.menu-sel = i;
                            root.close-menu();
                            root.menu-action(e.action);
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Page Seerr (premier plan)
    // Tout tient dans l'écran (pas de défilement) : tailles calculées sur la hauteur disponible.
    if root.sr-open && !root.playing: srp := Rectangle {
        transform-scale: 0.96 + 0.04 * root.page-e;
        background: #0b1220;

        property <length> u: min(self.height / 720px, self.width / 1280px) * 1px; // unité : 1 px sur un écran 1280x720
        property <length> pad: 40 * self.u;
        property <length> poster-h: 300 * self.u;

        TouchArea { }

        FocusScope {
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if (event.text == Key.LeftArrow) {
                    root.sr-sel = 0;
                } else if (event.text == Key.RightArrow) {
                    root.sr-sel = 1;
                } else if (event.text == Key.Return) {
                    if (root.sr-sel == 0 && (root.sr.can-request || root.sr.on-server)) {
                        root.seerr-action();
                    } else {
                        root.sr-open = false;
                        root.refocus += 1;
                    }
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.sr-open = false;
                    root.refocus += 1;
                }
                return EventResult.accept;
            }
        }

        // Fond : image du média floutée (préparée une fois), puis voile vers le bas.
        if root.sr.has-backdrop: Image {
            width: parent.width;
            height: parent.height;
            source: root.sr.backdrop;
            image-fit: cover;
        }
        Rectangle {
            background: @linear-gradient(180deg, #0b122066 0%, #0b1220d9 55%, #0b1220 100%);
        }

        if root.sr.loading: Text {
            text: "Chargement…";
            color: Theme.muted;
            font-size: 22 * srp.u;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if !root.sr.loading: Rectangle {
            // Affiche
            Rectangle {
                x: srp.pad;
                y: srp.pad;
                width: srp.poster-h / 1.5;
                height: srp.poster-h;
                border-radius: 12 * srp.u;
                background: root.sr.has-poster ? transparent : #ffffff14;
                if root.sr.has-poster: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.sr.poster;
                    image-fit: fill;
                }
            }

            // Titre, informations, état, boutons
            VerticalLayout {
                x: srp.pad + srp.poster-h / 1.5 + 32 * srp.u;
                y: srp.pad;
                width: parent.width - self.x - srp.pad;
                height: srp.poster-h;
                spacing: 12 * srp.u;
                alignment: center;

                Marquee {
                    text: root.sr.title + (root.sr.year != "" ? "  (" + root.sr.year + ")" : "");
                    text-color: white;
                    font-size: 38 * srp.u;
                    font-weight: 700;
                    active: true;
                    horizontal-alignment: TextHorizontalAlignment.left;
                    height: self.preferred-height;
                }
                Text {
                    text: root.sr.length + (root.sr.length != "" && root.sr.genres != "" ? "   ·   " : "") + root.sr.genres
                        + (root.sr.rating != "" ? "   ·   ★ " + root.sr.rating : "");
                    color: #ffffffd0;
                    font-size: 18 * srp.u;
                    overflow: elide;
                }
                // Informations clés en pastilles (statut, sortie, langue, studio)
                HorizontalLayout {
                    alignment: start;
                    spacing: 10 * srp.u;
                    height: 30 * srp.u;
                    for f in root.sr.facts: Rectangle {
                        border-radius: self.height / 2;
                        background: #ffffff1a;
                        width: fact-t.preferred-width + 24 * srp.u;
                        fact-t := Text {
                            text: f.label + " : " + f.value;
                            color: #ffffffe0;
                            font-size: 13 * srp.u;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.sr.status != "": Text {
                    text: root.sr.status;
                    color: Theme.accent2;
                    font-size: 18 * srp.u;
                    font-weight: 700;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 16 * srp.u;
                    height: 50 * srp.u;
                    if root.sr.can-request || root.sr.on-server: ActionButton {
                        text: root.sr.on-server ? "Voir sur le serveur" : "Demander";
                        font: 18 * srp.u;
                        focused: root.sr-sel == 0;
                        clicked => {
                            root.seerr-action();
                        }
                    }
                    ActionButton {
                        text: "Fermer";
                        font: 18 * srp.u;
                        focused: root.sr-sel == 1 || !(root.sr.can-request || root.sr.on-server);
                        clicked => {
                            root.sr-open = false;
                            root.refocus += 1;
                        }
                    }
                }
            }

            // Résumé (coupé proprement s'il est trop long)
            Text {
                x: srp.pad;
                y: srp.pad + srp.poster-h + 28 * srp.u;
                width: parent.width - 2 * srp.pad;
                height: 100 * srp.u;
                text: root.sr.overview;
                color: #ffffffd9;
                font-size: 17 * srp.u;
                wrap: word-wrap;
                overflow: elide;
            }

            // Distribution : photos rondes sur une ligne (autant qu'il en tient)
            Rectangle {
                x: srp.pad;
                y: min(parent.height - self.height - 16 * srp.u, srp.pad + srp.poster-h + 148 * srp.u);
                width: parent.width - 2 * srp.pad;
                height: 140 * srp.u;
                clip: true;
                for c[i] in root.sr-cast: Rectangle {
                    x: i * 118 * srp.u;
                    width: 104 * srp.u;
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 0px;
                        width: 84 * srp.u;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: #ffffff1a;
                        clip: false;
                        if c.has-image: Image {
                            width: parent.width;
                            height: parent.height;
                            source: c.image;
                            image-fit: fill;
                        }
                    }
                    Text {
                        y: 92 * srp.u;
                        width: parent.width;
                        text: c.title;
                        color: white;
                        font-size: 12 * srp.u;
                        font-weight: 600;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        y: 110 * srp.u;
                        width: parent.width;
                        text: c.subtitle;
                        color: Theme.muted;
                        font-size: 11 * srp.u;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Lecture
    if root.playing: PlayerView {
        width: parent.width;
        height: parent.height;
        k: root.k;
        frame: root.video-frame;
        ready: root.p-ready;
        title: root.p-title;
        subtitle: root.p-subtitle;
        paused: root.p-paused;
        progress: root.p-progress;
        pos-text: root.p-pos-text;
        dur-text: root.p-dur-text;
        end-text: root.p-end-text;
        chapters: root.p-chapters;
        chapter-count: root.p-chapter-count;
        has-prev: root.p-has-prev;
        has-next: root.p-has-next;
        audio-tracks: root.audio-tracks;
        audio-current: root.audio-current;
        sub-tracks: root.sub-tracks;
        sub-current: root.sub-current;
        episodes: root.p-episodes;
        ep-current: root.p-ep-current;
        up-mode: root.p-up-mode;
        up-title: root.p-up-title;
        up-sub: root.p-up-sub;
        up-image: root.p-up-image;
        has-up-image: root.p-has-up-image;
        picks: root.p-picks;
        up-button: root.p-up-button;
        skip-intro: root.p-skip-intro;
        bg: root.p-bg;
        has-bg: root.p-has-bg;
        party: root.sp-active ? root.sp-name : "";
        command(c) => {
            root.player-cmd(c);
        }
        toggle-fullscreen => {
            root.full-screen = !root.full-screen;
        }
    }

    // Chargement en cours : trait animé tout en haut de l'écran.
    if root.loading && !root.playing: Rectangle {
        y: 0px;
        height: 3px * root.k;
        Rectangle {
            x: (mod(animation-tick() / 1ms, 1100) / 1100) * (parent.width + self.width) - self.width;
            width: parent.width * 0.3;
            height: parent.height;
            background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
        }
    }

    // Message d'état : bulle en bas, au-dessus du contenu, effacée après 6 s.
    property <bool> toast-on;
    changed toast => {
        root.toast-on = root.toast != "";
    }
    Timer {
        interval: 6s;
        running: root.toast-on;
        triggered => {
            root.toast-on = false;
        }
    }
    if root.toast-on && root.screen != "login" && !root.playing: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px * root.k;
        width: min(parent.width - 64px * root.k, toast-text.preferred-width + 40px * root.k);
        height: toast-text.preferred-height + 20px * root.k;
        border-radius: 12px * root.k;
        background: #0b1620f2;
        border-width: 1px;
        border-color: Theme.glass-border;
        toast-text := Text {
            x: 20px * root.k;
            width: parent.width - 40px * root.k;
            text: root.toast;
            color: Theme.text;
            font-size: 15px * root.k;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
