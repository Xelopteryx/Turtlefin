export struct Section {
    title: string,
    items: [CardData],
    landscape: bool, // rangée de vignettes 16:9 (« Mes médias », « Reprendre »...)
    y-px: float,     // position verticale de la rangée, en pixels logiques (calculée en Rust)
    h-px: float,     // hauteur de la rangée, en pixels logiques
}

export struct ServerData {
    id: string,
    name: string,
    version: string,
    main: string,   // adresse principale, vide si inconnue
    backup: string, // adresse de secours (autre réseau, VPN...), vide si inconnue
}

export struct FactData {
    label: string,
    value: string,
}

export struct SeerrPage {
    loading: bool,
    title: string,
    year: string,
    overview: string,
    genres: string,
    length: string,
    rating: string,
    facts: [FactData],
    status: string,    // « Demande en attente »... vide si rien
    can-request: bool,
    on-server: bool,
    poster: image,
    has-poster: bool,
    backdrop: image,
    has-backdrop: bool,
}

export struct SettingRow {
    key: string,
    label: string,
    hint: string,  // aide sous le libellé
    value: string,
    kind: string, // "toggle" | "choice" | "action" | "info"
    on: bool,
}

// Appareil vers lequel diffuser : une appli Jellyfin du compte (télécommande) ou une télé DLNA.
export struct CastItem {
    id: string,    // "jf:<session>" · "dlna:<n>"
    name: string,
    sub: string,   // appli, titre en cours
    kind: string,  // "jf" · "dlna"
}

export struct MenuEntry {
    label: string,
    action: string, // "home" | "requests" | "lib:<id>" | "server" | "settings" | "logout" | "quit"
    header: bool,   // intitulé de groupe (non sélectionnable)
}

export struct ButtonData {
    label: string,  // vide pour un bouton à icône
    action: string, // "play" | "fav" | "played" | "download" | "open:<id>"
    icon: string,   // "play" | "heart" | "check" | "download" | ""
    active: bool,   // favori / vu
}

export struct DetailData {
    id: string,
    title: string,
    subtitle: string,
    misc: string,
    overview: string,
    expect-logo: bool,
    has-logo: bool,
    logo: image,
    has-poster: bool,
    poster: image,
    children-title: string,
    children-landscape: bool,
    has-next: bool,       // bloc « À suivre » (séries)
    next-id: string,
    next-title: string,
    next-subtitle: string,
    has-next-image: bool,
    next-image: image,
    buttons: [ButtonData],
    icon-count: int, // boutons à icône (ligne du haut), les autres sont des pastilles
    // Changement de fiche en douceur : ce qui est identique reste, le reste s'anime (voir detail-swap).
    poster-key: string,
    logo-key: string,
    icons-sig: string,
    chips-sig: string,
    children-sig: string,
}

// Défilement des rangées horizontales, calculé en Rust (chaque rangée garde le sien) :
// la rangée n'avance que quand la sélection atteint l'avant-dernière carte visible, et le passage
// d'une rangée à l'autre arrive sur la carte visuellement la plus proche.
// Clés : accueil = n° de rangée, recherche = 2000 + n°, fiche : enfants 1002, rangées 1004 + n°.
export global Rows {
    // Décalage (px, <= 0) de la rangée `key` pour que la carte `idx` (et sa voisine) soit visible.
    pure callback scroll(int /* key */, int /* idx */, int /* n */, float /* w */, float /* écart */, float /* marge */, float /* largeur */) -> float;
    // Carte de la rangée `to` la plus proche (à l'écran) de la carte `from-idx` de la rangée `from`.
    pure callback pick(int /* from */, int /* from-idx */, float /* from-w */, int /* to */, int /* to-n */, float /* to-w */, float /* écart */, float /* marge */, float /* largeur */) -> int;
    // Rangée lâchée après un glisser (doigt, souris) : son décalage devient celui-ci.
    callback set(int /* key */, float /* décalage */);
    // Incrémenté après `set` : les rangées recalculent leur décalage.
    in-out property <int> tick;
}

// Champ de saisie au style de l'appli : intitulé au-dessus, case de verre, contour d'accent quand
// il est choisi, rouge (avec message) en cas d'erreur. Bureau : saisie directe (TextInput) ;
// mode TV : le texte vient du clavier à l'écran (`shown`, curseur quand `editing`).
component Field inherits Rectangle {
    in property <float> k: 1.0;
    in property <string> label;
    in property <string> hint;                 // texte d'aide, quand le champ est vide
    in-out property <string> text;
    in property <string> shown;                // mode TV : texte affiché (points pour un mot de passe)
    in property <bool> password;
    in property <bool> tv;
    in property <bool> selected;               // mode TV : la sélection est sur ce champ
    in property <bool> editing;                // mode TV : le clavier à l'écran écrit ici
    in property <string> error;
    callback accepted();
    callback clicked();
    callback got-focus();                      // bureau : le champ prend le clavier (clic, Tab...)
    // Bureau : le champ prend le clavier, curseur au bout du texte.
    public function focus-input() {
        input.focus();
        input.set-selection-offsets(1000000, 1000000);
    }
    // Bureau : une touche tapée alors que le champ n'avait pas le clavier (clic à côté...) : il la
    // reçoit quand même, et reprend le clavier.
    public function type(t: string) {
        root.text = t == Key.Backspace ? Str.head(root.text, 1) : root.text + t;
        if (!root.tv) {
            root.focus-input();
        }
    }

    property <bool> lit: root.tv ? root.selected || root.editing : input.has-focus;
    property <length> cur-x: -1px;
    height: 22px * root.k + 52px * root.k + 22px * root.k;

    Text {
        x: 4px * root.k;
        y: 0px;
        width: parent.width - 8px * root.k;
        height: 22px * root.k;
        text: root.label;
        color: root.error != "" ? Theme.danger-text : root.lit ? Theme.fg : Theme.muted;
        font-size: 13px * root.k;
        font-weight: 600;
        vertical-alignment: center;
    }
    box := Rectangle {
        y: 22px * root.k;
        height: 52px * root.k;
        border-radius: 12px * root.k;
        background: root.lit ? Theme.fg.with-alpha(0.14) : Theme.fg.with-alpha(0.07);
        border-width: root.error != "" || root.lit ? 2px : 1px;
        border-color: root.error != "" ? Theme.danger : root.lit ? Theme.accent2 : Theme.fg.with-alpha(0.18);
        animate background, border-color { duration: Motion.select ? 160ms : 0ms; }

        // Texte tapé comme dans la recherche (lettres animées, curseur qui clignote, aide en fondu) :
        // clavier à l'écran en mode TV, champ classique au bureau (texte et curseur masqués, dessinés ici).
        TypedText {
            x: 18px * root.k;
            width: parent.width - 36px * root.k;
            height: parent.height;
            text: root.tv ? root.shown : root.password ? root.shown : root.text;
            placeholder: root.hint;
            cursor: root.tv ? root.editing : input.has-focus;
            cursor-x: root.tv || root.password ? -1px : root.cur-x;
            font-size: 18px * root.k;
            k: root.k;
        }
        input := TextInput {
            x: 18px * root.k;
            width: parent.width - 36px * root.k;
            height: parent.height;
            visible: !root.tv;
            enabled: !root.tv;
            text <=> root.text;
            input-type: root.password ? InputType.password : InputType.text;
            color: transparent;
            text-cursor-width: 0px;
            font-size: 18px * root.k;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: Theme.accent1.with-alpha(0.4);
            cursor-position-changed(pos) => {
                root.cur-x = pos.x;
            }
            accepted => {
                root.accepted();
            }
            changed has-focus => {
                // Bas du champ sans le décalage en cours (voir Kb) : le clavier virtuel le laissera visible.
                let bottom = root.absolute-position.y + root.height + Kb.lift;
                if (self.has-focus) {
                    Kb.field-bottom = bottom;
                    root.got-focus();
                } else if (Kb.field-bottom == bottom) {
                    Kb.field-bottom = 0;
                }
            }
        }
        if root.tv: TouchArea {
            clicked => {
                root.clicked();
            }
        }
    }
    if root.error != "": Text {
        x: 4px * root.k;
        y: 22px * root.k + 52px * root.k;
        width: parent.width - 8px * root.k;
        height: 22px * root.k;
        text: root.error;
        color: Theme.danger-text;
        font-size: 13px * root.k;
        vertical-alignment: center;
    }
}

// Message en bulle (connexion, saisie d'adresse) : verre sombre, rouge pour une erreur.
component Bubble inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    in property <float> k: 1.0;
    in property <length> max-w: 600px;
    width: min(root.max-w, msg.preferred-width + 44px * root.k);
    height: msg.preferred-height + 22px * root.k;
    border-radius: 14px * root.k;
    background: root.error ? #3a1418f2 : Theme.panel;
    border-width: 1px;
    border-color: root.error ? Theme.danger.with-alpha(0.5) : Theme.glass-border;
    msg := Text {
        x: 22px * root.k;
        width: parent.width - 44px * root.k;
        height: parent.height;
        text: root.text;
        color: root.error ? Theme.danger-text : Theme.text;
        font-size: 15px * root.k;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Image partagée entre une carte et la page qu'elle ouvre : à l'ouverture, la carte sélectionnée
// donne sa position et son image (voir AppWindow.open-hero).
global Hero {
    in-out property <int> tick;     // demande : la carte sélectionnée répond
    in-out property <int> seq;      // réponse de la carte (position et image ci-dessous)
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> w;
    in-out property <length> h;
    in-out property <image> img;
    in-out property <bool> wide;
    in-out property <CardData> data;   // la carte entière (pastilles, note)
    in-out property <float> k: 1.0;
    in-out property <string> hide-id;  // carte cachée pendant le vol (l'image partagée la remplace)
    in-out property <string> want-id;  // retour : la carte de cet élément répond (sinon la carte sélectionnée)
    in-out property <string> want-group; // retour : à défaut, la carte d'un autre épisode de la même série
}

// Image d'une carte avec ses pastilles (avancement, Seerr, épisodes restants / vu, statut, note).
// Utilisée par Card et par l'image partagée en vol (voir Hero).
component CardArt inherits Rectangle {
    in property <CardData> data;
    in property <float> k: 1.0;
    in property <bool> badges-only;     // sans image ni fond (image partagée en vol)

    border-top-left-radius: Theme.radius;
    border-top-right-radius: Theme.radius;
    background: transparent;
    // Affiche en attente (ou absente) : voir Placeholder. Elle reste dessous pendant le fondu.
    if root.img-a < 1 && !root.badges-only: Placeholder {
        // Vignette large : le titre est déjà écrit sous la carte.
        title: root.height > root.width ? root.data.title : "";
        k: root.k;
        border-top-left-radius: Theme.radius;
        border-top-right-radius: Theme.radius;
    }

    // Image arrivée après la carte : elle apparaît en fondu (déjà là à la création : tout de suite).
    property <float> img-a: root.data.has-image ? 1 : 0;
    animate img-a { duration: Motion.pages ? 380ms : 0ms; easing: ease-out; }
    if root.data.has-image && !root.badges-only: Image {
        width: parent.width;
        height: parent.height;
        source: root.data.image;
        image-fit: fill;
        opacity: parent.img-a;
    }

    // Avancement de la lecture (comme .itemProgressBar de JellySkin)
    if root.data.progress > 0: Rectangle {
        x: 14px * root.k;
        y: parent.height - 16px * root.k;
        width: parent.width - 28px * root.k - (root.data.rating != "" ? 50px * root.k : 0px);
        height: 5px * root.k;
        border-radius: self.height / 2;
        background: #ffffff4d;

        Rectangle {
            x: 0px;
            width: parent.width * root.data.progress;
            height: parent.height;
            border-radius: parent.height / 2;
            background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
        }
    }

    // Absent du serveur, proposé par Seerr : badge en haut à gauche.
    if root.data.seerr: Rectangle {
        x: 7px * root.k;
        y: 7px * root.k;
        width: 52px * root.k;
        height: 20px * root.k;
        border-radius: 5px * root.k;
        background: @linear-gradient(130deg, #6366f1 0%, #a855f7 100%);
        Text {
            text: "SEERR";
            color: white;
            font-size: 10px * root.k;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Coin en haut à droite, collé à l'angle de l'affiche : épisodes restant à voir (« +99 »
    // au-delà), sinon une coche si tout est vu.
    if root.data.count > 0 || root.data.played: Rectangle {
        x: parent.width - self.width;
        y: 0px;
        width: max(30px * root.k, cnt.preferred-width + 16px * root.k);
        height: 28px * root.k;
        border-top-right-radius: Theme.radius;
        border-bottom-left-radius: 9px * root.k;
        background: @linear-gradient(110deg, Theme.accent1 0%, Theme.accent2 100%);
        cnt := Text {
            text: root.data.count > 99 ? "+99" : root.data.count > 0 ? root.data.count : "";
            color: white;
            font-size: 14px * root.k;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.data.count == 0: Path {
            width: 14px * root.k;
            height: 14px * root.k;
            viewbox-width: 14;
            viewbox-height: 14;
            fill: transparent;
            stroke: white;
            stroke-width: 2.5px * root.k;
            commands: "M 2 7.5 L 5.5 11 L 12 3";
        }
    }

    // État d'une demande Seerr
    if root.data.status > 0: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 8px * root.k;
        width: st-row.preferred-width + 18px * root.k;
        height: 24px * root.k;
        border-radius: self.height / 2;
        background: root.data.status == 1 ? #d97706 : root.data.status == 2 ? #15803d
            : root.data.status == 3 ? #dc2626 : root.data.status == 4 ? #4ade80 : #7f1d1d;
        st-row := HorizontalLayout {
            alignment: center;
            spacing: 5px * root.k;
            padding-left: 9px * root.k;
            padding-right: 9px * root.k;
            Path {
                width: 12px * root.k;
                height: 12px * root.k;
                y: (24px * root.k - self.height) / 2;
                viewbox-width: 12;
                viewbox-height: 12;
                fill: transparent;
                stroke: root.data.status == 4 ? #052e16 : white;
                stroke-width: 2px * root.k;
                // en attente : sablier · acceptée / disponible : coche · refusée / échec : croix
                commands: root.data.status == 1 ? "M 2 1 L 10 1 L 2 11 L 10 11 Z"
                    : root.data.status == 2 || root.data.status == 4 ? "M 1.5 6.5 L 4.5 9.5 L 10.5 2.5"
                    : "M 2 2 L 10 10 M 10 2 L 2 10";
            }
            Text {
                text: root.data.status == 1 ? Tr.t(Tr.k, "En attente") : root.data.status == 2 ? Tr.t(Tr.k, "Acceptée")
                    : root.data.status == 3 ? Tr.t(Tr.k, "Refusée") : root.data.status == 4 ? Tr.t(Tr.k, "Disponible") : Tr.t(Tr.k, "Échec");
                color: root.data.status == 4 ? #052e16 : white;
                font-size: 11px * root.k;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    // Note de la communauté
    if root.data.rating != "" && Prefs.ratings: Rectangle {
        x: parent.width - self.width - 8px * root.k;
        y: parent.height - self.height - 7px * root.k;
        width: 44px * root.k;
        height: 18px * root.k;
        border-radius: 4px * root.k;
        background: #000000b3;

        HorizontalLayout {
            alignment: center;
            spacing: 3px * root.k;

            Text {
                text: "★";
                color: #f5c518;
                font-size: 11px * root.k;
                vertical-alignment: center;
            }
            Text {
                text: root.data.rating;
                color: white;
                font-size: 11px * root.k;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}

// Carte au style JellySkin : encadré translucide, image en haut (coins supérieurs arrondis
// intégrés à l'image au décodage), titre et sous-titre centrés dessous. Sélection : encadré plus
// sombre et carte légèrement agrandie (simple mise à l'échelle, sans image intermédiaire).
component Card inherits Rectangle {
    in property <CardData> data;
    in property <bool> focused;
    // Sélection montrée (au bureau : seulement après une touche de navigation, voir Nav) ; à la
    // souris, la carte survolée est mise en avant de la même façon.
    property <bool> lit: (Nav.kb ? (root.focused) : card-area.has-hover && !Nav.touch);
    in property <float> ratio: 1.5;
    in property <float> k: 1.0;
    callback clicked();
    callback touched();

    property <length> img-h: root.width * root.ratio;

    // Ouverture animée : la carte sélectionnée donne la place de son image (agrandie de 6 %).
    property <int> hero-tick: Hero.tick;
    changed hero-tick => {
        // Retour : la carte de l'élément quitté, ou (épisode « À suivre » passé au suivant, après « vu »)
        // celle de la même série ; son image peut encore être en chargement.
        if (Hero.want-id != "" ? root.data.id == Hero.want-id || (Hero.want-group != "" && root.data.group == Hero.want-group)
                : root.focused && root.data.has-image) {
            Hero.seq += 1;
            // absolute-position tient déjà compte de l'agrandissement de la carte (transform-scale,
            // centré) : c'est le coin de l'image telle qu'elle est dessinée. Taille : à l'échelle
            // actuelle (pas forcément 1,06 si la carte est encore en train de grossir).
            Hero.x = root.absolute-position.x;
            Hero.y = root.absolute-position.y;
            Hero.w = root.width * root.transform-scale;
            Hero.h = root.img-h * root.transform-scale;
            Hero.img = root.data.image;
            Hero.wide = root.ratio < 1;
            Hero.data = root.data;
            Hero.k = root.k;
        }
    }

    z: root.lit ? 1 : 0;
    transform-scale: root.lit ? 1.06 : 1.0;
    animate transform-scale { duration: Motion.select ? 220ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    border-radius: Theme.radius;
    // Windows 7 : corps en verre (clair en haut, plus sombre en bas), double liseré, et choisie :
    // teinte bleue lumineuse comme la sélection de l'Explorateur.
    background: Theme.win7 ? (root.lit
            ? @linear-gradient(180deg, rgba(150, 215, 255, 0.55) 0%, rgba(70, 160, 240, 0.45) 55%, rgba(30, 110, 210, 0.55) 100%)
            : @linear-gradient(180deg, rgba(255, 255, 255, 0.20) 0%, rgba(255, 255, 255, 0.08) 50%, rgba(0, 12, 34, 0.32) 100%))
        : root.lit ? Theme.card-focus : Theme.card;
    // Contour et lueur de la carte choisie, selon le thème (transparents par défaut).
    border-width: 1px;
    border-color: Theme.win7 ? rgba(0, 8, 26, 0.85) : Theme.card-border;
    drop-shadow-blur: Nav.no-shadow ? 0px : (root.lit ? (Theme.win7 ? 28px : 22px) * root.k : Theme.win7 ? 8px * root.k : 0px);
    drop-shadow-color: Theme.win7 ? (root.lit ? #6fd2ffd0 : #00000070) : Theme.glow;

    // Pas de cache-rendering-hint ici : quand la carte est réutilisée pour un autre élément (pages
    // des bibliothèques), Slint gardait l'ancienne image en cache (affiches mélangées).
    content := Rectangle {
    CardArt {
        y: 0px;
        height: root.img-h;
        data: root.data;
        k: root.k;
        // Pendant qu'elle vole (ouverture / retour), l'image partagée remplace celle-ci.
        visible: Hero.hide-id == "" || root.data.id != Hero.hide-id;
    }
    // Reflet en diagonale sur l'affiche, comme sur du verre (thèmes à `Theme.sheen`).
    if Theme.sheen > 0 && (Hero.hide-id == "" || root.data.id != Hero.hide-id): Sheen {
        height: root.img-h;
        r: Theme.radius;
        on: root.lit;
    }

    // Windows 7 : reflet brillant sur le haut de l'affiche, liseré clair intérieur, et choisie : cadre
    // bleu lumineux (double, comme la sélection de Windows 7).
    if Theme.win7 && (Hero.hide-id == "" || root.data.id != Hero.hide-id): Rectangle {
        y: 0px;
        height: root.img-h * 0.48;
        border-top-left-radius: Theme.radius;
        border-top-right-radius: Theme.radius;
        background: @linear-gradient(180deg, rgba(255, 255, 255, root.lit ? 0.30 : 0.20) 0%, rgba(255, 255, 255, 0.04) 100%);
    }
    if Theme.win7: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: Theme.radius - 1px;
        border-width: root.lit ? 2px * root.k : 1px;
        border-color: root.lit ? #9ee0ff : rgba(255, 255, 255, 0.42);
    }

    // Titre et sous-titre : défilent sur la carte sélectionnée s'ils sont trop longs.
    Marquee {
        x: 8px * root.k;
        // Sans sous-titre (bibliothèques), le titre est centré dans l'encadré.
        y: root.img-h + (root.data.subtitle == "" ? (parent.height - root.img-h - self.height) / 2 : 8px * root.k);
        width: parent.width - 16px * root.k;
        height: 22px * root.k;
        text: root.data.title;
        active: root.lit;
        text-color: Theme.text;
        font-size: 15px * root.k;
        font-weight: 500;
    }

    Marquee {
        x: 8px * root.k;
        y: root.img-h + 30px * root.k;
        width: parent.width - 16px * root.k;
        height: 18px * root.k;
        text: root.data.subtitle;
        active: root.lit;
        text-color: Theme.muted;
        font-size: 12px * root.k;
        font-weight: 400;
    }
    }

    card-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Rangée titrée de cartes, défilant horizontalement.
// Hauteur attendue : 132 px x k + hauteur d'image (titre 48, marges 10 + 18, texte 56).
component SectionRow inherits Rectangle {
    in property <string> title;
    in property <[CardData]> items;
    in property <length> card-w;
    in property <float> ratio: 1.5;
    in property <bool> active;
    in property <int> focus-index;
    in property <float> k: 1.0;
    in property <int> key;                  // voir Rows
    callback activated(int);
    callback touched(int);                  // carte touchée du doigt (sans l'ouvrir)

    property <length> gap: 18px * root.k;
    property <length> pad: 32px * root.k;
    property <length> title-h: 48px * root.k;
    property <length> text-h: 56px * root.k;
    // Chaque rangée garde son propre défilement quand elle n'est pas active.
    property <int> remembered: 0;
    property <int> idx: root.active ? root.focus-index : root.remembered;
    property <length> strip-w: root.items.length * (root.card-w + root.gap) + root.pad * 2;
    property <length> target-x: Rows.scroll(root.key, root.idx + 0 * Rows.tick, root.items.length, root.card-w / 1px, root.gap / 1px,
        root.pad / 1px, root.width / 1px) * 1px;
    // Défilement libre (doigt, molette horizontale) : la rangée est à ce décalage, indépendamment de
    // la sélection ; une sélection qui bouge dans la rangée (flèches) le reprend comme point de départ.
    property <bool> free;
    property <length> free-x;
    property <length> min-x: min(0px, root.width - root.strip-w);
    function unfree() {
        if (root.free) {
            Rows.set(root.key, root.free-x / 1px);
            Rows.tick += 1;
            root.free = false;
        }
    }

    changed focus-index => {
        if (root.active) {
            root.remembered = root.focus-index;
            root.unfree();
        }
    }

    // Titre précédé d'un trait (comme .sectionTitle:before de JellySkin)
    Rectangle {
        x: root.pad;
        y: root.title-h / 2 - 1px;
        width: 22px * root.k;
        height: 2px;
        background: Theme.fg;
    }

    Text {
        x: root.pad + 32px * root.k;
        y: 0px;
        height: root.title-h;
        text: root.title;
        color: Theme.fg;
        font-size: 22px * root.k;
        font-weight: 500;
        vertical-alignment: center;
    }

    Rectangle {
        y: root.title-h;
        height: root.height - root.title-h;
        clip: true;

        // Doigt, molette horizontale (ou Maj + molette) : la rangée défile librement, sans rien choisir.
        TouchArea {
            scroll-event(e) => {
                let d = e.modifiers.shift ? e.delta-y : e.delta-x;
                if (d == 0 || root.min-x >= 0px) {
                    return EventResult.reject;
                }
                let base = root.free ? root.free-x : root.target-x;
                root.free-x = clamp(base + d, root.min-x, 0px);
                root.free = true;
                return EventResult.accept;
            }
        }
        strip := Rectangle {
            x: root.free ? root.free-x : root.target-x;
            width: root.strip-w;
            animate x { duration: Motion.select && !Nav.drag ? 160ms : 0ms; easing: ease-out; }

            for card[i] in root.items: Card {
                // Hors de la rangée visible (avec une carte de marge) : sautée au dessin, rien ne change
                // à l'écran (une rangée peut compter des dizaines de cartes, parcourues à chaque image).
                visible: root.pad + i * (root.card-w + root.gap) + strip.x > -1.5 * root.card-w
                    && root.pad + i * (root.card-w + root.gap) + strip.x < root.width + 0.5 * root.card-w;
                x: root.pad + i * (root.card-w + root.gap);
                y: 10px * root.k;
                width: root.card-w;
                height: root.card-w * root.ratio + root.text-h;
                data: card;
                ratio: root.ratio;
                k: root.k;
                focused: root.active && i == root.focus-index;
                clicked => {
                    root.activated(i);
                }
                touched => {
                    root.touched(i);
                }
            }
        }
    }
}

// Onglet de l'en-tête : blanc et gras quand il est actif, souligné en dégradé quand il est sélectionné.
component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> focused;
    in property <float> k: 1.0;
    callback clicked();

    preferred-width: label.preferred-width + 8px * root.k;

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: (root.active || (Nav.kb ? (root.focused) : area.has-hover && !Nav.touch)) ? Theme.fg : Theme.fg.with-alpha(0.65);
        font-size: 18px * root.k;
        font-weight: root.active ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Soulignement qui s'étire depuis le centre à la sélection.
    Rectangle {
        property <float> w: (Nav.kb ? (root.focused) : area.has-hover && !Nav.touch) ? 1 : 0;
        animate w { duration: Motion.select ? 220ms : 0ms; easing: ease-out; }
        visible: self.w > 0.01;
        x: (parent.width - self.width) / 2;
        y: parent.height / 2 + 16px * root.k;
        width: parent.width * self.w;
        height: 3px * root.k;
        border-radius: self.height / 2;
        background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
    }

    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Icône ronde de l'en-tête (recherche, profil).
// Icônes du menu et des catégories des Paramètres : on s'y retrouve même dans une langue qu'on ne
// lit pas. Grille 24 x 24, tracées (aucune police d'icônes).
component NavIcon inherits Rectangle {
    in property <string> name;
    in property <color> tint: Theme.fg;
    if root.name == "home": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 12 3 L 21.5 11.5 L 19 11.5 L 19 20.5 L 14.5 20.5 L 14.5 15 L 9.5 15 L 9.5 20.5 L 5 20.5 L 5 11.5 L 2.5 11.5 Z";
