    if root.name == "requests": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.height / 11;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M 4 4 L 20 4 L 20 16 L 10 16 L 5 20 L 5 16 L 4 16 Z M 12 7 L 12 13 M 9 10 L 15 10";
