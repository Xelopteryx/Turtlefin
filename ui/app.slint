        fill: root.tint;
        fill-rule: evenodd;
        commands: "M 10.12 4.64 L 10.25 1.14 L 13.75 1.14 L 13.88 4.64 A 7.6 7.6 0 0 1 15.88 5.46 L 18.44 3.08 L 20.92 5.56 L 18.54 8.12 A 7.6 7.6 0 0 1 19.36 10.12 L 22.86 10.25 L 22.86 13.75 L 19.36 13.88 A 7.6 7.6 0 0 1 18.54 15.88 L 20.92 18.44 L 18.44 20.92 L 15.88 18.54 A 7.6 7.6 0 0 1 13.88 19.36 L 13.75 22.86 L 10.25 22.86 L 10.12 19.36 A 7.6 7.6 0 0 1 8.12 18.54 L 5.56 20.92 L 3.08 18.44 L 5.46 15.88 A 7.6 7.6 0 0 1 4.64 13.88 L 1.14 13.75 L 1.14 10.25 L 4.64 10.12 A 7.6 7.6 0 0 1 5.46 8.12 L 3.08 5.56 L 5.56 3.08 L 8.12 5.46 A 7.6 7.6 0 0 1 10.12 4.64 Z M 15.40 12 A 3.4 3.4 0 1 0 8.60 12 A 3.4 3.4 0 1 0 15.40 12 Z";
    }
    if root.name == "quit": Path {
