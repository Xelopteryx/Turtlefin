// Choix d'un filtre de la recherche avancée (genre, tag, studio).
export struct FilterOpt {
    name: string,
    on: bool,
}

export struct Section {
    title: string,
    items: [CardData],
    landscape: bool, // rangée de vignettes 16:9 (« Mes médias », « Reprendre »...)
    tiles: bool,     // tuiles sans légende (« Mes médias » : le nom est sur l'image)
    y-px: float,     // position verticale de la rangée, en pixels logiques (calculée en Rust)
    h-px: float,     // hauteur de la rangée, en pixels logiques
    leaving: bool,   // rangée qui s'en va (fiche suivante qui en a moins) : elle part en glissant
}

// Grande bannière en haut de l'accueil : le média à reprendre (ou à suivre, ou récent).
export struct Banner {
    id: string,
    title: string,
    subtitle: string,
    overview: string,
    play-label: string,
    progress: float,
    has-image: bool,
    image: image,
    has-logo: bool,
    logo: image,
}

export struct ServerData {
    id: string,
    name: string,
    version: string,
    main: string,   // adresse principale, vide si inconnue
    backup: string, // adresse de secours (autre réseau, VPN...), vide si inconnue
}

export struct FactData {
    label: string,
    value: string,
}

export struct SeerrPage {
    loading: bool,
    title: string,
    year: string,
    overview: string,
    genres: string,
    length: string,
    rating: string,
    facts: [FactData],
    status: string,    // « Demande en attente »... vide si rien
    state: int,        // état de la demande du compte (voir Theme.req-color), 0 : aucune
    can-request: bool,
    on-server: bool,
    poster: image,
    has-poster: bool,
    backdrop: image,
    has-backdrop: bool,
}

export struct SettingRow {
    key: string,
    label: string,
    hint: string,  // aide sous le libellé
    value: string,
    kind: string, // "toggle" | "choice" | "action" | "info" ; tableau de bord : "head" | "stats" | "session" | "bar" | "line"
    on: bool,
    img: int,      // affiche (dash-images), -1 : aucune
    progress: float, // barre d'avancement (bar)
    first: int,    // grille (« cards ») : première carte dans dash-cards
    count: int,    // et nombre de cartes
}

// Carte d'une grille du tableau de bord (comptes, extensions, lectures...).
export struct DashCard {
    key: string,   // ce que son activation fait (« line » : rien)
    title: string,
    sub: string,
    letter: string, // sans image : l'initiale du titre
    badge: string,
    alert: bool,   // pastille en couleur d'alerte
    img: int,      // image (dash-images), -1 : aucune
    round: bool,   // portrait rond (comptes, appareils) ; sinon image en largeur
    contain: bool, // logo : entier, sans être recadré
    progress: float,
}

// Appareil vers lequel diffuser : une appli Jellyfin du compte (télécommande) ou un Chromecast.
export struct CastItem {
    id: string,    // "jf:<session>" · "gcast:<n>"
    name: string,
    sub: string,   // appli, titre en cours
    kind: string,  // "jf" · "gcast"
}

export struct MenuEntry {
    label: string,
    action: string, // "home" | "requests" | "lib:<id>" | "server" | "settings" | "logout" | "quit"
    header: bool,   // intitulé de groupe (non sélectionnable)
}

export struct ButtonData {
    label: string,  // vide pour un bouton à icône
    action: string, // "play" | "fav" | "played" | "download" | "open:<id>"
    icon: string,   // "play" | "heart" | "check" | "download" | ""
    active: bool,   // favori / vu
}

export struct DetailData {
    id: string,
    title: string,
    subtitle: string,
    misc: string,
    misc-short: string,   // ligne d'infos quand les chiffres sont à part (langues audio)
    play-sub: string,     // série, saison : titre de l'épisode que lance le bouton Lecture
    play-progress: float, // son avancement (0..1) ; négatif : rien à montrer
    score: float,         // note sur 10 ; négative : aucune
    stat-time: string,    // durée
    stat-date: string,    // date de sortie
    stat-age: string,     // classification (« 10+ », « PG »)
    facts: [FactData],
    overview: string,
    expect-logo: bool,
    has-logo: bool,
    logo: image,
    has-poster: bool,
    poster: image,
    children-title: string,
    children-landscape: bool,
    has-next: bool,       // bloc « À suivre » (séries)
    next-id: string,
    next-title: string,
    next-subtitle: string,
    has-next-image: bool,
    next-image: image,
    buttons: [ButtonData],
    icon-count: int, // boutons à icône (ligne du haut), les autres sont des pastilles
    // Changement de fiche en douceur : ce qui est identique reste, le reste s'anime (voir detail-swap).
    poster-key: string,
    logo-key: string,
    icons-sig: string,
    chips-sig: string,
    children-sig: string,
}

// Défilement des rangées horizontales, calculé en Rust (chaque rangée garde le sien) :
// la rangée n'avance que quand la sélection atteint l'avant-dernière carte visible, et le passage
// d'une rangée à l'autre arrive sur la carte visuellement la plus proche.
// Clés : accueil = n° de rangée, recherche = 2000 + n°, fiche : enfants 1002, rangées 1004 + n°.
export global Rows {
    // Décalage (px, <= 0) de la rangée `key` pour que la carte `idx` (et sa voisine) soit visible.
    pure callback scroll(int /* key */, int /* idx */, int /* n */, float /* w */, float /* écart */, float /* marge */, float /* largeur */) -> float;
    // Carte de la rangée `to` la plus proche (à l'écran) de la carte `from-idx` de la rangée `from`.
    pure callback pick(int /* from */, int /* from-idx */, float /* from-w */, int /* to */, int /* to-n */, float /* to-w */, float /* écart */, float /* marge */, float /* largeur */) -> int;
    // Rangée lâchée après un glisser (doigt, souris) : son décalage devient celui-ci.
    callback set(int /* key */, float /* décalage */);
    // Incrémenté après `set` : les rangées recalculent leur décalage.
    in-out property <int> tick;
}

// Champ de saisie au style de l'appli : intitulé au-dessus, case de verre, contour d'accent quand
// il est choisi, rouge (avec message) en cas d'erreur. Bureau : saisie directe (TextInput) ;
// mode TV : le texte vient du clavier à l'écran (`shown`, curseur quand `editing`).
// Message d'une liste vide (« Aucun favori », « Aucun téléchargement »…) : centré sur un panneau
// discret (lisible sur n'importe quel décor : il tombait sur le capot du processeur du thème Nerd),
// et qui arrive en fondu en remontant un peu, au lieu de surgir.
component EmptyNote inherits Rectangle {
    in property <string> text;
    in property <float> k: 1.0;
    in property <length> font: 18px;
    property <float> a: 0;
    init => {
        self.a = 1;
    }
    animate a { duration: Motion.pages ? 320ms : 0ms; easing: ease-out; }
    visible: root.text != "";
    pill := Rectangle {
        property <length> max-w: min(root.width - 48px * root.k, 760px * root.k);
        width: min(self.max-w, note.preferred-width + 48px * root.k);
        height: note.preferred-height + 28px * root.k;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 + (1 - root.a) * 12px * root.k;
        opacity: root.a;
        border-radius: 14px * root.k;
        background: Theme.panel.with-alpha(0.82);
        border-width: 1px;
        border-color: Theme.glass-border;
        note := Text {
            x: 24px * root.k;
            width: parent.width - 48px * root.k;
            text: root.text;
            color: Theme.fg.with-alpha(0.82);
            font-size: root.font;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component Field inherits Rectangle {
    in property <float> k: 1.0;
    in property <string> label;
    in property <string> hint;                 // texte d'aide, quand le champ est vide
    in-out property <string> text;
    in property <string> shown;                // mode TV : texte affiché (points pour un mot de passe)
    in property <bool> password;
    in property <bool> tv;
    in property <bool> selected;               // mode TV : la sélection est sur ce champ
    in property <bool> editing;                // mode TV : le clavier à l'écran écrit ici
    in property <string> error;
    callback accepted();
    callback clicked();
    callback got-focus();                      // bureau : le champ prend le clavier (clic, Tab...)
    // Bureau : le champ prend le clavier, curseur au bout du texte.
    public function focus-input() {
        input.focus();
        input.set-selection-offsets(1000000, 1000000);
    }
    // Bureau : une touche tapée alors que le champ n'avait pas le clavier (clic à côté...) : il la
    // reçoit quand même, et reprend le clavier.
    public function type(t: string) {
        root.text = t == Key.Backspace ? Str.head(root.text, 1) : root.text + t;
        if (!root.tv) {
            root.focus-input();
        }
    }

    property <bool> lit: root.tv ? root.selected || root.editing : input.has-focus;
    property <length> cur-x: -1px;
    height: 22px * root.k + 52px * root.k + 22px * root.k;

    Text {
        x: 4px * root.k;
        y: 0px;
        width: parent.width - 8px * root.k;
        height: 22px * root.k;
        text: root.label;
        color: root.error != "" ? Theme.danger-text : root.lit ? Theme.fg : Theme.muted;
        font-size: (13px * root.k) * Theme.text-scale;
        font-weight: 600;
        vertical-alignment: center;
    }
    box := Rectangle {
        y: 22px * root.k;
        height: 52px * root.k;
        border-radius: 12px * root.k;
        background: root.lit ? Theme.fg.with-alpha(0.14) : Theme.fg.with-alpha(0.07);
        border-width: root.error != "" || root.lit ? 2px : 1px;
        border-color: root.error != "" ? Theme.danger : root.lit ? Theme.accent2 : Theme.fg.with-alpha(0.18);
        animate background, border-color { duration: Motion.select ? 160ms : 0ms; }

        // Texte tapé comme dans la recherche (lettres animées, curseur qui clignote, aide en fondu) :
        // clavier à l'écran en mode TV, champ classique au bureau (texte et curseur masqués, dessinés ici).
        TypedText {
            x: 18px * root.k;
            width: parent.width - 36px * root.k;
            height: parent.height;
            // Texte sélectionné : c'est le champ classique qui dessine (lettres et barre de sélection).
            opacity: input.anchor-position-byte-offset != input.cursor-position-byte-offset ? 0 : 1;
            text: root.tv ? root.shown : root.password ? root.shown : root.text;
            placeholder: root.hint;
            cursor: root.tv ? root.editing : input.has-focus;
            cursor-x: root.tv || root.password ? -1px : root.cur-x;
            font-size: (18px * root.k) * Theme.text-scale;
            k: root.k;
        }
        input := TextInput {
            x: 18px * root.k;
            width: parent.width - 36px * root.k;
            height: parent.height;
            visible: !root.tv;
            enabled: !root.tv;
            text <=> root.text;
            input-type: root.password ? InputType.password : InputType.text;
            color: self.anchor-position-byte-offset != self.cursor-position-byte-offset ? Theme.fg : transparent;
            text-cursor-width: 0px;
            font-size: (18px * root.k) * Theme.text-scale;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: Theme.accent2;
            selection-foreground-color: Theme.on-accent;
            cursor-position-changed(pos) => {
                root.cur-x = pos.x;
            }
            accepted => {
                root.accepted();
            }
            changed has-focus => {
                // Bas du champ sans le décalage en cours (voir Kb) : le clavier virtuel le laissera visible.
                let bottom = root.absolute-position.y + root.height + Kb.lift;
                if (self.has-focus) {
                    Kb.field-bottom = bottom;
                    root.got-focus();
                } else if (Kb.field-bottom == bottom) {
                    Kb.field-bottom = 0;
                }
            }
        }
        if root.tv: TouchArea {
            clicked => {
                root.clicked();
            }
        }
    }
    if root.error != "": Text {
        x: 4px * root.k;
        y: 22px * root.k + 52px * root.k;
        width: parent.width - 8px * root.k;
        height: 22px * root.k;
        text: root.error;
        color: Theme.danger-text;
        font-size: (13px * root.k) * Theme.text-scale;
        vertical-alignment: center;
    }
}

// Message en bulle (connexion, saisie d'adresse) : verre sombre, rouge pour une erreur.
component Bubble inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    in property <float> k: 1.0;
    in property <length> max-w: 600px;
    width: min(root.max-w, msg.preferred-width + 44px * root.k);
    height: msg.preferred-height + 22px * root.k;
    border-radius: 14px * root.k;
    background: root.error ? #3a1418f2 : Theme.panel;
    border-width: 1px;
    border-color: root.error ? Theme.danger.with-alpha(0.5) : Theme.glass-border;
    msg := Text {
        x: 22px * root.k;
        width: parent.width - 44px * root.k;
        height: parent.height;
        text: root.text;
        color: root.error ? Theme.danger-text : Theme.text;
        font-size: (15px * root.k) * Theme.text-scale;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Texte qui change (fiche -> fiche) : une barre fine balaie le texte de gauche à droite ; à sa gauche
// le nouveau texte, à sa droite ce qui reste de l'ancien. Le balayage ne parcourt que la largeur du
// plus long des deux (un texte court n'attend pas une barre qui traverse un bloc vide).
component Wipe inherits Rectangle {
    in property <string> from;
    in property <string> to;
    in property <float> p;               // avancement de la barre (0 à 1)
    in property <brush> ink;
    in property <length> font-size;
    in property <int> font-weight: 400;
    in property <bool> wrap;             // plusieurs lignes (résumé) : balayage sur toute la largeur
    in property <TextVerticalAlignment> valign: TextVerticalAlignment.center;
    clip: true;
    property <length> span: root.wrap ? root.width : min(root.width, max(m-from.preferred-width, m-to.preferred-width) + 4px);
    property <length> bx: root.span * root.p;
    m-from := Text { visible: false; text: root.from; font-size: root.font-size; font-weight: root.font-weight; }
    m-to := Text { visible: false; text: root.to; font-size: root.font-size; font-weight: root.font-weight; }
    // Nouveau texte, dévoilé à gauche de la barre.
    Rectangle {
        x: 0px;
        width: root.bx;
        clip: true;
        Text {
            x: 0px;
            width: root.width;
            height: root.height;
            text: root.to;
            color: root.ink;
            font-size: root.font-size;
            font-weight: root.font-weight;
            wrap: root.wrap ? TextWrap.word-wrap : TextWrap.no-wrap;
            overflow: elide;
            vertical-alignment: root.valign;
        }
    }
    // Ancien texte, effacé par la barre.
    Rectangle {
        x: root.bx;
        width: root.width - root.bx;
        clip: true;
        Text {
            x: -root.bx;
            width: root.width;
            height: root.height;
            text: root.from;
            color: root.ink;
            font-size: root.font-size;
            font-weight: root.font-weight;
            wrap: root.wrap ? TextWrap.word-wrap : TextWrap.no-wrap;
            overflow: elide;
            vertical-alignment: root.valign;
        }
    }
    if root.p > 0 && root.p < 1: Rectangle {
        x: root.bx - 1px;
        width: 2px;
        background: Theme.accent2;
    }
}

// Image partagée entre une carte et la page qu'elle ouvre : à l'ouverture, la carte sélectionnée
// donne sa position et son image (voir AppWindow.open-hero).
global Hero {
    in-out property <int> tick;     // demande : la carte sélectionnée répond
    in-out property <int> seq;      // réponse de la carte (position et image ci-dessous)
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> w;
    in-out property <length> h;
    in-out property <image> img;
    in-out property <bool> wide;
    in-out property <CardData> data;   // la carte entière (pastilles, note)
    in-out property <float> k: 1.0;
    in-out property <string> hide-id;  // carte cachée pendant le vol (l'image partagée la remplace)
    in-out property <string> want-id;  // retour : la carte de cet élément répond (sinon la carte sélectionnée)
    in-out property <string> want-group; // retour : à défaut, la carte d'un autre épisode de la même série
}

// Image d'une carte avec ses pastilles (avancement, Seerr, épisodes restants / vu, statut, note).
// Utilisée par Card et par l'image partagée en vol (voir Hero).
component CardArt inherits Rectangle {
    in property <CardData> data;
    in property <float> k: 1.0;
    in property <bool> badges-only;     // sans image ni fond (image partagée en vol)
    // Pastilles écrites (épisodes, état, note) : cachées pendant le vol de la carte (voir Card.moving).
    in property <float> badge-a: 1;

    border-top-left-radius: Theme.radius;
    border-top-right-radius: Theme.radius;
    background: transparent;
    // Affiche en attente (ou absente) : voir Placeholder. Elle reste dessous pendant le fondu.
    if root.img-a < 1 && !root.badges-only: Placeholder {
        // Vignette large : le titre est déjà écrit sous la carte.
        title: root.height > root.width ? root.data.title : "";
        k: root.k;
        border-top-left-radius: Theme.radius;
        border-top-right-radius: Theme.radius;
    }

    // Image arrivée après la carte : elle apparaît en fondu (déjà là à la création : tout de suite).
    property <float> img-a: root.data.has-image ? 1 : 0;
    animate img-a { duration: Motion.pages ? 380ms : 0ms; easing: ease-out; }
    if root.data.has-image && !root.badges-only: Image {
        width: parent.width;
        height: parent.height;
        source: root.data.image;
        image-fit: fill;
        opacity: parent.img-a;
    }

    // Avancement de la lecture (comme .itemProgressBar de JellySkin)
    if root.data.progress > 0: Rectangle {
        x: 14px * root.k;
        y: parent.height - 16px * root.k;
        width: parent.width - 28px * root.k - (root.data.rating != "" ? 50px * root.k : 0px);
        height: 5px * root.k;
        border-radius: self.height / 2;
        background: #ffffff4d;

        Rectangle {
            x: 0px;
            width: parent.width * root.data.progress;
            height: parent.height;
            border-radius: parent.height / 2;
            background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
        }
    }

    // Absent du serveur, proposé par Seerr : badge en haut à gauche.
    if root.data.seerr: Rectangle {
        opacity: root.badge-a;
        x: 7px * root.k;
        y: 7px * root.k;
        width: 52px * root.k;
        height: 20px * root.k;
        border-radius: 5px * root.k;
        background: @linear-gradient(130deg, #6366f1 0%, #a855f7 100%);
        Text {
            text: "SEERR";
            color: white;
            font-size: (10px * root.k) * Theme.text-scale;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Coin en haut à droite, collé à l'angle de l'affiche : épisodes restant à voir (« +99 »
    // au-delà), sinon une coche si tout est vu.
    if root.data.count > 0 || root.data.played: Rectangle {
        opacity: root.badge-a;
        x: parent.width - self.width;
        y: 0px;
        width: max(30px * root.k, cnt.preferred-width + 16px * root.k);
        height: 28px * root.k;
        border-top-right-radius: Theme.radius;
        border-bottom-left-radius: 9px * root.k;
        background: @linear-gradient(110deg, Theme.accent1 0%, Theme.accent2 100%);
        cnt := Text {
            text: root.data.count > 99 ? "+99" : root.data.count > 0 ? root.data.count : "";
            color: white;
            font-size: (14px * root.k) * Theme.text-scale;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.data.count == 0: Path {
            width: 14px * root.k;
            height: 14px * root.k;
            viewbox-width: 14;
            viewbox-height: 14;
            fill: transparent;
            stroke: white;
            stroke-width: 2.5px * root.k;
            commands: "M 2 7.5 L 5.5 11 L 12 3";
        }
    }

    // État d'une demande Seerr
    // Même couleur par état partout (Theme.req-color), matière propre au thème. Turtlefin : pastille unie.
    // Aero : plaque de verre bombée, reflet en haut. Nerd : étiquette de composant, sombre, trait et texte
    // en couleur d'afficheur.
    if root.data.status > 0 && root.data.status < 10: Rectangle {
        property <color> c: Theme.req-color(root.data.status);
        opacity: root.badge-a;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 8px * root.k;
        width: st-row.preferred-width + 18px * root.k;
        height: 24px * root.k;
        border-radius: Theme.term ? 2px * root.k : Theme.win7 ? 4px * root.k : self.height / 2;
        background: Theme.term ? #070b0ae6 : Theme.win7
            ? @linear-gradient(180deg, self.c.brighter(0.45) 0%, self.c.brighter(0.1) 47%, self.c.darker(0.18) 53%, self.c 100%)
            : self.c;
        border-width: Theme.term ? 1px : Theme.win7 ? 1px : 0px;
        border-color: Theme.term ? self.c : #ffffff80;
        st-row := HorizontalLayout {
            alignment: center;
            spacing: 5px * root.k;
            padding-left: 9px * root.k;
            padding-right: 9px * root.k;
            Path {
                width: 12px * root.k;
                height: 12px * root.k;
                y: (24px * root.k - self.height) / 2;
                viewbox-width: 12;
                viewbox-height: 12;
                fill: transparent;
                stroke: Theme.term ? Theme.req-color(root.data.status) : white;
                stroke-width: 2px * root.k;
                // en attente : sablier · acceptée / disponible : coche · refusée / échec : croix
                commands: root.data.status == 1 ? "M 2 1 L 10 1 L 2 11 L 10 11 Z"
                    : root.data.status == 2 || root.data.status == 4 ? "M 1.5 6.5 L 4.5 9.5 L 10.5 2.5"
                    : "M 2 2 L 10 10 M 10 2 L 2 10";
            }
            Text {
                text: root.data.status == 1 ? Tr.t(Tr.k, "En attente") : root.data.status == 2 ? Tr.t(Tr.k, "Acceptée")
                    : root.data.status == 3 ? Tr.t(Tr.k, "Refusée") : root.data.status == 4 ? Tr.t(Tr.k, "Disponible") : Tr.t(Tr.k, "Échec");
                color: Theme.term ? Theme.req-color(root.data.status) : white;
                font-size: (11px * root.k) * Theme.text-scale;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    // Note de la communauté
    if root.data.rating != "" && Prefs.ratings: Rectangle {
        opacity: root.badge-a;
        x: parent.width - self.width - 8px * root.k;
        y: parent.height - self.height - 7px * root.k;
        width: 44px * root.k;
        height: 18px * root.k;
        border-radius: 4px * root.k;
        background: #000000b3;

        HorizontalLayout {
            alignment: center;
            spacing: 3px * root.k;

            Text {
                text: "★";
                color: #f5c518;
                font-size: (11px * root.k) * Theme.text-scale;
                vertical-alignment: center;
            }
            Text {
                text: root.data.rating;
                color: white;
                font-size: (11px * root.k) * Theme.text-scale;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}

// Carte d'un groupe vide (demandes, À regarder) : chaque thème le dit à sa façon. Le code vient de
// `status`, négatif sur ces cartes (voir empty_tile, main.rs).
component EmptyTile inherits Rectangle {
    in property <int> code;
    in property <string> message;
    in property <float> k: 1.0;
    in property <bool> lit;
    border-radius: Theme.radius;
    clip: true;
    background: Theme.term ? #020d08e6
        : Theme.win7 ? @linear-gradient(180deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.05) 50%, rgba(0, 12, 34, 0.32) 100%)
        : Theme.fg.with-alpha(root.lit ? 0.09 : 0.05);
    border-width: 1px;
    border-color: root.lit ? Theme.accent2 : Theme.term ? Theme.accent2.with-alpha(0.35) : Theme.fg.with-alpha(0.16);
    VerticalLayout {
        padding: 12px * root.k;
        spacing: 8px * root.k;
        alignment: center;
        // Aero : la bulle d'information de Windows 7. Turtlefin : l'hexagone du logo.
        if Theme.win7: Rectangle {
            height: 30px * root.k;
            Rectangle {
                width: 30px * root.k;
                height: self.width;
                border-radius: self.width / 2;
                background: @linear-gradient(180deg, #8fd8ff 0%, #2f95e6 55%, #1670c8 100%);
                border-width: 1px;
                border-color: #ffffff80;
                Text {
                    text: "i";
                    color: white;
                    font-size: (19px * root.k) * Theme.text-scale;
                    font-weight: 700;
                }
            }
        }
        if !Theme.win7 && !Theme.term: Rectangle {
            height: 34px * root.k;
            Path {
                width: 34px * root.k;
                height: 34px * root.k;
                viewbox-width: 24;
                viewbox-height: 24;
                fill: transparent;
                stroke: Theme.accent2.with-alpha(0.7);
                stroke-width: 1.5px;
                stroke-line-join: round;
                commands: "M 12 2 L 21 7 L 21 17 L 12 22 L 3 17 L 3 7 Z";
            }
        }
        Text {
            text: Theme.term ? "Error " + root.code : Theme.win7 ? Tr.t(Tr.k, "Ce dossier est vide.") : Tr.t(Tr.k, "Rien par ici");
            color: Theme.term ? Theme.accent2 : Theme.fg;
            font-size: ((Theme.term ? 20px : 15px) * root.k) * Theme.text-scale;
            font-weight: 700;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: root.message;
            color: Theme.muted;
            font-size: (12px * root.k) * Theme.text-scale;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// Carte au style JellySkin : encadré translucide, image en haut (coins supérieurs arrondis
// intégrés à l'image au décodage), titre et sous-titre centrés dessous. Sélection : encadré plus
// sombre et carte légèrement agrandie (simple mise à l'échelle, sans image intermédiaire).
component Card inherits Rectangle {
    in property <CardData> data;
    in property <bool> focused;
    // Arrivée (rangées des fiches) : chaque carte à son tour (`in-delay`), en fondu en remontant un peu.
    in property <bool> cascade;
    in property <duration> in-delay;
    property <duration> in-t0;
    property <bool> in-live: root.cascade;
    init => {
        self.in-t0 = animation-tick();
    }
    Timer {
        interval: root.in-delay + 500ms;
        running: root.in-live;
        triggered => {
            root.in-live = false;
        }
    }
    property <float> ap-x: root.in-live && Motion.pages ? clamp((animation-tick() - root.in-t0 - root.in-delay) / 380ms, 0, 1) : 1;
    property <float> ap: 1 - (1 - root.ap-x) * (1 - root.ap-x);
    opacity: root.in-live ? root.ap : 1;
    // Autre média à cette place (rangée mise à jour) : la carte se retourne (l'ancien jusqu'à la
    // moitié du tour, le nouveau ensuite), une fois la nouvelle image chargée (0,8 s au plus).
    property <CardData> prev;
    property <CardData> old;
    property <bool> flip-pend;
    property <bool> flip-on;
    property <duration> flip-t0;
    changed data => {
        if (root.data.id != root.prev.id && root.prev.id != "" && Motion.select) {
            root.old = root.prev;
            root.flip-pend = true;
            root.flip-on = false;
            // Départ commun à la rangée (le moment du changement) : chacune à son tour (in-delay),
            // même si les images arrivent dans le désordre.
            root.flip-base = animation-tick();
        }
        root.prev = root.data;
    }
    property <duration> flip-base;
    property <bool> flip-go: root.flip-pend && (root.data.has-image || root.flip-waited);
    property <bool> flip-waited;
    Timer {
        interval: 800ms;
        running: root.flip-pend && !root.flip-waited;
        triggered => {
            root.flip-waited = true;
        }
    }
    changed flip-go => {
        if (root.flip-go) {
            root.flip-pend = false;
            root.flip-waited = false;
            root.flip-t0 = max(animation-tick(), root.flip-base + root.in-delay * 1.5);
            root.flip-on = true;
        }
    }
    Timer {
        interval: root.in-delay * 1.5 + 460ms;
        running: root.flip-on;
        triggered => {
            root.flip-on = false;
        }
    }
    property <float> fq: root.flip-on ? clamp((animation-tick() - root.flip-t0) / 420ms, 0, 1) : 1;
    // La carte attend son tour : elle montre encore l'ancien média, à plat.
    // Ce que montre la carte : l'ancien média tant qu'elle n'a pas fait la moitié du tour.
    property <CardData> shown: root.flip-pend || (root.flip-on && root.fq < 0.5) ? root.old : root.data;
    // Sélection montrée (au bureau : seulement après une touche de navigation, voir Nav) ; à la
    // souris, la carte survolée est mise en avant de la même façon.
    property <bool> lit: (Nav.kb ? (root.focused) : card-area.has-hover && !Nav.touch);
    in property <float> ratio: 1.5;
    in property <float> k: 1.0;
    callback clicked();
    callback touched();
    // Tuile sans légende : l'image occupe toute la carte (son nom n'apparaît qu'à la sélection).
    in property <bool> bare;
    // Une voisine est sélectionnée : celle-ci s'efface un peu.
    in property <bool> dim;
    callback lit-changed(bool);
    changed lit => {
        root.lit-changed(root.lit);
    }
    property <float> dim-a: root.dim ? 1 : 0;
    animate dim-a { duration: Motion.select ? 220ms : 0ms; easing: ease-out; }
    // Résumé sur l'image de la carte sélectionnée, après un instant (pas à chaque carte traversée).
    property <float> info-a: root.lit ? 1 : 0;
    animate info-a { duration: Motion.select ? 220ms : 0ms; delay: Motion.select ? 500ms : 0ms; easing: ease-out; }

    property <length> img-h: root.width * root.ratio;

    // Ouverture animée : la carte sélectionnée donne la place de son image (agrandie de 6 %).
    property <int> hero-tick: Hero.tick;
    changed hero-tick => {
        // Retour : la carte de l'élément quitté, ou (épisode « À suivre » passé au suivant, après « vu »)
        // celle de la même série ; son image peut encore être en chargement.
        if (Hero.want-id != "" ? root.data.id == Hero.want-id || (Hero.want-group != "" && root.data.group == Hero.want-group)
                : root.focused) {
            Hero.seq += 1;
            // absolute-position tient déjà compte de l'agrandissement de la carte (transform-scale,
            // centré) : c'est le coin de l'image telle qu'elle est dessinée. Taille : à l'échelle
            // actuelle (pas forcément 1,06 si la carte est encore en train de grossir).
            Hero.x = root.absolute-position.x;
            Hero.y = root.absolute-position.y;
            Hero.w = root.width * root.transform-scale;
            Hero.h = root.img-h * root.transform-scale;
            Hero.img = root.data.image;
            Hero.wide = root.ratio < 1;
            Hero.data = root.data;
            Hero.k = root.k;
        }
    }

    z: root.lit ? 1 : 0;
    // Zoom de la carte choisie (animé), multiplié par une échelle imposée de l'extérieur (distribution
    // d'une bibliothèque, non animée : elle change à chaque image).
    in property <float> extra-scale: 1;
    // Carte en vol (distribuée, ramassée) : tournée ou à une autre échelle, le moteur dessine ses
    // lettres plus épaisses et floues. Les textes sont cachés pendant le vol, puis apparaissent
    // en fondu une fois la carte posée (de même pendant un retournement).
    in property <bool> moving;
    property <float> text-a: root.moving || root.flip-pend || root.flip-on ? 0 : 1;
    animate text-a { duration: Motion.select ? 220ms : 0ms; easing: ease-out; }
    property <color> req-corner: Theme.req-color(root.shown.status - 10);
    property <float> lit-s: root.lit ? 1.08 : 1.0;
    animate lit-s { duration: Motion.select ? 220ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    transform-scale: root.lit-s * root.extra-scale;
    border-radius: Theme.radius;
    // Windows 7 : corps en verre (clair en haut, plus sombre en bas), double liseré, et choisie :
    // teinte bleue lumineuse comme la sélection de l'Explorateur.
    background: Theme.win7 ? (root.lit
            ? @linear-gradient(180deg, rgba(150, 215, 255, 0.55) 0%, rgba(70, 160, 240, 0.45) 55%, rgba(30, 110, 210, 0.55) 100%)
            : @linear-gradient(180deg, rgba(255, 255, 255, 0.20) 0%, rgba(255, 255, 255, 0.08) 50%, rgba(0, 12, 34, 0.32) 100%))
        : root.lit ? Theme.card-focus : Theme.card;
    // Contour au bord exact de la carte (Windows 7 : clair, bleu lumineux si choisie). Pas de halo
    // autour de la carte choisie : seulement une ombre discrète sous les cartes en verre.
    border-width: Theme.win7 || Theme.term ? 0px : 1px;
    border-color: root.bare && root.lit ? Theme.accent2 : Theme.card-border;
    // Windows 7 : ombre discrète.
    drop-shadow-blur: Nav.no-shadow ? 0px : Theme.win7 ? 8px * root.k : 0px;
    drop-shadow-color: #00000070;

    // Pas de cache-rendering-hint ici : quand la carte est réutilisée pour un autre élément (pages
    // des bibliothèques), Slint gardait l'ancienne image en cache (affiches mélangées).
    content := Rectangle {
    opacity: root.ap;
    y: (1 - root.ap) * 24px * root.k;
    // Tuile : l'image, arrondie seulement en haut au décodage, suit tous les coins de la carte.
    clip: root.bare;
    border-radius: root.bare ? Theme.radius : 0px;
    // Retournement : la carte s'amincit jusqu'à la tranche, puis se rouvre sur l'autre média.
    transform-scale-x: (root.flip-on ? max(0.02, abs(cos(root.fq * 180deg))) : 1) * 100%;
    CardArt {
        y: 0px;
        height: root.img-h;
        data: root.shown;
        k: root.k;
        badge-a: root.text-a;
        // Pendant qu'elle vole (ouverture / retour), l'image partagée remplace celle-ci.
        visible: (Hero.hide-id == "" || root.data.id != Hero.hide-id) && root.shown.status >= 0;
    }
    // Reflet en diagonale sur l'affiche, comme sur du verre (thèmes à `Theme.sheen`).
    if root.shown.status < 0: EmptyTile {
        height: root.img-h;
        code: -root.shown.status;
        message: root.shown.subtitle;
        k: root.k;
        lit: root.lit;
    }
    if Theme.sheen > 0 && root.shown.status >= 0 && (Hero.hide-id == "" || root.data.id != Hero.hide-id): Sheen {
        height: root.img-h;
        r: Theme.radius;
        on: root.lit;
    }

    // Windows 7 : reflet brillant sur le haut de l'affiche, liseré clair intérieur, et choisie : cadre
    // bleu lumineux (double, comme la sélection de Windows 7).
    if Theme.win7 && root.shown.status >= 0 && (Hero.hide-id == "" || root.data.id != Hero.hide-id): Rectangle {
        y: 0px;
        height: root.img-h * 0.48;
        border-top-left-radius: Theme.radius;
        border-top-right-radius: Theme.radius;
        background: @linear-gradient(180deg, rgba(255, 255, 255, root.lit ? 0.30 : 0.20) 0%, rgba(255, 255, 255, 0.04) 100%);
    }
    // Résumé de la carte sélectionnée, sur le bas de l'image.
    if root.lit && root.shown.overview != "" && Prefs.card-info && !Nav.touch: Rectangle {
        property <length> h: min(root.img-h, 92px * root.k);
        y: root.img-h - self.h;
        height: self.h;
        opacity: root.info-a;
        background: @linear-gradient(180deg, #00000000 0%, #000000d9 42%, #000000f0 100%);
        Text {
            x: 10px * root.k;
            y: 26px * root.k;
            width: parent.width - 20px * root.k;
            height: parent.height - self.y - 6px * root.k;
            text: root.shown.overview;
            color: white;
            font-size: (11px * root.k) * Theme.text-scale;
            wrap: word-wrap;
            overflow: elide;
        }
    }
    // Tuile : le nom, s'il n'y a pas d'image pour le porter ; carte de groupe : son nom et son nombre.
    if root.bare && root.shown.status >= 0 && (!root.shown.has-image || root.shown.subtitle != ""): ov := Rectangle {
        property <bool> two: root.shown.subtitle != "";
        y: parent.height - self.height;
        height: (self.two ? 74px : 40px) * root.k;
        background: @linear-gradient(180deg, #00000000 0%, #000000c8 30%, #000000f0 100%);
        Text {
            y: ov.two ? 20px * root.k : 0px;
            width: parent.width;
            height: ov.two ? 26px * root.k : parent.height;
            text: root.shown.title;
            color: white;
            font-size: ((ov.two ? 17px : 15px) * root.k) * Theme.text-scale;
            font-weight: ov.two ? 700 : 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        if ov.two: Text {
            y: 46px * root.k;
            width: parent.width;
            height: 20px * root.k;
            text: root.shown.subtitle;
            color: #ffffffd0;
            font-size: (12px * root.k) * Theme.text-scale;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // Titre et sous-titre : défilent sur la carte sélectionnée s'ils sont trop longs.
    if !root.bare: Marquee {
        x: 8px * root.k;
        // Sans sous-titre (bibliothèques), le titre est centré dans l'encadré.
        y: root.img-h + (root.data.subtitle == "" ? (parent.height - root.img-h - self.height) / 2 : 8px * root.k);
        width: parent.width - 16px * root.k;
        height: 22px * root.k;
        text: root.shown.title;
        active: root.lit;
        opacity: root.text-a;
        text-color: Theme.text;
        font-size: (15px * root.k) * Theme.text-scale;
        font-weight: 500;
    }

    if !root.bare: Marquee {
        x: 8px * root.k;
        y: root.img-h + 30px * root.k;
        width: parent.width - 16px * root.k;
        height: 18px * root.k;
        text: root.shown.subtitle;
        active: root.lit;
        opacity: root.text-a;
        text-color: Theme.muted;
        font-size: (12px * root.k) * Theme.text-scale;
        font-weight: 400;
    }
    }
    // Nerd : trait fin tout autour ; choisie, il s'allume et des équerres marquent les quatre coins
    // (comme un viseur), par-dessus l'affiche.
    if Theme.term: Rectangle {
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: root.lit ? Theme.accent2 : Theme.card-border;
        if root.lit: Path {
            property <float> w: self.width / 1px;
            property <float> h: self.height / 1px;
            property <float> e: 16 * root.k;
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            viewbox-width: self.w;
            viewbox-height: self.h;
            fill: transparent;
            stroke: Theme.accent2;
            stroke-width: 3px;
            commands: "M 1.5 " + self.e + " L 1.5 1.5 L " + self.e + " 1.5"
                + " M " + (self.w - self.e) + " 1.5 L " + (self.w - 1.5) + " 1.5 L " + (self.w - 1.5) + " " + self.e
                + " M " + (self.w - 1.5) + " " + (self.h - self.e) + " L " + (self.w - 1.5) + " " + (self.h - 1.5) + " L " + (self.w - self.e) + " " + (self.h - 1.5)
                + " M " + self.e + " " + (self.h - 1.5) + " L 1.5 " + (self.h - 1.5) + " L 1.5 " + (self.h - self.e);
        }
    }
    // Windows 7 : contour par-dessus l'affiche (sinon l'image le recouvre et seul le bas se voit),
    // bleu lumineux tout autour de la carte choisie.
    if Theme.win7: Rectangle {
        border-radius: Theme.radius;
        border-width: root.lit ? 2px * root.k : 1px;
        border-color: root.lit ? #9ee0ff : rgba(255, 255, 255, 0.38);
    }

    // Carte de demandes : liseré de la couleur de son état (status 10 + état), celle des pastilles.
    // Turtlefin : trait plein. Aero : trait clair sur une lueur intérieure. Nerd : trait fin, équerres aux
    // quatre coins et diode allumée.
    if root.shown.status >= 10: Rectangle {
        property <color> c: Theme.req-color(root.shown.status - 10);
        border-radius: Theme.radius;
        border-width: Theme.term ? 1px : Theme.win7 ? 2px * root.k : 3px * root.k;
        border-color: Theme.win7 ? self.c.brighter(0.5) : self.c;
        if Theme.win7: Rectangle {
            x: 2px * root.k;
            y: 2px * root.k;
            width: parent.width - 4px * root.k;
            height: parent.height - 4px * root.k;
            border-radius: max(0px, Theme.radius - 2px * root.k);
            border-width: 4px * root.k;
            border-color: parent.c.with-alpha(0.55);
        }
        for corner in (Theme.term ? 4 : 0): Rectangle {
            property <bool> right: mod(corner, 2) == 1;
            property <bool> low: corner >= 2;
            property <length> arm: 16px * root.k;
            property <length> th: 3px * root.k;
            x: self.right ? parent.width - self.arm : 0px;
            y: self.low ? parent.height - self.arm : 0px;
            width: self.arm;
            height: self.arm;
            Rectangle {
                x: 0px;
                y: parent.low ? parent.arm - parent.th : 0px;
                width: parent.arm;
                height: parent.th;
                background: root.req-corner;
            }
            Rectangle {
                x: parent.right ? parent.arm - parent.th : 0px;
                y: 0px;
                width: parent.th;
                height: parent.arm;
                background: root.req-corner;
            }
        }
        if Theme.term: Rectangle {
            x: parent.width - self.width - 10px * root.k;
            y: 10px * root.k;
            width: 9px * root.k;
            height: self.width;
            border-radius: self.width / 2;
            background: parent.c;
            border-width: 1px;
            border-color: #000000b0;
            drop-shadow-blur: Nav.no-shadow ? 0px : 8px * root.k;
            drop-shadow-color: parent.c;
        }
    }

    // Voisine de la carte sélectionnée : un voile plutôt qu'une opacité (bien moins coûteux à dessiner).
    if root.dim-a > 0.01: Rectangle {
        border-radius: Theme.radius;
        background: #000000.with-alpha((Theme.dark ? 0.42 : 0.2) * root.dim-a);
    }

    // Menu de la carte (vu, non vu...) : clic droit, ou appui long au doigt (le clic qui suit est ignoré).
    callback menu-requested();
    property <bool> long-fired;
    Timer {
        interval: 550ms;
        running: card-area.pressed && Nav.touch && !Nav.drag && !root.long-fired;
        triggered => {
            root.long-fired = true;
            root.menu-requested();
        }
    }
    card-area := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.long-fired = false;
                if (e.button == PointerEventButton.right) {
                    root.menu-requested();
                }
            }
        }
        clicked => {
            if (root.long-fired) {
                root.long-fired = false;
                return;
            }
            root.clicked();
        }
    }
}

// Rangée titrée de cartes, défilant horizontalement.
// Hauteur attendue : 132 px x k + hauteur d'image (titre 48, marges 10 + 18, texte 56).
component SectionRow inherits Rectangle {
    in property <string> title;
    in property <[CardData]> items;
    in property <length> card-w;
    in property <float> ratio: 1.5;
    in property <bool> active;
    in property <int> focus-index;
    in property <float> k: 1.0;
    in property <int> key;                  // voir Rows
    // Rangées d'une fiche : cartes l'une après l'autre, titre qui glisse vers la droite en arrivant ;
    // `leaving` : la rangée s'en va (titre vers la gauche, cartes en fondu).
    in property <bool> cascade;
    // Départ de la cascade après la création de la rangée (entrée de l'accueil : une rangée après l'autre).
    in property <duration> delay;
    in property <bool> leaving;
    in property <bool> tiles;
    // Plus de 0 : grille de wrap-cols colonnes au lieu d'une rangée (portrait, voir home-wrap).
    in property <int> wrap-cols: 0;
    // Carte survolée (souris) : ses voisines s'effacent, comme celles de la carte choisie au clavier.
    property <int> hover-i: -1;
    property <duration> t-t0;
    property <bool> t-live: root.cascade;
    init => {
        self.t-t0 = animation-tick();
    }
    Timer {
        interval: 600ms + root.delay;
        running: root.t-live;
        triggered => {
            root.t-live = false;
        }
    }
    property <float> t-x: root.t-live && Motion.pages ? clamp((animation-tick() - root.t-t0 - root.delay) / 420ms, 0, 1) : 1;
    property <float> out: root.leaving ? 1 : 0;
    animate out { duration: Motion.pages ? 300ms : 0ms; easing: ease-in; }
    property <float> te: (1 - (1 - root.t-x) * (1 - root.t-x)) * (1 - root.out);
    callback activated(int);
    callback touched(int);                  // carte touchée du doigt (sans l'ouvrir)
    // Menu d'une carte (clic droit, appui long) : carte, position dans la fenêtre. Pas sur les tuiles.
    callback card-menu(CardData, length, length);

    property <length> gap: 18px * root.k;
    property <length> pad: 32px * root.k;
    property <length> title-h: 48px * root.k;
    property <length> text-h: root.tiles ? 0px : 56px * root.k;
    // Chaque rangée garde son propre défilement quand elle n'est pas active.
    property <int> remembered: 0;
    property <int> idx: root.active ? root.focus-index : root.remembered;
    property <length> strip-w: root.items.length * (root.card-w + root.gap) + root.pad * 2;
    property <length> target-x: Rows.scroll(root.key, root.idx + 0 * Rows.tick, root.items.length, root.card-w / 1px, root.gap / 1px,
        root.pad / 1px, root.width / 1px) * 1px;
    // Défilement libre (doigt, molette horizontale) : la rangée est à ce décalage, indépendamment de
    // la sélection ; une sélection qui bouge dans la rangée (flèches) le reprend comme point de départ.
    property <bool> free;
    property <length> free-x;
    property <length> min-x: min(0px, root.width - root.strip-w);
    function unfree() {
        if (root.free) {
            Rows.set(root.key, root.free-x / 1px);
            Rows.tick += 1;
            root.free = false;
        }
    }

    changed focus-index => {
        if (root.active) {
            root.remembered = root.focus-index;
            root.unfree();
        }
    }

    // Titre précédé d'un trait (comme .sectionTitle:before de JellySkin) ; pas de titre, pas de trait.
    if root.title != "": Rectangle {
        x: root.pad - (1 - root.te) * 40px * root.k;
        opacity: root.te;
        y: root.title-h / 2 - 1px;
        width: 22px * root.k;
        height: 2px;
        background: Theme.fg;
    }
    Text {
        x: root.pad + 32px * root.k - (1 - root.te) * 40px * root.k;
        opacity: root.te;
        y: 0px;
        height: root.title-h;
        text: root.title;
        color: Theme.fg;
        font-size: (22px * root.k) * Theme.text-scale;
        font-weight: 500;
        vertical-alignment: center;
    }

    // Rognage de la rangée : il laisse de la place au-dessus et en dessous pour la carte choisie, agrandie
    // (son haut était coupé), en débordant sur la marge et le titre, jamais sur la carte voisine.
    property <length> room: 20px * root.k;
    Rectangle {
        y: root.title-h - root.room;
        height: root.height - root.title-h + 2 * root.room;
        clip: true;
        opacity: 1 - root.out;

        // Doigt, molette horizontale (ou Maj + molette) : la rangée défile librement, sans rien choisir.
        TouchArea {
            scroll-event(e) => {
                let d = e.modifiers.shift ? e.delta-y : e.delta-x;
                if (d == 0 || root.min-x >= 0px || root.wrap-cols > 0) {
                    return EventResult.reject;
                }
                let base = root.free ? root.free-x : root.target-x;
                root.free-x = clamp(base + d, root.min-x, 0px);
                root.free = true;
                return EventResult.accept;
            }
        }
        strip := Rectangle {
            x: root.wrap-cols > 0 ? 0px : root.free ? root.free-x : root.target-x;
            width: root.wrap-cols > 0 ? root.width : root.strip-w;
            // Défilement à ressort (ticket n° 2) : la rangée dépasse à peine sa place puis s'y pose.
            animate x { duration: Motion.select && !Nav.drag ? 260ms : 0ms; easing: cubic-bezier(0.3, 1.22, 0.5, 1); }

            for card[i] in root.items: Card {
                // Hors de la rangée visible (avec une carte de marge) : sautée au dessin, rien ne change
                // à l'écran (une rangée peut compter des dizaines de cartes, parcourues à chaque image).
                visible: root.wrap-cols > 0 || (root.pad + i * (root.card-w + root.gap) + strip.x > -1.5 * root.card-w
                    && root.pad + i * (root.card-w + root.gap) + strip.x < root.width + 0.5 * root.card-w);
                x: root.wrap-cols > 0 ? root.pad + mod(i, root.wrap-cols) * (root.card-w + root.gap) : root.pad + i * (root.card-w + root.gap);
                y: 10px * root.k + root.room
                    + (root.wrap-cols > 0 ? floor(i / root.wrap-cols) * (root.card-w * root.ratio + root.text-h + root.gap) : 0px);
                width: root.card-w;
                height: root.card-w * root.ratio + root.text-h;
                data: card;
                ratio: root.ratio;
                k: root.k;
                cascade: root.cascade;
                in-delay: root.delay + (root.delay > 0ms ? 160ms : 0ms) + min(i, 10) * 60ms;
                focused: root.active && i == root.focus-index;
                bare: root.tiles;
                dim: !Nav.touch && (Nav.kb ? root.active && i != root.focus-index : root.hover-i >= 0 && i != root.hover-i);
                lit-changed(on) => {
                    if (on) {
                        root.hover-i = i;
                    } else if (root.hover-i == i) {
                        root.hover-i = -1;
                    }
                }
                clicked => {
                    root.activated(i);
                }
                touched => {
                    root.touched(i);
                }
                // Tuiles (« Mes médias ») comprises : menu de bibliothèque (ouvrir, actualiser).
                menu-requested => {
                    root.touched(i);
                    root.card-menu(card, self.absolute-position.x + root.card-w / 2, self.absolute-position.y + root.card-w * root.ratio * 0.4);
                }
            }
        }
    }
}

// Icônes du menu des cartes (clic droit) : tracées, grille 24 x 24 (les signes « ⟳ » ou « ✎ » ne sont pas
// dans les polices des thèmes : carré vide ou rien). Une action par nom, voir `cm-layer` ; « box-on » /
// « box-off » : case cochée ou non.
component MenuIcon inherits Rectangle {
    in property <string> name;
    in property <color> tint: Theme.fg;
    property <string> d: root.name == "open" ? "M 9 5 L 16 12 L 9 19"
        : root.name == "back" ? "M 15 5 L 8 12 L 15 19"
        : root.name == "played" ? "M 4 12.5 L 9.5 18 L 20 6.5"
        // Recommencer : flèche qui tourne vers l'arrière.
        : root.name == "unplayed" ? "M 5.2 14.5 A 7.5 7.5 0 1 0 6.8 6.6 M 6.8 2.8 L 6.8 6.6 L 10.6 6.6"
        // Identifier : loupe et point d'interrogation.
        : root.name == "identify" ? "M 10.5 3.5 A 7 7 0 1 0 10.5 17.5 A 7 7 0 1 0 10.5 3.5 M 15.6 15.6 L 21 21 M 8.6 8.6 A 1.9 1.9 0 1 1 10.5 10.6 L 10.5 11.8 M 10.5 14.2 L 10.5 14.3"
        // Actualiser : deux flèches en cercle.
        : root.name == "refresh" || root.name == "scanall-one" ? "M 19.5 12 A 7.5 7.5 0 0 1 6.7 17.3 M 4.5 12 A 7.5 7.5 0 0 1 17.3 6.7 M 17.3 2.9 L 17.3 6.7 L 13.5 6.7 M 6.7 21.1 L 6.7 17.3 L 10.5 17.3"
        : root.name == "edit" ? "M 4 20 L 4.8 15.8 L 15.4 5.2 A 2.4 2.4 0 0 1 18.8 8.6 L 8.2 19.2 Z M 13.6 7 L 17 10.4"
        // Fichiers nouveaux : dossier et « + ».
        : root.name == "scan" ? "M 3 6 L 9.5 6 L 11.5 8.5 L 21 8.5 L 21 19 L 3 19 Z M 12 11 L 12 16.5 M 9.25 13.75 L 14.75 13.75"
        // Métadonnées manquantes : loupe et « + ».
        : root.name == "missing" ? "M 10.5 3.5 A 7 7 0 1 0 10.5 17.5 A 7 7 0 1 0 10.5 3.5 M 15.6 15.6 L 21 21 M 10.5 7.5 L 10.5 13.5 M 7.5 10.5 L 13.5 10.5"
        // Tout remplacer : deux flèches opposées.
        : root.name == "all" ? "M 4 8 L 19 8 M 15.5 4.5 L 19 8 L 15.5 11.5 M 20 16 L 5 16 M 8.5 12.5 L 5 16 L 8.5 19.5"
        // Toutes les bibliothèques : rayonnage.
        : root.name == "scanall" ? "M 3.5 4 L 7.5 4 L 7.5 20 L 3.5 20 Z M 10 4 L 14 4 L 14 20 L 10 20 Z M 16.2 5.2 L 19.6 4.2 L 22 19 L 18.6 20 Z"
        : root.name == "box-on" ? "M 4 4 L 20 4 L 20 20 L 4 20 Z M 7.5 12.5 L 10.8 15.8 L 16.8 8.5"
        : root.name == "box-off" ? "M 4 4 L 20 4 L 20 20 L 4 20 Z"
        : "";
    if root.d != "": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: max(1.5px, root.height / 12);
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: root.d;
    }
}

// Icône ronde de l'en-tête (recherche, profil).
// Icônes du menu et des catégories des Paramètres : on s'y retrouve même dans une langue qu'on ne
// lit pas. Grille 24 x 24, tracées (aucune police d'icônes).
component NavIcon inherits Rectangle {
    in property <string> name;
    in property <color> tint: Theme.fg;
    if root.name == "home": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 12 3 L 21.5 11.5 L 19 11.5 L 19 20.5 L 14.5 20.5 L 14.5 15 L 9.5 15 L 9.5 20.5 L 5 20.5 L 5 11.5 L 2.5 11.5 Z";
