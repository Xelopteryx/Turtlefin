// Mot de passe trop simple (voir Alert) : anneau rouge autour d'une photo ronde, qui respire, et
// une onde qui s'en échappe à chaque battement. À poser en dernier enfant de la photo.
component AlertRing inherits Rectangle {
    in property <float> k: 1.0;
    in property <length> gap: 3px;
    visible: Alert.weak-pw;
    property <float> b: Alert.blink;
    Rectangle {
        width: parent.width + 2 * root.gap * root.k + 12px * root.k * root.b;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        border-width: 2px * root.k * (1 - root.b);
        border-color: Alert.red.with-alpha(0.6 * root.b);
    }
    Rectangle {
        width: parent.width + 2 * root.gap * root.k;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        border-width: (2.5px + 1.5px * root.b) * root.k;
        border-color: Alert.red.with-alpha(0.55 + 0.45 * root.b);
    }
}

// Pastille « ! » rouge (mot de passe trop simple) : sur l'élément qui mène au changement.
component AlertBadge inherits Rectangle {
    in property <float> k: 1.0;
    visible: Alert.weak-pw;
    width: 18px * root.k;
    height: self.width;
    border-radius: self.width / 2;
    background: Alert.red;
    transform-scale: 1 + 0.18 * Alert.blink;
    drop-shadow-blur: Nav.no-shadow ? 0px : (8px * root.k * Alert.blink);
    drop-shadow-color: Alert.red;
    Text {
        text: "!";
        color: white;
        font-family: Theme.aero-font ? "Selawik" : "Montserrat";
        font-size: 13px * root.k;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component HeaderIcon inherits Rectangle {
    in property <string> icon;
    in property <bool> focused;
    in property <bool> on; // état actif (watch party en cours) : anneau d'accent
    in property <float> k: 1.0;
    in property <float> pop: 1.0; // apparition (avatar après la connexion), multiplie l'échelle
    callback clicked();

    width: 44px * root.k;
    height: 44px * root.k;
    // Windows 7 : bouton de la barre des tâches (carré de verre, lueur qui monte du bas au survol).
    border-radius: Theme.win7 ? 5px * root.k : self.height / 2;
    // Sélection au clavier montrée seulement si Nav.kb (au bureau, la souris la cache).
    property <bool> lit: (Nav.kb ? (root.focused) : area.has-hover && !Nav.touch);
    transform-scale: (root.lit ? (Theme.win7 ? 1.04 : 1.12) : 1.0) * root.pop;
    animate transform-scale { duration: Motion.select ? 200ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    background: Theme.win7 ? (root.lit ? @linear-gradient(180deg, rgba(255, 255, 255, 0.34) 0%, rgba(255, 255, 255, 0.12) 48%, rgba(70, 170, 255, 0.35) 52%, rgba(120, 210, 255, 0.75) 100%) : transparent)
        : root.lit ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : transparent;
    border-width: Theme.win7 && root.lit ? 1px : root.on && !root.lit ? 2px * root.k : 0px;
    border-color: Theme.win7 && root.lit ? rgba(255, 255, 255, 0.7) : Theme.accent2;
    drop-shadow-blur: Nav.no-shadow ? 0px : (Theme.win7 && root.lit ? 12px * root.k : 0px);
    drop-shadow-color: #59c2ffaa;
    property <color> ink: root.lit ? Theme.on-accent : Theme.fg;
    Gloss {
        r: parent.border-radius;
        visible: Theme.gloss > 0 && root.lit && !Theme.win7;
    }

    // Plus : trois points (icônes de la barre regroupées, petit écran).
    if root.icon == "more": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: "M 5 10 A 2 2 0 1 1 4.99 10 Z M 12 10 A 2 2 0 1 1 11.99 10 Z M 19 10 A 2 2 0 1 1 18.99 10 Z";
    }

    // Diffuser : écran et ondes (envoyer vers un autre appareil).
    if root.icon == "cast": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.ink;
        stroke-width: 2.2px * root.k;
        commands: "M 3 8 L 3 5 L 21 5 L 21 19 L 14 19 M 3 12 A 7 7 0 0 1 10 19 M 3 16 A 3 3 0 0 1 6 19";
    }
    if root.icon == "search": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.ink;
        stroke-width: 2.4px * root.k;
        commands: "M 10.5 3.5 A 7 7 0 1 1 10.49 3.5 Z M 15.6 15.6 L 21 21";
    }

    if root.icon == "menu": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.ink;
        stroke-width: 2.4px * root.k;
        commands: "M 4 6.5 L 20 6.5 M 4 12 L 20 12 M 4 17.5 L 20 17.5";
    }

    if root.icon == "back": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: "M 13.5 4 L 15.5 6 L 9.5 12 L 15.5 18 L 13.5 20 L 5.5 12 Z";
    }

    if root.icon == "home": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: "M 12 3 L 21.5 11.5 L 19 11.5 L 19 20.5 L 14.5 20.5 L 14.5 15 L 9.5 15 L 9.5 20.5 L 5 20.5 L 5 11.5 L 2.5 11.5 Z";
    }

    if root.icon == "party": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: "M 8 4 A 3.5 3.5 0 1 1 7.99 4 Z M 1 19 C 1 14.5 4 12.5 8 12.5 C 12 12.5 15 14.5 15 19 Z M 17 5.5 A 3 3 0 1 1 16.99 5.5 Z M 16.2 12.6 C 20 12.4 23 14.2 23 18 L 16.6 18 C 16.6 15.8 16.5 14 16.2 12.6 Z";
    }

    if root.icon == "dice": Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px * root.k;
        height: 22px * root.k;
        border-radius: 5px * root.k;
        border-width: 2.2px * root.k;
        border-color: root.ink;
        for p in [[0.28, 0.28], [0.72, 0.28], [0.5, 0.5], [0.28, 0.72], [0.72, 0.72]]: Rectangle {
            x: parent.width * p[0] - 2px * root.k;
            y: parent.height * p[1] - 2px * root.k;
            width: 4px * root.k;
            height: 4px * root.k;
            border-radius: 2px * root.k;
            background: root.ink;
        }
    }

    if root.icon == "profile": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px * root.k;
        height: 24px * root.k;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: "M 12 3 A 4.5 4.5 0 1 1 11.99 3 Z M 3.5 21.5 C 3.5 16.5 7.5 14 12 14 C 16.5 14 20.5 16.5 20.5 21.5 Z";
    }

    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Bouton de la fiche : dégradé violet -> bleu au focus/survol (comme .mainDetailButtons).
// Thème à `Theme.win7` : cadre de fenêtre de Windows 7 (bord de verre bleuté de 7 px, liserés
// sombre dehors et clair dedans, reflets en biais) autour d'une zone intérieure plus sombre. À poser
// en premier enfant d'un panneau ; rien sans `Theme.win7`.
component WinFrame inherits Rectangle {
    in property <length> r: 8px;
    in property <float> k: 1.0;
    visible: Theme.win7;
    border-radius: root.r;
    background: @linear-gradient(180deg, rgba(178, 216, 248, 0.62) 0%, rgba(120, 175, 230, 0.52) 22%, rgba(78, 138, 205, 0.5) 100%);
    border-width: 1px;
    border-color: rgba(0, 10, 30, 0.75);
    // Liseré clair intérieur du cadre.
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: root.r - 1px;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.55);
    }
    // Reflets en biais sur le verre du cadre.
    Rectangle {
        border-radius: root.r;
        clip: true;
        background: @linear-gradient(115deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0) 18%,
            rgba(255, 255, 255, 0.22) 19%, rgba(255, 255, 255, 0.08) 30%, rgba(255, 255, 255, 0) 31%,
            rgba(255, 255, 255, 0) 62%, rgba(255, 255, 255, 0.16) 63%, rgba(255, 255, 255, 0.05) 70%, rgba(255, 255, 255, 0) 71%);
    }
    // Zone intérieure (le contenu de la fenêtre).
    Rectangle {
        x: 7px * root.k;
        y: 7px * root.k;
        width: parent.width - 14px * root.k;
        height: parent.height - 14px * root.k;
        border-radius: 3px * root.k;
        background: @linear-gradient(180deg, rgba(10, 30, 58, 0.9) 0%, rgba(6, 20, 42, 0.93) 100%);
        border-width: 1px;
        border-color: rgba(0, 0, 0, 0.55);
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: parent.border-radius;
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.16);
        }
    }
}

// Bouton de la barre de titre de Windows 7 (valeurs du projet 7.css, licence MIT : voir
// icons/win7/LICENSE.txt) : verre en deux moitiés ; survol : bleu, lueur cyan qui monte du bas ;
// fermer : rouge, lueur jaune au survol.
component CaptionButton inherits Rectangle {
    in property <string> kind; // "min" · "max" · "restore" · "close"
    callback clicked();
    property <bool> hot: area.has-hover;
    property <bool> red: root.kind == "close";
    height: 19px;
    // Fond : rouge pour fermer, sinon verre clair.
    background: root.red ? (area.pressed ? @linear-gradient(180deg, #d1a894 0%, #b67562 25%, #b67562 50%, #7d0d01 50%, #7d0d01 100%)
            : root.hot ? @linear-gradient(180deg, #fb9d8b 0%, #ee6d56 25%, #ee6d56 50%, #d42809 50%, #d42809 100%)
            : @linear-gradient(180deg, #e0a197e5 0%, #cf796a 25%, #cf796a 50%, #d54f36 50%, #d54f36 100%))
        : area.pressed ? @linear-gradient(180deg, #86a7bc 0%, #86a7bc 50%, #092747 50%, #092747 100%)
        : root.hot ? @linear-gradient(180deg, #b6d9ee 0%, #b6d9ee 50%, #1a6ca1 50%, #1a6ca1 100%)
        : transparent;
    drop-shadow-blur: Nav.no-shadow ? 0px : (root.hot ? 7px : 0px);
    drop-shadow-color: root.red ? #e68e75 : #5dc4f0;
    // Lueur qui monte du bas (cyan, ou jaune pour fermer) au survol et à l'appui.
    if root.hot || area.pressed: Rectangle {
        background: @radial-gradient(circle, (root.red ? (area.pressed ? #dcc03f : #f4e676) : (area.pressed ? #0bfdfa : #2aceda)) 0%, #00000000 65%);
        width: parent.width * 1.3;
        height: parent.height * 1.3;
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.45;
    }
    // Reflet de verre : moitié haute claire, moitié basse un peu sombre.
    Rectangle {
        background: @linear-gradient(180deg, #ffffff80 0%, #ffffff4d 45%, #0000001a 50%, #0000001a 75%, #ffffff80 100%);
    }
    // Liseré clair intérieur.
    Rectangle {
        border-width: 1px;
        border-color: #ffffffaa;
    }
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.kind == "min" ? 3px : 0px);
        source: root.kind == "close" ? @image-url("icons/win7/close.png") : root.kind == "min" ? @image-url("icons/win7/minimize.png")
            : root.kind == "max" ? @image-url("icons/win7/maximize.png") : @image-url("icons/win7/restore.png");
        image-rendering: pixelated;
    }
    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Verre de Windows 7 (valeurs de 7.css) : bleu #4580c4 à demi transparent (Windows floute ce qu'il y a
// derrière, voir winfull::set_blur), voile clair puis sombre de gauche à droite, éclats clairs aux
// coins du haut, rayures en biais. Dessiné à la taille de la fenêtre ; les bandes du cadre en montrent
// chacune leur part (voir GlassStrip).
component GlassLayers inherits Rectangle {
    background: #4580c4b0;
    Rectangle {
        background: @linear-gradient(90deg, #ffffff66 0%, #0000001a 50%, #ffffff33 100%);
    }
    Rectangle {
        background: @linear-gradient(54deg, #00000022 0%, #00000022 4%, #66666611 6%, #00000022 8%, #00000022 10%,
            #00000000 12%, #00000022 15%, #00000022 16%, #aaaaaa11 17%, #aaaaaa11 18%, #00000022 23%, #00000022 24%,
            #bbbbbb22 25%, #bbbbbb22 26%, #00000022 31%, #00000022 33%, #00000022 34%, #bbbbbb22 36%, #bbbbbb22 40%,
            #00000022 41%, #bbbbbb22 44%, #bbbbbb22 47%, #00000022 48%, #00000022 50.5%, #00000000 53%,
            #00000022 56%, #bbbbbb22 57%, #bbbbbb22 63%, #00000022 67%, #00000022 69%, #bbbbbb22 70%, #00000022 74%,
            #bbbbbb22 75%, #bbbbbb22 79%, #00000022 80%, #00000022 84%, #aaaaaa22 85%, #aaaaaa22 86%, #00000022 87%, #bbbbbb11 90%);
    }
    // Éclats clairs des coins du haut.
    Rectangle {
        x: -60px;
        y: -60px;
        width: 220px;
        height: 220px;
        background: @radial-gradient(circle, #ffffff66 0%, #ffffff40 40%, #ffffff00 70%);
    }
    Rectangle {
        x: parent.width - 160px;
        y: -60px;
        width: 220px;
        height: 220px;
        background: @radial-gradient(circle, #ffffff66 0%, #ffffff40 40%, #ffffff00 70%);
    }
}

// Une bande du cadre : sa part du verre (la couche fait toute la fenêtre, décalée).
component GlassStrip inherits Rectangle {
    in property <length> win-w;
    in property <length> win-h;
    clip: true;
    GlassLayers {
        x: -root.x;
        y: -root.y;
        width: root.win-w;
        height: root.win-h;
    }
}

// Fenêtre de Windows 7 (Frutiger Aero en fenêtre) : cadre de verre flou et transparent, barre de titre
// (icône, nom avec son halo clair), boutons réduire / agrandir / fermer accrochés au haut, contour
// de la zone de l'interface. La barre déplace la fenêtre (double-clic : agrandir) ; les bords la
// redimensionnent. Dessiné par-dessus l'interface (qui commence sous la barre, voir chrome-top).
component WinCaption inherits Rectangle {
    in property <bool> win-maxed;
    in property <length> bar: 30px;
    in property <length> b: 8px;
    callback drag();
    callback resize(string);
    callback minimize();
    callback maximize();
    callback close();
    // Verre : barre de titre, côtés, bas.
    GlassStrip { x: 0px; y: 0px; width: root.width; height: root.bar; win-w: root.width; win-h: root.height;
        border-top-left-radius: root.win-maxed ? 0px : 6px; border-top-right-radius: root.win-maxed ? 0px : 6px; }
    if root.b > 0: GlassStrip { x: 0px; y: root.bar; width: root.b; height: root.height - root.bar; win-w: root.width; win-h: root.height; }
    if root.b > 0: GlassStrip { x: root.width - root.b; y: root.bar; width: root.b; height: root.height - root.bar; win-w: root.width; win-h: root.height; }
    if root.b > 0: GlassStrip { x: root.b; y: root.height - root.b; width: root.width - 2 * root.b; height: root.b; win-w: root.width; win-h: root.height;
        border-bottom-left-radius: 0px; }
    // Contour de la fenêtre : sombre dehors, clair dedans.
    if !root.win-maxed: Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: #000000b3;
    }
    if !root.win-maxed: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 5px;
        border-width: 1px;
        border-color: #ffffffaa;
    }
    // Contour de la zone de l'interface : liseré sombre, entouré d'un liseré clair.
    Rectangle {
        x: root.b - 2px;
        y: root.bar - 2px;
        width: parent.width - 2 * root.b + 4px;
        height: parent.height - root.bar - root.b + 4px;
        border-width: 1px;
        border-color: #ffffff99;
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-width: 1px;
            border-color: #000000b3;
        }
    }
    // Barre de titre : déplacer, double-clic pour agrandir. Position explicite : sans « y », Slint
    // centre l'élément, et une bande invisible au milieu de la fenêtre prenait les clics pour déplacer.
    TouchArea {
        y: 0px;
        height: root.bar;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.drag();
            }
        }
        double-clicked => {
            root.maximize();
        }
    }
    Image {
        x: root.b + 2px;
        y: (root.bar - self.height) / 2 + 1px;
        width: 16px;
        height: 16px;
        source: @image-url("../packaging/icons/turtlefin-64.png");
    }
    // Nom : noir, sur un halo clair et flou (comme le titre des fenêtres de Windows 7).
    Rectangle {
        x: root.b + 14px;
        y: (root.bar - self.height) / 2 + 1px;
        width: title.preferred-width + 28px;
        height: 30px;
        background: @radial-gradient(circle, #ffffffb0 0%, #ffffff70 35%, #ffffff00 70%);
    }
    title := Text {
        x: root.b + 28px;
        y: 0px;
        height: root.bar + 2px;
        text: "Turtlefin";
        color: #000000;
        font-family: "Selawik";
        font-size: 12px;
        vertical-alignment: center;
    }
    // Poignées : côtés et coins.
    if !root.win-maxed: TouchArea {
        y: 0px;
        height: 4px;
        mouse-cursor: ns-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize("n"); } }
    }
    if !root.win-maxed: TouchArea {
        y: parent.height - root.b;
        height: root.b;
        mouse-cursor: ns-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize("s"); } }
    }
    if !root.win-maxed: TouchArea {
        x: 0px;
        width: root.b;
        mouse-cursor: ew-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize("w"); } }
    }
    if !root.win-maxed: TouchArea {
        x: parent.width - root.b;
        width: root.b;
        mouse-cursor: ew-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize("e"); } }
    }
    if !root.win-maxed: TouchArea {
        width: 14px;
        height: 14px;
        x: 0px;
        y: 0px;
        mouse-cursor: nwse-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize("nw"); } }
    }
    if !root.win-maxed: TouchArea {
        width: 14px;
        height: 14px;
        x: parent.width - 14px;
        y: parent.height - 14px;
        mouse-cursor: nwse-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize("se"); } }
    }
    if !root.win-maxed: TouchArea {
        width: 14px;
        height: 14px;
        x: 0px;
        y: parent.height - 14px;
        mouse-cursor: nesw-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize("sw"); } }
    }
    if !root.win-maxed: TouchArea {
        width: 6px;
        height: 14px;
        x: parent.width - 6px;
        y: 0px;
        mouse-cursor: nesw-resize;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize("ne"); } }
    }
    // Boutons : accrochés au haut de la barre, coins du bas arrondis, séparés par un trait sombre,
    // liseré clair autour.
    Rectangle {
        x: parent.width - self.width - root.b - 2px;
        y: root.win-maxed ? 0px : 1px;
        width: 29px + 29px + 48px + 4px;
        height: 20px;
        border-bottom-left-radius: 5px;
        border-bottom-right-radius: 5px;
        // Verre bleuté (et non voile blanc) : les boutons gardent la couleur du cadre, comme sous Windows 7.
        background: #2a5a9a59;
        border-width: 1px;
        border-color: #000000b3;
        drop-shadow-blur: Nav.no-shadow ? 0px : (1px);
        drop-shadow-color: #ffffffaa;
        clip: true;
        HorizontalLayout {
            padding-left: 1px;
            padding-right: 1px;
            padding-bottom: 1px;
            spacing: 0px;
            CaptionButton {
                width: 29px;
                kind: "min";
                clicked => { root.minimize(); }
            }
            Rectangle { width: 1px; background: #000000b3; }
            CaptionButton {
                width: 29px;
                kind: root.win-maxed ? "restore" : "max";
                clicked => { root.maximize(); }
            }
            Rectangle { width: 1px; background: #000000b3; }
            CaptionButton {
                width: 48px;
                kind: "close";
                clicked => { root.close(); }
            }
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> focused;
    in property <length> font: 16px;
    callback clicked();

    preferred-width: label.preferred-width + 40px;
    // Thèmes brillants (Frutiger Aero) : bulle de verre teintée d'accent, en relief (contour clair,
    // ombre colorée, reflet), plutôt qu'un bouton plat.
    property <bool> bubble: Theme.gloss > 0 && !Theme.win7;
    // Windows 7 : bouton rectangulaire aux coins à peine arrondis (verre fumé ; choisi : bleu
    // lumineux, comme le survol d'un bouton de Windows 7).
    border-radius: Theme.win7 ? 4px : root.bubble ? self.height / 2 : 10px;
    // Sélection : petit rebond.
    property <bool> lit: (Nav.kb ? (root.focused) : area.has-hover && !Nav.touch);
    transform-scale: root.lit ? (Theme.win7 ? 1.03 : 1.07) : 1.0;
    animate transform-scale { duration: Motion.select ? 200ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    // Au repos, la bulle reste du verre à peine teinté (sans lueur) : seule la bulle choisie est
    // pleine, brillante et lumineuse (sinon on ne voyait pas laquelle était choisie).
    background: Theme.win7 ? (root.lit
            ? @linear-gradient(180deg, #8fd8ff 0%, #45a8ee 47%, #1670c8 53%, #2f95e6 100%)
            : @linear-gradient(180deg, rgba(255, 255, 255, 0.30) 0%, rgba(255, 255, 255, 0.12) 47%, rgba(0, 10, 30, 0.22) 53%, rgba(0, 10, 30, 0.36) 100%))
        : root.lit ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%)
        : root.bubble ? @linear-gradient(180deg, Theme.accent2.with-alpha(0.16) 0%, Theme.accent1.with-alpha(0.22) 100%)
        : @linear-gradient(130deg, Theme.fg.with-alpha(0.12) 0%, Theme.fg.with-alpha(0.12) 100%);
    border-width: root.bubble || Theme.win7 ? 1px : 0px;
    border-color: Theme.win7 ? (root.lit ? #0b3d7a : rgba(0, 8, 24, 0.7)) : root.lit ? rgba(255, 255, 255, 0.7) : rgba(255, 255, 255, 0.28);
    drop-shadow-blur: Nav.no-shadow ? 0px : ((root.bubble || Theme.win7) && root.lit ? 16px : 0px);
    drop-shadow-offset-y: root.bubble && root.lit ? 3px : 0px;
    drop-shadow-color: Theme.win7 ? #6fd0ffcc : Theme.accent2.with-alpha(0.55);
    // Windows 7 : liseré clair intérieur.
    if Theme.win7: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 3px;
        border-width: 1px;
        border-color: rgba(255, 255, 255, root.lit ? 0.7 : 0.32);
    }
    Gloss {
        r: parent.border-radius;
        visible: Theme.gloss > 0 && !Theme.win7;
        strength: root.bubble ? (root.lit ? 1.3 : 0.55) : 1.0;
    }

    label := Text {
        text: root.text;
        color: root.lit ? Theme.on-accent : Theme.fg;
        font-size: root.font;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Bouton rond de la télécommande (icône dessinée, ou texte court).
component PadButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> focused;
    in property <float> k: 1.0;
    in property <length> size: 56px;
    callback clicked();
    width: root.size * root.k;
    height: self.width;
    border-radius: self.width / 2;
    property <bool> lit: (Nav.kb ? root.focused : area.has-hover && !Nav.touch) || area.pressed;
    background: root.lit ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : Theme.fg.with-alpha(0.10);
    border-width: 1px;
    border-color: Theme.fg.with-alpha(0.18);
    transform-scale: area.pressed ? 0.92 : root.lit ? 1.06 : 1.0;
    animate transform-scale { duration: Motion.select ? 160ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    Gloss { r: parent.border-radius; visible: Theme.gloss > 0 && root.lit; }
    property <color> ink: root.lit ? Theme.on-accent : Theme.fg;
    if root.label != "": Text {
        text: root.label;
        color: root.ink;
        font-size: 15px * root.k;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon != "": Path {
        width: 22px * root.k;
        height: 22px * root.k;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.icon == "play" || root.icon == "pause" || root.icon == "next" || root.icon == "prev" || root.icon == "stop" ? root.ink : transparent;
        stroke: root.ink;
        stroke-width: 2.4px * root.k;
        commands: root.icon == "up" ? "M 5 15 L 12 8 L 19 15"
            : root.icon == "down" ? "M 5 9 L 12 16 L 19 9"
            : root.icon == "left" ? "M 15 5 L 8 12 L 15 19"
            : root.icon == "right" ? "M 9 5 L 16 12 L 9 19"
            : root.icon == "back" ? "M 10 6 L 4 12 L 10 18 M 4 12 L 20 12"
            : root.icon == "home" ? "M 4 11 L 12 4 L 20 11 M 6 10 L 6 20 L 18 20 L 18 10"
            : root.icon == "play" ? "M 7 4 L 20 12 L 7 20 Z"
            : root.icon == "pause" ? "M 6 4 L 10 4 L 10 20 L 6 20 Z M 14 4 L 18 4 L 18 20 L 14 20 Z"
            : root.icon == "prev" ? "M 5 4 L 7 4 L 7 20 L 5 20 Z M 19 4 L 9 12 L 19 20 Z"
            : root.icon == "next" ? "M 17 4 L 19 4 L 19 20 L 17 20 Z M 5 4 L 15 12 L 5 20 Z"
            : root.icon == "rew" ? "M 11 6 L 4 12 L 11 18 M 20 6 L 13 12 L 20 18"
            : root.icon == "ff" ? "M 13 6 L 20 12 L 13 18 M 4 6 L 11 12 L 4 18"
            : root.icon == "stop" ? "M 6 6 L 18 6 L 18 18 L 6 18 Z"
            : root.icon == "vol-" ? "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 16 12 L 21 12"
            : root.icon == "vol+" ? "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 15 12 L 21 12 M 18 9 L 18 15"
            : root.icon == "mute" ? "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 15 9 L 21 15 M 21 9 L 15 15"
            : "";
    }
    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Télécommande d'un appareil (voir cast.rs) : nom, titre en cours et avancement ; croix directionnelle
// et OK, Retour et Accueil ; lecture ; volume. `full` faux (télé DLNA) : lecture et volume seulement.
// Clavier : ← → ↑ ↓ choisissent un bouton (sel), Entrée l'active, Échap ferme.
component RemotePad inherits Rectangle {
    in property <float> k: 1.0;
    in property <string> name;
    in property <string> now;
    in property <bool> paused;
    in property <float> pos;
    in property <string> time;
    in property <bool> full: true;
    // Boutons (pour le clavier) : 0 haut · 1 gauche · 2 OK · 3 droite · 4 bas · 5 retour · 6 accueil ·
    // 7 précédent · 8 recul · 9 lecture · 10 avance · 11 suivant · 12 vol- · 13 muet · 14 vol+ · 15 fermer
    in-out property <int> sel: 2;
    callback cmd(string);
    callback close();
    // Hauteur du contenu (le parent s'y ajuste).
    out property <length> want-h: pad-col.preferred-height;
    border-radius: (Theme.win7 ? 8px : 24px) * root.k;
    background: Theme.win7 ? transparent : Theme.panel;
    border-width: Theme.win7 ? 0px : 1px;
    border-color: Theme.glass-border;
    drop-shadow-blur: Nav.no-shadow ? 0px : (30px * root.k);
    drop-shadow-color: #000000a0;
    Gloss { r: parent.border-radius; strength: 0.45; visible: Theme.gloss > 0 && !Theme.win7; }
    WinFrame { r: parent.border-radius; k: root.k; }
    property <[string]> codes: ["up", "left", "ok", "right", "down", "back", "home", "prev", "rew", "playpause", "ff", "next", "vol-", "mute", "vol+", "close"];
    function press(i: int) {
        if (i == 15) {
            root.close();
        } else {
            root.cmd(root.codes[i]);
        }
    }
    FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Backspace) {
                root.close();
                return EventResult.accept;
            }
            // Ordre de déplacement simple : ligne par ligne.
            if (event.text == Key.Return) {
                root.press(root.sel);
            } else if (event.text == Key.RightArrow) {
                root.sel = min(15, root.sel + 1);
            } else if (event.text == Key.LeftArrow) {
                root.sel = max(0, root.sel - 1);
            } else if (event.text == Key.DownArrow) {
                root.sel = root.sel < 2 ? 2 : root.sel < 5 ? 5 : root.sel < 7 ? 9 : root.sel < 12 ? 13 : 15;
            } else if (event.text == Key.UpArrow) {
                root.sel = root.sel >= 15 ? 13 : root.sel >= 12 ? 9 : root.sel >= 7 ? 5 : root.sel >= 5 ? 2 : 0;
            }
            return EventResult.accept;
        }
    }
    pad-col := VerticalLayout {
        padding: 22px * root.k;
        spacing: 14px * root.k;
        alignment: start;
        Text {
            text: Tr.f(Tr.k, "Télécommande · {}", root.name, "");
            color: Theme.fg;
            font-size: 20px * root.k;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.now == "" ? Tr.t(Tr.k, "Rien en lecture") : root.now;
            color: Theme.muted;
            font-size: 14px * root.k;
            overflow: elide;
        }
        // Avancement de la lecture sur l'appareil.
        Rectangle {
            height: 22px * root.k;
            Rectangle {
                y: 0px;
                height: 6px * root.k;
                border-radius: self.height / 2;
                background: Theme.fg.with-alpha(0.15);
                Rectangle {
                    x: 0px;
                    width: parent.width * clamp(root.pos, 0, 1);
                    animate width { duration: Motion.player ? 400ms : 0ms; }
                    border-radius: parent.border-radius;
                    background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
                }
            }
            Text {
                y: 10px * root.k;
                width: parent.width;
                text: root.time;
                color: Theme.muted;
                font-size: 12px * root.k;
                horizontal-alignment: right;
            }
        }
        // Croix directionnelle et OK (télécommande complète).
        if root.full: Rectangle {
            height: 200px * root.k;
            Rectangle {
                width: 200px * root.k;
                height: self.width;
                x: (parent.width - self.width) / 2;
                border-radius: self.width / 2;
                background: Theme.fg.with-alpha(0.05);
                border-width: 1px;
                border-color: Theme.fg.with-alpha(0.1);
                PadButton { k: root.k; icon: "up"; x: (parent.width - self.width) / 2; y: 4px * root.k; focused: root.sel == 0; clicked => { root.sel = 0; root.press(0); } }
                PadButton { k: root.k; icon: "left"; x: 4px * root.k; y: (parent.height - self.height) / 2; focused: root.sel == 1; clicked => { root.sel = 1; root.press(1); } }
                PadButton { k: root.k; label: "OK"; size: 68px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; focused: root.sel == 2; clicked => { root.sel = 2; root.press(2); } }
                PadButton { k: root.k; icon: "right"; x: parent.width - self.width - 4px * root.k; y: (parent.height - self.height) / 2; focused: root.sel == 3; clicked => { root.sel = 3; root.press(3); } }
                PadButton { k: root.k; icon: "down"; x: (parent.width - self.width) / 2; y: parent.height - self.height - 4px * root.k; focused: root.sel == 4; clicked => { root.sel = 4; root.press(4); } }
            }
        }
        if root.full: HorizontalLayout {
            alignment: center;
            spacing: 40px * root.k;
            PadButton { k: root.k; icon: "back"; focused: root.sel == 5; clicked => { root.sel = 5; root.press(5); } }
            PadButton { k: root.k; icon: "home"; focused: root.sel == 6; clicked => { root.sel = 6; root.press(6); } }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 10px * root.k;
            PadButton { k: root.k; size: 48px; icon: "prev"; focused: root.sel == 7; clicked => { root.sel = 7; root.press(7); } }
            PadButton { k: root.k; size: 48px; icon: "rew"; focused: root.sel == 8; clicked => { root.sel = 8; root.press(8); } }
            PadButton { k: root.k; size: 60px; icon: root.paused ? "play" : "pause"; focused: root.sel == 9; clicked => { root.sel = 9; root.press(9); } }
            PadButton { k: root.k; size: 48px; icon: "ff"; focused: root.sel == 10; clicked => { root.sel = 10; root.press(10); } }
            PadButton { k: root.k; size: 48px; icon: "next"; focused: root.sel == 11; clicked => { root.sel = 11; root.press(11); } }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 18px * root.k;
            PadButton { k: root.k; size: 48px; icon: "vol-"; focused: root.sel == 12; clicked => { root.sel = 12; root.press(12); } }
            PadButton { k: root.k; size: 48px; icon: "mute"; focused: root.sel == 13; clicked => { root.sel = 13; root.press(13); } }
            PadButton { k: root.k; size: 48px; icon: "vol+"; focused: root.sel == 14; clicked => { root.sel = 14; root.press(14); } }
        }
        HorizontalLayout {
            alignment: center;
            ActionButton {
                height: 42px * root.k;
                width: self.preferred-width;
                text: Tr.t(Tr.k, "Fermer");
                font: 15px * root.k;
                focused: Nav.kb && root.sel == 15;
                clicked => {
                    root.close();
                }
            }
        }
    }
}


// Bouton de la fiche : icône (lecture, favori, vu, téléchargement) ou texte, au style de ActionButton.
component DetailButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;          // "" : pastille de texte · "label" : texte sur la ligne des icônes
    in property <bool> active;
    in property <bool> focused;
    in property <float> k: 1.0;
    in property <int> press;            // incrémenté à chaque activation : le bouton sélectionné réagit
    callback clicked();

    property <bool> lit: (Nav.kb ? (root.focused) : area.has-hover && !Nav.touch);
    property <bool> is-icon: root.icon != "" && root.icon != "label";

    // Animations : appui (écrasé puis rebond) et changement d'état (le bouton « saute »).
    property <bool> act: root.active;
    property <int> kind;                // 1 appui · 2 changement d'état
    property <bool> anim;
    property <duration> t0;
    changed press => {
        if (root.focused) {
            root.kind = 1;
            root.t0 = animation-tick();
            root.anim = true;
        }
    }
    changed act => {
        root.kind = 2;
        root.t0 = animation-tick();
        root.anim = true;
    }
    Timer {
        interval: 520ms;
        running: root.anim;
        triggered => {
            root.anim = false;
        }
    }
    property <float> q: root.anim && Motion.select ? clamp((animation-tick() - root.t0) / 500ms, 0, 1) : 1;
    property <float> wave: root.anim ? sin(root.q * 360deg) * (1 - root.q) : 0;
    property <float> hop: root.anim ? sin(root.q * 180deg) * (1 - 0.4 * root.q) : 0;
    property <float> lit-s: root.lit ? 1.1 : 1.0;
    animate lit-s { duration: Motion.select ? 200ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

    in property <bool> chip; // pastille compacte (saison, série, pistes)
    preferred-width: root.is-icon ? self.height : label.preferred-width + (root.chip ? 24px : 40px) * root.k;
    min-width: self.preferred-width;
    horizontal-stretch: 0;
    // Le zoom ne s'applique pas à la racine d'un composant : il porte sur ce rectangle intérieur.
    face := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: root.chip || root.icon == "label" ? self.height / 2 : 10px;
        transform-scale: root.lit-s * (root.kind == 1 ? 1 - 0.16 * root.wave : 1 + 0.32 * root.hop);
        background: root.lit ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%)
            : @linear-gradient(130deg, Theme.fg.with-alpha(0.12) 0%, Theme.fg.with-alpha(0.12) 100%);
        property <color> ink: root.lit ? Theme.on-accent : Theme.fg;
        Gloss {
            r: parent.border-radius;
        }

        if root.icon == "play": Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 22px * root.k;
            height: 22px * root.k;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: face.ink;
            commands: "M 7 4 L 20 12 L 7 20 Z";
        }
        // Favori : le cœur se remplit en fondu pendant qu'il saute.
        if root.icon == "heart": Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 22px * root.k;
            height: 22px * root.k;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: root.active ? #ff4d6d : #ff4d6d00;
            animate fill { duration: Motion.select ? 300ms : 0ms; easing: ease-out; }
            stroke: root.active ? #ff4d6d : face.ink;
            animate stroke { duration: Motion.select ? 300ms : 0ms; }
            stroke-width: 2px * root.k;
            commands: "M 12 20.5 L 10.6 19.2 C 5.4 14.5 2.5 11.9 2.5 8.6 C 2.5 5.9 4.6 3.8 7.3 3.8 C 8.9 3.8 10.6 4.6 12 6 C 13.4 4.6 15.1 3.8 16.7 3.8 C 19.4 3.8 21.5 5.9 21.5 8.6 C 21.5 11.9 18.6 14.5 13.4 19.2 Z";
        }
        if root.icon == "check": Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 22px * root.k;
            height: 22px * root.k;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: root.active && !root.lit ? Theme.accent2 : face.ink;
            animate stroke { duration: Motion.select ? 300ms : 0ms; }
            stroke-width: (root.active ? 3.2px : 2.2px) * root.k;
            commands: "M 4 12.5 L 9.5 18 L 20 6.5";
        }
        // Téléchargement : la flèche plonge vers le plateau à l'appui.
        if root.icon == "download": Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (root.kind == 1 ? root.hop * 6px * root.k : 0px);
            width: 22px * root.k;
            height: 22px * root.k;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: root.active && !root.lit ? Theme.accent2 : face.ink;
            animate stroke { duration: Motion.select ? 300ms : 0ms; }
            stroke-width: 2.2px * root.k;
            commands: "M 12 3.5 L 12 15 M 6.5 10 L 12 15.5 L 17.5 10";
        }
        if root.icon == "download": Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 22px * root.k;
            height: 22px * root.k;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: root.active && !root.lit ? Theme.accent2 : face.ink;
            stroke-width: 2.2px * root.k;
            commands: "M 4.5 20 L 19.5 20";
        }

        // Supprimer (téléchargement) : corbeille, le couvercle se soulève à l'appui.
        if root.icon == "trash": Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - (root.kind == 1 ? root.hop * 4px * root.k : 0px);
            width: 22px * root.k;
            height: 22px * root.k;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: face.ink;
            stroke-width: 2px * root.k;
            commands: "M 4 6.5 L 20 6.5 M 9.5 6.5 L 9.5 4 L 14.5 4 L 14.5 6.5";
        }
        if root.icon == "trash": Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 22px * root.k;
            height: 22px * root.k;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: face.ink;
            stroke-width: 2px * root.k;
            commands: "M 6 6.5 L 7 20 L 17 20 L 18 6.5 M 10 10.5 L 10 16.5 M 14 10.5 L 14 16.5";
        }

        label := Text {
            width: parent.width;
            height: parent.height;
            text: root.is-icon ? "" : root.text;
            color: face.ink;
            font-size: (root.chip ? 13px : root.icon == "label" ? 15px : 16px) * root.k;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        area := TouchArea {
            clicked => {
                root.clicked();
            }
        }
    }
}

// Panneau « résumé complet » : fond assombri uni (pas de flou, trop coûteux sur les petites machines).
component OverviewPanel inherits Rectangle {
    in property <string> text;
    in property <length> font: 20px;
    in property <float> k: 1.0;
    // Ouverte : arrive en montant et en grossissant un peu ; fermée : repart vers le haut en fondu.
    in property <bool> open;
    callback close();
    property <float> p: root.open ? 1 : 0;
    animate p { duration: Motion.panels ? 300ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    visible: root.p > 0.01;
    changed open => {
        if (root.open) {
            root.scroll = 0px;
        }
    }

    property <length> scroll: 0px;

    public function scroll-by(d: length) {
        root.scroll = clamp(root.scroll + d, 0px, max(0px, txt.height - view.height));
    }
    public function reset() {
        root.scroll = 0px;
    }

    background: Theme.scrim.with-alpha(0.72 * root.p);

    TouchArea {
        clicked => {
            root.close();
        }
    }

    Rectangle {
        width: min(parent.width - 64px, 900px);
        height: min(parent.height - 96px, parent.height * 0.8);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (1 - root.p) * (root.open ? 40px : -30px) * root.k;
        opacity: root.p;
        transform-scale: 0.94 + 0.06 * root.p;
        border-radius: (Theme.win7 ? 8px : 16px);
        background: Theme.win7 ? transparent : Theme.panel;
        border-width: Theme.win7 ? 0px : 1px;
        border-color: Theme.fg.with-alpha(0.14);
        Gloss { r: parent.border-radius; strength: 0.45; visible: Theme.gloss > 0 && !Theme.win7; }
        WinFrame { r: parent.border-radius; k: 1.0; }

        // Absorbe les clics à l'intérieur du panneau (sinon ils fermeraient le panneau). La molette
        // fait défiler le texte (pas la page dessous).
        TouchArea {
            scroll-event(e) => {
                root.scroll-by(-e.delta-y);
                return EventResult.accept;
            }
        }

        view := Rectangle {
            x: 28px;
            y: 24px;
            width: parent.width - 56px;
            height: parent.height - 24px - 84px * root.k;
            clip: true;

            VerticalLayout {
                y: 0px - root.scroll;
                alignment: start;

                txt := Text {
                    text: root.text;
                    wrap: word-wrap;
                    color: Theme.text;
                    font-size: root.font;
                }
            }
        }

        // Bas de la fenêtre : aide à gauche (clavier, télécommande), bouton Retour à droite.
        if !Nav.touch: Text {
            x: 28px;
            y: parent.height - 30px * root.k - 22px * root.k;
            height: 44px * root.k;
            text: Tr.t(Tr.k, "Échap pour fermer  ·  ↑ ↓ pour défiler");
            color: Theme.muted;
            font-size: 13px * root.k;
            vertical-alignment: center;
        }
        ActionButton {
            x: parent.width - self.width - 22px;
            y: parent.height - self.height - 18px * root.k;
            height: 44px * root.k;
            width: self.preferred-width;
            text: Tr.t(Tr.k, "Retour");
            font: 16px * root.k;
            focused: true;
            clicked => {
                root.close();
            }
        }
    }
}

// Élément qui descend en glissant à son apparition (`e` passe de 0 à 1 à la création).
component DropIn inherits Rectangle {
    out property <float> e: 0;
    init => {
        self.e = 1;
    }
    animate e { duration: Motion.pages ? 280ms : 0ms; easing: ease-out; }
}

// Barre de navigation en haut à gauche de chaque écran : menu, retour (si l'on a navigué),
// accueil (hors accueil) et titre de la page. Les boutons qui apparaissent descendent en glissant,
// le menu et le titre se décalent en douceur, le titre d'une nouvelle page descend aussi.
component NavBar inherits Rectangle {
    in property <float> k: 1.0;
    in property <bool> can-back;
    in property <bool> show-home;
    in property <string> title;
    in property <brush> title-color: Theme.text;
    in property <int> sel: -1; // bouton sélectionné, de gauche à droite : [retour] [accueil] menu
    in property <float> enter: 1; // arrivée de la page (0 -> 1)
    callback activate(int);

    property <int> n: 1 + (root.can-back ? 1 : 0) + (root.show-home ? 1 : 0);
    property <length> x0: 24px * root.k;
    property <length> step: 54px * root.k;
    property <length> iy: (root.height - 44px * root.k) / 2;
    height: 72px * root.k;

    if root.can-back: DropIn {
        x: root.x0;
        y: root.iy + (self.e - 1) * 34px * root.k;
        width: 44px * root.k;
        height: 44px * root.k;
        HeaderIcon {
            icon: "back";
            k: root.k;
            focused: root.sel == 0;
            clicked => {
                root.activate(0);
            }
        }
    }
    if root.show-home: DropIn {
        x: root.x0 + (root.can-back ? root.step : 0px);
        y: root.iy + (self.e - 1) * 34px * root.k;
        width: 44px * root.k;
        height: 44px * root.k;
        animate x { duration: Motion.pages ? 240ms : 0ms; easing: ease-out; }
        HeaderIcon {
            icon: "home";
            k: root.k;
            focused: root.sel == (root.can-back ? 1 : 0);
            clicked => {
                root.activate(root.can-back ? 1 : 0);
            }
        }
    }
    HeaderIcon {
        x: root.x0 + (root.n - 1) * root.step;
        y: root.iy;
        animate x { duration: Motion.pages ? 240ms : 0ms; easing: ease-out; }
        icon: "menu";
        k: root.k;
        focused: root.sel == root.n - 1;
        clicked => {
            root.activate(root.n - 1);
        }
    }
    Text {
        x: root.x0 + root.n * root.step + 4px * root.k;
        y: (1 - root.enter) * -18px * root.k;
        width: root.width - self.x - 8px * root.k;
        height: root.height;
        animate x { duration: Motion.pages ? 240ms : 0ms; easing: ease-out; }
        text: root.title;
        color: root.title-color;
        font-size: 26px * root.k;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
        // Le nom de l'appli coupé (« Turtl… », téléphone) : plutôt rien.
        visible: root.title != "Turtlefin" || self.width >= self.preferred-width;
    }
}

// Droite de la barre du haut, sur toutes les pages : watch party, au hasard, recherche, compte, heure.
component HeaderRight inherits Rectangle {
    in property <float> k: 1.0;
    in property <int> sel: -1; // 0 diffuser · 1 watch party · 2 au hasard · 3 recherche · 4 compte
    in property <bool> party-on;
    in property <bool> cast-on;                // un appareil est piloté (télécommande)
    // Petit écran : diffuser, watch party, hasard et recherche regroupés derrière « ⋯ » (activate(5)) ;
    // la photo du compte reste visible.
    in property <bool> collapsed;
    in property <bool> has-avatar;
    in property <image> avatar;
    // Avatar animé : ses images (vide : `avatar`, fixe) et celle montrée (voir show_frames).
    in property <[image]> avatar-frames;
    in property <int> avatar-idx;
    in property <string> clock;
    in property <bool> offline;
    in property <int> party-count;
    // Portrait (téléphone tenu droit) : pas d'heure (la barre d'Android l'affiche), moins de marge.
    in property <bool> narrow;
    // Téléchargement en cours : pastille avec flèche, pourcentage et jauge (ambre : en pause).
    in property <string> dl-text;
    in property <float> dl-p;
    in property <bool> dl-paused;
    callback activate(int);

    // Impulsion (0 -> 1, trois fois) quand le groupe change.
    property <int> pc: root.party-count;
    property <bool> pulse-on;
    property <duration> pulse-t0;
    property <float> pulse: root.pulse-on ? mod((animation-tick() - root.pulse-t0) / 1ms, 700) / 700 : 0;
    changed pc => {
        if (root.party-on) {
            root.pulse-t0 = animation-tick();
            root.pulse-on = true;
        }
    }
    Timer {
        interval: 2100ms;
        running: root.pulse-on;
        triggered => {
            root.pulse-on = false;
        }
    }

    // Largeur occupée par les icônes (marge droite comprise) : cadre de la visite guidée.
    out property <length> used-w: hr-lay.preferred-width;
    // Photo du compte : apparition élastique après la connexion (0 -> 1).
    in property <float> me-pop: 1;
    hr-lay := HorizontalLayout {
        alignment: end;
        spacing: (root.narrow ? 6px : 12px) * root.k;
        padding-right: (root.narrow ? 14px : 32px) * root.k;
        padding-top: (root.height - 44px * root.k) / 2;
        padding-bottom: (root.height - 44px * root.k) / 2;

        if root.dl-text != "": Rectangle {
            width: dl-label.preferred-width + 52px * root.k;
            border-radius: self.height / 2;
            background: Theme.fg.with-alpha(0.08);
            border-width: 1px;
            border-color: root.dl-paused ? Theme.warn : Theme.fg.with-alpha(0.18);
            clip: true;
            // Jauge : le fond se remplit avec l'avancement.
            Rectangle {
                x: 0px;
                width: parent.width * clamp(root.dl-p, 0, 1);
                animate width { duration: Motion.select ? 500ms : 0ms; easing: ease-out; }
                background: @linear-gradient(130deg, Theme.accent1.transparentize(0.45) 0%, Theme.accent2.transparentize(0.45) 100%);
            }
            HorizontalLayout {
                padding-left: 12px * root.k;
                spacing: 6px * root.k;
                alignment: start;
                Path {
                    width: 16px * root.k;
                    height: 16px * root.k;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    fill: transparent;
                    stroke: root.dl-paused ? Theme.warn : Theme.fg;
                    stroke-width: 2px * root.k;
                    commands: "M 8 2 L 8 11 M 4 7 L 8 11 L 12 7 M 3 14 L 13 14";
                }
                dl-label := Text {
                    text: root.dl-text;
                    color: root.dl-paused ? Theme.warn : Theme.fg;
                    font-size: 14px * root.k;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
        // Mode hors ligne : pastille verte à la place des icônes qui demandent le serveur.
        if root.offline: Rectangle {
            width: offline-label.preferred-width + 48px * root.k;
            border-radius: self.height / 2;
            background: #14532d;
            border-width: 1px;
            border-color: #4ade80;
            HorizontalLayout {
                padding-left: 12px * root.k;
                spacing: 8px * root.k;
                alignment: start;
                Text {
                    text: "●";
                    color: #4ade80;
                    font-size: 11px * root.k;
                    vertical-alignment: center;
                }
                offline-label := Text {
                    text: Tr.t(Tr.k, "Hors ligne");
                    color: #bbf7d0;
                    font-size: 15px * root.k;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
        if !root.offline && root.collapsed: HeaderIcon {
            icon: "more";
            k: root.k;
            on: root.cast-on || root.party-on;
            focused: root.sel >= 0 && root.sel < 4;
            clicked => {
                root.activate(5);
            }
        }
        // Diffuser : télécommande d'un autre appareil, ou envoi de la vidéo vers une télé.
        if !root.offline && !root.collapsed: HeaderIcon {
            icon: "cast";
            k: root.k;
            on: root.cast-on;
            focused: root.sel == 0;
            clicked => {
                root.activate(0);
            }
        }
        if !root.offline && !root.collapsed: HeaderIcon {
            icon: "party";
            k: root.k;
            on: root.party-on;
            focused: root.sel == 1;
            clicked => {
                root.activate(1);
            }
            // Dans une watch party : fond d'accent, anneau qui s'élargit à chaque arrivée / départ
            // (trois fois puis plus rien : pas d'animation continue), nombre de participants.
            if root.party-on: Rectangle {
                width: parent.width * (1 + 0.7 * root.pulse);
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                border-width: 2px * root.k;
                border-color: Theme.accent2.transparentize(root.pulse-on ? root.pulse : 1);
            }
            if root.party-on: Rectangle {
                x: parent.width - self.width + 4px * root.k;
                y: -4px * root.k;
                width: max(18px * root.k, cnt-t.preferred-width + 10px * root.k);
                height: 18px * root.k;
                border-radius: self.height / 2;
                background: @linear-gradient(110deg, Theme.accent1 0%, Theme.accent2 100%);
                cnt-t := Text {
                    text: root.party-count;
                    color: Theme.on-accent;
                    font-size: 11px * root.k;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if !root.offline && !root.collapsed: HeaderIcon {
            icon: "dice";
            k: root.k;
            focused: root.sel == 2;
            clicked => {
                root.activate(2);
            }
        }
        if !root.offline && !root.collapsed: HeaderIcon {
            icon: "search";
            k: root.k;
            focused: root.sel == 3;
            clicked => {
                root.activate(3);
            }
        }
        me := HeaderIcon {
            icon: root.has-avatar ? "" : "profile";
            k: root.k;
            focused: root.sel == 4;
            // Connexion : la photo apparaît en zoomant (élastique) après le départ de celle du compte.
            pop: root.me-pop;
            clicked => {
                root.activate(4);
            }
            if root.has-avatar && root.avatar-frames.length == 0: Image {
                x: 4px * root.k;
                y: 4px * root.k;
                width: parent.width - 8px * root.k;
                height: parent.height - 8px * root.k;
                source: root.avatar;
                image-fit: fill;
            }
            // GIF : une image par étape, une seule visible (chaque texture n'est créée qu'une fois).
            for f[fi] in root.avatar-frames: Image {
                x: 4px * root.k;
                y: 4px * root.k;
                width: parent.width - 8px * root.k;
                height: parent.height - 8px * root.k;
                source: f;
                image-fit: fill;
                visible: fi == root.avatar-idx;
            }
            AlertRing { k: root.k; gap: -1px; }
            AlertBadge {
                k: root.k;
                x: parent.width - self.width + 5px * root.k;
                y: -5px * root.k;
            }
        }
        if Prefs.clock && !root.narrow: Text {
            text: root.clock;
            // Police nommée : l'heure ne dépend pas de la langue, l'effet de changement de langue
            // ne la recouvre pas (il repère les textes avec une police vide, voir dust.rs).
            font-family: Theme.aero-font ? "Selawik" : "Montserrat";
            color: Theme.text;
            font-size: 18px * root.k;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

// Fond de la fenêtre : dégradé du thème, image du média sélectionné (fondu enchaîné entre deux
// calques), décor du thème, barre de verre de l'en-tête. Dessiné une fois sous les pages, et une
// seconde fois (`a` < 1) comme voile des changements de page : le contenu s'efface, le fond reste.
// L'opacité est portée par chaque calque (pas de rendu hors écran de l'ensemble).
component Backdrop inherits Rectangle {
    in property <float> a: 1;
    in property <image> bg-a;
    in property <image> bg-b;
    in property <float> bg-mix;
    in property <float> bg-vis;
    in property <float> po;
    in property <length> d-fade;
    in property <bool> on-detail;
    in property <float> k: 1.0;
    in property <bool> glass;
    in property <length> header-h;

    // Voile : il doit couvrir la page, donc d'abord le dégradé opaque de la fenêtre.
    if root.a < 1: Rectangle {
        background: @linear-gradient(180deg, Theme.bg.with-alpha(root.a) 0%, Theme.bg-mid.with-alpha(root.a) 55%, Theme.bg-end.with-alpha(root.a) 100%);
    }
    if root.bg-vis > 0.001 && !Perf.hide(1): bgr := Rectangle {
        transform-scale: 1 + 0.12 * root.po;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.bg-a;
            image-fit: cover;
            opacity: (1 - root.bg-mix) * root.bg-vis * root.a;
        }
        Image {
            width: parent.width;
            height: parent.height;
            source: root.bg-b;
            image-fit: cover;
            opacity: root.bg-mix * root.bg-vis * root.a;
        }
        // Plus sombre vers le bas, là où sont les rangées. Fiche : l'image reste bien visible jusqu'au
        // bas de l'affiche (d-fade), puis s'assombrit (le voile suit le défilement de la fiche).
        property <float> d-v: root.on-detail ? 1 : 0;
        animate d-v { duration: Motion.pages ? 500ms : 0ms; easing: ease-in-out; }
        if !Perf.hide(2): Rectangle {
            opacity: (1 - bgr.d-v) * root.a;
            background: @linear-gradient(180deg, Theme.bg.with-alpha(min(1, 0.25 * Theme.veil)) 0%, Theme.bg-mid.with-alpha(min(1, 0.69 * Theme.veil)) 60%, Theme.bg-end.with-alpha(min(1, 0.88 * Theme.veil)) 100%);
        }
        if bgr.d-v > 0: Rectangle {
            Rectangle {
                y: 0px;
                height: max(1px, root.d-fade);
                opacity: bgr.d-v * root.a;
                background: @linear-gradient(180deg, Theme.bg.with-alpha(min(1, 0.3 * Theme.veil)) 0%, Theme.bg.with-alpha(min(0.35, 0.08 * Theme.veil)) 30%, Theme.bg-mid.with-alpha(min(0.5, 0.18 * Theme.veil)) 100%);
            }
            Rectangle {
                y: max(1px, root.d-fade);
                height: parent.height - self.y + 1px;
                opacity: bgr.d-v * root.a;
                background: @linear-gradient(180deg, Theme.bg-mid.with-alpha(min(0.5, 0.18 * Theme.veil)) 0%, Theme.bg-mid.with-alpha(min(1, 0.75 * Theme.veil)) 35%, Theme.bg-end.with-alpha(min(1, 0.92 * Theme.veil)) 100%);
            }
        }
    }

    // Décor du thème (Frutiger Aero : ciel, bulles), sur l'image de fond et sous les pages.
    if Theme.bubbles && !Perf.hide(4): AeroSky {
        k: root.k;
        opacity: root.a;
    }
    // Barre de verre derrière l'en-tête (thèmes à `Theme.header-glass`, façon barre des tâches de
    // Windows 7) : moitié haute claire, moitié basse plus sombre, liserés clairs.
    if Theme.header-glass && root.glass && !Perf.hide(8): Rectangle {
        y: 0px;
        height: root.header-h;
        opacity: root.a;
        // Windows 7 : verre fumé plus sombre, comme la barre des tâches.
        background: Theme.win7 ? @linear-gradient(180deg, rgba(150, 190, 230, 0.34) 0%, rgba(60, 100, 150, 0.36) 49%,
                rgba(4, 16, 36, 0.62) 50%, rgba(2, 10, 26, 0.72) 100%)
            : @linear-gradient(180deg, rgba(255, 255, 255, 0.20) 0%, rgba(255, 255, 255, 0.07) 49%,
            rgba(0, 12, 34, 0.30) 50%, rgba(0, 12, 34, 0.42) 100%);
        Rectangle { y: 0px; height: 1px; background: rgba(255, 255, 255, 0.30); }
        Rectangle { y: parent.height - 2px; height: 1px; background: rgba(0, 0, 0, 0.35); }
        Rectangle { y: parent.height - 1px; height: 1px; background: rgba(255, 255, 255, 0.28); }
    }
}

export struct DlInfo {
    title: string,
    details: string,
    overview: string,
}

export component AppWindow inherits Window {
    // Clavier virtuel (Android) : sa position, pour remonter l'écran de saisie au-dessus (voir Kb).
    property <length> kb-top: self.virtual-keyboard-size.height > 0 ? self.virtual-keyboard-position.y : 0px;
    changed kb-top => {
        Kb.top = self.kb-top;
    }
    title: "Turtlefin";
    // Icône de départ ; ensuite celle du thème, posée directement sur la fenêtre (theme::window_icon).
    icon: @image-url("../packaging/icons/turtlefin-64.png");
    // Interface TV sous Windows : fenêtre sans bordure sur tout l'écran (voir set_tv_window).
    in property <bool> frameless;
    // Frutiger Aero en fenêtre (bureau) : cadre et boutons de Windows 7 dessinés par Turtlefin (la
    // fenêtre est sans bordure ; voir WinCaption). Déplacer, redimensionner, réduire, agrandir, fermer :
    callback win-drag();
    callback win-resize(string);           // "n", "s", "e", "w", "ne", "nw", "se", "sw"
    callback win-min();
    callback win-max();
    callback win-close();
    in property <bool> chrome;
    in property <bool> win-maxed;
    // Passage en plein écran ou retour en fenêtre : la page arrive de nouveau sous un voile.
    public function screen-changed() {
        root.page-enter();
        root.rot-t0 = animation-tick();
        root.rot-anim = Motion.pages;
    }
    no-frame: root.frameless || root.chrome;
    // Fenêtre façon Windows 7 : fenêtre transparente, le fond n'est peint que dans la zone de
    // l'interface (le cadre montre le bureau flouté, voir WinCaption).
    background: root.chrome || Perf.hide(32) ? transparent : @linear-gradient(180deg, Theme.bg 0%, Theme.bg-mid 55%, Theme.bg-end 100%);
    // Captures de l'effet de langue : la même page sans texte (police vide, mêmes largeurs).
    default-font-family: Theme.aero-font ? (root.dust-blank ? "Turtlefin Blank Aero" : "Selawik")
        : root.dust-blank ? "Turtlefin Blank" : "Montserrat";
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 400px;

    // Démarrage : logo à six points (voir boot.slint et boot dans main.rs).
    in-out property <bool> boot-on: true;
    in property <[int]> boot-state: [0, 0, 0, 0, 0, 0, 0];
    in property <[string]> boot-labels: ["", "", "", "", "", "", ""];
    in property <string> boot-text;
    in property <string> boot-fail;
    in property <string> boot-fail-hint;
    in-out property <int> boot-phase;
    in-out property <bool> boot-lang-open;
    in property <string> boot-lang-title;
    in property <[TrackData]> boot-langs;
    in-out property <int> boot-lang-sel;
    callback boot-continue();
    callback boot-lang(string);
    callback boot-linked();
    in-out property <string> screen: "boot"; // "login" | "loading" | "home" | "detail" | "search" | "profile"
    in-out property <string> server;
    in-out property <string> user-name;
    in-out property <string> error-text;
    in-out property <string> toast;
    // Coin du lecteur dans la fenêtre (cadre de Windows 7, barres d'Android) : zones touchées, en Rust.
    out property <length> p-ox: max(root.safe-area-insets.left, Nav.phone && root.width > root.height ? 48px : 0px);
    out property <length> p-oy: root.chrome-top + root.safe-area-insets.top;
    // Connexion
    in-out property <string> login-mode: "pick"; // "pick" (tuiles) | "form" (identifiant, mot de passe)
    in property <[CardData]> login-tiles;
    in-out property <int> login-sel;
    in-out property <string> login-user;
    in-out property <string> login-pass;
    in-out property <int> login-field;  // 0 utilisateur · 1 mot de passe · 2 Se connecter · 3 Retour
    in-out property <bool> login-osk;   // mode TV : le clavier à l'écran a la sélection
    in-out property <string> login-user-err; // « Saisis un nom d'utilisateur. »
    property <int> login-focus-tick;         // bureau : le curseur retourne au nom d'utilisateur
    in property <string> server-name;
    in-out property <bool> busy;
    in property <bool> tv-mode;

    // Accueil
    in-out property <[Section]> sections;
    in-out property <int> sel-section: 0;
    in-out property <int> sel-item: 0;
    // Arrivée d'une page : 300 ms d'animation (zoom léger, glissement), puis la minuterie coupe
    // animation-tick() : rien n'est redessiné en continu.
    property <bool> page-anim;
    property <duration> page-t0;
    property <float> page-lin: root.page-anim && Motion.pages ? clamp((animation-tick() - root.page-t0) / 520ms, 0, 1) : 1;
    out property <float> page-e: 1 - (1 - root.page-lin) * (1 - root.page-lin) * (1 - root.page-lin);
    public function page-enter() {
        // Cartes d'une bibliothèque : arrivée en vague (voir arr-lin).
        root.arr-t0 = animation-tick();
        root.arr-anim = true;
        // Une image partagée vole vers sa place : la page ne bouge pas, pour qu'elle tombe juste
        // (sauf un grand fond : la page arrive normalement par-dessus). Le reste de la fiche arrive
        // alors l'un après l'autre (voir rev), au lieu de surgir d'un coup.
        if (root.hero-on && !root.hero-big) {
            root.rev-t0 = animation-tick();
            root.rev-anim = true;
            return;
        }
        root.page-t0 = animation-tick();
        root.page-anim = true;
    }
    // Relancée pendant qu'elle tourne, l'animation repart de zéro : on s'arrête sur le dernier départ
    // (une minuterie de la durée totale, elle, ne repart pas et coupait l'animation en route).
    Timer {
        interval: 100ms;
        running: root.page-anim;
        triggered => {
            if (animation-tick() - root.page-t0 > 540ms) {
                root.page-anim = false;
            }
        }
    }
    // Bibliothèque : les cartes arrivent en vague diagonale (haut gauche -> bas droite), chacune en
    // fondu en remontant doucement, sur une seconde (au lieu de toutes les rangées d'un coup).
    property <bool> arr-anim;
    property <duration> arr-t0;
    property <float> arr-lin: root.arr-anim && Motion.pages ? clamp((animation-tick() - root.arr-t0) / 1000ms, 0, 1) : 1;
    pure function arr(row: int, col: int) -> float {
        let x = clamp((root.arr-lin - clamp(row, 0, 6) * 0.075 - min(col, 8) * 0.045) / 0.45, 0, 1);
        return 1 - (1 - x) * (1 - x) * (1 - x) * (1 - x);
    }
    Timer {
        interval: 100ms;
        running: root.arr-anim;
        triggered => {
            if (animation-tick() - root.arr-t0 > 1050ms) {
                root.arr-anim = false;
            }
        }
    }
    // Fiche ouverte depuis une affiche : apparition échelonnée de ses éléments (0 : titre et
    // informations, 1 : boutons, 2 : résumé, 3 : saisons / épisodes, 4 : rangées du bas), en 900 ms.
    property <bool> rev-anim;
    property <duration> rev-t0;
    property <float> rev-lin: root.rev-anim && Motion.detail ? clamp((animation-tick() - root.rev-t0) / 900ms, 0, 1) : 1;
    pure function rev(i: int) -> float {
        let x = clamp((root.rev-lin - i * 0.14) / 0.44, 0, 1);
        return 1 - (1 - x) * (1 - x) * (1 - x);
    }
    Timer {
        interval: 100ms;
        running: root.rev-anim;
        triggered => {
            if (animation-tick() - root.rev-t0 > 950ms) {
                root.rev-anim = false;
            }
        }
    }
    // Chargement d'une page : un voile couleur de fond recouvre la page qui part (sauf l'image
    // partagée), puis se lève sur la nouvelle.
    in-out property <bool> loading;
    property <bool> veil-hold;               // retour animé : la fiche s'efface avant de partir
    property <float> veil: root.loading || root.veil-hold || root.kid-veil ? 1 : 0;
    // Saison ouverte depuis sa fiche : voile jusqu'à ce que l'affiche soit posée et la fiche là
    // (au plus 4 s, si quelque chose tourne mal).
    property <bool> kid-veil;
    Timer {
        interval: 4s;
        running: root.kid-veil;
        triggered => {
            root.kid-veil = false;
        }
    }
    animate veil { duration: Motion.detail ? 260ms : 0ms; easing: ease-in-out; }

    // ---- Image partagée (« hero ») : l'image de la carte ouverte (avec ses pastilles) vole jusqu'à
    // la place de l'affiche de la page ouverte : fiche, ou page Seerr (vignette 16:9 vers une fiche :
    // tout l'écran, en fond provisoire qui s'efface ensuite). Au retour, l'affiche reste d'abord
    // en place pendant que la page s'efface, puis vole vers la position exacte de sa carte, une fois
    // celle-ci affichée. Animations au temps (animation-tick), coupées par des minuteries.
    property <bool> hero-on;
    property <bool> hero-dest;              // vers la page ouverte (sinon retour vers la carte)
    property <bool> hero-flying;            // retour : le vol a commencé (avant : immobile sur l'affiche)
    property <length> hero-fx;
    property <length> hero-fy;
    property <length> hero-fw;
    property <length> hero-fh;
    property <image> hero-img;
    property <CardData> hero-data;
    property <float> hero-k: 1.0;
    property <bool> hero-wide;
    property <bool> hero-seerr;             // destination : la page Seerr
    // Collection : l'affiche va au centre de l'écran (un paquet de cartes), puis ses films sont
    // distribués un à un jusqu'à leur place dans la grille, comme au solitaire (voir deal-p).
    property <bool> hero-deck;
    property <bool> deal-anim;
    property <duration> deal-t0;
    // Cartes distribuées : celles qui tiennent à l'écran (posé par la grille) ; les suivantes, hors de
    // vue, attendent à leur place (rien à dessiner ni à animer, voir la grille de la bibliothèque).
    in-out property <int> deal-n: 20;
    // Durée de la distribution : un départ toutes les 70 ms, 420 ms de vol chacun.
    property <duration> deal-len: 260ms + min(root.lib-items.length, root.deal-n) * 70ms + 420ms;
    changed deal-anim => {
        // Distribution finie : le paquet (l'image partagée) s'efface sur place.
        if (!root.deal-anim && root.hero-deck && root.hero-on) {
            root.hero-out-t0 = animation-tick();
            root.hero-out = true;
        }
    }
    Timer {
        interval: root.deal-len;
        running: root.deal-anim;
        triggered => {
            root.deal-anim = false;
        }
    }
    // Avancement de la carte n° i de la grille (0 : dans le paquet, au centre · 1 : à sa place).
    // Collection ouverte, distribution pas encore commencée : les cartes restent dans le paquet.
    property <bool> deal-wait: root.hero-deck && root.hero-on && root.hero-dest && !root.deal-anim && !root.hero-out && !root.loading;
    pure function deal-p(i: int) -> float {
        // Hors de l'écran à l'arrivée : déjà à sa place (jamais vue en vol).
        if (i >= root.deal-n) {
            return 1;
        }
        if (root.deal-wait && Motion.detail) {
            return 0;
        }
        if (!root.deal-anim || !Motion.detail) {
            return 1;
        }
        let t = clamp((animation-tick() - root.deal-t0 - 260ms - i * 70ms) / 420ms, 0, 1);
        return 1 - (1 - t) * (1 - t) * (1 - t);
    }
    property <string> hero-id;              // page ouverte depuis une carte : retour animé
    property <bool> hero-anim;
    property <duration> hero-t0;
    property <float> hero-q: root.hero-anim && Motion.detail ? clamp((animation-tick() - root.hero-t0) / root.hero-dur, 0, 1) : 1;
    // Portrait, vignette 16:9 ouverte : « porte ». La carte vient au centre (0 à 0,32), s'ouvre en deux
    // battants (0,32 à 0,62) qui laissent sortir l'affiche, puis l'affiche vole à sa place sur la
    // fiche (0,62 à 1). Étirée à tout l'écran comme en paysage, la vignette en débordait largement.
    property <bool> hero-door: root.hero-wide && root.narrow && !root.hero-seerr && root.hero-dest;
    property <duration> hero-dur: root.hero-door ? 1150ms : 480ms;
    pure function door-e(a: float, b: float) -> float {
        let x = clamp((root.hero-q - a) / (b - a), 0, 1);
        return x < 0.5 ? 4 * x * x * x : 1 - (-2 * x + 2) * (-2 * x + 2) * (-2 * x + 2) / 2;
    }
    property <float> door-move: root.door-e(0, 0.32);
    property <float> door-open: root.door-e(0.32, 0.62);
    property <float> door-fly: root.door-e(0.62, 1);
    // Carte au centre : plus grande, sans dépasser l'écran.
    property <length> door-w: min(root.width - 48px * root.k, 560px * root.k);
    property <length> door-h: root.door-w * 0.5625;
    property <length> door-x: (root.width - root.door-w) / 2;
    property <length> door-y: (root.height - root.door-h) / 2;
    property <float> hero-e: root.hero-q < 0.5 ? 4 * root.hero-q * root.hero-q * root.hero-q
        : 1 - (-2 * root.hero-q + 2) * (-2 * root.hero-q + 2) * (-2 * root.hero-q + 2) / 2;
    // 0 : sur la carte · 1 : sur la page.
    property <float> hero-p: root.hero-dest ? root.hero-e : root.hero-flying ? 1 - root.hero-e : 1;
    // Grand fond 16:9 : fondu (sortie quand la page est là, entrée au retour).
    property <bool> hero-faded;
    property <bool> fade-in;
    property <bool> fade-anim;
    property <duration> fade-t0;
    property <float> fade-q: root.fade-anim && Motion.detail ? clamp((animation-tick() - root.fade-t0) / 700ms, 0, 1) : 1;
    property <float> hero-alpha: root.fade-anim ? (root.fade-in ? root.fade-q : 1 - root.fade-q) : (root.hero-faded ? 0 : 1);
    // Destination : affiche de la fiche, affiche de la page Seerr, ou tout l'écran (16:9 -> fiche).
    property <length> sr-u: min(root.height / 720px, root.width / 1280px) * 1px;
    property <length> hero-tx: root.hero-deck ? (root.width - root.hero-tw) / 2 : root.hero-seerr ? 40 * root.sr-u : root.hero-wide && !root.hero-door ? 0px : root.narrow ? 16px : 32px;
    property <length> hero-ty: root.hero-deck ? (root.height - root.hero-th) / 2 : root.hero-seerr ? 40 * root.sr-u : root.hero-wide && !root.hero-door ? 0px : root.header-h + 24px;
    property <length> hero-tw: root.hero-deck ? root.hero-fw * 1.25 : root.hero-seerr ? 200 * root.sr-u : root.hero-wide && !root.hero-door ? root.width : root.poster-w;
    property <length> hero-th: root.hero-deck ? root.hero-fh * 1.25 : root.hero-seerr ? 300 * root.sr-u : root.hero-wide && !root.hero-door ? root.height : root.poster-w * 1.5;
    property <bool> hero-big: root.hero-wide && !root.hero-seerr && !root.hero-door;
    // Lignes du haut de l'image à rogner (rayon des coins intégrés, en pixels de l'image).
    property <int> hero-crop: root.hero-big && root.hero-fw > 0
        ? round(min(1, 5 * root.hero-p) * root.hero-img.width * Theme.radius * 1.15 / (root.hero-fw / 1.06)) : 0;
    // Fiche ouverte depuis une vignette 16:9 : opacité de la page (0 au début du vol, 1 à la fin).
    property <float> hero-page-a: root.hero-on && root.hero-big && root.hero-dest
        ? clamp((root.hero-q - 0.45) / 0.55, 0, 1)
        // Porte : la fiche apparaît pendant que l'affiche sort.
        : root.hero-on && root.hero-door ? clamp((root.hero-q - 0.5) / 0.4, 0, 1) : 1;
    // L'affiche de la page ouverte est cachée tant que l'image partagée vole (elle prend le relais).
    property <bool> hero-covers: root.hero-on && root.hero-dest;
    property <string> hero-from-id;          // retour : page quittée (l'image attend qu'elle soit partie)
    // La page ouverte est affichée.
    property <bool> hero-ready: root.hero-on && root.hero-dest && !root.hero-anim && !root.loading && (root.hero-seerr
        ? root.sr-open && !root.sr.loading
        : root.screen == "detail" ? root.detail.id == root.hero-id
        : root.screen != "home" && root.screen != "loading");
    changed hero-ready => {
        if (root.hero-ready) {
            root.kid-veil = false;
        }
        // Collection arrivée : la distribution commence (les cartes partent du paquet).
        if (root.hero-ready && root.hero-deck) {
            root.deal-t0 = animation-tick();
            root.deal-anim = true;
        }
        if (root.hero-ready && root.hero-big && !root.hero-faded) {
            root.fade-in = false;
            root.fade-t0 = animation-tick();
            root.fade-anim = true;
            root.hero-faded = true;
        }
    }
    // L'affiche de la page met du temps (ou n'existe pas) : on n'attend pas plus de 1,2 s.
    property <bool> hero-gave-up;
    Timer {
        interval: 1200ms;
        running: root.hero-ready && !root.hero-gave-up;
        triggered => {
            root.hero-gave-up = true;
        }
    }
    // Fin : l'affiche de la page (ou la carte, au retour) a pris le relais.
    property <bool> hero-done: root.hero-on && !root.hero-anim && !root.fade-anim && !(root.hero-deck && root.hero-dest) && (
        (root.hero-ready && (root.hero-big ? root.hero-faded
            : root.hero-seerr ? root.sr.has-poster || root.hero-gave-up
            : root.screen != "detail" || root.detail.has-poster || root.hero-gave-up))
        // Retour : la carte reprend la main une fois posée et la page arrivée (plus rien ne bouge).
        || (!root.hero-dest && root.hero-flying && !root.page-anim));
    changed hero-done => {
        if (root.hero-done) {
            root.hero-on = false;
        }
    }
    changed hero-on => {
        if (!root.hero-on) {
            Hero.hide-id = "";
            Hero.want-id = "";
            Hero.want-group = "";
            root.hero-flying = false;
            root.hero-out = false;
        }
    }
    Timer {
        interval: root.hero-dur + 20ms;
        running: root.hero-anim;
        triggered => {
            root.hero-anim = false;
        }
    }
    Timer {
        interval: 720ms;
        running: root.fade-anim;
        triggered => {
            root.fade-anim = false;
        }
    }
    // Sécurité : jamais d'image partagée oubliée à l'écran.
    Timer {
        interval: 6s;
        running: root.hero-on;
        triggered => {
            root.hero-on = false;
        }
    }

    // Ouverture d'un élément depuis une carte : l'image de la carte sélectionnée vole vers la page.
    // La carte répond juste après (rappel `changed`), d'où les deux temps.
    property <string> hero-pending;
    pure callback is-seerr(string) -> bool;   // identifiant « seerr:… » (Rust : Slint n'a pas de starts-with)
    function open-hero(id: string) {
        root.hero-id = "";
        root.hero-pending = "";
        // Fiche : rangées du bas (autre média), et saisons : l'affiche vole jusqu'à sa place. Saison : la
        // fiche s'efface autour d'elle (kid-veil), puis la nouvelle arrive en douceur (detail-swap).
        // Épisodes (vignettes) : la fiche change en douceur, sans image qui vole.
        let kid = root.screen == "detail" && root.d-zone == 2 && !root.detail.children-landscape;
        if (root.screen == "home" || root.screen == "library" || root.screen == "search" || root.screen == "downloads"
                || (root.screen == "detail" && root.d-zone >= 4) || kid) {
            root.hero-pending = id;
            Hero.tick += 1;
            root.kid-veil = kid && Motion.detail;
        }
        root.open-item(id);
    }
    // Retour : l'image attend que sa carte soit affichée, puis vole exactement jusqu'à elle.
    property <bool> hero-wait: root.hero-on && !root.hero-dest && !root.hero-flying && !root.hero-out && !root.loading && !root.veil-hold
        && !root.sr-open && root.screen != "loading" && !(root.screen == "detail" && root.detail.id == root.hero-from-id);
    Timer {
        interval: 60ms;
        running: root.hero-wait;
        triggered => {
            Hero.tick += 1;
        }
    }
    Timer {
        interval: 700ms;
        running: root.hero-wait;
        triggered => {
            // Carte introuvable (plus affichée, vue en entier…) : l'image s'efface en fondu sur place.
            root.hero-out-t0 = animation-tick();
            root.hero-out = true;
        }
    }
    property <bool> hero-out;
    property <duration> hero-out-t0;
    property <float> hero-out-a: root.hero-out && Motion.detail ? 1 - clamp((animation-tick() - root.hero-out-t0) / 220ms, 0, 1) : root.hero-out ? 0 : 1;
    Timer {
        interval: 240ms;
        running: root.hero-out;
        triggered => {
            root.hero-on = false;
        }
    }
    // Retour en vol : la page d'arrivée fait encore son entrée (rangées qui glissent, léger zoom) ;
    // la carte redonne sa position à chaque image et l'image suit, sans viser une place périmée.
    Timer {
        interval: 16ms;
        running: root.hero-on && !root.hero-dest && root.hero-flying;
        triggered => {
            Hero.tick += 1;
        }
    }
    property <int> hero-seq: Hero.seq;
    changed hero-seq => {
        if (root.hero-pending == "" && root.hero-on && !root.hero-dest && root.hero-flying) {
            root.hero-fx = Hero.x;
            root.hero-fy = Hero.y;
            root.hero-fw = Hero.w;
            root.hero-fh = Hero.h;
            return;
        }
        if (root.hero-pending == "" && root.hero-wait && Hero.data.id != "") {
            root.hero-fx = Hero.x;
            root.hero-fy = Hero.y;
            root.hero-fw = Hero.w;
            root.hero-fh = Hero.h;
            root.hero-data = Hero.data;
            Hero.hide-id = Hero.data.id;
            root.hero-t0 = animation-tick();
            root.hero-anim = true;
            root.hero-flying = true;
            return;
        }
        if (root.hero-pending != "") {
            root.hero-fx = Hero.x;
            root.hero-fy = Hero.y;
            root.hero-fw = Hero.w;
            root.hero-fh = Hero.h;
            root.hero-img = Hero.img;
            root.hero-data = Hero.data;
            root.hero-k = Hero.k;
            root.hero-seerr = root.is-seerr(root.hero-pending);
            root.hero-wide = Hero.wide;
            root.hero-deck = Hero.data.deck;
            root.deal-anim = false;
            root.hero-faded = false;
            root.hero-gave-up = false;
            root.fade-anim = false;
            root.hero-dest = true;
            root.hero-flying = false;
            root.hero-t0 = animation-tick();
            root.hero-anim = true;
            root.hero-on = true;
            Hero.hide-id = Hero.data.id;
            root.hero-id = root.hero-pending;
            root.hero-pending = "";
        }
    }

    // Retour : depuis la page ouverte par une carte, l'image reste en place pendant que la page
    // s'efface, puis repart vers la carte.
    function hero-return() {
        // Fiche quittée : l'image attend qu'elle soit partie. Page Seerr fermée au-dessus d'une fiche :
        // la fiche reste, l'image repart tout de suite vers sa carte (sinon elle restait figée).
        root.hero-from-id = root.screen == "detail" && !root.sr-open ? root.detail.id : "";
        // Retour d'une collection : l'affiche revole normalement vers sa carte.
        root.hero-deck = false;
        root.deal-anim = false;
        Hero.want-id = root.hero-data.id;
        Hero.want-group = root.hero-data.group;
        root.hero-dest = false;
        root.hero-flying = false;
        root.hero-anim = false;
        root.hero-gave-up = false;
        root.hero-on = true;
        if (root.hero-big) {
            root.fade-in = true;
            root.fade-t0 = animation-tick();
            root.fade-anim = true;
            root.hero-faded = false;
        }
        root.hero-id = "";
    }
    function back-anim() {
        if (root.veil-hold) {
            return; // retour déjà en cours
        }
        // Fiche descendue (rangées du bas, épisodes) : son affiche n'est plus à l'écran, rien ne
        // revole vers la carte (l'image réapparaîtrait de nulle part).
        if (root.screen == "detail" && root.hero-id != "" && root.detail.id == root.hero-id && root.d-view-y < root.poster-w * 0.5) {
            root.hero-return();
        }
        root.hero-id = "";
        // Fiche -> fiche précédente : rien ne s'efface, la fiche change en douceur.
        if (root.screen == "detail" && root.back-soft) {
            root.run-action("back");
            return;
        }
        root.nav-out("back", "");
    }
    in property <bool> back-soft;           // la page précédente est une fiche (Rust)
    // Fermeture de la page Seerr (Échap, Retour, bouton Fermer).
    function seerr-close() {
        if (root.hero-id != "" && root.hero-seerr) {
            root.hero-return();
        }
        // La page s'efface (et recule un peu) au lieu de disparaître d'un coup ; l'affiche repart
        // vers sa carte par-dessus.
        if (Motion.pages) {
            root.sr-out-t0 = animation-tick();
            root.sr-out = true;
        }
        root.sr-open = false;
        root.refocus += 1;
    }
    property <bool> sr-out;
    property <duration> sr-out-t0;
    Timer {
        interval: 320ms;
        running: root.sr-out;
        triggered => {
            root.sr-out = false;
        }
    }
    // Changement de page sans image partagée (maison, retour, menu, Échap) : la page s'efface dans
    // le fond (voile), l'action a lieu, puis la nouvelle page arrive (page-enter, rangées en cascade).
    property <string> nav-kind;
    property <string> nav-arg;
    function nav-out(kind: string, arg: string) {
        if (root.veil-hold) {
            return; // une transition est déjà en cours
        }
        if (kind == "menu" && root.at(arg)) {
            return; // déjà ici : rien à recharger
        }
        root.nav-kind = kind;
        root.nav-arg = arg;
        root.veil-hold = true;
    }
    Timer {
        interval: 240ms;
        running: root.veil-hold;
        triggered => {
            root.veil-hold = false;
            if (root.nav-kind == "back") {
                root.run-action("back");
            } else if (root.nav-kind == "go-home") {
                root.go-home();
            } else {
                root.menu-action(root.nav-arg);
            }
            // Même écran (fiche -> fiche, accueil rechargé...) : l'arrivée est rejouée quand même.
            root.page-enter();
        }
    }
    // Arrivée en cascade : décalage vertical de l'élément n° i (rangées, lignes de grille).
    pure function stagger(i: int) -> length {
        return (1 - clamp(root.page-lin * 1.9 - min(i, 5) * 0.18, 0, 1)) * 70px * root.k;
    }
    Timer {
        interval: 20s;
        running: root.loading;
        triggered => {
            root.loading = false;
        }
    }

    property <duration> d-t0;                // arrivée de la fiche affichée
    changed screen => {
        root.party-pop = false;
        root.cast-pop = false;
        root.drop-keyboard();
        root.tour-ev(6);
        if (root.fly-phase == 1 || root.fly-phase == 2) {
            if (root.screen == "home") {
                root.fly-start(3);
            } else if (root.screen != "login" && root.screen != "loading") {
                root.fly-phase = 0;
            }
        }
        // Effet de langue en cours sur une page quittée : les mots reviennent, la liste se ferme.
        if (root.dust-cloud) {
            root.ch-key = "";
        }
        if (root.screen == "detail") {
            root.d-t0 = animation-tick();
        }
        root.loading = false;
        if (root.screen != "login") {
            root.page-enter();
        }
        if (root.screen == "login") {
            root.login-mode = "pick";
            root.login-osk = false;
            root.login-opened();
        }
    }
    changed sel-item => {
        root.row-seen(root.sel-section, root.sel-item);
        root.tour-ev(1);
    }

    // ---- Changement de fiche sans quitter l'écran (épisode, saison, série...) : rien ne s'efface ;
    // seuls les éléments dont le contenu change réapparaissent en fondu (drapeaux posés par les
    // `changed` ci-dessous, après detail-swap()). L'affiche fait un fondu enchaîné si elle change.
    in-out property <int> d-press;           // appui sur un bouton de la fiche (animation)
    property <bool> sw-anim;
    property <duration> sw-t0;
    property <float> sw-q: root.sw-anim && Motion.detail ? clamp((animation-tick() - root.sw-t0) / 420ms, 0, 1) : 1;
    property <float> sw-e: 1 - (1 - root.sw-q) * (1 - root.sw-q);
    property <bool> sw-title;
    property <bool> sw-sub;
    property <bool> sw-icons;
    property <bool> sw-chips;
    property <bool> sw-misc;
    property <bool> sw-ov;
    property <bool> sw-next;
    property <bool> sw-kids;
    public function detail-swap() {
        root.d-t0 = animation-tick();
        root.sw-title = false;
        root.sw-sub = false;
        root.sw-icons = false;
        root.sw-chips = false;
        root.sw-misc = false;
        root.sw-ov = false;
        root.sw-next = false;
        root.sw-kids = false;
        root.sw-t0 = animation-tick();
        root.sw-anim = true;
    }
    Timer {
        interval: 440ms;
        running: root.sw-anim;
        triggered => {
            root.sw-anim = false;
        }
    }
    property <string> w-logo-key: root.detail.logo-key;
    changed w-logo-key => {
        root.sw-title = true;
    }
    property <bool> w-has-logo: root.detail.has-logo;
    changed w-has-logo => {
        root.sw-title = true;
    }
    property <string> w-title: root.detail.title;
    changed w-title => {
        root.sw-title = true;
    }
    property <string> w-subtitle: root.detail.subtitle;
    changed w-subtitle => {
        root.sw-sub = true;
    }
    property <string> w-icons-sig: root.detail.icons-sig;
    changed w-icons-sig => {
        root.sw-icons = true;
    }
    property <string> w-chips-sig: root.detail.chips-sig;
    changed w-chips-sig => {
        root.sw-chips = true;
    }
    property <string> w-misc: root.detail.misc;
    changed w-misc => {
        root.sw-misc = true;
    }
    property <string> w-overview: root.detail.overview;
    changed w-overview => {
        root.sw-ov = true;
    }
    property <string> w-next-id: root.detail.next-id;
    changed w-next-id => {
        root.sw-next = true;
    }
    property <string> w-children-sig: root.detail.children-sig;
    changed w-children-sig => {
        root.sw-kids = true;
    }
    // Affiche : l'ancienne reste dessous (posée par Rust) jusqu'à ce que la nouvelle l'ait recouverte.
    in-out property <image> d-poster-old;
    in-out property <bool> d-poster-swap;
    property <bool> pm-anim;
    property <duration> pm-t0;
    property <float> pm: root.pm-anim && Motion.detail ? clamp((animation-tick() - root.pm-t0) / 450ms, 0, 1) : 1;
    property <bool> w-has-poster: root.detail.has-poster;
    changed w-has-poster => {
        if (root.detail.has-poster && root.d-poster-swap) {
            root.pm-t0 = animation-tick();
            root.pm-anim = true;
        }
    }
    Timer {
        interval: 470ms;
        running: root.pm-anim;
        triggered => {
            root.pm-anim = false;
            root.d-poster-swap = false;
        }
    }
    // Rangées du bas (plus de ce genre...) : elles arrivent après coup, en fondu.
    property <bool> rows-anim;
    property <duration> rows-t0;
    property <float> rows-a: root.rows-anim && Motion.pages ? clamp((animation-tick() - root.rows-t0) / 400ms, 0, 1) : 1;
    changed detail-rows => {
        root.rows-t0 = animation-tick();
        root.rows-anim = true;
    }
    // Relancée pendant qu'elle tourne, l'animation repart de zéro : on s'arrête sur le dernier départ
    // (une minuterie de la durée totale, elle, ne repart pas et coupait l'animation en route).
    Timer {
        interval: 100ms;
        running: root.rows-anim;
        triggered => {
            if (animation-tick() - root.rows-t0 > 420ms) {
                root.rows-anim = false;
            }
        }
    }
    changed login-user => {
        if (root.login-user != "") {
            root.login-user-err = "";
        }
    }
    changed login-mode => {
        if (root.login-mode != "form") {
            root.drop-keyboard();
        }
        root.login-user-err = "";
        root.login-osk = false;
        // Retour aux comptes : l'ancien message n'a plus lieu d'être (« Session expirée » reste, lui,
        // à l'ouverture du formulaire).
        if (root.login-mode == "pick") {
            root.error-text = "";
        }
        // Le champ qui avait le clavier disparaît : la page le reprend.
        root.refocus += 1;
    }

    // ---- Fond d'écran : image (floutée, assombrie) du média sélectionné, en fondu enchaîné.
    in-out property <image> bg-a;
    in-out property <image> bg-b;
    in-out property <bool> bg-flip;          // false : bg-a visible · true : bg-b visible
    in-out property <bool> bg-show;
    callback backdrop-for(string);
    property <float> bg-mix: root.bg-flip ? 1 : 0;
    animate bg-mix { duration: Motion.pages ? 800ms : 0ms; easing: ease-in-out; }
    property <float> bg-vis: root.bg-show && root.screen != "login" ? 1 : 0;
    animate bg-vis { duration: Motion.pages ? 600ms : 0ms; easing: ease-in-out; }
    // Média sélectionné (accueil, bibliothèque, fiche) : Rust attend un instant puis charge son fond.
    property <string> focus-id: root.screen == "home" && !root.h-focus && root.sel-section < root.sections.length
            && root.sel-item < root.sections[root.sel-section].items.length
        ? root.sections[root.sel-section].items[root.sel-item].id
        : root.screen == "library" && root.l-sel < root.lib-items.length ? root.lib-items[root.l-sel].id
        : root.screen == "downloads" && root.dl-sec < root.dl-sections.length
            && root.dl-item < root.dl-sections[root.dl-sec].items.length ? root.dl-sections[root.dl-sec].items[root.dl-item].id
        : root.screen == "detail" ? root.detail.id : "";
    changed focus-id => {
        root.backdrop-for(root.focus-id);
    }
    changed d-x => {
        root.row-seen(1000 + root.d-zone, root.d-x);
    }
    changed d-child => {
        root.row-seen(1002, root.d-child);
    }
    changed s-item => {
        root.row-seen(2000 + root.s-section, root.s-item);
    }
    in-out property <string> tab: "home";    // onglet affiché : "home" | "favorites" | "requests"
    in property <bool> has-requests;         // Seerr disponible : onglet Demandes
    in-out property <bool> h-focus: false;   // la sélection est dans l'en-tête
    in-out property <int> h-sel: 0;          // onglets (Accueil, Favoris, [Demandes]), puis Recherche, Profil
    in property <string> clock;              // « 16:52 »
    in-out property <int> prof-sel: 1;      // écran Profil : 0 Réglages · 1 Déconnexion

    // Navigation commune : bouton Retour (si l'on a navigué), menu latéral
    in property <bool> can-back;
    in-out property <bool> menu-open;
    in-out property <int> menu-sel;
    in property <[MenuEntry]> menu-entries;
    in-out property <string> soon-title: Tr.t(Tr.k, "Recherche"); // écran « bientôt disponible »
    in-out property <int> refocus;          // incrémenté : l'écran affiché reprend le clavier

    // Choix du serveur
    in property <[ServerData]> servers;
    in property <bool> srv-searching;
    in-out property <int> srv-sel;
    in-out property <bool> manual-open;
    in-out property <string> manual-error;
    in property <bool> manual-busy;
    in property <string> choice-a;          // deux adresses répondent (http et https) : laquelle ?
    in property <string> choice-b;

    // Paramètres : catégories à gauche (0 Compte · 1 Lecture · 2 Sous-titres · 3 Affichage · 4 Réseau · 5 À propos), lignes à droite
    in-out property <int> set-cat;
    // Liste de choix d'un réglage (Paramètres) : clé du réglage ("" : fermée), titre, options.
    in-out property <string> ch-key;
    in property <string> ch-title;
    // Titre de la liste des langues au choix d'une langue (Rust : choose_setting) : comme les
    // autres textes, une barre le recouvre de blanc, le bloc prend la largeur du nouveau titre, puis
    // la barre le dévoile. Rien avant le choix (le titre reste lisible), ni à l'annulation.
    property <string> ch-title-old;
    property <duration> ch-title-t0;
    property <bool> ch-title-live;
    public function ch-title-cover() {
        root.ch-title-old = root.ch-title;
        root.ch-title-t0 = animation-tick();
        root.ch-title-live = true;
    }
    Timer {
        interval: 500ms;
        running: root.ch-title-live;
        triggered => {
            if (animation-tick() - root.ch-title-t0 > 900ms) {
                root.ch-title-live = false;
            }
        }
    }
    in property <[TrackData]> ch-items;
    in-out property <int> ch-sel;
    callback settings-choose(string, string);
    in-out property <int> set-sel;
    in-out property <bool> set-in;           // sélection dans le panneau de droite
    in property <[SettingRow]> set-rows;
    // Ligne réglable suivante (dir = 1) ou précédente (-1) à partir de `sel` ; depuis -1 avec dir = 1 :
    // la première. Les lignes d'information sont sautées ; s'il n'y en a pas d'autre, `sel` revient.
    pure callback settings-step(int /* sel */, int /* dir */) -> int;
    // Choix de l'avatar (Compte > Photo de profil)
    in-out property <bool> av-open;
    in property <[CardData]> av-groups;     // catégories : nom (title) et nombre d'avatars (count)
    in property <int> av-total;
    in-out property <int> av-group;
    in-out property <int> av-zone;          // 0 catégories · 1 grille
    in-out property <int> av-sel;
    in-out property <int> av-top;           // première rangée affichée de la grille
    in-out property <int> g-top;            // première catégorie affichée
    in-out property <int> av-press;         // incrémenté à chaque choix (rebond de la case)
    in property <string> av-busy;           // avatar en cours d'envoi
    in property <string> av-current;        // avatar appliqué pendant cette session
    callback avatar-group(int);
    callback avatar-focus(int);
    callback avatar-want(int);              // la grille montre les N premiers avatars : images à charger
    changed av-sel => {
        root.avatar-focus(root.av-sel);
    }
    // Choix fermé : images et animation des avatars libérées.
    changed av-open => {
        if (!root.av-open) {
            root.avatar-focus(-1);
        }
    }
    // Saisie d'une adresse (Réseau) : 0 fermée · 1 principale · 2 secours
    in-out property <int> addr-edit;
    in-out property <string> addr-text;
    // Renommer un écran (mode 7) : son nom d'origine, montré en exemple dans le champ.
    in property <string> addr-hint;
    in-out property <string> addr-err;
    in property <bool> addr-busy;
    in-out property <bool> addr-osk;
    in-out property <int> addr-field;       // 0 champ · 1 Enregistrer · 2 Annuler
    // addr-edit : 1 adresse principale · 2 de secours · 3 mot de passe administrateur (mise à jour .deb)
    // · 4, 5, 6 : changer le mot de passe du compte (actuel, nouveau, confirmation).
    callback addr-save(int, string);
    callback addr-closed();
    // Solidité d'un mot de passe tapé (0 trop simple … 4 solide, voir password.rs).
    pure callback pw-score(string) -> int;
    // Étape 3 : la saisie est-elle le nouveau mot de passe de l'étape 2 ?
    pure callback pw-same(string) -> bool;
    // Fenêtre fermée : la page des paramètres reprend le clavier.
    // Mode de la fenêtre gardé pendant sa disparition : titre, champ masqué et boutons ne changent
    // pas pendant le fondu (sinon un mot de passe s'affichait en clair le temps de la sortie).
    property <int> ad-mode;
    changed addr-edit => {
        if (root.addr-edit > 0) {
            root.ad-mode = root.addr-edit;
        }
        if (root.addr-edit == 0) {
            root.drop-keyboard();
            root.refocus += 1;
            root.addr-closed();
        }
    }
    // Changer le mot de passe : l'erreur s'efface dès qu'on retape (pas quand le champ est vidé
    // par le passage à une autre étape, qui peut poser sa propre erreur).
    changed addr-text => {
        if (root.addr-edit >= 4 && root.addr-edit <= 6 && root.addr-text != "") {
            root.addr-err = "";
        }
    }
    // Mot de passe trop simple : salves de clignotement (1,8 s toutes les 6 s), voir Alert.
    Timer {
        interval: Alert.live ? 1800ms : 4200ms;
        running: Alert.weak-pw && !root.playing;
        triggered => {
            Alert.live = !Alert.live;
        }
    }
    changed manual-open => {
        if (!root.manual-open) {
            root.drop-keyboard();
        }
    }
    // Champ de saisie fermé avec son écran (sans perdre le clavier avant) : le clavier virtuel
    // d'Android resterait ouvert ; il est rangé, et l'écran n'a plus à remonter (voir Kb).
    function drop-keyboard() {
        Kb.field-bottom = 0;
        root.hide-keyboard();
    }
    callback hide-keyboard();
    function addr-close() {
        root.addr-edit = 0;
        root.addr-osk = false;
        root.addr-err = "";
    }
    in property <[CardData]> avatar-items;
    in property <image> avatar;
    // Avatar animé : ses images (vide : `avatar`, fixe) et celle montrée (voir show_frames).
    in property <[image]> avatar-frames;
    in property <int> avatar-idx;
    in property <bool> has-avatar;
    in property <bool> offline;             // pas de serveur : téléchargements seulement
    in property <bool> signed-in;           // une session est ouverte (en ligne ou hors ligne)
    // Paramètres → À propos : fenêtre des nouveautés d'une mise à jour (défile, Échap la ferme).
    in-out property <bool> notes-open;
    in property <string> notes-text;

    // Page Seerr (premier plan)
    in-out property <bool> sr-open;
    in property <SeerrPage> sr;
    in property <[CardData]> sr-cast;
    in-out property <int> sr-sel;           // 0 bouton Demander · 1 Fermer
    in-out property <length> sr-scroll;

    // Téléchargements : liste générale (séries, films) > saisons d'une série > épisodes d'une saison
    in property <[CardData]> dl-items;
    in property <[Section]> dl-sections;    // rangées (Reprendre, Séries, Films)
    in-out property <int> dl-sec;
    in-out property <int> dl-item;
    in property <[bool]> dl-folders;        // la carte s'ouvre (série, saison) au lieu de se lire
    in property <[DlInfo]> dl-infos;        // infos de la carte sélectionnée (bas de l'écran)
    in property <int> dl-level;             // 0 liste générale · 1 série · 2 saison
    in property <bool> dl-landscape;        // épisodes : vignettes 16:9
    in property <string> dl-title: Tr.t(Tr.k, "Téléchargements");
    in property <string> dl-status;
    in property <string> dl-pill;           // pastille de la barre du haut : « 42 % », « En pause »
    in property <float> dl-p;
    in property <bool> dl-paused;
    in-out property <int> dl-sel;
    in-out property <bool> dl-dialog;       // Lire / Supprimer / Annuler
    in-out property <int> dl-dsel;

    // Watch party
    in property <bool> sp-active;
    in property <string> sp-name;
    in property <string> sp-people;
    in property <int> sp-count;              // participants de la watch party
    in property <[string]> sp-list;          // leurs noms
    in property <[string]> sp-initials;      // et leurs initiales
    in property <string> sp-now;             // ce que le groupe regarde (vide : rien)
    in property <string> sp-state;
    in property <[MenuEntry]> sp-groups;     // label, action = identifiant du groupe
    in-out property <int> sp-sel;
    // Diffuser (voir cast.rs) : écran où les vidéos sont envoyées (télé DLNA, Turtlefin ou appli Jellyfin
    // du compte), choisi dans le panneau sous l'icône ; le panneau montre ensuite ce qui y passe.
    in-out property <bool> cast-pop;
    in property <[CastItem]> cast-items;
    in property <bool> cast-busy;          // recherche des appareils en cours
    in-out property <int> cast-sel;        // clavier : appareils, puis commandes, puis « Arrêter »
    in-out property <int> cast-ctl: 2;     // clavier : bouton choisi dans la rangée des commandes
    in property <bool> cast-on;            // un écran est choisi
    in property <string> cast-target;      // son nom
    in property <string> cast-now;         // titre en cours sur cet écran
    in property <bool> cast-paused;
    in property <float> cast-pos;          // avancement (0 à 1)
    in property <string> cast-time;        // « 12:03 / 47:59 »
    // Pistes de la vidéo diffusée (id : index Jellyfin, « -1 » : sans sous-titres) et liste ouverte
    // (« audio », « sub », ou "" : aucune).
    in property <[TrackData]> cast-audio;
    in property <[TrackData]> cast-subs;
    property <string> cast-trk;
    // Panneau ouvert depuis le lecteur : l'écran choisi reçoit la vidéo en cours.
    in-out property <bool> cast-handoff;
    // Lecteur en télécommande d'un écran de diffusion (voir PlayerView.remote).
    in-out property <bool> p-remote;
    in property <bool> p-remote-nodur;
    in property <string> p-remote-busy;
    callback cast-reopen();
    callback cast-track(string, string);
    callback player-cast();
    // Télécommande (menu) : un autre Turtlefin du compte, piloté comme avec sa télécommande.
    in-out property <bool> remote-open;
    in property <[CastItem]> remote-items; // Turtlefin à piloter (liste avant le choix)
    in property <bool> remote-busy;
    in-out property <int> remote-pick-sel;
    in property <string> remote-target;    // nom du Turtlefin piloté ("" : liste)
    in property <string> remote-now;       // titre en cours sur l'appareil
    in property <bool> remote-paused;
    in property <float> remote-pos;        // avancement (0 à 1)
    in property <string> remote-time;      // « 12:03 / 47:59 »
    in-out property <int> remote-sel: 4;   // bouton choisi au clavier (voir RemotePad)
    callback cast-refresh();
    callback cast-pick(string);
    callback cast-stop();
    callback cast-cmd(string);
    callback remote-pick(string);
    callback remote-closed();
    callback remote-cmd(string);
    property <float> cast-p: root.cast-pop ? 1 : 0;
    animate cast-p { duration: Motion.panels ? 260ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    property <float> remote-p: root.remote-open ? 1 : 0;
    animate remote-p { duration: Motion.panels ? 300ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    // Panneau refermé, quel que soit le chemin (icône, Échap, à côté, Rust) : la page reprend le
    // clavier (sinon le panneau disparu le gardait, et plus rien ne répondait).
    changed cast-pop => {
        if (!root.cast-pop) {
            root.refocus += 1;
        } else {
            root.drop-to(1);
        }
    }
    changed party-pop => {
        if (!root.party-pop) {
            root.refocus += 1;
        } else {
            root.drop-to(2);
        }
    }
    // Cadre commun des panneaux du haut à droite (0 ⋯, 1 Diffuser, 2 Watch party) : passer de l'un à
    // l'autre le redimensionne au lieu de le faire disparaître puis réapparaître ; seul le contenu
    // change, en fondu. Ouvert depuis rien, il prend sa taille tout de suite (et descend, comme avant).
    property <bool> drop-open: (root.more-open && !root.playing) || root.cast-pop || (root.party-pop && !root.playing);
    property <float> drop-p: root.drop-open ? 1 : 0;
    animate drop-p { duration: Motion.panels ? 260ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    property <int> drop-kind;
    property <bool> drop-morph;
    function drop-to(kind: int) {
        // Un autre panneau était ouvert (il se referme dans le même geste) : le cadre se redimensionne.
        root.drop-morph = root.drop-p > 0.5;
        root.drop-kind = kind;
    }
    // Hauteur voulue par le contenu de Diffuser et de la watch party (donnée par le panneau).
    in-out property <length> cast-h: 280px * root.k;
    in-out property <length> party-h: 200px * root.k;
    property <length> drop-w: min((root.drop-kind == 0 ? 260px : 460px) * root.k, root.width - 32px * root.k);
    property <length> drop-h: root.drop-kind == 0 ? 4 * 56px * root.k + 16px * root.k : root.drop-kind == 1 ? root.cast-h : root.party-h;
    animate drop-w, drop-h { duration: Motion.panels && root.drop-morph ? 260ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    property <length> drop-y: (root.playing ? root.chrome-top + 16px * root.k : root.header-row - 6px * root.k) - (1 - root.drop-p) * 18px * root.k;
    changed remote-open => {
        if (!root.remote-open) {
            root.refocus += 1;
        }
    }
    function cast-toggle() {
        root.party-pop = false;
        root.cast-pop = !root.cast-pop;
        if (root.cast-pop) {
            root.cast-sel = 0;
            root.cast-refresh();
        }
    }
    function close-cast() {
        root.cast-pop = false;
        root.refocus += 1;
    }
    function close-remote() {
        root.remote-open = false;
        root.remote-closed();
        root.refocus += 1;
    }
    // Panneau de la watch party ouvert (voir open_party), et son apparition.
    in-out property <bool> party-pop;
    property <float> party-p: root.party-pop && !root.playing ? 1 : 0;
    animate party-p { duration: Motion.panels ? 260ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    // Entrée du menu choisie : la watch party s'ouvre en panneau (sans changer de page).
    function menu-go(action: string) {
        if (action == "party" || action == "remote") {
            root.menu-action(action);
        } else {
            root.nav-out("menu", action);
        }
    }
    function close-party() {
        root.party-pop = false;
        root.refocus += 1;
    }

    // Recherche
    in-out property <string> search-text;
    in property <[Section]> search-sections;
    in property <bool> search-busy;
    in-out property <int> s-section;
    in-out property <int> s-item;
    in-out property <bool> s-osk;            // mode TV : clavier à l'écran ouvert (la sélection y est)
    in-out property <bool> s-field;          // mode TV : sélection sur le champ (OK ouvre le clavier)
    property <length> s-cur-x: -1px;         // bureau : position du curseur dans le champ

    // Bibliothèque (grille)
    in property <string> lib-title;
    in-out property <[CardData]> lib-items;
    in property <int> lib-total;
    in-out property <int> l-sel;

    // Fiche détail
    in-out property <DetailData> detail;
    in-out property <[CardData]> child-items;
    in-out property <int> d-zone: 0;   // 0 boutons · 1 résumé · 2 enfants
    in-out property <int> d-button: 0;
    in-out property <int> d-child: 0;
    in-out property <bool> overview-open: false;
    // Choix des pistes de la fiche (liste au premier plan) : "" | "audio" | "sub"
    in-out property <string> tp-kind;
    in property <[TrackData]> tp-items;
    in property <string> tp-hint;          // « Retenu pour toute la série » ou « pour ce film »
    in-out property <int> tp-sel;
    in-out property <[Section]> detail-rows; // casting, plus de ce genre, Seerr (zones 4 et +)
    in-out property <int> d-x: 0;            // carte sélectionnée dans une rangée du bas
    in-out property <bool> playing: false;

    // Lecture (rempli par player.rs / video.rs)
    in property <image> video-frame;
    in property <bool> p-ready;
    in property <bool> p-buffering;          // mise en mémoire (réseau lent)
    in property <bool> p-lost;               // connexion au serveur perdue (reprise automatique)
    in property <string> p-title;
    in property <string> p-subtitle;
    in property <bool> p-paused;
    in property <float> p-progress;
    in property <string> p-pos-text;
    in property <string> p-dur-text;
    in property <string> p-end-text;
    in-out property <int> p-volume: 100;
    // Barres du lecteur réglables au doigt (voir PlayerView, hit-*) : lues par Swipe (main.rs).
    in-out property <length> p-hit-sx;
    in-out property <length> p-hit-sy;
    in-out property <length> p-hit-sw;
    in-out property <length> p-hit-sh;
    in-out property <length> p-hit-vx;
    in-out property <length> p-hit-vy;
    in-out property <length> p-hit-vw;
    in-out property <length> p-hit-vh;
    in property <[float]> p-chapters;
    in property <int> p-chapter-count;
    in property <bool> p-has-prev;
    in property <bool> p-has-next;
    in property <[TrackData]> audio-tracks;
    in property <int> audio-current;
    // Débits maximaux proposés par le bouton Qualité du lecteur (vide : fichier local, pas de choix).
    // Glissement vertical du doigt sur la vidéo (Rust, voir Swipe) : compteur et sens.
    in property <int> p-swipe-n;
    in property <int> p-swipe-dir;
    in property <[TrackData]> p-quality;
    in property <int> p-quality-current;
    in property <[TrackData]> sub-tracks;
    in property <int> sub-current;
    in property <[CardData]> p-episodes;    // épisodes de la saison (bandeau ↓)
    in property <int> p-ep-current;
    in-out property <string> p-up-mode;     // "" | "next" | "pick" | "end" (propositions de fin)
    in property <string> p-up-title;
    in property <string> p-up-sub;
    in property <image> p-up-image;
    in property <bool> p-has-up-image;
    in property <[CardData]> p-picks;       // 3 suggestions
    in property <string> p-up-button;       // « Passer à l'épisode suivant » / « … à la saison suivante »
    in-out property <bool> p-skip-intro;    // bouton « Passer l'intro »
    in property <image> p-bg;               // fond de l'écran de fin (image du média, floutée)
    in property <bool> p-has-bg;

    callback login(string, string, string); // serveur, utilisateur, mot de passe
    callback open-item(string);
    callback run-action(string);            // "play" | "back" | "open:<id>"
    // Lecture lancée depuis une fiche : la fiche s'écarte (affiche à gauche, infos à droite, rangées
    // vers le bas), le fond plonge dans le noir, puis la lecture démarre ; au retour, tout revient.
    in-out property <bool> play-go;
    property <float> po: root.play-go ? 1 : 0;
    property <length> po-right: root.po * (root.width - root.col-x + 64px);
    property <length> po-down: root.po * root.height;
    animate po { duration: Motion.detail ? 420ms : 0ms; easing: cubic-bezier(0.55, 0, 0.35, 1); }
    changed playing => {
        if (!root.playing) {
            root.play-go = false;
        }
    }
    function detail-run(action: string) {
        if (action == "play" && !root.play-go) {
            root.play-go = true;
            play-launch.running = true;
        } else if (action != "play") {
            root.run-action(action);
        }
    }
    callback logout();
    callback switch-account();
    callback login-opened();               // écran de connexion affiché : tuiles des comptes
    callback login-pick(string);           // "acc:<id>" | "pub:<nom>" | "other"
    callback login-back();                 // Retour sur « Qui regarde ? » (compte quitté rouvert)
    callback login-forget(string);         // retirer un compte enregistré ("acc:<id>")
    in property <int> login-saved;         // comptes enregistrés parmi les tuiles
    in property <string> login-title: Tr.t(Tr.k, "Ajouter un compte");
    in-out property <bool> login-edit;     // « Gérer les comptes » : choisir un compte à retirer
    pure callback mask(string) -> string;  // mot de passe affiché en points
    callback select-tab(string);            // "home" | "favorites" | "requests"
    callback go-home();
    callback menu-action(string);
    callback lib-more();                    // page suivante de la bibliothèque
    callback row-seen(int /* key */, int /* index sélectionné */);
    callback servers-search();
    callback dl-play(string);
    callback dl-open(string);               // "series:<id>" | "season:<id>"
    callback seerr-action();
    callback track-pick(string, string, string); // type, langue ("" défaut, "off"), libellé
    callback search-open();
    callback party-action(string);
    callback search-changed(string);
    callback random-pick();
    // Effacement : le clavier à l'écran envoie "\u{8}" + texte ; le dernier caractère est retiré en Rust.
    pure callback text-backspace(string) -> string;
    callback dl-delete(string);
    public function back-anim-pub() {
        root.back-anim();
    }
    callback cancel-open();                  // Échap pendant un chargement (Rust annule l'ouverture)
    // Ouverture d'une fiche échouée : on reste sur la page affichée, l'image partagée revient à sa carte.
    public function open-failed() {
        root.loading = false;
        root.kid-veil = false;
        root.hero-pending = "";
        if (root.hero-id != "") {
            root.hero-return();
            root.hero-from-id = "";
        }
    }
    callback server-pick(int);
    callback manual-submit(string, string); // adresse principale, adresse de secours
    in-out property <string> manual-local;
    in-out property <string> manual-remote;
    in-out property <int> manual-field;     // 0 principale · 1 secours · 2 Valider · 3 Annuler
    in-out property <bool> manual-osk;      // mode TV : le clavier à l'écran écrit dans le champ
    in-out property <string> manual-local-err;
    function open-manual() {
        root.manual-field = 0;
        root.manual-osk = false;
        root.manual-local-err = "";
        root.manual-error = "";
        root.manual-open = true;
    }
    function close-manual() {
        root.manual-open = false;
        root.manual-osk = false;
        root.refocus += 1;
    }
    function manual-go() {
        if (root.manual-local == "" && root.manual-remote == "") {
            root.manual-local-err = Tr.t(Tr.k, "Saisis au moins l'adresse principale du serveur.");
            root.manual-field = 0;
            return;
        }
        root.manual-osk = false;
        root.manual-submit(root.manual-local, root.manual-remote);
    }
    changed manual-local => {
        if (root.manual-local != "") {
            root.manual-local-err = "";
        }
    }
    callback manual-choice(string);
    callback settings-activate(string);
    callback settings-category();
    // Plein écran : bascule (bouton et touche « f » du lecteur ; F11 est pris en Rust).
    callback toggle-full();
    callback avatar-pick(string);
    callback player-cmd(string);            // pendant la lecture : "pause", "seek:-10", "episode:1", ...

    property <float> k: root.tv-mode ? 1.4 : 1.0;
    // Entrée / sortie de l'interface TV : tout grandit ou rétrécit en douceur.
    animate k { duration: Motion.pages ? 380ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    property <length> card-w: root.tv-mode ? 230px : 170px;
    // Portrait (fenêtre plus haute que large : téléphone tenu droit) : en-tête sur deux lignes
    // (menu, nom et icônes, puis les onglets dessous) ; les pages se calent sur header-h.
    property <bool> narrow: self.height > self.width;
    // Téléphone tourné (portrait <-> paysage) : la page arrive de nouveau (zoom léger, glissement)
    // au lieu de sauter d'une mise en page à l'autre, sous un voile qui s'efface (voir rot-veil).
    changed narrow => {
        if (!root.playing) {
            root.page-enter();
            root.rot-t0 = animation-tick();
            root.rot-anim = Motion.pages;
        }
    }
    property <bool> rot-anim;
    property <duration> rot-t0;
    property <float> rot-veil: root.rot-anim ? 1 - clamp((animation-tick() - root.rot-t0) / 380ms, 0, 1) : 0;
    Timer {
        interval: 420ms;
        running: root.rot-anim;
        triggered => {
            root.rot-anim = false;
        }
    }
    // Fenêtre façon Windows 7 (voir WinCaption) : barre de titre au-dessus de l'interface, qui descend d'autant.
    out property <length> chrome-top: root.chrome ? 30px : 0px;
    property <length> chrome-side: root.chrome && !root.win-maxed ? 8px : 0px;
    property <length> header-row: 72px * root.k + root.chrome-top;
    // Onglets (Accueil, Favoris, Demandes) : dans la barre commune, sur toutes les pages qui l'ont.
    property <bool> tabs-on: (root.bar-screen || root.on-home) && !root.playing && (root.signed-in || root.offline);
    // Place des onglets sur la ligne de la barre : après le nom (accueil) ou les boutons de gauche
    // (autres pages, le titre de la page s'arrête avant eux), avant les icônes de droite.
    property <length> tabs-lo: root.on-home ? 250px * root.k : (24px + root.nav-n * 54px + 90px) * root.bar-k;
    property <length> tabs-hi: root.width - root.right-w - 16px * root.k;
    // En-tête sur deux lignes (onglets dessous) : portrait, ou onglets qui ne tiennent pas entre la
    // gauche de la barre et ses icônes de droite (petit écran en grands éléments, par exemple).
    property <bool> two-line: root.narrow || root.tabs-hi - root.tabs-lo < root.tabs-w;
    property <length> header-h: root.two-line && root.tabs-on ? root.header-row + 48px * root.k : root.header-row;
    property <int> tab-count: root.has-requests ? 3 : 2;

    // Passage d'une rangée à l'autre : carte la plus proche à l'écran (voir Rows).
    pure function row-to(from-key: int, from-idx: int, from-w: length, to-key: int, to-n: int, to-w: length) -> int {
        return Rows.pick(from-key, from-idx, from-w / 1px, to-key, to-n, to-w / 1px, 18 * root.k, 32 * root.k, root.width / 1px);
    }
    // Rangées de l'accueil.
    pure function home-w(si: int) -> length {
        return root.sections[si].landscape ? root.card-w * 1.5 : root.card-w;
    }
    pure function home-pick(from: int, to: int) -> int {
        return root.row-to(from, root.sel-item, root.home-w(from), to, root.sections[to].items.length, root.home-w(to));
    }
    // Fiche : rangée d'enfants (clé 1002) et rangées du bas (1004 + n°), cartes de 140 px x k.
    pure function detail-pick-down(from-key: int, from-x: int, from-w: length, to-row: int) -> int {
        return root.row-to(from-key, from-x, from-w, 1004 + to-row, root.detail-rows[to-row].items.length, root.card-w);
    }
    // Boutons de la barre de navigation, de gauche à droite : [retour], [accueil], menu.
    property <bool> show-home: root.screen != "home";
    // Retour visible aussi dans une sous-page sans pile (choix de l'avatar) : il la ferme.
    // Retour interne aux Paramètres : choix d'avatar ouvert, ou catégorie ouverte en portrait.
    property <bool> sub-back: root.screen == "settings" && (root.av-open || (root.set-one && root.set-in));
    // Paramètres sur une colonne : selon la largeur, pas le sens de l'écran (une tablette tournée en
    // portrait a la place pour deux colonnes ; changer de mise en page en la tournant déplaçait la
    // sélection, jusque sur la liste des catégories).
    property <bool> set-one: root.width < 640px * root.k;
    property <bool> back-ok: root.can-back || root.sub-back;
    property <int> nav-n: 1 + (root.back-ok ? 1 : 0) + (root.show-home ? 1 : 0);

    function nav-activate(i: int) {
        root.h-focus = false;
        if (i == 0 && root.sub-back) {
            if (root.av-open) {
                root.av-open = false;
            } else {
                root.set-in = false;
            }
        } else if (i == 0 && root.can-back) {
            root.back-anim();
        } else if (i == root.nav-n - 1) {
            root.open-menu();
        } else {
            root.nav-out("menu", "home");
        }
    }

    // Où l'on est, en termes d'entrée du menu (action) : signalé dans le menu.
    in-out property <string> here-lib;       // bibliothèque d'où vient la page ("lib:<id>"), sinon ""
    in-out property <bool> at-lib-root;      // à la racine de cette bibliothèque (pas dans un sous-dossier)
    property <string> here: root.screen == "downloads" ? "downloads" : root.screen == "party" ? "party"
        : root.screen == "settings" ? "settings" : root.screen == "servers" ? "server"
        : (root.screen == "library" || root.screen == "detail") && root.here-lib != "" ? root.here-lib
        : root.tab == "requests" ? "requests" : root.tab == "favorites" ? "favorites" : root.tab == "home" ? "home" : "";
    // Déjà sur cette page (à sa racine) : rien à recharger.
    pure function at(action: string) -> bool {
        return action == root.here && (
            ((action == "home" || action == "requests" || action == "favorites") && root.screen == "home")
            || (action == "downloads" && root.dl-level == 0)
            || action == "party" || action == "settings" || action == "server"
            || (root.screen == "library" && root.at-lib-root));
    }
    pure callback menu-find(string) -> int;  // n° de l'entrée du menu ayant cette action (-1 sinon)

    pure function menu-icon(action: string) -> string {
        return action == "home" ? "home" : action == "requests" ? "requests" : action == "downloads" ? "downloads"
            : action == "party" ? "party" : action == "switch" ? "profile" : action == "server" ? "server"
            : action == "logout" ? "logout" : action == "settings" ? "settings" : action == "quit" ? "quit"
            : action == "password" ? "profile" : action == "remote" ? "remote" : "library";
    }

    function open-menu() {
        let i = root.menu-find(root.here);
        root.menu-sel = i >= 0 ? i : root.menu-entries.length > 1 && root.menu-entries[0].header ? 1 : 0;
        root.menu-open = true;
    }

    function close-menu() {
        root.menu-open = false;
        root.menu-free = false;
        root.menu-hov = -1;
        root.refocus += 1;
    }

    // Déplacement dans le menu en sautant les intitulés de groupe.
    function menu-move(d: int) {
        if (root.menu-sel + d >= 0 && root.menu-sel + d < root.menu-entries.length) {
            if (root.menu-entries[root.menu-sel + d].header) {
                if (root.menu-sel + 2 * d >= 0 && root.menu-sel + 2 * d < root.menu-entries.length) {
                    root.menu-sel += 2 * d;
                }
            } else {
                root.menu-sel += d;
            }
        }
    }

    // Touches de la barre de navigation (écrans autres que l'accueil). Renvoie true si traitée.
    // Vrai clavier : touche qui écrit dans un champ (lettre, chiffre, espace...), pas un raccourci
    // (Ctrl, Alt). Bureau comme mode TV : le texte va au champ sans passer par le clavier à l'écran.
    function typing-key(e: KeyEvent) -> bool {
        return !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta && Str.printable(e.text);
    }
    // Retour arrière qui efface dans le champ : toujours au bureau ; en mode TV seulement s'il reste
    // du texte dans le champ choisi (`t`, vide sinon), car il sert aussi de touche Retour.
    function erase-key(e: KeyEvent, t: string) -> bool {
        return e.text == Key.Backspace && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta
            && (!root.tv-mode || t != "");
    }
    function key-edit(s: string, t: string) -> string {
        return t == Key.Backspace ? Str.head(s, 1) : s + t;
    }

    function nav-key(t: string) -> bool {
        if (!root.h-focus) {
            return false;
        }
        // Icônes regroupées : « ⋯ » (indice 0) puis la photo (indice 4).
        if (root.hdr-collapsed && t == Key.RightArrow && root.h-sel >= root.right-base && root.h-sel < root.right-base + 4) {
            root.h-sel = root.right-base + 4;
            return true;
        }
        if (root.hdr-collapsed && t == Key.LeftArrow && root.h-sel == root.right-base + 4) {
            root.h-sel = root.right-base;
            return true;
        }
        if (root.hdr-collapsed && t == Key.Return && root.h-sel >= root.right-base && root.h-sel < root.right-base + 4) {
            root.right-activate(5);
            return true;
        }
        if (t == Key.LeftArrow) {
            root.h-sel = max(0, root.h-sel - 1);
        } else if (t == Key.RightArrow) {
            root.h-sel = min(root.right-base + 4, root.h-sel + 1);
        } else if (t == Key.DownArrow || t == Key.Escape) {
            root.h-focus = false;
        } else if (t == Key.Return) {
            if (root.h-sel < root.nav-n) {
                root.nav-activate(root.h-sel);
            } else if (root.h-sel < root.right-base) {
                root.header-activate(root.h-sel - root.nav-n);
            } else {
                root.right-activate(root.h-sel - root.right-base);
            }
        }
        return true;
    }

    // Monte dans la barre de navigation, sur le premier bouton (Retour s'il existe).
    function nav-enter() {
        root.h-focus = true;
        // Hors accueil, le bouton maison est sélectionné d'abord (après le bouton retour s'il y en a un).
        // Dans une sous-page (choix de l'avatar), c'est Retour qui est sélectionné.
        root.h-sel = root.sub-back ? 0 : root.screen != "home" && root.can-back ? 1 : 0;
    }

    function tab-index() -> int {
        return root.tab == "favorites" ? 1 : root.tab == "requests" ? 2 : 0;
    }

    // Onglets, puis Recherche, puis Profil.
    function header-activate(i: int) {
        // Ailleurs que sur l'accueil : retour à l'accueil, sur cet onglet (transition habituelle).
        if (root.screen != "home") {
            root.h-focus = false;
            root.nav-out("menu", i == 0 ? "home" : i == 1 ? "favorites" : "requests");
            return;
        }
        if (i == 0) {
            root.select-tab("home");
        } else if (i == 1) {
            root.select-tab("favorites");
        } else if (i == 2 && root.has-requests) {
            root.select-tab("requests");
        }
    }

    // Icônes de droite de la barre du haut (toutes les pages).
    property <int> right-base: root.tabs-on ? root.nav-n + root.tab-count : root.nav-n;
    // Petit écran (téléphone tenu droit) : icônes de droite regroupées derrière « ⋯ ».
    property <bool> hdr-collapsed: root.narrow;
    in-out property <bool> more-open;
    property <float> more-p: root.more-open ? 1 : 0;
    animate more-p { duration: Motion.panels ? 220ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    property <int> more-sel;
    function right-activate(i: int) {
        if (i == 5) {
            root.more-open = !root.more-open;
            root.more-sel = 0;
            return;
        }
        root.more-open = false;
        // Panneaux (diffuser, watch party) : la sélection reste sur leur icône, dessous, et y revient
        // à la fermeture (sinon elle repartait sur la page : « Collections »…).
        if (i <= 1) {
            root.h-focus = true;
            root.h-sel = root.right-base + i;
        } else {
            root.h-focus = false;
        }
        if (i == 0) {
            root.cast-toggle();
        } else if (i == 1) {
            root.menu-action("party");
        } else if (i == 2) {
            root.random-pick();
        } else if (i == 3) {
            root.search-open();
        } else {
            root.menu-action("settings");
        }
    }

    property <length> poster-w: (root.narrow ? 120px : 200px) * root.k;
    property <length> col-x: (root.narrow ? 28px : 64px) + root.poster-w;
    // Portrait : boutons, pastilles et résumé sous l'affiche (pleine largeur, à partir de d-low-x).
    property <length> d-low: root.narrow ? root.poster-w * 1.5 + 24px - 112px * root.k : 0px;
    property <length> d-low-x: root.narrow ? 16px : root.col-x;
    property <length> d-low-w: root.narrow ? root.width - 32px : root.info-w;
    property <float> child-ratio: root.detail.children-landscape ? 0.5625 : 1.5;
    property <length> child-card-w: (root.detail.children-landscape ? 240px : 120px) * root.k;
    property <length> next-w: 260px * root.k;
    // Haut de la rangée d'enfants, et des rangées du bas (sous les enfants s'il y en a).
    property <length> d-children-y: 24px + 316px * root.k + 16px + root.d-low;
    property <length> d-extra-y: root.d-children-y
        + (root.child-items.length == 0 ? 0px : root.ep-list ? root.ep-block-h : root.child-card-w * root.child-ratio + 132px * root.k);
    // Épisodes d'une saison : en liste verticale (comme les .listItem de Style.css) au lieu d'une
    // rangée ; vignette 16:9 à gauche, numéro et titre, durée, début du résumé.
    property <bool> ep-list: root.detail.children-landscape;
    // Raccourci de la liste d'épisodes : la sélection (et la fiche) saute à la première rangée du bas.
    function ep-skip() {
        if (root.detail-rows.length > 0) {
            root.d-free = false;
            root.d-zone = 4;
            root.d-x = 0;
        }
    }
    property <length> ep-thumb-w: (root.narrow ? 132px : 192px) * root.k;
    property <length> ep-row-h: root.ep-thumb-w * 0.5625 + 16px * root.k;
    property <length> ep-gap: 8px * root.k;
    property <length> ep-head-h: 56px * root.k;
    property <length> ep-block-h: root.ep-head-h + root.child-items.length * (root.ep-row-h + root.ep-gap) + 40px * root.k;
    // Défilement de la fiche : la rangée sélectionnée remonte vers le haut de l'écran.
    // Défilement affiché de la fiche : celui de la sélection, ou le défilement libre (doigt, molette).
    property <length> d-view-y: root.d-free ? root.d-free-y : root.d-scroll;
    // Jamais plus loin que le bas de la fiche : quand tout tient à l'écran (grand écran, peu de
    // saisons), choisir une rangée ne fait rien défiler.
    property <length> d-rows-h: root.detail-rows.length > 0
        ? (root.detail-rows[root.detail-rows.length - 1].y-px + root.detail-rows[root.detail-rows.length - 1].h-px) * 1px : 0px;
    property <length> d-max: max(0px, root.d-extra-y + root.d-rows-h + 24px * root.k - root.height + root.header-h);
    // Rangée choisie déjà entièrement visible en haut de la fiche : pas de défilement.
    property <length> d-view-h: root.height - root.header-h;
    property <length> d-scroll: min(root.d-max, root.d-zone >= 4 && root.d-zone - 4 < root.detail-rows.length
        ? (root.d-extra-y + (root.detail-rows[root.d-zone - 4].y-px + root.detail-rows[root.d-zone - 4].h-px) * 1px <= root.d-view-h ? 0px
            : max(0px, root.d-extra-y + root.detail-rows[root.d-zone - 4].y-px * 1px - 40px * root.k))
        : root.d-zone == 2 && root.ep-list ? (root.d-extra-y <= root.d-view-h ? 0px
            // Liste d'épisodes : l'épisode choisi reste vers le milieu de l'écran.
            : max(0px, root.d-children-y + root.ep-head-h + root.d-child * (root.ep-row-h + root.ep-gap) - root.d-view-h * 0.4))
        : root.d-zone == 2 ? (root.d-extra-y <= root.d-view-h ? 0px : max(0px, root.d-children-y - 140px * root.k)) : 0px);
    // Largeur de la colonne d'infos : rétrécie quand le bloc « À suivre » est affiché.
    // « À suivre » seulement s'il reste assez de place aux infos (petite fenêtre : masqué).
    property <bool> show-next: !root.narrow && root.detail.has-next && root.width - root.col-x - 56px - root.next-w > 420px * root.k;
    property <length> info-w: root.width - root.col-x - 32px - (root.show-next ? root.next-w + 24px : 0px);

    // Fond : image du média sélectionné, décor du thème, barre de verre de l'en-tête (voir Backdrop).
    if root.chrome: Rectangle {
        x: root.chrome-side;
        y: root.chrome-top;
        width: root.width - 2 * root.chrome-side;
        height: root.height - root.chrome-top - root.chrome-side;
        background: @linear-gradient(180deg, Theme.bg 0%, Theme.bg-mid 55%, Theme.bg-end 100%);
    }
    if !root.playing: Backdrop {
        x: root.chrome-side;
        y: root.chrome-top;
        width: root.width - 2 * root.chrome-side;
        height: root.height - root.chrome-top - root.chrome-side;
        clip: root.chrome;
        a: 1;
        bg-a: root.bg-a;
        bg-b: root.bg-b;
        bg-mix: root.bg-mix;
        bg-vis: root.bg-vis;
        po: root.po;
        d-fade: root.header-h + 24px + 316px * root.k + root.d-low - root.d-view-y;
        on-detail: root.screen == "detail";
        k: root.k;
        glass: root.signed-in && root.screen != "login" && root.screen != "loading";
        // Le fond commence sous la barre de titre de Windows 7 (chrome-top) : la barre de verre a la
        // hauteur de l'en-tête seul.
        header-h: root.header-h - root.chrome-top;
    }

    // Grand fond provisoire (vignette 16:9 ouverte) : derrière la page, assombri, puis effacé.
    // Passe derrière une fois arrivé et la page prête (avant, le voile la cacherait).
    // Le grand fond passe derrière la page dès qu'elle est là (même en plein vol) : il ne cache
    // jamais les affiches.
    property <bool> hero-under: root.hero-on && root.hero-big && root.hero-dest && !root.loading
        && root.screen != "home" && root.screen != "loading";
    // Rognée sous la barre du haut : le verre de la barre reste visible pendant le vol.
    if root.hero-under && !root.playing: Rectangle {
        y: root.header-row;
        height: parent.height - root.header-row;
        clip: true;
    Rectangle {
        // Même trajectoire que l'image en vol (elle finit de s'agrandir derrière la page).
        x: root.hero-fx + (root.hero-tx - root.hero-fx) * root.hero-p;
        y: root.hero-fy + (root.hero-ty - root.hero-fy) * root.hero-p - root.header-row;
        width: root.hero-fw + (root.hero-tw - root.hero-fw) * root.hero-p;
        height: root.hero-fh + (root.hero-th - root.hero-fh) * root.hero-p;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.hero-img;
            image-fit: cover;
            opacity: root.hero-alpha;
            // Vignette 16:9 qui devient le fond : ses coins arrondis sont dans les pixels ; le haut
            // de l'image est rogné au fil de l'agrandissement pour qu'ils ne grandissent pas avec elle.
            source-clip-y: root.hero-crop;
            source-clip-height: root.hero-img.height - root.hero-crop;
        }
        Rectangle {
            background: Theme.bg.transparentize(1 - 0.6 * root.hero-alpha * root.hero-p);
        }
    }
    }

    // ------------------------------------------------------------ Connexion
    // Pendant la lecture, aucun écran n'est instancié sous la vidéo : rien à redessiner à chaque
    // image, et le clavier va au lecteur.
    if root.screen == "login" && !root.playing: lg := Rectangle {
        // Mise à l'échelle sur 1280 x 720 (paysage) ou 720 x 1280 (portrait, téléphone tenu droit).
        property <length> u: (self.height > self.width ? min(self.height / 1280px, self.width / 560px) : min(self.height / 720px, self.width / 1280px)) * 1px;
        property <length> tile: 150 * self.u;
        property <int> n: root.login-tiles.length;
        property <int> last-tile;              // tuile d'où l'on est descendu vers les boutons
        property <int> saved-count: root.login-saved;
        // Tuiles puis bouton « Changer de serveur » (index n).
        // Formulaire : largeur, haut, hauteur d'un champ, des boutons, écart entre les lignes.
        property <length> fw: min(self.width - 80 * self.u, 560 * self.u);
        property <length> fy: 150 * self.u;
        property <length> field-h: 54 * self.u;
        property <length> btn-h: 46 * self.u;
        property <length> gap: 12 * self.u;

        // Animations au temps (rien n'est redessiné en dehors) :
        // - arrivée : titre qui descend, tuiles qui apparaissent en cascade, boutons qui montent ;
        // - compte retiré : sa tuile rétrécit, puis les suivantes glissent à sa place ;
        // - compte choisi : sa tuile grossit, les autres s'estompent pendant la connexion.
        property <bool> in-anim;
        property <duration> in-t0;
        property <float> in-q: self.in-anim && Motion.login ? clamp((animation-tick() - self.in-t0) / 900ms, 0, 1) : 1;
        function play-in() {
            lg.in-t0 = animation-tick();
            lg.in-anim = true;
        }
        Timer {
            interval: 950ms;
            running: lg.in-anim;
            triggered => {
                lg.in-anim = false;
            }
        }
        // Élément n° i de la cascade : 0 -> 1 avec une courbe qui ralentit.
        pure function in-e(i: float) -> float {
            let x = clamp(lg.in-q * 2.2 - min(i, 8) * 0.15, 0, 1);
            return 1 - (1 - x) * (1 - x) * (1 - x);
        }
        // Suppression : la tuile `gone-id` s'efface (260 ms), Rust la retire, puis les tuiles qui
        // suivaient glissent d'un cran vers la gauche (`shift-from`).
        property <string> gone-id;
        property <int> shift-from: -1;
        property <bool> sh-anim;
        property <duration> sh-t0;
        property <float> sh-q: self.sh-anim && Motion.login ? clamp((animation-tick() - self.sh-t0) / 320ms, 0, 1) : 1;
        function forget(id: string, i: int) {
            if (lg.gone-id != "") {
                return;
            }
            lg.gone-id = id;
            lg.shift-from = i;
        }
        Timer {
            interval: 260ms;
            running: lg.gone-id != "";
            triggered => {
                root.login-forget(lg.gone-id);
                lg.gone-id = "";
                lg.sh-t0 = animation-tick();
                lg.sh-anim = true;
            }
        }
        Timer {
            interval: 340ms;
            running: lg.sh-anim;
            triggered => {
                lg.sh-anim = false;
                lg.shift-from = -1;
            }
        }
        // Rangée des tuiles (aussi le point de départ de la photo qui s'envole au choix).
        property <length> pk-step: lg.tile + 30 * lg.u;
        // Trop de comptes pour une ligne : ils passent à la ligne (colonnes), chaque ligne centrée.
        property <int> pk-cols: max(1, min(lg.n, floor((self.width - 80 * lg.u + 30 * lg.u) / self.pk-step)));
        property <int> pk-rows: max(1, ceil(lg.n / self.pk-cols));
        property <length> pk-row-h: lg.tile + 96 * lg.u;
        property <int> pk-focus: min(root.login-sel, lg.n - 1);
        // Lignes plus hautes que l'écran : la grille défile pour garder la ligne choisie visible.
        property <length> pk-avail: self.height - 240 * lg.u - 140 * lg.u;
        property <length> pk-scroll: self.pk-rows * self.pk-row-h <= self.pk-avail ? 0px
            : min(self.pk-rows * self.pk-row-h - self.pk-avail, max(0px, floor(self.pk-focus / self.pk-cols) * self.pk-row-h - self.pk-avail / 2 + self.pk-row-h / 2));
        animate pk-scroll { duration: Motion.login ? 260ms : 0ms; easing: ease-out; }
        pure function pk-x(i: int) -> length {
            let row = floor(i / self.pk-cols);
            let in-row = min(self.pk-cols, lg.n - row * self.pk-cols);
            return (self.width - (in-row * self.pk-step - 30 * lg.u)) / 2 + Math.mod(i, self.pk-cols) * self.pk-step;
        }
        pure function pk-y(i: int) -> length {
            return 240 * lg.u + floor(i / self.pk-cols) * self.pk-row-h - self.pk-scroll;
        }
        // Haut de la dernière ligne visible de la grille (boutons dessous).
        property <length> pk-bottom: 240 * lg.u + min(self.pk-rows * self.pk-row-h, max(self.pk-avail, self.pk-row-h)) - self.pk-row-h;
        // Connexion en cours (photo au centre) : le reste de la page s'efface.
        opacity: root.fly-phase == 1 || root.fly-phase == 2 ? 0 : 1;
        animate opacity { duration: Motion.login ? 280ms : 0ms; easing: ease-out; }
        // Compte choisi (connexion en cours).
        property <string> picking;
        // Seul un compte enregistré se connecte tout de suite (les autres ouvrent le formulaire).
        function pick(i: int) {
            if (root.login-tiles[i].subtitle == Tr.t(Tr.k, "Enregistré")) {
                lg.picking = root.login-tiles[i].id;
            }
            if (root.login-tiles[i].subtitle == Tr.t(Tr.k, "Enregistré") && Motion.login) {
                // Retour immédiat : la photo quitte sa tuile et va au centre de l'écran.
                root.fly-img = root.login-tiles[i].image;
                root.fly-has-img = root.login-tiles[i].has-image;
                root.fly-letter = root.login-tiles[i].rating;
                root.fly-sx = lg.pk-x(i);
                root.fly-sy = lg.pk-y(i);
                root.fly-ss = lg.tile;
                root.fly-start(1);
            }
            root.login-pick(root.login-tiles[i].id);
        }
        property <bool> was-busy: root.busy;
        changed was-busy => {
            if (!root.busy) {
                lg.picking = "";
            }
        }
        // Retour du formulaire vers les comptes : la cascade est rejouée.
        property <string> mode: root.login-mode;
        changed mode => {
            if (lg.mode == "pick") {
                lg.play-in();
            }
            lg.form-t0 = animation-tick();
            lg.form-anim = true;
        }
        property <bool> form-anim;
        property <duration> form-t0;
        property <float> form-q: self.form-anim && Motion.login ? clamp((animation-tick() - self.form-t0) / 420ms, 0, 1) : 1;
        property <float> form-e: 1 - (1 - self.form-q) * (1 - self.form-q) * (1 - self.form-q);
        Timer {
            interval: 440ms;
            running: lg.form-anim;
            triggered => {
                lg.form-anim = false;
            }
        }
        init => {
            lg.play-in();
        }

        function submit() {
            // Un compte a toujours un nom d'utilisateur (le mot de passe peut être vide sur Jellyfin).
            if (root.login-user == "") {
                root.login-user-err = Tr.t(Tr.k, "Saisis un nom d'utilisateur.");
                root.login-field = 0;
                root.login-focus-tick += 1;
                return;
            }
            root.login-osk = false;
            root.login(root.server, root.login-user, root.login-pass);
        }

        FocusScope {
            property <int> tick: root.refocus;
            // Bureau : un clic à côté d'un champ ne lui retire pas le clavier.
            focus-on-click: root.tv-mode;
            changed tick => {
                // Bureau, formulaire affiché : le clavier va au champ à remplir, pas à la page.
                if (!root.tv-mode && root.login-mode == "form") {
                    root.login-focus-tick += 1;
                } else if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            init => {
                // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                if (!root.tv-mode && root.login-mode == "form") {
                    root.login-focus-tick += 1;
                } else if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            key-pressed(event) => {
                // Touche maintenue : Entrée ne répète pas l'action (ouvrir, lancer la lecture...).
                if (event.repeat && event.text == Key.Return) {
                    return EventResult.accept;
                }
                // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                if (root.loading && event.text == Key.Escape) {
                    root.cancel-open();
                    return EventResult.accept;
                }
                if (root.busy) {
                    return EventResult.accept;
                }
                if (root.login-mode == "pick") {
                    // Tuiles (0..n-1), puis les boutons : Changer de serveur (n), Gérer les comptes (n + 1).
                    // En gestion, un seul bouton (Terminé, n).
                    let last-btn = root.login-edit || lg.saved-count == 0 ? lg.n : lg.n + 1;
                    if (event.text == Key.LeftArrow) {
                        if (root.login-sel == lg.n + 1) {
                            root.login-sel = lg.n;
                        } else if (root.login-sel < lg.n) {
                            root.login-sel = max(0, root.login-sel - 1);
                        }
                    } else if (event.text == Key.RightArrow) {
                        if (root.login-sel == lg.n) {
                            root.login-sel = last-btn;
                        } else if (root.login-sel < lg.n) {
                            root.login-sel = min(lg.n - 1, root.login-sel + 1);
                        }
                    } else if (event.text == Key.DownArrow) {
                        // Ligne suivante de la grille, sinon les boutons.
                        if (root.login-sel < lg.n && floor(root.login-sel / lg.pk-cols) < lg.pk-rows - 1) {
                            root.login-sel = min(lg.n - 1, root.login-sel + lg.pk-cols);
                        } else if (root.login-sel < lg.n) {
                            lg.last-tile = root.login-sel;
                            root.login-sel = lg.n;
                        }
                    } else if (event.text == Key.UpArrow) {
                        if (root.login-sel >= lg.n) {
                            root.login-sel = min(lg.last-tile, lg.n - 1);
                        } else if (root.login-sel >= lg.pk-cols) {
                            root.login-sel -= lg.pk-cols;
                        }
                    } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                        if (root.login-edit) {
                            root.login-edit = false;
                        } else {
                            root.login-back();
                        }
                    } else if (event.text == Key.Return) {
                        if (root.login-edit) {
                            if (root.login-sel >= lg.n) {
                                root.login-edit = false;
                                root.login-sel = 0;
                            } else if (root.login-tiles[root.login-sel].subtitle == Tr.t(Tr.k, "Enregistré")) {
                                lg.forget(root.login-tiles[root.login-sel].id, root.login-sel);
                            }
                        } else if (root.login-sel == lg.n) {
                            root.menu-action("server");
                        } else if (root.login-sel == lg.n + 1) {
                            root.login-edit = true;
                            root.login-sel = 0;
                        } else {
                            lg.pick(root.login-sel);
                        }
                    }
                    return EventResult.accept;
                }
                // Formulaire. Clavier à l'écran ouvert : il a les touches ; Échap le ferme.
                if (root.tv-mode && root.login-osk) {
                    if (form-osk.key(event.text)) {
                        return EventResult.accept;
                    }
                    if (event.text == Key.Escape) {
                        root.login-osk = false;
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.Escape) {
                    root.login-mode = "pick";
                    root.login-osk = false;
                    return EventResult.accept;
                }
                // Vrai clavier : une touche tapée va au champ choisi (au bureau : celui qui avait le
                // clavier ; en mode TV, sur un bouton : le nom d'utilisateur).
                if (root.typing-key(event) || root.erase-key(event, root.login-field > 1 ? "" : root.login-field == 1 ? root.login-pass : root.login-user)) {
                    if (root.login-field > 1) {
                        root.login-field = 0;
                    }
                    if (root.login-field == 1) {
                        root.login-pass = root.key-edit(root.login-pass, event.text);
                    } else {
                        root.login-user = root.key-edit(root.login-user, event.text);
                    }
                    root.login-focus-tick += 1;
                    return EventResult.accept;
                }
                // Touche maintenue : une fois le texte effacé, Retour arrière (ou Échap) ne sert pas de Retour.
                if (event.repeat && (event.text == Key.Backspace || event.text == Key.Escape)) {
                    return EventResult.accept;
                }
                if (!root.tv-mode) {
                    return EventResult.reject;
                }
                // Champs (0, 1), puis la ligne des boutons : Se connecter (2) et Retour (3, à gauche).
                if (event.text == Key.UpArrow) {
                    root.login-field = root.login-field >= 2 ? 1 : max(0, root.login-field - 1);
                } else if (event.text == Key.DownArrow) {
                    root.login-field = min(2, root.login-field + 1);
                } else if (event.text == Key.LeftArrow && root.login-field == 2) {
                    root.login-field = 3;
                } else if (event.text == Key.RightArrow && root.login-field == 3) {
                    root.login-field = 2;
                } else if (event.text == Key.Return) {
                    if (root.login-field <= 1) {
                        root.login-osk = true;
                    } else if (root.login-field == 2) {
                        lg.submit();
                    } else {
                        root.login-mode = "pick";
                    }
                } else if (event.text == Key.Backspace) {
                    root.login-mode = "pick";
                }
                return EventResult.accept;
            }
        }

        // En-tête : nom de l'appli et serveur (s'efface quand le clavier à l'écran prend la place).
        property <float> osk-p: root.tv-mode && root.login-mode == "form" && root.login-osk ? 1 : 0;
        animate osk-p { duration: Motion.search ? 280ms : 0ms; easing: ease-in-out; }
        Text {
            visible: lg.osk-p < 0.99;
            y: 40 * lg.u - lg.osk-p * 30 * lg.u - (1 - lg.in-e(0)) * 40 * lg.u;
            opacity: lg.in-e(0);
            width: parent.width;
            text: "Turtlefin";
            // Thèmes brillants : lettres de verre (dégradé clair vers l'accent, liseré foncé) ;
            // sinon la couleur d'accent, comme ailleurs.
            color: Theme.gloss > 0 ? @linear-gradient(180deg, #ffffff 0%, Theme.accent2.brighter(0.5) 50%, Theme.accent2 51%, Theme.accent2.darker(0.15) 100%)
                : Theme.dark ? Theme.accent2 : Theme.accent1;
            stroke: Theme.gloss > 0 ? Theme.accent1.darker(0.4) : transparent;
            stroke-width: Theme.gloss > 0 ? 1.5 * lg.u : 0px;
            font-size: 44 * lg.u;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Text {
            visible: lg.osk-p < 0.99;
            y: 100 * lg.u - lg.osk-p * 30 * lg.u - (1 - lg.in-e(0.5)) * 30 * lg.u;
            opacity: lg.in-e(0.5);
            width: parent.width;
            text: root.server-name != "" ? root.server-name + "  ·  " + root.server : root.server;
            color: Theme.muted;
            font-size: 16 * lg.u;
            horizontal-alignment: center;
        }

        // ---- Qui regarde ?
        if root.login-mode == "pick": Rectangle {
            // Rangée plus large que l'écran : elle défile pour garder la tuile choisie visible.
            property <length> step: lg.pk-step;
            // Comptes enregistrés (pour « Gérer les comptes »).
            property <int> saved: lg.saved-count;
            Text {
                y: 170 * lg.u + (1 - lg.in-e(1)) * 24 * lg.u;
                opacity: lg.in-e(1);
                width: parent.width;
                text: root.login-edit ? Tr.t(Tr.k, "Choisis un compte à retirer de cet appareil") : Tr.t(Tr.k, "Qui regarde ?");
                color: Theme.fg;
                font-size: 30 * lg.u;
                font-weight: 700;
                horizontal-alignment: center;
            }
            for t[i] in root.login-tiles: tile := Rectangle {
                // Après une suppression, les tuiles suivantes partent de leur ancienne place.
                // Après une suppression, les tuiles suivantes partent de leur ancienne place.
                property <length> from-x: lg.shift-from >= 0 && i >= lg.shift-from ? lg.pk-x(i + 1) - lg.pk-x(i) : 0px;
                property <length> from-y: lg.shift-from >= 0 && i >= lg.shift-from ? lg.pk-y(i + 1) - lg.pk-y(i) : 0px;
                x: lg.pk-x(i) + (1 - lg.sh-q) * (1 - lg.sh-q) * self.from-x;
                y: lg.pk-y(i) + (1 - lg.sh-q) * (1 - lg.sh-q) * self.from-y + (1 - self.e) * 50 * lg.u;
                width: lg.tile;
                height: lg.tile + 70 * lg.u;
                property <float> e: lg.in-e(1.5 + i);
                property <bool> removable: t.subtitle == Tr.t(Tr.k, "Enregistré");
                property <bool> sel: (Nav.kb ? (i == root.login-sel) : tile-area.has-hover && !Nav.touch);
                property <bool> gone: t.id == lg.gone-id;
                property <bool> chosen: lg.picking != "" && t.id == lg.picking;
                // Gestion : seuls les comptes enregistrés restent nets. Connexion : les autres s'estompent.
                property <float> dim: self.gone ? 0 : root.login-edit && !self.removable ? 0.35 : lg.picking != "" && !self.chosen ? 0.25 : 1;
                animate dim { duration: Motion.login ? 240ms : 0ms; easing: ease-out; }
                opacity: self.dim * self.e;
                transform-scale: self.gone ? 0.3 : self.chosen ? 1.18 : (self.sel ? 1.08 : 1.0) * (0.7 + 0.3 * self.e);
                animate transform-scale { duration: Motion.login ? 240ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                Rectangle {
                    y: 0px;
                    width: lg.tile;
                    height: lg.tile;
                    border-radius: self.width / 2;
                    background: t.id == "other" ? Theme.fg.with-alpha(0.08) : @linear-gradient(130deg, Theme.ph1 0%, Theme.ph2 100%);
                    // Contour et lueur du thème (comme les cartes), accent quand la tuile est choisie.
                    border-width: parent.sel ? 5 * lg.u : 2 * lg.u;
                    border-color: parent.sel ? Theme.accent2 : Theme.card-border;
                    drop-shadow-blur: Nav.no-shadow ? 0px : (parent.sel ? 26 * lg.u : 0px);
                    drop-shadow-color: Theme.glow;
                    if t.has-image: Image {
                        x: 6 * lg.u;
                        y: 6 * lg.u;
                        width: parent.width - 12 * lg.u;
                        height: parent.height - 12 * lg.u;
                        source: t.image;
                        image-fit: fill;
                    }
                    // Thèmes brillants : reflet de bulle en haut de la photo.
                    if Theme.gloss > 0: Rectangle {
                        x: parent.width * 0.16;
                        y: parent.height * 0.05;
                        width: parent.width * 0.68;
                        height: parent.height * 0.42;
                        border-radius: self.height / 2;
                        background: @linear-gradient(180deg, rgba(255, 255, 255, 0.55 * Theme.gloss) 0%, rgba(255, 255, 255, 0) 100%);
                    }
                    if !t.has-image: Text {
                        text: t.id == "other" ? "+" : t.rating;
                        color: Theme.fg;
                        font-size: (t.id == "other" ? 64 : 40) * lg.u;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: clip;
                    }
                }
                Marquee {
                    y: lg.tile + 12 * lg.u;
                    width: parent.width;
                    text: t.title;
                    text-color: Theme.fg;
                    font-size: 18 * lg.u;
                    font-weight: 600;
                    horizontal-alignment: center;
                    active: i == root.login-sel && Nav.kb;
                    height: self.preferred-height;
                }
                Text {
                    y: lg.tile + 38 * lg.u;
                    width: parent.width;
                    text: t.subtitle;
                    color: Theme.accent2;
                    font-size: 13 * lg.u;
                    horizontal-alignment: center;
                }
                // Gestion : croix rouge sur les comptes que l'on peut retirer.
                if root.login-edit && tile.removable: Rectangle {
                    x: lg.tile - self.width + 2 * lg.u;
                    y: -2 * lg.u;
                    width: 40 * lg.u;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: #dc2626;
                    border-width: 3 * lg.u;
                    border-color: Theme.bg;
                    Path {
                        width: 16 * lg.u;
                        height: 16 * lg.u;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        fill: transparent;
                        stroke: white;
                        stroke-width: 3 * lg.u;
                        commands: "M 3 3 L 13 13 M 13 3 L 3 13";
                    }
                }
                tile-area := TouchArea {
                    clicked => {
                        root.login-sel = i;
                        if (root.login-edit) {
                            if (tile.removable) {
                                lg.forget(t.id, i);
                            }
                        } else {
                            lg.pick(i);
                        }
                    }
                }
            }
            HorizontalLayout {
                y: lg.pk-bottom + lg.tile + 110 * lg.u + (1 - lg.in-e(3)) * 30 * lg.u;
                opacity: lg.in-e(3);
                width: parent.width;
                height: 46 * lg.u;
                alignment: center;
                spacing: 16 * lg.u;
                if !root.login-edit: ActionButton {
                    text: Tr.t(Tr.k, "Changer de serveur");
                    font: 16 * lg.u;
                    focused: root.login-sel == lg.n && Nav.kb;
                    clicked => {
                        root.menu-action("server");
                    }
                }
                if lg.saved-count > 0 || root.login-edit: ActionButton {
                    text: root.login-edit ? Tr.t(Tr.k, "Terminé") : Tr.t(Tr.k, "Gérer les comptes");
                    font: 16 * lg.u;
                    focused: (root.login-edit ? root.login-sel >= lg.n : root.login-sel == lg.n + 1) && Nav.kb;
                    clicked => {
                        root.login-edit = !root.login-edit;
                        root.login-sel = 0;
                    }
                }
            }
            if root.busy || root.error-text != "": Bubble {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 28 * lg.u;
                k: lg.u / 1px;
                max-w: parent.width - 80 * lg.u;
                text: root.busy ? Tr.t(Tr.k, "Connexion…") : root.error-text;
                error: !root.busy;
            }
        }

        // ---- Ajouter un compte : carte de verre centrée (intitulés au-dessus des champs).
        // Mode TV : choisir un champ (↑ ↓) puis Entrée ouvre le clavier à l'écran sous la carte.
        property <length> card-w: min(self.width - 80 * self.u, 520 * self.u);
        // Clavier à l'écran ouvert : seul le champ en cours reste sur la carte (plus petite), pour que
        // le clavier tienne en entier dessous, même sur un petit écran.
        property <bool> one: root.tv-mode && root.login-osk;
        property <length> card-h: (1 - self.osk-p) * 390 * self.u + self.osk-p * 200 * self.u;
        property <length> card-y: (1 - self.osk-p) * max(150 * self.u, (self.height - 390 * self.u) / 2 + 40 * self.u)
            + self.osk-p * 24 * self.u;

        if root.login-mode == "form": form-card := FocusScope {
            x: (parent.width - lg.card-w) / 2;
            y: lg.card-y + (1 - lg.form-e) * 50 * lg.u - Kb.lift;
            opacity: lg.form-e;
            width: lg.card-w;
            height: lg.card-h;
            // Bureau : juste après l'apparition du formulaire, le champ à remplir prend le clavier (le
            // demander à la création du champ ne suffit pas : la page le reprend dans la foulée).
            Timer {
                interval: 60ms;
                running: !root.tv-mode;
                triggered => {
                    self.running = false;
                    if (root.login-field == 1) {
                        pass-field.focus-input();
                    } else {
                        user-field.focus-input();
                    }
                }
            }
            // Un clic sur la carte ne lui donne pas le clavier : au bureau, le champ le garde ; en
            // mode TV, la page (qui gère la télécommande) le garde.
            focus-on-click: false;
            // Bureau : Échap depuis un champ revient aux comptes.
            key-pressed(event) => {
                // Touche maintenue : Entrée ne répète pas l'action (ouvrir, lancer la lecture...).
                if (event.repeat && event.text == Key.Return) {
                    return EventResult.accept;
                }
                // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                if (root.loading && event.text == Key.Escape) {
                    root.cancel-open();
                    return EventResult.accept;
                }
                if (event.text == Key.Escape) {
                    root.login-mode = "pick";
                    return EventResult.accept;
                }
                // Bureau : une touche tapée sur la carte, hors des champs, va à celui qui avait le clavier.
                if (!root.tv-mode && (root.typing-key(event) || root.erase-key(event, ""))) {
                    if (root.login-field == 1) {
                        pass-field.type(event.text);
                    } else {
                        user-field.type(event.text);
                    }
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            Rectangle {
                border-radius: Theme.win7 ? 8 * lg.u : 20 * lg.u;
                background: Theme.win7 ? transparent : Theme.glass;
                border-width: Theme.win7 ? 0px : 1px;
                border-color: Theme.glass-border;
                Gloss { r: parent.border-radius; strength: 0.45; visible: Theme.gloss > 0 && !Theme.win7; }
                WinFrame { r: parent.border-radius; k: root.k; }
                drop-shadow-blur: Nav.no-shadow ? 0px : (0px);
            }

            VerticalLayout {
                padding: 26 * lg.u;
                spacing: 6 * lg.u;
                alignment: start;

                Text {
                    text: root.login-title;
                    color: Theme.fg;
                    font-size: 24 * lg.u;
                    font-weight: 700;
                }
                Text {
                    text: root.tv-mode ? Tr.t(Tr.k, "Choisis un champ puis appuie sur Entrée pour écrire.")
                        : Tr.t(Tr.k, "Le mot de passe peut rester vide si le compte n'en a pas.");
                    visible: !lg.one;
                    height: lg.one ? 0px : self.preferred-height;
                    color: Theme.muted;
                    font-size: 13 * lg.u;
                }
                Rectangle {
                    height: 6 * lg.u;
                }
                user-field := Field {
                    k: lg.u / 1px;
                    visible: !lg.one || root.login-field == 0;
                    height: self.visible ? 96 * lg.u : 0px;
                    label: Tr.t(Tr.k, "Nom d'utilisateur");
                    hint: Tr.t(Tr.k, "ex. Heisenberg");
                    text <=> root.login-user;
                    shown: root.login-user;
                    tv: root.tv-mode;
                    selected: root.tv-mode && !root.login-osk && root.login-field == 0;
                    editing: root.login-osk && root.login-field == 0;
                    error: root.login-user-err;
                    property <int> want: root.login-focus-tick;
                    changed want => {
                        if (!root.tv-mode && root.login-field == 0) {
                            self.focus-input();
                        }
                    }
                    init => {
                        if (!root.tv-mode && root.login-field == 0) {
                            self.focus-input();
                        }
                    }
                    accepted => {
                        pass-field.focus-input();
                    }
                    got-focus => {
                        root.login-field = 0;
                    }
                    clicked => {
                        root.login-field = 0;
                        root.login-osk = true;
                    }
                }
                pass-field := Field {
                    k: lg.u / 1px;
                    visible: !lg.one || root.login-field == 1;
                    height: self.visible ? 96 * lg.u : 0px;
                    label: Tr.t(Tr.k, "Mot de passe");
                    hint: Tr.t(Tr.k, "Mot de passe");
                    text <=> root.login-pass;
                    shown: root.mask(root.login-pass);
                    password: true;
                    tv: root.tv-mode;
                    selected: root.tv-mode && !root.login-osk && root.login-field == 1;
                    editing: root.login-osk && root.login-field == 1;
                    property <int> want: root.login-focus-tick;
                    changed want => {
                        if (!root.tv-mode && root.login-field == 1) {
                            self.focus-input();
                        }
                    }
                    init => {
                        if (!root.tv-mode && root.login-field == 1) {
                            self.focus-input();
                        }
                    }
                    accepted => {
                        lg.submit();
                    }
                    got-focus => {
                        root.login-field = 1;
                    }
                    clicked => {
                        root.login-field = 1;
                        root.login-osk = true;
                    }
                }
                HorizontalLayout {
                    visible: !lg.one;
                    height: lg.one ? 0px : 46 * lg.u;
                    spacing: 14 * lg.u;
                    alignment: end;
                    ActionButton {
                        text: Tr.t(Tr.k, "Retour");
                        font: 16 * lg.u;
                        focused: root.tv-mode && !root.login-osk && root.login-field == 3;
                        clicked => {
                            root.login-mode = "pick";
                            root.login-osk = false;
                        }
                    }
                    ActionButton {
                        text: root.busy ? Tr.t(Tr.k, "Connexion…") : Tr.t(Tr.k, "Se connecter");
                        font: 16 * lg.u;
                        focused: root.tv-mode ? !root.login-osk && root.login-field == 2 : true;
                        clicked => {
                            lg.submit();
                        }
                    }
                }
            }
        }

        // Clavier à l'écran (TV), sous la carte, seulement quand un champ est en cours d'écriture.
        form-osk := Osk {
            x: (parent.width - self.width) / 2;
            y: lg.card-y + lg.card-h + 18 * lg.u + (1 - lg.osk-p) * 60 * lg.u;
            width: min(parent.width - 80 * lg.u, 760 * lg.u);
            visible: root.tv-mode && root.login-mode == "form" && lg.osk-p > 0.01;
            k: lg.u / 1px * 1.0;
            active: root.login-osk;
            text: root.login-field == 0 ? root.login-user : root.login-pass;
            ok-label: root.login-field == 0 ? Tr.t(Tr.k, "Suivant") : Tr.t(Tr.k, "Connexion");
            erase(t) => {
                return root.text-backspace("\u{8}" + t);
            }
            edited(t) => {
                if (root.login-field == 0) {
                    root.login-user = t;
                } else {
                    root.login-pass = t;
                }
            }
            done => {
                if (root.login-field == 0) {
                    root.login-field = 1;
                } else {
                    lg.submit();
                }
            }
            leave-up => {
                root.login-osk = false;
            }
            leave-down => {
                root.login-osk = false;
                root.login-field = 2;
            }
        }

        // Message (erreur de connexion, nom manquant...) en bulle en bas.
        if root.login-mode == "form" && (root.busy || root.error-text != "") && lg.osk-p < 0.5: Bubble {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 28 * lg.u;
            k: lg.u / 1px;
            max-w: parent.width - 80 * lg.u;
            text: root.busy ? Tr.t(Tr.k, "Connexion…") : root.error-text;
            error: !root.busy;
        }
    }

    // ------------------------------------------------------------ Chargement
    // Démarrage (ou juste après la connexion) : nom de l'appli et barre animée.
    if root.screen == "loading" && !root.playing && root.fly-phase == 0: Rectangle {
        Text {
            y: parent.height / 2 - 60px * root.k;
            width: parent.width;
            text: "Turtlefin";
            color: Theme.dark ? Theme.accent2 : Theme.accent1;
            font-size: 48px * root.k;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height / 2 + 20px * root.k;
            width: 220px * root.k;
            height: 4px * root.k;
            border-radius: self.height / 2;
            background: Theme.fg.with-alpha(0.1);
            // Segment qui traverse la piste sans jamais en sortir (bords coupés à la piste).
            property <length> seg: 80px * root.k;
            property <length> head: (mod(animation-tick() / 1ms, 1400) / 1400) * (self.width + self.seg);
            Rectangle {
                x: max(0px, parent.head - parent.seg);
                width: min(parent.width, parent.head) - self.x;
                height: parent.height;
                border-radius: self.height / 2;
                background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
            }
        }
    }

    // ------------------------------------------------------------ Accueil / Favoris
    if root.screen == "home" && !root.playing && !Perf.hide(16): Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        // En-tête (nom, onglets, icônes) : la barre commune à toutes les pages (plus bas), jamais recréée.

        FocusScope {
            y: root.header-h;
            height: parent.height - root.header-h;

            property <int> tick: root.refocus;
            changed tick => {
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }

            init => {
                // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }

            key-pressed(event) => {
                // Après un défilement libre : la sélection repart de la rangée affichée en haut.
                if (root.home-free && root.sections.length > 0) {
                    root.sel-section = root.home-section-at(root.home-free-y / 1px);
                    root.sel-item = min(root.sel-item, root.sections[root.sel-section].items.length - 1);
                    root.home-free = false;
                }
                // Touche maintenue : Entrée, Échap et Retour arrière ne répètent pas l'action (ouvrir, revenir...).
                if (event.repeat && (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace)) {
                    return EventResult.accept;
                }
                // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                if (root.loading && event.text == Key.Escape) {
                    root.cancel-open();
                    return EventResult.accept;
                }
                // Visite guidée : Retour / Échap la quittent (étapes où ils ne servent pas au geste
                // demandé) ; OK n'ouvre rien tant que l'étape ne le demande pas.
                if (root.tour-esc && (event.text == Key.Escape || event.text == Key.Backspace)) {
                    root.tour-step = -1;
                    return EventResult.accept;
                }
                if (root.tour-no-ok && event.text == Key.Return) {
                    return EventResult.accept;
                }
                // Sélection dans l'en-tête : menu, onglets, recherche, profil
                if (root.h-focus) {
                    if (event.text == Key.LeftArrow) {
                        root.h-sel = max(0, root.h-sel - 1);
                    } else if (event.text == Key.RightArrow) {
                        root.h-sel = min(root.right-base + 4, root.h-sel + 1);
                    } else if (event.text == Key.DownArrow) {
                        if (root.sections.length > 0) {
                            root.h-focus = false;
                        }
                    } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                        // Échap : retour à la page ; onglet vide (rien où descendre) : le menu.
                        if (root.sections.length > 0) {
                            root.h-focus = false;
                        } else {
                            root.h-focus = false;
                            root.open-menu();
                        }
                    } else if (event.text == Key.Return) {
                        if (root.h-sel < root.nav-n) {
                            root.nav-activate(root.h-sel);
                        } else if (root.h-sel < root.right-base) {
                            root.header-activate(root.h-sel - root.nav-n);
                        } else {
                            root.right-activate(root.h-sel - root.right-base);
                        }
                    }
                    return EventResult.accept;
                }
                if (root.sections.length == 0) {
                    // Onglet vide (aucun favori...) : Échap / Retour ouvrent le menu comme sur l'accueil,
                    // les autres touches montent dans la barre (les onglets).
                    if (event.text == Key.Escape || event.text == Key.Backspace) {
                        root.open-menu();
                        return EventResult.accept;
                    }
                    root.h-focus = true;
                    root.h-sel = root.nav-n + root.tab-index();
                    return EventResult.accept;
                }
                if (event.text == Key.RightArrow) {
                    if (root.sel-item < root.sections[root.sel-section].items.length - 1) {
                        root.sel-item += 1;
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.LeftArrow) {
                    if (root.sel-item > 0) {
                        root.sel-item -= 1;
                    } else {
                        // Tout à gauche : le menu s'ouvre.
                        root.open-menu();
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.open-menu();
                    return EventResult.accept;
                }
                if (event.text == Key.DownArrow) {
                    if (root.sel-section < root.sections.length - 1) {
                        root.sel-item = root.home-pick(root.sel-section, root.sel-section + 1);
                        root.sel-section += 1;
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.UpArrow) {
                    if (root.sel-section > 0) {
                        root.sel-item = root.home-pick(root.sel-section, root.sel-section - 1);
                        root.sel-section -= 1;
                    } else {
                        // Depuis la première rangée : on monte dans l'en-tête, sur l'onglet affiché.
                        root.h-focus = true;
                        root.h-sel = root.nav-n + root.tab-index();
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.Return) {
                    root.open-hero(root.sections[root.sel-section].items[root.sel-item].id);
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            // Molette : un cran = une rangée (comme ↑ ↓) ; Maj + molette ou molette horizontale : dans
            // la rangée (comme ← →). La sélection suit, la page défile comme au clavier.
            TouchArea {
                scroll-event(e) => {
                    if (root.sections.length == 0 || root.h-focus) {
                        return EventResult.reject;
                    }
                    let side = e.modifiers.shift ? e.delta-y : e.delta-x;
                    if (side != 0) {
                        if (side < 0 && root.sel-item < root.sections[root.sel-section].items.length - 1) {
                            root.sel-item += 1;
                        } else if (side > 0 && root.sel-item > 0) {
                            root.sel-item -= 1;
                        }
                    } else if (e.delta-y != 0) {
                        // Défilement libre de la page (doigt, molette), sans changer la sélection.
                        let last = root.sections[root.sections.length - 1];
                        let max-y = max(0px, (last.y-px + last.h-px) * 1px - self.height + 16px * root.k);
                        let base = root.home-free ? root.home-free-y : max(0px, root.sections[root.sel-section].y-px * 1px - 4px * root.k);
                        root.home-free-y = clamp(base - e.delta-y, 0px, max-y);
                        root.home-free = true;
                    }
                    return EventResult.accept;
                }
            }

            if root.sections.length == 0: Text {
                text: root.tab == "favorites" ? Tr.t(Tr.k, "Aucun favori pour l'instant.")
                    : root.tab == "requests" ? Tr.t(Tr.k, "Aucune demande pour l'instant.") : Tr.t(Tr.k, "Rien à afficher.");
                color: Theme.muted;
                font-size: 20px * root.k;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            home-clip := Rectangle {
                clip: true;

                home-view := Rectangle {
                    y: root.sections.length == 0 ? 0px
                        : root.home-free ? -root.home-free-y
                        : min(0px, 4px * root.k - root.sections[root.sel-section].y-px * 1px);
                    animate y { duration: Motion.scroll && !Nav.drag ? 180ms : 0ms; easing: ease-out; }

                    for section[si] in root.sections: SectionRow {
                        // Rangée hors de l'écran : sautée au dessin (voir les cartes de SectionRow).
                        visible: section.y-px * 1px + root.stagger(si) + home-view.y < home-clip.height + 60px
                            && section.y-px * 1px + root.stagger(si) + section.h-px * 1px + home-view.y > -60px;
                        y: section.y-px * 1px + root.stagger(si);
                        width: parent.width;
                        height: section.h-px * 1px;
                        title: section.title;
                        items: section.items;
                        card-w: section.landscape ? root.card-w * 1.5 : root.card-w;
                        ratio: section.landscape ? 0.5625 : 1.5;
                        k: root.k;
                        active: !root.h-focus && si == root.sel-section;
                        focus-index: root.sel-item;
                        key: si;
                        touched(i) => {
                            root.h-focus = false;
                            root.sel-section = si;
                            root.sel-item = i;
                        }
                        activated(i) => {
                            root.h-focus = false;
                            root.sel-section = si;
                            root.sel-item = i;
                            root.open-hero(section.items[i].id);
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Watch party

    // ------------------------------------------------------------ Recherche
    if root.screen == "search" && !root.playing: srch := Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        y: root.header-h + (1 - root.page-e) * 28px * root.k;
        height: parent.height - root.header-h;

        property <length> box-h: 52px * root.k;
        property <length> osk-h: root.tv-mode ? 7 * 48px * root.k + 16px * root.k : 0px;
        // Clavier à l'écran : apparaît en descendant et en fondu, les résultats glissent dessous.
        property <float> osk-p: root.tv-mode && root.s-osk ? 1 : 0;
        animate osk-p { duration: Motion.search ? 280ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
        property <length> res-y: 16px * root.k + self.box-h + 16px * root.k + self.osk-p * self.osk-h;

        // Bureau : le champ reprend le clavier, curseur à la fin du texte.
        function s-type() {
            s-input.focus();
            s-input.set-selection-offsets(1000000, 1000000);
        }
        FocusScope {
            // Bureau : un clic à côté du champ ne lui retire pas le clavier.
            focus-on-click: root.tv-mode;
            property <int> tick: root.refocus;
            changed tick => {
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    // Bureau : le clavier retourne au champ s'il l'avait (menu refermé, retour d'une fiche...).
                    if (!root.tv-mode && root.s-field && !root.h-focus) {
                        s-input.focus();
                    } else {
                        self.focus();
                    }
                }
            }
            init => {
                // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                if (root.menu-open) {
                } else if (root.tv-mode || !root.s-field) {
                    self.focus();
                } else {
                    srch.s-type();
                }
            }
            key-pressed(event) => {
                // Touche maintenue : Entrée ne répète pas l'action (ouvrir, lancer la lecture...).
                if (event.repeat && event.text == Key.Return) {
                    return EventResult.accept;
                }
                // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                if (root.loading && event.text == Key.Escape) {
                    root.cancel-open();
                    return EventResult.accept;
                }
                // Vrai clavier : une lettre (ou un effacement) tapée hors du champ y va, au bout du texte ;
                // en mode TV, sans ouvrir le clavier à l'écran (celui-ci, ouvert, la reçoit lui-même).
                if (!(root.tv-mode && root.s-osk) && (root.typing-key(event)
                    || root.erase-key(event, root.tv-mode && (!root.s-field || root.h-focus) ? "" : root.search-text))) {
                    root.h-focus = false;
                    root.s-field = true;
                    root.search-text = root.key-edit(root.search-text, event.text);
                    root.search-changed(root.search-text);
                    if (!root.tv-mode) {
                        srch.s-type();
                    }
                    return EventResult.accept;
                }
                // Touche maintenue : une fois le texte effacé, Retour arrière (ou Échap) ne sert pas de
                // Retour (clavier à l'écran ouvert : c'est lui qui efface).
                if (event.repeat && (event.text == Key.Backspace || event.text == Key.Escape) && !(root.tv-mode && root.s-osk)) {
                    return EventResult.accept;
                }
                if (root.nav-key(event.text)) {
                    // Bureau : en redescendant de la barre, retour au champ s'il avait le clavier.
                    if (!root.tv-mode && !root.h-focus && root.s-field) {
                        s-input.focus();
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.Escape) {
                    root.nav-out("go-home", "");
                    return EventResult.accept;
                }
                // Clavier à l'écran (mode TV)
                if (root.tv-mode && root.s-osk) {
                    if (osk.key(event.text)) {
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
                // Mode TV, sélection sur le champ : OK ouvre le clavier, ↓ va aux résultats, ↑ à la barre.
                if (root.tv-mode && (root.s-field || root.search-sections.length == 0)) {
                    if (event.text == Key.Return) {
                        root.s-field = false;
                        root.s-osk = true;
                    } else if (event.text == Key.DownArrow && root.search-sections.length > 0) {
                        root.s-field = false;
                    } else if (event.text == Key.UpArrow) {
                        root.nav-enter();
                    } else if (event.text == Key.Backspace) {
                        root.nav-out("go-home", "");
                    } else {
                        root.s-field = true;
                    }
                    return EventResult.accept;
                }
                if (root.search-sections.length == 0) {
                    if (event.text == Key.UpArrow) {
                        s-input.focus();
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.RightArrow) {
                    root.s-item = min(root.search-sections[root.s-section].items.length - 1, root.s-item + 1);
                } else if (event.text == Key.LeftArrow) {
                    root.s-item = max(0, root.s-item - 1);
                } else if (event.text == Key.DownArrow) {
                    if (root.s-section < root.search-sections.length - 1) {
                        root.s-item = root.row-to(2000 + root.s-section, root.s-item,
                            root.search-sections[root.s-section].landscape ? root.card-w * 1.5 : root.card-w,
                            2001 + root.s-section, root.search-sections[root.s-section + 1].items.length,
                            root.search-sections[root.s-section + 1].landscape ? root.card-w * 1.5 : root.card-w);
                        root.s-section += 1;
                    }
                } else if (event.text == Key.UpArrow) {
                    if (root.s-section > 0) {
                        root.s-item = root.row-to(2000 + root.s-section, root.s-item,
                            root.search-sections[root.s-section].landscape ? root.card-w * 1.5 : root.card-w,
                            1999 + root.s-section, root.search-sections[root.s-section - 1].items.length,
                            root.search-sections[root.s-section - 1].landscape ? root.card-w * 1.5 : root.card-w);
                        root.s-section -= 1;
                    } else if (root.tv-mode) {
                        // Retour au champ, sans rouvrir le clavier.
                        root.s-field = true;
                    } else {
                        s-input.focus();
                    }
                } else if (event.text == Key.Return) {
                    root.open-hero(root.search-sections[root.s-section].items[root.s-item].id);
                } else if (event.text == Key.Backspace) {
                    root.nav-out("go-home", "");
                }
                return EventResult.accept;
            }
        }

        // Molette : un cran = une rangée de résultats (comme ↑ ↓, du champ aux résultats et retour) ;
        // Maj + molette ou molette horizontale : dans la rangée (comme ← →).
        TouchArea {
            scroll-event(e) => {
                if (root.search-sections.length == 0 || root.h-focus || root.s-osk) {
                    return EventResult.reject;
                }
                let side = e.modifiers.shift ? e.delta-y : e.delta-x;
                if (root.s-field) {
                    if (side == 0 && e.delta-y < 0) {
                        root.s-field = false;
                        root.refocus += 1;
                    }
                } else if (side != 0) {
                    if (side < 0) {
                        root.s-item = min(root.search-sections[root.s-section].items.length - 1, root.s-item + 1);
                    } else {
                        root.s-item = max(0, root.s-item - 1);
                    }
                } else if (e.delta-y < 0 && root.s-section < root.search-sections.length - 1) {
                    root.s-item = root.row-to(2000 + root.s-section, root.s-item,
                        root.search-sections[root.s-section].landscape ? root.card-w * 1.5 : root.card-w,
                        2001 + root.s-section, root.search-sections[root.s-section + 1].items.length,
                        root.search-sections[root.s-section + 1].landscape ? root.card-w * 1.5 : root.card-w);
                    root.s-section += 1;
                } else if (e.delta-y > 0) {
                    if (root.s-section > 0) {
                        root.s-item = root.row-to(2000 + root.s-section, root.s-item,
                            root.search-sections[root.s-section].landscape ? root.card-w * 1.5 : root.card-w,
                            1999 + root.s-section, root.search-sections[root.s-section - 1].items.length,
                            root.search-sections[root.s-section - 1].landscape ? root.card-w * 1.5 : root.card-w);
                        root.s-section -= 1;
                    } else {
                        // Au-dessus des résultats : le champ.
                        root.s-field = true;
                        root.refocus += 1;
                    }
                }
                return EventResult.accept;
            }
        }

        // Champ de recherche
        Rectangle {
            x: 32px * root.k;
            y: 16px * root.k;
            width: parent.width - 64px * root.k;
            height: parent.box-h;
            border-radius: self.height / 2;
            background: Theme.fg.with-alpha(0.08);
            border-width: (root.tv-mode && (root.s-osk || root.s-field)) || s-input.has-focus ? 2px : 1px;
            border-color: (root.tv-mode && (root.s-osk || root.s-field)) || s-input.has-focus ? Theme.accent2 : Theme.fg.with-alpha(0.2);
            clip: true;

            Path {
                x: 18px * root.k;
                y: (parent.height - self.height) / 2;
                width: 22px * root.k;
                height: 22px * root.k;
                viewbox-width: 24;
                viewbox-height: 24;
                fill: transparent;
                stroke: Theme.fg.with-alpha(0.7);
                stroke-width: 2.4px * root.k;
                commands: "M 10.5 3.5 A 7 7 0 1 1 10.49 3.5 Z M 15.6 15.6 L 21 21";
            }
            // Texte tapé (animé, curseur qui clignote) : clavier à l'écran en mode TV, champ
            // classique au bureau (son texte et son curseur sont masqués, celui-ci les dessine).
            TypedText {
                x: 54px * root.k;
                width: parent.width - 70px * root.k;
                height: parent.height;
                text: root.search-text;
                placeholder: Tr.t(Tr.k, "Titre d'un film, d'une série, d'un épisode…");
                cursor: root.tv-mode ? root.s-osk : s-input.has-focus;
                cursor-x: root.tv-mode ? -1px : root.s-cur-x;
                font-size: 18px * root.k;
                k: root.k;
            }
            s-input := TextInput {
                x: 54px * root.k;
                width: parent.width - 70px * root.k;
                height: parent.height;
                visible: !root.tv-mode;
                enabled: !root.tv-mode;
                text <=> root.search-text;
                color: transparent;
                text-cursor-width: 0px;
                font-size: 18px * root.k;
                vertical-alignment: center;
                single-line: true;
                cursor-position-changed(pos) => {
                    root.s-cur-x = pos.x;
                }
                // Bureau : le champ a le clavier (clic, ↑ depuis les résultats...) ; il le retrouvera.
                changed has-focus => {
                    if (self.has-focus && !root.tv-mode) {
                        root.s-field = true;
                        root.h-focus = false;
                    }
                }
                edited => {
                    root.search-changed(self.text);
                }
                key-pressed(event) => {
                    // Touche maintenue : Entrée ne répète pas l'action (ouvrir, lancer la lecture...).
                    if (event.repeat && event.text == Key.Return) {
                        return EventResult.accept;
                    }
                    // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                    if (root.loading && event.text == Key.Escape) {
                        root.cancel-open();
                        return EventResult.accept;
                    }
                    // ↓ / Entrée : vers les résultats (s'il y en a : sinon le champ garde le clavier).
                    if (event.text == Key.DownArrow || event.text == Key.Return) {
                        if (root.search-sections.length > 0) {
                            root.s-field = false;
                            root.refocus += 1;
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.UpArrow) {
                        root.nav-enter();
                        root.refocus += 1;
                        return EventResult.accept;
                    }
                    if (event.text == Key.Escape) {
                        root.nav-out("go-home", "");
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            // Mode TV : un clic sur le champ ouvre le clavier à l'écran (le vrai clavier écrit aussi).
            if root.tv-mode: TouchArea {
                clicked => {
                    root.h-focus = false;
                    root.s-field = false;
                    root.s-osk = true;
                }
            }
        }

        // Clavier à l'écran (mode TV)
        osk := Osk {
            x: max(32px * root.k, (parent.width - 900px * root.k) / 2);
            y: 16px * root.k + parent.box-h + 16px * root.k - (1 - parent.osk-p) * 30px * root.k;
            width: min(parent.width - 64px * root.k, 900px * root.k);
            visible: parent.osk-p > 0.01;
            opacity: parent.osk-p;
            k: root.k;
            active: root.s-osk;
            text: root.search-text;
            erase(t) => {
                return root.text-backspace("\u{8}" + t);
            }
            edited(t) => {
                root.search-text = t;
                root.search-changed(root.search-text);
            }
            // OK du clavier, ou ↓ sous sa dernière ligne : il se ferme ; la sélection va aux
            // résultats (ou reste sur le champ s'il n'y en a pas).
            done => {
                root.s-osk = false;
                root.s-field = root.search-sections.length == 0;
            }
            leave-up => {
                root.nav-enter();
            }
            leave-down => {
                root.s-osk = false;
                root.s-field = root.search-sections.length == 0;
            }
        }

        // Résultats
        Rectangle {
            y: parent.res-y;
            height: parent.height - parent.res-y;
            clip: true;

            if root.search-sections.length == 0: Text {
                text: root.search-busy ? Tr.t(Tr.k, "Recherche…") : root.search-text.character-count >= 2 ? Tr.t(Tr.k, "Aucun résultat.") : "";
                color: Theme.muted;
                font-size: 18px * root.k;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                y: root.search-sections.length == 0 ? 0px
                    : min(0px, 4px * root.k - root.search-sections[root.s-section].y-px * 1px);
                animate y { duration: Motion.scroll ? 180ms : 0ms; easing: ease-out; }

                for section[si] in root.search-sections: SectionRow {
                    y: section.y-px * 1px;
                    width: parent.width;
                    height: section.h-px * 1px;
                    title: section.title;
                    items: section.items;
                    card-w: section.landscape ? root.card-w * 1.5 : root.card-w;
                    ratio: section.landscape ? 0.5625 : 1.5;
                    k: root.k;
                    active: !root.h-focus && !root.s-osk && !(root.tv-mode && root.s-field) && si == root.s-section;
                    focus-index: root.s-item;
                    key: 2000 + si;
                    touched(i) => {
                        root.s-section = si;
                        root.s-item = i;
                    }
                    activated(i) => {
                        root.s-section = si;
                        root.s-item = i;
                        root.open-hero(section.items[i].id);
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Bientôt disponible (Recherche, Paramètres)
    if root.screen == "soon" && !root.playing: Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            init => {
                // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            key-pressed(event) => {
                // Touche maintenue : Entrée, Échap et Retour arrière ne répètent pas l'action (ouvrir, revenir...).
                if (event.repeat && (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace)) {
                    return EventResult.accept;
                }
                // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                if (root.loading && event.text == Key.Escape) {
                    root.cancel-open();
                    return EventResult.accept;
                }
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                if (event.text == Key.UpArrow) {
                    root.nav-enter();
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.nav-out("go-home", "");
                }
                return EventResult.accept;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 14px * root.k;

            Text {
                text: root.soon-title;
                color: Theme.text;
                font-size: 34px * root.k;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: Tr.t(Tr.k, "Bientôt disponible.");
                color: Theme.muted;
                font-size: 18px * root.k;
                horizontal-alignment: center;
            }
            Text {
                text: Tr.t(Tr.k, "Échap ou Retour arrière pour revenir");
                color: Theme.muted;
                font-size: 14px * root.k;
                horizontal-alignment: center;
            }
        }
    }

    // ------------------------------------------------------------ Profil
    if root.screen == "profile" && !root.playing: Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            init => {
                // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            key-pressed(event) => {
                // Touche maintenue : Entrée, Échap et Retour arrière ne répètent pas l'action (ouvrir, revenir...).
                if (event.repeat && (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace)) {
                    return EventResult.accept;
                }
                // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                if (root.loading && event.text == Key.Escape) {
                    root.cancel-open();
                    return EventResult.accept;
                }
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                if (event.text == Key.UpArrow) {
                    root.nav-enter();
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.nav-out("go-home", "");
                } else if (event.text == Key.LeftArrow) {
                    root.prof-sel = 0;
                } else if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                    root.prof-sel = 1;
                } else if (event.text == Key.Return && root.prof-sel == 1) {
                    root.logout();
                }
                return EventResult.accept;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 24px * root.k;

            Text {
                text: root.user-name;
                color: Theme.text;
                font-size: 34px * root.k;
                font-weight: 700;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 16px * root.k;
                height: 44px * root.k;

                ActionButton {
                    text: Tr.t(Tr.k, "Réglages · bientôt");
                    font: 16px * root.k;
                    focused: root.prof-sel == 0;
                    clicked => {
                        root.prof-sel = 0;
                    }
                }
                ActionButton {
                    text: Tr.t(Tr.k, "Déconnexion");
                    font: 16px * root.k;
                    focused: root.prof-sel == 1;
                    clicked => {
                        root.logout();
                    }
                }
            }

            Text {
                text: Tr.t(Tr.k, "Échap ou Retour arrière pour revenir");
                color: Theme.muted;
                font-size: 14px * root.k;
                horizontal-alignment: center;
            }
        }
    }

    // ------------------------------------------------------------ Fiche détail
    play-launch := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            root.run-action("play");
        }
    }
    Timer {
        interval: 8s;
        running: root.play-go && !root.playing;
        triggered => {
            root.play-go = false;
        }
    }

    if root.screen == "detail" && !root.playing: dt := Rectangle {
        // Vignette 16:9 qui devient le fond : la fiche apparaît en fondu pendant la fin de
        // l'agrandissement, au lieu de surgir d'un coup par-dessus l'image encore en vol.
        opacity: root.hero-page-a;
        // Boutons : deux lignes centrées l'une sur l'autre (icônes, puis pastilles).
        property <length> btn-gap: 14px * root.k;
        property <length> icons-w: max(0px, icons-row.preferred-width - (root.detail.buttons.length - root.detail.icon-count) * self.btn-gap);
        // Pas de pastilles (saison...) : les infos remontent d'une ligne.
        property <length> lift: root.detail.buttons.length == root.detail.icon-count ? 34px * root.k : 0px;
        // Les boutons à icône masqués de la ligne des pastilles comptent encore un espacement chacun.
        property <length> chips-w: max(0px, chips-row.preferred-width - root.detail.icon-count * self.btn-gap);
        property <length> btns-w: max(self.icons-w, self.chips-w);
        // Portrait : pastilles plus larges que l'écran -> elles défilent au doigt (ou suivent la sélection).
        property <length> chips-over: root.narrow ? max(0px, dt.chips-w - root.d-low-w) : 0px;
        property <length> chips-free-x;
        property <bool> chips-free;
        property <length> chips-x: dt.chips-free ? dt.chips-free-x : 0px;
        property <int> d-btn-now: root.d-button;
        changed d-btn-now => {
            dt.chips-free = false;
        }
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        y: root.header-h + (1 - root.page-e) * 28px * root.k;
        height: parent.height - root.header-h;
        clip: true; // le contenu défile sous la barre de navigation sans la recouvrir

        // Navigation dans la fiche (zones : boutons, résumé, saisons / épisodes, rangées du bas,
        // « À suivre ») : touches du clavier, et molette (voir plus bas). Vrai si la touche a servi.
        function d-nav(t: string) -> bool {
        // Zone 0 : boutons (↑ : pastilles -> icônes -> barre de navigation)
        if (root.d-zone == 0) {
            if (t == Key.UpArrow) {
                if (root.d-button >= root.detail.icon-count) {
                    root.d-button = 0;
                } else {
                    root.nav-enter();
                }
                return true;
            }
            let on-icons = root.d-button < root.detail.icon-count;
            if (t == Key.RightArrow) {
                if (root.d-button < (on-icons ? root.detail.icon-count : root.detail.buttons.length) - 1) {
                    root.d-button += 1;
                } else if (root.show-next) {
                    root.d-zone = 3;
                }
                return true;
            }
            if (t == Key.LeftArrow) {
                if (root.d-button > (on-icons ? 0 : root.detail.icon-count)) {
                    root.d-button -= 1;
                }
                return true;
            }
            if (t == Key.DownArrow && on-icons && root.detail.buttons.length > root.detail.icon-count) {
                root.d-button = root.detail.icon-count;
                return true;
            }
            if (t == Key.DownArrow) {
                if (root.detail.overview != "") {
                    root.d-zone = 1;
                } else if (root.child-items.length > 0) {
                    root.d-zone = 2;
                } else if (root.detail-rows.length > 0) {
                    root.d-zone = 4;
                    root.d-x = 0;
                }
                return true;
            }
            if (t == Key.Return) {
                root.d-press += 1;
                root.detail-run(root.detail.buttons[root.d-button].action);
                return true;
            }
        }

        // Zone 1 : résumé
        if (root.d-zone == 1) {
            if (t == Key.UpArrow) {
                root.d-zone = 0;
                return true;
            }
            if (t == Key.RightArrow) {
                if (root.show-next) {
                    root.d-zone = 3;
                }
                return true;
            }
            if (t == Key.DownArrow) {
                if (root.child-items.length > 0) {
                    root.d-zone = 2;
                } else if (root.detail-rows.length > 0) {
                    root.d-zone = 4;
                    root.d-x = 0;
                }
                return true;
            }
            if (t == Key.Return) {
                root.overview-open = true;
                return true;
            }
        }

        // Zone 2, épisodes en liste : ↑ ↓ d'un épisode à l'autre, → saute à la suite (rangées du bas).
        if (root.d-zone == 2 && root.ep-list) {
            if (t == Key.DownArrow) {
                if (root.d-child < root.child-items.length - 1) {
                    root.d-child += 1;
                } else if (root.detail-rows.length > 0) {
                    root.d-zone = 4;
                    root.d-x = 0;
                }
                return true;
            }
            if (t == Key.UpArrow) {
                if (root.d-child > 0) {
                    root.d-child -= 1;
                } else {
                    root.d-zone = root.detail.overview != "" ? 1 : 0;
                }
                return true;
            }
            if (t == Key.RightArrow) {
                root.ep-skip();
                return true;
            }
            if (t == Key.LeftArrow) {
                return true;
            }
            if (t == Key.Return) {
                root.open-hero(root.child-items[root.d-child].id);
                return true;
            }
        }

        // Zone 2 : saisons / épisodes
        if (root.d-zone == 2) {
            if (t == Key.RightArrow) {
                if (root.d-child < root.child-items.length - 1) {
                    root.d-child += 1;
                }
                return true;
            }
            if (t == Key.LeftArrow) {
                if (root.d-child > 0) {
                    root.d-child -= 1;
                }
                return true;
            }
            if (t == Key.UpArrow) {
                root.d-zone = root.detail.overview != "" ? 1 : 0;
                return true;
            }
            if (t == Key.DownArrow) {
                if (root.detail-rows.length > 0) {
                    root.d-x = root.detail-pick-down(1002, root.d-child, root.child-card-w, 0);
                    root.d-zone = 4;
                }
                return true;
            }
            if (t == Key.Return) {
                root.open-hero(root.child-items[root.d-child].id);
                return true;
            }
        }

        // Zones 4 et + : rangées du bas
        if (root.d-zone >= 4 && root.d-zone - 4 < root.detail-rows.length) {
            if (t == Key.RightArrow) {
                if (root.d-x < root.detail-rows[root.d-zone - 4].items.length - 1) {
                    root.d-x += 1;
                }
            } else if (t == Key.LeftArrow) {
                if (root.d-x > 0) {
                    root.d-x -= 1;
                }
            } else if (t == Key.DownArrow) {
                if (root.d-zone - 4 < root.detail-rows.length - 1) {
                    root.d-x = root.detail-pick-down(1000 + root.d-zone, root.d-x, root.card-w, root.d-zone - 3);
                    root.d-zone += 1;
                }
            } else if (t == Key.UpArrow) {
                if (root.d-zone > 4) {
                    root.d-x = root.detail-pick-down(1000 + root.d-zone, root.d-x, root.card-w, root.d-zone - 5);
                    root.d-zone -= 1;
                } else if (root.ep-list && root.child-items.length > 0) {
                    // Remontée dans la liste d'épisodes : sur le dernier.
                    root.d-child = root.child-items.length - 1;
                    root.d-zone = 2;
                } else {
                    if (root.child-items.length > 0) {
                        root.d-child = root.row-to(1004, root.d-x, root.card-w, 1002, root.child-items.length, root.child-card-w);
                    }
                    root.d-zone = root.child-items.length > 0 ? 2 : root.detail.overview != "" ? 1 : 0;
                }
            } else if (t == Key.Return) {
                root.open-hero(root.detail-rows[root.d-zone - 4].items[root.d-x].id);
            }
            return true;
        }

        // Zone 3 : bloc « À suivre »
        if (root.d-zone == 3) {
            if (t == Key.LeftArrow) {
                root.d-zone = 0;
                return true;
            }
            if (t == Key.DownArrow) {
                if (root.child-items.length > 0) {
                    root.d-zone = 2;
                }
                return true;
            }
            if (t == Key.Return) {
                root.open-hero(root.detail.next-id);
                return true;
            }
        }
            return false;
        }

        // Réceptionne le clavier / la télécommande (sans taille : seul le focus compte).
        FocusScope {
            width: 0px;
            height: 0px;

            property <int> tick: root.refocus;
            changed tick => {
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }

            init => {
                // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }

            key-pressed(event) => {
                // Une touche rend la fiche à la sélection.
                root.d-free = false;
                // Touche maintenue : Entrée, Échap et Retour arrière ne répètent pas l'action (ouvrir, revenir...).
                if (event.repeat && (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace)) {
                    return EventResult.accept;
                }
                // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                if (root.loading && event.text == Key.Escape) {
                    root.cancel-open();
                    return EventResult.accept;
                }
                // Fiche qui vient de s'afficher : un Entrée de trop (celui qui l'a ouverte) ne lance
                // pas la lecture.
                if (event.text == Key.Return && animation-tick() - root.d-t0 < 600ms) {
                    return EventResult.accept;
                }
                if (root.tp-kind != "") {
                    if (event.text == Key.UpArrow) {
                        root.tp-sel = max(0, root.tp-sel - 1);
                    } else if (event.text == Key.DownArrow) {
                        root.tp-sel = min(root.tp-items.length - 1, root.tp-sel + 1);
                    } else if (event.text == Key.Return) {
                        root.track-pick(root.tp-kind, root.tp-items[root.tp-sel].id, root.tp-items[root.tp-sel].label);
                    } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                        root.tp-kind = "";
                    }
                    return EventResult.accept;
                }
                if (!root.overview-open && root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                // Panneau « résumé complet » ouvert : il capte toutes les touches.
                if (root.overview-open) {
                    if (event.text == Key.DownArrow) {
                        ov-panel.scroll-by(80px);
                    } else if (event.text == Key.UpArrow) {
                        ov-panel.scroll-by(-80px);
                    } else if (event.text == Key.PageDown) {
                        ov-panel.scroll-by(300px);
                    } else if (event.text == Key.PageUp) {
                        ov-panel.scroll-by(-300px);
                    } else if (event.text == Key.Escape || event.text == Key.Backspace || event.text == Key.Return) {
                        root.overview-open = false;
                        ov-panel.reset();
                    }
                    return EventResult.accept;
                }

                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.back-anim();
                    return EventResult.accept;
                }

                if (dt.d-nav(event.text)) {
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
        }

        // Molette : un cran = une rangée (comme ↑ ↓) ; Maj + molette ou molette horizontale : dans
        // la rangée (comme ← →). La page défile comme au clavier.
        TouchArea {
            scroll-event(e) => {
                if (root.h-focus || root.overview-open || root.tp-kind != "") {
                    return EventResult.reject;
                }
                let side = e.modifiers.shift ? e.delta-y : e.delta-x;
                if (side < 0) {
                    dt.d-nav(Key.RightArrow);
                } else if (side > 0) {
                    dt.d-nav(Key.LeftArrow);
                } else if (e.delta-y != 0) {
                    // Défilement libre (doigt, molette), sans changer la sélection.
                    let rows-h = root.detail-rows.length > 0
                        ? (root.detail-rows[root.detail-rows.length - 1].y-px + root.detail-rows[root.detail-rows.length - 1].h-px) * 1px : 0px;
                    let max-y = max(0px, root.d-extra-y + rows-h - self.height + root.header-h);
                    let base = root.d-free ? root.d-free-y : root.d-scroll;
                    root.d-free-y = clamp(base - e.delta-y, 0px, max-y);
                    root.d-free = true;
                } else if (e.delta-y < 0) {
                    dt.d-nav(Key.DownArrow);
                } else if (e.delta-y > 0 && !(root.d-zone == 0 && root.d-button < root.detail.icon-count)) {
                    // Pas de montée dans la barre du haut à la molette.
                    dt.d-nav(Key.UpArrow);
                }
                return EventResult.accept;
            }
        }

        // Contenu qui défile (la barre de navigation reste en place).
        Rectangle {
            y: 0px - root.d-view-y;
            height: parent.height + root.d-view-y;
            animate y { duration: Motion.scroll && !Nav.drag ? 180ms : 0ms; easing: ease-out; }

        // Windows 7 : cadre de verre épais autour de l'affiche (comme les jaquettes de Windows Media Center).
        if Theme.win7 && (!root.hero-covers || root.hero-seerr || root.hero-big): Rectangle {
            x: (root.narrow ? 16px : 32px) - root.po * (root.poster-w + 64px) - 7px;
            y: 24px - 7px;
            width: root.poster-w + 14px;
            height: root.poster-w * 1.5 + 14px;
            border-radius: Theme.radius + 5px;
            background: @linear-gradient(180deg, rgba(185, 222, 252, 0.55) 0%, rgba(110, 168, 230, 0.42) 40%, rgba(60, 120, 200, 0.45) 100%);
            border-width: 1px;
            border-color: rgba(0, 8, 26, 0.8);
            drop-shadow-blur: Nav.no-shadow ? 0px : (18px);
            drop-shadow-color: #00000080;
            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                border-radius: parent.border-radius - 1px;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.6);
            }
        }
        // Poster (portrait)
        Rectangle {
            x: (root.narrow ? 16px : 32px) - root.po * (root.poster-w + 64px);
            y: 24px;
            width: root.poster-w;
            height: root.poster-w * 1.5;
            border-radius: Theme.radius;
            visible: !root.hero-covers || root.hero-seerr || root.hero-big;
            background: transparent;
            if !root.detail.has-poster && !root.d-poster-swap: Placeholder {
                title: root.detail.title;
                k: root.k;
                border-radius: Theme.radius;
            }

            // Ancienne affiche (autre saison / série) : elle reste dessous pendant le fondu.
            if root.d-poster-swap: Image {
                width: parent.width;
                height: parent.height;
                source: root.d-poster-old;
                image-fit: fill;
            }
            // Image déjà recadrée et arrondie (voir Card).
            if root.detail.has-poster: Image {
                width: parent.width;
                height: parent.height;
                opacity: root.d-poster-swap ? root.pm : 1;
                source: root.detail.poster;
                image-fit: fill;
            }
            // Reflet de verre et contour, selon le thème.
            if Theme.sheen > 0: Sheen {
                r: Theme.radius;
                border-bottom-left-radius: Theme.radius;
                border-bottom-right-radius: Theme.radius;
            }
            Rectangle {
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.card-border;
            }
        }

        // Logo, ou titre en texte à défaut
        Rectangle {
            x: root.col-x + root.po-right;
            y: 24px;
            width: root.info-w;
            height: 84px * root.k;
            opacity: (root.sw-title ? root.sw-e : 1) * root.rev(0);

            if root.detail.has-logo: Image {
                x: 0px;
                width: min(parent.width, 420px * root.k);
                height: parent.height;
                source: root.detail.logo;
                image-fit: contain;
            }

            if !root.detail.has-logo && !root.detail.expect-logo: Marquee {
                width: parent.width;
                height: parent.height;
                text: root.detail.title;
                text-color: Theme.text;
                font-size: 34px * root.k;
                font-weight: 800;
                vertical-alignment: center;
                active: true;
                horizontal-alignment: TextHorizontalAlignment.left;
            }
        }

        Marquee {
            x: root.col-x + root.po-right;
            y: 24px + 88px * root.k;
            width: root.info-w;
            height: 24px * root.k;
            opacity: (root.sw-sub ? root.sw-e : 1) * root.rev(0);
            text: root.detail.subtitle;
            text-color: Theme.accent2;
            font-size: 18px * root.k;
            font-weight: 600;
            vertical-alignment: center;
            active: true;
            horizontal-alignment: TextHorizontalAlignment.left;
        }

        // Boutons : icônes (lecture, favori, vu, téléchargement)…
        icons-row := HorizontalLayout {
            x: root.d-low-x + (root.narrow ? 0px : (dt.btns-w - dt.icons-w) / 2) + root.po-right;
            opacity: (root.sw-icons ? root.sw-e : 1) * root.rev(1);
            y: 24px + 118px * root.k + root.d-low;
            width: root.d-low-w;
            height: 40px * root.k;
            spacing: dt.btn-gap;
            alignment: start;

            for b[i] in root.detail.buttons: DetailButton {
                visible: i < root.detail.icon-count;
                width: i < root.detail.icon-count ? (b.icon == "label" ? self.preferred-width : self.height) : 0px;
                text: b.label;
                icon: b.icon;
                active: b.active;
                k: root.k;
                press: root.d-press;
                focused: !root.h-focus && root.d-zone == 0 && root.d-button == i;
                clicked => {
                    root.d-zone = 0;
                    root.d-button = i;
                    root.d-press += 1;
                    root.detail-run(b.action);
                }
            }
        }
        // … puis pastilles compactes (saison, série, langue audio, sous-titres).
        if dt.chips-over > 0px: TouchArea {
            x: root.d-low-x;
            y: 24px + 166px * root.k + root.d-low;
            width: root.d-low-w;
            height: 30px * root.k;
            scroll-event(e) => {
                if (e.delta-x == 0) {
                    return EventResult.reject;
                }
                dt.chips-free-x = max(-dt.chips-over, min(0px, dt.chips-x + e.delta-x));
                dt.chips-free = true;
                return EventResult.accept;
            }
        }
        chips-row := HorizontalLayout {
            opacity: (root.sw-chips ? root.sw-e : 1) * root.rev(1);
            // Les boutons à icône masqués comptent encore dans les espacements : on les compense.
            x: root.d-low-x - root.detail.icon-count * dt.btn-gap + (root.narrow ? dt.chips-x : (dt.btns-w - dt.chips-w) / 2) + root.po-right;
            y: 24px + 166px * root.k + root.d-low;
            width: root.d-low-w;
            height: 30px * root.k;
            spacing: dt.btn-gap;
            alignment: start;

            for b[i] in root.detail.buttons: DetailButton {
                visible: i >= root.detail.icon-count;
                width: i >= root.detail.icon-count ? self.preferred-width : 0px;
                chip: true;
                text: b.label;
                icon: "";
                k: root.k;
                press: root.d-press;
                focused: !root.h-focus && root.d-zone == 0 && root.d-button == i;
                clicked => {
                    root.d-zone = 0;
                    root.d-button = i;
                    root.d-press += 1;
                    root.detail-run(b.action);
                }
            }
        }

        // Année · classification · durée · note
        Text {
            x: root.col-x + root.po-right;
            y: root.narrow ? 24px + 118px * root.k : 24px + 202px * root.k - dt.lift;
            opacity: (root.sw-misc ? root.sw-e : 1) * root.rev(0);
            width: root.info-w;
            height: 24px * root.k;
            text: root.detail.misc;
            color: Theme.muted;
            font-size: 15px * root.k;
            vertical-alignment: center;
            overflow: elide;
        }

        // Résumé (bloc « verre » cliquable)
        if root.detail.overview != "": Rectangle {
            x: root.d-low-x + root.po-right;
            y: 24px + 232px * root.k - dt.lift + root.d-low - (root.narrow ? 30px * root.k : 0px);
            opacity: (root.sw-ov ? root.sw-e : 1) * root.rev(2);
            width: root.d-low-w;
            height: 80px * root.k;
            border-radius: 14px;
            background: !root.h-focus && root.d-zone == 1 ? Theme.fg.with-alpha(0.24) : Theme.fg.with-alpha(0.13);
            border-width: !root.h-focus && root.d-zone == 1 ? 2px : 0px;
            border-color: Theme.accent2;

            Text {
                x: 14px;
                y: 10px;
                width: parent.width - 28px;
                height: parent.height - 20px;
                text: root.detail.overview;
                wrap: word-wrap;
                overflow: elide;
                color: Theme.text;
                font-size: 15px * root.k;
            }

            TouchArea {
                clicked => {
                    root.d-zone = 1;
                    root.overview-open = true;
                }
            }
        }

        // Bloc « À suivre » (séries) : colonne resserrée à droite, comme .nextUpSection
        if root.show-next: Rectangle {
            x: parent.width - 32px - root.next-w + root.po * (root.next-w + 64px);
            y: 24px;
            opacity: (root.sw-next ? root.sw-e : 1) * root.rev(2);
            width: root.next-w;
            height: 228px * root.k;

            Text {
                height: 20px * root.k;
                text: Tr.t(Tr.k, "À SUIVRE");
                color: Theme.muted;
                font-size: 12px * root.k;
                font-weight: 700;
                vertical-alignment: center;
            }

            // Corps de carte aux couleurs du thème (comme les cartes des rangées) : fond, contour, lueur.
            property <bool> nsel: !root.h-focus && root.d-zone == 3;
            Rectangle {
                y: 24px * root.k;
                height: parent.height - self.y;
                border-radius: Theme.radius;
                background: parent.nsel ? Theme.card-focus : Theme.card;
                border-width: 1px;
                border-color: Theme.card-border;
                drop-shadow-blur: Nav.no-shadow ? 0px : (parent.nsel ? 22px * root.k : 0px);
                drop-shadow-color: Theme.glow;
            }
            Rectangle {
                y: 24px * root.k;
                height: root.next-w * 0.5625;
                border-radius: Theme.radius;
                background: transparent;
                if !root.detail.has-next-image: Placeholder {
                    k: root.k;
                    border-radius: Theme.radius;
                }

                // Image déjà recadrée et arrondie (voir Card).
                if root.detail.has-next-image: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.detail.next-image;
                    image-fit: fill;
                }

                if Theme.sheen > 0: Sheen {
                    r: Theme.radius;
                    on: !root.h-focus && root.d-zone == 3;
                }
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-radius: Theme.radius;
                    border-width: !root.h-focus && root.d-zone == 3 ? 3px : 0px;
                    border-color: Theme.accent2;
                }
            }

            Marquee {
                x: 10px * root.k;
                width: parent.width - 20px * root.k;
                y: 24px * root.k + root.next-w * 0.5625 + 6px;
                height: 22px * root.k;
                text: root.detail.next-title;
                text-color: Theme.text;
                font-size: 14px * root.k;
                font-weight: 600;
                active: !root.h-focus && root.d-zone == 3;
                horizontal-alignment: TextHorizontalAlignment.left;
            }

            Marquee {
                x: 10px * root.k;
                width: parent.width - 20px * root.k;
                y: 24px * root.k + root.next-w * 0.5625 + 6px + 22px * root.k;
                height: 18px * root.k;
                text: root.detail.next-subtitle;
                text-color: Theme.muted;
                font-size: 12px * root.k;
                active: !root.h-focus && root.d-zone == 3;
                horizontal-alignment: TextHorizontalAlignment.left;
            }

            TouchArea {
                clicked => {
                    root.d-zone = 3;
                    root.open-hero(root.detail.next-id);
                }
            }
        }

        // Épisodes d'une saison : liste verticale (voir ep-list).
        if root.child-items.length > 0 && root.ep-list: Rectangle {
            x: (root.narrow ? 16px : 32px) + root.po-right;
            y: root.d-children-y + (root.sw-kids ? (1 - root.sw-e) * 40px * root.k : 0px) + (1 - root.rev(3)) * 60px * root.k + root.po-down;
            width: min(parent.width - 2 * (root.narrow ? 16px : 32px), 1200px * root.k);
            height: root.ep-block-h;
            // Titre de la liste (« Épisodes »), et raccourci vers la suite quand la liste est longue.
            Text {
                x: 0px;
                y: 0px;
                height: root.ep-head-h - 12px * root.k;
                text: "— " + root.detail.children-title;
                color: Theme.text;
                font-size: 22px * root.k;
                vertical-alignment: center;
            }
            if root.detail-rows.length > 0 && root.child-items.length > 6: Rectangle {
                property <bool> hot: skip-area.has-hover && !Nav.touch;
                x: parent.width - self.width;
                y: (root.ep-head-h - 12px * root.k - self.height) / 2;
                width: skip-t.preferred-width + 32px * root.k;
                height: 38px * root.k;
                border-radius: self.height / 2;
                background: self.hot ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : Theme.fg.with-alpha(0.1);
                skip-t := Text {
                    text: Tr.f(Tr.k, "Aller à « {} »", root.detail-rows[0].title, "") + "  ↓";
                    color: parent.hot ? Theme.on-accent : Theme.fg;
                    font-size: 14px * root.k;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                skip-area := TouchArea {
                    clicked => {
                        root.ep-skip();
                    }
                }
            }
            for ep[i] in root.child-items: ep-row := Rectangle {
                property <bool> lit: (!root.h-focus && root.d-zone == 2 && root.d-child == i && Nav.kb) || (ep-area.has-hover && !Nav.touch);
                // Hors de l'écran : pas dessiné (saisons de plus de 100 épisodes).
                property <length> top: root.ep-head-h + i * (root.ep-row-h + root.ep-gap);
                visible: parent.y + self.top - root.d-view-y < root.d-view-h + 40px && parent.y + self.top + root.ep-row-h - root.d-view-y > -40px;
                y: self.top;
                width: parent.width;
                height: root.ep-row-h;
                border-radius: 12px * root.k;
                // Résumé long : coupé au bas de la ligne.
                clip: true;
                background: self.lit ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : (Theme.dark ? #00000040 : Theme.fg.with-alpha(0.07));
                animate background { duration: Motion.select ? 150ms : 0ms; }
                // Vignette 16:9, avancement et coche « vu ».
                Rectangle {
                    x: 8px * root.k;
                    y: 8px * root.k;
                    width: root.ep-thumb-w;
                    height: root.ep-thumb-w * 0.5625;
                    border-radius: 8px * root.k;
                    clip: true;
                    background: Theme.fg.with-alpha(0.08);
                    if ep.has-image: Image {
                        width: parent.width;
                        height: parent.height;
                        source: ep.image;
                        image-fit: cover;
                    }
                    if ep.progress > 0 && !ep.played: Rectangle {
                        x: 0px;
                        y: parent.height - self.height;
                        width: parent.width * ep.progress;
                        height: 4px * root.k;
                        background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
                    }
                    if ep.played: Rectangle {
                        x: parent.width - self.width - 6px * root.k;
                        y: 6px * root.k;
                        width: 22px * root.k;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: Theme.accent2;
                        Text {
                            text: "✓";
                            color: Theme.on-accent;
                            font-size: 13px * root.k;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                // Numéro et titre, durée, puis le début du résumé.
                VerticalLayout {
                    x: root.ep-thumb-w + 24px * root.k;
                    y: 10px * root.k;
                    width: parent.width - self.x - 16px * root.k;
                    height: parent.height - 20px * root.k;
                    spacing: 3px * root.k;
                    alignment: start;
                    Text {
                        text: ep.title;
                        color: ep-row.lit ? Theme.on-accent : Theme.fg;
                        font-size: 17px * root.k;
                        font-weight: 700;
                        overflow: elide;
                    }
                    if ep.subtitle != "": Text {
                        text: ep.subtitle;
                        color: (ep-row.lit ? Theme.on-accent : Theme.fg).with-alpha(0.7);
                        font-size: 13px * root.k;
                        overflow: elide;
                    }
                    if ep.overview != "" && !root.narrow: Text {
                        text: ep.overview;
                        color: (ep-row.lit ? Theme.on-accent : Theme.fg).with-alpha(0.8);
                        font-size: 13px * root.k;
                        wrap: word-wrap;
                        overflow: elide;
                        vertical-stretch: 1;
                    }
                }
                ep-area := TouchArea {
                    clicked => {
                        root.d-zone = 2;
                        root.d-child = i;
                        root.open-hero(ep.id);
                    }
                }
            }
        }

        // Saisons / épisodes / contenu
        if root.child-items.length > 0 && !root.ep-list: SectionRow {
            // Glissement seulement : une opacité sur toute la rangée coûte cher sur les petites machines.
            y: root.d-children-y + (root.sw-kids ? (1 - root.sw-e) * 40px * root.k : 0px) + (1 - root.rev(3)) * 60px * root.k + root.po-down;
            width: parent.width;
            height: root.child-card-w * root.child-ratio + 132px * root.k;
            title: root.detail.children-title;
            items: root.child-items;
            card-w: root.child-card-w;
            ratio: root.child-ratio;
            k: root.k;
            active: !root.h-focus && root.d-zone == 2;
            focus-index: root.d-child;
            key: 1002;
            touched(i) => {
                root.d-zone = 2;
                root.d-child = i;
            }
            activated(i) => {
                root.d-zone = 2;
                root.d-child = i;
                root.open-hero(root.child-items[i].id);
            }
        }

        // Rangées du bas : plus de ce genre, Seerr (similaires, recommandés)
        for row[ri] in root.detail-rows: SectionRow {
            y: root.d-extra-y + row.y-px * 1px + root.stagger(ri + 2) + (1 - root.rows-a) * 50px * root.k + (1 - root.rev(4)) * 60px * root.k + root.po-down;
            width: parent.width;
            height: row.h-px * 1px;
            title: row.title;
            items: row.items;
            card-w: root.card-w;
            ratio: 1.5;
            k: root.k;
            active: !root.h-focus && root.d-zone == 4 + ri;
            focus-index: root.d-x;
            key: 1004 + ri;
            touched(i) => {
                root.d-zone = 4 + ri;
                root.d-x = i;
            }
            activated(i) => {
                root.d-zone = 4 + ri;
                root.d-x = i;
                root.open-hero(row.items[i].id);
            }
        }
        }

        // Choix des pistes (au premier plan)
        if root.tp-kind != "": Rectangle {
            background: Theme.scrim.with-alpha(0.65);
            TouchArea {
                clicked => {
                    root.tp-kind = "";
                }
                scroll-event(e) => {
                    return EventResult.accept;
                }
            }
            Rectangle {
                width: min(480px * root.k, parent.width - 32px * root.k);
                height: 70px * root.k + root.tp-items.length * 44px * root.k;
                border-radius: (Theme.win7 ? 8px : 16px);
                background: Theme.win7 ? transparent : Theme.glass;
                border-width: Theme.win7 ? 0px : 1px;
                border-color: Theme.glass-border;
                Gloss { r: parent.border-radius; strength: 0.45; visible: Theme.gloss > 0 && !Theme.win7; }
                WinFrame { r: parent.border-radius; k: root.k; }
                TouchArea {
                    // La molette ne fait pas défiler la page dessous.
                    scroll-event(e) => {
                        return EventResult.accept;
                    }
                }
                Text {
                    x: 24px * root.k;
                    y: 16px * root.k;
                    text: root.tp-kind == "audio" ? Tr.t(Tr.k, "Langue audio") : Tr.t(Tr.k, "Sous-titres");
                    color: Theme.text;
                    font-size: 20px * root.k;
                    font-weight: 700;
                }
                Text {
                    x: 24px * root.k;
                    y: 42px * root.k;
                    text: root.tp-hint;
                    color: Theme.muted;
                    font-size: 12px * root.k;
                }
                for t[i] in root.tp-items: Rectangle {
                    x: 12px * root.k;
                    y: 62px * root.k + i * 44px * root.k;
                    width: parent.width - 24px * root.k;
                    height: 40px * root.k;
                    border-radius: 10px * root.k;
                    background: ((Nav.kb ? (i == root.tp-sel) : tp-area.has-hover && !Nav.touch))
                        ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : transparent;
                    Gloss { r: parent.border-radius; strength: 0.8; visible: Theme.gloss > 0 && ((Nav.kb ? (i == root.tp-sel) : tp-area.has-hover && !Nav.touch)); }
                    if t.current: Rectangle {
                        x: 14px * root.k;
                        y: (parent.height - self.height) / 2;
                        width: 9px * root.k;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: ((Nav.kb ? (i == root.tp-sel) : tp-area.has-hover && !Nav.touch) ? Theme.on-accent : Theme.fg);
                    }
                    Text {
                        x: 34px * root.k;
                        width: parent.width - 44px * root.k;
                        height: parent.height;
                        text: t.label;
                        color: ((Nav.kb ? (i == root.tp-sel) : tp-area.has-hover && !Nav.touch) ? Theme.on-accent : Theme.fg);
                        font-size: 15px * root.k;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    tp-area := TouchArea {
                        clicked => {
                            root.track-pick(root.tp-kind, t.id, t.label);
                        }
                    }
                }
            }
        }

        // Panneau du résumé complet (toujours instancié, affiché à la demande)
        ov-panel := OverviewPanel {
            width: parent.width;
            height: parent.height;
            open: root.overview-open;
            k: root.k;
            text: root.detail.overview;
            font: 20px * root.k;
            close => {
                root.overview-open = false;
            }
        }
    }

    // ------------------------------------------------------------ Bibliothèque (grille)
    if root.screen == "library" && !root.playing: lib := Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        y: root.header-h + (1 - root.page-e) * 28px * root.k;
        height: parent.height - root.header-h;

        property <length> gap: 18px * root.k;
        property <length> pad: 32px * root.k;
        property <length> cw: root.card-w;
        property <length> ch: root.card-w * 1.5 + 56px * root.k;
        property <int> cols: max(1, floor((self.width - 2 * self.pad + self.gap) / (self.cw + self.gap)));
        property <int> rows: ceil(root.lib-items.length / self.cols);
        property <int> sel-row: floor(root.l-sel / self.cols);
        // Première ligne affichée (départ de la vague d'arrivée).
        property <int> top-row: max(0, floor(max(0px, -grid.y - 12px * root.k) / (self.ch + self.gap)));
        // Cartes visibles à l'arrivée (lignes entières ou entamées) : seules celles-là sont distribuées.
        property <int> on-screen: self.cols * max(1, ceil((self.height - 12px * root.k) / (self.ch + self.gap)));
        init => {
            root.deal-n = self.on-screen;
        }
        changed on-screen => {
            root.deal-n = self.on-screen;
        }
        // Grille centrée horizontalement.
        property <length> left: (self.width - (self.cols * (self.cw + self.gap) - self.gap)) / 2;

        // Proche de la fin de ce qui est chargé : page suivante.
        function maybe-more() {
            if (root.l-sel >= root.lib-items.length - 2 * self.cols && root.lib-items.length < root.lib-total) {
                root.lib-more();
            }
        }

        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            init => {
                // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            key-pressed(event) => {
                // Après un défilement libre : la sélection repart de la ligne au milieu de l'écran.
                if (root.lib-free && root.lib-items.length > 0) {
                    let row = clamp(floor((root.lib-free-y + lib.height / 2 - 12px * root.k) / (lib.ch + lib.gap)), 0, lib.rows - 1);
                    root.l-sel = min(root.lib-items.length - 1, row * lib.cols + mod(root.l-sel, lib.cols));
                    root.lib-free = false;
                }
                // Touche maintenue : Entrée, Échap et Retour arrière ne répètent pas l'action (ouvrir, revenir...).
                if (event.repeat && (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace)) {
                    return EventResult.accept;
                }
                // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                if (root.loading && event.text == Key.Escape) {
                    root.cancel-open();
                    return EventResult.accept;
                }
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.back-anim();
                    return EventResult.accept;
                }
                if (root.lib-items.length == 0) {
                    if (event.text == Key.UpArrow) {
                        root.nav-enter();
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.RightArrow) {
                    root.l-sel = min(root.lib-items.length - 1, root.l-sel + 1);
                } else if (event.text == Key.LeftArrow) {
                    root.l-sel = max(0, root.l-sel - 1);
                } else if (event.text == Key.DownArrow) {
                    if (lib.sel-row < lib.rows - 1) {
                        root.l-sel = min(root.lib-items.length - 1, root.l-sel + lib.cols);
                    }
                } else if (event.text == Key.UpArrow) {
                    if (lib.sel-row > 0) {
                        root.l-sel -= lib.cols;
                    } else {
                        root.nav-enter();
                    }
                } else if (event.text == Key.Return) {
                    root.open-hero(root.lib-items[root.l-sel].id);
                }
                lib.maybe-more();
                return EventResult.accept;
            }
            // Molette : une ligne d'affiches par cran (comme ↑ ↓).
            TouchArea {
                scroll-event(e) => {
                    if (root.lib-items.length == 0 || root.h-focus) {
                        return EventResult.reject;
                    }
                    // Défilement libre (doigt, molette), sans changer la sélection ; la page suivante se
                    // charge en approchant de la fin.
                    let view = self.height;
                    let max-y = max(0px, 12px * root.k + lib.rows * (lib.ch + lib.gap) - view + 24px * root.k);
                    let base = root.lib-free ? root.lib-free-y : -min(0px, view / 2 - (12px * root.k + lib.sel-row * (lib.ch + lib.gap) + lib.ch / 2));
                    root.lib-free-y = clamp(base - e.delta-y, 0px, max-y);
                    root.lib-free = true;
                    if (root.lib-free-y > max-y - 2 * (lib.ch + lib.gap) && root.lib-items.length < root.lib-total) {
                        root.lib-more();
                    }
                    return EventResult.accept;
                }
            }
        }

        if root.lib-items.length == 0: Text {
            text: root.lib-total == 0 ? Tr.t(Tr.k, "Chargement…") : "";
            color: Theme.muted;
            font-size: 20px * root.k;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        lib-clip := Rectangle {
            clip: true;

            grid := Rectangle {
                // La rangée sélectionnée reste vers le milieu de l'écran (défilement libre : le décalage).
                y: root.lib-free ? -root.lib-free-y : min(0px, parent.height / 2 - (12px * root.k + lib.sel-row * (lib.ch + lib.gap) + lib.ch / 2));
                animate y { duration: Motion.scroll && !Nav.drag ? 180ms : 0ms; easing: ease-out; }

                for card[i] in root.lib-items: Card {
                    // Collection : la carte part du paquet (centre de l'écran), tournée, et file à sa place.
                    property <float> dp: root.deal-p(i);
                    property <length> bx: lib.left + mod(i, lib.cols) * (lib.cw + lib.gap);
                    // Arrivée de la page : en vague, à partir de la première ligne à l'écran (voir arr).
                    property <float> ap: self.dp < 1 ? 1 : root.arr(floor(i / lib.cols) - lib.top-row, mod(i, lib.cols));
                    property <length> by: 12px * root.k + floor(i / lib.cols) * (lib.ch + lib.gap) + (1 - self.ap) * 36px * root.k;
                    opacity: self.ap;
                    // Ligne hors de l'écran : sautée au dessin (une bibliothèque compte des centaines
                    // de cartes). Pendant la distribution d'une collection, toutes restent visibles.
                    visible: self.dp < 1 || (self.by + grid.y < lib-clip.height + lib.ch && self.by + grid.y > -2 * lib.ch);
                    x: self.bx + (1 - self.dp) * (root.width / 2 - lib.cw / 2 - grid.absolute-position.x - self.bx);
                    y: self.by + (1 - self.dp) * (root.height / 2 - lib.cw * 0.75 - grid.absolute-position.y - self.by);
                    transform-rotation: (1 - self.dp) * (mod(i * 7, 5) - 2) * 7deg;
                    width: lib.cw;
                    height: lib.ch;
                    data: card;
                    ratio: 1.5;
                    k: root.k;
                    focused: !root.h-focus && i == root.l-sel;
                    touched => {
                        root.h-focus = false;
                        root.l-sel = i;
                    }
                    clicked => {
                        root.h-focus = false;
                        root.l-sel = i;
                        root.open-hero(card.id);
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Choix du serveur
    if root.screen == "servers" && !root.playing: srv := Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        y: root.header-h + (1 - root.page-e) * 28px * root.k;
        height: parent.height - root.header-h;

        property <int> n: root.servers.length;
        property <length> col-w: min(self.width - 64px * root.k, 680px * root.k);

        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            init => {
                // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            key-pressed(event) => {
                // Touche maintenue : Entrée, Échap et Retour arrière ne répètent pas l'action (ouvrir, revenir...).
                if (event.repeat && (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace)) {
                    return EventResult.accept;
                }
                // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                if (root.loading && event.text == Key.Escape) {
                    root.cancel-open();
                    return EventResult.accept;
                }
                if (root.manual-open || root.choice-a != "") {
                    return EventResult.reject;
                }
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                // Serveurs trouvés, puis « Rechercher à nouveau » et « Saisir une adresse ».
                if (event.text == Key.UpArrow) {
                    if (root.srv-sel == 0) {
                        root.nav-enter();
                    } else if (root.srv-sel > srv.n) {
                        root.srv-sel = max(0, srv.n - 1);
                    } else {
                        root.srv-sel -= 1;
                    }
                } else if (event.text == Key.DownArrow) {
                    root.srv-sel = min(srv.n, root.srv-sel + 1);
                } else if (event.text == Key.LeftArrow && root.srv-sel == srv.n + 1) {
                    root.srv-sel = srv.n;
                } else if (event.text == Key.RightArrow && root.srv-sel == srv.n) {
                    root.srv-sel = srv.n + 1;
                } else if (event.text == Key.Return) {
                    if (root.srv-sel < srv.n) {
                        root.server-pick(root.srv-sel);
                    } else if (root.srv-sel == srv.n) {
                        root.servers-search();
                    } else {
                        root.open-manual();
                    }
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.nav-out("go-home", "");
                }
                return EventResult.accept;
            }
        }

        VerticalLayout {
            x: (parent.width - srv.col-w) / 2;
            width: srv.col-w;
            alignment: start;
            padding-top: 8px * root.k;
            spacing: 14px * root.k;

            Text {
                text: Tr.t(Tr.k, "Choisir un serveur");
                color: Theme.text;
                font-size: 30px * root.k;
                font-weight: 700;
            }
            // Recherche en cours : trois points qui pulsent.
            HorizontalLayout {
                height: 22px * root.k;
                spacing: 8px * root.k;
                alignment: start;
                Text {
                    text: root.srv-searching ? Tr.t(Tr.k, "Recherche sur tes réseaux")
                        : root.servers.length == 0 ? Tr.t(Tr.k, "Aucun serveur trouvé : saisis son adresse.")
                        : Tr.p(Tr.k, "{n} serveur trouvé sur tes réseaux", "{n} serveurs trouvés sur tes réseaux", root.servers.length);
                    color: Theme.muted;
                    font-size: 15px * root.k;
                    vertical-alignment: center;
                }
                for d[di] in (root.srv-searching ? [0, 1, 2] : []): Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 6px * root.k;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.accent2.transparentize(0.75 - 0.75 * max(0, sin((animation-tick() / 1ms / 300 - di * 0.7) * 1rad)));
                }
            }

            for s[i] in root.servers: srv-card := Rectangle {
                height: 92px * root.k;
                property <bool> sel: !root.h-focus && i == root.srv-sel && Nav.kb;
                property <bool> current: root.server != "" && (s.main == root.server || s.backup == root.server);
                border-radius: 16px * root.k;
                background: self.sel ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%)
                    : ((srv-area.has-hover && !Nav.kb && !Nav.touch) ? ((srv-card.sel ? Theme.on-accent : (srv-card.sel ? Theme.on-accent : Theme.fg))).with-alpha(0.15) : ((srv-card.sel ? Theme.on-accent : (srv-card.sel ? Theme.on-accent : Theme.fg))).with-alpha(0.07));
                Gloss { r: parent.border-radius; strength: 0.8; }
                border-width: self.sel ? 0px : 1px;
                border-color: ((srv-card.sel ? Theme.on-accent : (srv-card.sel ? Theme.on-accent : Theme.fg))).with-alpha(0.12);
                transform-scale: self.sel ? 1.03 : 1.0;
                animate transform-scale { duration: Motion.select ? 220ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

                // Icône de serveur
                Rectangle {
                    x: 20px * root.k;
                    y: (parent.height - self.height) / 2;
                    width: 52px * root.k;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: parent.sel ? ((srv-card.sel ? Theme.on-accent : (srv-card.sel ? Theme.on-accent : Theme.fg))).with-alpha(0.2) : ((srv-card.sel ? Theme.on-accent : (srv-card.sel ? Theme.on-accent : Theme.fg))).with-alpha(0.08);
                    Path {
                        width: 26px * root.k;
                        height: 26px * root.k;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: transparent;
                        stroke: (srv-card.sel ? Theme.on-accent : Theme.fg);
                        stroke-width: 2px * root.k;
                        commands: "M 4 4 L 20 4 L 20 10 L 4 10 Z M 4 14 L 20 14 L 20 20 L 4 20 Z M 7 7 L 8.5 7 M 7 17 L 8.5 17";
                    }
                }
                VerticalLayout {
                    x: 90px * root.k;
                    width: parent.width - self.x - 20px * root.k;
                    alignment: center;
                    spacing: 6px * root.k;
                    HorizontalLayout {
                        spacing: 10px * root.k;
                        alignment: start;
                        Text {
                            text: s.name;
                            color: (srv-card.sel ? Theme.on-accent : Theme.fg);
                            font-size: 20px * root.k;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if s.version != "": Rectangle {
                            width: ver.preferred-width + 16px * root.k;
                            border-radius: self.height / 2;
                            background: ((srv-card.sel ? Theme.on-accent : (srv-card.sel ? Theme.on-accent : Theme.fg))).with-alpha(0.15);
                            ver := Text {
                                text: "Jellyfin " + s.version;
                                color: ((srv-card.sel ? Theme.on-accent : (srv-card.sel ? Theme.on-accent : Theme.fg))).with-alpha(0.85);
                                font-size: 11px * root.k;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if srv-card.current: Rectangle {
                            width: cur.preferred-width + 16px * root.k;
                            border-radius: self.height / 2;
                            background: #15803d;
                            cur := Text {
                                text: Tr.t(Tr.k, "Actuel");
                                color: white;
                                font-size: 11px * root.k;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: Tr.f(Tr.k, "Principale : {}      Secours : {}", s.main != "" ? s.main : "—", s.backup != "" ? s.backup : "—");
                        color: Theme.fg.with-alpha(0.8);
                        font-size: 13px * root.k;
                        overflow: elide;
                    }
                }
                srv-area := TouchArea {
                    clicked => {
                        root.srv-sel = i;
                        root.server-pick(i);
                    }
                }
            }

            HorizontalLayout {
                alignment: start;
                spacing: 16px * root.k;
                height: 46px * root.k;
                padding-top: 4px * root.k;

                ActionButton {
                    text: root.srv-searching ? Tr.t(Tr.k, "Recherche…") : Tr.t(Tr.k, "Rechercher à nouveau");
                    font: 16px * root.k;
                    focused: !root.h-focus && root.srv-sel == root.servers.length && Nav.kb;
                    clicked => {
                        root.servers-search();
                    }
                }
                ActionButton {
                    text: Tr.t(Tr.k, "Saisir une adresse");
                    font: 16px * root.k;
                    focused: !root.h-focus && root.srv-sel == root.servers.length + 1 && Nav.kb;
                    clicked => {
                        root.open-manual();
                    }
                }
            }
        }

        // Saisie d'une adresse : deux adresses possibles pour le même serveur (principale, secours).
        // Mode TV : ↑ ↓ pour choisir, Entrée pour écrire au clavier à l'écran.
        property <float> mo-p: root.manual-open ? 1 : 0;
        animate mo-p { duration: Motion.panels ? 220ms : 0ms; easing: ease-out; }
        property <float> mosk-p: root.manual-open && root.tv-mode && root.manual-osk ? 1 : 0;
        animate mosk-p { duration: Motion.search ? 260ms : 0ms; easing: ease-in-out; }
        if srv.mo-p > 0.01: mbox := Rectangle {
            y: -root.header-h;
            height: parent.height + root.header-h;
            background: Theme.scrim.with-alpha(0.7).transparentize(1 - srv.mo-p);

            TouchArea {
                // La molette ne fait pas défiler la page dessous.
                scroll-event(e) => {
                    return EventResult.accept;
                }
            }

            property <length> dw: min(self.width - 64px * root.k, 600px * root.k);
            // Clavier à l'écran ouvert : seul le champ en cours reste (fenêtre plus petite), pour que le
            // clavier tienne en entier dessous, même sur un petit écran.
            property <bool> one: root.tv-mode && root.manual-osk;
            property <length> dh: (1 - srv.mosk-p) * 384px * root.k + srv.mosk-p * 186px * root.k;
            mdlg := FocusScope {
                x: (parent.width - parent.dw) / 2;
                y: (1 - srv.mosk-p) * (parent.height - parent.dh) / 2 + srv.mosk-p * 20px * root.k
                    + (1 - srv.mo-p) * 30px * root.k - Kb.lift;
                width: parent.dw;
                height: parent.dh;
                // Bureau : un clic à côté d'un champ ne lui retire pas le clavier.
                focus-on-click: root.tv-mode;
                init => {
                    // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                    if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                        self.focus();
                    }
                }
                key-pressed(event) => {
                    // Touche maintenue : Entrée ne répète pas l'action (ouvrir, lancer la lecture...).
                    if (event.repeat && event.text == Key.Return) {
                        return EventResult.accept;
                    }
                    // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                    if (root.loading && event.text == Key.Escape) {
                        root.cancel-open();
                        return EventResult.accept;
                    }
                    if (root.tv-mode && root.manual-osk) {
                        if (m-osk.key(event.text)) {
                            return EventResult.accept;
                        }
                        if (event.text == Key.Escape) {
                            root.manual-osk = false;
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.Escape) {
                        root.close-manual();
                        return EventResult.accept;
                    }
                    // Vrai clavier : une touche tapée va au champ choisi (sur un bouton : le premier).
                    if (root.typing-key(event) || root.erase-key(event, root.manual-field > 1 ? "" : root.manual-field == 1 ? root.manual-remote : root.manual-local)) {
                        if (root.manual-field > 1) {
                            root.manual-field = 0;
                        }
                        if (root.manual-field == 1) {
                            remote-f.type(event.text);
                        } else {
                            local-f.type(event.text);
                        }
                        return EventResult.accept;
                    }
                    // Touche maintenue : une fois le texte effacé, Retour arrière (ou Échap) ne sert pas de Retour.
                    if (event.repeat && (event.text == Key.Backspace || event.text == Key.Escape)) {
                        return EventResult.accept;
                    }
                    if (!root.tv-mode) {
                        return EventResult.reject;
                    }
                    // Champs (0, 1), puis Valider (2) et Annuler (3, à gauche).
                    if (event.text == Key.UpArrow) {
                        root.manual-field = root.manual-field >= 2 ? 1 : max(0, root.manual-field - 1);
                    } else if (event.text == Key.DownArrow) {
                        root.manual-field = min(2, root.manual-field + 1);
                    } else if (event.text == Key.LeftArrow && root.manual-field == 2) {
                        root.manual-field = 3;
                    } else if (event.text == Key.RightArrow && root.manual-field == 3) {
                        root.manual-field = 2;
                    } else if (event.text == Key.Return) {
                        if (root.manual-field <= 1) {
                            root.manual-osk = true;
                        } else if (root.manual-field == 2) {
                            root.manual-go();
                        } else {
                            root.close-manual();
                        }
                    } else if (event.text == Key.Backspace) {
                        root.close-manual();
                    }
                    return EventResult.accept;
                }

                Rectangle {
                    border-radius: (Theme.win7 ? 8px : 20px) * root.k;
                    background: Theme.win7 ? transparent : Theme.glass;
                    border-width: Theme.win7 ? 0px : 1px;
                    border-color: Theme.glass-border;
                    Gloss { r: parent.border-radius; strength: 0.45; visible: Theme.gloss > 0 && !Theme.win7; }
                    WinFrame { r: parent.border-radius; k: root.k; }
                }
                VerticalLayout {
                    padding: 26px * root.k;
                    spacing: 6px * root.k;
                    alignment: start;

                    Text {
                        text: Tr.t(Tr.k, "Adresse du serveur");
                        color: Theme.fg;
                        font-size: 22px * root.k;
                        font-weight: 700;
                    }
                    Text {
                        text: Tr.t(Tr.k, "Sans « http:// » ni « https:// », les deux sont essayés.");
                        visible: !mbox.one;
                        height: mbox.one ? 0px : self.preferred-height;
                        color: Theme.muted;
                        font-size: 13px * root.k;
                    }
                    Rectangle {
                        height: 4px * root.k;
                    }
                    local-f := Field {
                        k: root.k;
                        visible: !mbox.one || root.manual-field == 0;
                        height: self.visible ? 96px * root.k : 0px;
                        label: Tr.t(Tr.k, "Adresse principale");
                        hint: "192.168.1.32:8097";
                        text <=> root.manual-local;
                        shown: root.manual-local;
                        tv: root.tv-mode;
                        selected: root.tv-mode && !root.manual-osk && root.manual-field == 0;
                        editing: root.manual-osk && root.manual-field == 0;
                        error: root.manual-local-err;
                        init => {
                            if (!root.tv-mode) {
                                self.focus-input();
                            }
                        }
                        accepted => {
                            remote-f.focus-input();
                        }
                        got-focus => {
                            root.manual-field = 0;
                        }
                        clicked => {
                            root.manual-field = 0;
                            root.manual-osk = true;
                        }
                    }
                    remote-f := Field {
                        k: root.k;
                        visible: !mbox.one || root.manual-field == 1;
                        height: self.visible ? 96px * root.k : 0px;
                        label: Tr.t(Tr.k, "Adresse de secours · facultative, si la principale ne répond pas");
                        hint: "10.8.0.5:8096";
                        text <=> root.manual-remote;
                        shown: root.manual-remote;
                        tv: root.tv-mode;
                        selected: root.tv-mode && !root.manual-osk && root.manual-field == 1;
                        editing: root.manual-osk && root.manual-field == 1;
                        accepted => {
                            root.manual-go();
                        }
                        got-focus => {
                            root.manual-field = 1;
                        }
                        clicked => {
                            root.manual-field = 1;
                            root.manual-osk = true;
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 14px * root.k;
                        visible: !mbox.one;
                        height: mbox.one ? 0px : 44px * root.k;

                        ActionButton {
                            text: Tr.t(Tr.k, "Annuler");
                            font: 15px * root.k;
                            focused: root.tv-mode && !root.manual-osk && root.manual-field == 3;
                            clicked => {
                                root.close-manual();
                            }
                        }
                        ActionButton {
                            text: root.manual-busy ? Tr.t(Tr.k, "Vérification…") : Tr.t(Tr.k, "Valider");
                            font: 15px * root.k;
                            focused: root.tv-mode ? !root.manual-osk && root.manual-field == 2 : true;
                            clicked => {
                                root.manual-go();
                            }
                        }
                    }
                }
            }

            m-osk := Osk {
                x: (parent.width - self.width) / 2;
                y: mdlg.y + parent.dh + 16px * root.k + (1 - srv.mosk-p) * 60px * root.k;
                width: min(parent.width - 80px * root.k, 760px * root.k);
                visible: root.tv-mode && srv.mosk-p > 0.01;
                k: root.k;
                active: root.manual-osk;
                text: root.manual-field == 0 ? root.manual-local : root.manual-remote;
                ok-label: root.manual-field == 0 ? Tr.t(Tr.k, "Suivant") : Tr.t(Tr.k, "Valider");
                erase(t) => {
                    return root.text-backspace("\u{8}" + t);
                }
                edited(t) => {
                    if (root.manual-field == 0) {
                        root.manual-local = t;
                    } else {
                        root.manual-remote = t;
                    }
                }
                done => {
                    if (root.manual-field == 0) {
                        root.manual-field = 1;
                    } else {
                        root.manual-osk = false;
                        root.manual-go();
                    }
                }
                leave-up => {
                    root.manual-osk = false;
                }
                leave-down => {
                    root.manual-osk = false;
                    root.manual-field = 2;
                }
            }

            // Vérification en cours, ou erreur du serveur : bulle en bas.
            if (root.manual-busy || root.manual-error != "") && srv.mosk-p < 0.5: Bubble {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 28px * root.k;
                k: root.k;
                max-w: parent.width - 80px * root.k;
                text: root.manual-busy ? Tr.t(Tr.k, "Vérification des adresses…") : root.manual-error;
                error: !root.manual-busy;
            }
        }

        // http et https répondent tous deux : l'utilisateur choisit.
        if root.choice-a != "": Rectangle {
            background: Theme.scrim.with-alpha(0.75);

            TouchArea {
                // La molette ne fait pas défiler la page dessous.
                scroll-event(e) => {
                    return EventResult.accept;
                }
            }

            choice := Rectangle {
                width: min(600px * root.k, parent.width - 32px * root.k);
                height: 190px * root.k;
                border-radius: (Theme.win7 ? 8px : 16px);
                background: Theme.win7 ? transparent : Theme.glass;
                border-width: Theme.win7 ? 0px : 1px;
                border-color: Theme.glass-border;
                Gloss { r: parent.border-radius; strength: 0.45; visible: Theme.gloss > 0 && !Theme.win7; }
                WinFrame { r: parent.border-radius; k: root.k; }

                property <int> pick: 0;

                FocusScope {
                    init => {
                        // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                        if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                            self.focus();
                        }
                    }
                    key-pressed(event) => {
                        // Touche maintenue : Entrée, Échap et Retour arrière ne répètent pas l'action (ouvrir, revenir...).
                        if (event.repeat && (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace)) {
                            return EventResult.accept;
                        }
                        // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                        if (root.loading && event.text == Key.Escape) {
                            root.cancel-open();
                            return EventResult.accept;
                        }
                        if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                            choice.pick = 0;
                        } else if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                            choice.pick = 1;
                        } else if (event.text == Key.Return) {
                            root.manual-choice(choice.pick == 0 ? root.choice-a : root.choice-b);
                        } else if (event.text == Key.Escape) {
                            root.manual-choice("");
                        }
                        return EventResult.accept;
                    }
                }

                VerticalLayout {
                    padding: 24px * root.k;
                    spacing: 18px * root.k;

                    Text {
                        text: Tr.t(Tr.k, "Deux adresses répondent. Laquelle utiliser ?");
                        color: Theme.text;
                        font-size: 18px * root.k;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 14px * root.k;
                        height: 44px * root.k;

                        ActionButton {
                            text: root.choice-a;
                            font: 15px * root.k;
                            focused: choice.pick == 0;
                            clicked => {
                                root.manual-choice(root.choice-a);
                            }
                        }
                        ActionButton {
                            text: root.choice-b;
                            font: 15px * root.k;
                            focused: choice.pick == 1;
                            clicked => {
                                root.manual-choice(root.choice-b);
                            }
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Téléchargements
    // Comme l'accueil : rangées (Reprendre, Séries, Films) ; les fiches marchent sans serveur.
    if root.screen == "downloads" && !root.playing: dls := Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        y: root.header-h + (1 - root.page-e) * 28px * root.k;
        height: parent.height - root.header-h;

        property <length> top: root.dl-status != "" ? 40px * root.k : 0px;
        pure function w(si: int) -> length {
            return root.dl-sections[si].landscape ? root.card-w * 1.5 : root.card-w;
        }

        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            init => {
                // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            key-pressed(event) => {
                // Touche maintenue : Entrée, Échap et Retour arrière ne répètent pas l'action (ouvrir, revenir...).
                if (event.repeat && (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace)) {
                    return EventResult.accept;
                }
                // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                if (root.loading && event.text == Key.Escape) {
                    root.cancel-open();
                    return EventResult.accept;
                }
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                // Hors ligne, la liste des téléchargements tient lieu d'accueil : Échap ouvre le menu.
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    if (root.offline && root.dl-level == 0) {
                        root.open-menu();
                    } else {
                        root.nav-out("go-home", "");
                    }
                    return EventResult.accept;
                }
                if (root.dl-sections.length == 0) {
                    if (event.text == Key.UpArrow) {
                        root.nav-enter();
                    }
                    return EventResult.accept;
                }
                if (event.text == Key.RightArrow) {
                    root.dl-item = min(root.dl-sections[root.dl-sec].items.length - 1, root.dl-item + 1);
                } else if (event.text == Key.LeftArrow) {
                    // Tout à gauche : le menu s'ouvre (comme sur l'accueil).
                    if (root.dl-item == 0) {
                        root.open-menu();
                    }
                    root.dl-item = max(0, root.dl-item - 1);
                } else if (event.text == Key.DownArrow) {
                    if (root.dl-sec < root.dl-sections.length - 1) {
                        root.dl-item = root.row-to(3000 + root.dl-sec, root.dl-item, dls.w(root.dl-sec),
                            3001 + root.dl-sec, root.dl-sections[root.dl-sec + 1].items.length, dls.w(root.dl-sec + 1));
                        root.dl-sec += 1;
                    }
                } else if (event.text == Key.UpArrow) {
                    if (root.dl-sec > 0) {
                        root.dl-item = root.row-to(3000 + root.dl-sec, root.dl-item, dls.w(root.dl-sec),
                            2999 + root.dl-sec, root.dl-sections[root.dl-sec - 1].items.length, dls.w(root.dl-sec - 1));
                        root.dl-sec -= 1;
                    } else {
                        root.nav-enter();
                    }
                } else if (event.text == Key.Return) {
                    root.open-hero(root.dl-sections[root.dl-sec].items[root.dl-item].id);
                }
                return EventResult.accept;
            }
        }

        // Molette : un cran = une rangée (comme ↑ ↓) ; Maj + molette ou molette horizontale : dans
        // la rangée (comme ← →).
        TouchArea {
            scroll-event(e) => {
                if (root.dl-sections.length == 0 || root.h-focus) {
                    return EventResult.reject;
                }
                let side = e.modifiers.shift ? e.delta-y : e.delta-x;
                if (side < 0) {
                    root.dl-item = min(root.dl-sections[root.dl-sec].items.length - 1, root.dl-item + 1);
                } else if (side > 0) {
                    root.dl-item = max(0, root.dl-item - 1);
                } else if (e.delta-y < 0 && root.dl-sec < root.dl-sections.length - 1) {
                    root.dl-item = root.row-to(3000 + root.dl-sec, root.dl-item, dls.w(root.dl-sec),
                        3001 + root.dl-sec, root.dl-sections[root.dl-sec + 1].items.length, dls.w(root.dl-sec + 1));
                    root.dl-sec += 1;
                } else if (e.delta-y > 0 && root.dl-sec > 0) {
                    root.dl-item = root.row-to(3000 + root.dl-sec, root.dl-item, dls.w(root.dl-sec),
                        2999 + root.dl-sec, root.dl-sections[root.dl-sec - 1].items.length, dls.w(root.dl-sec - 1));
                    root.dl-sec -= 1;
                }
                return EventResult.accept;
            }
        }

        if root.dl-status != "": Text {
            x: 32px * root.k;
            y: 4px * root.k;
            height: 32px * root.k;
            text: root.dl-status;
            color: Theme.accent2;
            font-size: 15px * root.k;
            font-weight: 600;
            vertical-alignment: center;
        }

        if root.dl-sections.length == 0: Text {
            text: root.offline ? Tr.t(Tr.k, "Aucun téléchargement : rien à regarder hors ligne.")
                : Tr.t(Tr.k, "Aucun téléchargement.\nSur la fiche d'un film ou d'une série, le bouton Télécharger permet de regarder hors ligne.");
            x: 24px * root.k;
            width: parent.width - 48px * root.k;
            wrap: word-wrap;
            color: Theme.muted;
            font-size: 18px * root.k;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            y: dls.top;
            height: parent.height - dls.top;
            clip: true;

            Rectangle {
                y: root.dl-sections.length == 0 ? 0px
                    : min(0px, 4px * root.k - root.dl-sections[root.dl-sec].y-px * 1px);
                animate y { duration: Motion.scroll ? 180ms : 0ms; easing: ease-out; }

                for section[si] in root.dl-sections: SectionRow {
                    y: section.y-px * 1px + root.stagger(si);
                    width: parent.width;
                    height: section.h-px * 1px;
                    title: section.title;
                    items: section.items;
                    card-w: section.landscape ? root.card-w * 1.5 : root.card-w;
                    ratio: section.landscape ? 0.5625 : 1.5;
                    k: root.k;
                    active: !root.h-focus && si == root.dl-sec;
                    focus-index: root.dl-item;
                    key: 3000 + si;
                    touched(i) => {
                        root.h-focus = false;
                        root.dl-sec = si;
                        root.dl-item = i;
                    }
                    activated(i) => {
                        root.h-focus = false;
                        root.dl-sec = si;
                        root.dl-item = i;
                        root.open-hero(section.items[i].id);
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Paramètres
    if root.screen == "settings" && !root.playing: sets := Rectangle {
        // Arrivée de la page : léger zoom et glissement (voir page-enter).
        transform-scale: 0.96 + 0.04 * root.page-e;
        y: root.header-h + (1 - root.page-e) * 28px * root.k;
        height: parent.height - root.header-h;

        property <[string]> cat-icons: ["profile", "play", "subs", "display", "network", "motion", "about"];
        property <[string]> cats: [Tr.t(Tr.k, "Compte"), Tr.t(Tr.k, "Lecture"), Tr.t(Tr.k, "Sous-titres"), Tr.t(Tr.k, "Affichage"), Tr.t(Tr.k, "Réseau"), Tr.t(Tr.k, "Animations"), Tr.t(Tr.k, "À propos")];
        // Écran étroit (téléphone tenu droit) : une colonne à la fois, comme les réglages d'un téléphone :
        // la liste des catégories, puis la catégorie touchée en plein écran (Retour : la liste).
        // set-in (sélection dans les lignes) dit laquelle est affichée.
        property <bool> one: root.set-one;
        property <float> one-p: self.one && root.set-in ? 1 : 0;
        animate one-p { duration: Motion.panels ? 260ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
        property <length> left-w: self.one ? self.width - 32px * root.k : 260px * root.k;

        // Choix de l'avatar : catégories à gauche (s'il y en a plusieurs), grille qui défile à droite.
        property <bool> av-multi: root.av-groups.length > 1;
        property <length> av: 104px * root.k;                   // diamètre d'un avatar
        property <length> av-cw: self.av + 30px * root.k;        // case : avatar + marge (il grossit quand il est choisi)
        property <length> av-ch: self.av + 50px * root.k;        // case : avatar + nom
        property <length> av-gx: self.av-multi ? 32px * root.k + 250px * root.k + 24px * root.k : 32px * root.k;
        property <length> av-gw: self.width - self.av-gx - 32px * root.k;
        property <length> av-gh: self.height - 80px * root.k - 16px * root.k;
        property <int> av-cols: max(1, floor((self.av-gw - 28px * root.k) / self.av-cw));
        property <int> av-rows: max(1, floor((self.av-gh - 28px * root.k) / self.av-ch));
        property <int> av-lines: ceil(root.avatar-items.length / self.av-cols);
        // Images à charger : rangées visibles et les deux suivantes (le reste attend le défilement).
        property <int> av-want: (root.av-top + self.av-rows + 2) * self.av-cols;
        changed av-want => {
            root.avatar-want(self.av-want);
        }
        property <length> g-h: 46px * root.k;
        property <int> g-vis: max(1, floor(self.av-gh / (self.g-h + 6px * root.k)));
        // Garde la rangée de l'avatar choisi à l'écran (défilement de la grille).
        function av-follow() {
            let r = floor(root.av-sel / sets.av-cols);
            if (r < root.av-top) {
                root.av-top = r;
            } else if (r >= root.av-top + sets.av-rows) {
                root.av-top = r - sets.av-rows + 1;
            }
        }
        function g-follow() {
            if (root.av-group < root.g-top) {
                root.g-top = root.av-group;
            } else if (root.av-group >= root.g-top + sets.g-vis) {
                root.g-top = root.av-group - sets.g-vis + 1;
            }
        }
        function av-scroll(d: int) {
            root.av-top = max(0, min(sets.av-lines - sets.av-rows, root.av-top + d));
        }

        // Animations au temps (rien n'est redessiné en dehors) : lignes de la catégorie choisie en
        // cascade, avatars en cascade à l'ouverture du choix et à chaque changement de catégorie.
        property <bool> rw-anim;
        property <duration> rw-t0;
        property <float> rw-q: self.rw-anim && Motion.panels ? clamp((animation-tick() - self.rw-t0) / 650ms, 0, 1) : 1;
        function rows-in() {
            sets.rw-t0 = animation-tick();
            sets.rw-anim = true;
        }
        // Relancée pendant qu'elle tourne, l'animation repart de zéro : on s'arrête sur le dernier départ
        // (une minuterie de la durée totale, elle, ne repart pas et coupait l'animation en route).
        Timer {
            interval: 100ms;
            running: sets.rw-anim;
            triggered => {
                if (animation-tick() - sets.rw-t0 > 680ms) {
                    sets.rw-anim = false;
                }
            }
        }
        pure function rw-e(i: int) -> float {
            // Décalage plafonné : même la 15e ligne a fini d'arriver à la fin de l'animation.
            let x = clamp(sets.rw-q * 2.2 - min(i, 8) * 0.15, 0, 1);
            return 1 - (1 - x) * (1 - x) * (1 - x);
        }
        property <bool> ai-anim;
        property <duration> ai-t0;
        property <float> ai-q: self.ai-anim && Motion.panels ? clamp((animation-tick() - self.ai-t0) / 700ms, 0, 1) : 1;
        function av-in() {
            sets.ai-t0 = animation-tick();
            sets.ai-anim = true;
        }
        // Relancée pendant qu'elle tourne, l'animation repart de zéro : on s'arrête sur le dernier départ
        // (une minuterie de la durée totale, elle, ne repart pas et coupait l'animation en route).
        Timer {
            interval: 100ms;
            running: sets.ai-anim;
            triggered => {
                if (animation-tick() - sets.ai-t0 > 720ms) {
                    sets.ai-anim = false;
                }
            }
        }
        // Rangée n° r à l'écran (0 = la première visible).
        pure function ai-e(r: int) -> float {
            let x = clamp(sets.ai-q * 2.4 - r * 0.22, 0, 1);
            return 1 - (1 - x) * (1 - x) * (1 - x);
        }
        property <bool> avo: root.av-open;
        changed avo => {
            if (root.av-open) {
                sets.av-in();
            }
        }
        property <int> avg: root.av-group;
        changed avg => {
            sets.av-in();
        }
        init => {
            sets.rows-in();
        }

        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            init => {
                // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            key-pressed(event) => {
                // Touche maintenue : Entrée, Échap et Retour arrière ne répètent pas l'action (ouvrir, revenir...).
                if (event.repeat && (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace)) {
                    return EventResult.accept;
                }
                // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                if (root.loading && event.text == Key.Escape) {
                    root.cancel-open();
                    return EventResult.accept;
                }
                // Nouveautés d'une mise à jour : ↑ ↓ font défiler, Échap / Retour / Entrée ferment.
                if (root.notes-open) {
                    if (event.text == Key.DownArrow) {
                        notes-p.scroll-by(80px);
                    } else if (event.text == Key.UpArrow) {
                        notes-p.scroll-by(-80px);
                    } else if (event.text == Key.PageDown) {
                        notes-p.scroll-by(300px);
                    } else if (event.text == Key.PageUp) {
                        notes-p.scroll-by(-300px);
                    } else if (event.text == Key.Escape || event.text == Key.Backspace || event.text == Key.Return) {
                        root.notes-open = false;
                        notes-p.reset();
                    }
                    return EventResult.accept;
                }
                // Saisie d'une adresse : la fenêtre a son propre clavier.
                if (root.addr-edit > 0) {
                    return EventResult.reject;
                }
                if (root.av-open) {
                    if (root.nav-key(event.text)) {
                        return EventResult.accept;
                    }
                    if (event.text == Key.Escape || event.text == Key.Backspace) {
                        root.av-open = false;
                        return EventResult.accept;
                    }
                    if (root.av-zone == 0) {
                        // Catégories d'avatars ; ↑ depuis la première : barre du haut.
                        if (event.text == Key.UpArrow && root.av-group == 0) {
                            root.nav-enter();
                        } else if (event.text == Key.UpArrow && root.av-group > 0) {
                            root.av-group -= 1;
                            sets.g-follow();
                            root.avatar-group(root.av-group);
                        } else if (event.text == Key.DownArrow && root.av-group < root.av-groups.length - 1) {
                            root.av-group += 1;
                            sets.g-follow();
                            root.avatar-group(root.av-group);
                        } else if ((event.text == Key.RightArrow || event.text == Key.Return) && root.avatar-items.length > 0) {
                            root.av-zone = 1;
                            root.avatar-focus(root.av-sel);
                        }
                        return EventResult.accept;
                    }
                    // Grille
                    if (root.avatar-items.length == 0) {
                        if (event.text == Key.LeftArrow && sets.av-multi) {
                            root.av-zone = 0;
                        } else if (event.text == Key.UpArrow) {
                            root.nav-enter();
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.RightArrow) {
                        if (mod(root.av-sel, sets.av-cols) < sets.av-cols - 1 && root.av-sel < root.avatar-items.length - 1) {
                            root.av-sel += 1;
                        }
                    } else if (event.text == Key.LeftArrow) {
                        if (mod(root.av-sel, sets.av-cols) == 0) {
                            if (sets.av-multi) {
                                root.av-zone = 0;
                            }
                        } else {
                            root.av-sel -= 1;
                        }
                    } else if (event.text == Key.DownArrow) {
                        // Dernière rangée incomplète : on va sur le dernier avatar.
                        if (floor(root.av-sel / sets.av-cols) < sets.av-lines - 1) {
                            root.av-sel = min(root.avatar-items.length - 1, root.av-sel + sets.av-cols);
                        }
                    } else if (event.text == Key.UpArrow) {
                        if (root.av-sel >= sets.av-cols) {
                            root.av-sel -= sets.av-cols;
                        } else {
                            root.nav-enter();
                        }
                    } else if (event.text == Key.Return) {
                        if (root.av-busy == "") {
                            root.av-press += 1;
                            root.avatar-pick(root.avatar-items[root.av-sel].id);
                        }
                    }
                    sets.av-follow();
                    return EventResult.accept;
                }
                // Liste de choix ouverte : ↑ ↓ choisir, Entrée valider, Échap / ← fermer.
                if (root.ch-key != "") {
                    if (event.text == Key.UpArrow) {
                        root.ch-sel = max(0, root.ch-sel - 1);
                    } else if (event.text == Key.DownArrow) {
                        root.ch-sel = min(root.ch-items.length - 1, root.ch-sel + 1);
                    } else if (event.text == Key.Return) {
                        // Langue : la liste reste ouverte pendant l'effet de changement (Rust la ferme).
                        root.settings-choose(root.ch-key, root.ch-items[root.ch-sel].id);
                        if (root.ch-key != "language") {
                            root.ch-key = "";
                        }
                    } else if (event.text == Key.Escape || event.text == Key.Backspace || event.text == Key.LeftArrow) {
                        root.ch-key = "";
                    }
                    return EventResult.accept;
                }
                if (root.nav-key(event.text)) {
                    return EventResult.accept;
                }
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    if (root.set-in) {
                        root.set-in = false;
                    } else {
                        root.nav-out("go-home", "");
                    }
                    return EventResult.accept;
                }
                if (!root.set-in) {
                    // Colonne des catégories
                    if (event.text == Key.UpArrow) {
                        if (root.set-cat == 0) {
                            root.nav-enter();
                        } else {
                            root.set-cat -= 1;
                            root.settings-category();
                            sets.rows-in();
                        }
                    } else if (event.text == Key.DownArrow) {
                        if (root.set-cat < sets.cats.length - 1) {
                            root.set-cat += 1;
                            root.settings-category();
                            sets.rows-in();
                        }
                    } else if (event.text == Key.RightArrow || event.text == Key.Return) {
                        // Première ligne réglable (les lignes d'information ne se sélectionnent pas).
                        let f = root.settings-step(-1, 1);
                        if (f >= 0) {
                            root.set-in = true;
                            root.set-sel = f;
                        }
                    }
                    return EventResult.accept;
                }
                // Lignes : les lignes d'information sont sautées, quel que soit leur nombre.
                if (event.text == Key.UpArrow) {
                    root.set-sel = root.settings-step(root.set-sel, -1);
                } else if (event.text == Key.DownArrow) {
                    root.set-sel = root.settings-step(root.set-sel, 1);
                } else if (event.text == Key.LeftArrow) {
                    root.set-in = false;
                } else if (event.text == Key.Return || (event.text == Key.RightArrow && root.set-rows[root.set-sel].kind == "choice")) {
                    root.settings-activate(root.set-rows[root.set-sel].key);
                }
                return EventResult.accept;
            }
        }

        // Colonne des catégories : elle défile si elle ne tient pas (petit écran, interface TV) ; elle
        // suit la catégorie choisie, ou le doigt / la molette (défilement libre).
        property <length> cat-view-h: self.height - 56px * root.k - 16px * root.k;
        property <length> cat-max: max(0px, sets.cats.length * 52px * root.k + 8px * root.k - sets.cat-view-h);
        property <bool> cat-free;
        property <length> cat-free-y;
        property <length> cat-y: sets.cat-free ? sets.cat-free-y
            : clamp(root.set-cat * 52px * root.k + 23px * root.k - sets.cat-view-h / 2, 0px, sets.cat-max);
        // La colonne glisse (doigt, molette, catégorie choisie) en douceur ; elle se remet en place
        // quand sa taille change (interface TV retirée : elle tient de nouveau en entier).
        animate cat-y { duration: Motion.scroll && !Nav.drag ? 300ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
        property <int> cat-now: root.set-cat;
        changed cat-now => {
            sets.cat-free = false;
        }
        changed cat-max => {
            sets.cat-free = false;
        }
        Rectangle {
            y: 56px * root.k;
            height: parent.height - self.y;
            width: sets.left-w + 8px * root.k;
            x: -sets.one-p * parent.width;
            opacity: 1 - sets.one-p;
            visible: sets.one-p < 0.99;
            clip: true;
            TouchArea {
                scroll-event(e) => {
                    if (sets.cat-max <= 0px || e.delta-y == 0px) {
                        return EventResult.reject;
                    }
                    let base = sets.cat-free ? sets.cat-free-y : sets.cat-y;
                    sets.cat-free-y = clamp(base - e.delta-y, 0px, sets.cat-max);
                    sets.cat-free = true;
                    return EventResult.accept;
                }
            }
            // Windows 7 : la colonne est un volet de verre (comme le volet de navigation de l'Explorateur).
            if Theme.win7: Rectangle {
                x: 24px * root.k;
                y: 0px;
                width: sets.left-w - 16px * root.k;
                height: min(parent.height - 8px * root.k, sets.cats.length * 52px * root.k + 18px * root.k);
                border-radius: 6px * root.k;
                background: @linear-gradient(180deg, rgba(190, 225, 252, 0.30) 0%, rgba(110, 165, 225, 0.20) 100%);
                border-width: 1px;
                border-color: rgba(0, 10, 30, 0.6);
                Rectangle {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    border-radius: parent.border-radius - 1px;
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.35);
                }
            }
            // Catégories : la surbrillance glisse jusqu'à la catégorie choisie (dégradé quand la
            // sélection est dans la colonne, gris quand elle est dans les lignes).
            Rectangle {
                x: 32px * root.k;
                y: 8px * root.k + root.set-cat * 52px * root.k - sets.cat-y;
                animate y { duration: Motion.scroll && !Nav.drag ? 300ms : 0ms; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
                width: sets.left-w - 32px * root.k;
                height: 46px * root.k;
                border-radius: (Theme.win7 ? 4px : 10px) * root.k;
                // Windows 7 : sélection bleue brillante de l'Explorateur (verre bleu clair, liseré).
                background: Theme.win7 ? @linear-gradient(180deg, rgba(205, 238, 255, 0.62) 0%, rgba(140, 205, 250, 0.50) 48%, rgba(75, 160, 235, 0.55) 52%, rgba(120, 200, 255, 0.62) 100%)
                    : Theme.fg.with-alpha(0.12);
                border-width: Theme.win7 ? 1px : 0px;
                border-color: #0f4f8f;
                drop-shadow-blur: Nav.no-shadow ? 0px : (Theme.win7 ? 10px * root.k : 0px);
                drop-shadow-color: #5cc6ff90;
                if Theme.win7: Rectangle {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    border-radius: 3px * root.k;
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.75);
                }
                Rectangle {
                    border-radius: parent.border-radius;
                    background: @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%);
                    Gloss { r: parent.border-radius; strength: 0.8; }
                    opacity: !root.set-in && !root.h-focus && Nav.kb ? 1 : 0;
                    animate opacity { duration: Motion.panels ? 200ms : 0ms; }
                }
            }
            for c[i] in sets.cats: Rectangle {
                x: 32px * root.k;
                y: 8px * root.k + i * 52px * root.k - sets.cat-y;
                width: sets.left-w - 32px * root.k;
                height: 46px * root.k;
                border-radius: 10px * root.k;
                background: cat-area.has-hover && !Nav.touch && i != root.set-cat ? ((i == root.set-cat && !root.set-in && !root.h-focus && Nav.kb ? Theme.on-accent : (i == root.set-cat && !root.set-in && !root.h-focus && Nav.kb ? Theme.on-accent : Theme.fg))).with-alpha(0.08) : transparent;
                NavIcon {
                    x: 14px * root.k;
                    y: (parent.height - self.height) / 2;
                    width: 22px * root.k;
                    height: 22px * root.k;
                    name: sets.cat-icons[i];
                    tint: i == root.set-cat && !root.set-in && !root.h-focus && Nav.kb ? Theme.on-accent : Theme.fg;
                }
                Text {
                    x: 46px * root.k;
                    height: parent.height;
                    text: c;
                    color: (i == root.set-cat && !root.set-in && !root.h-focus && Nav.kb ? Theme.on-accent : Theme.fg);
                    font-size: 17px * root.k;
                    font-weight: i == root.set-cat ? 700 : 500;
                    vertical-alignment: center;
                }
                if i == 0: AlertBadge {
                    k: root.k;
                    x: parent.width - self.width - 12px * root.k;
                    y: (parent.height - self.height) / 2;
                }
                cat-area := TouchArea {
                    clicked => {
                        if (root.set-cat != i) {
                            root.set-cat = i;
                            root.settings-category();
                            sets.rows-in();
                        }
                        // Portrait : la catégorie touchée s'ouvre en plein écran.
                        root.set-in = sets.one;
                        if (sets.one) {
                            sets.rows-in();
                        }
                    }
                }
            }
        }

        Text {
            x: 32px * root.k;
            y: 8px * root.k;
            height: 44px * root.k;
            text: sets.one && root.set-in ? sets.cats[root.set-cat] : Tr.t(Tr.k, "Paramètres");
            color: Theme.text;
            font-size: 28px * root.k;
            font-weight: 700;
            vertical-alignment: center;
        }

        // Panneau de droite : lignes de réglage (libellé, aide dessous, valeur ou interrupteur à droite).
        // Marge autour des lignes : la ligne choisie grossit un peu sans être rognée.
        property <length> pad: 14px * root.k;
        // Défilement des lignes (catégorie plus haute que l'écran) : suit la ligne choisie, molette.
        property <length> set-scroll;
        property <length> set-view-h;
        property <length> set-list-h;
        property <length> set-max: max(0px, self.set-list-h - self.set-view-h);
        function set-follow(top: length, h: length) {
            if (top - sets.set-scroll < 0px) {
                sets.set-scroll = max(0px, top - sets.pad);
            } else if (top + h - sets.set-scroll > sets.set-view-h - sets.pad * 2) {
                sets.set-scroll = min(sets.set-max, top + h - sets.set-view-h + sets.pad * 2);
            }
        }
        property <int> set-cat-now: root.set-cat;
        changed set-cat-now => {
            sets.set-scroll = 0px;
        }
        set-panel := Rectangle {
            x: sets.one ? 16px * root.k - sets.pad + (1 - sets.one-p) * parent.width : sets.left-w + 32px * root.k - sets.pad;
            y: 64px * root.k - sets.pad;
            visible: !sets.one || sets.one-p > 0.01;
            width: sets.one ? parent.width - 32px * root.k + 2 * sets.pad : parent.width - self.x - 32px * root.k + sets.pad;
            height: parent.height - self.y - 24px * root.k;
            clip: true;
            init => {
                sets.set-view-h = self.height;
            }
            changed height => {
                sets.set-view-h = self.height;
                sets.set-scroll = min(sets.set-scroll, sets.set-max);
            }

            // Barre de défilement (seulement si tout ne tient pas).
            if sets.set-max > 0px: Rectangle {
                x: parent.width - 5px * root.k;
                y: sets.pad + (parent.height - sets.pad * 2) * (sets.set-scroll / sets.set-list-h);
                width: 4px * root.k;
                height: (parent.height - sets.pad * 2) * (sets.set-view-h / sets.set-list-h);
                border-radius: 2px * root.k;
                background: Theme.fg.with-alpha(0.25);
                animate y { duration: Motion.scroll ? 220ms : 0ms; easing: ease-out; }
            }

            TouchArea {
                scroll-event(e) => {
                    if (sets.set-max <= 0px || e.delta-y == 0px) {
                        return EventResult.reject;
                    }
                    sets.set-scroll = max(0px, min(sets.set-max, sets.set-scroll - e.delta-y));
                    return EventResult.accept;
                }
                set-list := VerticalLayout {
                    y: -sets.set-scroll;
                    animate y { duration: Motion.scroll && !Nav.drag ? 220ms : 0ms; easing: ease-out; }
                    width: parent.width - 8px * root.k;
                    height: self.preferred-height;
                    changed height => {
                        sets.set-list-h = self.height;
                    }
                    init => {
                        sets.set-list-h = self.height;
                    }
                    alignment: start;
                    spacing: 10px * root.k;
                    padding: sets.pad;

                    for r[i] in root.set-rows: set-row-box := Rectangle {
                        // Portrait : la pastille d'un choix passe sous le libellé (ligne plus haute).
                        property <bool> stack: sets.one && r.kind == "choice";
                        // Grandit avec son texte (description sur plusieurs lignes, texte agrandi par le système).
                        height: max(r.kind == "profile" ? 104px * root.k : r.kind == "info" ? 26px * root.k : r.hint != "" ? 72px * root.k : 56px * root.k,
                                row-col.preferred-height + (r.kind == "info" ? 4px : 22px) * root.k)
                            + (self.stack ? 44px * root.k : 0px);
                        // Ligne choisie au clavier : on fait défiler pour qu'elle reste visible.
                        property <bool> is-sel: root.set-in && i == root.set-sel;
                        changed is-sel => {
                            if (self.is-sel) {
                                sets.set-follow(self.y, self.height);
                            }
                        }
                      set-row := Rectangle {
                        x: (1 - sets.rw-e(i)) * 60px * root.k;
                        width: parent.width;
                        height: parent.height;
                        opacity: sets.rw-e(i);
                        border-radius: 12px * root.k;
                        property <bool> sel: root.set-in && root.ch-key == "" && i == root.set-sel && Nav.kb;
                        property <bool> still: r.kind == "info" || r.kind == "profile";
                        background: r.kind == "info" ? transparent
                            : r.kind == "profile" ? Theme.fg.with-alpha(0.05)
                            : r.kind == "action" && (self.sel || (row-area.has-hover && !Nav.kb && !Nav.touch)) ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%)
                            : self.sel ? Theme.fg.with-alpha(0.18) : (row-area.has-hover && !Nav.kb && !Nav.touch) ? Theme.fg.with-alpha(0.12) : Theme.fg.with-alpha(0.07);
                        property <bool> alert: r.key == "password" && Alert.weak-pw;
                        border-width: self.alert ? (2px + 1.5px * Alert.blink) * root.k : self.sel && r.kind != "action" ? 2px : 0px;
                        border-color: self.alert ? Alert.red.with-alpha(0.5 + 0.5 * Alert.blink) : Theme.accent2;
                        transform-scale: self.sel ? 1.015 : 1.0;
                        animate transform-scale { duration: Motion.select ? 200ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

                        // Mot de passe trop simple : onde rouge qui s'écarte de la ligne à chaque battement.
                        if self.alert: Rectangle {
                            x: -6px * root.k * Alert.blink;
                            y: -6px * root.k * Alert.blink;
                            width: parent.width + 12px * root.k * Alert.blink;
                            height: parent.height + 12px * root.k * Alert.blink;
                            border-radius: parent.border-radius + 6px * root.k * Alert.blink;
                            border-width: 2px * root.k;
                            border-color: Alert.red.with-alpha(0.55 * Alert.blink * (1 - Alert.blink) * 4);
                        }
                        // Compte : avatar et nom
                        if r.kind == "profile": Rectangle {
                            x: 18px * root.k;
                            y: (parent.height - self.height) / 2;
                            width: 72px * root.k;
                            height: self.width;
                            border-radius: self.width / 2;
                            background: Theme.fg.with-alpha(0.12);
                            if root.has-avatar && root.avatar-frames.length == 0: Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.avatar;
                                image-fit: fill;
                            }
                            // GIF : une image par étape, une seule visible (chaque texture n'est créée qu'une fois).
                            for f[fi] in root.avatar-frames: Image {
                                width: parent.width;
                                height: parent.height;
                                source: f;
                                image-fit: fill;
                                visible: fi == root.avatar-idx;
                            }
                            AlertRing { k: root.k; gap: 4px; }
                        }
                        row-col := VerticalLayout {
                            x: r.kind == "profile" ? 108px * root.k : 20px * root.k;
                            y: 0px;
                            height: parent.height - (set-row-box.stack ? 44px * root.k : 0px);
                            // Place à droite seulement pour une valeur, un choix ou un interrupteur (portrait :
                            // juste la place de l'interrupteur ou de la valeur, le choix est dessous).
                            width: parent.width - self.x - (set-row.still || (r.kind == "action" && r.value == "") || set-row-box.stack ? 20px * root.k
                                : sets.one && r.kind == "toggle" ? 90px * root.k : sets.one ? 130px * root.k : 280px * root.k);
                            alignment: center;
                            spacing: 3px * root.k;
                            if r.label != "": Text {
                                text: r.label;
                                color: (r.kind == "action" && (set-row.sel || (row-area.has-hover && !Nav.kb && !Nav.touch)) ? Theme.on-accent : Theme.fg);
                                font-size: r.kind == "profile" ? 24px * root.k : 16px * root.k;
                                font-weight: r.kind == "action" || r.kind == "profile" ? 700 : 600;
                                overflow: elide;
                            }
                            if r.hint != "": Text {
                                text: r.hint;
                                color: set-row.alert && !set-row.sel && !(row-area.has-hover && !Nav.kb && !Nav.touch) ? Theme.danger-text : set-row.still ? Theme.muted : (r.kind == "action" && (set-row.sel || (row-area.has-hover && !Nav.kb && !Nav.touch)) ? Theme.on-accent : Theme.fg).with-alpha(r.kind == "action" && set-row.sel ? 0.85 : 0.6);
                                font-size: 13px * root.k;
                                wrap: word-wrap;
                                // Trois lignes au plus : un texte trop long finit par « … » au lieu de déborder.
                                height: min(self.preferred-height, 54px * root.k);
                                overflow: elide;
                            }
                        }
                        // Choix : valeur actuelle dans une pastille, flèche vers la liste.
                        if r.kind == "choice": Rectangle {
                            x: set-row-box.stack ? 20px * root.k : parent.width - self.width - 18px * root.k;
                            y: set-row-box.stack ? parent.height - self.height - 12px * root.k : (parent.height - self.height) / 2;
                            // Largeur animée ; le texte est calé sur le bord droit (fixe), il ne bouge pas.
                            width: val-t.preferred-width + 48px * root.k;
                            animate width { duration: Motion.panels ? 420ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
                            height: 34px * root.k;
                            border-radius: self.height / 2;
                            background: parent.sel ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : Theme.fg.with-alpha(0.12);
                            Gloss { r: parent.border-radius; strength: 0.8; }
                            clip: true;
                            val-t := Text {
                                x: parent.width - self.width - 32px * root.k;
                                width: self.preferred-width;
                                height: parent.height;
                                text: r.value;
                                color: (set-row.sel ? Theme.on-accent : Theme.fg);
                                font-size: 15px * root.k;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Path {
                                x: parent.width - self.width - 14px * root.k;
                                y: (parent.height - self.height) / 2;
                                width: 12px * root.k;
                                height: 12px * root.k;
                                viewbox-width: 12;
                                viewbox-height: 12;
                                fill: transparent;
                                stroke: (set-row.sel ? Theme.on-accent : Theme.fg);
                                stroke-width: 2px * root.k;
                                commands: "M 2 4 L 6 8 L 10 4";
                            }
                        }
                        // Action avec une valeur (taille du cache, « Modifier »...)
                        if r.kind == "action" && r.value != "": Text {
                            x: parent.width - (sets.one ? 130px : 260px) * root.k;
                            width: (sets.one ? 110px : 240px) * root.k;
                            height: parent.height;
                            text: r.value;
                            color: ((set-row.sel || (row-area.has-hover && !Nav.kb && !Nav.touch) ? Theme.on-accent : (set-row.sel || (row-area.has-hover && !Nav.kb && !Nav.touch) ? Theme.on-accent : Theme.fg))).with-alpha(0.85);
                            font-size: 15px * root.k;
                            font-weight: 600;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if r.kind == "toggle": Rectangle {
                            x: parent.width - self.width - 20px * root.k;
                            y: (parent.height - self.height) / 2;
                            width: 56px * root.k;
                            height: 30px * root.k;
                            border-radius: self.height / 2;
                            background: r.on ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : Theme.fg.with-alpha(0.2);
                            Gloss { r: parent.border-radius; strength: 0.8; }
                            Rectangle {
                                x: r.on ? parent.width - self.width - 4px * root.k : 4px * root.k;
                                width: 22px * root.k;
                                height: 22px * root.k;
                                border-radius: self.height / 2;
                                background: Theme.on-accent;
                                animate x { duration: Motion.select ? 220ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                            }
                        }
                        row-area := TouchArea {
                            enabled: !set-row.still;
                            clicked => {
                                root.set-in = true;
                                root.set-sel = i;
                                root.settings-activate(r.key);
                            }
                        }
                      }
                    }
                }
            }
        }

        // Effet de langue (dust.rs) : sous la liste de choix, à la place des textes de la page.
        if root.dust-on && root.dust-layer == 1: DustLines {
            x: 0px;
            y: -sets.y;
            width: root.width;
            height: root.height;
            lines: root.dust-lines;
            phase: root.dust-phase;
            t0: root.dust-t0;
            k: root.k;
        }

        // Liste de choix d'un réglage : panneau de verre à droite, l'option actuelle cochée.
        property <float> ch-p: root.ch-key != "" ? 1 : 0;
        animate ch-p { duration: Motion.panels ? 280ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
        if sets.ch-p > 0.01 && !root.dust-snap: ch-pane := Rectangle {
            // Langue : voile léger, les blocs blancs de l'effet restent blancs.
            background: (root.ch-key == "language" || root.dust-on ? Theme.scrim.with-alpha(0.15) : Theme.scrim.with-alpha(0.5)).transparentize(1 - sets.ch-p);
            TouchArea {
                clicked => {
                    root.ch-key = "";
                }
                // Liste ouverte : la molette choisit dans la liste, la page dessous ne bouge pas.
                scroll-event(e) => {
                    if (e.delta-y > 0) {
                        root.ch-sel = max(0, root.ch-sel - 1);
                    } else if (e.delta-y < 0) {
                        root.ch-sel = min(root.ch-items.length - 1, root.ch-sel + 1);
                    }
                    return EventResult.accept;
                }
            }
            property <length> row-h: 46px * root.k;
            // Autant de lignes que l'écran en permet (la liste défile avec la sélection).
            property <int> rows: min(root.ch-items.length, max(3, floor((self.height - 120px * root.k) / self.row-h)));
            property <int> top: max(0, min(root.ch-sel - 4, root.ch-items.length - self.rows));
            Rectangle {
                x: max(16px * root.k, parent.width - self.width - 32px * root.k) + (1 - sets.ch-p) * (self.width + 40px * root.k);
                y: (parent.height - self.height) / 2;
                width: min(380px * root.k, parent.width - 32px * root.k);
                height: 70px * root.k + parent.rows * parent.row-h + 12px * root.k;
                border-radius: (Theme.win7 ? 8px : 18px) * root.k;
                background: Theme.win7 ? transparent : Theme.glass;
                border-width: Theme.win7 ? 0px : 1px;
                border-color: Theme.glass-border;
                Gloss { r: parent.border-radius; strength: 0.45; visible: Theme.gloss > 0 && !Theme.win7; }
                WinFrame { r: parent.border-radius; k: root.k; }
                TouchArea {
                    // La molette ne fait pas défiler la page dessous.
                    scroll-event(e) => {
                        return EventResult.accept;
                    }
                }
                // Titre (barre blanche au choix d'une langue, voir ch-title-cover). État gardé hors de
                // la liste : elle est recréée après les captures de l'effet de langue.
                ch-head := Rectangle {
                    y: 0px;
                    height: 62px * root.k;
                    property <bool> live: root.ch-title-live;
                    property <duration> now: self.live ? animation-tick() - root.ch-title-t0 : 2s;
                    // Recouvrir (0-300 ms), changer de largeur (300-450), dévoiler (450-870).
                    property <float> p1: clamp(self.now / 300ms, 0, 1);
                    property <float> m: clamp((self.now - 300ms) / 150ms, 0, 1);
                    property <float> p5: clamp((self.now - 450ms) / 420ms, 0, 1);
                    property <float> e1: self.p1 * self.p1 * (3 - 2 * self.p1);
                    property <float> e5: self.p5 * self.p5 * (3 - 2 * self.p5);
                    property <float> me: 1 - (1 - self.m) * (1 - self.m) * (1 - self.m);
                    property <length> bx: 22px * root.k;
                    property <length> bw: old-t.preferred-width + (new-t.preferred-width - old-t.preferred-width) * self.me;
                    property <length> left: self.bx + self.bw * self.e5;
                    property <length> right: self.p1 < 1 ? self.bx + self.bw * self.e1 : self.bx + self.bw;
                    property <length> pad: 4px * root.k;
                    property <length> th: 22px * root.k;
                    // Mesures seulement (invisibles).
                    old-t := Text { visible: false; text: root.ch-title-old; font-family: Theme.aero-font ? "Selawik" : "Montserrat"; font-size: 18px * root.k; font-weight: 700; }
                    new-t := Text { visible: false; text: root.ch-title; font-family: Theme.aero-font ? "Selawik" : "Montserrat"; font-size: 18px * root.k; font-weight: 700; }
                    Text {
                        x: ch-head.bx;
                        height: parent.height;
                        // L'ancien titre tant qu'il n'est pas recouvert.
                        text: ch-head.live && ch-head.p1 < 1 ? root.ch-title-old : root.ch-title;
                        font-family: Theme.aero-font ? "Selawik" : "Montserrat"; // reste lisible pendant l'effet de langue (police vide ailleurs)
                        color: Theme.fg;
                        font-size: 18px * root.k;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    if ch-head.live && ch-head.right > ch-head.left: Rectangle {
                        x: ch-head.left - ch-head.pad;
                        y: (parent.height - ch-head.th) / 2 - ch-head.pad;
                        width: ch-head.right - ch-head.left + 2 * ch-head.pad;
                        height: ch-head.th + 2 * ch-head.pad;
                        border-radius: 4px * root.k;
                        background: white;
                    }
                    if ch-head.live && ((ch-head.p1 > 0 && ch-head.p1 < 1) || (ch-head.p5 > 0 && ch-head.p5 < 1)): Rectangle {
                        x: (ch-head.p1 < 1 ? ch-head.right : ch-head.left) - 2px * root.k;
                        y: (parent.height - ch-head.th) / 2 - 7px * root.k;
                        width: 4px * root.k;
                        height: ch-head.th + 14px * root.k;
                        border-radius: 2px * root.k;
                        background: Theme.accent2;
                        drop-shadow-blur: Nav.no-shadow ? 0px : (10px * root.k);
                        drop-shadow-color: Theme.accent2;
                    }
                }
                Rectangle {
                    y: 62px * root.k;
                    height: parent.height - self.y - 12px * root.k;
                    clip: true;
                    for t[i] in root.ch-items: Rectangle {
                        x: 10px * root.k;
                        y: (i - ch-pane.top) * ch-pane.row-h;
                        animate y { duration: Motion.scroll ? 160ms : 0ms; easing: ease-out; }
                        width: parent.width - 20px * root.k;
                        height: ch-pane.row-h - 4px * root.k;
                        border-radius: 10px * root.k;
                        background: (Nav.kb ? (i == root.ch-sel) : ch-area.has-hover && !Nav.touch) ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : transparent;
                        Gloss { r: parent.border-radius; strength: 0.8; visible: Theme.gloss > 0 && ((Nav.kb ? (i == root.ch-sel) : ch-area.has-hover && !Nav.touch)); }
                        Text {
                            x: 16px * root.k;
                            width: parent.width - 60px * root.k;
                            height: parent.height;
                            text: t.label;
                            font-family: Theme.aero-font ? "Selawik" : "Montserrat";
                            color: ((Nav.kb ? (i == root.ch-sel) : ch-area.has-hover && !Nav.touch) ? Theme.on-accent : Theme.fg);
                            font-size: 16px * root.k;
                            font-weight: t.current ? 700 : 500;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if t.current: Path {
                            x: parent.width - self.width - 16px * root.k;
                            y: (parent.height - self.height) / 2;
                            width: 16px * root.k;
                            height: 16px * root.k;
                            viewbox-width: 16;
                            viewbox-height: 16;
                            fill: transparent;
                            stroke: i == root.ch-sel ? Theme.on-accent : Theme.accent2;
                            stroke-width: 2.4px * root.k;
                            commands: "M 2.5 8.5 L 6.5 12.5 L 13.5 3.5";
                        }
                        ch-area := TouchArea {
                            clicked => {
                                root.settings-choose(root.ch-key, t.id);
                                if (root.ch-key != "language") {
                                    root.ch-key = "";
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------- Choix de la photo de profil
        // Page au premier plan : catégories (une par « entreprise » des noms d'avatars), grille qui
        // défile pour garder l'avatar choisi à l'écran. Entrée applique l'avatar (arc qui tourne,
        // puis coche verte) ; Échap revient au compte.
        property <float> av-p: root.av-open ? 1 : 0;
        animate av-p { duration: Motion.panels ? 260ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
        if sets.av-p > 0.01: Rectangle {
            background: @linear-gradient(180deg, Theme.bg 0%, Theme.bg-mid 55%, Theme.bg-end 100%);
            opacity: sets.av-p;
            transform-scale: 0.94 + 0.06 * sets.av-p;
            TouchArea {
                // La molette ne fait pas défiler la page dessous.
                scroll-event(e) => {
                    return EventResult.accept;
                }
            }

            Text {
                x: 32px * root.k;
                y: 8px * root.k;
                height: 44px * root.k;
                text: Tr.t(Tr.k, "Photo de profil");
                color: Theme.text;
                font-size: 28px * root.k;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                x: 32px * root.k;
                y: 48px * root.k;
                height: 22px * root.k;
                text: root.av-total == 0 ? Tr.t(Tr.k, "Chargement des avatars…")
                    : root.av-groups.length > 1 ? Tr.f(Tr.k, "{} avatars en {} catégories · Entrée pour choisir, Échap pour revenir", root.av-total, root.av-groups.length)
                    : Tr.f(Tr.k, "{} avatars · Entrée pour choisir, Échap pour revenir", root.av-total, "");
                color: Theme.muted;
                font-size: 14px * root.k;
                vertical-alignment: center;
            }
            // Avatar actuel, en haut à droite
            Text {
                x: parent.width - 32px * root.k - 56px * root.k - 12px * root.k - self.width;
                y: 10px * root.k;
                height: 56px * root.k;
                text: Tr.t(Tr.k, "Actuelle");
                color: Theme.muted;
                font-size: 14px * root.k;
                vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 32px * root.k - self.width;
                y: 10px * root.k;
                width: 56px * root.k;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.fg.with-alpha(0.12);
                border-width: 2px * root.k;
                border-color: Theme.accent2;
                if root.has-avatar && root.avatar-frames.length == 0: Image {
                    x: 3px * root.k;
                    y: 3px * root.k;
                    width: parent.width - 6px * root.k;
                    height: parent.height - 6px * root.k;
                    source: root.avatar;
                    image-fit: fill;
                }
                // GIF : une image par étape, une seule visible (chaque texture n'est créée qu'une fois).
                for f[fi] in root.avatar-frames: Image {
                    x: 3px * root.k;
                    y: 3px * root.k;
                    width: parent.width - 6px * root.k;
                    height: parent.height - 6px * root.k;
                    source: f;
                    image-fit: fill;
                    visible: fi == root.avatar-idx;
                }
            }

            // Catégories
            if sets.av-multi: Rectangle {
                x: 32px * root.k;
                y: 80px * root.k;
                width: 250px * root.k;
                height: sets.av-gh;
                clip: true;
                TouchArea {
                    scroll-event(e) => {
                        if (e.delta-y < 0) {
                            root.g-top = max(0, min(root.av-groups.length - sets.g-vis, root.g-top + 1));
                        } else if (e.delta-y > 0) {
                            root.g-top = max(0, root.g-top - 1);
                        }
                        return EventResult.accept;
                    }
                }
                Rectangle {
                    y: (root.av-group - root.g-top) * (sets.g-h + 6px * root.k);
                    animate y { duration: Motion.scroll ? 300ms : 0ms; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
                    height: sets.g-h;
                    border-radius: 10px * root.k;
                    background: Theme.fg.with-alpha(0.12);
                    Rectangle {
                        border-radius: parent.border-radius;
                        background: @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%);
                        Gloss { r: parent.border-radius; strength: 0.8; }
                        opacity: !root.h-focus && root.av-zone == 0 && Nav.kb ? 1 : 0;
                        animate opacity { duration: Motion.panels ? 200ms : 0ms; }
                    }
                }
                for g[i] in root.av-groups: Rectangle {
                    y: (i - root.g-top) * (sets.g-h + 6px * root.k);
                    animate y { duration: Motion.scroll ? 200ms : 0ms; easing: ease-out; }
                    height: sets.g-h;
                    border-radius: 10px * root.k;
                    background: avg-area.has-hover && !Nav.touch && i != root.av-group ? ((i == root.av-group && !root.h-focus && root.av-zone == 0 && Nav.kb ? Theme.on-accent : (i == root.av-group && !root.h-focus && root.av-zone == 0 && Nav.kb ? Theme.on-accent : Theme.fg))).with-alpha(0.08) : transparent;
                    Text {
                        x: 16px * root.k;
                        width: parent.width - 70px * root.k;
                        height: parent.height;
                        text: g.title;
                        color: (i == root.av-group && !root.h-focus && root.av-zone == 0 && Nav.kb ? Theme.on-accent : Theme.fg);
                        font-size: 16px * root.k;
                        font-weight: i == root.av-group ? 700 : 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        x: parent.width - 60px * root.k;
                        width: 46px * root.k;
                        height: parent.height;
                        text: g.count;
                        color: ((i == root.av-group && !root.h-focus && root.av-zone == 0 && Nav.kb ? Theme.on-accent : (i == root.av-group && !root.h-focus && root.av-zone == 0 && Nav.kb ? Theme.on-accent : Theme.fg))).with-alpha(0.7);
                        font-size: 13px * root.k;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    avg-area := TouchArea {
                        clicked => {
                            root.av-group = i;
                            root.av-zone = 0;
                            root.avatar-group(i);
                        }
                    }
                }
            }

            // Grille des avatars de la catégorie
            Rectangle {
                x: sets.av-gx;
                y: 80px * root.k;
                width: sets.av-gw;
                height: sets.av-gh;
                clip: true;
                TouchArea {
                    scroll-event(e) => {
                        if (e.delta-y < 0) {
                            sets.av-scroll(1);
                        } else if (e.delta-y > 0) {
                            sets.av-scroll(-1);
                        }
                        return EventResult.accept;
                    }
                }
                Rectangle {
                    x: 14px * root.k;
                    y: 14px * root.k - root.av-top * sets.av-ch;
                    animate y { duration: Motion.scroll ? 260ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
                    for a[i] in root.avatar-items: cell := Rectangle {
                        property <int> line: floor(i / sets.av-cols);
                        // Seules les rangées proches de l'écran sont dessinées.
                        visible: self.line >= root.av-top - 1 && self.line <= root.av-top + sets.av-rows;
                        property <float> e: sets.ai-e(self.line - root.av-top);
                        x: mod(i, sets.av-cols) * sets.av-cw;
                        y: self.line * sets.av-ch + (1 - self.e) * 40px * root.k;
                        opacity: self.e;
                        width: sets.av-cw;
                        height: sets.av-ch;
                        property <bool> sel: !root.h-focus && root.av-zone == 1 && i == root.av-sel && Nav.kb;
                        property <bool> lit: self.sel || (av-area.has-hover && !Nav.kb && !Nav.touch);
                        property <bool> busy: a.id == root.av-busy;
                        property <bool> done: a.id == root.av-current;
                        // Appui : la case s'écrase puis rebondit.
                        property <int> press: root.av-press;
                        property <bool> squash;
                        changed press => {
                            if (self.sel) {
                                self.squash = true;
                                squash-t.running = true;
                            }
                        }
                        squash-t := Timer {
                            interval: 110ms;
                            running: false;
                            triggered => {
                                self.running = false;
                                cell.squash = false;
                            }
                        }
                        ring := Rectangle {
                            x: (sets.av-cw - sets.av) / 2;
                            y: 6px * root.k;
                            width: sets.av;
                            height: sets.av;
                            border-radius: self.width / 2;
                            background: cell.lit ? Theme.fg.with-alpha(0.15) : Theme.fg.with-alpha(0.07);
                            border-width: cell.lit ? 4px * root.k : cell.done ? 3px * root.k : 0px;
                            border-color: cell.done ? Theme.ok : Theme.accent2;
                            transform-scale: cell.squash ? 0.92 : cell.lit ? 1.14 : 1.0;
                            animate transform-scale { duration: Motion.select ? 240ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                            animate background { duration: Motion.select ? 160ms : 0ms; }
                            // Image en fondu à son arrivée.
                            Image {
                                x: 6px * root.k;
                                y: 6px * root.k;
                                width: parent.width - 12px * root.k;
                                height: parent.height - 12px * root.k;
                                source: a.image;
                                image-fit: fill;
                                opacity: !a.has-image ? 0 : cell.busy ? 0.45 : 1.0;
                                animate opacity { duration: Motion.panels ? 220ms : 0ms; }
                            }
                            // Avatar en cours d'envoi : arc qui tourne.
                            if cell.busy: Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-width: 100;
                                viewbox-height: 100;
                                fill: transparent;
                                stroke: Theme.fg;
                                stroke-width: 4px * root.k;
                                commands: "M 50 6 A 44 44 0 0 1 94 50";
                                transform-rotation: mod(animation-tick() / 1ms, 900) / 900 * 360deg;
                            }
                            // Avatar appliqué : coche verte qui apparaît en rebond.
                            Rectangle {
                                x: parent.width - self.width + 2px * root.k;
                                y: parent.height - self.height + 2px * root.k;
                                width: 30px * root.k;
                                height: self.width;
                                border-radius: self.width / 2;
                                background: #16a34a;
                                border-width: 2px * root.k;
                                border-color: Theme.bg;
                                transform-scale: cell.done ? 1.0 : 0.0;
                                animate transform-scale { duration: Motion.select ? 320ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                                Path {
                                    width: 16px * root.k;
                                    height: 16px * root.k;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    viewbox-width: 16;
                                    viewbox-height: 16;
                                    fill: transparent;
                                    stroke: white;
                                    stroke-width: 2.4px * root.k;
                                    commands: "M 2.5 8.5 L 6.5 12.5 L 13.5 3.5";
                                }
                            }
                        }
                        Marquee {
                            x: 4px * root.k;
                            y: sets.av + 16px * root.k;
                            width: parent.width - 8px * root.k;
                            text: a.title;
                            text-color: cell.lit ? Theme.fg : Theme.muted;
                            font-size: 13px * root.k;
                            horizontal-alignment: center;
                            active: cell.sel;
                            height: self.preferred-height;
                        }
                        av-area := TouchArea {
                            x: ring.x;
                            y: ring.y;
                            width: ring.width;
                            height: ring.height;
                            clicked => {
                                root.av-zone = 1;
                                root.av-sel = i;
                                if (root.av-busy == "") {
                                    root.av-press += 1;
                                    root.avatar-pick(a.id);
                                }
                            }
                        }
                    }
                }
                // Barre de défilement (s'il y a plus de rangées que l'écran n'en montre).
                if sets.av-lines > sets.av-rows: Rectangle {
                    x: parent.width - 6px * root.k;
                    width: 4px * root.k;
                    height: parent.height;
                    border-radius: 2px * root.k;
                    background: Theme.fg.with-alpha(0.08);
                    Rectangle {
                        y: parent.height * root.av-top / sets.av-lines;
                        animate y { duration: Motion.scroll ? 260ms : 0ms; easing: ease-out; }
                        height: parent.height * sets.av-rows / sets.av-lines;
                        border-radius: 2px * root.k;
                        background: Theme.fg.with-alpha(0.4);
                    }
                }
            }
        }

        // ---------------------------------------------------- Saisie d'une adresse (Réseau)
        // Mode TV : ↑ ↓ pour choisir, Entrée pour écrire au clavier à l'écran.
        property <float> ad-p: root.addr-edit > 0 ? 1 : 0;
        animate ad-p { duration: Motion.panels ? 220ms : 0ms; easing: ease-out; }
        property <float> adk-p: root.addr-edit > 0 && root.tv-mode && root.addr-osk ? 1 : 0;
        animate adk-p { duration: Motion.search ? 260ms : 0ms; easing: ease-in-out; }
        if sets.ad-p > 0.01: Rectangle {
            y: -root.header-h;
            height: parent.height + root.header-h;
            background: Theme.scrim.with-alpha(0.7).transparentize(1 - sets.ad-p);
            TouchArea {
                // La molette ne fait pas défiler la page dessous.
                scroll-event(e) => {
                    return EventResult.accept;
                }
            }

            property <length> dw: min(self.width - 64px * root.k, 620px * root.k);
            // Changer le mot de passe : jauge de solidité (étape 2) ou accord des deux saisies (étape 3).
            property <length> dh: root.ad-mode >= 4 && root.ad-mode <= 6 ? pw-col.preferred-height : 290px * root.k;
            animate dh { duration: Motion.panels ? 260ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
            adlg := FocusScope {
                x: (parent.width - parent.dw) / 2;
                y: (1 - sets.adk-p) * (parent.height - parent.dh) / 2 + sets.adk-p * 20px * root.k
                    // Arrivée : monte depuis le bas ; départ : continue de monter en s'effaçant (pas l'inverse
                    // de l'arrivée).
                    + (1 - sets.ad-p) * (root.addr-edit > 0 ? 30px : -46px) * root.k - Kb.lift;
                width: parent.dw;
                height: parent.dh;
                focus-on-click: root.tv-mode;
                property <bool> pw: root.ad-mode >= 4 && root.ad-mode <= 6;
                // Passage d'une étape à l'autre : le contenu arrive de la droite.
                property <int> step: root.ad-mode;
                property <bool> step-live;
                property <duration> step-t0;
                property <float> step-e: !self.step-live ? 1 : 1 - pow(1 - clamp((animation-tick() - self.step-t0) / 340ms, 0, 1), 3);
                changed step => {
                    if (self.step >= 5 && Motion.panels) {
                        self.step-t0 = animation-tick();
                        self.step-live = true;
                    }
                }
                Timer {
                    interval: 360ms;
                    running: parent.step-live;
                    triggered => {
                        parent.step-live = false;
                    }
                }
                property <int> score: root.ad-mode == 5 && root.addr-text != "" ? root.pw-score(root.addr-text) : -1;
                init => {
                    self.focus();
                }
                key-pressed(event) => {
                    // Touche maintenue : Entrée ne répète pas l'action (ouvrir, lancer la lecture...).
                    if (event.repeat && event.text == Key.Return) {
                        return EventResult.accept;
                    }
                    // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                    if (root.loading && event.text == Key.Escape) {
                        root.cancel-open();
                        return EventResult.accept;
                    }
                    if (root.tv-mode && root.addr-osk) {
                        if (ad-osk.key(event.text)) {
                            return EventResult.accept;
                        }
                        if (event.text == Key.Escape) {
                            root.addr-osk = false;
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.Escape) {
                        root.addr-close();
                        return EventResult.accept;
                    }
                    // Vrai clavier : une touche tapée va au champ, même si la sélection est sur un bouton.
                    if (root.typing-key(event) || root.erase-key(event, root.addr-field > 0 ? "" : root.addr-text)) {
                        root.addr-field = 0;
                        addr-f.type(event.text);
                        return EventResult.accept;
                    }
                    // Touche maintenue : une fois le texte effacé, Retour arrière (ou Échap) ne sert pas de Retour.
                    if (event.repeat && (event.text == Key.Backspace || event.text == Key.Escape)) {
                        return EventResult.accept;
                    }
                    if (!root.tv-mode) {
                        return EventResult.reject;
                    }
                    // Champ (0), puis Enregistrer (1) et Annuler (2, à gauche).
                    if (event.text == Key.UpArrow) {
                        root.addr-field = 0;
                    } else if (event.text == Key.DownArrow) {
                        root.addr-field = root.addr-field == 0 ? 1 : root.addr-field;
                    } else if (event.text == Key.LeftArrow && root.addr-field == 1) {
                        root.addr-field = 2;
                    } else if (event.text == Key.RightArrow && root.addr-field == 2) {
                        root.addr-field = 1;
                    } else if (event.text == Key.Return) {
                        if (root.addr-field == 0) {
                            root.addr-osk = true;
                        } else if (root.addr-field == 1) {
                            root.addr-save(root.ad-mode, root.addr-text);
                        } else {
                            root.addr-close();
                        }
                    } else if (event.text == Key.Backspace) {
                        root.addr-close();
                    }
                    return EventResult.accept;
                }

                Rectangle {
                    border-radius: (Theme.win7 ? 8px : 20px) * root.k;
                    background: Theme.win7 ? transparent : Theme.glass;
                    border-width: Theme.win7 ? 0px : 1px;
                    border-color: Theme.glass-border;
                    Gloss { r: parent.border-radius; strength: 0.45; visible: Theme.gloss > 0 && !Theme.win7; }
                    WinFrame { r: parent.border-radius; k: root.k; }
                }
                // Étapes du changement de mot de passe : trois points, l'étape en cours s'allonge.
                if adlg.pw: HorizontalLayout {
                    x: parent.width - self.preferred-width - 26px * root.k;
                    y: 34px * root.k;
                    height: 8px * root.k;
                    spacing: 6px * root.k;
                    for d[di] in 3: Rectangle {
                        width: (di == root.ad-mode - 4 ? 24px : 8px) * root.k;
                        animate width { duration: Motion.panels ? 300ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                        border-radius: 4px * root.k;
                        background: di <= root.ad-mode - 4 ? @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%) : Theme.fg.with-alpha(0.2);
                    }
                }
                Rectangle {
                  x: (1 - adlg.step-e) * 40px * root.k;
                  opacity: 0.2 + 0.8 * adlg.step-e;
                  pw-col := VerticalLayout {
                    padding: 26px * root.k;
                    spacing: 6px * root.k;
                    alignment: start;

                    Text {
                        text: root.ad-mode == 1 ? Tr.t(Tr.k, "Adresse principale") : root.ad-mode == 3 ? Tr.t(Tr.k, "Mot de passe administrateur")
                            : root.ad-mode == 7 ? Tr.t(Tr.k, "Renommer l'écran")
                            : root.ad-mode >= 4 ? Tr.t(Tr.k, "Changer le mot de passe")
                            : Tr.t(Tr.k, "Adresse de secours");
                        color: Theme.fg;
                        font-size: 22px * root.k;
                        font-weight: 700;
                    }
                    Text {
                        text: root.ad-mode == 1 ? Tr.t(Tr.k, "Utilisée en priorité. Sans « http:// » ni « https:// », les deux sont essayés.")
                            : root.ad-mode == 3 ? Tr.t(Tr.k, "La mise à jour s'installe en administrateur (sudo). Le mot de passe n'est pas enregistré.")
                            : root.ad-mode == 4 ? Tr.t(Tr.k, "Étape 1 sur 3 · Ton mot de passe actuel, pour confirmer que c'est bien toi.")
                            : root.ad-mode == 5 ? Tr.t(Tr.k, "Étape 2 sur 3 · 8 caractères au moins. Une petite phrase (« pluie-sur-la-mer ») se retient bien et reste solide.")
                            : root.ad-mode == 6 ? Tr.t(Tr.k, "Étape 3 sur 3 · Retape le nouveau mot de passe.")
                            : root.ad-mode == 7 ? Tr.f(Tr.k, "Nom affiché dans « Diffuser ». Vide : son nom d'origine ({}).", root.addr-hint, "")
                            : Tr.t(Tr.k, "Essayée quand la principale ne répond pas (autre réseau…). Laisse vide pour n'en avoir aucune.");
                        color: Theme.muted;
                        font-size: 13px * root.k;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 4px * root.k;
                    }
                    addr-f := Field {
                        k: root.k;
                        label: root.ad-mode == 3 ? Tr.t(Tr.k, "Mot de passe") : root.ad-mode == 4 ? Tr.t(Tr.k, "Mot de passe actuel")
                            : root.ad-mode == 5 ? Tr.t(Tr.k, "Nouveau mot de passe") : root.ad-mode == 6 ? Tr.t(Tr.k, "Nouveau mot de passe, encore une fois")
                            : root.ad-mode == 7 ? Tr.t(Tr.k, "Nom de l'écran") : Tr.t(Tr.k, "Adresse du serveur");
                        hint: root.ad-mode == 1 ? "192.168.1.32:8096" : root.ad-mode == 7 ? root.addr-hint : root.ad-mode >= 3 ? "" : "10.8.0.5:8096";
                        password: root.ad-mode >= 3 && root.ad-mode <= 6;
                        text <=> root.addr-text;
                        shown: root.ad-mode >= 3 && root.ad-mode <= 6 ? root.mask(root.addr-text) : root.addr-text;
                        tv: root.tv-mode;
                        selected: root.tv-mode && !root.addr-osk && root.addr-field == 0;
                        editing: root.addr-osk;
                        error: root.addr-err;
                        init => {
                            if (!root.tv-mode) {
                                self.focus-input();
                            }
                        }
                        accepted => {
                            root.addr-save(root.ad-mode, root.addr-text);
                        }
                        clicked => {
                            root.addr-field = 0;
                            root.addr-osk = true;
                        }
                    }
                    // Étape 2 : jauge de solidité (quatre segments qui se remplissent et changent de couleur).
                    if root.ad-mode == 5: HorizontalLayout {
                        height: 34px * root.k;
                        spacing: 6px * root.k;
                        property <int> fill: adlg.score < 0 ? 0 : max(1, adlg.score);
                        property <color> gauge: adlg.score <= 0 ? Alert.red : adlg.score == 1 ? #ff8a3b : adlg.score == 2 ? Theme.warn : adlg.score == 3 ? #a3e635 : Theme.ok;
                        for g[gi] in 4: Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: (gi < parent.fill ? 8px : 6px) * root.k;
                            animate height { duration: Motion.select ? 220ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                            border-radius: 4px * root.k;
                            background: gi < parent.fill ? parent.gauge : Theme.fg.with-alpha(0.14);
                            animate background { duration: Motion.select ? 260ms : 0ms; }
                        }
                        Text {
                            width: 120px * root.k;
                            text: adlg.score < 0 ? "" : adlg.score == 0 ? Tr.t(Tr.k, "Trop simple") : adlg.score == 1 ? Tr.t(Tr.k, "Faible")
                                : adlg.score == 2 ? Tr.t(Tr.k, "Correct") : adlg.score == 3 ? Tr.t(Tr.k, "Bon") : Tr.t(Tr.k, "Solide");
                            color: parent.gauge;
                            font-size: 14px * root.k;
                            font-weight: 700;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    // Étape 3 : les deux saisies concordent-elles ?
                    if root.ad-mode == 6: HorizontalLayout {
                        height: 26px * root.k;
                        spacing: 8px * root.k;
                        alignment: start;
                        property <bool> same: root.addr-text != "" && root.pw-same(root.addr-text);
                        Rectangle {
                            width: 18px * root.k;
                            height: self.width;
                            y: (parent.height - self.height) / 2;
                            border-radius: self.width / 2;
                            background: parent.same ? Theme.ok : Theme.fg.with-alpha(0.14);
                            animate background { duration: Motion.select ? 220ms : 0ms; }
                            transform-scale: parent.same ? 1 : 0.8;
                            animate transform-scale { duration: Motion.select ? 300ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                            if parent.same: Path {
                                width: 12px * root.k;
                                height: 12px * root.k;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                viewbox-width: 16;
                                viewbox-height: 16;
                                fill: transparent;
                                stroke: white;
                                stroke-width: 2.4px * root.k;
                                commands: "M 2.5 8.5 L 6.5 12.5 L 13.5 3.5";
                            }
                        }
                        Text {
                            text: parent.same ? Tr.t(Tr.k, "Identiques") : Tr.t(Tr.k, "Pas encore identiques");
                            color: parent.same ? Theme.ok : Theme.muted;
                            font-size: 14px * root.k;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 14px * root.k;
                        height: 44px * root.k;

                        ActionButton {
                            text: Tr.t(Tr.k, "Annuler");
                            font: 15px * root.k;
                            focused: root.tv-mode && !root.addr-osk && root.addr-field == 2;
                            clicked => {
                                root.addr-close();
                            }
                        }
                        ActionButton {
                            text: root.addr-busy ? (root.ad-mode == 6 ? Tr.t(Tr.k, "Changement…") : Tr.t(Tr.k, "Vérification…"))
                                : root.ad-mode == 3 ? Tr.t(Tr.k, "Installer") : root.ad-mode == 4 || root.ad-mode == 5 ? Tr.t(Tr.k, "Suivant")
                                : root.ad-mode == 6 ? Tr.t(Tr.k, "Changer") : Tr.t(Tr.k, "Enregistrer");
                            font: 15px * root.k;
                            focused: root.tv-mode ? !root.addr-osk && root.addr-field == 1 : true;
                            clicked => {
                                root.addr-save(root.ad-mode, root.addr-text);
                            }
                        }
                    }
                  }
                }
            }

            ad-osk := Osk {
                x: (parent.width - self.width) / 2;
                y: adlg.y + parent.dh + 16px * root.k + (1 - sets.adk-p) * 60px * root.k;
                width: min(parent.width - 80px * root.k, 760px * root.k);
                visible: root.tv-mode && sets.adk-p > 0.01;
                k: root.k;
                active: root.addr-osk;
                text: root.addr-text;
                ok-label: root.ad-mode == 3 ? Tr.t(Tr.k, "Installer") : root.ad-mode == 4 || root.ad-mode == 5 ? Tr.t(Tr.k, "Suivant")
                    : root.ad-mode == 6 ? Tr.t(Tr.k, "Changer") : Tr.t(Tr.k, "Enregistrer");
                erase(t) => {
                    return root.text-backspace("\u{8}" + t);
                }
                edited(t) => {
                    root.addr-text = t;
                }
                done => {
                    root.addr-osk = false;
                    root.addr-save(root.ad-mode, root.addr-text);
                }
                leave-up => {
                    root.addr-osk = false;
                }
                leave-down => {
                    root.addr-osk = false;
                    root.addr-field = 1;
                }
            }

            if root.addr-busy && sets.adk-p < 0.5: Bubble {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 28px * root.k;
                k: root.k;
                max-w: parent.width - 80px * root.k;
                text: root.ad-mode == 6 ? Tr.t(Tr.k, "Changement du mot de passe…") : Tr.t(Tr.k, "Vérification de l'adresse…");
            }
        }

        // Nouveautés d'une mise à jour : fenêtre à part, qui défile (le texte peut être long).
        notes-p := OverviewPanel {
            open: root.notes-open;
            k: root.k;
            text: root.notes-text;
            font: 17px * root.k;
            close => {
                root.notes-open = false;
            }
        }
    }

    // Barre de navigation des écrans autres que l'accueil (l'accueil l'intègre à son en-tête).
    property <bool> bar-screen: root.screen == "detail" || root.screen == "library" || root.screen == "soon" || root.screen == "profile"
        || root.screen == "search" || root.screen == "party" || root.screen == "servers" || root.screen == "settings" || root.screen == "downloads";
    // Sans session (premier lancement, « Changer de serveur » depuis la connexion) : pas de barre,
    // ses boutons (accueil, watch party, hasard, recherche, compte) n'auraient rien à ouvrir.
    // Barre du haut des pages (fiche, bibliothèque…) sur un écran étroit : icônes de gauche (retour,
    // accueil, menu) et de droite (5 icônes) côte à côte, réduites si elles ne tiennent pas (téléphone en
    // mode tablette). Largeur à k = 1 : 24 + 3 × 54 à gauche, ~270 à droite.
    property <float> bar-k: root.narrow ? min(root.k, root.width / (24px + (root.back-ok ? 3 : 2) * 54px + 280px)) : root.k;
    // Barre du haut : la même pour toutes les pages (accueil compris), jamais recréée en changeant de
    // page (ses boutons ne disparaissent plus à chaque chargement) ; seuls ses boutons et son titre changent.
    property <bool> on-home: root.screen == "home";
    if (root.bar-screen || root.on-home) && !root.playing && (root.signed-in || root.offline): NavBar {
        y: root.chrome-top;
        // Le titre s'arrête avant les icônes de droite (fenêtre étroite, portrait) ; à l'accueil, avant
        // les onglets.
        x: 0px;
        width: root.tabs-on && !root.two-line ? root.tabs-x - 8px * root.k : parent.width - root.right-w;
        // Même hauteur que la barre (icônes réduites centrées comme celles de droite).
        height: 72px * root.k;
        k: root.on-home ? root.k : root.bar-k;
        can-back: !root.on-home && root.back-ok;
        show-home: !root.on-home;
        enter: root.page-e;
        title-color: root.offline ? Theme.ok : root.on-home ? (Theme.dark ? Theme.accent2 : Theme.accent1) : Theme.text;
        title: root.on-home ? "Turtlefin" : root.screen == "library" ? root.lib-title : root.screen == "downloads" ? root.dl-title : root.screen == "search" ? Tr.t(Tr.k, "Recherche")
            : root.screen == "party" ? Tr.t(Tr.k, "Watch party") : "";
        sel: root.h-focus && root.h-sel < root.nav-n ? root.h-sel : -1;
        activate(i) => {
            root.nav-activate(i);
        }
    }
    // Onglets (Accueil, Favoris, Demandes) : sur toutes les pages, au centre de la barre, jamais sur le
    // titre ni sur les icônes de droite ; seconde ligne quand la place manque (portrait). Hors de
    // l'accueil, aucun n'est en avant, et en choisir un y ramène, sur cet onglet.
    if root.tabs-on: HorizontalLayout {
        width: self.preferred-width;
        y: root.two-line ? root.header-row - 10px * root.k : root.chrome-top;
        height: root.two-line ? 54px * root.k : 72px * root.k;
        x: root.two-line ? (parent.width - self.width) / 2 : max(root.tabs-lo, min((parent.width - self.width) / 2, root.tabs-hi - self.width));
        spacing: parent.width < 1100px * root.k ? 18px * root.k : 36px * root.k;
        // Position réelle des onglets : titre de la barre, visite guidée.
        init => {
            root.tabs-x = self.x;
            root.tabs-w = self.width;
        }
        changed x => {
            root.tabs-x = self.x;
        }
        changed width => {
            root.tabs-w = self.width;
        }

        Tab {
            text: Tr.t(Tr.k, "Accueil");
            k: root.on-home ? root.k : root.bar-k;
            active: root.on-home && root.tab == "home";
            focused: root.h-focus && root.h-sel == root.nav-n + 0;
            clicked => {
                root.h-sel = root.nav-n + 0;
                root.header-activate(0);
            }
        }
        Tab {
            text: Tr.t(Tr.k, "Favoris");
            k: root.on-home ? root.k : root.bar-k;
            active: root.on-home && root.tab == "favorites";
            focused: root.h-focus && root.h-sel == root.nav-n + 1;
            clicked => {
                root.h-sel = root.nav-n + 1;
                root.header-activate(1);
            }
        }
        if root.has-requests: Tab {
            text: Tr.t(Tr.k, "Demandes");
            k: root.on-home ? root.k : root.bar-k;
            active: root.on-home && root.tab == "requests";
            focused: root.h-focus && root.h-sel == root.nav-n + 2;
            clicked => {
                root.h-sel = root.nav-n + 2;
                root.header-activate(2);
            }
        }
    }
    if (root.bar-screen || root.on-home) && !root.playing && (root.signed-in || root.offline): HeaderRight {
        // Téléphone tenu droit : la moitié de l'écran ne suffit pas aux cinq icônes (alignées à droite).
        // Toujours la largeur entière (icônes alignées à droite) : la barre ne bouge pas d'une page à l'autre.
        x: 0px;
        y: root.chrome-top;
        width: parent.width;
        height: 72px * root.k;
        k: root.on-home ? root.k : root.bar-k;
        me-pop: root.me-pop;
        collapsed: root.hdr-collapsed;
        narrow: root.narrow;
        sel: root.h-focus && root.h-sel >= root.right-base ? root.h-sel - root.right-base : -1;
        party-on: root.sp-active;
        cast-on: root.cast-on;
        party-count: root.sp-count;
        has-avatar: root.has-avatar;
        avatar: root.avatar;
        avatar-frames: root.avatar-frames;
        avatar-idx: root.avatar-idx;
        clock: root.clock;
        offline: root.offline;
        dl-text: root.dl-pill;
        dl-p: root.dl-p;
        dl-paused: root.dl-paused;
        init => {
            root.right-w = self.used-w;
        }
        changed used-w => {
            root.right-w = self.used-w;
        }
        activate(i) => {
            root.right-activate(i);
        }
    }

    // Télécommande (menu) : d'abord le Turtlefin à piloter, puis ses boutons (flèches, OK, retour,
    // accueil, lecture, volume), comme la télécommande de la télé.
    if root.remote-p > 0.01: Rectangle {
        background: Theme.scrim.with-alpha(0.55 * root.remote-p);
        TouchArea {
            clicked => {
                if (root.remote-target == "") {
                    root.close-remote();
                }
            }
            scroll-event(e) => {
                return EventResult.accept;
            }
        }
        if root.remote-target == "": Rectangle {
            width: min(parent.width - 32px * root.k, 460px * root.k);
            height: pick-col.preferred-height + 40px * root.k;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (1 - root.remote-p) * 40px * root.k;
            opacity: root.remote-p;
            border-radius: (Theme.win7 ? 8px : 18px) * root.k;
            background: Theme.win7 ? transparent : Theme.panel;
            border-width: Theme.win7 ? 0px : 1px;
            border-color: Theme.glass-border;
            drop-shadow-blur: Nav.no-shadow ? 0px : (30px * root.k);
            drop-shadow-color: #000000a0;
            Gloss { r: parent.border-radius; strength: 0.45; visible: Theme.gloss > 0 && !Theme.win7; }
            WinFrame { r: parent.border-radius; k: root.k; }
            TouchArea {
                scroll-event(e) => {
                    return EventResult.accept;
                }
            }
            FocusScope {
                init => {
                    self.focus();
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape || event.text == Key.Backspace) {
                        root.close-remote();
                    } else if (event.text == Key.UpArrow) {
                        root.remote-pick-sel = max(0, root.remote-pick-sel - 1);
                    } else if (event.text == Key.DownArrow) {
                        root.remote-pick-sel = min(root.remote-items.length, root.remote-pick-sel + 1);
                    } else if (event.text == Key.Return) {
                        if (root.remote-pick-sel < root.remote-items.length) {
                            root.remote-pick(root.remote-items[root.remote-pick-sel].id);
                        } else {
                            root.close-remote();
                        }
                    }
                    return EventResult.accept;
                }
            }
            pick-col := VerticalLayout {
                x: 20px * root.k;
                y: 20px * root.k;
                width: parent.width - 40px * root.k;
                alignment: start;
                spacing: 10px * root.k;
                Text {
                    text: Tr.t(Tr.k, "Télécommande");
                    color: Theme.fg;
                    font-size: 20px * root.k;
                    font-weight: 700;
                }
                Text {
                    text: root.remote-busy && root.remote-items.length == 0 ? Tr.t(Tr.k, "Recherche des appareils…")
                        : root.remote-items.length == 0 ? Tr.t(Tr.k, "Aucun autre Turtlefin ouvert avec ce compte. Ouvre-le sur la télé (ou le Pi), puis reviens ici.")
                        : Tr.t(Tr.k, "Choisis le Turtlefin à piloter : cet appareil devient sa télécommande.");
                    color: Theme.muted;
                    font-size: 13px * root.k;
                    wrap: word-wrap;
                }
                for c[i] in root.remote-items: Rectangle {
                    height: 56px * root.k;
                    border-radius: 10px * root.k;
                    property <bool> lit: (Nav.kb ? i == root.remote-pick-sel : r-area.has-hover && !Nav.touch);
                    background: self.lit ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : Theme.fg.with-alpha(0.07);
                    Text {
                        x: 16px * root.k;
                        y: 8px * root.k;
                        width: parent.width - 32px * root.k;
                        text: c.name;
                        color: parent.lit ? Theme.on-accent : Theme.fg;
                        font-size: 16px * root.k;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        x: 16px * root.k;
                        y: 31px * root.k;
                        width: parent.width - 32px * root.k;
                        text: c.sub;
                        color: (parent.lit ? Theme.on-accent : Theme.fg).with-alpha(0.7);
                        font-size: 12px * root.k;
                        overflow: elide;
                    }
                    r-area := TouchArea {
                        clicked => {
                            root.remote-pick-sel = i;
                            root.remote-pick(c.id);
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    ActionButton {
                        height: 42px * root.k;
                        width: self.preferred-width;
                        text: Tr.t(Tr.k, "Fermer");
                        font: 15px * root.k;
                        focused: Nav.kb && root.remote-pick-sel == root.remote-items.length;
                        clicked => {
                            root.close-remote();
                        }
                    }
                }
            }
        }
        if root.remote-target != "": RemotePad {
            width: min(parent.width - 24px * root.k, 440px * root.k);
            // Ajustée au contenu ; un écran trop bas réduit l'ensemble (k).
            height: min(parent.height - 24px * root.k, self.want-h);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (1 - root.remote-p) * (root.remote-open ? 60px : -40px) * root.k;
            opacity: root.remote-p;
            // Écran trop bas ou trop étroit (téléphone en mode tablette) : l'ensemble rétrécit (rangée de
            // lecture : 340 px de large à k = 1, marges comprises).
            k: min(root.k, (parent.height - 24px * root.k) / 600px, (parent.width - 24px * root.k) / 360px);
            name: root.remote-target;
            now: root.remote-now;
            paused: root.remote-paused;
            pos: root.remote-pos;
            time: root.remote-time;
            full: true;
            sel <=> root.remote-sel;
            cmd(c) => {
                root.remote-cmd(c);
            }
            close => {
                root.close-remote();
            }
        }
    }

    // ------------------------------------------------------------ Menu latéral
    // Ouverture : le menu glisse vers la droite ; fermeture (ou choix) : il repart vers la gauche.
    // Défilement libre (doigt, molette) : la page ne suit plus la sélection mais ce décalage ; une
    // touche de navigation la rend à la sélection (repartie de ce qui est à l'écran).
    in-out property <bool> home-free;
    in-out property <length> home-free-y;
    in-out property <bool> lib-free;
    in-out property <length> lib-free-y;
    in-out property <bool> d-free;
    in-out property <length> d-free-y;
    property <bool> menu-free;
    property <length> menu-free-y;
    // Rangée de l'accueil dont le haut est le plus près de ce décalage (Rust).
    pure callback home-section-at(float) -> int;
    property <float> menu-p: root.menu-open ? 1 : 0;
    // Entrée du menu survolée par la souris (-1 : aucune) : au bureau, c'est elle qui est choisie.
    property <int> menu-hov: -1;
    // Surbrillance montrée : au clavier (Nav.kb), ou sous la souris.
    property <bool> menu-lit: Nav.kb || root.menu-hov >= 0;
    animate menu-p { duration: Motion.menu ? 380ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    // Toujours construit (invisible quand il est fermé) : l'ouverture ne crée rien, pas d'à-coup.
    // Pas de « visible: false » quand il est fermé : un élément caché ne peut pas prendre le clavier
    // (il le demande à l'ouverture, avant le début de l'animation). Fermé, il est hors écran.
    Rectangle {
        visible: !root.playing;
        background: Theme.scrim.with-alpha(0.65).transparentize(1 - root.menu-p);

        TouchArea {
            enabled: root.menu-open;
            clicked => {
                if (root.menu-open) {
                    root.close-menu();
                }
            }
            // Menu ouvert : la molette ne fait pas défiler la page dessous.
            scroll-event(e) => {
                return EventResult.accept;
            }
        }

        drawer := Rectangle {
            x: -(1 - root.menu-p) * (self.width + 8px);
            y: root.chrome-top;
            width: min(340px * root.k, parent.width - 32px * root.k);
            height: parent.height - root.chrome-top;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.glass-border;
            Gloss { r: parent.border-radius; strength: 0.45; }

            property <length> row-h: 40px * root.k;
            property <length> top: 84px * root.k;
            // Défilement si le menu dépasse l'écran (mode TV).
            property <length> max-scroll: max(0px, root.menu-entries.length * self.row-h - (self.height - self.top - 16px * root.k));
            property <length> scroll: root.menu-free ? root.menu-free-y
                : max(0px, (root.menu-sel + 1) * self.row-h - (self.height - self.top - 16px * root.k));
            animate scroll { duration: Motion.menu && !Nav.drag ? 220ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }

            TouchArea {
                // Molette dans le menu : la sélection monte ou descend.
                scroll-event(e) => {
                    // Doigt, molette : le menu défile librement (s'il dépasse l'écran), sans changer la sélection.
                    if (drawer.max-scroll > 0px) {
                        let base = root.menu-free ? root.menu-free-y : drawer.scroll;
                        root.menu-free-y = clamp(base - e.delta-y, 0px, drawer.max-scroll);
                        root.menu-free = true;
                    }
                    return EventResult.accept;
                }
            }

            // Menu ouvert sans le clavier (une page qui arrivait l'a repris : retour d'une bibliothèque,
            // puis menu rouvert aussitôt) : il le reprend, sinon les flèches allaient à la page dessous.
            Timer {
                interval: 50ms;
                running: root.menu-open && !root.tour-lock && !root.lx-open && !menu-fs.has-focus;
                triggered => {
                    menu-fs.focus();
                }
            }
            menu-fs := FocusScope {
                // À l'ouverture (même pendant qu'il se refermait), le clavier va au menu.
                property <bool> open: root.menu-open;
                changed open => {
                    // Ouvert par la visite guidée : le clavier reste à la visite.
                    if (self.open && !root.tour-lock) {
                        self.focus();
                    }
                }
                key-pressed(event) => {
                    root.menu-free = false;
                    // Touche maintenue : Entrée, Échap et Retour arrière ne répètent pas l'action (ouvrir, revenir...).
                    if (event.repeat && (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace)) {
                        return EventResult.accept;
                    }
                    // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                    if (root.loading && event.text == Key.Escape) {
                        root.cancel-open();
                        return EventResult.accept;
                    }
                    if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                        return EventResult.reject;
                    }
                    if (event.text == Key.UpArrow) {
                        root.menu-move(-1);
                    } else if (event.text == Key.DownArrow) {
                        root.menu-move(1);
                    } else if (event.text == Key.Return) {
                        if (root.tour-step == 6) {
                            return EventResult.accept;
                        }
                        root.close-menu();
                        root.menu-go(root.menu-entries[root.menu-sel].action);
                    } else if (event.text == Key.Escape || event.text == Key.Backspace || event.text == Key.RightArrow) {
                        root.close-menu();
                    }
                    return EventResult.accept;
                }
            }

            Text {
                x: 28px * root.k;
                y: 0px;
                height: parent.top;
                text: "Turtlefin";
                color: Theme.dark ? Theme.accent2 : Theme.accent1;
                font-size: 26px * root.k;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                y: parent.top;
                height: parent.height - parent.top;
                clip: true;

                // Surbrillance de l'entrée choisie : elle glisse d'une entrée à l'autre. À l'ouverture,
                // elle est déjà sur la page en cours (pas de glissement depuis l'entrée d'avant).
                Rectangle {
                    x: 14px * root.k - (1 - clamp(root.menu-p * max(1.7, 1 + root.menu-entries.length * 0.045) - root.menu-sel * 0.045, 0, 1)) * 90px * root.k;
                    y: root.menu-sel * drawer.row-h - drawer.scroll;
                    animate y { duration: Motion.menu && root.menu-open && root.menu-p > 0.05 ? 200ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    opacity: root.menu-lit ? 1 : 0;
                    animate opacity { duration: Motion.menu ? 150ms : 0ms; }
                    width: parent.width - 28px * root.k;
                    height: drawer.row-h - 4px * root.k;
                    border-radius: 10px * root.k;
                    background: @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%);
                    Gloss { r: parent.border-radius; strength: 0.8; }
                }

                for e[i] in root.menu-entries: Rectangle {
                    // Entrées en cascade : chacune arrive un peu après la précédente.
                    // Cascade : la dernière entrée arrive aussi à sa place quand le menu est ouvert (avant, au-delà
                    // de ~15 entrées, les dernières restaient décalées vers la gauche).
                    x: 14px * root.k - (1 - clamp(root.menu-p * max(1.7, 1 + root.menu-entries.length * 0.045) - i * 0.045, 0, 1)) * 90px * root.k;
                    y: i * drawer.row-h - drawer.scroll;
                    width: parent.width - 28px * root.k;
                    height: drawer.row-h - 4px * root.k;
                    border-radius: 10px * root.k;
                    property <bool> on: i == root.menu-sel && root.menu-lit;

                    if e.header && i > 0: Rectangle {
                        x: 4px * root.k;
                        y: 6px * root.k;
                        width: parent.width - 8px * root.k;
                        height: 1px;
                        background: Theme.fg.with-alpha(0.22);
                    }

                    if !e.header: NavIcon {
                        x: 16px * root.k;
                        y: (parent.height - self.height) / 2;
                        width: 20px * root.k;
                        height: 20px * root.k;
                        name: root.menu-icon(e.action);
                        tint: parent.on ? Theme.on-accent : Theme.fg.with-alpha(0.8);
                    }
                    Marquee {
                        x: (e.header ? 14px : 48px) * root.k;
                        width: parent.width - (e.header ? 28px : 62px) * root.k;
                        text: e.header ? e.label.to-uppercase() : e.label;
                        text-color: e.header ? Theme.muted : parent.on ? Theme.on-accent : Theme.fg;
                        font-size: (e.header ? 12px : 17px) * root.k;
                        font-weight: e.header ? 700 : (parent.on ? 600 : 500);
                        vertical-alignment: e.header ? TextVerticalAlignment.bottom : TextVerticalAlignment.center;
                        active: !e.header && parent.on;
                        horizontal-alignment: TextHorizontalAlignment.left;
                        height: self.preferred-height;
                    }

                    // Mot de passe trop simple : pastille qui bat sur le chemin du changement.
                    if !e.header && (e.action == "settings" || e.action == "password") && e.action != root.here: AlertBadge {
                        k: root.k;
                        x: parent.width - self.width - 10px * root.k;
                        y: (parent.height - self.height) / 2;
                    }
                    // Vous êtes ici : trait d'accent à gauche et point à droite.
                    if !e.header && e.action == root.here: Rectangle {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        width: 4px * root.k;
                        height: parent.height * 0.6;
                        border-radius: self.width / 2;
                        background: parent.on ? Theme.on-accent : Theme.accent2;
                    }
                    if !e.header && e.action == root.here: Rectangle {
                        x: parent.width - self.width - 14px * root.k;
                        y: (parent.height - self.height) / 2;
                        width: 8px * root.k;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: parent.on ? Theme.on-accent : Theme.accent2;
                    }

                    row := TouchArea {
                        enabled: !e.header;
                        // La souris choisit l'entrée qu'elle survole (la surbrillance la rejoint).
                        changed has-hover => {
                            // Au clavier / à la télécommande (Nav.kb), un pointeur immobile sous le menu
                            // qui glisse ne doit pas déplacer la sélection.
                            if (self.has-hover && !Nav.kb && !Nav.touch) {
                                root.menu-sel = i;
                                root.menu-hov = i;
                            } else if (root.menu-hov == i) {
                                root.menu-hov = -1;
                            }
                        }
                        clicked => {
                            root.menu-sel = i;
                            root.close-menu();
                            root.menu-go(e.action);
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Page Seerr (premier plan)
    // Tout tient dans l'écran (pas de défilement) : tailles calculées sur la hauteur disponible.
    if (root.sr-open || root.sr-out) && !root.playing: srp := Rectangle {
        // Fermeture (sr-out) : fondu et léger recul.
        property <float> out-q: root.sr-out && !root.sr-open ? clamp((animation-tick() - root.sr-out-t0) / 280ms, 0, 1) : 0;
        property <float> out-e: 1 - (1 - self.out-q) * (1 - self.out-q);
        opacity: 1 - self.out-e;
        transform-scale: 0.96 + 0.04 * root.page-e - 0.05 * self.out-e;
        background: Theme.bg-end;

        property <length> u: min(self.height / 720px, self.width / 1280px) * 1px; // unité : 1 px sur un écran 1280x720
        property <length> pad: 40 * self.u;
        property <length> poster-h: 300 * self.u;

        TouchArea {
            // La molette ne fait pas défiler la page dessous.
            scroll-event(e) => {
                return EventResult.accept;
            }
        }

        FocusScope {
            init => {
                // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            key-pressed(event) => {
                // Page en train de s'effacer : plus d'action.
                if (!root.sr-open) {
                    return EventResult.accept;
                }
                // Touche maintenue : Entrée, Échap et Retour arrière ne répètent pas l'action (ouvrir, revenir...).
                if (event.repeat && (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace)) {
                    return EventResult.accept;
                }
                // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                if (root.loading && event.text == Key.Escape) {
                    root.cancel-open();
                    return EventResult.accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.sr-sel = 0;
                } else if (event.text == Key.RightArrow) {
                    root.sr-sel = 1;
                } else if (event.text == Key.Return) {
                    if (root.sr-sel == 0 && (root.sr.can-request || root.sr.on-server)) {
                        root.seerr-action();
                    } else {
                        root.seerr-close();
                    }
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.seerr-close();
                }
                return EventResult.accept;
            }
        }

        // Fond : image du média floutée (préparée une fois), puis voile vers le bas.
        if root.sr.has-backdrop: Image {
            width: parent.width;
            height: parent.height;
            source: root.sr.backdrop;
            image-fit: cover;
        }
        Rectangle {
            background: @linear-gradient(180deg, Theme.bg-mid.with-alpha(0.4) 0%, Theme.bg-end.with-alpha(0.85) 55%, Theme.bg-end 100%);
        }

        if root.sr.loading: Text {
            text: Tr.t(Tr.k, "Chargement…");
            color: Theme.muted;
            font-size: 22 * srp.u;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if !root.sr.loading: Rectangle {
            // Affiche
            Rectangle {
                x: srp.pad;
                y: srp.pad;
                width: srp.poster-h / 1.5;
                height: srp.poster-h;
                border-radius: 12 * srp.u;
                visible: !root.hero-covers || !root.hero-seerr;
                background: root.sr.has-poster ? transparent : Theme.fg.with-alpha(0.08);
                if root.sr.has-poster: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.sr.poster;
                    image-fit: fill;
                }
            }

            // Titre, informations, état, boutons
            VerticalLayout {
                x: srp.pad + srp.poster-h / 1.5 + 32 * srp.u;
                y: srp.pad;
                width: parent.width - self.x - srp.pad;
                height: srp.poster-h;
                spacing: 12 * srp.u;
                alignment: center;

                Marquee {
                    text: root.sr.title + (root.sr.year != "" ? "  (" + root.sr.year + ")" : "");
                    text-color: Theme.fg;
                    font-size: 38 * srp.u;
                    font-weight: 700;
                    active: true;
                    horizontal-alignment: TextHorizontalAlignment.left;
                    height: self.preferred-height;
                }
                Text {
                    text: root.sr.length + (root.sr.length != "" && root.sr.genres != "" ? "   ·   " : "") + root.sr.genres
                        + (root.sr.rating != "" ? "   ·   ★ " + root.sr.rating : "");
                    color: Theme.fg.with-alpha(0.82);
                    font-size: 18 * srp.u;
                    overflow: elide;
                }
                // Informations clés en pastilles (statut, sortie, langue, studio)
                HorizontalLayout {
                    alignment: start;
                    spacing: 10 * srp.u;
                    height: 30 * srp.u;
                    for f in root.sr.facts: Rectangle {
                        border-radius: self.height / 2;
                        background: Theme.fg.with-alpha(0.1);
                        width: fact-t.preferred-width + 24 * srp.u;
                        fact-t := Text {
                            text: f.label + " : " + f.value;
                            color: Theme.fg.with-alpha(0.88);
                            font-size: 13 * srp.u;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.sr.status != "": Text {
                    text: root.sr.status;
                    color: Theme.accent2;
                    font-size: 18 * srp.u;
                    font-weight: 700;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 16 * srp.u;
                    height: 50 * srp.u;
                    if root.sr.can-request || root.sr.on-server: ActionButton {
                        text: root.sr.on-server ? Tr.t(Tr.k, "Voir sur le serveur") : Tr.t(Tr.k, "Demander");
                        font: 18 * srp.u;
                        focused: root.sr-sel == 0;
                        clicked => {
                            root.seerr-action();
                        }
                    }
                    ActionButton {
                        text: Tr.t(Tr.k, "Fermer");
                        font: 18 * srp.u;
                        focused: root.sr-sel == 1 || !(root.sr.can-request || root.sr.on-server);
                        clicked => {
                            root.seerr-close();
                        }
                    }
                }
            }

            // Résumé (coupé proprement s'il est trop long)
            Text {
                x: srp.pad;
                y: srp.pad + srp.poster-h + 28 * srp.u;
                width: parent.width - 2 * srp.pad;
                height: 100 * srp.u;
                text: root.sr.overview;
                color: Theme.fg.with-alpha(0.85);
                font-size: 17 * srp.u;
                wrap: word-wrap;
                overflow: elide;
            }

            // Distribution : photos rondes sur une ligne (autant qu'il en tient)
            Rectangle {
                x: srp.pad;
                y: min(parent.height - self.height - 16 * srp.u, srp.pad + srp.poster-h + 148 * srp.u);
                width: parent.width - 2 * srp.pad;
                height: 140 * srp.u;
                clip: true;
                for c[i] in root.sr-cast: Rectangle {
                    x: i * 118 * srp.u;
                    width: 104 * srp.u;
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 0px;
                        width: 84 * srp.u;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: Theme.fg.with-alpha(0.1);
                        clip: false;
                        if c.has-image: Image {
                            width: parent.width;
                            height: parent.height;
                            source: c.image;
                            image-fit: fill;
                        }
                    }
                    Text {
                        y: 92 * srp.u;
                        width: parent.width;
                        text: c.title;
                        color: Theme.fg;
                        font-size: 12 * srp.u;
                        font-weight: 600;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        y: 110 * srp.u;
                        width: parent.width;
                        text: c.subtitle;
                        color: Theme.muted;
                        font-size: 11 * srp.u;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Lecture
    // Marges du lecteur (barres d'Android) : noires, comme le fond de la vidéo.
    if root.playing: Rectangle {
        y: root.chrome-top;
        height: parent.height - root.chrome-top;
        background: black;
    }
    if root.playing: PlayerView {
        cast-on: root.cast-on;
        remote: root.p-remote;
        remote-name: root.cast-target;
        remote-nodur: root.p-remote-nodur;
        remote-busy: root.p-remote-busy;
        cast => {
            root.player-cast();
        }
        // Android : hors des barres du système. En paysage, la barre de navigation passe sur le côté
        // (gauche ou droite selon le sens), par-dessus l'appli, sans que le système le signale : marge
        // de sa largeur des deux côtés (la vidéo, en 16/9, a la place).
        property <length> side: Nav.phone && parent.width > parent.height ? 48px : 0px;
        x: max(root.safe-area-insets.left, self.side);
        y: root.chrome-top + root.safe-area-insets.top;
        width: parent.width - max(root.safe-area-insets.left, self.side) - max(root.safe-area-insets.right, self.side);
        // Bas : la barre de gestes d'Android (paysage) passe aussi par-dessus.
        height: parent.height - root.chrome-top - root.safe-area-insets.top - max(root.safe-area-insets.bottom, Nav.phone ? 20px : 0px);
        hit-sx <=> root.p-hit-sx;
        hit-sy <=> root.p-hit-sy;
        hit-sw <=> root.p-hit-sw;
        hit-sh <=> root.p-hit-sh;
        hit-vx <=> root.p-hit-vx;
        hit-vy <=> root.p-hit-vy;
        hit-vw <=> root.p-hit-vw;
        hit-vh <=> root.p-hit-vh;
        k: root.k;
        frame: root.video-frame;
        ready: root.p-ready;
        buffering: root.p-buffering;
        lost: root.p-lost;
        title: root.p-title;
        subtitle: root.p-subtitle;
        paused: root.p-paused;
        progress: root.p-progress;
        pos-text: root.p-pos-text;
        dur-text: root.p-dur-text;
        end-text: root.p-end-text;
        volume <=> root.p-volume;
        chapters: root.p-chapters;
        chapter-count: root.p-chapter-count;
        has-prev: root.p-has-prev;
        has-next: root.p-has-next;
        audio-tracks: root.audio-tracks;
        audio-current: root.audio-current;
        quality-tracks: root.p-quality;
        quality-current: root.p-quality-current;
        sub-tracks: root.sub-tracks;
        sub-current: root.sub-current;
        episodes: root.p-episodes;
        ep-current: root.p-ep-current;
        up-mode: root.p-up-mode;
        up-title: root.p-up-title;
        up-sub: root.p-up-sub;
        up-image: root.p-up-image;
        has-up-image: root.p-has-up-image;
        picks: root.p-picks;
        up-button: root.p-up-button;
        skip-intro: root.p-skip-intro;
        bg: root.p-bg;
        has-bg: root.p-has-bg;
        party: root.sp-active ? root.sp-name : "";
        swipe-n: root.p-swipe-n;
        swipe-dir: root.p-swipe-dir;
        command(c) => {
            root.player-cmd(c);
        }
        toggle-fullscreen => {
            root.toggle-full();
        }
    }

    // Panneaux du haut à droite (⋯, Diffuser, Watch party), après le lecteur : Diffuser s'ouvre aussi
    // depuis le lecteur, par-dessus.
    // Menu « ⋯ » (petit écran) : diffuser, watch party, hasard, recherche, en liste sous le bouton.
    changed more-open => {
        if (!root.more-open) {
            root.refocus += 1;
        } else {
            root.drop-to(0);
        }
    }
    // Le cadre commun (voir drop-kind) et le voile de la page ; les panneaux, dessus, n'ont que leur contenu.
    if root.drop-p > 0.01: Rectangle {
        background: Theme.scrim.with-alpha(0.35 * root.drop-p);
        Rectangle {
            width: root.drop-w;
            height: root.drop-h;
            x: parent.width - self.width - 16px * root.k;
            y: root.drop-y;
            opacity: root.drop-p;
            border-radius: (Theme.win7 ? 8px : 18px) * root.k;
            background: Theme.win7 ? transparent : Theme.glass;
            border-width: Theme.win7 ? 0px : 1px;
            border-color: Theme.glass-border;
            drop-shadow-blur: Nav.no-shadow ? 0px : (24px * root.k);
            drop-shadow-color: #00000080;
            Gloss { r: parent.border-radius; strength: 0.45; visible: Theme.gloss > 0 && !Theme.win7; }
            WinFrame { r: parent.border-radius; k: root.k; }
        }
    }
    if root.more-p > 0.01 && !root.playing: Rectangle {
        TouchArea {
            clicked => {
                root.more-open = false;
            }
        }
        property <[string]> icons: ["cast", "party", "dice", "search"];
        Rectangle {
            width: root.drop-w;
            height: root.drop-h;
            x: parent.width - self.width - 16px * root.k;
            y: root.drop-y;
            opacity: root.more-p;
            clip: true;
            FocusScope {
                init => {
                    self.focus();
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape || event.text == Key.Backspace) {
                        root.more-open = false;
                    } else if (event.text == Key.UpArrow) {
                        root.more-sel = max(0, root.more-sel - 1);
                    } else if (event.text == Key.DownArrow) {
                        root.more-sel = min(3, root.more-sel + 1);
                    } else if (event.text == Key.Return) {
                        root.right-activate(root.more-sel);
                    }
                    return EventResult.accept;
                }
            }
            for ic[i] in parent.icons: Rectangle {
                x: 8px * root.k;
                y: 8px * root.k + i * 56px * root.k;
                width: parent.width - 16px * root.k;
                height: 52px * root.k;
                border-radius: 10px * root.k;
                property <bool> lit: Nav.kb ? root.more-sel == i : m-area.has-hover && !Nav.touch;
                property <bool> on: (i == 0 && root.cast-on) || (i == 1 && root.sp-active);
                background: self.lit ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : self.on ? Theme.fg.with-alpha(0.14) : transparent;
                HeaderIcon {
                    x: 6px * root.k;
                    y: (parent.height - self.height) / 2;
                    k: root.k;
                    icon: ic;
                    on: parent.on;
                }
                Text {
                    x: 60px * root.k;
                    width: parent.width - self.x - 10px * root.k;
                    text: i == 0 ? Tr.t(Tr.k, "Diffuser") : i == 1 ? Tr.t(Tr.k, "Watch party") : i == 2 ? Tr.t(Tr.k, "Au hasard") : Tr.t(Tr.k, "Recherche");
                    color: parent.lit ? Theme.on-accent : Theme.fg;
                    font-size: 16px * root.k;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                m-area := TouchArea {
                    clicked => {
                        root.more-sel = i;
                        root.right-activate(i);
                    }
                }
            }
        }
    }

    // Diffuser : panneau qui descend sous son icône (toucher à côté, Échap ou Retour le referment).
    // Écrans où envoyer les vidéos (télés DLNA du réseau, Turtlefin ou applis Jellyfin du compte) ; l'écran
    // choisi, le panneau montre ce qui y passe, avec lecture, avance, arrêt et volume.
    // Clavier : ↑ ↓ entre les écrans, les deux rangées de commandes et « Ne plus diffuser » ; ← → dans une rangée.
    if root.cast-p > 0.01: Rectangle {
        TouchArea {
            clicked => {
                root.close-cast();
            }
            scroll-event(e) => {
                return EventResult.accept;
            }
        }
        cast-panel := Rectangle {
            // Indices du clavier : 0..n-1 écrans · n commandes de lecture · n+1 volume · n+2 « Ne plus diffuser ».
            property <int> n: root.cast-items.length;
            // Commandes : 0 précédent · 1 recul · 2 lecture · 3 avance · 4 suivant · 5 arrêt · 6 vol- · 7 muet · 8 vol+
            property <[string]> codes: ["prev", "rew", "playpause", "ff", "next", "stop", "vol-", "mute", "vol+"];
            // Boutons de lecture réduits si la rangée (310 px à k = 1) ne tient pas (téléphone).
            property <float> bk: root.k * min(1, (self.width - 40px * root.k) / (310px * root.k));
            // Taille : celle du cadre commun (voir drop-kind), qui suit la hauteur voulue ici.
            property <length> want-h: cast-col.preferred-height + 40px * root.k;
            init => {
                root.cast-h = self.want-h;
            }
            changed want-h => {
                root.cast-h = self.want-h;
            }
            width: root.drop-w;
            height: root.drop-h;
            x: parent.width - self.width - 16px * root.k;
            y: root.drop-y;
            opacity: root.cast-p;
            clip: true;
            TouchArea {
                scroll-event(e) => {
                    return EventResult.accept;
                }
            }
            FocusScope {
                init => {
                    self.focus();
                }
                key-pressed(event) => {
                    // Indices : 0..n-1 écrans · n « Voir la lecture » · n+1 « Ne plus diffuser ».
                    if (event.text == Key.Escape || event.text == Key.Backspace) {
                        root.close-cast();
                    } else if (event.text == Key.UpArrow) {
                        root.cast-sel = max(0, root.cast-sel - 1);
                        if (root.cast-sel == cast-panel.n && root.cast-now == "") {
                            root.cast-sel -= 1;
                        }
                    } else if (event.text == Key.DownArrow) {
                        root.cast-sel = min(root.cast-on ? cast-panel.n + 1 : cast-panel.n - 1, root.cast-sel + 1);
                        if (root.cast-sel == cast-panel.n && root.cast-now == "") {
                            root.cast-sel += 1;
                        }
                    } else if (event.text == Key.Return) {
                        if (root.cast-sel < cast-panel.n) {
                            root.cast-pick(root.cast-items[root.cast-sel].id);
                        } else if (root.cast-sel == cast-panel.n) {
                            root.cast-reopen();
                        } else if (root.cast-on) {
                            root.cast-stop();
                        }
                    }
                    return EventResult.accept;
                }
            }
            cast-col := VerticalLayout {
                x: 20px * root.k;
                y: 20px * root.k;
                width: parent.width - 40px * root.k;
                alignment: start;
                spacing: 10px * root.k;
                Text {
                    text: Tr.t(Tr.k, "Diffuser");
                    color: Theme.fg;
                    font-size: 20px * root.k;
                    font-weight: 700;
                }
                Text {
                    text: root.cast-busy && root.cast-items.length == 0 ? Tr.t(Tr.k, "Recherche des écrans…")
                        : root.cast-items.length == 0 ? Tr.t(Tr.k, "Aucun écran. Allume une télé compatible DLNA sur ce réseau, ou ouvre Turtlefin (ou une appli Jellyfin) sur la télé avec le même compte.")
                        : root.cast-on ? Tr.t(Tr.k, "Les vidéos lancées avec « Lire sur » (sur les fiches) passent sur cet écran.")
                        : Tr.t(Tr.k, "Choisis l'écran où envoyer les vidéos : « Lire sur » apparaît ensuite sur les fiches.");
                    color: Theme.muted;
                    font-size: 13px * root.k;
                    wrap: word-wrap;
                }
                for c[i] in root.cast-items: Rectangle {
                    height: 56px * root.k;
                    border-radius: 10px * root.k;
                    property <bool> lit: (Nav.kb ? i == root.cast-sel : c-area.has-hover && !Nav.touch);
                    property <bool> chosen: root.cast-on && root.cast-target == c.name;
                    background: self.lit ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : Theme.fg.with-alpha(self.chosen ? 0.16 : 0.07);
                    border-width: self.chosen && !self.lit ? 1px : 0px;
                    border-color: Theme.accent2;
                    opacity: 1 - (1 - root.cast-p) * min(1, i * 0.4);
                    Text {
                        x: 16px * root.k;
                        y: 8px * root.k;
                        width: parent.width - 32px * root.k;
                        text: (c.kind != "jf" ? "📺  " : "") + c.name + (parent.chosen ? "  ✓" : "");
                        color: parent.lit ? Theme.on-accent : Theme.fg;
                        font-size: 16px * root.k;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        x: 16px * root.k;
                        y: 31px * root.k;
                        width: parent.width - 32px * root.k;
                        text: c.sub;
                        color: (parent.lit ? Theme.on-accent : Theme.fg).with-alpha(0.7);
                        font-size: 12px * root.k;
                        overflow: elide;
                    }
                    c-area := TouchArea {
                        clicked => {
                            root.cast-sel = i;
                            root.cast-pick(c.id);
                        }
                    }
                }
                // Écran choisi : la vidéo en cours, et le lecteur-télécommande pour la piloter.
                if root.cast-on && root.cast-now != "": ActionButton {
                    height: 42px * root.k;
                    text: Tr.f(Tr.k, "Voir la lecture · {}", root.cast-now, "");
                    font: 15px * root.k;
                    focused: Nav.kb && root.cast-sel == cast-panel.n;
                    clicked => {
                        root.cast-reopen();
                    }
                }
                if root.cast-on: ActionButton {
                    height: 42px * root.k;
                    text: Tr.f(Tr.k, "Ne plus diffuser sur {}", root.cast-target, "");
                    font: 15px * root.k;
                    focused: Nav.kb && root.cast-sel == cast-panel.n + 1;
                    clicked => {
                        root.cast-stop();
                    }
                }
            }
        }
    }

    // Watch party : panneau qui descend sous son icône, en haut à droite (toucher à côté, Échap ou
    // Retour le referment). Contenu : le groupe en cours, ou les groupes à rejoindre et « Créer ».
    if root.party-p > 0.01 && !root.playing: Rectangle {
        TouchArea {
            clicked => {
                root.close-party();
            }
            scroll-event(e) => {
                return EventResult.accept;
            }
        }
    party := Rectangle {
        // Taille : celle du cadre commun (voir drop-kind), qui suit la hauteur voulue ici.
        property <length> want-h: party-col.preferred-height + 40px * root.k;
        changed want-h => {
            root.party-h = self.want-h;
        }
        width: root.drop-w;
        height: root.drop-h;
        x: parent.width - self.width - 16px * root.k;
        y: root.drop-y;
        opacity: root.party-p;
        clip: true;
        // Le panneau garde les touchers (ils ne ferment pas).
        TouchArea {
            scroll-event(e) => {
                return EventResult.accept;
            }
        }

        // Boutons : dans un groupe, « Quitter » ; sinon les groupes existants puis « Créer ».
        property <int> n: root.sp-active ? 1 : root.sp-groups.length + 1;
        // Arrivée : la colonne glisse depuis la gauche, ses éléments apparaissent l'un après l'autre.
        property <float> in-e: 0;
        init => {
            self.in-e = 1;
            root.party-h = self.want-h;
        }
        animate in-e { duration: Motion.panels ? 520ms : 0ms; delay: Motion.panels ? 60ms : 0ms; easing: ease-out; }
        pure function step(i: int) -> float {
            let x = clamp(party.in-e * 1.8 - min(i, 6) * 0.14, 0, 1);
            return 1 - (1 - x) * (1 - x);
        }

        FocusScope {
            property <int> tick: root.refocus;
            changed tick => {
                // Panneau en train de partir (fermé) : il ne reprend pas le clavier (il l'emporterait
                // en disparaissant, et plus rien ne répondrait).
                if (root.party-pop && !root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            init => {
                // Menu ouvert : il garde le clavier (sa fermeture rend la main via refocus).
                if (!root.menu-open && !root.tour-lock && !root.lx-open) {
                    self.focus();
                }
            }
            key-pressed(event) => {
                // Touche maintenue : Entrée, Échap et Retour arrière ne répètent pas l'action (ouvrir, revenir...).
                if (event.repeat && (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace)) {
                    return EventResult.accept;
                }
                // Page en cours de chargement : Échap annule l'ouverture (on reste où l'on est).
                if (root.loading && event.text == Key.Escape) {
                    root.cancel-open();
                    return EventResult.accept;
                }
                if (event.text == Key.UpArrow) {
                    if (root.sp-sel == 0) {
                        root.close-party();
                    } else {
                        root.sp-sel -= 1;
                    }
                } else if (event.text == Key.DownArrow) {
                    root.sp-sel = min(party.n - 1, root.sp-sel + 1);
                } else if (event.text == Key.Return) {
                    if (root.sp-active) {
                        root.party-action("leave");
                    } else if (root.sp-sel < root.sp-groups.length) {
                        root.party-action(root.sp-groups[root.sp-sel].action);
                    } else {
                        root.party-action("create");
                    }
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.close-party();
                }
                return EventResult.accept;
            }
        }

        party-col := VerticalLayout {
            x: 20px * root.k + (1 - party.step(0)) * 24px * root.k;
            y: 20px * root.k;
            width: parent.width - 40px * root.k;
            alignment: start;
            spacing: 14px * root.k;

            Text {
                text: Tr.t(Tr.k, "Watch party");
                color: Theme.fg;
                font-size: 20px * root.k;
                font-weight: 700;
            }
            Text {
                opacity: party.step(0);
                text: root.sp-active
                    ? Tr.f(Tr.k, "Tu es dans « {} ». Lance un film ou un épisode : il démarrera pour tout le groupe, en même temps. Pause et sauts sont partagés.", root.sp-name, "")
                    : Tr.t(Tr.k, "Regarde la même chose en même temps que d'autres comptes : crée une watch party ou rejoins-en une.");
                color: Theme.muted;
                font-size: 15px * root.k;
                wrap: word-wrap;
            }
            // Le groupe : état, ce qu'il regarde, participants.
            if root.sp-active: Rectangle {
                opacity: party.step(1);
                height: party-card.preferred-height;
                border-radius: 16px * root.k;
                background: Theme.fg.with-alpha(0.07);
                border-width: 1px;
                border-color: Theme.glass-border;
                party-card := VerticalLayout {
                    padding: 20px * root.k;
                    spacing: 10px * root.k;
                    HorizontalLayout {
                        spacing: 10px * root.k;
                        alignment: start;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 10px * root.k;
                            height: self.width;
                            border-radius: self.width / 2;
                            background: root.sp-state == Tr.t(Tr.k, "En lecture") ? Theme.ok : root.sp-state == Tr.t(Tr.k, "En pause") ? Theme.warn : Theme.accent2;
                        }
                        Text {
                            text: root.sp-state;
                            color: Theme.fg;
                            font-size: 16px * root.k;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.sp-now != "" ? Tr.f(Tr.k, "Regarde : {}", root.sp-now, "") : Tr.t(Tr.k, "Rien pour l'instant : lance un film ou un épisode.");
                        color: root.sp-now != "" ? Theme.accent2 : Theme.muted;
                        font-size: 16px * root.k;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Text {
                        text: Tr.p(Tr.k, "{n} participant", "{n} participants", root.sp-count);
                        color: Theme.muted;
                        font-size: 13px * root.k;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        spacing: 8px * root.k;
                        alignment: start;
                        height: 32px * root.k;
                        for who[wi] in root.sp-list: Rectangle {
                            width: who-t.preferred-width + 44px * root.k;
                            border-radius: self.height / 2;
                            background: Theme.fg.with-alpha(0.1);
                            Rectangle {
                                x: 4px * root.k;
                                y: 4px * root.k;
                                width: parent.height - 8px * root.k;
                                height: self.width;
                                border-radius: self.width / 2;
                                background: @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%);
                                Gloss { r: parent.border-radius; strength: 0.8; }
                                Text {
                                    text: wi < root.sp-initials.length ? root.sp-initials[wi] : "?";
                                    color: Theme.on-accent;
                                    font-size: 12px * root.k;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            who-t := Text {
                                x: parent.height + 2px * root.k;
                                text: who;
                                color: Theme.fg;
                                font-size: 14px * root.k;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            if !root.sp-active && root.sp-groups.length > 0: Text {
                opacity: party.step(1);
                text: Tr.t(Tr.k, "REJOINDRE");
                color: Theme.muted;
                font-size: 12px * root.k;
                font-weight: 700;
            }
            for g[i] in root.sp-active ? [] : root.sp-groups: Rectangle {
                opacity: party.step(2 + i);
                height: 56px * root.k;
                border-radius: 12px * root.k;
                background: (Nav.kb ? (!root.h-focus && i == root.sp-sel) : g-area.has-hover && !Nav.touch) ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : (((Nav.kb ? (!root.h-focus && i == root.sp-sel) : g-area.has-hover && !Nav.touch) ? Theme.on-accent : ((Nav.kb ? (!root.h-focus && i == root.sp-sel) : g-area.has-hover && !Nav.touch) ? Theme.on-accent : Theme.fg))).with-alpha(0.08);
                Gloss { r: parent.border-radius; strength: 0.8; }
                Text {
                    x: 20px * root.k;
                    height: parent.height;
                    text: g.label;
                    color: ((Nav.kb ? (!root.h-focus && i == root.sp-sel) : g-area.has-hover && !Nav.touch) ? Theme.on-accent : Theme.fg);
                    font-size: 16px * root.k;
                    vertical-alignment: center;
                }
                g-area := TouchArea {
                    clicked => {
                        root.party-action(g.action);
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                height: 46px * root.k;
                opacity: party.step(root.sp-active ? 2 : 2 + root.sp-groups.length);
                ActionButton {
                    text: root.sp-active ? Tr.t(Tr.k, "Quitter la watch party") : Tr.t(Tr.k, "Créer une watch party");
                    font: 16px * root.k;
                    focused: !root.h-focus && (root.sp-active ? root.sp-sel == 0 : root.sp-sel == root.sp-groups.length);
                    clicked => {
                        root.party-action(root.sp-active ? "leave" : "create");
                    }
                }
            }
        }
    }
    }

    // Départ vers la lecture : tout plonge dans le noir (le lecteur est noir dessous).
    if root.po > 0.01 && !root.playing: Rectangle {
        background: black;
        // Le noir n'arrive qu'en seconde moitié : on voit d'abord la fiche s'écarter.
        opacity: clamp((root.po - 0.45) / 0.55, 0, 1);
    }

    // Voile de transition : la page qui part s'efface dans son fond, qui lui ne bouge pas (même image,
    // même décor : une copie du fond passe par-dessus la page, seul le contenu disparaît).
    property <bool> veil-dim: root.hero-on && root.hero-big && root.hero-dest;
    // Sous la barre du haut seulement : la barre (commune à toutes les pages) reste nette. Rognée,
    // la copie du fond garde sa position (l'image tombe exactement sur celle de dessous).
    if root.veil > 0.001 && !root.playing && !root.veil-dim: Rectangle {
        y: root.header-row;
        height: parent.height - root.header-row;
        clip: true;
        Backdrop {
        x: root.chrome-side;
        y: root.chrome-top - root.header-row;
        width: root.width - 2 * root.chrome-side;
        height: root.height - root.chrome-top - root.chrome-side;
        a: root.veil;
        bg-a: root.bg-a;
        bg-b: root.bg-b;
        bg-mix: root.bg-mix;
        bg-vis: root.bg-vis;
        po: root.po;
        d-fade: root.header-h + 24px + 316px * root.k + root.d-low - root.d-view-y;
        on-detail: root.screen == "detail";
        k: root.k;
        glass: root.signed-in && root.screen != "login" && root.screen != "loading";
        // Le fond commence sous la barre de titre de Windows 7 (chrome-top) : la barre de verre a la
        // hauteur de l'en-tête seul.
        header-h: root.header-h - root.chrome-top;
        TouchArea {
            // La molette ne fait pas défiler la page dessous.
            scroll-event(e) => {
                return EventResult.accept;
            }
        }
        }
    }
    if root.veil > 0.001 && !root.playing && root.veil-dim: Rectangle {
        y: root.header-row;
        height: parent.height - root.header-row;
        // Sous une vignette qui grandit jusqu'au plein écran : léger assombrissement seulement
        // (pas de « fondu au noir » avant que l'image ne couvre tout).
        background: Theme.bg.transparentize(1 - root.veil * 0.45);
        TouchArea {
            // La molette ne fait pas défiler la page dessous.
            scroll-event(e) => {
                return EventResult.accept;
            }
        }
    }

    // Chargement qui traîne (réseau lent) : après 1,2 s, une pastille discrète le signale en bas.
    property <bool> slow-load;
    Timer {
        interval: 1200ms;
        running: root.loading && !root.slow-load;
        triggered => {
            root.slow-load = true;
        }
    }
    changed loading => {
        if (!root.loading) {
            root.slow-load = false;
        }
    }
    property <float> slow-p: root.slow-load && root.loading ? 1 : 0;
    animate slow-p { duration: Motion.pages ? 300ms : 0ms; easing: ease-out; }
    if root.slow-p > 0.01 && !root.playing: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 40px * root.k + (1 - root.slow-p) * 20px * root.k;
        opacity: root.slow-p;
        width: slow-t.preferred-width + 80px * root.k;
        height: 48px * root.k;
        border-radius: self.height / 2;
        background: Theme.glass;
        border-width: 1px;
        border-color: Theme.glass-border;
        Gloss { r: parent.border-radius; strength: 0.45; }
        Path {
            x: 18px * root.k;
            y: (parent.height - self.height) / 2;
            width: 20px * root.k;
            height: 20px * root.k;
            viewbox-width: 100;
            viewbox-height: 100;
            fill: transparent;
            stroke: Theme.accent2;
            stroke-width: 3px * root.k;
            commands: "M 50 8 A 42 42 0 0 1 92 50";
            transform-rotation: mod(animation-tick() / 1ms, 900) / 900 * 360deg;
        }
        slow-t := Text {
            x: 50px * root.k;
            height: parent.height;
            text: Tr.t(Tr.k, "Chargement… (Échap pour annuler)");
            color: Theme.text;
            font-size: 15px * root.k;
            vertical-alignment: center;
        }
    }

    // Image partagée (au-dessus du voile) pendant qu'elle vole ; un grand fond arrivé passe derrière
    // la page (voir plus haut, avant les écrans). Coins arrondis (rognage, le temps du vol) et
    // pastilles de la carte (épisodes restants, note...), qui s'effacent vers la page.
    // Rognée sous la barre du haut, qui reste nette pendant le vol (barre commune à toutes les pages).
    if root.hero-on && !root.hero-under && !root.playing: Rectangle {
        y: root.header-row;
        height: parent.height - root.header-row;
        clip: true;
    Rectangle {
        // Porte (portrait) : dessinée à part (voir hero-door).
        opacity: root.hero-door ? 0 : root.hero-out-a;
        x: root.hero-fx + (root.hero-tx - root.hero-fx) * root.hero-p;
        y: root.hero-fy + (root.hero-ty - root.hero-fy) * root.hero-p - root.header-row;
        width: root.hero-fw + (root.hero-tw - root.hero-fw) * root.hero-p;
        height: root.hero-fh + (root.hero-th - root.hero-fh) * root.hero-p;
        // Carte : coins du haut arrondis, bas carrés · affiche : 4 coins arrondis · plein écran : aucun.
        // Vignette qui devient le fond : les coins du haut disparaissent dès le début du vol.
        border-top-left-radius: root.hero-big ? Theme.radius * max(0, 1 - 5 * root.hero-p) : Theme.radius;
        border-top-right-radius: root.hero-big ? Theme.radius * max(0, 1 - 5 * root.hero-p) : Theme.radius;
        border-bottom-left-radius: root.hero-big ? 0px : Theme.radius * root.hero-p;
        border-bottom-right-radius: root.hero-big ? 0px : Theme.radius * root.hero-p;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.hero-img;
            image-fit: cover;
            opacity: root.hero-alpha;
            // Vignette 16:9 qui devient le fond : ses coins arrondis sont dans les pixels ; le haut
            // de l'image est rogné au fil de l'agrandissement pour qu'ils ne grandissent pas avec elle.
            source-clip-y: root.hero-crop;
            source-clip-height: root.hero-img.height - root.hero-crop;
        }
        // Pastilles de la carte, à leur taille de carte.
        if root.hero-p < 0.999 && !root.hero-big: CardArt {
            data: root.hero-data;
            k: root.hero-k;
            badges-only: true;
            opacity: 1 - root.hero-p;
        }
        // Grand fond : assombri pour que la page reste lisible par-dessus.
        if root.hero-big: Rectangle {
            background: Theme.bg.transparentize(1 - 0.6 * root.hero-p * root.hero-alpha);
        }
    }
    }

    // Porte (portrait, vignette 16:9 ouverte, voir hero-door) : sous la barre du haut, qui reste nette.
    if root.hero-on && root.hero-door && !root.playing: Rectangle {
        y: root.header-row;
        height: parent.height - root.header-row;
        clip: true;
        // Page dessous assombrie le temps de l'ouverture.
        Rectangle {
            y: -root.header-row;
            height: root.height;
            background: Theme.bg.transparentize(1 - 0.55 * root.door-move * (1 - root.door-fly));
        }
        // Carte entière, de sa place vers le centre (puis les deux battants prennent le relais).
        property <length> cx: root.hero-fx + (root.door-x - root.hero-fx) * root.door-move;
        property <length> cy: root.hero-fy + (root.door-y - root.hero-fy) * root.door-move - root.header-row;
        property <length> cw: root.hero-fw + (root.door-w - root.hero-fw) * root.door-move;
        property <length> ch: root.hero-fh + (root.door-h - root.hero-fh) * root.door-move;
        // Affiche : sort du centre de la carte, puis vole vers sa place sur la fiche.
        property <bool> poster-ok: root.screen == "detail" && root.detail.id == root.hero-id && root.detail.has-poster;
        property <length> ph0: self.ch * 1.15;
        property <length> pw0: self.ph0 / 1.5;
        property <float> ps: 0.7 + 0.3 * root.door-open;
        property <length> pw: (self.pw0 * self.ps) + (root.hero-tw - self.pw0 * self.ps) * root.door-fly;
        property <length> ph: (self.ph0 * self.ps) + (root.hero-th - self.ph0 * self.ps) * root.door-fly;
        if root.door-open > 0.01: Rectangle {
            x: (parent.cx + parent.cw / 2 - parent.pw / 2) + (root.hero-tx - (parent.cx + parent.cw / 2 - parent.pw / 2)) * root.door-fly;
            y: (parent.cy + parent.ch / 2 - parent.ph / 2) + (root.hero-ty - root.header-row - (parent.cy + parent.ch / 2 - parent.ph / 2)) * root.door-fly;
            width: parent.pw;
            height: parent.ph;
            opacity: min(1, root.door-open * 1.6);
            border-radius: Theme.radius;
            clip: true;
            drop-shadow-blur: Nav.no-shadow ? 0px : 24px * root.k * (1 - root.door-fly);
            drop-shadow-color: #00000099;
            if parent.poster-ok: Image {
                width: parent.width;
                height: parent.height;
                source: root.detail.poster;
                image-fit: fill;
            }
            if !parent.poster-ok: Placeholder {
                title: root.hero-data.title;
                k: root.k;
                border-radius: Theme.radius;
            }
        }
        // Deux battants : chacun garde sa moitié de l'image et se replie vers son bord (comme une
        // porte vue de face), en s'assombrissant ; ils sont devant l'affiche, qui sort entre eux.
        for side[i] in [0, 1]: Rectangle {
            property <length> half: parent.cw / 2;
            property <length> w: self.half * (1 - root.door-open);
            x: i == 0 ? parent.cx : parent.cx + parent.cw - self.w;
            y: parent.cy + parent.ch * 0.04 * root.door-open;
            width: self.w;
            height: parent.ch * (1 - 0.08 * root.door-open);
            visible: root.door-open < 0.995;
            border-top-left-radius: i == 0 ? Theme.radius : 0px;
            border-bottom-left-radius: i == 0 ? Theme.radius : 0px;
            border-top-right-radius: i == 1 ? Theme.radius : 0px;
            border-bottom-right-radius: i == 1 ? Theme.radius : 0px;
            clip: true;
            Image {
                // La moitié de l'image, écrasée vers le gond.
                width: parent.width;
                height: parent.height;
                source: root.hero-img;
                source-clip-x: i == 0 ? 0 : root.hero-img.width / 2;
                source-clip-width: root.hero-img.width / 2;
                image-fit: fill;
            }
            Rectangle {
                background: #000000.transparentize(1 - 0.6 * root.door-open);
            }
        }
    }

    // Vidéo en cours sur un écran de diffusion (lecteur quitté) : bandeau en bas pour y revenir.
    if root.cast-on && root.cast-now != "" && !root.playing && root.signed-in: Rectangle {
        width: min(parent.width - 32px * root.k, cb-row.preferred-width + 36px * root.k);
        height: 52px * root.k;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 16px * root.k - max(root.safe-area-insets.bottom, Nav.phone && root.height > root.width ? 48px : 0px);
        border-radius: self.height / 2;
        background: @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%);
        cb-row := HorizontalLayout {
            x: 18px * root.k;
            width: parent.width - 36px * root.k;
            spacing: 10px * root.k;
            Text {
                text: "▶";
                color: Theme.on-accent;
                font-size: 15px * root.k;
                vertical-alignment: center;
            }
            Text {
                text: Tr.f(Tr.k, "En lecture sur {}", root.cast-target, "") + " · " + root.cast-now;
                color: Theme.on-accent;
                font-size: 15px * root.k;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        TouchArea {
            clicked => {
                root.cast-reopen();
            }
        }
    }

    // Message d'état : bulle en bas, au-dessus du contenu, effacée après 6 s.
    property <bool> toast-on;
    changed toast => {
        root.toast-on = root.toast != "";
        // Nouveau message pendant qu'un autre est affiché : il a droit à ses 6 s.
        if (root.toast-on) {
            toast-timer.restart();
        }
    }
    toast-timer := Timer {
        interval: 6s;
        running: root.toast-on;
        triggered => {
            root.toast-on = false;
        }
    }
    if root.toast-on && root.screen != "login": Rectangle {
        x: (parent.width - self.width) / 2;
        // Pendant la lecture : en haut (les commandes sont en bas).
        // Android : au-dessus de la barre de navigation (boutons du système dessinés sur l'appli).
        y: root.playing ? 24px * root.k + root.safe-area-insets.top : parent.height - self.height - 24px * root.k - max(root.safe-area-insets.bottom, Nav.phone && root.height > root.width ? 48px : 0px);
        width: min(parent.width - 64px * root.k, toast-text.preferred-width + 40px * root.k);
        height: toast-text.preferred-height + 20px * root.k;
        border-radius: 12px * root.k;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.glass-border;
        Gloss { r: parent.border-radius; strength: 0.45; }
        toast-text := Text {
            x: 20px * root.k;
            width: parent.width - 40px * root.k;
            text: root.toast;
            color: Theme.text;
            font-size: 15px * root.k;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ------------------------------------------------------------ Visite guidée
    // L'utilisateur navigue lui-même : chaque étape demande un geste (→, ↓, ↑, ouvrir le menu, une
    // fiche...) et passe à la suivante quand il est fait (tour-ev, appelé par les `changed` des
    // propriétés de navigation). Pendant ces étapes (tour-act), les touches vont à l'app ; Échap
    // quitte la visite là où il ne sert pas au geste demandé. Bienvenue, lecture et fin : bulle avec
    // boutons (← → choisissent, OK active). Étapes : 0 bienvenue · 1 parcourir une rangée ·
    // 2 changer de rangée · 3 monter aux onglets · 4 barre du haut · 5 ouvrir le menu · 6 le menu ·
    // 7 ouvrir une fiche · 8 revenir · 9 lecture (schéma) · 10 fin.
    in-out property <int> tour-step: -1;
    property <int> tour-count: 11;
    property <float> tour-p: root.tour-step >= 0 ? 1 : 0;
    animate tour-p { duration: Motion.tour ? 300ms : 0ms; easing: ease-out; }
    property <int> tour-last: 0;
    property <bool> tour-act: root.tour-step >= 1 && root.tour-step <= 8;
    // Visite affichée et étape à boutons : elle garde le clavier.
    property <bool> tour-lock: root.tour-step >= 0 && !root.tour-act;
    // Échap / Retour quittent la visite (étapes où ils ne servent pas au geste demandé).
    property <bool> tour-esc: (root.tour-step >= 1 && root.tour-step <= 4) || root.tour-step == 7;
    // Pendant la visite, OK n'ouvre rien sur l'accueil, sauf à l'étape « ouvrir un média » et le
    // bouton menu à l'étape « ouvrir le menu » (sinon on quitterait l'accueil en pleine visite).
    property <bool> tour-no-ok: (root.tour-step >= 1 && root.tour-step <= 6 && root.tour-step != 5)
        || (root.tour-step == 5 && !(root.h-focus && root.h-sel == root.nav-n - 1));
    // Gestes possibles avec ce qu'affiche l'accueil (une seule affiche, une seule rangée, rien).
    property <int> tour-cards: root.sections.length == 0 ? 0 : root.sections.length > 1 ? 2 : root.sections[0].items.length;
    // Bouton choisi au clavier : 0 retour · 1 passer la visite · 2 suivant.
    property <int> tour-btn: 2;
    // Gestes déjà faits dans l'étape (→ de l'étape 1, icônes de l'étape 4).
    property <int> tour-n: 0;
    // Geste réussi : coche verte un instant avant l'étape suivante.
    property <bool> tour-ok;
    function tour-press(b: int) {
        if (b == 0) {
            // Depuis la lecture : retour à « Ouvrir un média » (l'étape « Revenir » se saute sur l'accueil).
            root.tour-step = root.tour-last == 9 ? 7 : max(0, root.tour-last - 1);
        } else if (b == 1) {
            root.tour-step = -1;
        } else {
            root.tour-step = root.tour-last < root.tour-count - 1 ? root.tour-last + 1 : -1;
        }
    }
    function tour-done() {
        if (!root.tour-ok) {
            root.tour-ok = true;
        }
    }
    // kind : 1 sel-item · 2 sel-section · 3 h-focus · 4 h-sel · 5 menu-open · 6 screen.
    function tour-ev(kind: int) {
        if (!root.tour-act || root.tour-ok) {
            return;
        }
        // Accueil quitté (clic, raccourci) pendant les étapes qui s'y déroulent : fin de la visite.
        if (kind == 6 && root.tour-step <= 6 && root.screen != "home") {
            root.tour-step = -1;
            return;
        }
        if (root.tour-step == 1 && (kind == 1 || kind == 2)) {
            root.tour-n += 1;
            if (root.tour-n >= 2) {
                root.tour-done();
            }
        } else if (root.tour-step == 2 && kind == 2) {
            root.tour-done();
        } else if (root.tour-step == 3 && kind == 3 && root.h-focus) {
            root.tour-done();
        } else if (root.tour-step == 4 && kind == 4 && root.h-sel >= root.right-base + (root.offline ? 0 : 4)) {
            // Arrivé au profil, tout à droite.
            root.tour-done();
        } else if (root.tour-step == 4 && kind == 3 && !root.h-focus) {
            root.tour-done();
        } else if (root.tour-step == 5 && kind == 5 && root.menu-open) {
            root.tour-done();
        } else if (root.tour-step == 6 && kind == 5 && !root.menu-open) {
            root.tour-done();
        } else if (root.tour-step == 7 && kind == 6 && (root.screen == "detail" || root.screen == "library")) {
            root.tour-done();
        } else if (root.tour-step == 8 && kind == 6 && root.screen == "home") {
            root.tour-done();
        }
    }
    Timer {
        interval: 650ms;
        running: root.tour-ok;
        triggered => {
            root.tour-ok = false;
            root.tour-step = root.tour-step + 1;
        }
    }
    changed sel-section => {
        root.tour-ev(2);
    }
    changed h-focus => {
        root.tour-ev(3);
    }
    changed h-sel => {
        root.tour-ev(4);
    }
    changed menu-open => {
        root.tour-ev(5);
    }
    // Arrivée de la bulle à chaque étape (voir tour-box).
    property <bool> tour-fresh;
    property <duration> tour-t0;
    Timer {
        interval: 300ms;
        running: root.tour-fresh;
        triggered => {
            root.tour-fresh = false;
        }
    }
    changed tour-step => {
        root.tour-ok = false;
        root.tour-n = 0;
        root.tour-t0 = animation-tick();
        root.tour-fresh = true;
        if (root.tour-step >= 0) {
            root.tour-last = root.tour-step;
            root.tour-btn = 2;
            if (root.tour-act) {
                // Les touches retournent à la page (ou au menu ouvert).
                root.refocus += 1;
            }
            // Geste impossible ici (une seule affiche, une seule rangée, aucun média, pas de page
            // ouverte) : l'étape est sautée.
            if ((root.tour-step == 1 && root.tour-cards < 2) || (root.tour-step == 2 && root.sections.length < 2)
                    || (root.tour-step == 7 && root.sections.length == 0) || (root.tour-step == 8 && root.screen == "home")) {
                root.tour-step += 1;
            } else {
                // Pendant la coche verte (0,65 s), les touches agissent toujours : l'étape trouve
                // peut-être l'interface déjà changée. Elle la remet dans l'état attendu, ou se valide
                // toute seule si son geste est déjà fait.
                if (root.tour-step == 4 && !root.h-focus) {
                    root.h-focus = true;
                    root.h-sel = root.nav-n;
                } else if (root.tour-step == 6 && !root.menu-open) {
                    root.open-menu();
                } else if (root.tour-step == 7 && root.menu-open) {
                    root.close-menu();
                }
                if ((root.tour-step == 3 && root.h-focus) || (root.tour-step == 5 && root.menu-open)
                        || (root.tour-step == 7 && root.screen != "home")) {
                    root.tour-done();
                }
                if (root.tour-step == 1 || root.tour-step == 2) {
                    // Rangées : menu fermé, sélection dans les affiches.
                    root.menu-open = false;
                    root.h-focus = false;
                }
            }
        } else {
            root.refocus += 1;
        }
    }
    // Zone éclairée de chaque étape (x, y, largeur, hauteur) ; largeur 0 : aucune.
    property <length> tour-row-h: root.sections.length > 0 ? root.sections[0].h-px * 1px : 300px * root.k;
    property <length> menu-w: 340px * root.k;
    // Position réelle des onglets et des icônes de droite, relevée dans l'en-tête de l'accueil.
    in-out property <length> tabs-x: root.width * 0.35;
    in-out property <length> tabs-w: root.width * 0.25;
    in-out property <length> right-w: 330px * root.k;
    property <length> hx: root.tour-last == 1 ? 6px * root.k : root.tour-last == 3 || root.tour-last == 4 ? 4px * root.k
        : root.tour-last == 6 ? 4px * root.k : 0px;
    property <length> hy: root.tour-last == 1 ? root.header-h - 4px * root.k : root.tour-last == 3 || root.tour-last == 4 ? 4px * root.k
        : root.tour-last == 6 ? 4px * root.k : 0px;
    property <length> hw: root.tour-last == 1 ? 0px : root.tour-last == 3 || root.tour-last == 4 ? root.width - 8px * root.k
        : root.tour-last == 6 ? root.menu-w : 0px;
    property <length> hh: root.tour-last == 1 ? 0px : root.tour-last == 3 || root.tour-last == 4 ? root.header-h - 8px * root.k
        : root.tour-last == 6 ? root.height - 8px * root.k : 0px;
    animate hx, hy, hw, hh { duration: Motion.tour ? 380ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    // Voile : sombre pour les étapes à boutons et celles qui éclairent une zone ; léger sinon (la page
    // reste lisible pendant qu'on y navigue).
    property <color> tour-veil: root.tour-last == 1 || root.tour-last == 2 || root.tour-last == 5 || root.tour-last == 7 || root.tour-last == 8 ? Theme.scrim.with-alpha(0.25) : Theme.scrim.with-alpha(0.72);
    animate tour-veil { duration: Motion.tour ? 300ms : 0ms; }

    if root.tour-p > 0.01 && !root.playing: Rectangle {
        opacity: root.tour-p;
        // Étapes à boutons : la page dessous ne prend pas les clics.
        if root.tour-lock: TouchArea {
            // La molette ne fait pas défiler la page dessous.
            scroll-event(e) => {
                return EventResult.accept;
            }
        }
        // Voile autour de la zone éclairée (quatre bandes).
        Rectangle { x: 0px; y: 0px; width: parent.width; height: root.hy; background: root.tour-veil; }
        Rectangle { x: 0px; y: root.hy + root.hh; width: parent.width; height: max(0px, parent.height - root.hy - root.hh); background: root.tour-veil; }
        Rectangle { x: 0px; y: root.hy; width: root.hx; height: root.hh; background: root.tour-veil; }
        Rectangle { x: root.hx + root.hw; y: root.hy; width: max(0px, parent.width - root.hx - root.hw); height: root.hh; background: root.tour-veil; }
        if root.hw > 1px: Rectangle {
            x: root.hx;
            y: root.hy;
            width: root.hw;
            height: root.hh;
            border-radius: 14px * root.k;
            border-width: 3px * root.k;
            border-color: Theme.accent2;
        }

        tour-box := Rectangle {
            // Placement : sous l'en-tête (barre du haut), à droite du menu, en bas à droite pendant
            // qu'on navigue dans la page, sinon au centre.
            property <bool> below: root.tour-last == 3 || root.tour-last == 4;
            property <bool> corner: root.tour-last == 1 || root.tour-last == 2 || root.tour-last == 5 || root.tour-last == 7 || root.tour-last == 8;
            property <length> art-h: root.tour-last == 0 ? 190px * root.k : root.tour-last == 4 ? 210px * root.k
                : root.tour-last == 9 ? 170px * root.k : 0px;
            property <bool> buttons: !root.tour-act;
            width: min((root.tour-last == 6 ? parent.width - root.menu-w : parent.width) - 80px * root.k, (self.corner ? 480px : 620px) * root.k);
            height: (self.buttons ? 150px : 118px) * root.k + self.art-h + tour-body.preferred-height;
            x: root.tour-last == 6 ? root.menu-w + (parent.width - root.menu-w - self.width) / 2
                : self.corner ? parent.width - self.width - 30px * root.k : (parent.width - self.width) / 2;
            y: self.below ? root.header-h + 30px * root.k
                : self.corner ? parent.height - self.height - 30px * root.k
                : root.tour-last == 1 ? min(parent.height - self.height - 30px * root.k, root.header-h + root.tour-row-h + 30px * root.k)
                : (parent.height - self.height) / 2;
            // Nouvelle étape : la bulle apparaît à sa place (fondu, léger zoom) au lieu de
            // glisser depuis celle de l'étape d'avant.
            animate height { duration: Motion.tour ? 380ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
            property <float> fresh: root.tour-fresh && Motion.tour ? clamp((animation-tick() - root.tour-t0) / 240ms, 0, 1) : 1;
            opacity: self.fresh;
            transform-scale: 0.96 + 0.04 * self.fresh;
            border-radius: 20px * root.k;
            background: Theme.panel;
            border-width: root.tour-ok ? 2px * root.k : 1px;
            border-color: root.tour-ok ? Theme.ok : Theme.glass-border;
            Gloss { r: parent.border-radius; strength: 0.45; }

            Text {
                x: 28px * root.k;
                y: 22px * root.k;
                width: parent.width - 100px * root.k;
                text: root.tour-last == 0 ? Tr.t(Tr.k, "Bienvenue dans Turtlefin") : root.tour-last == 1 ? Tr.t(Tr.k, "Les rangées")
                    : root.tour-last == 2 ? Tr.t(Tr.k, "Changer de rangée") : root.tour-last == 3 ? Tr.t(Tr.k, "Les onglets")
                    : root.tour-last == 4 ? Tr.t(Tr.k, "La barre du haut") : root.tour-last == 5 ? Tr.t(Tr.k, "Le menu")
                    : root.tour-last == 6 ? Tr.t(Tr.k, "Dans le menu") : root.tour-last == 7 ? Tr.t(Tr.k, "Ouvrir un média")
                    : root.tour-last == 8 ? Tr.t(Tr.k, "Revenir") : root.tour-last == 9 ? Tr.t(Tr.k, "Pendant la lecture")
                    : Tr.t(Tr.k, "C'est parti !");
                color: Theme.fg;
                font-size: 24px * root.k;
                font-weight: 700;
                wrap: word-wrap;
            }
            // Geste réussi.
            Rectangle {
                x: parent.width - self.width - 22px * root.k;
                y: 20px * root.k;
                width: 34px * root.k;
                height: self.width;
                border-radius: self.width / 2;
                background: #4ade80;
                opacity: root.tour-ok ? 1 : 0;
                animate opacity { duration: Motion.tour ? 160ms : 0ms; }
                Path {
                    width: 18px * root.k;
                    height: 18px * root.k;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    fill: transparent;
                    stroke: #0b1520;
                    stroke-width: 2.6px * root.k;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    commands: "M 2.5 8.5 L 6.5 12.5 L 13.5 3.5";
                }
            }
            tour-body := Text {
                x: 28px * root.k;
                y: 66px * root.k;
                width: parent.width - 56px * root.k;
                wrap: word-wrap;
                text: root.tour-last == 0 ? Tr.t(Tr.k, "Cette visite te fait essayer l'app. Tout se fait avec la télécommande : les flèches pour se déplacer, OK pour ouvrir ou valider, Retour pour revenir en arrière.")
                    : root.tour-last == 1 ? Tr.t(Tr.k, "Essaie : déplace-toi deux fois avec les flèches, ← → dans une rangée, ↑ ↓ d'une rangée à l'autre.")
                    : root.tour-last == 2 ? Tr.t(Tr.k, "Change de rangée avec ↓ ou ↑.")
                    : root.tour-last == 3 ? Tr.t(Tr.k, "Appuie sur ↑ jusqu'à monter dans la barre du haut.")
                    : root.tour-last == 4 ? Tr.t(Tr.k, "Parcours-la avec → jusqu'à ton profil, tout à droite : les onglets Accueil, Favoris et Demandes, puis ces icônes.")
                    : root.tour-last == 5 ? Tr.t(Tr.k, "Ouvre le menu : dans la barre du haut, va tout à gauche sur ≡ et appuie sur OK ; depuis les affiches, ← au début d'une rangée (ou Retour).")
                    : root.tour-last == 6 ? Tr.t(Tr.k, "Bibliothèques, téléchargements (à regarder sans connexion), watch party, compte, serveur et Paramètres. Parcours-le avec ↑ ↓, puis referme-le avec →.")
                    : root.tour-last == 7 ? Tr.t(Tr.k, "Choisis une affiche et appuie sur OK pour l'ouvrir.")
                    : root.tour-last == 8 ? Tr.t(Tr.k, "Une fiche (film, série) ou une bibliothèque entière : tout se parcourt de la même façon. Appuie sur Retour pour revenir à l'accueil.")
                    : root.tour-last == 9 ? Tr.t(Tr.k, "← → : 10 s en arrière ou en avant. OK ou ↓ : les commandes (pause, volume, audio, sous-titres) ; ↓ encore : les épisodes de la saison. Retour : arrêter la lecture.")
                    : Tr.t(Tr.k, "Langue, sous-titres, interface TV… tout se règle dans le menu, Paramètres. Cette visite se relance depuis Paramètres → À propos.");
                color: Theme.fg.with-alpha(0.85);
                font-size: 17px * root.k;
            }

            // Télécommande : croix (flèches) avec OK au centre, et le bouton Retour ; les touches
            // s'allument l'une après l'autre.
            if root.tour-last == 0: Rectangle {
                x: 28px * root.k;
                y: tour-body.y + tour-body.preferred-height + 14px * root.k;
                width: parent.width - 56px * root.k;
                height: 176px * root.k;
                property <int> lit: mod(floor(animation-tick() / 700ms), 6); // 0 haut 1 droite 2 bas 3 gauche 4 OK 5 retour
                property <length> d: 118px * root.k;
                property <length> cx: self.width / 2 - 50px * root.k;
                pad := Rectangle {
                    x: parent.cx - parent.d / 2;
                    y: 0px;
                    width: parent.d;
                    height: parent.d;
                    border-radius: self.width / 2;
                    background: Theme.fg.with-alpha(0.07);
                    border-width: 1px;
                    border-color: Theme.fg.with-alpha(0.15);
                    property <int> lit: parent.lit;
                    for a[i] in ["↑", "→", "↓", "←"]: Text {
                        property <length> r: pad.width / 2 - 17px * root.k;
                        x: pad.width / 2 - 12px * root.k + (i == 1 ? self.r : i == 3 ? -self.r : 0px);
                        y: pad.height / 2 - 14px * root.k + (i == 0 ? -self.r : i == 2 ? self.r : 0px);
                        width: 24px * root.k;
                        height: 28px * root.k;
                        text: a;
                        color: pad.lit == i ? Theme.accent2 : Theme.fg.with-alpha(0.69);
                        font-size: (pad.lit == i ? 24px : 20px) * root.k;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 46px * root.k;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: pad.lit == 4 ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : Theme.fg.with-alpha(0.15);
                        Gloss { r: parent.border-radius; strength: 0.8; }
                        Text { text: "OK"; color: pad.lit == 4 ? Theme.on-accent : Theme.fg; font-size: 15px * root.k; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    x: parent.cx + parent.d / 2 + 40px * root.k;
                    y: (parent.d - self.height) / 2;
                    width: 52px * root.k;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: parent.lit == 5 ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : Theme.fg.with-alpha(0.15);
                    Gloss { r: parent.border-radius; strength: 0.8; }
                    Path {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 24px * root.k;
                        height: 24px * root.k;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: transparent;
                        stroke: Theme.fg;
                        stroke-width: 2.4px * root.k;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                        commands: "M 9 5 L 4 10 L 9 15 M 4 10 L 14 10 C 18 10 20 12.5 20 15.5 C 20 18.5 18 20 15 20 L 12 20";
                    }
                }
                Text {
                    x: parent.cx - 80px * root.k;
                    y: parent.d + 4px * root.k;
                    width: 160px * root.k;
                    text: Tr.t(Tr.k, "Flèches et OK");
                    color: Theme.fg.with-alpha(0.63);
                    font-size: 13px * root.k;
                    horizontal-alignment: center;
                }
                Text {
                    x: parent.cx + parent.d / 2 + 66px * root.k - 60px * root.k;
                    y: parent.d / 2 + 30px * root.k;
                    width: 120px * root.k;
                    text: Tr.t(Tr.k, "Retour");
                    color: Theme.fg.with-alpha(0.63);
                    font-size: 13px * root.k;
                    horizontal-alignment: center;
                }
                Text {
                    y: parent.height - self.preferred-height;
                    width: parent.width;
                    wrap: word-wrap;
                    text: Tr.t(Tr.k, "Au clavier : Entrée = OK, Échap = Retour. La souris et le tactile marchent aussi.");
                    color: Theme.fg.with-alpha(0.5);
                    font-size: 13px * root.k;
                    horizontal-alignment: center;
                }
            }

            // Icônes du haut : les mêmes qu'à l'écran, celle sélectionnée en ce moment s'allume.
            if root.tour-last == 4: VerticalLayout {
                x: 28px * root.k;
                y: tour-body.y + tour-body.preferred-height + 12px * root.k;
                width: parent.width - 56px * root.k;
                spacing: 6px * root.k;
                for it[i] in [
                    { icon: "party", text: Tr.t(Tr.k, "Watch party : regarder la même chose, en même temps, sur plusieurs appareils.") },
                    { icon: "dice", text: Tr.t(Tr.k, "Au hasard : Turtlefin choisit un média pour toi.") },
                    { icon: "search", text: Tr.t(Tr.k, "Recherche : dans ta bibliothèque, et de quoi demander ce qui manque.") },
                    { icon: "profile", text: Tr.t(Tr.k, "Ton profil : changer de compte ou de photo.") },
                ]: HorizontalLayout {
                    spacing: 14px * root.k;
                    property <bool> on: root.h-focus && root.h-sel == root.right-base + i;
                    HeaderIcon {
                        icon: it.icon;
                        k: root.k;
                        focused: parent.on;
                    }
                    Text {
                        text: it.text;
                        wrap: word-wrap;
                        color: parent.on ? Theme.fg : Theme.fg.with-alpha(0.66);
                        font-size: 15px * root.k;
                        vertical-alignment: center;
                    }
                }
            }

            // Schéma du lecteur : panneau (barre + boutons) et, dessous, les épisodes qui montent.
            if root.tour-last == 9: Rectangle {
                x: 28px * root.k;
                y: tour-body.y + tour-body.preferred-height + 16px * root.k;
                width: parent.width - 56px * root.k;
                height: 150px * root.k;
                border-radius: 12px * root.k;
                background: Theme.scrim;
                clip: true;
                property <float> t: mod(animation-tick() / 1ms, 2400) / 2400;
                property <float> up: self.t < 0.4 ? 0 : self.t < 0.6 ? (self.t - 0.4) / 0.2 : self.t < 0.9 ? 1 : 1 - (self.t - 0.9) / 0.1;
                Rectangle {
                    x: 14px * root.k;
                    y: 40px * root.k - parent.up * 44px * root.k;
                    width: parent.width - 28px * root.k;
                    height: 66px * root.k;
                    border-radius: 10px * root.k;
                    background: Theme.fg.with-alpha(0.1);
                    Rectangle {
                        x: 14px * root.k;
                        y: 14px * root.k;
                        width: parent.width - 28px * root.k;
                        height: 5px * root.k;
                        border-radius: 3px * root.k;
                        background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
                    }
                    for b[i] in 5: Rectangle {
                        x: parent.width / 2 - 75px * root.k + i * 32px * root.k;
                        y: 32px * root.k;
                        width: 24px * root.k;
                        height: 24px * root.k;
                        border-radius: 12px * root.k;
                        background: i == 2 ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : Theme.fg.with-alpha(0.15);
                        Gloss { r: parent.border-radius; strength: 0.8; }
                    }
                }
                for e[i] in 4: Rectangle {
                    x: 14px * root.k + i * ((parent.width - 28px * root.k) / 4);
                    y: parent.height + 6px * root.k - parent.up * 50px * root.k;
                    width: (parent.width - 28px * root.k) / 4 - 10px * root.k;
                    height: 40px * root.k;
                    border-radius: 6px * root.k;
                    background: i == 1 ? Theme.accent2 : Theme.fg.with-alpha(0.2);
                }
                Text {
                    x: parent.width - 60px * root.k;
                    y: 112px * root.k - parent.up * 30px * root.k;
                    text: "↓";
                    color: Theme.accent2;
                    font-size: 26px * root.k;
                    font-weight: 700;
                    opacity: 1 - parent.up;
                }
            }

            // Points d'avancement.
            for d[i] in root.tour-count: Rectangle {
                x: 28px * root.k + i * 14px * root.k;
                y: parent.height - (parent.buttons ? 40px : 30px) * root.k;
                width: (i == root.tour-last ? 20px : 7px) * root.k;
                animate width { duration: Motion.tour ? 220ms : 0ms; }
                height: 7px * root.k;
                border-radius: 4px * root.k;
                background: i == root.tour-last ? Theme.accent2 : i < root.tour-last ? Theme.fg.with-alpha(0.5) : Theme.fg.with-alpha(0.19);
            }
            // Étapes où l'on navigue : comment quitter.
            if root.tour-act: Text {
                x: parent.width - self.width - 24px * root.k;
                y: parent.height - 38px * root.k;
                height: 24px * root.k;
                text: root.tour-esc ? Tr.t(Tr.k, "Retour : quitter la visite") : "";
                color: Theme.fg.with-alpha(0.5);
                font-size: 13px * root.k;
                vertical-alignment: center;
            }
            // Boutons (le bouton choisi prend le dégradé, comme partout).
            if tour-box.buttons: HorizontalLayout {
                x: parent.width - self.preferred-width - 24px * root.k;
                y: parent.height - 58px * root.k;
                height: 40px * root.k;
                spacing: 10px * root.k;
                for b in [0, 1, 2]: Rectangle {
                    property <bool> shown: b == 0 ? root.tour-last > 0 : b == 1 ? root.tour-last < root.tour-count - 1 : true;
                    property <bool> on: root.tour-btn == b;
                    visible: self.shown;
                    width: self.shown ? b-t.preferred-width + 34px * root.k : 0px;
                    border-radius: 10px * root.k;
                    background: self.on ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%)
                        : (b-a.has-hover && !Nav.kb && !Nav.touch) ? Theme.fg.with-alpha(0.15) : Theme.fg.with-alpha(0.07);
                    Gloss { r: parent.border-radius; strength: 0.8; }
                    b-t := Text {
                        text: b == 0 ? Tr.t(Tr.k, "Retour") : b == 1 ? Tr.t(Tr.k, "Passer la visite")
                            : root.tour-last == 0 ? Tr.t(Tr.k, "Commencer")
                            : root.tour-last < root.tour-count - 1 ? Tr.t(Tr.k, "Suivant") : Tr.t(Tr.k, "Terminer");
                        color: parent.on ? Theme.on-accent : Theme.fg.with-alpha(0.8);
                        font-size: 15px * root.k;
                        font-weight: parent.on ? 700 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    b-a := TouchArea {
                        clicked => {
                            root.tour-press(b);
                        }
                    }
                }
            }
        }

        tour-fs := FocusScope {
            property <bool> lock: root.tour-lock;
            property <int> st: root.tour-step;
            changed st => {
                if (root.tour-lock) {
                    self.focus();
                }
            }
            init => {
                if (root.tour-lock) {
                    self.focus();
                }
            }
            key-pressed(event) => {
                if (!root.tour-lock) {
                    return EventResult.reject;
                }
                if (event.repeat) {
                    return EventResult.accept;
                }
                // ← → choisissent un bouton (retour, passer, suivant), OK l'active.
                if (event.text == Key.Return || event.text == " ") {
                    root.tour-press(root.tour-btn);
                } else if (event.text == Key.RightArrow) {
                    root.tour-btn = root.tour-btn == 0 && root.tour-last < root.tour-count - 1 ? 1 : 2;
                } else if (event.text == Key.LeftArrow) {
                    root.tour-btn = root.tour-btn == 2 && root.tour-last < root.tour-count - 1 ? 1
                        : root.tour-last > 0 ? 0 : root.tour-btn;
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.tour-step = -1;
                }
                return EventResult.accept;
            }
        }
    }

    // ------------------------------------------------------------ Ajouter une langue
    // Explorateur du dossier des langues (ui/langx.slint, géré en Rust : lx_* dans main.rs).
    in-out property <bool> lx-open;
    in property <string> lx-place;
    in property <string> lx-hint;
    in property <[LxItem]> lx-items;
    in property <bool> lx-can-folder;
    in property <bool> lx-can-template: true;
    in property <string> lx-title;
    in property <int> lx-tick;
    in-out property <int> lx-sel;
    callback lx-activate(int);
    callback lx-back();
    callback lx-button(string);
    changed lx-open => {
        if (!root.lx-open) {
            root.refocus += 1;
        }
    }
    LangExplorer {
        k: root.k;
        open: root.lx-open;
        place: root.lx-place;
        hint: root.lx-hint;
        items: root.lx-items;
        can-open-folder: root.lx-can-folder;
        can-template: root.lx-can-template;
        title: root.lx-title;
        tick: root.lx-tick;
        sel <=> root.lx-sel;
        activate(i) => {
            root.lx-activate(i);
        }
        back => {
            root.lx-back();
        }
        button(b) => {
            root.lx-button(b);
        }
    }

    // ------------------------------------------------------------ Connexion : la photo du compte
    // 1 : la photo du compte choisi quitte sa tuile pour le centre (élastique), le reste s'efface ;
    // 2 : elle y attend la connexion, une barre de chargement en dessous ;
    // 3 : connecté : elle part au loin (léger élan puis dézoom), sur un fond qui cache l'accueil ;
    // 4 : le fond s'efface, l'accueil arrive et l'avatar en haut à droite apparaît en zoomant
    //     (élastique) ;
    // 0 : rien (échec de la connexion : la page « Qui regarde ? » revient).
    in-out property <int> fly-phase;
    in-out property <image> fly-img;
    in-out property <bool> fly-has-img;
    in-out property <string> fly-letter;
    in-out property <length> fly-sx;
    in-out property <length> fly-sy;
    in-out property <length> fly-ss;
    property <duration> fly-t0;
    function fly-start(phase: int) {
        root.fly-phase = phase;
        root.fly-t0 = animation-tick();
    }
    // Connexion automatique : la photo apparaît directement au centre (pas de tuile d'où partir).
    public function fly-wait() {
        root.fly-ss = root.fly-cs;
        root.fly-sx = root.fly-cx;
        root.fly-sy = root.fly-cy;
        root.fly-start(2);
    }
    Timer {
        interval: 480ms;
        running: root.fly-phase == 1;
        triggered => {
            root.fly-phase = 2;
        }
    }
    Timer {
        interval: 460ms;
        running: root.fly-phase == 3;
        triggered => {
            root.fly-start(4);
            root.page-enter();
        }
    }
    Timer {
        interval: 760ms;
        running: root.fly-phase == 4;
        triggered => {
            root.fly-phase = 0;
        }
    }
    // Échec (formulaire de mot de passe, erreur) : la photo disparaît, la page revient.
    property <string> fly-err: root.error-text;
    changed fly-err => {
        if ((root.fly-phase == 1 || root.fly-phase == 2) && root.error-text != "") {
            root.fly-phase = 0;
        }
    }
    property <string> fly-mode: root.login-mode;
    changed fly-mode => {
        if ((root.fly-phase == 1 || root.fly-phase == 2) && root.login-mode == "form") {
            root.fly-phase = 0;
        }
    }
    // Avatar en haut à droite : apparition élastique (phase 4), caché avant.
    property <float> fly-pq: root.fly-phase == 4 ? clamp((animation-tick() - root.fly-t0) / 700ms, 0, 1) : 1;
    out property <float> me-pop: root.fly-phase == 3 ? 0
        : root.fly-pq >= 1 ? 1 : 1 - pow(2, -9 * root.fly-pq) * cos(root.fly-pq * 440deg);
    property <length> fly-cs: 190px * root.k;
    property <length> fly-cx: (root.width - self.fly-cs) / 2;
    property <length> fly-cy: (root.height - self.fly-cs) / 2 - 20px * root.k;
    if root.fly-phase > 0: Rectangle {
        property <float> t: (animation-tick() - root.fly-t0) / 1ms;
        // Fond : cache l'écran de chargement puis l'accueil jusqu'à la fin du départ de la photo.
        Rectangle {
            background: @linear-gradient(180deg, Theme.bg 0%, Theme.bg-mid 55%, Theme.bg-end 100%);
            opacity: root.fly-phase < 4 ? 1 : 1 - clamp(parent.t / 300, 0, 1);
            TouchArea {
                // La molette ne fait pas défiler la page dessous.
                scroll-event(e) => {
                    return EventResult.accept;
                }
            }
        }
        // Phase 1 : vers le centre (élastique).
        property <float> a: root.fly-phase == 1 ? clamp(self.t / 460, 0, 1) : 1;
        property <float> ae: 1 - pow(2, -9 * self.a) * cos(self.a * 330deg * 1.35);
        // Phase 3 : petit élan, puis la photo part au loin (rétrécit et s'efface).
        property <float> v: root.fly-phase == 3 ? clamp(self.t / 440, 0, 1) : root.fly-phase == 4 ? 1 : 0;
        property <float> vs: self.v < 0.25 ? 1 + 0.12 * self.v / 0.25 : 1.12 * (1 - pow((self.v - 0.25) / 0.75, 2));
        property <length> s: (root.fly-ss + (root.fly-cs - root.fly-ss) * self.ae) * (root.fly-phase >= 3 ? self.vs : 1);
        property <length> cx: (root.fly-sx + root.fly-ss / 2) + ((root.fly-cx + root.fly-cs / 2) - (root.fly-sx + root.fly-ss / 2)) * self.ae;
        property <length> cy: (root.fly-sy + root.fly-ss / 2) + ((root.fly-cy + root.fly-cs / 2) - (root.fly-sy + root.fly-ss / 2)) * self.ae;
        if root.fly-phase < 4: Rectangle {
            x: parent.cx - parent.s / 2;
            y: parent.cy - parent.s / 2;
            width: max(0px, parent.s);
            height: self.width;
            opacity: root.fly-phase == 3 ? 1 - clamp((parent.v - 0.25) / 0.75, 0, 1) : 1;
            border-radius: self.width / 2;
            background: @linear-gradient(130deg, Theme.ph1 0%, Theme.ph2 100%);
            clip: true;
            if root.fly-has-img: Image {
                width: parent.width;
                height: parent.height;
                source: root.fly-img;
                image-fit: fill;
            }
            if !root.fly-has-img: Text {
                text: root.fly-letter;
                color: Theme.fg;
                font-size: parent.height * 0.4;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        // Connexion en cours : barre de chargement sous la photo.
        if root.fly-phase == 2: Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.fly-cy + root.fly-cs + 28px * root.k;
            width: 160px * root.k;
            height: 4px * root.k;
            border-radius: self.height / 2;
            background: Theme.fg.with-alpha(0.1);
            clip: true;
            property <length> seg: 60px * root.k;
            property <length> head: (mod(animation-tick() / 1ms, 1300) / 1300) * (self.width + self.seg);
            Rectangle {
                x: max(0px, parent.head - parent.seg);
                width: min(parent.width, parent.head) - self.x;
                height: parent.height;
                border-radius: self.height / 2;
                background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
            }
        }
    }

    // Démarrage (au-dessus de tout) : vérifications, liaison du logo, puis zoom vers la page suivante.
    // Changement de thème (Rust : switch_theme) : l'écran de l'ancien thème, photographié, est balayé
    // par le nouveau, déjà posé dessous.
    in property <image> theme-snap;
    property <bool> theme-tiles;
    property <duration> theme-t0;
    // Départ pris au premier tour de boucle après le changement : appliquer le thème prend un moment,
    // et l'animation se serait jouée pendant que rien ne s'affichait.
    property <bool> theme-armed;
    public function theme-tiles-start() {
        root.theme-armed = false;
        root.theme-tiles = true;
    }
    Timer {
        interval: 30ms;
        running: root.theme-tiles && !root.theme-armed;
        triggered => {
            root.theme-t0 = animation-tick();
            root.theme-armed = true;
        }
    }
    Timer {
        interval: 1000ms;
        running: root.theme-armed;
        triggered => {
            root.theme-tiles = false;
            root.theme-armed = false;
        }
    }
    if root.theme-tiles: Rectangle {
        TouchArea { }
        // Balayage : le nouveau thème (déjà posé dessous) recouvre l'ancien de gauche à droite,
        // précédé d'une bande de lumière aux couleurs du nouveau thème. Une seule image, découpée.
        property <float> q: root.theme-armed ? clamp((animation-tick() - root.theme-t0) / 760ms, 0, 1) : 0;
        property <float> e: self.q < 0.5 ? 4 * self.q * self.q * self.q : 1 - (-2 * self.q + 2) * (-2 * self.q + 2) * (-2 * self.q + 2) / 2;
        property <length> band: 220px * root.k;
        // Milieu de la bande : part avant le bord gauche, finit après le bord droit.
        property <length> edge: -self.band / 2 + (self.width + self.band) * self.e;
        Rectangle {
            x: max(0px, parent.edge);
            width: max(0px, parent.width - self.x);
            clip: true;
            Image {
                x: -parent.x;
                width: root.width;
                height: root.height;
                source: root.theme-snap;
                image-fit: fill;
            }
        }
        Rectangle {
            x: parent.edge - parent.band / 2;
            width: parent.band;
            background: @linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, Theme.accent1.with-alpha(0.28) 38%,
                rgba(255, 255, 255, 0.55) 50%, Theme.accent2.with-alpha(0.28) 62%, rgba(255, 255, 255, 0) 100%);
        }
    }

    if root.boot-on: BootLogo {
        k: root.k;
        state: root.boot-state;
        labels: root.boot-labels;
        text: root.boot-text;
        fail: root.boot-fail;
        fail-hint: root.boot-fail-hint;
        phase: root.boot-phase;
        lang-open: root.boot-lang-open;
        lang-title: root.boot-lang-title;
        snap: root.dust-snap;
        dust-on: root.dust-on && root.dust-layer == 2;
        dust-lines: root.dust-lines;
        dust-phase: root.dust-phase;
        dust-t0: root.dust-t0;
        langs: root.boot-langs;
        lang-sel <=> root.boot-lang-sel;
        continue-boot => {
            root.boot-continue();
        }
        lang-chosen(id) => {
            root.boot-lang(id);
        }
        linked => {
            root.boot-linked();
        }
        finished => {
            root.boot-on = false;
            root.refocus += 1;
        }
    }

    // Changement de langue (dust.rs, ui/dust.slint) : blocs blancs posés sur les lignes de texte,
    // sous la liste des langues (couche 1 : Paramètres, 2 : démarrage). dust-snap : captures en
    // cours, la liste est masquée ; dust-cloud : textes recouverts (liste ouverte), sa fermeture
    // sans choix les fait revenir (dust-cancel).
    in-out property <bool> dust-on;
    in property <[DustLine]> dust-lines;
    in property <int> dust-layer;
    in-out property <bool> dust-snap;
    in-out property <bool> dust-blank;
    in-out property <bool> dust-cloud;
    property <int> dust-phase;
    property <duration> dust-t0;
    callback dust-cancel();
    // Taille de la fenêtre changée (textes recouverts : les blocs sont recalculés, voir dust.rs).
    callback dust-resized();
    changed width => {
        root.dust-resized();
    }
    changed height => {
        root.dust-resized();
    }
    // Phase de l'effet (1 recouvrir, 2 recouvert, 3 dévoiler), avec son départ.
    public function dust-start(phase: int) {
        root.dust-phase = phase;
        root.dust-t0 = animation-tick();
    }
    changed ch-key => {
        if (root.dust-cloud && root.ch-key != "language") {
            root.dust-cancel();
        }
    }

    // Téléphone tourné : voile du fond qui s'efface pendant que la nouvelle mise en page arrive.
    if root.rot-veil > 0.01: Rectangle {
        background: @linear-gradient(180deg, Theme.bg 0%, Theme.bg-mid 55%, Theme.bg-end 100%);
        opacity: 0.85 * root.rot-veil;
    }

    // Fenêtre façon Windows 7 (Frutiger Aero, hors plein écran) : cadre de verre, poignées de
    // redimensionnement et boutons réduire / agrandir / fermer, au-dessus de tout.
    if root.chrome: WinCaption {
        win-maxed: root.win-maxed;
        bar: root.chrome-top;
        b: root.chrome-side;
        drag => {
            root.win-drag();
        }
        resize(d) => {
            root.win-resize(d);
        }
        minimize => {
            root.win-min();
        }
        maximize => {
            root.win-max();
        }
        close => {
            root.win-close();
        }
    }
}
