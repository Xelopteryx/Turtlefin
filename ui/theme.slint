// Jetons de thème, posés par Rust (thèmes intégrés ou fichier .tftheme, voir src/theme.rs). Valeurs
// par défaut : le thème Turtlefin. Les surfaces translucides s'écrivent `Theme.fg.with-alpha(…)` :
// blanc translucide sur un thème sombre, encre translucide sur un thème clair.
export global Theme {
    // Fond de la fenêtre : dégradé vertical à trois arrêts (identiques : fond uni).
    in-out property <color> bg: #010e18;
    in-out property <color> bg-mid: #010e18;
    in-out property <color> bg-end: #010e18;
    // Encre : textes, icônes, traits, et base des surfaces translucides.
    in-out property <color> fg: #ffffff;
    in-out property <color> text: #ffffffe6;
    in-out property <color> muted: #ffffff99;
    in-out property <color> accent1: #a95bc2;
    in-out property <color> accent2: #00a4db;
    // Textes et icônes posés sur le dégradé d'accent (bouton choisi…).
    in-out property <color> on-accent: #ffffff;
    // Verre (panneaux, bulles) : rgba(24, 24, 28) + contour translucide, sans flou.
    in-out property <color> glass: #181820d9;
    in-out property <color> glass-border: #ffffff24;
    // Panneaux pleins au premier plan (menu, fenêtres, bulle de la visite).
    in-out property <color> panel: #0b1520f5;
    // Corps des cartes sous l'affiche (normal / choisie).
    in-out property <color> card: #00000033;
    in-out property <color> card-focus: #00000080;
    // Contour des cartes, lueur autour de l'élément choisi (transparent : aucune), reflet en
    // diagonale sur les affiches (0 : aucun).
    in-out property <color> card-border: transparent;
    in-out property <color> glow: transparent;
    in-out property <float> sheen: 0;
    // Lecteur : barre de commandes, encre (texte, icônes) et bouton lecture en orbe brillante.
    in-out property <color> player-bar: #181820d9;
    in-out property <color> player-ink: #ffffff;
    in-out property <bool> player-orb: false;
    // Affiche absente : dégradé de remplacement.
    in-out property <color> ph1: #2b2142;
    in-out property <color> ph2: #10283a;
    // Voile derrière les fenêtres au premier plan.
    in-out property <color> scrim: #000000;
    in-out property <color> danger: #ff6b6b;
    in-out property <color> danger-text: #ff8a8a;
    in-out property <color> ok: #4ade80;
    in-out property <color> warn: #f59e0b;
    // Voile sur l'image de fond du média sélectionné : 1 normal, plus : image plus effacée.
    in-out property <float> veil: 1.0;
    in-out property <length> radius: 10px;
    // Reflet brillant en haut des boutons et des panneaux (0 : aucun ; Frutiger Aero : ~1).
    in-out property <float> gloss: 0;
    // Décor du fond : 0 aucun · 1 ciel, herbe et bulles · 2 « Harmony » (Windows 7 : gerbe de
    // lumière sur bleu profond). `bubbles` : ancien nom du décor 1.
    in-out property <bool> bubbles: false;
    in-out property <int> scenery: 0;
    // Barre de verre derrière l'en-tête (comme la barre des tâches de Windows 7).
    in-out property <bool> header-glass: false;
    // Liseré intérieur des éléments brillants et des panneaux (transparent : aucun).
    in-out property <color> edge: transparent;
    // Reflets en biais sur les grands panneaux de verre.
    in-out property <bool> streaks: false;
    // Animation de démarrage : 0 logo qui se relie · 1 billes de verre qui tourbillonnent (Aero).
    in-out property <int> boot-style: 0;
    // Thème sombre (sinon clair).
    in-out property <bool> dark: true;
}

// Reflet brillant d'un bouton ou d'un panneau (thèmes à `Theme.gloss` > 0) : moitié haute plus
// claire, comme du plastique mouillé ou du verre. À poser en premier enfant, pleine largeur.
export component Gloss inherits Rectangle {
    in property <length> r: 10px;
    in property <float> strength: 1.0;
    visible: Theme.gloss > 0;
    clip: true;
    border-radius: root.r;
    // Liseré intérieur clair (verre de Windows 7).
    border-width: 1px;
    border-color: Theme.edge;
    // Reflets en biais, seulement sur les grandes surfaces.
    if Theme.streaks && root.height > 90px: Rectangle {
        background: @linear-gradient(115deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0) 30%,
            rgba(255, 255, 255, 0.09) 31%, rgba(255, 255, 255, 0.05) 42%, rgba(255, 255, 255, 0) 43%,
            rgba(255, 255, 255, 0) 52%, rgba(255, 255, 255, 0.07) 53%, rgba(255, 255, 255, 0.03) 58%, rgba(255, 255, 255, 0) 59%,
            rgba(255, 255, 255, 0) 100%);
    }
    Rectangle {
        y: 0px;
        height: root.height * 0.52;
        border-top-left-radius: root.r;
        border-top-right-radius: root.r;
        border-bottom-left-radius: root.r * 0.4;
        border-bottom-right-radius: root.r * 0.4;
        background: @linear-gradient(180deg, rgba(255, 255, 255, 0.62 * Theme.gloss * root.strength) 0%,
            rgba(255, 255, 255, 0.12 * Theme.gloss * root.strength) 100%);
    }
}

// Réglages d'affichage de l'appareil (Paramètres > Affichage), posés par Rust.
export global Prefs {
    in-out property <bool> ratings: true;  // notes sur les affiches
    in-out property <bool> marquee: true;  // défilement des noms trop longs
    in-out property <bool> clock: true;    // heure en haut à droite
}

// Traduction de l'interface, faite en Rust (i18n.rs) : langues intégrées et fichiers .po ajoutés,
// changement à chaud. `l` change à chaque changement de langue : passé à chaque appel, il fait
// recalculer les textes affichés.
export global Tr {
    in-out property <int> l;
    // Clé passée à chaque appel (recalcul des textes) : la même que `l`.
    out property <int> k: self.l;
    // Texte simple.
    pure callback t(int, string) -> string;
    // Texte avec une ou deux valeurs à la place des {} ("" si une seule).
    pure callback f(int, string, string, string) -> string;
    // Pluriel : forme « un », forme « plusieurs », n ({n} remplacé par n).
    pure callback p(int, string, string, int) -> string;
}

// Animations activées, par partie de l'interface (Paramètres → Animations ; réglé depuis Rust).
// Désactivée : la durée devient nulle, l'élément est posé directement à sa place.
export global Motion {
    in-out property <bool> boot: true;      // démarrage (logo animé)
    in-out property <bool> pages: true;     // arrivée des pages, fonds
    in-out property <bool> menu: true;      // menu latéral
    in-out property <bool> select: true;    // sélection : boutons, affiches, onglets
    in-out property <bool> scroll: true;    // défilement des rangées et des listes
    in-out property <bool> panels: true;    // panneaux et listes de choix (Paramètres, serveurs…)
    in-out property <bool> detail: true;    // fiche et lancement de la lecture
    in-out property <bool> player: true;    // lecteur
    in-out property <bool> search: true;    // recherche : lettres et clavier
    in-out property <bool> login: true;     // connexion
    in-out property <bool> language: true;  // changement de langue
    in-out property <bool> tour: true;      // visite guidée
}
