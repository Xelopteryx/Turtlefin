// Jetons de thème (équivalents de tes variables CSS --accent1-light / --accent2-light).
export global Theme {
    out property <color> bg: #010e18; // .backgroundContainer de JellySkin
    out property <color> accent1: #a95bc2;
    out property <color> accent2: #00a4db;
    out property <color> text: #ffffffe6;
    out property <color> muted: #ffffff99;
    out property <length> radius: 10px;
    // Verre sombre de Style.css : rgba(24, 24, 28) + contour blanc translucide (sans flou).
    out property <color> glass: #181820d9;
    out property <color> glass-border: #ffffff24;
}

// Réglages d'affichage de l'appareil (Paramètres > Affichage), posés par Rust.
export global Prefs {
    in-out property <bool> ratings: true;  // notes sur les affiches
    in-out property <bool> marquee: true;  // défilement des noms trop longs
    in-out property <bool> clock: true;    // heure en haut à droite
}

// Traduction de l'interface, faite en Rust (i18n.rs) : langues intégrées et fichiers .po ajoutés,
// changement à chaud. `l` change à chaque changement de langue : passé à chaque appel, il fait
// recalculer les textes affichés.
export global Tr {
    in property <int> l;
    // Fragmentation des textes (0 : nets · 100 : tout en « pixels »), le temps de choisir une langue.
    in-out property <int> fx;
    // Clé passée à chaque appel : change avec la langue ET la fragmentation (recalcul des textes).
    out property <int> k: self.l * 1000 + self.fx;
    // Texte simple.
    pure callback t(int, string) -> string;
    // Texte avec une ou deux valeurs à la place des {} ("" si une seule).
    pure callback f(int, string, string, string) -> string;
    // Pluriel : forme « un », forme « plusieurs », n ({n} remplacé par n).
    pure callback p(int, string, string, int) -> string;
    // Texte déjà traduit (fourni par Rust) : seulement la fragmentation.
    pure callback x(int, string) -> string;
}
