// Jetons de thème (équivalents de tes variables CSS --accent1-light / --accent2-light).
export global Theme {
    out property <color> bg: #010e18; // .backgroundContainer de JellySkin
    out property <color> accent1: #a95bc2;
    out property <color> accent2: #00a4db;
    out property <color> text: #ffffffe6;
    out property <color> muted: #ffffff99;
    out property <length> radius: 10px;
    // Verre sombre de Style.css : rgba(24, 24, 28) + contour blanc translucide (sans flou).
    out property <color> glass: #181820d9;
    out property <color> glass-border: #ffffff24;
}

// Réglages d'affichage de l'appareil (Paramètres > Affichage), posés par Rust.
export global Prefs {
    in-out property <bool> ratings: true;  // notes sur les affiches
    in-out property <bool> marquee: true;  // défilement des noms trop longs
    in-out property <bool> clock: true;    // heure en haut à droite
}
