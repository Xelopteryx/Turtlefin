// Clavier à l'écran (mode TV), à la manière d'un clavier de téléphone : trois dispositions
// (lettres AZERTY · chiffres et symboles · accents), grosses touches, Maj à un coup.
// Flèches : se déplacer ; Entrée : taper la touche (ou valider après une saisie au vrai clavier) ;
// Retour arrière : effacer.
// Le clavier ne modifie jamais `text` lui-même : il propose le nouveau texte par `edited`.

import { Theme, Tr, Gloss, Motion, Win7Glass, TermGlass } from "theme.slint";
import { Str } from "typed.slint";

// Vrai clavier branché (mode TV) : un caractère imprimable est écrit tel quel (Rust décide).
export global OskKeys {
    pure callback printable(string) -> bool;
}

export component Osk inherits Rectangle {
    in property <float> k: 1.0;
    in property <string> text;
    // Le clavier a la sélection (sinon, ses touches ne réagissent qu'à la souris).
    in property <bool> active;
    in property <string> ok-label: "OK";
    callback edited(string);
    callback done();
    // Flèche ↑ sur la première ligne / ↓ sur la dernière : la sélection quitte le clavier.
    callback leave-up();
    callback leave-down();
    // Retire le dernier caractère (fait en Rust : Slint n'a pas de sous-chaîne).
    pure callback erase(string) -> string;
    // Retour arrière sur un texte vide (la recherche retire alors son dernier filtre).
    callback erase-empty();
    // Touches ‹ et › autour de l'espace : le curseur se déplace dans le texte (`back` : caractères
    // après lui ; 0 : à la fin). Seulement là où le champ montre ce curseur (recherche).
    in property <bool> cursor-keys;
    in-out property <int> back: 0;
    property <int> len: Str.len(root.text);
    changed len => {
        root.back = min(root.back, root.len);
    }
    // Texte avec `s` inséré au curseur.
    function insert(s: string) {
        root.edited(Str.head(root.text, root.back) + s + Str.tail(root.text, root.back));
    }
    // Retour arrière : le caractère avant le curseur.
    function backspace() {
        if (root.text == "") {
            root.erase-empty();
        } else if (root.back < root.len) {
            root.edited(root.erase(Str.head(root.text, root.back)) + Str.tail(root.text, root.back));
        }
    }

    property <int> mode: 0; // 0 lettres · 1 chiffres et symboles · 2 accents
    // Maj pour une lettre ; deux appuis rapides : verrouillé (`caps`) jusqu'à un nouvel appui.
    property <bool> shift;
    property <bool> caps;
    property <duration> shift-t;
    // Dernière ligne : « CL » / « CR » sont les touches ‹ › du curseur.
    property <[string]> last-abc: root.cursor-keys ? ["?123", "àé", "CL", "␣", "CR", ".", "OK"] : ["?123", "àé", "␣", ".", "OK"];
    property <[string]> last-sym: root.cursor-keys ? ["ABC", "àé", "CL", "␣", "CR", ".", "OK"] : ["ABC", "àé", "␣", ".", "OK"];
    property <[string]> last-acc: root.cursor-keys ? ["ABC", "?123", "CL", "␣", "CR", ".", "OK"] : ["ABC", "?123", "␣", ".", "OK"];
    property <[[string]]> letters: [
        ["a", "z", "e", "r", "t", "y", "u", "i", "o", "p"],
        ["q", "s", "d", "f", "g", "h", "j", "k", "l", "m"],
        ["⇧", "w", "x", "c", "v", "b", "n", "'", "-", "⌫"],
        root.last-abc,
    ];
    property <[[string]]> symbols: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["@", "#", "€", "%", "&", "_", "+", "=", "/", ":"],
        ["(", ")", "\"", ";", "!", "?", ",", "*", "~", "⌫"],
        root.last-sym,
    ];
    property <[[string]]> accents: [
        ["é", "è", "ê", "ë", "à", "â", "ä", "ç", "ù", "û"],
        ["î", "ï", "ô", "ö", "ü", "ÿ", "œ", "æ", "«", "»"],
        ["⇧", "'", "-", "(", ")", ",", "?", "!", ":", "⌫"],
        root.last-acc,
    ];
    property <[[string]]> keys: root.mode == 0 ? root.letters : root.mode == 1 ? root.symbols : root.accents;
    property <int> r: 0;
    property <int> c: 0;
    // Dernière saisie au vrai clavier : Entrée valide (« Suivant » / OK) au lieu de taper la touche
    // en surbrillance. Une flèche rend la main au clavier à l'écran.
    property <bool> typed;
    property <length> gap: 8px * root.k;
    property <length> kh: 48px * root.k;

    // Touche enfoncée (télécommande, clic ou vrai clavier) : elle s'enfonce un instant à l'écran.
    property <string> press-key;
    property <bool> press-on;
    property <duration> press-t;
    function flash(k: string) {
        root.press-key = k;
        root.press-t = animation-tick();
        root.press-on = true;
    }
    Timer {
        interval: 40ms;
        running: root.press-on;
        triggered => {
            if (animation-tick() - root.press-t > 220ms) {
                root.press-on = false;
            }
        }
    }

    function press() {
        let key = root.keys[root.r][root.c];
        root.flash(key);
        if (key == "⇧") {
            if (root.caps) {
                root.caps = false;
                root.shift = false;
            } else if (root.shift && animation-tick() - root.shift-t < 600ms) {
                root.caps = true;
            } else {
                root.shift = !root.shift;
                root.shift-t = animation-tick();
            }
        } else if (key == "⌫") {
            root.backspace();
        } else if (key == "CL") {
            root.back = min(root.len, root.back + 1);
        } else if (key == "CR") {
            root.back = max(0, root.back - 1);
        } else if (key == "?123") {
            root.mode = 1;
        } else if (key == "ABC") {
            root.mode = 0;
        } else if (key == "àé") {
            root.mode = 2;
        } else if (key == "␣") {
            root.insert(" ");
        } else if (key == "OK") {
            root.done();
        } else {
            root.insert(root.shift || root.caps ? key.to-uppercase() : key);
            root.shift = root.caps;
        }
        root.c = min(root.c, root.keys[root.r].length - 1);
    }

    // Même position horizontale (proportionnelle) en changeant de ligne.
    function move-row(d: int) {
        let from = root.keys[root.r].length;
        root.r += d;
        let to = root.keys[root.r].length;
        root.c = min(to - 1, floor((root.c + 0.5) * to / from));
    }

    public function key(t: string) -> bool {
        if (t == Key.LeftArrow || t == Key.RightArrow || t == Key.UpArrow || t == Key.DownArrow) {
            root.typed = false;
        }
        if (t == Key.Return && root.typed) {
            root.typed = false;
            root.flash("OK");
            root.done();
            return true;
        }
        if (t == Key.LeftArrow) {
            root.c = max(0, root.c - 1);
        } else if (t == Key.RightArrow) {
            root.c = min(root.keys[root.r].length - 1, root.c + 1);
        } else if (t == Key.UpArrow) {
            if (root.r == 0) {
                root.leave-up();
            } else {
                root.move-row(-1);
            }
        } else if (t == Key.DownArrow) {
            if (root.r == root.keys.length - 1) {
                root.leave-down();
            } else {
                root.move-row(1);
            }
        } else if (t == Key.Return) {
            root.press();
        } else if (t == Key.Backspace) {
            root.flash("⌫");
            root.backspace();
        } else if (OskKeys.printable(t)) {
            // Vrai clavier : le caractère tapé va directement dans le champ (sa touche s'enfonce).
            root.flash(t == " " ? "␣" : t.to-lowercase());
            root.insert(t);
            root.typed = true;
        } else {
            return false;
        }
        return true;
    }

    height: 4 * self.kh + 3 * self.gap;
    background: transparent;

    for row[ri] in root.keys: HorizontalLayout {
        y: ri * (root.kh + root.gap);
        height: root.kh;
        spacing: root.gap;

        for key[ci] in row: Rectangle {
            horizontal-stretch: key == "␣" ? 3.4 : key == "OK" ? 1.6 : key == "?123" || key == "ABC" || key == "àé" ? 1.15 : 1;
            // Touches dans la matière du thème : verre de Windows 7 (Aero), composants (Nerd), sinon plates.
            border-radius: Theme.win7 ? 4px * root.k : Theme.term ? 2px : 10px * root.k;
            property <bool> lit: (root.active && ri == root.r && ci == root.c) || ka.has-hover;
            property <bool> down: root.press-on && key == root.press-key;
            transform-scale: self.down ? 0.86 : 1.0;
            animate transform-scale { duration: Motion.search ? (self.down ? 50ms : 180ms) : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            background: Theme.skinned ? transparent
                : self.lit ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%)
                : key == "OK" ? Theme.fg.with-alpha(0.22) : (key == "⇧" && root.shift) ? Theme.fg.with-alpha(0.3)
                : key.character-count > 1 || key == "⇧" || key == "⌫" ? Theme.fg.with-alpha(0.14) : Theme.fg.with-alpha(0.08);
            if Theme.win7: Win7Glass {
                lit: parent.lit;
            }
            if Theme.term: TermGlass {
                lit: parent.lit;
            }
            // Aero : la touche OK teintée de bleu, comme le bouton par défaut d'une fenêtre de Windows 7.
            if Theme.win7 && key == "OK" && !self.lit: Rectangle {
                border-radius: parent.border-radius;
                background: @linear-gradient(180deg, rgba(120, 200, 255, 0.35) 0%, rgba(40, 120, 220, 0.30) 100%);
            }
            if !Theme.skinned: Gloss { r: parent.border-radius; strength: 0.8; }
            // Maj active : teinte d'accent (plus forte une fois verrouillée).
            if key == "⇧" && (root.shift || root.caps) && !self.lit: Rectangle {
                border-radius: parent.border-radius;
                background: Theme.accent2.with-alpha(root.caps ? 0.55 : 0.28);
            }
            property <color> lit-ink: self.lit && !Theme.skinned ? Theme.on-accent : Theme.fg;

            if key == "⇧": Path {
                width: 20px * root.k;
                height: 20px * root.k;
                viewbox-width: 20;
                viewbox-height: 20;
                y: (parent.height - self.height) / 2 - (root.caps ? 3px * root.k : 0px);
                fill: root.shift || root.caps ? parent.lit-ink : transparent;
                stroke: parent.lit-ink;
                stroke-width: 2px * root.k;
                commands: "M 10 2 L 18 11 L 13.5 11 L 13.5 18 L 6.5 18 L 6.5 11 L 2 11 Z";
            }
            // Majuscules verrouillées : un trait sous la flèche (comme sur un téléphone).
            if key == "⇧" && root.caps: Rectangle {
                y: parent.height / 2 + 9px * root.k;
                width: 14px * root.k;
                height: 2.5px * root.k;
                border-radius: 1px;
                background: parent.lit-ink;
            }
            // Curseur : chevrons dessinés.
            if key == "CL" || key == "CR": Path {
                width: 10px * root.k;
                height: 16px * root.k;
                viewbox-width: 10;
                viewbox-height: 16;
                fill: transparent;
                stroke: parent.lit-ink;
                stroke-width: 2.4px * root.k;
                commands: key == "CL" ? "M 8 1.5 L 2 8 L 8 14.5" : "M 2 1.5 L 8 8 L 2 14.5";
            }
            if key == "⌫": Path {
                width: 26px * root.k;
                height: 20px * root.k;
                viewbox-width: 26;
                viewbox-height: 20;
                fill: transparent;
                stroke: parent.lit-ink;
                stroke-width: 2px * root.k;
                commands: "M 8 2 L 24 2 L 24 18 L 8 18 L 1 10 Z M 12 6 L 19 14 M 19 6 L 12 14";
            }
            if key != "⇧" && key != "⌫" && key != "CL" && key != "CR": Text {
                text: key == "␣" ? Tr.t(Tr.k, "espace") : key == "OK" ? root.ok-label
                    : key.character-count == 1 && (root.shift || root.caps) ? key.to-uppercase() : key;
                color: parent.lit-ink;
                font-size: ((key.character-count > 1 ? 16px : 22px) * root.k) * Theme.text-scale;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Éclair de l'appui
            Rectangle {
                border-radius: parent.border-radius;
                background: rgba(255, 255, 255, parent.down ? 0.4 : 0);
                animate background { duration: Motion.search ? 160ms : 0ms; }
            }
            ka := TouchArea {
                clicked => {
                    root.r = ri;
                    root.c = ci;
                    root.press();
                }
            }
        }
    }
}
