// Texte tapé dans un champ (recherche) : la lettre ajoutée apparaît en grossissant, celle effacée
// glisse vers la droite en s'estompant (chacune a son animation, même en effaçant vite), le
// curseur clignote juste après la dernière lettre, le texte d'exemple s'efface en fondu à la
// première lettre. Utilisé en mode TV (clavier à l'écran) et sur le bureau (par-dessus un
// TextInput dont le texte et le curseur sont masqués).
import { Theme, Motion } from "theme.slint";

// Découpe d'un texte (faite en Rust, Slint n'a pas de sous-chaînes).
export global Str {
    // Tout sauf les `n` derniers caractères.
    pure callback head(string, int) -> string;
    // Caractère `k` en partant de la fin (0 : le dernier) ; "" s'il n'y en a pas.
    pure callback at(string, int) -> string;
    // Vrai pour le texte d'une touche qui s'écrit (lettre, chiffre, espace...), faux pour les autres.
    pure callback printable(string) -> bool;
}

// Une des dernières lettres tapées : apparaît en grossissant (chacune garde son animation, même
// en tapant vite).
component Typed inherits Rectangle {
    in property <string> ch;
    in property <duration> t0;
    in property <bool> live;
    in property <length> font-size;
    property <float> p: root.live && Motion.search ? clamp((animation-tick() - root.t0) / 180ms, 0, 1) : 1;
    out property <length> w: root.ch == "" ? 0px : t.preferred-width;
    width: root.w;
    opacity: root.p;
    transform-scale: 1.6 - 0.6 * (1 - (1 - root.p) * (1 - root.p));
    t := Text {
        text: root.ch;
        color: Theme.fg;
        font-size: root.font-size;
        vertical-alignment: center;
    }
}

// Lettre effacée : glisse vers la droite en s'estompant, depuis la place qu'elle occupait.
component Ghost inherits Rectangle {
    in property <string> ch;
    in property <length> x0;
    in property <duration> t0;
    in property <int> serial;
    in property <length> font-size;
    in property <float> k: 1.0;
    // Animée seulement pendant son passage (pas de rafraîchissement continu ensuite). La place peut
    // resservir avant la fin (effacement rapide) : l'arrêt se règle sur la dernière lettre reçue, pas
    // sur la première (sinon la nouvelle lettre disparaissait d'un coup, en plein glissement).
    property <bool> live;
    changed serial => {
        self.live = true;
    }
    Timer {
        interval: 50ms;
        running: root.live;
        triggered => {
            if (animation-tick() - root.t0 > 280ms) {
                root.live = false;
            }
        }
    }
    property <float> p: root.live && Motion.search ? clamp((animation-tick() - root.t0) / 260ms, 0, 1) : 1;
    x: root.x0 + root.p * 16px * root.k;
    width: g.preferred-width;
    opacity: 1 - root.p;
    visible: root.p < 1;
    g := Text {
        text: root.ch;
        color: Theme.fg;
        font-size: root.font-size;
        vertical-alignment: center;
    }
}

export component TypedText inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    // Saisie en cours : curseur affiché.
    in property <bool> cursor;
    // Bureau : position du curseur donnée par le champ ; négative : fin du texte.
    in property <length> cursor-x: -1px;
    in property <length> font-size: 18px;
    in property <float> k: 1.0;
    clip: true;

    property <string> prev;
    // Moments où les 4 dernières lettres ont été tapées (0 : la dernière).
    property <duration> a0;
    property <duration> a1;
    property <duration> a2;
    property <duration> a3;
    property <duration> add-last;
    property <bool> adding;
    property <bool> blink: true;
    // Lettres effacées : 8 places utilisées tour à tour (touche maintenue : une lettre toutes les
    // ~30 ms, chacune garde son animation de 260 ms).
    property <int> slot;
    property <int> serial;
    property <string> g0; property <length> x0; property <duration> t0; property <int> s0;
    property <string> g1; property <length> x1; property <duration> t1; property <int> s1;
    property <string> g2; property <length> x2; property <duration> t2; property <int> s2;
    property <string> g3; property <length> x3; property <duration> t3; property <int> s3;
    property <string> g4; property <length> x4; property <duration> t4; property <int> s4;
    property <string> g5; property <length> x5; property <duration> t5; property <int> s5;
    property <string> g6; property <length> x6; property <duration> t6; property <int> s6;
    property <string> g7; property <length> x7; property <duration> t7; property <int> s7;
    changed text => {
        if (root.text.character-count > root.prev.character-count) {
            root.a3 = root.a2;
            root.a2 = root.a1;
            root.a1 = root.a0;
            root.a0 = animation-tick();
            root.add-last = root.a0;
            root.adding = true;
        } else if (root.text.character-count < root.prev.character-count) {
            root.a0 = root.a1;
            root.a1 = root.a2;
            root.a2 = root.a3;
            root.a3 = 0ms;
            let ch = Str.at(root.prev, 0);
            let now = animation-tick();
            root.serial += 1;
            if (root.slot == 0) { root.g0 = ch; root.x0 = root.end-x; root.t0 = now; root.s0 = root.serial; }
            else if (root.slot == 1) { root.g1 = ch; root.x1 = root.end-x; root.t1 = now; root.s1 = root.serial; }
            else if (root.slot == 2) { root.g2 = ch; root.x2 = root.end-x; root.t2 = now; root.s2 = root.serial; }
            else if (root.slot == 3) { root.g3 = ch; root.x3 = root.end-x; root.t3 = now; root.s3 = root.serial; }
            else if (root.slot == 4) { root.g4 = ch; root.x4 = root.end-x; root.t4 = now; root.s4 = root.serial; }
            else if (root.slot == 5) { root.g5 = ch; root.x5 = root.end-x; root.t5 = now; root.s5 = root.serial; }
            else if (root.slot == 6) { root.g6 = ch; root.x6 = root.end-x; root.t6 = now; root.s6 = root.serial; }
            else { root.g7 = ch; root.x7 = root.end-x; root.t7 = now; root.s7 = root.serial; }
            root.slot = mod(root.slot + 1, 8);
        }
        root.prev = root.text;
        root.blink = true;
    }
    // Animations d'apparition en cours tant que la dernière frappe a moins de 240 ms.
    Timer {
        interval: 60ms;
        running: root.adding;
        triggered => {
            if (animation-tick() - root.add-last > 240ms) {
                root.adding = false;
            }
        }
    }
    // Clignotement du curseur (pas d'animation continue : une bascule toutes les 530 ms).
    Timer {
        interval: 530ms;
        running: root.cursor;
        triggered => {
            root.blink = !root.blink;
        }
    }

    // Texte d'exemple : s'efface en fondu dès la première lettre, revient quand le champ est vide.
    Text {
        x: 0px;
        opacity: root.text == "" ? 1 : 0;
        animate opacity { duration: Motion.search ? 220ms : 0ms; }
        height: parent.height;
        text: root.placeholder;
        color: Theme.muted;
        font-size: root.font-size;
        vertical-alignment: center;
    }
    // Tout sauf les 4 dernières lettres (un texte vide a quand même une petite largeur : 0 alors).
    head := Text {
        x: 0px;
        height: parent.height;
        text: Str.head(root.text, 4);
        color: Theme.fg;
        font-size: root.font-size;
        vertical-alignment: center;
    }
    property <length> head-w: root.text.character-count > 4 ? head.preferred-width : 0px;
    c3 := Typed { x: root.head-w; height: parent.height; ch: Str.at(root.text, 3); t0: root.a3; live: root.adding; font-size: root.font-size; }
    c2 := Typed { x: c3.x + c3.w; height: parent.height; ch: Str.at(root.text, 2); t0: root.a2; live: root.adding; font-size: root.font-size; }
    c1 := Typed { x: c2.x + c2.w; height: parent.height; ch: Str.at(root.text, 1); t0: root.a1; live: root.adding; font-size: root.font-size; }
    c0 := Typed { x: c1.x + c1.w; height: parent.height; ch: Str.at(root.text, 0); t0: root.a0; live: root.adding; font-size: root.font-size; }
    property <length> end-x: c0.x + c0.w;
    Ghost { ch: root.g0; x0: root.x0; t0: root.t0; serial: root.s0; height: parent.height; font-size: root.font-size; k: root.k; }
    Ghost { ch: root.g1; x0: root.x1; t0: root.t1; serial: root.s1; height: parent.height; font-size: root.font-size; k: root.k; }
    Ghost { ch: root.g2; x0: root.x2; t0: root.t2; serial: root.s2; height: parent.height; font-size: root.font-size; k: root.k; }
    Ghost { ch: root.g3; x0: root.x3; t0: root.t3; serial: root.s3; height: parent.height; font-size: root.font-size; k: root.k; }
    Ghost { ch: root.g4; x0: root.x4; t0: root.t4; serial: root.s4; height: parent.height; font-size: root.font-size; k: root.k; }
    Ghost { ch: root.g5; x0: root.x5; t0: root.t5; serial: root.s5; height: parent.height; font-size: root.font-size; k: root.k; }
    Ghost { ch: root.g6; x0: root.x6; t0: root.t6; serial: root.s6; height: parent.height; font-size: root.font-size; k: root.k; }
    Ghost { ch: root.g7; x0: root.x7; t0: root.t7; serial: root.s7; height: parent.height; font-size: root.font-size; k: root.k; }
    if root.cursor && root.blink: Rectangle {
        // Bureau : position donnée par le champ ; sinon fin du texte (tout à gauche s'il est vide).
        x: (root.text == "" ? 0px : root.cursor-x >= 0px ? root.cursor-x : root.end-x) + 1px;
        y: (parent.height - self.height) / 2;
        width: 2px * root.k;
        height: root.font-size * 1.2;
        border-radius: 1px;
        background: Theme.accent2;
    }
}
