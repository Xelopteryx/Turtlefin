// Écran de lecture : la vidéo (texture dessinée par libmpv) et les commandes par-dessus.
//
// Navigation (clavier / télécommande) :
//   commandes masquées : ← → reculer / avancer de 10 s sans rien afficher ; ↑ ↓ Entrée Espace
//   affichent les commandes, sélection sur Lecture/Pause (Espace / Entrée : pause) ; Échap quitte.
//   boutons : ← → changer de bouton ; Entrée activer ; ↑ barre de temps ; ↓ épisodes de la saison.
//   barre de temps : ← → déplacer le curseur ; ↓ boutons ; ↑ bouton Retour.
//   épisodes de la saison : ← → choisir ; Entrée lire ; ↑ ou Échap revenir aux boutons.
//   menu des pistes : ↑ ↓ choisir ; Entrée valider ; Échap ou ← fermer.
// Fin d'un épisode (générique) : carte « Épisode suivant » ; fin de série / film : 3 suggestions,
// la vidéo réduite en haut à gauche (sélectionnable pour rester jusqu'au bout).

import { Marquee } from "marquee.slint";
import { Theme, Tr, Motion, Gloss, Sheen, Nav, Placeholder } from "theme.slint";
import { CardData } from "card.slint";

export struct TrackData {
    id: string,    // identifiant mpv ("no" = sous-titres désactivés)
    label: string,
    current: bool,
}

// Icônes tracées (24 x 24) : aucune police d'icônes à installer.
component Icon inherits Rectangle {
    in property <string> name;
    in property <color> tint: Theme.player-ink;

    if root.name == "play": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 7 4 L 20 12 L 7 20 Z";
    }
    if root.name == "pause": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 6 4 L 10 4 L 10 20 L 6 20 Z M 14 4 L 18 4 L 18 20 L 14 20 Z";
    }
    if root.name == "prev-ep": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 5 5 L 8 5 L 8 19 L 5 19 Z M 19 5 L 19 19 L 9 12 Z";
    }
    if root.name == "next-ep": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 16 5 L 19 5 L 19 19 L 16 19 Z M 5 5 L 15 12 L 5 19 Z";
    }
    if root.name == "prev-chap": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 12 6 L 12 18 L 3 12 Z M 21 6 L 21 18 L 12 12 Z";
    }
    if root.name == "next-chap": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 3 6 L 12 12 L 3 18 Z M 12 6 L 21 12 L 12 18 Z";
    }
    // Haut-parleur (volume, muet), note (piste audio), cadre CC (sous-titres).
    if root.name == "volume" || root.name == "mute": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 3 9 L 7 9 L 12 4.5 L 12 19.5 L 7 15 L 3 15 Z";
    }
    if root.name == "volume": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.height / 12;
        stroke-line-cap: round;
        commands: "M 15.5 9 Q 17.5 12 15.5 15 M 18.5 6.5 Q 22 12 18.5 17.5";
    }
    if root.name == "mute": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.height / 12;
        stroke-line-cap: round;
        commands: "M 16 9 L 21 15 M 21 9 L 16 15";
    }
    // Diffuser : écran et ondes (pleine quand la vidéo est déjà sur un écran).
    if root.name == "cast" || root.name == "cast-on": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: 2.2px;
        commands: "M 3 8 L 3 5 L 21 5 L 21 19 L 14 19 M 3 12 A 7 7 0 0 1 10 19 M 3 16 A 3 3 0 0 1 6 19";
    }
    if root.name == "cast-on": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 6 8 L 18 8 L 18 16 L 14 16 A 9 9 0 0 0 6 10 Z";
    }
    if root.name == "audio": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 9 5 L 20 3 L 20 16 A 3 3 0 1 1 18 13.2 L 18 7.4 L 11 8.7 L 11 18 A 3 3 0 1 1 9 15.2 Z";
    }
    if root.name == "subs": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.height / 12;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M 3 5.5 L 21 5.5 L 21 18.5 L 3 18.5 Z M 6.5 11.5 L 11 11.5 M 13 11.5 L 17.5 11.5 M 6.5 15 L 14 15";
    }
    if root.name == "quality": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.height / 12;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M 4.5 17.5 A 8.5 8.5 0 1 1 19.5 17.5 M 12 15 L 15.5 9.5";
    }
    if root.name == "back": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: "M 13.5 4 L 15.5 6 L 9.5 12 L 15.5 18 L 13.5 20 L 5.5 12 Z";
    }
}

// Bouton « pilule » de Style.css : verre clair, dégradé violet -> bleu au focus / survol.
component PlayerButton inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> focused;
    in property <bool> enabled: true;
    in property <length> size: 48px;
    in property <length> font: 16px;
    // Bouton principal (lecture / pause) : orbe brillante pleine d'accent si le thème le veut.
    in property <bool> main;
    property <bool> orb: root.main && Theme.player-orb;
    // Incrémenté à chaque activation (clavier ou souris) : le bouton s'enfonce puis rebondit.
    in property <int> press;
    // Doigt ou bouton de souris encore appuyé (répétition tant qu'il est maintenu).
    out property <bool> held: area.pressed;
    callback clicked();

    // Sélection au clavier (au bureau : seulement après une touche de navigation, voir Nav) ou survol.
    property <bool> lit: root.enabled && ((Nav.kb ? (root.focused) : area.has-hover && !Nav.touch) || area.pressed);
    property <duration> t0;
    property <bool> anim;
    changed press => {
        // 0 : un autre bouton vient d'être activé (ce bouton perd son compteur), rien à animer.
        if (root.press > 0) {
            self.t0 = animation-tick();
            self.anim = true;
        }
    }
    property <float> q: self.anim && Motion.player ? clamp((animation-tick() - self.t0) / 380ms, 0, 1) : 1;
    // 0 -> enfoncé (0,82) -> léger dépassement -> repos.
    property <float> push: self.q < 0.3 ? -0.18 * self.q / 0.3 : -0.18 * (1 - (self.q - 0.3) / 0.7) * cos((self.q - 0.3) / 0.7 * 540deg);
    Timer {
        interval: 400ms;
        running: root.anim;
        triggered => {
            root.anim = false;
        }
    }
    // Bouton inactif estompé par la couleur, pas par « opacity » : une opacité partielle sur un
    // élément qui a des enfants le fait dessiner hors écran à chaque image.
    property <color> ink: !root.enabled ? Theme.player-ink.with-alpha(0.35)
        : root.lit || root.orb ? Theme.on-accent : Theme.player-ink;

    width: root.text == "" ? root.size * (root.orb ? 1.3 : 1) : label.preferred-width + root.size;
    height: root.size * (root.orb ? 1.3 : 1);
    property <float> lit-s: root.lit ? 1.12 : 1.0;
    animate lit-s { duration: Motion.player ? 220ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

    // Le zoom est sur un rectangle intérieur : ignoré sur la racine d'un composant à minuterie.
    face := Rectangle {
    width: parent.width;
    height: parent.height;
    border-radius: self.height / 2;
    transform-scale: root.lit-s + root.push;
    // Orbe au repos : verre teinté d'accent, plus discret ; choisie : pleine, brillante et lumineuse.
    background: root.lit ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%)
        : root.orb ? @linear-gradient(130deg, Theme.accent1.with-alpha(0.38) 0%, Theme.accent2.with-alpha(0.38) 100%)
        : Theme.player-ink.with-alpha(0.08);
    animate background { duration: Motion.player ? 180ms : 0ms; }
    border-width: root.lit && !root.orb ? 0px : 1px;
    border-color: root.orb ? Theme.player-ink.with-alpha(0.55) : Theme.player-ink.with-alpha(0.25);
    drop-shadow-blur: Nav.no-shadow ? 0px : (root.orb && root.lit ? 16px : 0px);
    drop-shadow-color: Theme.accent2.with-alpha(0.8);
    Gloss { r: parent.border-radius; }
    // Orbe : éclat lumineux en bas, comme une bille de verre éclairée par-dessous.
    if root.orb: Rectangle {
        x: parent.width * 0.2;
        y: parent.height * 0.55;
        width: parent.width * 0.6;
        height: parent.height * 0.4;
        border-radius: self.height / 2;
        background: @radial-gradient(circle, rgba(170, 230, 255, 0.55) 0%, rgba(170, 230, 255, 0) 100%);
    }

    if root.icon != "": Icon {
        width: root.size * 0.5;
        height: root.size * 0.5;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        tint: root.ink;
    }

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.ink;
        font-size: root.font;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    area := TouchArea {
        enabled: root.enabled;
        clicked => {
            // Le bouton s'enfonce aussi au toucher et à la souris (pas seulement au clavier).
            root.t0 = animation-tick();
            root.anim = true;
            root.clicked();
        }
    }
    }
}

// Épisode du bandeau ↓ : vignette 16:9, numéro et titre ; l'épisode en cours est signalé.
component EpisodeCard inherits Rectangle {
    in property <CardData> data;
    in property <bool> focused;
    in property <bool> current;
    in property <float> k: 1.0;
    callback clicked();
    property <bool> lit: (Nav.kb ? (root.focused) : ep-area.has-hover && !Nav.touch);

    z: root.lit ? 1 : 0;
    transform-scale: root.lit ? 1.06 : 1.0;
    animate transform-scale { duration: Motion.player ? 220ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    // Aux couleurs du thème, comme les cartes des pages : fond de la barre du lecteur, contour,
    // lueur et reflet de verre du thème.
    border-radius: Theme.radius;
    background: Theme.player-bar;
    border-width: root.current ? 2px : 1px;
    border-color: root.current ? Theme.accent2 : Theme.card-border;
    drop-shadow-blur: Nav.no-shadow ? 0px : (root.lit ? 18px * root.k : 0px);
    drop-shadow-color: Theme.glow;
    // Carte choisie : un peu plus claire.
    Rectangle {
        border-radius: Theme.radius;
        background: root.lit ? Theme.player-ink.with-alpha(0.12) : transparent;
    }

    Rectangle {
        height: root.width * 0.5625;
        y: 0px;
        border-top-left-radius: Theme.radius;
        border-top-right-radius: Theme.radius;
        clip: true;
        background: transparent;
        if !root.data.has-image: Placeholder {
            title: root.data.title;
            k: root.k;
        }
        if root.data.has-image: Image {
            width: parent.width;
            height: parent.height;
            source: root.data.image;
            image-fit: fill;
        }
    }
    if Theme.sheen > 0: Sheen {
        height: root.width * 0.5625;
        r: Theme.radius;
        on: root.lit;
    }
    Marquee {
        x: 8px * root.k;
        y: root.width * 0.5625 + 6px * root.k;
        width: parent.width - 16px * root.k;
        height: 18px * root.k;
        text: root.data.title;
        active: root.lit;
        text-color: Theme.player-ink;
        font-size: 13px * root.k;
        font-weight: 600;
        horizontal-alignment: TextHorizontalAlignment.left;
    }
    Text {
        x: 8px * root.k;
        y: root.width * 0.5625 + 26px * root.k;
        width: parent.width - 16px * root.k;
        text: root.current ? Tr.t(Tr.k, "En cours") : root.data.subtitle;
        color: root.current ? Theme.accent2 : Theme.player-ink.with-alpha(0.62);
        font-size: 11px * root.k;
        overflow: elide;
    }
    ep-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Suggestion de fin : affiche, titre, année.
component PickCard inherits Rectangle {
    in property <CardData> data;
    in property <bool> focused;
    in property <float> k: 1.0;
    callback clicked();
    property <bool> lit: (Nav.kb ? (root.focused) : pick-area.has-hover && !Nav.touch);

    transform-scale: root.lit ? 1.08 : 1.0;
    animate transform-scale { duration: Motion.player ? 220ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    border-radius: 10px;
    background: root.lit ? Theme.player-ink.with-alpha(0.15) : Theme.player-ink.with-alpha(0.06);
    border-width: root.lit ? 3px : 0px;
    border-color: Theme.accent2;

    Rectangle {
        y: 0px;
        height: root.width * 1.5;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        background: root.data.has-image ? transparent : Theme.player-ink.with-alpha(0.08);
        if root.data.has-image: Image {
            width: parent.width;
            height: parent.height;
            source: root.data.image;
            image-fit: fill;
        }
    }
    Text {
        x: 8px * root.k;
        y: root.width * 1.5 + 8px * root.k;
        width: parent.width - 16px * root.k;
        text: root.data.title;
        color: Theme.player-ink;
        font-size: 14px * root.k;
        font-weight: 600;
        horizontal-alignment: center;
        overflow: elide;
    }
    Text {
        x: 8px * root.k;
        y: root.width * 1.5 + 30px * root.k;
        width: parent.width - 16px * root.k;
        text: root.data.subtitle;
        color: Theme.player-ink.with-alpha(0.62);
        font-size: 12px * root.k;
        horizontal-alignment: center;
        overflow: elide;
    }
    pick-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component PlayerView inherits Rectangle {
    in property <float> k: 1.0;
    in property <image> frame;
    in property <bool> ready;
    in property <bool> buffering;
    in property <bool> lost;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> paused;
    in property <float> progress;
    // Position et durée en secondes (durée 0 : inconnue, pas de limite aux sauts).
    in property <float> pos-secs;
    in property <float> dur-secs;
    in property <string> pos-text;
    in property <string> dur-text;
    in property <string> end-text;
    in property <[float]> chapters;
    in property <int> chapter-count;
    in property <bool> has-prev;
    in property <bool> has-next;
    in property <[TrackData]> audio-tracks;
    in property <int> audio-current;
    in property <[TrackData]> sub-tracks;
    in property <int> sub-current;
    in property <[TrackData]> quality-tracks;
    in property <int> quality-current;
    in property <[CardData]> episodes;
    in property <int> ep-current;
    in property <string> up-mode;
    in property <string> up-title;
    in property <string> up-sub;
    in property <image> up-image;
    in property <bool> has-up-image;
    in property <[CardData]> picks;
    in property <string> up-button;
    in property <bool> skip-intro;
    in property <image> bg;
    in property <bool> has-bg;
    in property <string> party; // watch party en cours (nom), vide sinon
    // Glissement du doigt sur la vidéo (Rust, voir Swipe) : compteur et sens (-1 vers le haut, 1 vers le bas).
    in property <int> swipe-n;
    in property <int> swipe-dir;
    changed swipe-n => {
        // Menu ouvert : le glissement l'a fait défiler, ce n'est pas un geste.
        if (root.menu != "") {
            return;
        }
        if (root.swipe-dir < 0) {
            // Vers le haut : épisodes de la saison (avec les commandes).
            if (root.episodes.length > 0) {
                root.menu = "";
                root.zone = 5;
                root.ep-sel = root.ep-current;
            }
            root.show();
        } else if (root.zone == 5) {
            root.zone = 2;
            root.show();
        } else {
            root.hide();
        }
    }
    // Commandes visibles quand le doigt s'est posé : le toucher les inverse (le simple contact les
    // affiche déjà, voir la zone de la vidéo).
    property <bool> osd-at-press;
    // Au doigt : un toucher attend un instant (un second toucher en fait un double : recul ou avance
    // de 10 s selon le côté) ; seul, il montre ou cache les commandes.
    property <bool> tap-wait;
    property <bool> tap-osd;
    // Retour visuel du double toucher : -1 recul, 1 avance ; seek-n relance l'animation. Après un
    // double toucher, chaque toucher du même côté (dans la seconde qui suit le précédent) ajoute 10 s
    // de plus : le compteur monte (+10, +20, +30…), comme sur les applis vidéo des téléphones.
    property <int> seek-side;
    property <int> seek-n;
    property <int> seek-total;
    // Position au premier toucher de la série : les sauts s'arrêtent au début et 1 s avant la fin
    // (le total affiché est le vrai décalage, plus de « −1000 s » au début d'un épisode).
    property <float> seek-base;
    property <duration> seek-t0;
    property <length> tap-x;
    property <length> tap-y;
    changed seek-n => {
        self.seek-t0 = animation-tick();
    }
    // 0 au toucher, 1 quand le retour visuel a disparu (plus rien d'affiché : 1,1 s après le dernier).
    property <float> seek-q: root.seek-n > 0 ? clamp((animation-tick() - root.seek-t0) / 1100ms, 0, 1) : 1;
    // Série en cours : un toucher de plus compte tout de suite (pas d'attente du double toucher).
    property <bool> seek-chain: root.seek-n > 0 && root.seek-q < 0.8;
    // Carte « Épisode suivant » et « Passer l'intro » : apparition et disparition en fondu.
    property <float> next-p: root.up-mode == "next" && root.menu == "" ? 1 : 0;
    animate next-p { duration: Motion.player ? 220ms : 0ms; easing: ease-out; }
    property <float> skip-p: root.skip-intro && root.up-mode == "" ? 1 : 0;
    animate skip-p { duration: Motion.player ? 220ms : 0ms; easing: ease-out; }

    callback command(string);   // "pause", "seek:-10", "seek-to:0.5", "chapter:1", "episode:-1", "aid:2", "sid:no", "quality:8000", "stop"
    callback toggle-fullscreen();
    // Bouton Diffuser (en haut à droite) ; un écran est déjà choisi.
    callback cast();
    in property <bool> cast-on;
    // Lecture sur un écran de diffusion : ce lecteur sert de télécommande (aucune vidéo ici) ; les
    // commandes partent à l'écran. `remote-nodur` : l'écran ne donne pas la durée (flux converti).
    in property <bool> remote;
    in property <string> remote-name;
    in property <bool> remote-nodur;
    // Ce que l'écran est en train de faire (« Changement de piste… »), vide sinon.
    in property <string> remote-busy;
    property <bool> cm-open;
    // Volume avant « muet » (télécommande), rendu au second appui.
    property <int> unmute-vol: 30;

    property <bool> osd: true;   // commandes affichées
    property <int> idle: 0;      // secondes sans activité
    property <int> zone: 0;      // 0 aucune · 1 barre de temps · 2 boutons · 3 Retour · 5 épisodes · 6 volume
    property <int> btn: 2;       // 0 ép. préc. · 1 chap. préc. · 2 lecture · 3 chap. suiv. · 4 ép. suiv. · 5 volume · 6 audio · 7 sous-titres · 8 qualité
    // Volume de Turtlefin (mpv), 0 à 100 ; réglé par la barre du bouton volume.
    in-out property <int> volume: 100;
    // Appui sur un bouton (animation) : numéro du bouton et compteur.
    property <int> press-btn: -1;
    property <int> press-n;
    // Bouton utilisable (les autres sont cachés et sautés par la sélection).
    pure function btn-ok(i: int) -> bool {
        // Télécommande : le panneau n'a plus que les pistes (le reste est au milieu, voir pad).
        if (root.remote && i != 6 && i != 7) {
            return false;
        }
        return i == 0 ? root.has-prev : i == 1 || i == 3 ? root.chapter-count > 0 : i == 4 ? root.has-next
            : i == 6 ? root.audio-tracks.length > 1 : i == 7 ? root.sub-tracks.length > 0
            : i == 8 ? root.quality-tracks.length > 0 : true;
    }
    // Bouton utilisable suivant dans la direction d (sinon on reste sur place).
    pure function btn-step(from: int, d: int) -> int {
        let a = from + d;
        let b = from + 2 * d;
        let c = from + 3 * d;
        let e = from + 4 * d;
        return a >= 0 && a <= 8 && root.btn-ok(a) ? a
            : b >= 0 && b <= 8 && root.btn-ok(b) ? b
            : c >= 0 && c <= 8 && root.btn-ok(c) ? c
            : e >= 0 && e <= 8 && root.btn-ok(e) ? e : from;
    }
    property <string> menu: "";  // "" | "audio" | "sub" | "quality"
    // Dernier menu ouvert : son contenu reste affiché pendant qu'il disparaît.
    property <string> menu-last: "audio";
    changed menu => {
        root.menu-free = false;
        if (root.menu != "") {
            root.menu-last = root.menu;
        }
    }
    property <float> menu-p: root.menu != "" && root.osd ? 1 : 0;
    animate menu-p { duration: Motion.player ? 240ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    // Barre du volume affichée (zone 6) : même animation.
    property <float> vol-p: root.zone == 6 && root.osd ? 1 : 0;
    animate vol-p { duration: Motion.player ? 240ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    function set-volume(v: int) {
        root.volume = max(0, min(100, v));
        root.command("volume:" + root.volume);
    }
    property <int> menu-sel: 0;
    // Défilement au doigt / à la molette dans un menu : cumul en pixels, une ligne tous les 46 points.
    property <length> menu-acc;
    // Lignes visibles du menu (Audio, Sous-titres, Qualité) : 8 au plus, moins sur un petit écran (le
    // menu tient entre le haut de l'écran et le panneau des commandes ; le reste défile).
    property <int> menu-rows: max(3, min(8, floor((root.height - 160px * root.k - 3 * root.m - 90px * root.k) / (46px * root.k))));
    // Première ligne affichée : suit la sélection (clavier), ou le doigt (défilement libre).
    property <bool> menu-free;
    property <int> menu-free-top;
    property <int> menu-top: root.menu-free ? root.menu-free-top : max(0, root.menu-sel - root.menu-rows + 1);
    property <[TrackData]> menu-items: root.menu-last == "audio" ? root.audio-tracks
        : root.menu-last == "sub" ? root.sub-tracks : root.quality-tracks;
    property <bool> dragging;
    property <float> drag-frac;
    property <length> m: 24px * root.k;
    // Barres réglables au doigt (temps, volume) : un doigt qui s'y pose les règle au lieu de faire un
    // geste sur la vidéo (voir Swipe, main.rs). Mêmes calculs que le panneau et la barre de volume
    // (rectangles en pixels logiques, largeur nulle : barre absente).
    property <length> c-sx: root.osd ? 2 * root.m : 0px;
    in-out property <length> hit-sx: root.c-sx;
    changed c-sx => {
        root.hit-sx = root.c-sx;
    }
    property <length> c-sy: root.height - 160px * root.k - root.m - root.ep-p * root.ep-h + 40px * root.k - 10px * root.k;
    in-out property <length> hit-sy: root.c-sy;
    changed c-sy => {
        root.hit-sy = root.c-sy;
    }
    // Valeurs de départ : le parent (<=>) impose les siennes (0), et une valeur qui ne change jamais
    // (hauteurs) ne passerait pas par les « changed ».
    init => {
        root.hit-sx = root.c-sx;
        root.hit-sy = root.c-sy;
        root.hit-sw = root.c-sw;
        root.hit-sh = root.c-sh;
        root.hit-vx = root.c-vx;
        root.hit-vy = root.c-vy;
        root.hit-vw = root.c-vw;
        root.hit-vh = root.c-vh;
        root.sub-margin();
    }
    property <length> c-sw: root.osd ? root.width - 4 * root.m : 0px;
    in-out property <length> hit-sw: root.c-sw;
    changed c-sw => {
        root.hit-sw = root.c-sw;
    }
    property <length> c-sh: 48px * root.k;
    in-out property <length> hit-sh: root.c-sh;
    changed c-sh => {
        root.hit-sh = root.c-sh;
    }
    property <length> c-vw: root.osd && root.vol-p > 0.5 ? min(root.width - 2 * root.m, (Nav.touch ? 520px : 420px) * root.k) : 0px;
    in-out property <length> hit-vw: root.c-vw;
    changed c-vw => {
        root.hit-vw = root.c-vw;
    }
    property <length> c-vh: (Nav.touch ? 96px : 76px) * root.k;
    in-out property <length> hit-vh: root.c-vh;
    changed c-vh => {
        root.hit-vh = root.c-vh;
    }
    property <length> c-vx: root.width - root.c-vw - root.m;
    in-out property <length> hit-vx: root.c-vx;
    changed c-vx => {
        root.hit-vx = root.c-vx;
    }
    property <length> c-vy: root.height - root.m - 160px * root.k - root.c-vh - 16px * root.k;
    in-out property <length> hit-vy: root.c-vy;
    changed c-vy => {
        root.hit-vy = root.c-vy;
    }
    property <int> ep-sel: 0;
    property <int> up-sel: 0;    // carte suivante : 0 lire · 1 continuer ; suggestions : 0 vidéo / accueil · 1..3
    property <bool> mini: root.up-mode == "pick";
    // Les suggestions montent du bas de l'écran (activé juste après leur création, pour l'animation).
    property <bool> picks-in;
    changed picks => {
        root.picks-in = false;
    }
    property <length> ep-h: 190px * root.k; // hauteur du bandeau d'épisodes
    // Bandeau d'épisodes affiché (0 -> 1) : panneau et bandeau glissent ensemble.
    property <float> ep-p: root.osd && root.zone == 5 ? 1 : 0;
    animate ep-p { duration: Motion.player ? 280ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    changed up-mode => {
        root.up-sel = root.up-mode == "next" ? 0 : root.up-mode == "" ? 0 : 1;
    }

    // Sous-titres remontés au-dessus du panneau tant qu'il est affiché (marge mpv : unités sur 720 de haut).
    function sub-margin() {
        root.command("sub-margin:" + (root.osd ? round((160px * root.k + 2 * root.m) / root.height * 720) : 22));
    }
    changed osd => {
        root.sub-margin();
        root.command("cursor:" + (root.osd ? "show" : "hide"));
    }

    function show() {
        root.osd = true;
        root.idle = 0;
    }

    function hide() {
        // Télécommande : les commandes restent affichées (il n'y a rien à regarder dessous).
        if (root.remote) {
            root.menu = "";
            root.cm-open = false;
            return;
        }
        root.osd = false;
        root.zone = 0;
        root.menu = "";
    }

    function open-menu(kind: string) {
        if (root.menu == kind) {
            root.menu = "";
        } else {
            root.menu = kind;
            root.menu-sel = kind == "audio" ? root.audio-current : kind == "sub" ? root.sub-current : root.quality-current;
            root.zone = 2;
            root.btn = kind == "audio" ? 6 : kind == "sub" ? 7 : 8;
        }
        root.show();
    }

    function apply-menu() {
        if (root.menu-sel < root.menu-items.length) {
            root.command((root.menu == "audio" ? "aid:" : root.menu == "sub" ? "sid:" : "quality:") + root.menu-items[root.menu-sel].id);
        }
        root.menu = "";
    }

    // Pause / lecture par une simple touche : commandes affichées, sélection sur le bouton Lecture/Pause.
    function toggle-pause() {
        root.command("pause");
        root.menu = "";
        root.zone = 2;
        root.btn = 2;
        root.show();
    }

    function activate(i: int) {
        root.press-btn = i;
        root.press-n += 1;
        if (i == 0) {
            if (root.has-prev) {
                root.command("episode:-1");
            }
        } else if (i == 1) {
            if (root.chapter-count > 0) {
                root.command("chapter:-1");
            }
        } else if (i == 2) {
            root.command("pause");
        } else if (i == 3) {
            if (root.chapter-count > 0) {
                root.command("chapter:1");
            }
        } else if (i == 4) {
            if (root.has-next) {
                root.command("episode:1");
            }
        } else if (i == 5) {
            root.menu = "";
            root.zone = root.zone == 6 ? 2 : 6;
            root.btn = 5;
        } else if (i == 6) {
            root.open-menu("audio");
        } else if (i == 7) {
            root.open-menu("sub");
        } else if (i == 8) {
            root.open-menu("quality");
        }
        root.show();
    }

    background: black;

    // Vidéo : la texture a la taille de la fenêtre, mpv y gère lui-même le format d'image.
    Image {
        x: root.mini ? 32px * root.k : 0px;
        y: root.mini ? 32px * root.k : 0px;
        width: root.mini ? 400px * root.k : parent.width;
        height: root.mini ? 225px * root.k : parent.height;
        source: root.frame;
        image-fit: fill;
        animate x, y, width, height { duration: Motion.player ? 450ms : 0ms; easing: ease-in-out; }
    }

    // Télécommande : image de la vidéo (floutée par l'assombrissement), écran où elle passe.
    if root.remote: Rectangle {
        if root.has-bg: Image {
            width: parent.width;
            height: parent.height;
            source: root.bg;
            image-fit: cover;
            opacity: 0.45;
        }
        Rectangle {
            background: @linear-gradient(180deg, #000000aa 0%, #00000066 50%, #000000cc 100%);
        }
    }

    // « Chargement… » seulement si l'attente dure (pas pour un épisode qui enchaîne en une demi-
    // seconde : le mot apparaissait et disparaissait d'un coup), et en fondu dans les deux sens.
    property <bool> load-slow;
    Timer {
        interval: 700ms;
        running: !root.ready && !root.load-slow;
        triggered => {
            root.load-slow = true;
        }
    }
    changed ready => {
        if (root.ready) {
            root.load-slow = false;
        }
    }
    property <float> load-a: root.load-slow && !root.ready ? 1 : 0;
    animate load-a { duration: Motion.player ? 300ms : 0ms; easing: ease-in-out; }
    if root.load-a > 0.01: Text {
        opacity: root.load-a;
        text: Tr.t(Tr.k, "Chargement…");
        color: Theme.player-ink.with-alpha(0.62);
        font-size: 22px * root.k;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Réseau lent (image arrêtée le temps de remplir le cache) ou connexion perdue : pastille au
    // centre avec un arc qui tourne ; la lecture reprend seule.
    if root.ready && (root.buffering || root.lost): Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: wait-t.preferred-width + 90px * root.k;
        height: 60px * root.k;
        border-radius: self.height / 2;
        background: #000000b3;
        border-width: 1px;
        border-color: root.lost ? #f59e0b : Theme.player-ink.with-alpha(0.2);
        Path {
            x: 18px * root.k;
            y: (parent.height - self.height) / 2;
            width: 26px * root.k;
            height: 26px * root.k;
            viewbox-width: 100;
            viewbox-height: 100;
            fill: transparent;
            stroke: root.lost ? #fbbf24 : Theme.player-ink;
            stroke-width: 3px * root.k;
            commands: "M 50 8 A 42 42 0 0 1 92 50";
            transform-rotation: mod(animation-tick() / 1ms, 900) / 900 * 360deg;
        }
        wait-t := Text {
            x: 58px * root.k;
            height: parent.height;
            text: root.lost ? Tr.t(Tr.k, "Connexion au serveur perdue · reprise automatique dès son retour") : Tr.t(Tr.k, "Mise en mémoire…");
            color: Theme.player-ink;
            font-size: 16px * root.k;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    // Souris sur la vidéo : affiche les commandes ; clic = pause ; double-clic = plein écran.
    TouchArea {
        mouse-cursor: root.osd ? MouseCursor.default : MouseCursor.none;
        // Souris qui bouge : les commandes apparaissent. Pas au doigt : le doigt qui se pose compte aussi
        // comme un mouvement (avant l'appui), et le toucher suivant les aurait aussitôt cachées.
        changed mouse-x => {
            if (!Nav.touch) {
                root.show();
            }
        }
        changed mouse-y => {
            if (!Nav.touch) {
                root.show();
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.osd-at-press = root.osd;
            }
        }
        clicked => {
            if (root.menu != "") {
                root.menu = "";
                root.show();
            } else if (Nav.touch) {
                if (root.seek-chain) {
                    // Série de touchers : 10 s de plus à chaque fois (de l'autre côté : nouvelle série,
                    // depuis l'endroit où la précédente a mené).
                    let side = self.mouse-x < self.width / 2 ? -1 : 1;
                    if (side != root.seek-side) {
                        root.seek-base = root.seek-base + root.seek-side * root.seek-total;
                        root.seek-total = 0;
                        root.seek-side = side;
                    }
                    root.tap-x = self.mouse-x;
                    root.tap-y = self.mouse-y;
                    root.seek-step();
                } else if (root.tap-wait) {
                    // Second toucher : recul ou avance de 10 s selon le côté touché.
                    root.tap-wait = false;
                    root.seek-side = self.mouse-x < self.width / 2 ? -1 : 1;
                    root.seek-base = root.pos-secs;
                    root.seek-total = 0;
                    root.tap-x = self.mouse-x;
                    root.tap-y = self.mouse-y;
                    root.seek-step();
                    if (root.tap-osd) {
                        root.show();
                    }
                } else {
                    // Premier toucher : décidé à la fin de l'attente (voir le minuteur dessous).
                    root.tap-wait = true;
                    root.tap-osd = root.osd-at-press;
                }
            } else {
                root.command("pause");
                root.show();
            }
        }
        double-clicked => {
            if (!Nav.touch) {
                root.toggle-fullscreen();
            }
        }
    }

    // Un saut de la série : 10 s, ou ce qui reste jusqu'au début / la fin (rien s'il ne reste rien).
    function seek-step() {
        let known = root.dur-secs > 0;
        let room = !known ? 10 : root.seek-side < 0 ? root.seek-base - root.seek-total
            : root.dur-secs - 1 - root.seek-base - root.seek-total;
        let step = floor(clamp(room, 0, 10));
        if (step > 0) {
            root.command("seek:" + (root.seek-side * step));
            root.seek-total += step;
        }
        root.seek-n += 1;
    }
    // Toucher seul (pas suivi d'un second) : montre ou cache les commandes, comme ailleurs.
    Timer {
        interval: 260ms;
        running: root.tap-wait;
        triggered => {
            root.tap-wait = false;
            if (root.tap-osd) {
                root.hide();
            } else {
                root.show();
            }
        }
    }

    // Double toucher (et touchers suivants) : du côté touché, un arc de lumière part du bord, une
    // onde s'élargit sous le doigt, trois chevrons s'allument l'un après l'autre et le total
    // (« +30 s », « −20 s ») rebondit à chaque nouveau toucher ; le tout s'efface ensuite.
    if root.seek-q < 1: sk := Rectangle {
        clip: true;
        // Apparition au premier toucher, disparition à la fin (rien entre deux touchers).
        property <float> a: Motion.player ? clamp((1 - root.seek-q) / 0.25, 0, 1) : 1;
        property <duration> since: animation-tick() - root.seek-t0;
        // Arc : grand disque centré hors de l'écran, sur le bord du côté touché.
        Rectangle {
            width: parent.height * 1.5;
            height: self.width;
            x: root.seek-side < 0 ? parent.width * 0.36 - self.width : parent.width * 0.64;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: #ffffff;
            opacity: 0.10 * parent.a;
        }
        // Onde sous le doigt, à chaque toucher.
        Rectangle {
            property <float> w: Motion.player ? clamp(parent.since / 450ms, 0, 1) : 1;
            width: (60px + 220px * (1 - (1 - self.w) * (1 - self.w))) * root.k;
            height: self.width;
            x: root.tap-x - self.width / 2;
            y: root.tap-y - self.height / 2;
            border-radius: self.width / 2;
            background: #ffffff;
            opacity: 0.22 * (1 - self.w) * parent.a;
        }
        // Chevrons et total, au milieu de l'arc.
        Rectangle {
            width: 160px * root.k;
            height: 110px * root.k;
            x: root.seek-side < 0 ? parent.width * 0.16 - self.width / 2 : parent.width * 0.84 - self.width / 2;
            y: (parent.height - self.height) / 2;
            opacity: parent.a;
            for j in 3: Path {
                // Allumés en vague, dans le sens du saut (de droite à gauche pour un recul).
                property <int> rank: root.seek-side < 0 ? 2 - j : j;
                property <float> ph: Motion.player ? mod(animation-tick() / 1ms + 1000 - self.rank * 140, 700) / 700 : 0.5;
                x: (parent.width - 3 * 22px * root.k) / 2 + j * 22px * root.k;
                y: 6px * root.k;
                width: 22px * root.k;
                height: 30px * root.k;
                viewbox-width: 22;
                viewbox-height: 30;
                fill: transparent;
                stroke: Theme.player-ink;
                stroke-width: 3.5px * root.k;
                stroke-line-cap: round;
                stroke-line-join: round;
                commands: root.seek-side < 0 ? "M 15 5 L 6 15 L 15 25" : "M 7 5 L 16 15 L 7 25";
                opacity: 0.25 + 0.75 * max(0, 1 - abs(self.ph - 0.25) * 4);
            }
            Text {
                y: 46px * root.k;
                width: parent.width;
                // Rebond du total à chaque toucher.
                property <float> pop: Motion.player ? clamp(sk.since / 220ms, 0, 1) : 1;
                transform-scale: 1 + 0.3 * (1 - self.pop) * (1 - self.pop);
                text: (root.seek-total == 0 ? "" : root.seek-side < 0 ? "−" : "+") + root.seek-total + " s";
                color: Theme.player-ink;
                font-size: 26px * root.k;
                font-weight: 800;
                horizontal-alignment: center;
            }
        }
    }

    Timer {
        interval: 1s;
        running: root.osd;
        triggered => {
            root.idle += 1;
            if (root.idle >= (Nav.touch ? 5 : 3) && !root.paused && root.menu == "" && !root.dragging && root.zone != 5) {
                root.hide();
            }
        }
    }

    FocusScope {
        width: 0px;
        height: 0px;

        init => {
            self.focus();
        }

        key-pressed(event) => {
            // Touche maintenue : Entrée, Échap et Retour arrière ne répètent pas l'action (ouvrir, revenir...).
            if (event.repeat && (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Backspace)) {
                return EventResult.accept;
            }
            if (event.text == Key.F11 || event.text == "f") {
                root.toggle-fullscreen();
                return EventResult.accept;
            }

            // Suggestions de fin / écran de fin : elles prennent toutes les touches.
            if (root.up-mode == "pick" || root.up-mode == "end") {
                if (event.text == Key.LeftArrow) {
                    if (root.up-sel > 1) {
                        root.up-sel -= 1;
                    }
                } else if (event.text == Key.RightArrow) {
                    root.up-sel = min(root.picks.length, max(1, root.up-sel + 1));
                } else if (event.text == Key.UpArrow) {
                    root.up-sel = 0;
                } else if (event.text == Key.DownArrow) {
                    if (root.up-sel == 0 && root.picks.length > 0) {
                        root.up-sel = 1;
                    }
                } else if (event.text == Key.Return) {
                    if (root.up-sel == 0) {
                        // Vidéo réduite : on continue à regarder ; écran de fin : retour à l'accueil.
                        root.command(root.up-mode == "pick" ? "up:dismiss" : "home");
                    } else {
                        root.command("pick:" + root.picks[root.up-sel - 1].id);
                    }
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.command(root.up-mode == "pick" ? "up:dismiss" : "stop");
                }
                return EventResult.accept;
            }

            // « Passer l'intro » affiché et commandes masquées : Entrée passe l'intro.
            if (root.skip-intro && (!root.osd || root.zone == 0) && event.text == Key.Return) {
                root.command("skip-intro");
                return EventResult.accept;
            }

            // Carte « Épisode suivant » (commandes masquées) : ↑ ↓ choisir, Entrée, Échap.
            if (root.up-mode == "next" && (!root.osd || root.zone == 0)) {
                if (event.text == Key.UpArrow) {
                    root.up-sel = 0;
                    return EventResult.accept;
                } else if (event.text == Key.DownArrow) {
                    root.up-sel = 1;
                    return EventResult.accept;
                } else if (event.text == Key.Return) {
                    root.command(root.up-sel == 0 ? "up:play" : "up:dismiss");
                    return EventResult.accept;
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.command("up:dismiss");
                    return EventResult.accept;
                }
            }
            if (event.text == "q" || event.text == Key.Stop) {
                root.command("stop");
                return EventResult.accept;
            }
            // Télécommande (voir main.rs, remote_key) : piste suivante / précédente (et Chaîne + / −),
            // avance rapide (F18 : +30 s) et retour rapide (F17 : -10 s).
            if (event.text == Key.PageDown || event.text == Key.PageUp) {
                if (event.text == Key.PageDown && root.has-next) {
                    root.command("episode:1");
                } else if (event.text == Key.PageUp && root.has-prev) {
                    root.command("episode:-1");
                }
                return EventResult.accept;
            }
            if (event.text == Key.F18 || event.text == Key.F17) {
                root.command(event.text == Key.F18 ? "seek:30" : "seek:-10");
                return EventResult.accept;
            }
            if (event.text == "a") {
                root.open-menu("audio");
                return EventResult.accept;
            }
            if (event.text == "s") {
                root.open-menu("sub");
                return EventResult.accept;
            }
            if (event.text == Key.Space) {
                root.toggle-pause();
                return EventResult.accept;
            }

            // Menu des pistes ouvert : il prend les flèches.
            if (root.menu != "") {
                root.menu-free = false;
                if (event.text == Key.UpArrow) {
                    root.menu-sel = max(0, root.menu-sel - 1);
                } else if (event.text == Key.DownArrow) {
                    root.menu-sel = min(root.menu-items.length - 1, root.menu-sel + 1);
                } else if (event.text == Key.Return) {
                    root.apply-menu();
                } else if (event.text == Key.Escape || event.text == Key.Backspace || event.text == Key.LeftArrow) {
                    root.menu = "";
                }
                root.show();
                return EventResult.accept;
            }

            // Commandes masquées (ou affichées à la souris, sans sélection).
            if (!root.osd || root.zone == 0) {
                if (event.text == Key.LeftArrow) {
                    root.command("seek:-10");
                } else if (event.text == Key.RightArrow) {
                    root.command("seek:10");
                } else if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                    // Commandes affichées, sélection sur Lecture/Pause.
                    root.zone = 2;
                    root.btn = 2;
                    root.show();
                } else if (event.text == Key.Return) {
                    root.toggle-pause();
                } else if (event.text == Key.Escape || event.text == Key.Backspace) {
                    // Aucune commande choisie (commandes masquées, ou affichées toutes seules au
                    // démarrage / par la souris) : Échap quitte la lecture, sans étape de plus.
                    root.command("stop");
                }
                return EventResult.accept;
            }

            if (event.text == Key.Escape || event.text == Key.Backspace) {
                if (root.zone == 5 || root.zone == 6) {
                    root.zone = 2;
                } else {
                    root.hide();
                }
                return EventResult.accept;
            }

            if (root.zone == 1) {
                // Barre de temps
                if (event.text == Key.LeftArrow) {
                    root.command("seek:-10");
                } else if (event.text == Key.RightArrow) {
                    root.command("seek:10");
                } else if (event.text == Key.DownArrow) {
                    root.zone = 2;
                    root.btn = 2;
                } else if (event.text == Key.UpArrow) {
                    root.zone = 3;
                } else if (event.text == Key.Return) {
                    root.toggle-pause();
                }
            } else if (root.zone == 2) {
                // Boutons
                if (event.text == Key.LeftArrow) {
                    root.btn = root.btn-step(root.btn, -1);
                } else if (event.text == Key.RightArrow) {
                    root.btn = root.btn-step(root.btn, 1);
                } else if (event.text == Key.UpArrow) {
                    root.zone = 1;
                } else if (event.text == Key.DownArrow) {
                    if (root.episodes.length > 0) {
                        root.zone = 5;
                        root.ep-sel = root.ep-current;
                    }
                } else if (event.text == Key.Return) {
                    root.activate(root.btn);
                }
            } else if (root.zone == 6) {
                // Barre du volume : ← → par 5 %, Entrée / ↑ / ↓ referment.
                if (event.text == Key.LeftArrow) {
                    root.set-volume(root.volume - 5);
                } else if (event.text == Key.RightArrow) {
                    root.set-volume(root.volume + 5);
                } else if (event.text == Key.Return || event.text == Key.UpArrow || event.text == Key.DownArrow) {
                    root.zone = 2;
                    root.btn = 5;
                }
            } else if (root.zone == 5) {
                // Épisodes de la saison
                if (event.text == Key.LeftArrow) {
                    root.ep-sel = max(0, root.ep-sel - 1);
                } else if (event.text == Key.RightArrow) {
                    root.ep-sel = min(root.episodes.length - 1, root.ep-sel + 1);
                } else if (event.text == Key.UpArrow) {
                    root.zone = 2;
                } else if (event.text == Key.Return) {
                    if (root.ep-sel != root.ep-current) {
                        root.command("goto:" + root.episodes[root.ep-sel].id);
                    }
                    root.zone = 2;
                }
            } else if (root.zone == 3) {
                // Bouton Retour
                if (event.text == Key.DownArrow) {
                    root.zone = 1;
                } else if (event.text == Key.Return) {
                    root.command("stop");
                }
            }
            root.show();
            return EventResult.accept;
        }
    }

    // Télécommande au milieu, entre la barre du titre et le panneau du bas, par-dessus la zone
    // tactile du lecteur (sinon elle prenait les touchers) : gros boutons (recul, lecture, avance,
    // épisodes, volume). Sur un petit écran, les boutons rapetissent, puis le volume et enfin
    // l'en-tête s'effacent.
    if root.remote: pad := Rectangle {
        property <length> top: 96px * root.k;
        property <length> room: root.height - 160px * root.k - 2 * root.m - self.top;
        property <length> gap: 14px * root.k;
        property <length> head-h: (root.remote-nodur || root.remote-busy != "" ? 58px : 36px) * root.k;
        property <length> bs: max(36px * root.k, min(72px * root.k, root.width / 7.4, self.room / 2.9));
        property <length> row1-h: self.bs * 1.3;
        property <length> row2-h: self.bs * 0.8;
        property <bool> show-head: self.room >= self.head-h + self.gap + self.row1-h;
        property <bool> show-vol: self.room >= (self.show-head ? self.head-h + self.gap : 0px) + self.row1-h + self.gap + self.row2-h;
        property <length> used: (self.show-head ? self.head-h + self.gap : 0px) + self.row1-h + (self.show-vol ? self.gap + self.row2-h : 0px);
        property <length> y0: self.top + max(0px, (self.room - self.used) / 2);
        if pad.show-head: VerticalLayout {
            x: 16px * root.k;
            y: pad.y0;
            width: root.width - 32px * root.k;
            height: pad.head-h;
            alignment: center;
            spacing: 4px * root.k;
            HorizontalLayout {
                alignment: center;
                spacing: 10px * root.k;
                Icon {
                    width: 26px * root.k;
                    height: 26px * root.k;
                    name: "cast-on";
                }
                Text {
                    text: Tr.f(Tr.k, "En lecture sur {}", root.remote-name, "");
                    color: Theme.player-ink;
                    font-size: 20px * root.k;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            if root.remote-busy != "" || root.remote-nodur: Text {
                text: root.remote-busy != "" ? root.remote-busy
                    : Tr.t(Tr.k, "Cet écran ne donne pas la durée d'une vidéo convertie : utilise les boutons recul et avance.");
                color: Theme.player-ink.with-alpha(0.7);
                font-size: 13px * root.k;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
        // Rangée principale : épisode précédent, recul, lecture / pause, avance, épisode suivant.
        HorizontalLayout {
            y: pad.y0 + (pad.show-head ? pad.head-h + pad.gap : 0px);
            height: pad.row1-h;
            alignment: center;
            spacing: pad.bs * 0.28;
            PlayerButton {
                size: pad.bs * 0.85;
                icon: "prev-ep";
                enabled: root.has-prev;
                clicked => {
                    root.command("episode:-1");
                }
            }
            PlayerButton {
                size: pad.bs;
                text: "−10";
                font: pad.bs * 0.3;
                clicked => {
                    root.command("seek:-10");
                }
            }
            PlayerButton {
                size: pad.bs;
                main: true;
                icon: root.paused ? "play" : "pause";
                clicked => {
                    root.command("pause");
                }
            }
            PlayerButton {
                size: pad.bs;
                text: "+30";
                font: pad.bs * 0.3;
                clicked => {
                    root.command("seek:30");
                }
            }
            PlayerButton {
                size: pad.bs * 0.85;
                icon: "next-ep";
                enabled: root.has-next;
                clicked => {
                    root.command("episode:1");
                }
            }
        }
        // Volume de l'écran : − et + par pas de 1 (maintenus : le volume défile), muet, valeur.
        // L'écran reçoit le volume au lâcher (pas une commande par pas).
        if pad.show-vol: HorizontalLayout {
            y: pad.y0 + (pad.show-head ? pad.head-h + pad.gap : 0px) + pad.row1-h + pad.gap;
            height: pad.row2-h;
            alignment: center;
            spacing: pad.bs * 0.3;
            // Volume affiché pendant un appui maintenu (-1 : celui de l'écran) et pas déjà faits.
            property <int> vol-shown: -1;
            property <int> vol-rep: 0;
            vol-timer := Timer {
                interval: 90ms;
                running: vminus.held || vplus.held;
                triggered => {
                    let d = vminus.held ? -1 : 1;
                    parent.vol-rep += 1;
                    // Un instant d'appui avant que ça défile (un simple toucher fait un seul pas).
                    if (parent.vol-rep > 3) {
                        parent.vol-shown = max(0, min(100, (parent.vol-shown < 0 ? root.volume : parent.vol-shown) + d));
                    }
                }
            }
            vminus := PlayerButton {
                size: pad.row2-h;
                text: "−";
                font: pad.row2-h * 0.5;
                changed held => {
                    if (!self.held) {
                        parent.release(-1);
                    }
                }
            }
            PlayerButton {
                size: pad.row2-h;
                icon: root.volume == 0 ? "mute" : "volume";
                clicked => {
                    if (root.volume > 0) {
                        root.unmute-vol = root.volume;
                        root.set-volume(0);
                    } else {
                        root.set-volume(root.unmute-vol);
                    }
                }
            }
            Text {
                width: 64px * root.k;
                text: (parent.vol-shown >= 0 ? parent.vol-shown : root.volume) + " %";
                color: Theme.player-ink.with-alpha(0.85);
                font-size: 16px * root.k;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            vplus := PlayerButton {
                size: pad.row2-h;
                text: "+";
                font: pad.row2-h * 0.5;
                changed held => {
                    if (!self.held) {
                        parent.release(1);
                    }
                }
            }
            // Bouton lâché : un pas si c'était un simple toucher, sinon le volume atteint.
            function release(d: int) {
                if (self.vol-shown >= 0) {
                    root.set-volume(self.vol-shown);
                } else {
                    root.set-volume(root.volume + d);
                }
                self.vol-shown = -1;
                self.vol-rep = 0;
            }
        }
    }

    // ------------------------------------------------------------ Commandes
    if root.osd: Rectangle {
        // Voile du haut pour la lisibilité du titre : simple dégradé, sans flou.
        Rectangle {
            y: 0px;
            height: 150px * root.k;
            background: @linear-gradient(180deg, #000000b3 0%, #00000000 100%);
        }

        // Diffuser : la vidéo passe à un écran (télé, Chromecast) au même endroit.
        PlayerButton {
            x: parent.width - self.width - root.m;
            y: root.m;
            size: 52px * root.k;
            icon: root.cast-on ? "cast-on" : "cast";
            clicked => {
                if (root.remote) {
                    root.cm-open = !root.cm-open;
                    root.show();
                } else {
                    root.cast();
                }
            }
        }
        // Télécommande : reprendre ici ou arrêter.
        if root.remote && root.cm-open: Rectangle {
            width: min(320px * root.k, parent.width - 2 * root.m);
            height: 2 * 52px * root.k + 16px * root.k;
            x: parent.width - self.width - root.m;
            y: root.m + 60px * root.k;
            border-radius: 14px * root.k;
            background: Theme.player-bar;
            border-width: 1px;
            border-color: Theme.glass-border;
            for c[i] in [Tr.t(Tr.k, "Reprendre sur cet appareil"), Tr.t(Tr.k, "Arrêter la diffusion")]: Rectangle {
                x: 8px * root.k;
                y: 8px * root.k + i * 52px * root.k;
                width: parent.width - 16px * root.k;
                height: 48px * root.k;
                border-radius: 10px * root.k;
                background: (cm-a.has-hover && !Nav.touch) || cm-a.pressed ? Theme.player-ink.with-alpha(0.16) : transparent;
                Text {
                    x: 14px * root.k;
                    width: parent.width - 28px * root.k;
                    text: c;
                    color: Theme.player-ink;
                    font-size: 16px * root.k;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                cm-a := TouchArea {
                    clicked => {
                        root.cm-open = false;
                        root.command(i == 0 ? "cast:resume" : "cast:stop");
                    }
                }
            }
        }

        PlayerButton {
            x: root.m;
            y: root.m;
            size: 52px * root.k;
            icon: "back";
            focused: root.zone == 3;
            clicked => {
                root.command("stop");
            }
        }

        Text {
            x: root.m + 70px * root.k;
            y: root.m - 2px * root.k;
            width: parent.width - self.x - root.m - 70px * root.k;
            height: 30px * root.k;
            text: root.title;
            color: Theme.player-ink.with-alpha(0.92);
            font-size: 22px * root.k;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: root.m + 70px * root.k;
            y: root.m + 28px * root.k;
            width: parent.width - self.x - root.m - 70px * root.k;
            height: 24px * root.k;
            text: root.subtitle;
            color: Theme.accent2;
            font-size: 16px * root.k;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        // Panneau du bas : temps, barre, boutons, heure de fin.
        panel := Rectangle {
            // Petit écran (téléphone, texte agrandi) : les boutons de lecture (au centre) et de pistes (à
            // droite) ne doivent pas se chevaucher : la lecture se décale à gauche, puis tout rétrécit.
            property <int> nr: root.quality-tracks.length > 0 ? 4 : 3;
            // Marges des deux côtés, bouton Lecture plus gros que sa place (+16), écart de 24 entre les groupes.
            property <length> need: (5 * 52px + 4 * 16px + 16px + (self.nr + 1) * 44px + self.nr * 12px + 24px) * root.k + 2 * root.m;
            property <float> bk: min(1, self.width / self.need);
            property <length> cw: (5 * 52px + 4 * 16px) * root.k * self.bk;
            property <length> rw: ((self.nr + 1) * 44px + self.nr * 12px) * root.k * self.bk;
            x: root.m;
            width: parent.width - 2 * root.m;
            height: 160px * root.k;
            y: parent.height - self.height - root.m - root.ep-p * root.ep-h;
            border-radius: 16px;
            background: Theme.player-bar;
            Gloss { r: parent.border-radius; strength: 0.4; }
            border-width: 1px;
            border-color: Theme.glass-border;

            // Absorbe les clics sur le panneau (sinon ils mettraient en pause).
            TouchArea {
                // La molette ne fait pas défiler la page dessous.
                scroll-event(e) => {
                    return EventResult.accept;
                }
            }

            Text {
                x: root.m;
                y: 12px * root.k;
                height: 24px * root.k;
                text: root.pos-text;
                color: Theme.player-ink.with-alpha(0.92);
                font-size: 16px * root.k;
                vertical-alignment: center;
            }

            Text {
                x: parent.width - self.width - root.m;
                y: 12px * root.k;
                width: 160px * root.k;
                height: 24px * root.k;
                text: root.dur-text;
                color: Theme.player-ink.with-alpha(0.62);
                font-size: 16px * root.k;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            // Barre de temps (zone sensible plus haute que le trait).
            bar := Rectangle {
                x: root.m;
                y: 40px * root.k;
                width: parent.width - 2 * root.m;
                height: 28px * root.k;

                property <length> th: (root.zone == 1 ? 10px : 6px) * root.k;
                property <float> shown: root.dragging ? root.drag-frac : root.progress;

                track := Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: bar.th;
                    border-radius: self.height / 2;
                    background: Theme.player-ink.with-alpha(0.2);
                }

                Rectangle {
                    x: 0px;
                    y: track.y;
                    width: max(bar.th, parent.width * bar.shown);
                    height: bar.th;
                    border-radius: self.height / 2;
                    background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
                }

                // Repères de chapitres
                for c in root.chapters: Rectangle {
                    x: parent.width * c - 1.5px;
                    y: track.y;
                    width: 3px;
                    height: bar.th;
                    background: #000000b3;
                }

                Rectangle {
                    width: (root.zone == 1 ? 22px : 14px) * root.k;
                    height: self.width;
                    x: parent.width * bar.shown - self.width / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    background: Theme.on-accent;
                    border-width: root.zone == 1 ? 3px : 0px;
                    border-color: Theme.accent2;
                }

                TouchArea {
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.dragging = true;
                            root.drag-frac = clamp(self.mouse-x / self.width, 0, 1);
                        } else if (e.kind == PointerEventKind.up) {
                            if (root.dragging) {
                                root.command("seek-to:" + root.drag-frac);
                            }
                            root.dragging = false;
                        } else if (e.kind == PointerEventKind.cancel) {
                            root.dragging = false;
                        }
                    }
                    moved => {
                        if (root.dragging) {
                            root.drag-frac = clamp(self.mouse-x / self.width, 0, 1);
                            root.show();
                        }
                    }
                }
            }

            // Boutons de lecture, au centre (décalés à gauche s'ils touchent les pistes). Télécommande :
            // ils sont au milieu de l'écran (voir pad), le panneau ne garde que le temps et les pistes.
            if !root.remote: HorizontalLayout {
                x: max(root.m + 8px * root.k * panel.bk, min((parent.width - panel.cw) / 2, parent.width - root.m - panel.rw - 32px * root.k * panel.bk - panel.cw));
                y: 78px * root.k + (1 - panel.bk) * 26px * root.k;
                width: panel.cw;
                height: 52px * root.k * panel.bk;
                alignment: start;
                spacing: 16px * root.k * panel.bk;

                PlayerButton {
                    size: 52px * root.k * panel.bk;
                    icon: "prev-ep";
                    enabled: root.has-prev;
                    focused: root.zone == 2 && root.btn == 0;
                    press: root.press-btn == 0 ? root.press-n : 0;
                    clicked => {
                        root.zone = 0;
                        root.activate(0);
                    }
                }
                PlayerButton {
                    size: 52px * root.k * panel.bk;
                    icon: "prev-chap";
                    enabled: root.chapter-count > 0;
                    focused: root.zone == 2 && root.btn == 1;
                    press: root.press-btn == 1 ? root.press-n : 0;
                    clicked => {
                        root.zone = 0;
                        root.activate(1);
                    }
                }
                PlayerButton {
                    size: 52px * root.k * panel.bk;
                    icon: root.paused ? "play" : "pause";
                    main: true;
                    focused: root.zone == 2 && root.btn == 2;
                    press: root.press-btn == 2 ? root.press-n : 0;
                    clicked => {
                        root.zone = 0;
                        root.activate(2);
                    }
                }
                PlayerButton {
                    size: 52px * root.k * panel.bk;
                    icon: "next-chap";
                    enabled: root.chapter-count > 0;
                    focused: root.zone == 2 && root.btn == 3;
                    press: root.press-btn == 3 ? root.press-n : 0;
                    clicked => {
                        root.zone = 0;
                        root.activate(3);
                    }
                }
                PlayerButton {
                    size: 52px * root.k * panel.bk;
                    icon: "next-ep";
                    enabled: root.has-next;
                    focused: root.zone == 2 && root.btn == 4;
                    press: root.press-btn == 4 ? root.press-n : 0;
                    clicked => {
                        root.zone = 0;
                        root.activate(4);
                    }
                }
            }

            // Pistes, à droite
            HorizontalLayout {
                x: 0px;
                y: 82px * root.k + (1 - panel.bk) * 22px * root.k;
                width: parent.width - root.m;
                height: 44px * root.k * panel.bk;
                alignment: end;
                spacing: 12px * root.k * panel.bk;

                if !root.remote: PlayerButton {
                    size: 44px * root.k * panel.bk;
                    icon: root.volume == 0 ? "mute" : "volume";
                    focused: (root.zone == 2 || root.zone == 6) && root.btn == 5;
                    press: root.press-btn == 5 ? root.press-n : 0;
                    clicked => {
                        root.activate(5);
                    }
                }
                PlayerButton {
                    enabled: root.audio-tracks.length > 1;
                    size: 44px * root.k * panel.bk;
                    icon: "audio";
                    focused: root.zone == 2 && root.btn == 6;
                    press: root.press-btn == 6 ? root.press-n : 0;
                    clicked => {
                        root.activate(6);
                    }
                }
                PlayerButton {
                    enabled: root.sub-tracks.length > 0;
                    size: 44px * root.k * panel.bk;
                    icon: "subs";
                    focused: root.zone == 2 && root.btn == 7;
                    press: root.press-btn == 7 ? root.press-n : 0;
                    clicked => {
                        root.activate(7);
                    }
                }
                if root.quality-tracks.length > 0: PlayerButton {
                    size: 44px * root.k * panel.bk;
                    icon: "quality";
                    focused: root.zone == 2 && root.btn == 8;
                    press: root.press-btn == 8 ? root.press-n : 0;
                    clicked => {
                        root.activate(8);
                    }
                }
            }

            // Heure de fin : au-dessus de la barre, entre le temps écoulé et la durée.
            Text {
                y: 12px * root.k;
                width: parent.width;
                height: 24px * root.k;
                text: root.end-text;
                color: Theme.player-ink.with-alpha(0.62);
                font-size: 14px * root.k;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Menu des pistes, au-dessus du panneau, à droite.
        // Monte de 24 px en apparaissant, redescend en disparaissant.
        if root.menu-p > 0.01: Rectangle {
            width: min(440px * root.k, parent.width - 32px * root.k);
            height: 64px * root.k + max(1, min(root.menu-items.length, root.menu-rows)) * 46px * root.k + 10px * root.k;
            x: parent.width - self.width - root.m;
            y: panel.y - self.height - 16px * root.k + (1 - root.menu-p) * 24px * root.k;
            opacity: root.menu-p;
            border-radius: 16px;
            background: Theme.player-bar;
            Gloss { r: parent.border-radius; strength: 0.4; }
            border-width: 1px;
            border-color: Theme.glass-border;

            TouchArea {
                // La molette parcourt la liste (plus de lignes que de place : Qualité) ; elle ne fait
                // pas défiler la page dessous.
                scroll-event(e) => {
                    let row = 46px * root.k;
                    root.menu-acc += e.delta-y;
                    let steps = root.menu-acc > 0 ? floor(root.menu-acc / row) : -floor(-root.menu-acc / row);
                    if (steps != 0) {
                        root.menu-acc -= steps * row;
                        if (Nav.drag) {
                            // Doigt : la liste défile, le choix ne change pas (un toucher choisit).
                            let top = root.menu-free ? root.menu-free-top : root.menu-top;
                            root.menu-free-top = max(0, min(root.menu-items.length - root.menu-rows, top - steps));
                            root.menu-free = true;
                        } else {
                            root.menu-free = false;
                            root.menu-sel = max(0, min(root.menu-items.length - 1, root.menu-sel - steps));
                        }
                    }
                    root.show();
                    return EventResult.accept;
                }
            }

            Text {
                x: root.m;
                y: 16px * root.k;
                height: 32px * root.k;
                text: root.menu-last == "audio" ? Tr.t(Tr.k, "Piste audio") : root.menu-last == "sub" ? Tr.t(Tr.k, "Sous-titres") : Tr.t(Tr.k, "Qualité");
                color: Theme.player-ink.with-alpha(0.92);
                font-size: 22px * root.k;
                font-weight: 700;
                vertical-alignment: center;
            }

            if root.menu-items.length == 0: Text {
                x: root.m;
                y: 60px * root.k;
                height: 42px * root.k;
                text: Tr.t(Tr.k, "Aucune piste");
                color: Theme.player-ink.with-alpha(0.62);
                font-size: 17px * root.k;
                vertical-alignment: center;
            }

            for t[i] in root.menu-items: Rectangle {
                visible: i >= root.menu-top && i < root.menu-top + root.menu-rows;
                x: 12px * root.k;
                y: 60px * root.k + (i - root.menu-top) * 46px * root.k;
                width: parent.width - 24px * root.k;
                height: 42px * root.k;
                border-radius: 10px * root.k;
                background: (i == root.menu-sel || row.has-hover) ? @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%) : transparent;

                if t.current: Rectangle {
                    x: 14px * root.k;
                    y: (parent.height - self.height) / 2;
                    width: 10px * root.k;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: (i == root.menu-sel || row.has-hover) ? Theme.on-accent : Theme.player-ink;
                }

                Text {
                    x: 36px * root.k;
                    width: parent.width - 48px * root.k;
                    text: t.label;
                    color: (i == root.menu-sel || row.has-hover) ? Theme.on-accent : Theme.player-ink;
                    font-size: 17px * root.k;
                    font-weight: i == root.menu-sel ? 700 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                }

                row := TouchArea {
                    clicked => {
                        root.menu-sel = i;
                        root.apply-menu();
                        root.show();
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ Indice : épisodes dessous
    // Commandes affichées et saison connue : petite languette sous le panneau (↓ pour l'ouvrir).
    if root.osd && root.episodes.length > 0 && root.zone != 5 && root.ep-p < 0.01: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 2px * root.k;
        width: ep-hint.preferred-width + 54px * root.k;
        height: 22px * root.k;
        border-top-left-radius: 10px * root.k;
        border-top-right-radius: 10px * root.k;
        background: Theme.player-bar;
            Gloss { r: parent.border-radius; strength: 0.4; }
        Path {
            x: 14px * root.k;
            y: (parent.height - self.height) / 2;
            width: 12px * root.k;
            height: 12px * root.k;
            viewbox-width: 12;
            viewbox-height: 12;
            fill: transparent;
            stroke: Theme.accent2;
            stroke-width: 2px * root.k;
            commands: "M 2 4 L 6 8 L 10 4";
        }
        ep-hint := Text {
            x: 34px * root.k;
            height: parent.height;
            text: Tr.t(Tr.k, "Épisodes");
            color: Theme.player-ink.with-alpha(0.8);
            font-size: 13px * root.k;
            font-weight: 600;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => {
                root.zone = 5;
                root.ep-sel = root.ep-current;
                root.show();
            }
        }
    }

    // ------------------------------------------------------------ Volume
    // Barre horizontale : ← → (5 %), souris ou doigt. Bureau : volume de Turtlefin ; Android : volume
    // « média » du téléphone (celui des touches), relu tant que la barre est ouverte.
    Timer {
        interval: 400ms;
        running: root.vol-p > 0.5;
        triggered => {
            root.command("volume-poll");
        }
    }
    if root.osd && root.vol-p > 0.01: Rectangle {
        // Au doigt : plus large (dans la limite de l'écran), plus haute, la barre se prend partout.
        width: min(parent.width - 2 * root.m, (Nav.touch ? 520px : 420px) * root.k);
        height: (Nav.touch ? 96px : 76px) * root.k;
        x: parent.width - self.width - root.m;
        y: parent.height - root.m - 160px * root.k - self.height - 16px * root.k + (1 - root.vol-p) * 24px * root.k;
        opacity: root.vol-p;
        border-radius: 16px;
        background: Theme.player-bar;
            Gloss { r: parent.border-radius; strength: 0.4; }
        border-width: 1px;
        border-color: Theme.glass-border;

        TouchArea {
            // La molette ne fait pas défiler la page dessous.
            scroll-event(e) => {
                return EventResult.accept;
            }
        }

        Icon {
            x: 22px * root.k;
            y: (parent.height - self.height) / 2;
            width: 28px * root.k;
            height: 28px * root.k;
            name: root.volume == 0 ? "mute" : "volume";
        }
        vbar := Rectangle {
            x: 66px * root.k;
            y: (parent.height - self.height) / 2;
            width: parent.width - 66px * root.k - 90px * root.k;
            height: (Nav.touch ? 56px : 28px) * root.k;
            property <length> track: (Nav.touch ? 12px : 8px) * root.k;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: vbar.track;
                border-radius: self.height / 2;
                // Partie vide bien visible (au doigt, on doit voir où toucher).
                background: Theme.player-ink.with-alpha(0.3);
                border-width: 1px;
                border-color: Theme.player-ink.with-alpha(0.25);
            }
            Rectangle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: max(vbar.track, parent.width * root.volume / 100);
                animate width { duration: Motion.player && !vtouch.pressed ? 120ms : 0ms; easing: ease-out; }
                height: vbar.track;
                border-radius: self.height / 2;
                background: @linear-gradient(90deg, Theme.accent1 0%, Theme.accent2 100%);
            }
            Rectangle {
                // Bouton qui grossit sous le doigt.
                width: (vtouch.pressed ? 32px : Nav.touch ? 28px : 22px) * root.k;
                animate width { duration: Motion.player ? 160ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                height: self.width;
                x: parent.width * root.volume / 100 - self.width / 2;
                animate x { duration: Motion.player && !vtouch.pressed ? 120ms : 0ms; easing: ease-out; }
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: Theme.player-ink;
                border-width: 3px;
                border-color: Theme.accent2;
            }
            vtouch := TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.set-volume(round(clamp(self.mouse-x / self.width, 0, 1) * 100));
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.set-volume(round(clamp(self.mouse-x / self.width, 0, 1) * 100));
                    }
                    root.show();
                }
            }
        }
        Text {
            x: parent.width - 76px * root.k;
            width: 60px * root.k;
            height: parent.height;
            text: root.volume + " %";
            color: Theme.player-ink;
            font-size: 17px * root.k;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    // ------------------------------------------------------------ Épisodes de la saison (↓)
    // Le bandeau monte du bas en même temps que le panneau (ep-p), sans le recouvrir.
    if root.osd && root.ep-p > 0.001: Rectangle {
        x: root.m;
        y: parent.height - root.ep-p * (root.ep-h + root.m / 2);
        width: parent.width - 2 * root.m;
        height: root.ep-h;
        clip: true;

        property <length> cw: 220px * root.k;
        property <length> gap: 16px * root.k;
        // Marge intérieure : la carte agrandie (sélection) n'est pas coupée sur les bords.
        property <length> pad: 16px * root.k;
        property <length> strip-min: min(0px, self.width - root.episodes.length * (self.cw + self.gap) + self.gap - 2 * self.pad);
        property <length> sel-x: max(self.strip-min, min(0px, self.width / 2 - (self.pad + root.ep-sel * (self.cw + self.gap) + self.cw / 2)));
        // Au doigt : le bandeau suit le glissement (défilement libre) ; une touche le recentre.
        property <bool> free;
        property <length> free-x;
        property <int> sel-now: root.ep-sel;
        changed sel-now => {
            self.free = false;
        }
        property <length> strip-x: self.free ? self.free-x : self.sel-x;
        animate strip-x { duration: Motion.player && !Nav.drag ? 220ms : 0ms; easing: ease-out; }
        TouchArea {
            scroll-event(e) => {
                // Molette verticale : défile aussi ; doigt vertical : c'est un geste (pas un défilement).
                let d = e.delta-x != 0 ? e.delta-x : Nav.drag ? 0px : e.delta-y;
                if (d == 0) {
                    return EventResult.reject;
                }
                parent.free-x = max(parent.strip-min, min(0px, (parent.free ? parent.free-x : parent.sel-x) + d));
                parent.free = true;
                root.show();
                return EventResult.accept;
            }
        }

        for e[i] in root.episodes: EpisodeCard {
            x: parent.strip-x + parent.pad + i * (parent.cw + parent.gap);
            y: 8px * root.k;
            width: parent.cw;
            height: parent.cw * 0.5625 + 50px * root.k;
            data: e;
            k: root.k;
            focused: i == root.ep-sel;
            current: i == root.ep-current;
            clicked => {
                if (i != root.ep-current) {
                    root.command("goto:" + e.id);
                }
            }
        }
    }

    // ------------------------------------------------------------ Passer l'intro
    if root.skip-p > 0.01: Rectangle {
        x: parent.width - self.width - root.m + (1 - root.skip-p) * 30px * root.k;
        y: parent.height - self.height - root.m - (root.osd ? 160px * root.k + root.m : 0px);
        opacity: root.skip-p;
        width: 190px * root.k;
        height: 48px * root.k;

        PlayerButton {
            width: parent.width;
            size: 48px * root.k;
            font: 16px * root.k;
            text: Tr.t(Tr.k, "Passer l'intro");
            focused: !root.osd || root.zone == 0;
            clicked => {
                root.command("skip-intro");
            }
        }
    }

    // ------------------------------------------------------------ Épisode suivant (générique)
    // Cachée tant qu'un menu Audio / Sous-titres est ouvert (elle le recouvrait).
    if root.next-p > 0.01: Rectangle {
        x: parent.width - self.width - root.m + (1 - root.next-p) * 40px * root.k;
        opacity: root.next-p;
        y: parent.height - self.height - root.m - (root.osd ? 160px * root.k + root.m : 0px);
        animate y { duration: Motion.player ? 160ms : 0ms; easing: ease-out; }
        width: min(340px * root.k, parent.width - 32px * root.k);
        height: 340px * 0.5625 * root.k + 150px * root.k;
        border-radius: 14px;
        background: Theme.player-bar;
            Gloss { r: parent.border-radius; strength: 0.4; }
        border-width: 1px;
        border-color: Theme.glass-border;

        Text {
            x: 14px * root.k;
            y: 10px * root.k;
            text: root.up-title;
            color: Theme.accent2;
            font-size: 14px * root.k;
            font-weight: 700;
        }
        Rectangle {
            x: 14px * root.k;
            y: 34px * root.k;
            width: parent.width - 28px * root.k;
            height: self.width * 0.5625;
            border-radius: 10px;
            background: root.has-up-image ? transparent : Theme.player-ink.with-alpha(0.08);

            if root.has-up-image: Image {
                width: parent.width;
                height: parent.height;
                source: root.up-image;
                image-fit: fill;
            }
        }
        Text {
            x: 14px * root.k;
            y: 34px * root.k + (parent.width - 28px * root.k) * 0.5625 + 6px * root.k;
            width: parent.width - 28px * root.k;
            text: root.up-sub;
            color: Theme.player-ink.with-alpha(0.92);
            font-size: 14px * root.k;
            font-weight: 600;
            overflow: elide;
        }
        VerticalLayout {
            x: 14px * root.k;
            y: parent.height - 92px * root.k;
            width: parent.width - 28px * root.k;
            height: 82px * root.k;
            spacing: 8px * root.k;

            PlayerButton {
                size: 37px * root.k;
                font: 14px * root.k;
                text: root.up-button;
                focused: root.up-sel == 0;
                clicked => {
                    root.command("up:play");
                }
            }
            PlayerButton {
                size: 37px * root.k;
                font: 14px * root.k;
                text: Tr.t(Tr.k, "Regarder la fin de celui-ci");
                focused: root.up-sel == 1;
                clicked => {
                    root.command("up:dismiss");
                }
            }
        }
    }

    // ------------------------------------------------------------ Suggestions / écran de fin
    if root.up-mode == "pick" || root.up-mode == "end": ups := Rectangle {
        // Haut de la zone des suggestions : sous la vidéo réduite (« pick ») ou en haut (« end »).
        property <length> top: root.up-mode == "pick" ? 32px * root.k + 225px * root.k + 44px * root.k : 60px * root.k;
        // Bas : place pour « Retour à l'accueil » (« end »).
        property <length> bottom: root.up-mode == "end" ? 90px * root.k : 24px * root.k;
        // Largeur des affiches : tout doit tenir en hauteur (titre 50 px, textes sous l'affiche 56 px).
        property <length> pw: min(170px * root.k, (self.height - self.top - self.bottom - 50px * root.k - 56px * root.k) / 1.5);

        // Fond : image du média qui vient de se terminer, floutée et assombrie au chargement.
        if root.has-bg: Image {
            width: parent.width;
            height: parent.height;
            source: root.bg;
            image-fit: cover;
        }
        Rectangle {
            background: root.has-bg ? @linear-gradient(180deg, #00000066 0%, #000000d9 100%) : #000000e6;
        }

        // Vidéo réduite, redessinée au-dessus du voile (même texture, aucun coût de décodage).
        if root.up-mode == "pick": Image {
            x: 32px * root.k;
            y: 32px * root.k;
            width: 400px * root.k;
            height: 225px * root.k;
            source: root.frame;
            image-fit: fill;
        }

        // Cadre de sélection de la vidéo réduite : sélectionnable pour rester jusqu'au bout.
        if root.up-mode == "pick": Rectangle {
            x: 32px * root.k - 4px;
            y: 32px * root.k - 4px;
            width: 400px * root.k + 8px;
            height: 225px * root.k + 8px;
            border-radius: 6px;
            border-width: root.up-sel == 0 ? 4px : 0px;
            border-color: Theme.accent2;
            TouchArea {
                clicked => {
                    root.command("up:dismiss");
                }
            }
        }
        if root.up-mode == "pick": Text {
            x: 32px * root.k;
            y: 32px * root.k + 225px * root.k + 10px * root.k;
            text: Tr.t(Tr.k, "Regarder la fin");
            color: root.up-sel == 0 ? Theme.player-ink : Theme.player-ink.with-alpha(0.62);
            font-size: 15px * root.k;
            font-weight: 600;
        }

        Text {
            y: ups.top;
            height: 50px * root.k;
            width: parent.width;
            text: root.up-mode == "pick" ? Tr.t(Tr.k, "À voir ensuite") : Tr.t(Tr.k, "C'est fini ! À voir ensuite");
            color: Theme.player-ink.with-alpha(0.92);
            font-size: 26px * root.k;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // Les 3 suggestions (films ou séries) montent du bas de l'écran, l'une après l'autre.
        for p[i] in root.picks: PickCard {
            x: (ups.width - (root.picks.length * (ups.pw + 28px * root.k) - 28px * root.k)) / 2
                + i * (ups.pw + 28px * root.k);
            y: root.picks-in ? ups.top + 50px * root.k : ups.height + 20px;
            animate y { duration: Motion.player ? 520ms : 0ms; delay: 120ms + i * 110ms; easing: ease-out; }
            width: ups.pw;
            height: ups.pw * 1.5 + 56px * root.k;
            data: p;
            k: root.k;
            focused: root.up-sel == i + 1;
            clicked => {
                root.command("pick:" + p.id);
            }
        }

        if root.up-mode == "end": HorizontalLayout {
            y: parent.height - 70px * root.k;
            width: parent.width;
            height: 48px * root.k;
            alignment: center;

            PlayerButton {
                size: 48px * root.k;
                font: 16px * root.k;
                text: Tr.t(Tr.k, "Retour à l'accueil");
                focused: root.up-sel == 0;
                clicked => {
                    root.command("home");
                }
            }
        }

        // Déclenche l'animation d'entrée des suggestions juste après leur affichage.
        Timer {
            interval: 40ms;
            running: !root.picks-in && root.picks.length > 0;
            triggered => {
                root.picks-in = true;
            }
        }
    }

    // Watch party : rappel discret en haut à droite.
    if root.party != "" && root.osd: Rectangle {
        x: parent.width - self.width - root.m;
        y: root.m + 6px * root.k;
        width: party-txt.preferred-width + 28px * root.k;
        height: 34px * root.k;
        border-radius: self.height / 2;
        background: @linear-gradient(130deg, Theme.accent1 0%, Theme.accent2 100%);
        party-txt := Text {
            text: Tr.f(Tr.k, "Watch party · {}", root.party, "");
            color: Theme.on-accent;
            font-size: 14px * root.k;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
