// Changement de langue (dust.rs) : une barre lumineuse parcourt chaque ligne de texte et la
// recouvre de blanc (phase 1), les lignes restent blanches pendant le choix (2) ; au choix, les
// blocs s'élargissent pour couvrir aussi la place des nouveaux mots (4, l'ancienne langue toujours
// affichée dessous), la langue change, puis ils se resserrent et la barre les dévoile (3).
// Peu coûteux : quelques rectangles animés ; les lignes sont repérées une fois, en Rust.
import { Theme } from "theme.slint";

export struct DustLine {
    // Ligne de texte (px logiques) ; fx / fw : position et largeur d'avant (phase 3, les blocs
    // passent de l'ancienne largeur à la nouvelle) ; delay : départ de la barre sur cette ligne.
    x: length,
    y: length,
    w: length,
    h: length,
    fx: length,
    fw: length,
    delay: duration,
}

export component DustLines inherits Rectangle {
    in property <[DustLine]> lines;
    in property <int> phase;
    in property <duration> t0;
    in property <float> k: 1.0;
    // Recouvert (phase 2) : rien ne bouge, pas de rafraîchissement continu.
    property <duration> now: root.phase == 2 ? 0ms : animation-tick() - root.t0;
    property <duration> morph: 260ms;
    property <duration> sweep: 420ms;

    for l in root.lines: ln := Rectangle {
        // Phase 3 : de l'ancienne largeur à la nouvelle, puis la barre dévoile.
        property <float> m: root.phase == 3 || root.phase == 4 ? clamp(root.now / root.morph, 0, 1) : 1;
        property <float> me: 1 - (1 - self.m) * (1 - self.m);
        property <length> bx: l.fx + (l.x - l.fx) * self.me;
        property <length> bw: l.fw + (l.w - l.fw) * self.me;
        property <float> p: root.phase == 1 ? clamp((root.now - l.delay) / root.sweep, 0, 1)
            : root.phase == 3 ? clamp((root.now - root.morph - l.delay) / root.sweep, 0, 1)
            : root.phase == 4 ? 0 : 1;
        property <float> e: self.p * self.p * (3 - 2 * self.p);
        // Bord qui avance avec la barre : droite du bloc (recouvrir), gauche (dévoiler).
        property <length> left: root.phase == 3 || root.phase == 4 ? self.bx + self.bw * self.e : self.bx;
        property <length> right: root.phase == 1 ? self.bx + self.bw * self.e : self.bx + self.bw;
        property <length> pad: 4px * root.k;

        if ln.right > ln.left: Rectangle {
            x: ln.left - ln.pad;
            y: l.y - ln.pad;
            width: ln.right - ln.left + 2 * ln.pad;
            height: l.h + 2 * ln.pad;
            border-radius: 4px * root.k;
            background: white;
        }
        // La barre, pendant son passage.
        if ln.p > 0 && ln.p < 1: Rectangle {
            x: (root.phase == 3 ? ln.left : ln.right) - 2px * root.k;
            y: l.y - 7px * root.k;
            width: 4px * root.k;
            height: l.h + 14px * root.k;
            border-radius: 2px * root.k;
            background: Theme.accent2;
            drop-shadow-blur: 10px * root.k;
            drop-shadow-color: Theme.accent2;
        }
    }
}
