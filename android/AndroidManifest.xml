<?xml version="1.0" encoding="utf-8"?>
<!-- Turtlefin pour Android : NativeActivity (pas de code Java à nous ; Slint charge son petit
     assistant Java en mémoire). Portrait comme paysage (selon le verrouillage de la rotation) ; la
     lecture d'une vidéo passe en paysage (android/src/entry.rs, lock_landscape). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.xelopteryx.turtlefin">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Android TV : la télécommande suffit. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Recherche des serveurs Jellyfin et des écrans (DLNA, Google Cast) du réseau local. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- allowBackup : pas de sauvegarde (Google, transfert vers un autre téléphone) des données de
         l'appli : elles contiennent les jetons de connexion aux serveurs. -->
    <application
        android:allowBackup="false"
        android:label="Turtlefin"
        android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/ic_launcher"
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Turtlefin">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation">
            <meta-data android:name="android.app.lib_name" android:value="turtlefin" />
        </activity>
        <!-- Icône aux couleurs du thème : une entrée de lanceur par thème intégré, une seule active
             (android/src/entry.rs, set_launcher_icon ; icônes générées par le test android_icons de
             src/theme.rs). Thème importé : l'icône par défaut. -->
        <activity-alias
            android:name=".Icon_turtlefin"
            android:targetActivity="android.app.NativeActivity"
            android:icon="@mipmap/ic_launcher"
            android:banner="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <!-- Lancée par cette entrée, NativeActivity lit le nom de la bibliothèque ici (sinon « main » :
                 plantage au démarrage). -->
            <meta-data android:name="android.app.lib_name" android:value="turtlefin" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_sombre"
            android:targetActivity="android.app.NativeActivity"
            android:icon="@mipmap/ic_sombre"
            android:banner="@mipmap/ic_sombre"
            android:enabled="false"
            android:exported="true">
            <!-- Lancée par cette entrée, NativeActivity lit le nom de la bibliothèque ici (sinon « main » :
                 plantage au démarrage). -->
            <meta-data android:name="android.app.lib_name" android:value="turtlefin" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_clair"
            android:targetActivity="android.app.NativeActivity"
            android:icon="@mipmap/ic_clair"
            android:banner="@mipmap/ic_clair"
            android:enabled="false"
            android:exported="true">
            <!-- Lancée par cette entrée, NativeActivity lit le nom de la bibliothèque ici (sinon « main » :
                 plantage au démarrage). -->
            <meta-data android:name="android.app.lib_name" android:value="turtlefin" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_aero"
            android:targetActivity="android.app.NativeActivity"
            android:icon="@mipmap/ic_aero"
            android:banner="@mipmap/ic_aero"
            android:enabled="false"
            android:exported="true">
            <!-- Lancée par cette entrée, NativeActivity lit le nom de la bibliothèque ici (sinon « main » :
                 plantage au démarrage). -->
            <meta-data android:name="android.app.lib_name" android:value="turtlefin" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_vert"
            android:targetActivity="android.app.NativeActivity"
            android:icon="@mipmap/ic_vert"
            android:banner="@mipmap/ic_vert"
            android:enabled="false"
            android:exported="true">
            <!-- Lancée par cette entrée, NativeActivity lit le nom de la bibliothèque ici (sinon « main » :
                 plantage au démarrage). -->
            <meta-data android:name="android.app.lib_name" android:value="turtlefin" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
