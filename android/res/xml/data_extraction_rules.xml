<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus : allowBackup="false" n'empêche plus le transfert d'appareil à appareil
     (passage à un nouveau téléphone). Rien n'est copié, ni dans le nuage ni vers un autre appareil :
     les données de l'appli contiennent les jetons de connexion aux serveurs. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
