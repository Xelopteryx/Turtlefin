msgid "← → : 10 s en arrière ou en avant. OK ou ↓ : les commandes (pause, volume, audio, sous-titres) ; ↓ encore : les épisodes de la saison. Retour : arrêter la lecture."
msgstr "← →: 10 s do tyłu lub do przodu. OK lub ↓: sterowanie (pauza, głośność, dźwięk, napisy); ponownie ↓: odcinki sezonu. Wstecz: zatrzymanie odtwarzania."

msgid "Langue, sous-titres, interface TV… tout se règle dans le menu, Paramètres. Cette visite se relance depuis Paramètres → À propos."
msgstr "Język, napisy, interfejs TV… wszystko ustawia się w menu, w Ustawieniach. Tę prezentację można powtórzyć w Ustawienia → Informacje."

msgid "Flèches et OK"
msgstr "Strzałki i OK"

msgid "Au clavier : Entrée = OK, Échap = Retour. La souris et le tactile marchent aussi."
msgstr "Na klawiaturze: Enter = OK, Esc = Wstecz. Mysz i ekran dotykowy też działają."

msgid "Watch party : regarder la même chose, en même temps, sur plusieurs appareils."
msgstr "Watch party: oglądanie tego samego, w tym samym czasie, na kilku urządzeniach."

msgid "Au hasard : Turtlefin choisit un média pour toi."
msgstr "Losowo: Turtlefin wybiera coś dla ciebie."

msgid "Recherche : dans ta bibliothèque, et de quoi demander ce qui manque."
msgstr "Wyszukiwanie: w twojej bibliotece, oraz sposób, by poprosić o to, czego brakuje."

msgid "Ton profil : changer de compte ou de photo."
msgstr "Twój profil: zmiana konta lub zdjęcia."

msgid "Cette visite te fait essayer l'app. Tout se fait avec la télécommande : les flèches pour se déplacer, OK pour ouvrir ou valider, Retour pour revenir en arrière."
msgstr "Ta prezentacja pozwala wypróbować aplikację. Wszystko robi się pilotem: strzałki do poruszania się, OK, aby otworzyć lub zatwierdzić, Wstecz, aby wrócić."

msgid "Commencer"
msgstr "Zaczynamy"

msgid "Les rangées"
msgstr "Rzędy"


msgid "Changer de rangée"
msgstr "Zmiana rzędu"


msgid "Appuie sur ↑ jusqu'à monter dans la barre du haut."
msgstr "Naciskaj ↑, aż dojdziesz do górnego paska."



msgid "Dans le menu"
msgstr "W menu"

msgid "Bibliothèques, téléchargements (à regarder sans connexion), watch party, compte, serveur et Paramètres. Parcours-le avec ↑ ↓, puis referme-le avec →."
msgstr "Biblioteki, pobrane (do oglądania bez połączenia), watch party, konto, serwer i Ustawienia. Przeglądaj je strzałkami ↑ ↓, a zamknij strzałką →."

msgid "Ouvrir un média"
msgstr "Otwieranie pozycji"

msgid "Choisis une affiche et appuie sur OK pour l'ouvrir."
msgstr "Wybierz plakat i naciśnij OK, aby go otworzyć."

msgid "Revenir"
msgstr "Powrót"

msgid "Une fiche (film, série) ou une bibliothèque entière : tout se parcourt de la même façon. Appuie sur Retour pour revenir à l'accueil."
msgstr "Strona (film, serial) lub cała biblioteka: wszystko przegląda się tak samo. Naciśnij Wstecz, aby wrócić do ekranu startowego."

msgid "Essaie : déplace-toi deux fois avec les flèches, ← → dans une rangée, ↑ ↓ d'une rangée à l'autre."
msgstr "Spróbuj: przesuń się dwa razy strzałkami, ← → w rzędzie, ↑ ↓ między rzędami."

msgid "Change de rangée avec ↓ ou ↑."
msgstr "Zmień rząd strzałką ↓ lub ↑."

msgid "Parcours-la avec → jusqu'à ton profil, tout à droite : les onglets Accueil, Favoris et Demandes, puis ces icônes."
msgstr "Przejdź po nim strzałką → aż do swojego profilu, całkiem po prawej: karty Start, Ulubione i Prośby, a potem te ikony."

msgid "Ouvre le menu : dans la barre du haut, va tout à gauche sur ≡ et appuie sur OK ; depuis les affiches, ← au début d'une rangée (ou Retour)."
msgstr "Otwórz menu: na górnym pasku przejdź całkiem w lewo na ≡ i naciśnij OK; przy plakatach ← na początku rzędu (lub Wstecz)."

msgid "Retour : quitter la visite"
msgstr "Wstecz: zakończ prezentację"
